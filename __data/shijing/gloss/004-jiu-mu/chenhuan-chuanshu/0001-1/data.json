{"version":1,"page":{"kind":"gloss-detail","href":"/shijing/gloss/004-jiu-mu/chenhuan-chuanshu/0001-1","dataHref":"/__data/shijing/gloss/004-jiu-mu/chenhuan-chuanshu/0001-1/data.json","title":"詩毛氏傳疏 · 《樛木》后妃逮下之义 · 陈奂 · 疏","description":"風 · 周南 · 樛木 · 《詩毛氏傳疏》关于“《樛木》后妃逮下之义”的注脚：陈奂承《序》义，以《樛木》为后妃逮下、无嫉妒之心之诗。其说重在后妃能和谐众妾，使众妾皆乐其君子而为之祝福，故诗中不以木尊葛卑为比贱，而以樛木下曲…"},"payload":{"detail":{"route":{"poemId":"004-jiu-mu","materialId":"chenhuan-chuanshu","glossId":"0001-1"},"href":"/shijing/gloss/004-jiu-mu/chenhuan-chuanshu/0001-1","poem":{"id":"004-jiu-mu","title":"樛木","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","樛木"],"segments":[{"id":"seg-001","text":"南有樛木","isActive":false},{"id":"seg-002","text":"葛藟纍之","isActive":false},{"id":"seg-003","text":"樂只君子","isActive":false},{"id":"seg-004","text":"福履綏之","isActive":false},{"id":"seg-005","text":"南有樛木","isActive":false},{"id":"seg-006","text":"葛藟荒之","isActive":false},{"id":"seg-007","text":"樂只君子","isActive":false},{"id":"seg-008","text":"福履將之","isActive":false},{"id":"seg-009","text":"南有樛木","isActive":false},{"id":"seg-010","text":"葛藟縈之","isActive":false},{"id":"seg-011","text":"樂只君子","isActive":false},{"id":"seg-012","text":"福履成之","isActive":false}]},"material":{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","authors":["陳奐"],"contributorLine":"清 · 陳奐","era":"清","publicationYear":1847,"carrier":"PDF"},"annotation":{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"《樛木》后妃逮下之义","targetNotes":"篇首总义与陈奂疏义。","sourceLabel":"第 28 页","sourceNotes":"PDF 28 页篇题后总说。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"陈奂承《序》义，以《樛木》为后妃逮下、无嫉妒之心之诗。其说重在后妃能和谐众妾，使众妾皆乐其君子而为之祝福，故诗中不以木尊葛卑为比贱，而以樛木下曲、葛藟附丽之象见德之柔和。","notes":"据 PDF 28 页疏义提要。"}]},"siblings":[{"id":"0001","order":1,"layerLabel":"全篇总说","title":"《樛木》后妃逮下之义","href":"/shijing/gloss/004-jiu-mu/chenhuan-chuanshu/0001-1","isCurrent":true},{"id":"0002","order":2,"layerLabel":"诗句片段","title":"南有樛木，葛藟纍之。樂只君子，福履綏之。","href":"/shijing/gloss/004-jiu-mu/chenhuan-chuanshu/0002-1","isCurrent":false},{"id":"0003","order":3,"layerLabel":"诗句片段","title":"南有樛木，葛藟荒之。樂只君子，福履將之。","href":"/shijing/gloss/004-jiu-mu/chenhuan-chuanshu/0003-1","isCurrent":false},{"id":"0004","order":4,"layerLabel":"诗句片段","title":"南有樛木，葛藟縈之。樂只君子，福履成之。","href":"/shijing/gloss/004-jiu-mu/chenhuan-chuanshu/0004-1","isCurrent":false}],"previous":null,"next":{"title":"南有樛木，葛藟纍之。樂只君子，福履綏之。","href":"/shijing/gloss/004-jiu-mu/chenhuan-chuanshu/0002-1"},"gloss":{"key":"0001-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"陈奂承《序》义，以《樛木》为后妃逮下、无嫉妒之心之诗。其说重在后妃能和谐众妾，使众妾皆乐其君子而为之祝福，故诗中不以木尊葛卑为比贱，而以樛木下曲、葛藟附丽之象见德之柔和。","notes":"据 PDF 28 页疏义提要。","id":"0001-1","order":1,"total":1,"annotationId":"0001"}}}}
