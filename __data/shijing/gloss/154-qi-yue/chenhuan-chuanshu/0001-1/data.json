:"25-2","segmentId":"seg-059","surfaceText":"十月穫稻","charStart":1,"charEnd":4}]},{"id":"part-26","order":26,"excerpt":"爲此春酒，以介眉壽。","anchors":[{"key":"26-1","segmentId":"seg-060","surfaceText":"爲此春酒","charStart":1,"charEnd":4},{"key":"26-2","segmentId":"seg-061","surfaceText":"以介眉壽","charStart":1,"charEnd":4}]},{"id":"part-27","order":27,"excerpt":"七月食瓜，八月斷壺，九月叔苴。","anchors":[{"key":"27-1","segmentId":"seg-062","surfaceText":"七月食瓜","charStart":1,"charEnd":4},{"key":"27-2","segmentId":"seg-063","surfaceText":"八月斷壺","charStart":1,"charEnd":4},{"key":"27-3","segmentId":"seg-064","surfaceText":"九月叔苴","charStart":1,"charEnd":4}]},{"id":"part-28","order":28,"excerpt":"采荼薪樗，食我農夫。","anchors":[{"key":"28-1","segmentId":"seg-065","surfaceText":"采荼薪樗","charStart":1,"charEnd":4},{"key":"28-2","segmentId":"seg-066","surfaceText":"食我農夫","charStart":1,"charEnd":4}]},{"id":"part-29","order":29,"excerpt":"九月築場圃，十月納禾稼。","anchors":[{"key":"29-1","segmentId":"seg-067","surfaceText":"九月築場圃","charStart":1,"charEnd":5},{"key":"29-2","segmentId":"seg-068","surfaceText":"十月納禾稼","charStart":1,"charEnd":5}]},{"id":"part-30","order":30,"excerpt":"黍稷重穋，禾麻菽麥。","anchors":[{"key":"30-1","segmentId":"seg-069","surfaceText":"黍稷重穋","charStart":1,"charEnd":4},{"key":"30-2","segmentId":"seg-070","surfaceText":"禾麻菽麥","charStart":1,"charEnd":4}]},{"id":"part-31","order":31,"excerpt":"嗟我農夫，我稼既同，上入執宫功。","anchors":[{"key":"31-1","segmentId":"seg-071","surfaceText":"嗟我農夫","charStart":1,"charEnd":4},{"key":"31-2","segmentId":"seg-072","surfaceText":"我稼既同","charStart":1,"charEnd":4},{"key":"31-3","segmentId":"seg-073","surfaceText":"上入執宫功","charStart":1,"charEnd":5}]},{"id":"part-32","order":32,"excerpt":"晝爾于茅，宵爾索陶。","anchors":[{"key":"32-1","segmentId":"seg-074","surfaceText":"晝爾于茅","charStart":1,"charEnd":4},{"key":"32-2","segmentId":"seg-075","surfaceText":"宵爾索陶","charStart":1,"charEnd":4}]},{"id":"part-33","order":33,"excerpt":"亟其乘屋，其始播百穀。","anchors":[{"key":"33-1","segmentId":"seg-076","surfaceText":"亟其乘屋",