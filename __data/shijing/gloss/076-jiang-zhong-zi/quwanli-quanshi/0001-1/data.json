{"version":1,"page":{"kind":"gloss-detail","href":"/shijing/gloss/076-jiang-zhong-zi/quwanli-quanshi/0001-1","dataHref":"/__data/shijing/gloss/076-jiang-zhong-zi/quwanli-quanshi/0001-1/data.json","title":"詩經詮釋 · 将仲子兮，无逾我里，无折我树杞。岂敢爱之？畏我父母。仲可怀也，父母之言，亦可畏也。将仲子兮，无逾我墙，无折我树桑。岂敢爱之？畏我诸兄。仲可怀也，诸兄之言，亦可畏也。将仲子兮，无逾我园，无折我树檀。岂敢爱之？畏人之多言。仲可怀也，人之多言，亦可畏也。 · 屈万里 · 注释","description":"風 · 鄭風 · 將仲子 · 《詩經詮釋》关于“将仲子兮，无逾我里，无折我树杞。岂敢爱之？畏我父…”的注脚：屈万里以《将仲子》为女子拒人求爱之诗，并依次训“将”为发语词，“仲子”为犹今言老二，“逾”为越，“里”为居处，“杞”为木名，“怀”为思。"},"payload":{"detail":{"route":{"poemId":"076-jiang-zhong-zi","materialId":"quwanli-quanshi","glossId":"0001-1"},"href":"/shijing/gloss/076-jiang-zhong-zi/quwanli-quanshi/0001-1","poem":{"id":"076-jiang-zhong-zi","title":"將仲子","categoryId":"feng","subcategoryId":"zhengfeng","path":["風","鄭風","將仲子"],"segments":[{"id":"seg-001","text":"将仲子兮","isActive":true},{"id":"seg-002","text":"无逾我里","isActive":true},{"id":"seg-003","text":"无折我树杞","isActive":true},{"id":"seg-004","text":"岂敢爱之","isActive":true},{"id":"seg-005","text":"畏我父母","isActive":true},{"id":"seg-006","text":"仲可怀也","isActive":true},{"id":"seg-007","text":"父母之言","isActive":true},{"id":"seg-008","text":"亦可畏也","isActive":true},{"id":"seg-009","text":"将仲子兮","isActive":true},{"id":"seg-010","text":"无逾我墙","isActive":true},{"id":"seg-011","text":"无折我树桑","isActive":true},{"id":"seg-012","text":"岂敢爱之","isActive":true},{"id":"seg-013","text":"畏我诸兄","isActive":true},{"id":"seg-014","text":"仲可怀也","isActive":true},{"id":"seg-015","text":"诸兄之言","isActive":true},{"id":"seg-016","text":"亦可畏也","isActive":true},{"id":"seg-017","text":"将仲子兮","isActive":true},{"id":"seg-018","text":"无逾我园","isActive":true},{"id":"seg-019","text":"无折我树檀","isActive":true},{"id":"seg-020","text":"岂敢爱之","isActive":true},{"id":"seg-021","text":"畏人之多言","isActive":true},{"id":"seg-022","text":"仲可怀也","isActive":true},{"id":"seg-023","text":"人之多言","isActive":true},{"id":"seg-024","text":"亦可畏也","isActive":true}]},"material":{"id":"quwanli-quanshi","title":"詩經詮釋","authors":["屈萬里"],