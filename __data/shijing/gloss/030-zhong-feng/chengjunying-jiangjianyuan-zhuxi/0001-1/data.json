{"version":1,"page":{"kind":"gloss-detail","href":"/shijing/gloss/030-zhong-feng/chengjunying-jiangjianyuan-zhuxi/0001-1","dataHref":"/__data/shijing/gloss/030-zhong-feng/chengjunying-jiangjianyuan-zhuxi/0001-1/data.json","title":"詩經注析 · 题解 · 程俊英、蒋见元 · 题解","description":"風 · 邶風 · 終風 · 《詩經注析》关于“题解”的注脚：程、蒋认为《终风》写的是一位妇女被丈夫轻薄、玩弄、冷落后的怨恋之情。题解指出《毛序》以庄姜遭州吁之暴为说，既与诗中“顾我则笑”“惠然肯来”等辞不…"},"payload":{"detail":{"route":{"poemId":"030-zhong-feng","materialId":"chengjunying-jiangjianyuan-zhuxi","glossId":"0001-1"},"href":"/shijing/gloss/030-zhong-feng/chengjunying-jiangjianyuan-zhuxi/0001-1","poem":{"id":"030-zhong-feng","title":"終風","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","終風"],"segments":[{"id":"seg-001","text":"终风且暴","isActive":false},{"id":"seg-002","text":"顾我则笑","isActive":false},{"id":"seg-003","text":"谑浪笑敖","isActive":false},{"id":"seg-004","text":"中心是悼","isActive":false},{"id":"seg-005","text":"终风且霾","isActive":false},{"id":"seg-006","text":"惠然肯来","isActive":false},{"id":"seg-007","text":"莫往莫来","isActive":false},{"id":"seg-008","text":"悠悠我思","isActive":false},{"id":"seg-009","text":"终风且曀","isActive":false},{"id":"seg-010","text":"不日有曀","isActive":false},{"id":"seg-011","text":"寤言不寐","isActive":false},{"id":"seg-012","text":"愿言则嚏","isActive":false},{"id":"seg-013","text":"曀曀其阴","isActive":false},{"id":"seg-014","text":"虺虺其雷","isActive":false},{"id":"seg-015","text":"寤言不寐","isActive":false},{"id":"seg-016","text":"愿言则怀","isActive":false}]},"material":{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","authors":["程俊英","蔣見元"],"contributorLine":"现代 · 程俊英、蔣見元","era":"现代","publicationYear":1991,"carrier":"PDF"},"annotation":{"id":"0001","order":1,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"题解","targetNotes":"题解总说。","sourceLabel":"第 57-58 页","sourceNotes":"书内页 57 下半至 58《题解》段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"程、蒋认为《终风》写的是一位妇女被丈夫轻薄、玩弄、冷落后的怨恋之情。题解指出《毛序》以庄姜遭州吁之暴为说，既与诗中“顾我则笑”“惠然肯来”等辞不合，也无足够确据；就诗意看，四章层层写出既恨其轻狂、又不能断绝思念的矛盾心理。","notes":null}]},"siblings":[{"id":"0001","order":1,"layerLabel":"全篇总说","title":"题解","href":"/shijing/gloss/030-zhong-feng/chengjunying-jiangjianyuan-zhuxi/0001-1","isCurrent":true},{"id":"0002","order":2,"layerLabel":"诗句片段","title":"终风且暴，顾我则笑。谑浪笑敖，中心是悼。","href":"/shijing/gloss/030-zhong-feng/chengjunying-jiangjianyuan-zhuxi/0002-1","isCurrent":false},{"id":"0003","order":3,"layerLabel":"诗句片段","title":"终风且霾，惠然肯来。莫往莫来，悠悠我思。","href":"/shijing/gloss/030-zhong-feng/chengjunying-jiangjianyuan-zhuxi/0003-1","isCurrent":false},{"id":"0004","order":4,"layerLabel":"诗句片段","title":"终风且曀，不日有曀。寤言不寐，愿言则嚏。","href":"/shijing/gloss/030-zhong-feng/chengjunying-jiangjianyuan-zhuxi/0004-1","isCurrent":false},{"id":"0005","order":5,"layerLabel":"诗句片段","title":"曀曀其阴，虺虺其雷。寤言不寐，愿言则怀。","href":"/shijing/gloss/030-zhong-feng/chengjunying-jiangjianyuan-zhuxi/0005-1","isCurrent":false}],"previous":null,"next":{"title":"终风且暴，顾我则笑。谑浪笑敖，中心是悼。","href":"/shijing/gloss/030-zhong-feng/chengjunying-jiangjianyuan-zhuxi/0002-1"},"gloss":{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"程、蒋认为《终风》写的是一位妇女被丈夫轻薄、玩弄、冷落后的怨恋之情。题解指出《毛序》以庄姜遭州吁之暴为说，既与诗中“顾我则笑”“惠然肯来”等辞不合，也无足够确据；就诗意看，四章层层写出既恨其轻狂、又不能断绝思念的矛盾心理。","notes":null,"id":"0001-1","order":1,"total":1,"annotationId":"0001","parts":[{"id":"part-1","order":1,"excerpt":"程、蒋认为《终风》写的是一位妇女被丈夫轻薄、玩弄、冷落后的怨恋之情。","anchors":[]},{"id":"part-2","order":2,"excerpt":"题解指出《毛序》以庄姜遭州吁之暴为说，既与诗中“顾我则笑”“惠然肯来”等辞不合，","anchors":[]},{"id":"part-3","order":3,"excerpt":"也无足够确据；","anchors":[]},{"id":"part-4","order":4,"excerpt":"就诗意看，四章层层写出既恨其轻狂、又不能断绝思念的矛盾心理。","anchors":[]}]}}}}
