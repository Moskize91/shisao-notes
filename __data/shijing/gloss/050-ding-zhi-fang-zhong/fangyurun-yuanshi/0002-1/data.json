urceLabel":null,"sourceNotes":"对应 EPUB item 右评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"总评","text":"方玉润右评据《序》《集传》与《春秋传》肯定此篇为美卫文公迁楚丘再造公室，并斥伪《传》以鲁僖公城楚丘实之为妄。其称文公流离后能损抑自励、与民同劳，故由“秉心塞淵”而能重天时、察地利、尽人力，终致戎马蠶桑并盛，成河北巨邦。末复感叹卫亡于宣姜而兴于其子，申明人君拨乱反正之要。","notes":null}]},"siblings":[{"id":"0001","order":1,"layerLabel":"全篇总说","title":"定之方中㊟美衛文公再造公室也。","href":"/shijing/gloss/050-ding-zhi-fang-zhong/fangyurun-yuanshi/0001-1","isCurrent":false},{"id":"0002","order":2,"layerLabel":"全篇总说","title":"总评","href":"/shijing/gloss/050-ding-zhi-fang-zhong/fangyurun-yuanshi/0002-1","isCurrent":true},{"id":"0003","order":3,"layerLabel":"全篇总说","title":"眉评","href":"/shijing/gloss/050-ding-zhi-fang-zhong/fangyurun-yuanshi/0003-1","isCurrent":false},{"id":"0004","order":4,"layerLabel":"字词注","title":"定之方中作于楚宫揆之以日椅桐梓漆爰伐琴瑟升彼虚矣望楚…","href":"/shijing/gloss/050-ding-zhi-fang-zhong/fangyurun-yuanshi/0004-1","isCurrent":false},{"id":"0005","order":5,"layerLabel":"全篇总说","title":"标韵","href":"/shijing/gloss/050-ding-zhi-fang-zhong/fangyurun-yuanshi/0005-1","isCurrent":false}],"previous":{"title":"定之方中㊟美衛文公再造公室也。","href":"/shijing/gloss/050-ding-zhi-fang-zhong/fangyurun-yuanshi/0001-1"},"next":{"title":"眉评","href":"/shijing/gloss/050-ding-zhi-fang-zhong/fangyurun-yuanshi/0003-1"},"gloss":{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"总评","text":"方玉润右评据《序》《集传》与《春秋传》肯定此篇为美卫文公迁楚丘再造公室，并斥伪《传》以鲁僖公城楚丘实之为妄。其称文公流离后能损抑自励、与民同劳，故由“秉心塞淵”而能重天时、察地利、尽人力，终致戎马蠶桑并盛，成河北巨邦。末复感叹卫亡于宣姜而兴于其子，申明人君拨乱反正之要。","notes":null,"id":"0002-1","order":1,"total":1,"annotationId":"0002","parts":[{"id":"part-1","order":1,"excerpt":"方玉润右评据《序》《集传》与《春秋传》肯定此篇为美卫文公迁楚丘再造公室，并斥伪《传》以鲁僖公城楚丘实之为妄。","anchors":[]},{"id":"part-2","order":2,"excerpt":"其称文公流离后能损抑自励、与民同劳，故由“秉心塞淵”而能重天时、察地利、尽人力，终致戎马蠶桑并盛，成河北巨邦。","anchors":[]},{"id":"part-3","order":3,"excerpt":"末复感叹卫亡于宣姜而兴于其子，申明人君拨乱反正之要。","anchors":[]}]}}}}
