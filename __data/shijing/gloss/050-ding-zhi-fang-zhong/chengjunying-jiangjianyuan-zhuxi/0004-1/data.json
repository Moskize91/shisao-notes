on":{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"灵雨既零，命彼倌人。星言夙驾，说于桑田。匪直也人，秉心塞渊，騋牝三千！","targetNotes":"第三章。","sourceLabel":"第 108 页","sourceNotes":"书内页 108 第三章注析。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","text":"末章“灵雨既零，命彼倌人。星言夙驾，说于桑田。匪直也人，秉心塞渊，騋牝三千”写卫文公勤于农政而致国富。程、蒋释“灵雨”为好雨，“倌人”为主驾者，“星言夙驾”为见星即早驾，“说于桑田”为止息桑田而务劝农桑。又释“匪直也人”为不但人民勤作，尤在君上秉心诚实深远；“騋牝三千”以良马繁多见国力充实。结句由人及政，归到卫国中兴之盛。","notes":null}]},"siblings":[{"id":"0001","order":1,"layerLabel":"全篇总说","title":"题解","href":"/shijing/gloss/050-ding-zhi-fang-zhong/chengjunying-jiangjianyuan-zhuxi/0001-1","isCurrent":false},{"id":"0002","order":2,"layerLabel":"诗句片段","title":"定之方中，作于楚宫。揆之以日，作于楚室。树之榛栗，椅…","href":"/shijing/gloss/050-ding-zhi-fang-zhong/chengjunying-jiangjianyuan-zhuxi/0002-1","isCurrent":false},{"id":"0003","order":3,"layerLabel":"诗句片段","title":"升彼虚矣，以望楚矣。望楚与堂，景山与京。降观于桑，卜…","href":"/shijing/gloss/050-ding-zhi-fang-zhong/chengjunying-jiangjianyuan-zhuxi/0003-1","isCurrent":false},{"id":"0004","order":4,"layerLabel":"诗句片段","title":"灵雨既零，命彼倌人。星言夙驾，说于桑田。匪直也人，秉…","href":"/shijing/gloss/050-ding-zhi-fang-zhong/chengjunying-jiangjianyuan-zhuxi/0004-1","isCurrent":true}],"previous":{"title":"升彼虚矣，以望楚矣。望楚与堂，景山与京。降观于桑，卜…","href":"/shijing/gloss/050-ding-zhi-fang-zhong/chengjunying-jiangjianyuan-zhuxi/0003-1"},"next":null,"gloss":{"key":"0004-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","text":"末章“灵雨既零，命彼倌人。星言夙驾，说于桑田。匪直也人，秉心塞渊，騋牝三千”写卫文公勤于农政而致国富。程、蒋释“灵雨”为好雨，“倌人”为主驾者，“星言夙驾”为见星即早驾，“说于桑田”为止息桑田而务劝农桑。又释“匪直也人”为不但人民勤作，尤在君上秉心诚实深远；“騋牝三千”以良马繁多见国力充实。结句由人及政，归到卫国中兴之盛。","notes":null,"id":"0004-1","order":1,"total":1,"annotationId":"0004","parts":[{"id":"part-1","order":1,"excerpt":"末章“灵雨既零，命彼倌人。星言夙驾，说于桑田。匪直也人，秉心塞渊，騋牝三千”写卫文公勤于农政而致国富。","anchors":[{"key":"1-1","segmentId":"seg-015","surfaceText":"灵雨既零","charStart":1,"charEnd":4},{"key":"1-2","segmentId":"seg-016","surfaceText":"命彼倌人","charStart":1,"charEnd":4},{"key":"1-3","segmentId":"seg-017","surfaceTe