{"version":1,"page":{"kind":"gloss-detail","href":"/shijing/gloss/001-guan-ju/maruichen-tongshi/0002-2","dataHref":"/__data/shijing/gloss/001-guan-ju/maruichen-tongshi/0002-2/data.json","title":"毛詩傳箋通釋 · 關關雎鳩 · 马瑞辰 · 按","description":"風 · 周南 · 關雎 · 《毛詩傳箋通釋》关于“關關雎鳩”的注脚：玉篇：「關關，和聲也。」或作咺。廣雅：「喧喧，鳥和鳴也。」關、官雙聲，故關或作咺。然喧字不見說文，蓋後人增益字也。釋文曰「本亦作鷙」。左傳杜注曰…"},"payload":{"detail":{"route":{"poemId":"001-guan-ju","materialId":"maruichen-tongshi","glossId":"0002-2"},"href":"/shijing/gloss/001-guan-ju/maruichen-tongshi/0002-2","poem":{"id":"001-guan-ju","title":"關雎","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","關雎"],"segments":[{"id":"seg-001","text":"關關雎鳩","isActive":true},{"id":"seg-002","text":"在河之洲","isActive":false},{"id":"seg-003","text":"窈窕淑女","isActive":false},{"id":"seg-004","text":"君子好逑","isActive":false},{"id":"seg-005","text":"參差荇菜","isActive":false},{"id":"seg-006","text":"左右流之","isActive":false},{"id":"seg-007","text":"窈窕淑女","isActive":false},{"id":"seg-008","text":"寤寐求之","isActive":false},{"id":"seg-009","text":"求之不得","isActive":false},{"id":"seg-010","text":"寤寐思服","isActive":false},{"id":"seg-011","text":"悠哉悠哉","isActive":false},{"id":"seg-012","text":"輾轉反側","isActive":false},{"id":"seg-013","text":"參差荇菜","isActive":false},{"id":"seg-014","text":"左右采之","isActive":false},{"id":"seg-015","text":"窈窕淑女","isActive":false},{"id":"seg-016","text":"琴瑟友之","isActive":false},{"id":"seg-017","text":"參差荇菜","isActive":false},{"id":"seg-018","text":"左右芼之","isActive":false},{"id":"seg-019","text":"窈窕淑女","isActive":false},{"id":"seg-020","text":"鐘鼓樂之","isActive":false}]},"material":{"id":"maruichen-tongshi","title":"毛詩傳箋通釋","authors":["馬瑞辰"],"contributorLine":"清 · 馬瑞辰","era":"清","publicationYear":1989,"carrier":"PDF"},"annotation":{"id":"0002","order":2,"total":12,"layer":"span","layerLabel":"诗句片段","targetText":"關關雎鳩","targetNotes":"首句。","sourceLabel":"第 61-62 页","sourceNotes":"第 61 页起，续至第 62 页上半。","notes":"以“和聲”“有別”為核心。","glosses":[{"key":"0002-2","attributionLabel":"马瑞辰","sectionLabel":"按","text":"玉篇：「關關，和聲也。」或作咺。廣雅：「喧喧，鳥和鳴也。」關、官雙聲，故關或作咺。然喧字不見說文，蓋後人增益字也。釋文曰「本亦作鷙」。左傳杜注曰：「王雎也，摯而有別，故為司馬，主法制。」是雎鳩實摯鳥。傳本作「摯而有別」，義取有別，非取其摯。后妃諸家合而一之，誤矣。淮南子泰族訓曰：「關雎興於鳥，而君子美之，為其雌雄之不乖居也。」與毛傳取其有別同義。又按說文：「鷢，白鷢也。」與爾雅所釋王雎分為二鳥。焦循曰：魚鷹尾短，飛則見尾上之白，故說文以王雎訓白鷢耳。","notes":"第 62 页该条多引异文与训诂，兼及鸟名字形辨析。"}]},"siblings":[{"id":"0001","order":1,"layerLabel":"篇序","title":"關雎后妃之德也","href":"/shijing/gloss/001-guan-ju/maruichen-tongshi/0001-1","isCurrent":false},{"id":"0002","order":2,"layerLabel":"诗句片段","title":"關關雎鳩","href":"/shijing/gloss/001-guan-ju/maruichen-tongshi/0002-1","isCurrent":true},{"id":"0003","order":3,"layerLabel":"诗句片段","title":"在河之洲","href":"/shijing/gloss/001-guan-ju/maruichen-tongshi/0003-1","isCurrent":false},{"id":"0004","order":4,"layerLabel":"诗句片段","title":"窈窕淑女","href":"/shijing/gloss/001-guan-ju/maruichen-tongshi/0004-1","isCurrent":false},{"id":"0005","order":5,"layerLabel":"诗句片段","title":"君子好逑","href":"/shijing/gloss/001-guan-ju/maruichen-tongshi/0005-1","isCurrent":false},{"id":"0006","order":6,"layerLabel":"诗句片段","title":"參差荇菜","href":"/shijing/gloss/001-guan-ju/maruichen-tongshi/0006-1","isCurrent":false},{"id":"0007","order":7,"layerLabel":"诗句片段","title":"左右流之","href":"/shijing/gloss/001-guan-ju/maruichen-tongshi/0007-1","isCurrent":false},{"id":"0008","order":8,"layerLabel":"诗句片段","title":"寤寐求之","href":"/shijing/gloss/001-guan-ju/maruichen-tongshi/0008-1","isCurrent":false},{"id":"0009","order":9,"layerLabel":"诗句片段","title":"寤寐思服","href":"/shijing/gloss/001-guan-ju/maruichen-tongshi/0009-1","isCurrent":false},{"id":"0010","order":10,"layerLabel":"诗句片段","title":"輾轉反側","href":"/shijing/gloss/001-guan-ju/maruichen-tongshi/0010-1","isCurrent":false},{"id":"0011","order":11,"layerLabel":"诗句片段","title":"琴瑟友之","href":"/shijing/gloss/001-guan-ju/maruichen-tongshi/0011-1","isCurrent":false},{"id":"0012","order":12,"layerLabel":"诗句片段","title":"鐘鼓樂之","href":"/shijing/gloss/001-guan-ju/maruichen-tongshi/0012-1","isCurrent":false}],"previous":{"title":"關雎后妃之德也"