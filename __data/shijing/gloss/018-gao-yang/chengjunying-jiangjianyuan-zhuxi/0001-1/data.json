nt":true},{"id":"0002","order":2,"layerLabel":"诗句片段","title":"羔羊之皮，素丝五紽。退食自公，委蛇委蛇。","href":"/shijing/gloss/018-gao-yang/chengjunying-jiangjianyuan-zhuxi/0002-1","isCurrent":false},{"id":"0003","order":3,"layerLabel":"诗句片段","title":"羔羊之革，素丝五緎。委蛇委蛇，自公退食。","href":"/shijing/gloss/018-gao-yang/chengjunying-jiangjianyuan-zhuxi/0003-1","isCurrent":false},{"id":"0004","order":4,"layerLabel":"诗句片段","title":"羔羊之缝，素丝五总。委蛇委蛇，退食自公。","href":"/shijing/gloss/018-gao-yang/chengjunying-jiangjianyuan-zhuxi/0004-1","isCurrent":false}],"previous":null,"next":{"title":"羔羊之皮，素丝五紽。退食自公，委蛇委蛇。","href":"/shijing/gloss/018-gao-yang/chengjunying-jiangjianyuan-zhuxi/0002-1"},"gloss":{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"题解指出此篇是一首通过衣饰步履来讽刺统治阶级官僚的诗。编者综合朱熹、崔述与姚际恒等说，强调诗中并无直陈议论，只是反复描摹“服羔裘而退食、委蛇而行”的形态，由极平淡客观的细节写出其优游自适、无所事事，从而显出讽刺意味。","notes":null,"id":"0001-1","order":1,"total":1,"annotationId":"0001"}}}}
