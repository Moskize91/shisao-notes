":[{"key":"0002-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","text":"首章“孑孑干旄，在浚之郊。素丝纰之，良马四之。彼姝者子，何以畀之”写使者建旗乘马到浚郊访贤。程、蒋释“孑孑”为特出独立之貌，“干旄”为旗竿顶端注旄牛尾之旗；“纰”是用白丝镶饰旗帜，“四之”是以四马为礼。又据胡承珙、陈奂等说，解“姝”为顺貌，“畀”为给予，末句即问贤者将以何策何道答其礼意之勤。","notes":null}]},"siblings":[{"id":"0001","order":1,"layerLabel":"全篇总说","title":"《干旄》题解","href":"/shijing/gloss/053-gan-mao/chengjunying-jiangjianyuan-zhuxi/0001-1","isCurrent":false},{"id":"0002","order":2,"layerLabel":"诗句片段","title":"孑孑干旄，在浚之郊。素丝纰之，良马四之。彼姝者子，何…","href":"/shijing/gloss/053-gan-mao/chengjunying-jiangjianyuan-zhuxi/0002-1","isCurrent":true},{"id":"0003","order":3,"layerLabel":"诗句片段","title":"孑孑干旟，在浚之都。素丝组之，良马五之。彼姝者子，何…","href":"/shijing/gloss/053-gan-mao/chengjunying-jiangjianyuan-zhuxi/0003-1","isCurrent":false},{"id":"0004","order":4,"layerLabel":"诗句片段","title":"孑孑干旌，在浚之城。素丝祝之，良马六之。彼姝者子，何…","href":"/shijing/gloss/053-gan-mao/chengjunying-jiangjianyuan-zhuxi/0004-1","isCurrent":false}],"previous":{"title":"《干旄》题解","href":"/shijing/gloss/053-gan-mao/chengjunying-jiangjianyuan-zhuxi/0001-1"},"next":{"title":"孑孑干旟，在浚之都。素丝组之，良马五之。彼姝者子，何…","href":"/shijing/gloss/053-gan-mao/chengjunying-jiangjianyuan-zhuxi/0003-1"},"gloss":{"key":"0002-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","text":"首章“孑孑干旄，在浚之郊。素丝纰之，良马四之。彼姝者子，何以畀之”写使者建旗乘马到浚郊访贤。程、蒋释“孑孑”为特出独立之貌，“干旄”为旗竿顶端注旄牛尾之旗；“纰”是用白丝镶饰旗帜，“四之”是以四马为礼。又据胡承珙、陈奂等说，解“姝”为顺貌，“畀”为给予，末句即问贤者将以何策何道答其礼意之勤。","notes":null,"id":"0002-1","order":1,"total":1,"annotationId":"0002","parts":[{"id":"part-1","order":1,"excerpt":"首章“孑孑干旄，在浚之郊。素丝纰之，良马四之。彼姝者子，何以畀之”写使者建旗乘马到浚郊访贤。","anchors":[{"key":"1-1","segmentId":"seg-001","surfaceText":"孑孑干旄","charStart":1,"charEnd":4},{"key":"1-2","segmentId":"seg-002","surfaceText":"在浚之郊","charStart":1,"charEnd":4},{"key":"1-3","segmentId":"seg-003","surfaceText":"素丝纰之","charStart":1,"charEnd":4},{"key":"1-4","segmentId":"seg-004","surfaceText":"良马四之","charStart":1,"charEnd":4},{"key":"1-5","segmentId":"seg-005","surfaceText":"彼姝者子","charStart":1,"charEnd":4},{"key":"1-6","segme