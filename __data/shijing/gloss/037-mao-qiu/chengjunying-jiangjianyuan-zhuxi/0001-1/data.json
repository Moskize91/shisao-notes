es":null}]},"siblings":[{"id":"0001","order":1,"layerLabel":"全篇总说","title":"题解","href":"/shijing/gloss/037-mao-qiu/chengjunying-jiangjianyuan-zhuxi/0001-1","isCurrent":true},{"id":"0002","order":2,"layerLabel":"诗句片段","title":"旄丘之葛兮，何诞之节兮。叔兮伯兮，何多日也。","href":"/shijing/gloss/037-mao-qiu/chengjunying-jiangjianyuan-zhuxi/0002-1","isCurrent":false},{"id":"0003","order":3,"layerLabel":"诗句片段","title":"何其处也，必有与也。何其久也，必有以也。","href":"/shijing/gloss/037-mao-qiu/chengjunying-jiangjianyuan-zhuxi/0003-1","isCurrent":false},{"id":"0004","order":4,"layerLabel":"诗句片段","title":"狐裘蒙戎，匪车不东。叔兮伯兮，靡所与同。","href":"/shijing/gloss/037-mao-qiu/chengjunying-jiangjianyuan-zhuxi/0004-1","isCurrent":false},{"id":"0005","order":5,"layerLabel":"诗句片段","title":"琐兮尾兮，流离之子。叔兮伯兮，褎如充耳。","href":"/shijing/gloss/037-mao-qiu/chengjunying-jiangjianyuan-zhuxi/0005-1","isCurrent":false}],"previous":null,"next":{"title":"旄丘之葛兮，何诞之节兮。叔兮伯兮，何多日也。","href":"/shijing/gloss/037-mao-qiu/chengjunying-jiangjianyuan-zhuxi/0002-1"},"gloss":{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"程俊英、蒋见元把《旄丘》解释为流亡到卫国的黎国人盼卫救济而久不得助之诗，基本承《诗序》“责卫伯不能修方伯连率之职”一路，但强调诗中最终情绪已从责卫转成绝望，实含劝归之意。","notes":null,"id":"0001-1","order":1,"total":1,"annotationId":"0001","parts":[{"id":"part-1","order":1,"excerpt":"程俊英、蒋见元把《旄丘》解释为流亡到卫国的黎国人盼卫救济而久不得助之诗，基本承《诗序》“责卫伯不能修方伯连率之职”一路，但强调诗中最终情绪已从责卫转成绝望，实含劝归之意。","anchors":[]}]}}}}
