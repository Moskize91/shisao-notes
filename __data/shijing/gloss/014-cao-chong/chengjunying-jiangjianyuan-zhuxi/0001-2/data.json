1","order":1,"total":17,"layer":"global","layerLabel":"全篇总说","targetText":"【题解】","targetNotes":null,"sourceLabel":"第 26 页","sourceNotes":"书内页 26《草虫》题解。","notes":null,"glosses":[{"key":"0001-2","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"此诗主题与卷耳相同都是思念行役的丈夫，表现手法也和卷耳相似，都借想象寄托心中的愁思。卷耳作者，本不知其夫近况如何，诗中却着重描写旅途的借酒浇愁和劳苦之状；此诗原写“未见君子”时忡忡、惙惙的忧心，诗中却偏添上一段既见其夫的喜悦之情。对作者来说，这原是出于无奈的自我宽慰和陶醉，而两层描写却形成了强烈的对照。这种虚幻的喜悦之情，恰如镜子，照出诗人真实的痛苦之心。所流露的喜悦愈甚，其思念之情就愈切，而无法相见的痛苦亦愈深。李商隐的名篇夜雨寄北，在表现手法上即受此诗的影响。由于对比能产生强烈的艺术效果，故对后世诗文的影响尤大，如欧阳修生查子、柳永戚氏、周邦彦过秦楼、李清照永遇乐等，均通过今昔对比、环境对比、哀乐对比，从而使心中难堪和难喻之情，得到深切的表现。","notes":null}]},"siblings":[{"id":"0001","order":1,"layerLabel":"全篇总说","title":"【题解】","href":"/shijing/gloss/014-cao-chong/chengjunying-jiangjianyuan-zhuxi/0001-1","isCurrent":true},{"id":"0002","order":2,"layerLabel":"诗句片段","title":"喓喓","href":"/shijing/gloss/014-cao-chong/chengjunying-jiangjianyuan-zhuxi/0002-1","isCurrent":false},{"id":"0003","order":3,"layerLabel":"诗句片段","title":"草虫","href":"/shijing/gloss/014-cao-chong/chengjunying-jiangjianyuan-zhuxi/0003-1","isCurrent":false},{"id":"0004","order":4,"layerLabel":"诗句片段","title":"趯趯","href":"/shijing/gloss/014-cao-chong/chengjunying-jiangjianyuan-zhuxi/0004-1","isCurrent":false},{"id":"0005","order":5,"layerLabel":"诗句片段","title":"阜螽","href":"/shijing/gloss/014-cao-chong/chengjunying-jiangjianyuan-zhuxi/0005-1","isCurrent":false},{"id":"0006","order":6,"layerLabel":"诗句片段","title":"忧心忡忡","href":"/shijing/gloss/014-cao-chong/chengjunying-jiangjianyuan-zhuxi/0006-1","isCurrent":false},{"id":"0007","order":7,"layerLabel":"诗句片段","title":"亦既见止，亦既觏止","href":"/shijing/gloss/014-cao-chong/chengjunying-jiangjianyuan-zhuxi/0007-1","isCurrent":false},{"id":"0008","order":8,"layerLabel":"诗句片段","title":"亦既觏止","href":"/shijing/gloss/014-cao-chong/chengjunying-jiangjianyuan-zhuxi/0008-1","isCurrent":false},{"id":"0009","order":9,"layerLabel":"诗句片段","title":"我心则降","href":"/shijing/gloss/014-cao-chong/chengjunying-jiangjianyuan-zhuxi/0009-1","isCurrent":false},{"id":"0010","order":10,"layerLabel":"全篇总说","title":"韵读","href":"/shijing/gloss/014-cao-chong/chengjunying-jiangjianyuan-zhuxi/0010-1","isCurrent":false},{"id":"0011","order":11,"layerLabel":"诗句片段","title":"陟彼南山","href":"/shijing/gloss/014-cao-chong/chengjunying-jiangjianyuan-zhuxi/0011-1","isCurrent":false},{"id":"0012","order":12,"layerLabel":"诗句片段","title":"言采其蕨","href":"/shijing/gloss/014-cao-chong/chengjunying-jiangjianyuan-zhuxi/0012-1","isCurrent":false},{"id":"0013","order":13,"layerLabel":"诗句片段","title":"忧心惙惙","href":"/shijing/gloss/014-cao-chong/chengjunying-jiangjianyuan-zhuxi/0013-1","isCurrent":false},{"id":"0014","order":14,"layerLabel":"诗句片段","title":"我心则说","href":"/shijing/gloss/014-cao-chong/chengjunying-jiangjianyuan-zhuxi/0014-1","isCurrent":false},{"id":"0015","order":15,"layerLabel":"全篇总说","title":"韵读","href":"/shijing/gloss/014-cao-chong/chengjunying-jiangjianyuan-zhuxi/0015-1","isCurrent":false},{"id":"0016","order":16,"layerLabel":"诗句片段","title":"言采其薇","href":"/shijing/gloss/014-cao-chong/chengjunying-jiangjianyuan-zhuxi/0016-1","isCurrent":false},{"id":"0017","order":17,"layerLabel":"诗句片段","title":"我心则夷","href":"/shijing/gloss/014-cao-chong/chengjunying-jiangjianyuan-zhuxi/0017-1","isCurrent":false}],"previous":null,"next":{"title":"喓喓","href":"/shijing/gloss/014-cao-chong/chengjunying-jiangjianyuan-zhuxi/0002-1"},"gloss":{"key":"0001-2","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"此诗主题与卷耳相同都是思念行役的丈夫，表现手法也和卷耳相似，都借想象寄托心中的愁思。卷耳作者，本不知其夫近况如何，诗中却着重描写旅途的借酒浇愁和劳苦之状；此诗原写“未见君子”时忡忡、惙惙的忧心，诗中却偏添上一段既见其夫的喜悦之情。对作者来说，这原是出于无奈的自我宽慰和陶醉，而两层描写却形成了强烈的对照。这种虚幻的喜悦之情，恰如镜子，照出诗人真实的痛苦之心。所流露的喜悦愈甚，其思念之情就愈切，而无法相见的痛苦亦愈深。李商隐的名篇夜雨寄北，在表现手法上即受此诗的影响。由于对比能产生强烈的艺术效果，故对后世诗文的影响尤大，如欧阳修生查子、柳永戚氏、周邦彦过秦楼、李清照永遇乐等，均通过今昔对比、环境对比、哀乐对比，从而使心中难堪和难喻之情，得到深切的表现。","notes":null,"id":"0001-2","order":2,"total":2,"annotationId":"0001","parts":[{"id":"part-1","order":1,"excerpt":"此诗主题与卷耳相同都是思念行役的丈夫，表现手法也和卷耳相似，都借想象寄托心中的愁思。卷耳作者，本不知其夫近况如何，诗中却着重描写旅途的借酒浇愁和劳苦之状；此诗原写“未见君子”时忡忡、惙惙的忧心，诗中却偏添上一段既见其夫的喜悦之情。对作者来说，这原是出于无奈的自我宽慰和陶醉，而两层描写却形成了强烈的对照。这种虚幻的喜悦之情，恰如镜子，照出诗人真实的痛苦之心。所流露的喜悦愈甚，其思念之情就愈切，而无法相见的痛苦亦愈深。李商隐的名篇夜雨寄北，在表现手法上即受此诗的影响。由于对比能产生强烈的艺术效果，故对后世诗文的影响尤大，如欧阳修生查子、柳永戚氏、周邦彦过秦楼、李清照永遇乐等，均通过今昔对比、环境对比、哀乐对比，从而使心中难堪和难喻之情，得到深切的表现。","anchors":[]}]}}}}
