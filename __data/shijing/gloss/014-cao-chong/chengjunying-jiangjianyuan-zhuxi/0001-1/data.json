1","order":1,"total":17,"layer":"global","layerLabel":"全篇总说","targetText":"【题解】","targetNotes":null,"sourceLabel":"第 26 页","sourceNotes":"书内页 26《草虫》题解。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"这是一首思妇诗。戴震诗经补注：“草虫感念君子行役之诗也。”诗中的主人是一位采菜的女子。第一章叙述在秋天蝉鸣虫跳的季节她忧心忡忡地思念在外行役的丈夫并想象着团聚的欢乐。第二、三章遥叙到了春天采蕨薇菜的时候，她的丈夫还不见回来，而她却仍旧幻想着重聚的情景。诗通过物候的更易和内心变化的描写衬托出别离之苦。王照圆说：“两年事尔。君子行役当春夏间涉秋未归故感虫鸣而思。至来年春夏犹未归，故复有后二章。”其实，每章的“既见”、“既觏”，都是想象之辞。","notes":null}]},"siblings":[{"id":"0001","order":1,"layerLabel":"全篇总说","title":"【题解】","href":"/shijing/gloss/014-cao-chong/chengjunying-jiangjianyuan-zhuxi/0001-1","isCurrent":true},{"id":"0002","order":2,"layerLabel":"诗句片段","title":"喓喓","href":"/shijing/gloss/014-cao-chong/chengjunying-jiangjianyuan-zhuxi/0002-1","isCurrent":false},{"id":"0003","order":3,"layerLabel":"诗句片段","title":"草虫","href":"/shijing/gloss/014-cao-chong/chengjunying-jiangjianyuan-zhuxi/0003-1","isCurrent":false},{"id":"0004","order":4,"layerLabel":"诗句片段","title":"趯趯","href":"/shijing/gloss/014-cao-chong/chengjunying-jiangjianyuan-zhuxi/0004-1","isCurrent":false},{"id":"0005","order":5,"layerLabel":"诗句片段","title":"阜螽","href":"/shijing/gloss/014-cao-chong/chengjunying-jiangjianyuan-zhuxi/0005-1","isCurrent":false},{"id":"0006","order":6,"layerLabel":"诗句片段","title":"忧心忡忡","href":"/shijing/gloss/014-cao-chong/chengjunying-jiangjianyuan-zhuxi/0006-1","isCurrent":false},{"id":"0007","order":7,"layerLabel":"诗句片段","title":"亦既见止，亦既觏止","href":"/shijing/gloss/014-cao-chong/chengjunying-jiangjianyuan-zhuxi/0007-1","isCurrent":false},{"id":"0008","order":8,"layerLabel":"诗句片段","title":"亦既觏止","href":"/shijing/gloss/014-cao-chong/chengjunying-jiangjianyuan-zhuxi/0008-1","isCurrent":false},{"id":"0009","order":9,"layerLabel":"诗句片段","title":"我心则降","href":"/shijing/gloss/014-cao-chong/chengjunying-jiangjianyuan-zhuxi/0009-1","isCurrent":false},{"id":"0010","order":10,"layerLabel":"全篇总说","title":"韵读","href":"/shijing/gloss/014-cao-chong/chengjunying-jiangjianyuan-zhuxi/0010-1","isCurrent":false},{"id":"0011","order":11,"layerLabel":"诗句片段","title":"陟彼南山","href":"/shijing/gloss/014-cao-chong/chengjunying-jiangjianyuan-zhuxi/0011-1","isCurrent":false},{"id":"0012","order":12,"layerLabel":"诗句片段","title":"言采其蕨","href":"/shijing/gloss/014-cao-chong/chengjunying-jiangjianyuan-zhuxi/0012-1","isCurrent":false},{"id":"0013","order":13,"layerLabel":"诗句片段","title":"忧心惙惙","href":"/shijing/gloss/014-cao-chong/chengjunying-jiangjianyuan-zhuxi/0013-1","isCurrent":false},{"id":"0014","order":14,"layerLabel":"诗句片段","title":"我心则说","href":"/shijing/gloss/014-cao-chong/chengjunying-jiangjianyuan-zhuxi/0014-1","isCurrent":false},{"id":"0015","order":15,"layerLabel":"全篇总说","title":"韵读","href":"/shijing/gloss/014-cao-chong/chengjunying-jiangjianyuan-zhuxi/0015-1","isCurrent":false},{"id":"0016","order":16,"layerLabel":"诗句片段","title":"言采其薇","href":"/shijing/gloss/014-cao-chong/chengjunying-jiangjianyuan-zhuxi/0016-1","isCurrent":false},{"id":"0017","order":17,"layerLabel":"诗句片段","title":"我心则夷","href":"/shijing/gloss/014-cao-chong/chengjunying-jiangjianyuan-zhuxi/0017-1","isCurrent":false}],"previous":null,"next":{"title":"喓喓","href":"/shijing/gloss/014-cao-chong/chengjunying-jiangjianyuan-zhuxi/0002-1"},"gloss":{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"这是一首思妇诗。戴震诗经补注：“草虫感念君子行役之诗也。”诗中的主人是一位采菜的女子。第一章叙述在秋天蝉鸣虫跳的季节她忧心忡忡地思念在外行役的丈夫并想象着团聚的欢乐。第二、三章遥叙到了春天采蕨薇菜的时候，她的丈夫还不见回来，而她却仍旧幻想着重聚的情景。诗通过物候的更易和内心变化的描写衬托出别离之苦。王照圆说：“两年事尔。君子行役当春夏间涉秋未归故感虫鸣而思。至来年春夏犹未归，故复有后二章。”其实，每章的“既见”、“既觏”，都是想象之辞。","notes":null,"id":"0001-1","order":1,"total":2,"annotationId":"0001","parts":[{"id":"part-1","order":1,"excerpt":"这是一首思妇诗。戴震诗经补注：“草虫感念君子行役之诗也。”诗中的主人是一位采菜的女子。第一章叙述在秋天蝉鸣虫跳的季节她忧心忡忡地思念在外行役的丈夫并想象着团聚的欢乐。第二、三章遥叙到了春天采蕨薇菜的时候，她的丈夫还不见回来，而她却仍旧幻想着重聚的情景。诗通过物候的更易和内心变化的描写衬托出别离之苦。王照圆说：“两年事尔。君子行役当春夏间涉秋未归故感虫鸣而思。至来年春夏犹未归，故复有后二章。”其实，每章的“既见”、“既觏”，都是想象之辞。","anchors":[]}]}}}}
