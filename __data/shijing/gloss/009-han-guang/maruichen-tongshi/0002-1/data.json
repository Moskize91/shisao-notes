otation":{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"南有喬木，不可休息。漢有游女，不可求思。漢之廣矣，不可泳思。江之永矣，不可方思。","targetNotes":"首章考释。","sourceLabel":"第 92-93 页","sourceNotes":"第 92 页起首章注释，续见 /tmp/hanguang-pages/maruichen-2.png 上段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"马瑞辰","sectionLabel":"按","text":"瑞辰释“喬木”为高而难就之木，借以兴游女之不可狎；又辨“休息”古本或作“休思”，“思”仍为语辞。其尤着力于“泳”“方”二字，谓前者是潜行涉水，后者是凭桴横渡，皆从不可渡写到不可求，故首章四句层层转深。","notes":"依据第 92-93 页首章提要。"}]},"siblings":[{"id":"0001","order":1,"layerLabel":"全篇总说","title":"《漢廣》江漢比興與不可求之旨","href":"/shijing/gloss/009-han-guang/maruichen-tongshi/0001-1","isCurrent":false},{"id":"0002","order":2,"layerLabel":"诗句片段","title":"南有喬木，不可休息。漢有游女，不可求思。漢之廣矣，不…","href":"/shijing/gloss/009-han-guang/maruichen-tongshi/0002-1","isCurrent":true},{"id":"0003","order":3,"layerLabel":"诗句片段","title":"翹翹錯薪，言刈其楚。之子于歸，言秣其馬。漢之廣矣，不…","href":"/shijing/gloss/009-han-guang/maruichen-tongshi/0003-1","isCurrent":false},{"id":"0004","order":4,"layerLabel":"诗句片段","title":"翹翹錯薪，言刈其蔞。之子于歸，言秣其駒。漢之廣矣，不…","href":"/shijing/gloss/009-han-guang/maruichen-tongshi/0004-1","isCurrent":false}],"previous":{"title":"《漢廣》江漢比興與不可求之旨","href":"/shijing/gloss/009-han-guang/maruichen-tongshi/0001-1"},"next":{"title":"翹翹錯薪，言刈其楚。之子于歸，言秣其馬。漢之廣矣，不…","href":"/shijing/gloss/009-han-guang/maruichen-tongshi/0003-1"},"gloss":{"key":"0002-1","attributionLabel":"马瑞辰","sectionLabel":"按","text":"瑞辰释“喬木”为高而难就之木，借以兴游女之不可狎；又辨“休息”古本或作“休思”，“思”仍为语辞。其尤着力于“泳”“方”二字，谓前者是潜行涉水，后者是凭桴横渡，皆从不可渡写到不可求，故首章四句层层转深。","notes":"依据第 92-93 页首章提要。","id":"0002-1","order":1,"total":1,"annotationId":"0002"}}}}
