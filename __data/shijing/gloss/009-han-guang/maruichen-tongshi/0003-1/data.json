otation":{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"翹翹錯薪，言刈其楚。之子于歸，言秣其馬。漢之廣矣，不可泳思。江之永矣，不可方思。","targetNotes":"第二章考释。","sourceLabel":"第 93 页","sourceNotes":"第 93 页中段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"马瑞辰","sectionLabel":"按","text":"瑞辰以“翹翹錯薪”为高起错杂之薪束，认为“言刈其楚”并非徒叙樵采，而是借取其尤美者以比所慕之女；“之子于歸，言秣其馬”则转为设想其嫁时备马致礼，以见爱慕而不失于礼，末仍以江汉叠句收回不可得之意。","notes":"依据第 93 页第二章提要。"}]},"siblings":[{"id":"0001","order":1,"layerLabel":"全篇总说","title":"《漢廣》江漢比興與不可求之旨","href":"/shijing/gloss/009-han-guang/maruichen-tongshi/0001-1","isCurrent":false},{"id":"0002","order":2,"layerLabel":"诗句片段","title":"南有喬木，不可休息。漢有游女，不可求思。漢之廣矣，不…","href":"/shijing/gloss/009-han-guang/maruichen-tongshi/0002-1","isCurrent":false},{"id":"0003","order":3,"layerLabel":"诗句片段","title":"翹翹錯薪，言刈其楚。之子于歸，言秣其馬。漢之廣矣，不…","href":"/shijing/gloss/009-han-guang/maruichen-tongshi/0003-1","isCurrent":true},{"id":"0004","order":4,"layerLabel":"诗句片段","title":"翹翹錯薪，言刈其蔞。之子于歸，言秣其駒。漢之廣矣，不…","href":"/shijing/gloss/009-han-guang/maruichen-tongshi/0004-1","isCurrent":false}],"previous":{"title":"南有喬木，不可休息。漢有游女，不可求思。漢之廣矣，不…","href":"/shijing/gloss/009-han-guang/maruichen-tongshi/0002-1"},"next":{"title":"翹翹錯薪，言刈其蔞。之子于歸，言秣其駒。漢之廣矣，不…","href":"/shijing/gloss/009-han-guang/maruichen-tongshi/0004-1"},"gloss":{"key":"0003-1","attributionLabel":"马瑞辰","sectionLabel":"按","text":"瑞辰以“翹翹錯薪”为高起错杂之薪束，认为“言刈其楚”并非徒叙樵采，而是借取其尤美者以比所慕之女；“之子于歸，言秣其馬”则转为设想其嫁时备马致礼，以见爱慕而不失于礼，末仍以江汉叠句收回不可得之意。","notes":"依据第 93 页第二章提要。","id":"0003-1","order":1,"total":1,"annotationId":"0003"}}}}
