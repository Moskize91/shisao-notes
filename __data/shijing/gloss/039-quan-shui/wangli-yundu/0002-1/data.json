{"version":1,"page":{"kind":"gloss-detail","href":"/shijing/gloss/039-quan-shui/wangli-yundu/0002-1","dataHref":"/__data/shijing/gloss/039-quan-shui/wangli-yundu/0002-1/data.json","title":"詩經韻讀 · 毖彼泉水，亦流于淇。有怀于卫，靡日不思。变彼诸姬，聊与之谋。出宿于泲，饮饯于祢。女子有行，远父母兄弟。问我诸姑，遂及伯姊。出宿于干，饮饯于言。载脂载辖，还车言迈。遄臻于卫，不瑕有害？我思肥泉，兹之永叹。思须与漕，我心悠悠。驾言出游，以写我忧。 · 王力 · 韵读","description":"風 · 邶風 · 泉水 · 《詩經韻讀》关于“毖彼泉水，亦流于淇。有怀于卫，靡日不思。变彼诸姬…”的注脚：页图可读《泉水》首章押之部，二章押脂部，末章先元后幽，而第三章则由“干、言”转到“辖、迈、害”，形成章内换韵。王力所记音值把每章韵脚排列得很清楚…"},"payload":{"detail":{"route":{"poemId":"039-quan-shui","materialId":"wangli-yundu","glossId":"0002-1"},"href":"/shijing/gloss/039-quan-shui/wangli-yundu/0002-1","poem":{"id":"039-quan-shui","title":"泉水","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","泉水"],"segments":[{"id":"seg-001","text":"毖彼泉水","isActive":true},{"id":"seg-002","text":"亦流于淇","isActive":true},{"id":"seg-003","text":"有怀于卫","isActive":true},{"id":"seg-004","text":"靡日不思","isActive":true},{"id":"seg-005","text":"变彼诸姬","isActive":true},{"id":"seg-006","text":"聊与之谋","isActive":true},{"id":"seg-007","text":"出宿于泲","isActive":true},{"id":"seg-008","text":"饮饯于祢","isActive":true},{"id":"seg-009","text":"女子有行","isActive":true},{"id":"seg-010","text":"远父母兄弟","isActive":true},{"id":"seg-011","text":"问我诸姑","isActive":true},{"id":"seg-012","text":"遂及伯姊","isActive":true},{"id":"seg-013","text":"出宿于干","isActive":true},{"id":"seg-014","text":"饮饯于言","isActive":true},{"id":"seg-015","text":"载脂载辖","isActive":true},{"id":"seg-016","text":"还车言迈","isActive":true},{"id":"seg-017","text":"遄臻于卫","isActive":true},{"id":"seg-018","text":"不瑕有害","isActive":true},{"id":"seg-019","text":"我思肥泉","isActive":true},{"id":"seg-020","text":"兹之永叹","isActive":true},{"id":"seg-021","text":"思须与漕","isActive":true},{"id":"seg-022","text":"我心悠悠","isActive":true},{"id":"seg-023","text":"驾言出游","isActive":true},{"id":"seg-024","text":"以写我忧","isActive":true}]},"material":{"id":"wangli-yundu","title":"詩經韻讀","authors":["王力"],"contributorLine":"现代 · 王力","era":"现代","publicat