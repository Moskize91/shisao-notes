tionYear":1847,"carrier":"PDF"},"annotation":{"id":"0002","order":2,"total":2,"layer":"span","layerLabel":"诗句片段","targetText":"毖彼泉水亦流于淇有懷于衛靡日不思孌彼諸姬聊與之謀出宿于泲飲餞于禰女子有行遠父母兄弟問我諸姑遂及伯姊出宿于干飲餞于言載脂載舝還車言邁遄臻于衛不瑕有害我思肥泉茲之永嘆思須與漕我心悠悠駕言出遊以寫我憂","targetNotes":"通篇经传疏解。","sourceLabel":"第 67-68 页","sourceNotes":"据第 67-68 页《泉水》经传疏。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"陈奂疏《泉水》时，以伯姬嫁于诸侯、父母既终而不得归宁为全诗主旨。其疏先就“毖彼泉水，亦流于淇”“有懷于衛”说明泉水、淇水皆卫地，见思卫之情；又以“孌彼諸姬，聊與之謀”“問我諸姑，遂及伯姊”申明所谋所问都围绕归卫与亲族称谓。至“載脂載舝，還車言邁，遄臻于衛，不瑕有害”则写欲归而终以礼义为止，末章“我思肥泉”“思須與漕”“駕言出遊，以寫我憂”复归于思卫不已、不得已而借出游写忧。","notes":null}]},"siblings":[{"id":"0001","order":1,"layerLabel":"篇序","title":"泉水刺伯姬也嫁于諸侯而國人思之故作是詩也","href":"/shijing/gloss/039-quan-shui/chenhuan-chuanshu/0001-1","isCurrent":false},{"id":"0002","order":2,"layerLabel":"诗句片段","title":"毖彼泉水亦流于淇有懷于衛靡日不思孌彼諸姬聊與之謀出宿…","href":"/shijing/gloss/039-quan-shui/chenhuan-chuanshu/0002-1","isCurrent":true}],"previous":{"title":"泉水刺伯姬也嫁于諸侯而國人思之故作是詩也","href":"/shijing/gloss/039-quan-shui/chenhuan-chuanshu/0001-1"},"next":null,"gloss":{"key":"0002-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"陈奂疏《泉水》时，以伯姬嫁于诸侯、父母既终而不得归宁为全诗主旨。其疏先就“毖彼泉水，亦流于淇”“有懷于衛”说明泉水、淇水皆卫地，见思卫之情；又以“孌彼諸姬，聊與之謀”“問我諸姑，遂及伯姊”申明所谋所问都围绕归卫与亲族称谓。至“載脂載舝，還車言邁，遄臻于衛，不瑕有害”则写欲归而终以礼义为止，末章“我思肥泉”“思須與漕”“駕言出遊，以寫我憂”复归于思卫不已、不得已而借出游写忧。","notes":null,"id":"0002-1","order":1,"total":1,"annotationId":"0002","parts":[{"id":"part-1","order":1,"excerpt":"陈奂疏《泉水》时，以伯姬嫁于诸侯、父母既终而不得归宁为全诗主旨。其疏先就“毖彼泉水，亦流于淇”“有懷于衛”说明泉水、淇水皆卫地，见思卫之情；","anchors":[{"key":"1-1","segmentId":"seg-001","surfaceText":"毖彼泉水","charStart":1,"charEnd":4},{"key":"1-2","segmentId":"seg-002","surfaceText":"亦流于淇","charStart":1,"charEnd":4},{"key":"1-3","segmentId":"seg-003","surfaceText":"有懷于衛","charStart":1,"charEnd":4}]},{"id":"part-2","order":2,"excerpt":"又以“孌彼諸姬，聊與之謀”“問我諸姑，遂及伯姊”申明所谋所问都围绕归卫与亲族称谓。","anchors":[{"key":"2-1","segmentId":"seg-005","surfaceText":"孌彼諸姬","charStart":1,"charEnd":4},{"key":"2-2","segmentId":"seg-006","surfaceText":"聊與之謀","c