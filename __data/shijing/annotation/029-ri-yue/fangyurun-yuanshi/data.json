{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/029-ri-yue/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/029-ri-yue/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 日月 · 注释总览","description":"風 · 邶風 · 日月 · 汇集《诗经原始(上下)》关于《日月》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"029-ri-yue","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/029-ri-yue/fangyurun-yuanshi","poem":{"id":"029-ri-yue","title":"日月","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","日月"],"segments":[{"id":"seg-001","text":"日居月諸","isActive":false},{"id":"seg-002","text":"照臨下土","isActive":false},{"id":"seg-003","text":"乃如之人兮","isActive":false},{"id":"seg-004","text":"逝不古處","isActive":false},{"id":"seg-005","text":"胡能有定","isActive":false},{"id":"seg-006","text":"寧不我顧","isActive":false},{"id":"seg-007","text":"日居月諸","isActive":false},{"id":"seg-008","text":"下土是冒","isActive":false},{"id":"seg-009","text":"乃如之人兮","isActive":false},{"id":"seg-010","text":"逝不相好","isActive":false},{"id":"seg-011","text":"胡能有定","isActive":false},{"id":"seg-012","text":"寧不我報","isActive":false},{"id":"seg-013","text":"日居月諸","isActive":false},{"id":"seg-014","text":"出自東方","isActive":false},{"id":"seg-015","text":"乃如之人兮","isActive":false},{"id":"seg-016","text":"德音無良","isActive":false},{"id":"seg-017","text":"胡能有定","isActive":false},{"id":"seg-018","text":"俾也可忘","isActive":false},{"id":"seg-019","text":"日居月諸","isActive":false},{"id":"seg-020","text":"東方自出","isActive":false},{"id":"seg-021","text":"父兮母兮","isActive":false},{"id":"seg-022","text":"畜我不卒","isActive":false},{"id":"seg-023","text":"胡能有定","isActive":false},{"id":"seg-024","text":"報我不述","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"日月㊟衛莊姜傷己不見答於莊公也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标题段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注","text":"方玉润在题注中径定《日月》为卫庄姜伤己不见答于庄公之诗，直接把怨怼对象落到庄公本人。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"总评","targetNotes":"通篇总评。","sourceLabel":null,"sourceNotes":"对应 EPUB item 总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"总评","text":"总评中方玉润明确反驳《大序》“遭州吁之难”之说，认为此诗自是庄姜为庄公而作。全篇反复追问“胡能有定”，正是痛诉庄公之心无常，不以古夫妇之道待己；末章呼父母，虽怨极而仍云“报我不述”，尤见其情厚而守正。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"眉评","targetNotes":"各章眉评撮要。","sourceLabel":null,"sourceNotes":"对应 EPUB item 眉评内容。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"眉评","text":"方玉润眉评以为四章层层逼进：前二章责其不顾不报，三章进而怨其“德音无良”，四章则因伤极而呼父母。其评语始终扣住“胡能有定”一句，认为全诗之势便由此往复回环。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"term","layerLabel":"字词注","targetText":"逝不古處胡能有定下土是冒寧不我報畜我不卒報我不述","targetNotes":"集释撮要。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":"集释","text":"方玉润集释云：“逝”为发语辞，“胡”“寧”皆何，“冒”为覆，“報”为答，“畜”为養，“卒”为終，“不述”为不欲稱述。整组训诂用来说明诗人所怨者，正在夫心反覆、恩爱不能有终。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"标韵","targetNotes":"四章韵脚撮述。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标韵段。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"方玉润","sectionLabel":"标韵","text":"方玉润分章标出韵脚：首章“土、處、顧”，次章“冒、好、報”，三章“方、良、忘”，四章“出、卒、述”。他借此显示四章各自成韵，而都围绕同一句“胡能有定”回环唱叹。","notes":null}]}]}}}
