{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/029-ri-yue/quwanli-quanshi","dataHref":"/__data/shijing/annotation/029-ri-yue/quwanli-quanshi/data.json","title":"詩經詮釋 · 日月 · 注释总览","description":"風 · 邶風 · 日月 · 汇集《詩經詮釋》关于《日月》的 2 条注释，含 2 条注脚。"},"payload":{"detail":{"route":{"poemId":"029-ri-yue","materialId":"quwanli-quanshi"},"href":"/shijing/annotation/029-ri-yue/quwanli-quanshi","poem":{"id":"029-ri-yue","title":"日月","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","日月"],"segments":[{"id":"seg-001","text":"日居月诸","isActive":false},{"id":"seg-002","text":"照临下土","isActive":false},{"id":"seg-003","text":"乃如之人兮","isActive":false},{"id":"seg-004","text":"逝不古处","isActive":false},{"id":"seg-005","text":"胡能有定","isActive":false},{"id":"seg-006","text":"宁不我顾","isActive":false},{"id":"seg-007","text":"日居月诸","isActive":false},{"id":"seg-008","text":"下土是冒","isActive":false},{"id":"seg-009","text":"乃如之人兮","isActive":false},{"id":"seg-010","text":"逝不相好","isActive":false},{"id":"seg-011","text":"胡能有定","isActive":false},{"id":"seg-012","text":"宁不我报","isActive":false},{"id":"seg-013","text":"日居月诸","isActive":false},{"id":"seg-014","text":"出自东方","isActive":false},{"id":"seg-015","text":"乃如之人兮","isActive":false},{"id":"seg-016","text":"德音无良","isActive":false},{"id":"seg-017","text":"胡能有定","isActive":false},{"id":"seg-018","text":"俾也可忘","isActive":false},{"id":"seg-019","text":"日居月诸","isActive":false},{"id":"seg-020","text":"东方自出","isActive":false},{"id":"seg-021","text":"父兮母兮","isActive":false},{"id":"seg-022","text":"畜我不卒","isActive":false},{"id":"seg-023","text":"胡能有定","isActive":false},{"id":"seg-024","text":"报我不述","isActive":false}]},"material":{"id":"quwanli-quanshi","title":"詩經詮釋","authors":["屈萬里"],"contributorLine":"现代 · 屈萬里","era":"现代","publicationYear":1983,"carrier":"PDF"},"stats":{"annotationCount":2,"glossCount":2},"annotations":[{"id":"0001","order":1,"total":2,"layer":"global","layerLabel":"全篇总说","targetText":"全篇旨意","targetNotes":"通篇总说。","sourceLabel":"第 34 页","sourceNotes":"第 34 页可见总说。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"屈万里","sectionLabel":"注释","text":"屈万里直言此诗当是妇人不得于其夫之所作，着眼点在失偶失欢的切身怨苦，而不再深究庄姜州吁等史事。全篇借日月起兴，层层写不得其夫之顾、报、好与终养，旨在表现弃妇反复申诉之情。","notes":null}]},{"id":"0002","order":2,"total":2,"layer":"term","layerLabel":"字词注","targetText":"照临下土乃如之人兮逝不古处胡能有定下土是冒德音无良父兮母兮畜我不卒报我不述","targetNotes":"《注释》②至⑭撮要。","sourceLabel":"第 34 页","sourceNotes":"第 34 页《注释》②至⑭。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"屈万里","sectionLabel":"注释","text":"屈万里释“下土”为地上，“乃如之人”为此人，“逝”为发语词，“古”为故，“宁”为岂，“冒”为覆盖，“德音”为言语之善，“畜”为好、养，“卒”为终，“述”为循道。整组注释偏重字词训解，用以凸显妇人所怨者正在夫心反复失常。","notes":null}]}]}}}
