{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/029-ri-yue/chengjunying-jiangjianyuan-zhuxi","dataHref":"/__data/shijing/annotation/029-ri-yue/chengjunying-jiangjianyuan-zhuxi/data.json","title":"詩經注析 · 日月 · 注释总览","description":"風 · 邶風 · 日月 · 汇集《詩經注析》关于《日月》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"029-ri-yue","materialId":"chengjunying-jiangjianyuan-zhuxi"},"href":"/shijing/annotation/029-ri-yue/chengjunying-jiangjianyuan-zhuxi","poem":{"id":"029-ri-yue","title":"日月","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","日月"],"segments":[{"id":"seg-001","text":"日居月诸","isActive":false},{"id":"seg-002","text":"照临下土","isActive":false},{"id":"seg-003","text":"乃如之人兮","isActive":false},{"id":"seg-004","text":"逝不古处","isActive":false},{"id":"seg-005","text":"胡能有定","isActive":false},{"id":"seg-006","text":"宁不我顾","isActive":false},{"id":"seg-007","text":"日居月诸","isActive":false},{"id":"seg-008","text":"下土是冒","isActive":false},{"id":"seg-009","text":"乃如之人兮","isActive":false},{"id":"seg-010","text":"逝不相好","isActive":false},{"id":"seg-011","text":"胡能有定","isActive":false},{"id":"seg-012","text":"宁不我报","isActive":false},{"id":"seg-013","text":"日居月诸","isActive":false},{"id":"seg-014","text":"出自东方","isActive":false},{"id":"seg-015","text":"乃如之人兮","isActive":false},{"id":"seg-016","text":"德音无良","isActive":false},{"id":"seg-017","text":"胡能有定","isActive":false},{"id":"seg-018","text":"俾也可忘","isActive":false},{"id":"seg-019","text":"日居月诸","isActive":false},{"id":"seg-020","text":"东方自出","isActive":false},{"id":"seg-021","text":"父兮母兮","isActive":false},{"id":"seg-022","text":"畜我不卒","isActive":false},{"id":"seg-023","text":"胡能有定","isActive":false},{"id":"seg-024","text":"报我不述","isActive":false}]},"material":{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","authors":["程俊英","蔣見元"],"contributorLine":"现代 · 程俊英、蔣見元","era":"现代","publicationYear":1991,"carrier":"PDF"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"题解","targetNotes":"题解总说。","sourceLabel":"第 56 页","sourceNotes":"书内页 56《题解》段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"程、蒋对《毛序》“庄姜伤己”说持保留态度，认为就诗本身看，更像一位被丈夫冷落的妇人反复申诉怨愤。题解指出“胡能有定”是全篇诗眼，诗人屡举日月恒常，以反衬丈夫心志反复无定；末章忽呼父母，则是哀伤至极时的自然流露。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"日居月诸，照临下土。乃如之人兮，逝不古处。胡能有定，宁不我顾。","targetNotes":"首章。","sourceLabel":"第 56-57 页","sourceNotes":"书内页 56-57 首章注析。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"注析","text":"程、蒋释“乃如之人”为其丈夫，“逝不古处”是倒文，谓不能回到往日夫妇和好之常道；“顾”则是念我。首章借日月照临下土起兴，写她追问丈夫为何总不守旧情，也不回头顾念自己。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"日居月诸，下土是冒。乃如之人兮，逝不相好。胡能有定，宁不我报。","targetNotes":"第二章。","sourceLabel":"第 57 页","sourceNotes":"书内页 57 第二章注析。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"注析","text":"此章承首章推进。程、蒋释“冒”为覆盖，“报”为答；“逝不相好”即不再相亲相爱。“胡能有定”在这里仍指丈夫反复失常，末句则怨其既不与己和好，也从不答我衷情。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"日居月诸，出自东方。乃如之人兮，德音无良。胡能有定，俾也可忘。","targetNotes":"第三章。","sourceLabel":"第 57-58 页","sourceNotes":"书内页 57-58 第三章注析。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"注析","text":"程、蒋指出“德音无良”不是单说口出恶言，而是有善待我之名、无善待我之实；“俾也可忘”则是说若其心稍有定准，也许还能让我忘却前怨。第三章比前两章更深一层，从不相答转到怨其虚有美名。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"日居月诸，东方自出。父兮母兮，畜我不卒。胡能有定，报我不述。","targetNotes":"第四章。","sourceLabel":"第 58 页","sourceNotes":"书内页 58 第四章注析。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"注析","text":"程、蒋以“畜我不卒”为丈夫爱我不能终始，“报我不述”近于不循常道、不依常理。末章忽呼父母，显示弃妇情感已逼绝境；但她仍围绕“胡能有定”发问，可见全篇怨而不乱，依旧着眼于丈夫失其常道。","notes":null}]}]}}}
