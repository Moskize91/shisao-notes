{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/029-ri-yue/chenhuan-chuanshu","dataHref":"/__data/shijing/annotation/029-ri-yue/chenhuan-chuanshu/data.json","title":"詩毛氏傳疏 · 日月 · 注释总览","description":"風 · 邶風 · 日月 · 汇集《詩毛氏傳疏》关于《日月》的 2 条注释，含 2 条注脚。"},"payload":{"detail":{"route":{"poemId":"029-ri-yue","materialId":"chenhuan-chuanshu"},"href":"/shijing/annotation/029-ri-yue/chenhuan-chuanshu","poem":{"id":"029-ri-yue","title":"日月","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","日月"],"segments":[{"id":"seg-001","text":"日居月諸","isActive":false},{"id":"seg-002","text":"照臨下土","isActive":false},{"id":"seg-003","text":"乃如之人兮","isActive":false},{"id":"seg-004","text":"逝不古處","isActive":false},{"id":"seg-005","text":"胡能有定","isActive":false},{"id":"seg-006","text":"寧不我顧","isActive":false},{"id":"seg-007","text":"日居月諸","isActive":false},{"id":"seg-008","text":"下土是冒","isActive":false},{"id":"seg-009","text":"乃如之人兮","isActive":false},{"id":"seg-010","text":"逝不相好","isActive":false},{"id":"seg-011","text":"胡能有定","isActive":false},{"id":"seg-012","text":"寧不我報","isActive":false},{"id":"seg-013","text":"日居月諸","isActive":false},{"id":"seg-014","text":"出自東方","isActive":false},{"id":"seg-015","text":"乃如之人兮","isActive":false},{"id":"seg-016","text":"德音無良","isActive":false},{"id":"seg-017","text":"胡能有定","isActive":false},{"id":"seg-018","text":"俾也可忘","isActive":false},{"id":"seg-019","text":"日居月諸","isActive":false},{"id":"seg-020","text":"東方自出","isActive":false},{"id":"seg-021","text":"父兮母兮","isActive":false},{"id":"seg-022","text":"畜我不卒","isActive":false},{"id":"seg-023","text":"胡能有定","isActive":false},{"id":"seg-024","text":"報我不述","isActive":false}]},"material":{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","authors":["陳奐"],"contributorLine":"清 · 陳奐","era":"清","publicationYear":1847,"carrier":"PDF"},"stats":{"annotationCount":2,"glossCount":2},"annotations":[{"id":"0001","order":1,"total":2,"layer":"preface","layerLabel":"篇序","targetText":"日月衛莊姜傷己也遭州吁之難傷己不見答於先君以至困窮之詩也","targetNotes":"篇首小序。","sourceLabel":"第 56 页","sourceNotes":"书内页 56 篇首序文。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序","text":"序：《日月》，衛莊姜傷己也。遭州吁之難，傷己不見答於先君，以至困窮之詩也。","notes":null}]},{"id":"0002","order":2,"total":2,"layer":"span","layerLabel":"诗句片段","targetText":"日居月諸，照臨下土。乃如之人兮，逝不古處。胡能有定，寧不我顧。日居月諸，下土是冒。乃如之人兮，逝不相好。胡能有定，寧不我報。日居月諸，出自東方。乃如之人兮，德音無良。胡能有定，俾也可忘。日居月諸，東方自出。父兮母兮，畜我不卒。胡能有定，報我不述。","targetNotes":"通篇经传疏解。","sourceLabel":"第 56-57 页","sourceNotes":"据第 56-57 页《日月》经传疏。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"陈奂遵《序》旧说，以《日月》为庄姜遭州吁之难后伤己不见答于庄公之诗。其疏重在申明“逝不古处”是不以古夫妇之道相待，“胡能有定”则统摄四章，皆怨庄公之心无常；末章呼父母，亦仍归于庄姜自伤困穷、而情义未绝。","notes":null}]}]}}}
