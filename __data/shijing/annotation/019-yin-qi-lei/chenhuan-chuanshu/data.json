{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/019-yin-qi-lei/chenhuan-chuanshu","dataHref":"/__data/shijing/annotation/019-yin-qi-lei/chenhuan-chuanshu/data.json","title":"詩毛氏傳疏 · 殷其靁 · 注释总览","description":"風 · 召南 · 殷其靁 · 汇集《詩毛氏傳疏》关于《殷其靁》的 2 条注释，含 2 条注脚。"},"payload":{"detail":{"route":{"poemId":"019-yin-qi-lei","materialId":"chenhuan-chuanshu"},"href":"/shijing/annotation/019-yin-qi-lei/chenhuan-chuanshu","poem":{"id":"019-yin-qi-lei","title":"殷其靁","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","殷其靁"],"segments":[{"id":"seg-001","text":"殷其靁","isActive":false},{"id":"seg-002","text":"在南山之陽","isActive":false},{"id":"seg-003","text":"何斯違斯","isActive":false},{"id":"seg-004","text":"莫敢或遑","isActive":false},{"id":"seg-005","text":"振振君子","isActive":false},{"id":"seg-006","text":"歸哉歸哉","isActive":false},{"id":"seg-007","text":"殷其靁","isActive":false},{"id":"seg-008","text":"在南山之側","isActive":false},{"id":"seg-009","text":"何斯違斯","isActive":false},{"id":"seg-010","text":"莫敢遑息","isActive":false},{"id":"seg-011","text":"振振君子","isActive":false},{"id":"seg-012","text":"歸哉歸哉","isActive":false},{"id":"seg-013","text":"殷其靁","isActive":false},{"id":"seg-014","text":"在南山之下","isActive":false},{"id":"seg-015","text":"何斯違斯","isActive":false},{"id":"seg-016","text":"莫敢遑處","isActive":false},{"id":"seg-017","text":"振振君子","isActive":false},{"id":"seg-018","text":"歸哉歸哉","isActive":false}]},"material":{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","authors":["陳奐"],"contributorLine":"清 · 陳奐","era":"清","publicationYear":1847,"carrier":"PDF"},"stats":{"annotationCount":2,"glossCount":2},"annotations":[{"id":"0001","order":1,"total":2,"layer":"preface","layerLabel":"篇序","targetText":"殷其靁，勸以義也。","targetNotes":"篇首序文。","sourceLabel":"第 49 页","sourceNotes":"据第 49 页《殷其靁》序义。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"陈奂承《序》以《殷其靁》为大夫妻子念其从政君子、虽闵其勤劳而仍勉之以臣义之诗。其意不在思妇自伤，而在室家知王事方殷，不可因私情而废公命。","notes":null}]},{"id":"0002","order":2,"total":2,"layer":"span","layerLabel":"诗句片段","targetText":"殷其靁，在南山之陽。何斯違斯？莫敢或遑。振振君子，歸哉歸哉。殷其靁，在南山之側。何斯違斯？莫敢遑息。振振君子，歸哉歸哉。殷其靁，在南山之下。何斯違斯？莫敢遑處。振振君子，歸哉歸哉。","targetNotes":"通篇经传疏解。","sourceLabel":"第 49-50 页","sourceNotes":"据第 49-50 页《殷其靁》经传疏。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"陈奂疏解以毛郑义为纲，谓殷雷在阳、侧、下，是随雷势渐近渐下以比大夫奉王命奔驰四方；“何斯違斯”“莫敢或遑”“莫敢遑息”“莫敢遑處”层层写行役者不敢自暇。至“振振君子，歸哉歸哉”，则从大夫妻子口吻出之，虽深闵其劳苦，却终以臣子当成君事相勉，不许徒以私恩求归。","notes":null}]}]}}}
