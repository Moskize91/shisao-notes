{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/019-yin-qi-lei/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/019-yin-qi-lei/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 殷其靁 · 注释总览","description":"風 · 召南 · 殷其靁 · 汇集《诗经原始(上下)》关于《殷其靁》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"019-yin-qi-lei","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/019-yin-qi-lei/fangyurun-yuanshi","poem":{"id":"019-yin-qi-lei","title":"殷其靁","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","殷其靁"],"segments":[{"id":"seg-001","text":"殷其靁","isActive":false},{"id":"seg-002","text":"在南山之陽","isActive":false},{"id":"seg-003","text":"何斯違斯","isActive":false},{"id":"seg-004","text":"莫敢或遑","isActive":false},{"id":"seg-005","text":"振振君子","isActive":false},{"id":"seg-006","text":"歸哉歸哉","isActive":false},{"id":"seg-007","text":"殷其靁","isActive":false},{"id":"seg-008","text":"在南山之側","isActive":false},{"id":"seg-009","text":"何斯違斯","isActive":false},{"id":"seg-010","text":"莫敢遑息","isActive":false},{"id":"seg-011","text":"振振君子","isActive":false},{"id":"seg-012","text":"歸哉歸哉","isActive":false},{"id":"seg-013","text":"殷其靁","isActive":false},{"id":"seg-014","text":"在南山之下","isActive":false},{"id":"seg-015","text":"何斯違斯","isActive":false},{"id":"seg-016","text":"莫或遑處","isActive":false},{"id":"seg-017","text":"振振君子","isActive":false},{"id":"seg-018","text":"歸哉歸哉","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"殷其靁㊟諷衆士以歸周也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标题段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注","text":"方玉润开篇即改定旧说，不从思妇劝义之解，而定为“讽众士以归周”。其意在把“归哉归哉”解成相招来归之辞，所向者是闻文王之化而将归附的贤士群体。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"殷其靁，在南山之陽。何斯違斯？莫敢或遑。振振君子，歸哉歸哉。殷其靁，在南山之側。何斯違斯？莫敢遑息。振振君子，歸哉歸哉。殷其靁，在南山之下。何斯違斯？莫或遑處。振振君子，歸哉歸哉。","targetNotes":"通篇总评。","sourceLabel":null,"sourceNotes":"对应 EPUB item 正文与右《殷其靁》总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":null,"text":"方玉润力辨《小序》《大序》所谓思妇劝义皆不足据，认为此诗应是伯夷、太公辈相率归周之辞。“何斯違斯，莫敢或遑”不是妇人怨夫，而是避乱贤士自言不敢久留异地；“振振君子”亦非夫婿，而是闻文王作而振兴来归的众士。三章反复写殷雷在阳、侧、下，正如文王号令自高而下、由近及远，故诗意在群才竞赴而不胜来归恐后之心。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"眉评","targetNotes":"眉评。","sourceLabel":null,"sourceNotes":"对应 EPUB item 眉评段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"眉评","text":"眉评云“呼朋引类，相率来归，如闻其声，如见其人”，正以群士闻风竞赴的场面，概括全篇振起奔赴之势。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"term","layerLabel":"字词注","targetText":"殷其靁何斯違斯莫敢或遑振振君子","targetNotes":"集释所及名物字义。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"集释","sectionLabel":null,"text":"集释释“殷殷”为雷声，“何斯”之“斯”为此事，“違斯”之“斯”为此地，“遑”为暇，“振振”则既可训兴起，亦可训众盛。整组训释正是方玉润重解全诗的关键枢纽。","notes":null}]}]}}}
