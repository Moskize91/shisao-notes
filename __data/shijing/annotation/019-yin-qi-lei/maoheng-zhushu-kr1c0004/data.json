{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/019-yin-qi-lei/maoheng-zhushu-kr1c0004","dataHref":"/__data/shijing/annotation/019-yin-qi-lei/maoheng-zhushu-kr1c0004/data.json","title":"毛詩注疏 · 殷其靁 · 注释总览","description":"風 · 召南 · 殷其靁 · 汇集《毛詩注疏》关于《殷其靁》的 4 条注释，含 6 条注脚。"},"payload":{"detail":{"route":{"poemId":"019-yin-qi-lei","materialId":"maoheng-zhushu-kr1c0004"},"href":"/shijing/annotation/019-yin-qi-lei/maoheng-zhushu-kr1c0004","poem":{"id":"019-yin-qi-lei","title":"殷其靁","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","殷其靁"],"segments":[{"id":"seg-001","text":"殷其靁","isActive":false},{"id":"seg-002","text":"在南山之陽","isActive":false},{"id":"seg-003","text":"何斯違斯","isActive":false},{"id":"seg-004","text":"莫敢或遑","isActive":false},{"id":"seg-005","text":"振振君子","isActive":false},{"id":"seg-006","text":"歸哉歸哉","isActive":false},{"id":"seg-007","text":"殷其靁","isActive":false},{"id":"seg-008","text":"在南山之側","isActive":false},{"id":"seg-009","text":"何斯違斯","isActive":false},{"id":"seg-010","text":"莫敢遑息","isActive":false},{"id":"seg-011","text":"振振君子","isActive":false},{"id":"seg-012","text":"歸哉歸哉","isActive":false},{"id":"seg-013","text":"殷其靁","isActive":false},{"id":"seg-014","text":"在南山之下","isActive":false},{"id":"seg-015","text":"何斯違斯","isActive":false},{"id":"seg-016","text":"莫或遑處","isActive":false},{"id":"seg-017","text":"振振君子","isActive":false},{"id":"seg-018","text":"歸哉歸哉","isActive":false}]},"material":{"id":"maoheng-zhushu-kr1c0004","title":"毛詩注疏","authors":["毛亨","鄭氏","孔穎達"],"contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","era":"漢唐","publicationYear":653,"carrier":"TXT"},"stats":{"annotationCount":4,"glossCount":6},"annotations":[{"id":"0001","order":1,"total":4,"layer":"preface","layerLabel":"篇序","targetText":"殷其靁勸以義也","targetNotes":"篇首小序。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷一》“殷其靁”条序文。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序","text":"序：《殷其靁》，勸以義也。召南之大夫遠行從政，不遑寧處，其室家能閔其勤勞，勸以義也。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"殷其靁在南山之陽何斯違斯莫敢或遑振振君子歸哉歸哉","targetNotes":"首章。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷一》“殷其靁”首章。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：殷，靁聲也。山南曰陽。何此君子也。斯，此。違，去。遑，暇也。振振，信厚也。","notes":null},{"key":"0002-2","attributionLabel":"郑笺","sectionLabel":null,"text":"箋云：靁以喻號令於南山之陽，又喻其在外也。召南大夫以王命施號令於四方，猶靁殷殷然發聲於山之陽。何乎此君子，適居此，復去此，轉行遠，從事於王所命之方，無敢或閒暇時。閔其勤勞。大夫信厚之君子，為君使，功未成，歸哉歸哉！勸以為臣之義，未得歸也。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"殷其靁在南山之側何斯違斯莫敢遑息振振君子歸哉歸哉","targetNotes":"第二章。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷一》“殷其靁”第二章。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：亦在其陰與左右也。息，止也。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"殷其靁在南山之下何斯違斯莫或遑處振振君子歸哉歸哉","targetNotes":"第三章。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷一》“殷其靁”第三章。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：或在其下。處，居也。","notes":null},{"key":"0004-2","attributionLabel":"郑笺","sectionLabel":null,"text":"箋云：下謂山足。","notes":null}]}]}}}
