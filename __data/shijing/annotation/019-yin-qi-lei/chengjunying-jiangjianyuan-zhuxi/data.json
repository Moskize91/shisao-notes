{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/019-yin-qi-lei/chengjunying-jiangjianyuan-zhuxi","dataHref":"/__data/shijing/annotation/019-yin-qi-lei/chengjunying-jiangjianyuan-zhuxi/data.json","title":"詩經注析 · 殷其靁 · 注释总览","description":"風 · 召南 · 殷其靁 · 汇集《詩經注析》关于《殷其靁》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"019-yin-qi-lei","materialId":"chengjunying-jiangjianyuan-zhuxi"},"href":"/shijing/annotation/019-yin-qi-lei/chengjunying-jiangjianyuan-zhuxi","poem":{"id":"019-yin-qi-lei","title":"殷其靁","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","殷其靁"],"segments":[{"id":"seg-001","text":"殷其靁","isActive":false},{"id":"seg-002","text":"在南山之阳","isActive":false},{"id":"seg-003","text":"何斯违斯","isActive":false},{"id":"seg-004","text":"莫敢或遑","isActive":false},{"id":"seg-005","text":"振振君子","isActive":false},{"id":"seg-006","text":"归哉归哉","isActive":false},{"id":"seg-007","text":"殷其靁","isActive":false},{"id":"seg-008","text":"在南山之侧","isActive":false},{"id":"seg-009","text":"何斯违斯","isActive":false},{"id":"seg-010","text":"莫敢遑息","isActive":false},{"id":"seg-011","text":"振振君子","isActive":false},{"id":"seg-012","text":"归哉归哉","isActive":false},{"id":"seg-013","text":"殷其靁","isActive":false},{"id":"seg-014","text":"在南山之下","isActive":false},{"id":"seg-015","text":"何斯违斯","isActive":false},{"id":"seg-016","text":"莫敢遑处","isActive":false},{"id":"seg-017","text":"振振君子","isActive":false},{"id":"seg-018","text":"归哉归哉","isActive":false}]},"material":{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","authors":["程俊英","蔣見元"],"contributorLine":"现代 · 程俊英、蔣見元","era":"现代","publicationYear":1991,"carrier":"PDF"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"题解","targetNotes":"题解总说。","sourceLabel":"第 35 页","sourceNotes":"书内页 35《殷其靁》题解。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"题解把此篇定为妇女思夫之诗，不从《毛序》所谓“劝以义”。编者认为叠词“归哉归哉”直接写出盼望丈夫早归的迫切心情；同时诗中又赞丈夫振奋有为，因此全诗格调比一般思妇诗更为明快。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"殷其靁，在南山之阳。何斯违斯？莫敢或遑。振振君子，归哉归哉！","targetNotes":"首章。","sourceLabel":"第 35 页","sourceNotes":"书内页 35 首章与注释。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"首章释“殷”为雷声，“靁”为古雷字；“阳”为山南坡。“何斯违斯”中上“斯”指时，下“斯”指地，“违”是离去；“或”训有，“遑”为闲暇。编者并指出“振振”一语当从声训与文例解作忠厚威武之貌，借以赞美远行之夫。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"殷其靁，在南山之侧。何斯违斯？莫敢遑息。振振君子，归哉归哉！","targetNotes":"第二章。","sourceLabel":"第 36 页","sourceNotes":"书内页 36 第二章与注释。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"第二章“侧”写山旁之地，“息”则训为喘息、止息。章法上只是以地势和动词略作转换，而“归哉归哉”的重叠语仍不断复沓，更显盼归情绪的急切不衰。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"殷其靁，在南山之下。何斯违斯？莫敢遑处。振振君子，归哉归哉！","targetNotes":"第三章。","sourceLabel":"第 36 页","sourceNotes":"书内页 36 第三章与注释。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"第三章“下”承“阳”“侧”而来，继续由高而下铺写雷动所及；“处”训居住、止处。三章同中见变，既写雷声层层逼近，也写思妇对丈夫归来的期待层层加深。","notes":null}]}]}}}
