{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/056-kao-pan/chengjunying-jiangjianyuan-zhuxi","dataHref":"/__data/shijing/annotation/056-kao-pan/chengjunying-jiangjianyuan-zhuxi/data.json","title":"詩經注析 · 考槃 · 注释总览","description":"風 · 衛風 · 考槃 · 汇集《詩經注析》关于《考槃》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"056-kao-pan","materialId":"chengjunying-jiangjianyuan-zhuxi"},"href":"/shijing/annotation/056-kao-pan/chengjunying-jiangjianyuan-zhuxi","poem":{"id":"056-kao-pan","title":"考槃","categoryId":"feng","subcategoryId":"weifeng","path":["風","衛風","考槃"],"segments":[{"id":"seg-001","text":"考槃在涧","isActive":false},{"id":"seg-002","text":"硕人之宽","isActive":false},{"id":"seg-003","text":"独寐寤言","isActive":false},{"id":"seg-004","text":"永矢弗谖","isActive":false},{"id":"seg-005","text":"考槃在阿","isActive":false},{"id":"seg-006","text":"硕人之薖","isActive":false},{"id":"seg-007","text":"独寐寤歌","isActive":false},{"id":"seg-008","text":"永矢弗过","isActive":false},{"id":"seg-009","text":"考槃在陆","isActive":false},{"id":"seg-010","text":"硕人之轴","isActive":false},{"id":"seg-011","text":"独寐寤宿","isActive":false},{"id":"seg-012","text":"永矢弗告","isActive":false}]},"material":{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","authors":["程俊英","蔣見元"],"contributorLine":"现代 · 程俊英、蔣見元","era":"现代","publicationYear":1991,"carrier":"PDF"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"这是一首抒写隐居生活的诗。","targetNotes":"题解。","sourceLabel":"第 123 页","sourceNotes":"书内页 123《题解》。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"程、蒋认为《考槃》写失意者隐居山间而自得其乐，虽《诗序》刺庄公之说未必可信，但“使贤者退而穷处”的情调与诗意相近。二人又把此诗视为中国早期隐逸诗的源头之一，强调其清淡闲适、意境幽洁。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"考槃在涧，硕人之宽。独寐寤言，永矢弗谖。","targetNotes":"首章。","sourceLabel":"第 123-124 页","sourceNotes":"书内页 123-124 首章注析。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","text":"程、蒋释首章时，先辨“考槃”可作建室，也可与击槃成乐有关，而以“扣槃于山水之间”最具隐者神韵；“涧”是山间水处，“硕人”指贤人，“宽”则写其心胸宽广。末二句说隐者独处而自言，自誓不忘此乐。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"考槃在阿，硕人之薖。独寐寤歌，永矢弗过。","targetNotes":"次章。","sourceLabel":"第 124 页","sourceNotes":"书内页 124 次章注析。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","text":"程、蒋解“阿”为山坡，“薖”近于窝、寞一类，仍写隐居闲适之状；“独寐寤歌”比首章更进一层，从寤言到寤歌，见其乐而形诸歌咏。“弗过”则是不愿越出这种隐居生活去与人过从，也可通作不复入朝。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"考槃在陆，硕人之轴。独寐寤宿，永矢弗告。","targetNotes":"末章。","sourceLabel":"第 124 页","sourceNotes":"书内页 124 末章注析与韵读。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","text":"程、蒋以“陆”为高平之地，“轴”引方玉润说，取其盘旋不穷之意，不从郑笺“病”义；“独寐寤宿”写其安于独处，“弗告”则与陶弘景“只可自怡悦，不堪持寄君”同意，谓此乐自得于心，不必告人。书末并标出本章“陆、轴、宿、告”一组用韵。","notes":null}]}]}}}
