{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/056-kao-pan/zhuxi-shijichuan-kr1c0009","dataHref":"/__data/shijing/annotation/056-kao-pan/zhuxi-shijichuan-kr1c0009/data.json","title":"詩集傳 · 考槃 · 注释总览","description":"風 · 衛風 · 考槃 · 汇集《詩集傳》关于《考槃》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"056-kao-pan","materialId":"zhuxi-shijichuan-kr1c0009"},"href":"/shijing/annotation/056-kao-pan/zhuxi-shijichuan-kr1c0009","poem":{"id":"056-kao-pan","title":"考槃","categoryId":"feng","subcategoryId":"weifeng","path":["風","衛風","考槃"],"segments":[{"id":"seg-001","text":"考槃在澗","isActive":true},{"id":"seg-002","text":"碩人之寬","isActive":true},{"id":"seg-003","text":"獨寐寤言","isActive":true},{"id":"seg-004","text":"永矢弗諼","isActive":true},{"id":"seg-005","text":"考槃在阿","isActive":false},{"id":"seg-006","text":"碩人之薖","isActive":false},{"id":"seg-007","text":"獨寐寤歌","isActive":false},{"id":"seg-008","text":"永矢弗過","isActive":false},{"id":"seg-009","text":"考槃在陸","isActive":false},{"id":"seg-010","text":"碩人之軸","isActive":false},{"id":"seg-011","text":"獨寐寤宿","isActive":false},{"id":"seg-012","text":"永矢弗告","isActive":false}]},"material":{"id":"zhuxi-shijichuan-kr1c0009","title":"詩集傳","authors":["朱熹"],"contributorLine":"宋 · 朱熹","era":"宋","publicationYear":1186,"carrier":"TXT"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"考槃在澗碩人之寬獨寐寤言永矢弗諼","targetNotes":"首章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》考槃首章。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"朱熹","sectionLabel":null,"text":"賦也。考、成也。槃、盤桓之意。言成其隱處之室也。陳氏曰、考、扣也。槃、器名。蓋扣之以節歌。如鼓盆拊缶之爲樂也。二說未知孰是。山夾水曰澗。碩、大。寬、廣。永、長。矢、誓。諼、忘也。○詩人美賢者隱處澗谷之閒、而碩大寬廣無戚戚之意。雖獨寐而寤言、猶自誓其不忘此樂也。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"考槃在阿碩人之薖獨寐寤歌永矢弗過","targetNotes":"次章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》考槃次章。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"朱熹","sectionLabel":null,"text":"賦也。曲陵曰阿。薖、義未詳。或云、亦寬大之意也。永矢弗過、自誓所願不踰於此。若將終身之意也。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"考槃在陸碩人之軸獨寐寤宿永矢弗告","targetNotes":"末章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》考槃末章。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"朱熹","sectionLabel":null,"text":"賦也。高平曰陸。軸、盤桓不行之意。寤宿、已覺而猶臥也。弗告者、不以此樂告人也。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"考槃三章章四句","targetNotes":"章句总记。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》末行章句总记。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"朱熹","sectionLabel":null,"text":"朱熹于篇末记《考槃》为三章、章四句，保持通行章句划分。","notes":null}]}]}}}
