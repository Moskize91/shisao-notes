{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/056-kao-pan/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/056-kao-pan/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 考槃 · 注释总览","description":"風 · 衛風 · 考槃 · 汇集《诗经原始(上下)》关于《考槃》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"056-kao-pan","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/056-kao-pan/fangyurun-yuanshi","poem":{"id":"056-kao-pan","title":"考槃","categoryId":"feng","subcategoryId":"weifeng","path":["風","衛風","考槃"],"segments":[{"id":"seg-001","text":"考槃在澗","isActive":false},{"id":"seg-002","text":"碩人之寬","isActive":false},{"id":"seg-003","text":"獨寐寤言","isActive":false},{"id":"seg-004","text":"永矢弗諼","isActive":false},{"id":"seg-005","text":"考槃在阿","isActive":false},{"id":"seg-006","text":"碩人之薖","isActive":false},{"id":"seg-007","text":"獨寐寤歌","isActive":false},{"id":"seg-008","text":"永矢弗過","isActive":false},{"id":"seg-009","text":"考槃在陸","isActive":false},{"id":"seg-010","text":"碩人之軸","isActive":false},{"id":"seg-011","text":"獨寐寤宿","isActive":false},{"id":"seg-012","text":"永矢弗告","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"考槃㊟贊賢者隱居自樂也。","targetNotes":"题注。","sourceLabel":null,"sourceNotes":"对应 EPUB 题注。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注"}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"考槃在澗碩人之寬獨寐寤言永矢弗諼考槃在阿碩人之薖獨寐寤歌永矢弗過考槃在陸碩人之軸獨寐寤宿永矢弗告","targetNotes":"通篇总论。","sourceLabel":null,"sourceNotes":"对应 EPUB 三章正文后总论段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"总论"}]},{"id":"0003","order":3,"total":4,"layer":"term","layerLabel":"字词注","targetText":"集釋考成也。〔姚氏際恒曰〕《左傳》「考仲子之宫」、《雜記》「路寢成則考之」是也。槃〔黄氏一正曰〕槃者，架木爲屋，盤結之義也。阿曲陵曰阿。薖〔李氏曰〕薖與窩同。陸高平曰陸。軸〔張氏彩曰〕軸者，言其旋轉而不窮，猶所謂游於環中者也。亦有任其旋轉不出乎此之意。弗告〔朱氏善曰〕弗告，謂不必以此樂告人，非不以告人也。得於心而難於言，雖言人亦未必信也。〔姚氏曰〕弗告，猶不以姓名告人之意。二義均可通。","targetNotes":"集释。","sourceLabel":null,"sourceNotes":"对应 EPUB《集释》段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"集释"}]},{"id":"0004","order":4,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"標韻寬十四寒。言十三元。諼同。通韻。阿五歌。薖、歌、過並同。本韻。陸一屋。軸、宿同。告二沃。通韻。","targetNotes":"标韵。","sourceLabel":null,"sourceNotes":"对应 EPUB《标韵》段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":"标韵"}]}]}}}
