{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/050-ding-zhi-fang-zhong/chenhuan-chuanshu","dataHref":"/__data/shijing/annotation/050-ding-zhi-fang-zhong/chenhuan-chuanshu/data.json","title":"詩毛氏傳疏 · 定之方中 · 注释总览","description":"風 · 鄘風 · 定之方中 · 汇集《詩毛氏傳疏》关于《定之方中》的 2 条注释，含 2 条注脚。"},"payload":{"detail":{"route":{"poemId":"050-ding-zhi-fang-zhong","materialId":"chenhuan-chuanshu"},"href":"/shijing/annotation/050-ding-zhi-fang-zhong/chenhuan-chuanshu","poem":{"id":"050-ding-zhi-fang-zhong","title":"定之方中","categoryId":"feng","subcategoryId":"yongfeng","path":["風","鄘風","定之方中"],"segments":[{"id":"seg-001","text":"定之方中","isActive":false},{"id":"seg-002","text":"作於楚宮","isActive":false},{"id":"seg-003","text":"揆之以日","isActive":false},{"id":"seg-004","text":"作於楚室","isActive":false},{"id":"seg-005","text":"樹之榛栗","isActive":false},{"id":"seg-006","text":"椅桐梓漆","isActive":false},{"id":"seg-007","text":"爰伐琴瑟","isActive":false},{"id":"seg-008","text":"升彼虛矣","isActive":false},{"id":"seg-009","text":"以望楚矣","isActive":false},{"id":"seg-010","text":"望楚與堂","isActive":false},{"id":"seg-011","text":"景山與京","isActive":false},{"id":"seg-012","text":"降觀於桑","isActive":false},{"id":"seg-013","text":"卜云其吉","isActive":false},{"id":"seg-014","text":"終然允臧","isActive":false},{"id":"seg-015","text":"靈雨旣零","isActive":false},{"id":"seg-016","text":"命彼倌人","isActive":false},{"id":"seg-017","text":"星言夙駕","isActive":false},{"id":"seg-018","text":"說於桑田","isActive":false},{"id":"seg-019","text":"匪直也人","isActive":false},{"id":"seg-020","text":"秉心塞淵","isActive":false},{"id":"seg-021","text":"騋牝三千","isActive":false}]},"material":{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","authors":["陳奐"],"contributorLine":"清 · 陳奐","era":"清","publicationYear":1847,"carrier":"PDF"},"stats":{"annotationCount":2,"glossCount":2},"annotations":[{"id":"0001","order":1,"total":2,"layer":"preface","layerLabel":"篇序","targetText":"定之方中美衛文公也衛為狄所滅東徙渡河野處漕邑齊桓公攘戎狄而封之文公徙居楚丘始建城市而營宮室得其時制百姓說之國家殷富焉","targetNotes":"诗序","sourceLabel":"第 8 页","sourceNotes":"卷四页八，《定之方中》篇首小序。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序"}]},{"id":"0002","order":2,"total":2,"layer":"span","layerLabel":"诗句片段","targetText":"定之方中，作於楚宮。揆之以日，作於楚室。樹之榛栗，椅桐梓漆。爰伐琴瑟。升彼虛矣，以望楚矣。望楚與堂，景山與京。降觀於桑，卜云其吉。終然允臧。靈雨旣零，命彼倌人。星言夙駕，說於桑田。匪直也人，秉心塞淵。騋牝三千。","targetNotes":"通篇经文","sourceLabel":"第 9 页","sourceNotes":"卷四页九，《定之方中》通篇经文。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"陈奂","sectionLabel":"疏"}]}]}}}
