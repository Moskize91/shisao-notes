{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/050-ding-zhi-fang-zhong/chenhuan-chuanshu","dataHref":"/__data/shijing/annotation/050-ding-zhi-fang-zhong/chenhuan-chuanshu/data.json","title":"詩毛氏傳疏 · 定之方中 · 注释总览","description":"風 · 鄘風 · 定之方中 · 汇集《詩毛氏傳疏》关于《定之方中》的 2 条注释，含 2 条注脚。"},"payload":{"detail":{"route":{"poemId":"050-ding-zhi-fang-zhong","materialId":"chenhuan-chuanshu"},"href":"/shijing/annotation/050-ding-zhi-fang-zhong/chenhuan-chuanshu","poem":{"id":"050-ding-zhi-fang-zhong","title":"定之方中","categoryId":"feng","subcategoryId":"yongfeng","path":["風","鄘風","定之方中"],"segments":[{"id":"seg-001","text":"定之方中","isActive":false},{"id":"seg-002","text":"作於楚宮","isActive":false},{"id":"seg-003","text":"揆之以日","isActive":false},{"id":"seg-004","text":"作於楚室","isActive":false},{"id":"seg-005","text":"樹之榛栗","isActive":false},{"id":"seg-006","text":"椅桐梓漆","isActive":false},{"id":"seg-007","text":"爰伐琴瑟","isActive":false},{"id":"seg-008","text":"升彼虛矣","isActive":false},{"id":"seg-009","text":"以望楚矣","isActive":false},{"id":"seg-010","text":"望楚與堂","isActive":false},{"id":"seg-011","text":"景山與京","isActive":false},{"id":"seg-012","text":"降觀於桑","isActive":false},{"id":"seg-013","text":"卜云其吉","isActive":false},{"id":"seg-014","text":"終然允臧","isActive":false},{"id":"seg-015","text":"靈雨旣零","isActive":false},{"id":"seg-016","text":"命彼倌人","isActive":false},{"id":"seg-017","text":"星言夙駕","isActive":false},{"id":"seg-018","text":"說於桑田","isActive":false},{"id":"seg-019","text":"匪直也人","isActive":false},{"id":"seg-020","text":"秉心塞淵","isActive":false},{"id":"seg-021","text":"騋牝三千","isActive":false}]},"material":{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","authors":["陳奐"],"contributorLine":"清 · 陳奐","era":"清","publicationYear":1847,"carrier":"PDF"},"stats":{"annotationCount":2,"glossCount":2},"annotations":[{"id":"0001","order":1,"total":2,"layer":"preface","layerLabel":"篇序","targetText":"定之方中美衛文公也衛為狄所滅東徙渡河野處漕邑齊桓公攘戎狄而封之文公徙居楚丘始建城市而營宮室得其時制百姓說之國家殷富焉","targetNotes":"篇首小序。","sourceLabel":"第 9 页","sourceNotes":"卷四页九《定之方中》小序。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序","text":"序：《定之方中》，美衛文公也。衛為狄所滅，東徙渡河，野處漕邑。齊桓公攘戎狄而封之。文公徙居楚丘，始建城市而營宮室，得其時制，百姓說之，國家殷富焉。","notes":null}]},{"id":"0002","order":2,"total":2,"layer":"span","layerLabel":"诗句片段","targetText":"定之方中，作於楚宮。揆之以日，作於楚室。樹之榛栗，椅桐梓漆。爰伐琴瑟。升彼虛矣，以望楚矣。望楚與堂，景山與京。降觀於桑，卜云其吉。終然允臧。靈雨旣零，命彼倌人。星言夙駕，說於桑田。匪直也人，秉心塞淵。騋牝三千。","targetNotes":"通篇经传疏解。","sourceLabel":"第 9-12 页","sourceNotes":"据卷四页九至页十二《定之方中》经传疏。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"陈奂疏《定之方中》时，先据《序》“美衛文公也……國家殷富焉”申明此篇本旨在美卫文公迁楚丘后营国有法、富庶可观。其释首章“定之方中，作於楚宮。揆之以日，作於楚室。樹之榛栗，椅桐梓漆。爰伐琴瑟”，以定星中天为营室之候，“揆日”见建宫度方之审，“樹木伐琴瑟”则见先务久远、为国经始。次章“升彼虛矣，以望楚矣。望楚與堂，景山與京。降觀於桑，卜云其吉。終然允臧”，言登虚望邑、审山川高下，复观土宜而后卜居，终获其善，见迁都之慎。末章“靈雨旣零，命彼倌人。星言夙駕，說於桑田。匪直也人，秉心塞淵。騋牝三千”，则推称文公雨后夙驾、亲劝农桑，不独勤政于外，且其操心诚实深厚，故国富兵强，马畜滋盛，以成中兴之业。","notes":null}]}]}}}
