{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/050-ding-zhi-fang-zhong/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/050-ding-zhi-fang-zhong/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 定之方中 · 注释总览","description":"風 · 鄘風 · 定之方中 · 汇集《诗经原始(上下)》关于《定之方中》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"050-ding-zhi-fang-zhong","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/050-ding-zhi-fang-zhong/fangyurun-yuanshi","poem":{"id":"050-ding-zhi-fang-zhong","title":"定之方中","categoryId":"feng","subcategoryId":"yongfeng","path":["風","鄘風","定之方中"],"segments":[{"id":"seg-001","text":"定之方中","isActive":false},{"id":"seg-002","text":"作于楚宫","isActive":false},{"id":"seg-003","text":"揆之以日","isActive":false},{"id":"seg-004","text":"作于楚室","isActive":false},{"id":"seg-005","text":"樹之榛栗","isActive":false},{"id":"seg-006","text":"椅桐梓漆","isActive":false},{"id":"seg-007","text":"爰伐琴瑟","isActive":false},{"id":"seg-008","text":"升彼虚矣","isActive":false},{"id":"seg-009","text":"以望楚矣","isActive":false},{"id":"seg-010","text":"望楚與堂","isActive":false},{"id":"seg-011","text":"景山與京","isActive":false},{"id":"seg-012","text":"降觀于桑","isActive":false},{"id":"seg-013","text":"卜云其吉","isActive":false},{"id":"seg-014","text":"終焉允臧","isActive":false},{"id":"seg-015","text":"靈雨既零","isActive":false},{"id":"seg-016","text":"命彼倌人","isActive":false},{"id":"seg-017","text":"星言夙駕","isActive":false},{"id":"seg-018","text":"説于桑田","isActive":false},{"id":"seg-019","text":"匪直也人","isActive":false},{"id":"seg-020","text":"秉心塞淵","isActive":false},{"id":"seg-021","text":"騋牝三千","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"定之方中㊟美衛文公再造公室也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标题段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注","text":"方玉润题注以“美衛文公再造公室”定篇，认为《定之方中》旨在称美文公复兴卫国。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"总评","targetNotes":"通篇右评。","sourceLabel":null,"sourceNotes":"对应 EPUB item 右评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"总评","text":"方玉润右评据《序》《集传》与《春秋传》肯定此篇为美卫文公迁楚丘再造公室，并斥伪《传》以鲁僖公城楚丘实之为妄。其称文公流离后能损抑自励、与民同劳，故由“秉心塞淵”而能重天时、察地利、尽人力，终致戎马蠶桑并盛，成河北巨邦。末复感叹卫亡于宣姜而兴于其子，申明人君拨乱反正之要。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"眉评","targetNotes":"篇中眉评撮要。","sourceLabel":null,"sourceNotes":"对应 EPUB item 眉评段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"眉评","text":"方玉润眉评云：首章总言建国规模，二章追叙卜筑之始，三章终言勤劳致富；“秉心”一句为全诗主脑。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"term","layerLabel":"字词注","targetText":"定之方中作于楚宫揆之以日椅桐梓漆爰伐琴瑟升彼虚矣望楚與堂景山與京降觀于桑靈雨既零命彼倌人星言夙駕説于桑田秉心塞淵騋牝三千","targetNotes":"集释撮要。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":"集释","text":"方玉润集释云：定为北方营室星，方中则昏中可营宫室；楚宫即楚丘之宫，揆为度日景以正东西南北。椅桐梓漆皆建宫所用之木，爰犹“于”也。又释虚为漕虚故墟，堂为楚丘堂邑，景可训测景亦可作山名，京为高丘；桑疑兼地名与水名，降观当近察流泉。靈雨为应时瑞雨，倌人为主驾者，星言夙駕即戴星早驾，説为舍止。秉为操，塞为实，淵为深，故“秉心塞淵”谓谋虑笃实深远；騋牝则举国马牝牡并见其富强。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"标韵","targetNotes":"三章韵脚撮述。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标韵段。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"方玉润","sectionLabel":"标韵","text":"方玉润标韵云：首章“中、宫”为一东本韵，“日、室、栗、漆、瑟”属四质。次章“虚”六鱼与“楚”六语叶，“堂、桑、臧”七阳并“京”八庚转韵。三章“零”九青、“人”十一真、“田”一先与“淵、千”通韵。","notes":null}]}]}}}
