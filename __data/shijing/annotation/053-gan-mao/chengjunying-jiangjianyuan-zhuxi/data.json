{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/053-gan-mao/chengjunying-jiangjianyuan-zhuxi","dataHref":"/__data/shijing/annotation/053-gan-mao/chengjunying-jiangjianyuan-zhuxi/data.json","title":"詩經注析 · 干旄 · 注释总览","description":"風 · 鄘風 · 干旄 · 汇集《詩經注析》关于《干旄》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"053-gan-mao","materialId":"chengjunying-jiangjianyuan-zhuxi"},"href":"/shijing/annotation/053-gan-mao/chengjunying-jiangjianyuan-zhuxi","poem":{"id":"053-gan-mao","title":"干旄","categoryId":"feng","subcategoryId":"yongfeng","path":["風","鄘風","干旄"],"segments":[{"id":"seg-001","text":"孑孑干旄","isActive":false},{"id":"seg-002","text":"在浚之郊","isActive":false},{"id":"seg-003","text":"素丝纰之","isActive":false},{"id":"seg-004","text":"良马四之","isActive":false},{"id":"seg-005","text":"彼姝者子","isActive":false},{"id":"seg-006","text":"何以畀之","isActive":false},{"id":"seg-007","text":"孑孑干旟","isActive":false},{"id":"seg-008","text":"在浚之都","isActive":false},{"id":"seg-009","text":"素丝组之","isActive":false},{"id":"seg-010","text":"良马五之","isActive":false},{"id":"seg-011","text":"彼姝者子","isActive":false},{"id":"seg-012","text":"何以予之","isActive":false},{"id":"seg-013","text":"孑孑干旌","isActive":false},{"id":"seg-014","text":"在浚之城","isActive":false},{"id":"seg-015","text":"素丝祝之","isActive":false},{"id":"seg-016","text":"良马六之","isActive":false},{"id":"seg-017","text":"彼姝者子","isActive":false},{"id":"seg-018","text":"何以告之","isActive":false}]},"material":{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","authors":["程俊英","蔣見元"],"contributorLine":"现代 · 程俊英、蔣見元","era":"现代","publicationYear":1991,"carrier":"PDF"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"《干旄》题解","targetNotes":"题解总说。","sourceLabel":"第 113 页","sourceNotes":"书内页 113《题解》。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"程、蒋将《干旄》解释为赞美卫文公招致贤士、复兴卫国之诗，谓诗中写卫国臣子建旌旄、备良马、往浚郊与城邑访问贤者，正与《左传》所称卫文公“授方任能”相发明。他们又强调三章只更换少数字而反复申说求贤一意，因重章复沓而使思贤若渴之情层层加强。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"孑孑干旄，在浚之郊。素丝纰之，良马四之。彼姝者子，何以畀之？","targetNotes":"第一章。","sourceLabel":"第 113 页","sourceNotes":"书内页 113 首章注析。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","text":"首章“孑孑干旄，在浚之郊。素丝纰之，良马四之。彼姝者子，何以畀之”写使者建旗乘马到浚郊访贤。程、蒋释“孑孑”为特出独立之貌，“干旄”为旗竿顶端注旄牛尾之旗；“纰”是用白丝镶饰旗帜，“四之”是以四马为礼。又据胡承珙、陈奂等说，解“姝”为顺貌，“畀”为给予，末句即问贤者将以何策何道答其礼意之勤。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"孑孑干旟，在浚之都。素丝组之，良马五之。彼姝者子，何以予之？","targetNotes":"第二章。","sourceLabel":"第 114 页","sourceNotes":"书内页 114 次章注析。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","text":"次章“孑孑干旟，在浚之都。素丝组之，良马五之。彼姝者子，何以予之”把访贤地点由郊推近于都。程、蒋释“干旟”为画有疾飞鸟隼的招贤之旗，“都”为近郊之邑；“组”仍是联缀旗旒的丝饰，“五之”较首章益一马，见礼数更盛。末句“予之”与首章“畀之”同义，仍是盼贤者授以善道。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"孑孑干旌，在浚之城。素丝祝之，良马六之。彼姝者子，何以告之？","targetNotes":"第三章。","sourceLabel":"第 114 页","sourceNotes":"书内页 114 三章注析。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","text":"末章“孑孑干旌，在浚之城。素丝祝之，良马六之。彼姝者子，何以告之”进一步写使者入城求贤。程、蒋释“干旌”为竿端加析羽之旗，“城”为都城，“祝”为“属”的假借，指编连旗饰；“六之”则比前两章更盛。末句“告之”据《左传》旧注取其忠告善道之义，点出全诗所求正在贤者献策进言。","notes":null}]}]}}}
