{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/053-gan-mao/chenhuan-chuanshu","dataHref":"/__data/shijing/annotation/053-gan-mao/chenhuan-chuanshu/data.json","title":"詩毛氏傳疏 · 干旄 · 注释总览","description":"風 · 鄘風 · 干旄 · 汇集《詩毛氏傳疏》关于《干旄》的 2 条注释，含 2 条注脚。"},"payload":{"detail":{"route":{"poemId":"053-gan-mao","materialId":"chenhuan-chuanshu"},"href":"/shijing/annotation/053-gan-mao/chenhuan-chuanshu","poem":{"id":"053-gan-mao","title":"干旄","categoryId":"feng","subcategoryId":"yongfeng","path":["風","鄘風","干旄"],"segments":[{"id":"seg-001","text":"孑孑干旄","isActive":false},{"id":"seg-002","text":"在浚之郊","isActive":false},{"id":"seg-003","text":"素絲紕之","isActive":false},{"id":"seg-004","text":"良馬四之","isActive":false},{"id":"seg-005","text":"彼姝者子","isActive":false},{"id":"seg-006","text":"何以畀之","isActive":false},{"id":"seg-007","text":"孑孑干旟","isActive":false},{"id":"seg-008","text":"在浚之都","isActive":false},{"id":"seg-009","text":"素絲組之","isActive":false},{"id":"seg-010","text":"良馬五之","isActive":false},{"id":"seg-011","text":"彼姝者子","isActive":false},{"id":"seg-012","text":"何以予之","isActive":false},{"id":"seg-013","text":"孑孑干旌","isActive":false},{"id":"seg-014","text":"在浚之城","isActive":false},{"id":"seg-015","text":"素絲祝之","isActive":false},{"id":"seg-016","text":"良馬六之","isActive":false},{"id":"seg-017","text":"彼姝者子","isActive":false},{"id":"seg-018","text":"何以告之","isActive":false}]},"material":{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","authors":["陳奐"],"contributorLine":"清 · 陳奐","era":"清","publicationYear":1847,"carrier":"PDF"},"stats":{"annotationCount":2,"glossCount":2},"annotations":[{"id":"0001","order":1,"total":2,"layer":"preface","layerLabel":"篇序","targetText":"干旄美好善也衛文公臣子多好善賢者樂告以善道也","targetNotes":"篇首小序。","sourceLabel":"第 16 页","sourceNotes":"卷四页十六《干旄》小序。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序","text":"序：《干旄》，美好善也。衛文公臣子多好善，賢者樂告以善道也。","notes":null}]},{"id":"0002","order":2,"total":2,"layer":"span","layerLabel":"诗句片段","targetText":"孑孑干旄，在浚之郊。素絲紕之，良馬四之。彼姝者子，何以畀之。孑孑干旟，在浚之都。素絲組之，良馬五之。彼姝者子，何以予之。孑孑干旌，在浚之城。素絲祝之，良馬六之。彼姝者子，何以告之。","targetNotes":"通篇经传疏解。","sourceLabel":"第 16-18 页","sourceNotes":"据卷四页十六至页十八《干旄》经传疏。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"陈奂疏《干旄》时，先就《序》申明卫文公臣子多好善，故贤者乐告以善道。其释首章，谓“孑孑”为特出之貌，“干旄”为注旄于旗干之首，“浚”为卫邑，“紕”为织组，又以“姝”为美顺之称、“畀”为与。次章释“干旟”为鸟隼之旟，“都”为下邑，“組”为缀旒之饰，“予”与“畀”互文同义。末章则释“干旌”为析羽注旄之旌，“城”为都城，“祝”当作“屬”，仍是联属旗饰之义；“告之”则取贤者忠告善道。通篇重在见卫之君臣好善下贤，而贤者亦愿出谋应之。","notes":null}]}]}}}
