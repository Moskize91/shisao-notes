{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/053-gan-mao/zhuxi-shijichuan-kr1c0009","dataHref":"/__data/shijing/annotation/053-gan-mao/zhuxi-shijichuan-kr1c0009/data.json","title":"詩集傳 · 干旄 · 注释总览","description":"風 · 鄘風 · 干旄 · 汇集《詩集傳》关于《干旄》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"053-gan-mao","materialId":"zhuxi-shijichuan-kr1c0009"},"href":"/shijing/annotation/053-gan-mao/zhuxi-shijichuan-kr1c0009","poem":{"id":"053-gan-mao","title":"干旄","categoryId":"feng","subcategoryId":"yongfeng","path":["風","鄘風","干旄"],"segments":[{"id":"seg-001","text":"孑孑干旄","isActive":true},{"id":"seg-002","text":"在浚之郊","isActive":true},{"id":"seg-003","text":"素絲紕之","isActive":true},{"id":"seg-004","text":"良馬四之","isActive":true},{"id":"seg-005","text":"彼姝者子","isActive":true},{"id":"seg-006","text":"何以畀之","isActive":true},{"id":"seg-007","text":"孑孑干旟","isActive":false},{"id":"seg-008","text":"在浚之都","isActive":false},{"id":"seg-009","text":"素絲組之","isActive":false},{"id":"seg-010","text":"良馬五之","isActive":false},{"id":"seg-011","text":"彼姝者子","isActive":false},{"id":"seg-012","text":"何以予之","isActive":false},{"id":"seg-013","text":"孑孑干旌","isActive":false},{"id":"seg-014","text":"在浚之城","isActive":false},{"id":"seg-015","text":"素絲祝之","isActive":false},{"id":"seg-016","text":"良馬六之","isActive":false},{"id":"seg-017","text":"彼姝者子","isActive":false},{"id":"seg-018","text":"何以告之","isActive":false}]},"material":{"id":"zhuxi-shijichuan-kr1c0009","title":"詩集傳","authors":["朱熹"],"contributorLine":"宋 · 朱熹","era":"宋","publicationYear":1186,"carrier":"TXT"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"孑孑干旄在浚之郊素絲紕之良馬四之彼姝者子何以畀之","targetNotes":"首章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》干旄首章。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"朱熹","sectionLabel":null,"text":"賦也。孑孑、特出之貌。干旄、以旄牛尾、注於旗干之首、而建之車後也。浚、衛邑名。邑外謂之郊。紕、織組也。蓋以素絲織組而維之也。四之、兩服兩驂、凡四馬以載之也。姝、美也。子、指所見之人也。畀、與也。○言衛大夫乘此車馬、建此旌旄、以見賢者。彼其所見之賢者、將何以畀之、而答其禮意之勤乎。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"孑孑干旟在浚之都素絲組之良馬五之彼姝者子何以予之","targetNotes":"次章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》干旄次章。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"朱熹","sectionLabel":null,"text":"賦也。旟、州里所建鳥隼之旗也。上設旌旄、其下繫斿。斿、下屬縿。皆畫鳥隼也。下邑曰都。五之、五馬。言其盛也。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"孑孑干旌在浚之城素絲祝之良馬六之彼姝者子何以告之","targetNotes":"三章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》干旄三章。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"朱熹","sectionLabel":null,"text":"賦也。析羽爲旌。干旌、蓋析翟羽、設於旗干之首也。城、都城也。祝、屬也。六之、六馬。極其盛而言也。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"干旄三章章六句","targetNotes":"章句总说。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》干旄章句总说。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"朱熹","sectionLabel":"总说","text":"干旄三章。章六句。此上三詩、小序皆以爲、文公時詩。蓋見其列於定中·載馳之閒故爾。他無所考也。然衛本以淫亂無禮不樂善道、而亡其國。今破滅之餘、人心危懼、正其有以懲創往事、而興起善端之時也。故其爲詩如此。蓋所謂生於憂患、死於安樂者。小序之言、疑亦有所本云。","notes":null}]}]}}}
