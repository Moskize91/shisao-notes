{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/053-gan-mao/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/053-gan-mao/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 干旄 · 注释总览","description":"風 · 鄘風 · 干旄 · 汇集《诗经原始(上下)》关于《干旄》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"053-gan-mao","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/053-gan-mao/fangyurun-yuanshi","poem":{"id":"053-gan-mao","title":"干旄","categoryId":"feng","subcategoryId":"yongfeng","path":["風","鄘風","干旄"],"segments":[{"id":"seg-001","text":"孑孑干旄","isActive":false},{"id":"seg-002","text":"在浚之郊","isActive":false},{"id":"seg-003","text":"素絲紕之","isActive":false},{"id":"seg-004","text":"良馬四之","isActive":false},{"id":"seg-005","text":"彼姝者子","isActive":false},{"id":"seg-006","text":"何以畀之","isActive":false},{"id":"seg-007","text":"孑孑干旟","isActive":false},{"id":"seg-008","text":"在浚之都","isActive":false},{"id":"seg-009","text":"素絲組之","isActive":false},{"id":"seg-010","text":"良馬五之","isActive":false},{"id":"seg-011","text":"彼姝者子","isActive":false},{"id":"seg-012","text":"何以予之","isActive":false},{"id":"seg-013","text":"孑孑干旌","isActive":false},{"id":"seg-014","text":"在浚之城","isActive":false},{"id":"seg-015","text":"素絲祝之","isActive":false},{"id":"seg-016","text":"良馬六之","isActive":false},{"id":"seg-017","text":"彼姝者子","isActive":false},{"id":"seg-018","text":"何以告之","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"干旄㊟美好善也","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标题段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注","text":"方玉润题注径以“美好善也”定篇，承用《小序》说法。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"孑孑干旄，在浚之郊。素絲紕之，良馬四之。彼姝者子，何以畀之。孑孑干旟，在浚之都。素絲組之，良馬五之。彼姝者子，何以予之。孑孑干旌，在浚之城。素絲祝之，良馬六之。彼姝者子，何以告之。","targetNotes":"通篇总论。","sourceLabel":null,"sourceNotes":"对应 EPUB 正文后总论段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"总论","text":"方玉润据《小序》以《干旄》为“美好善”之诗，并以卫文公能敬教劝学、授方任能，故此诗写其君臣乘车建旌旄，远适郊畿、近访城邑，广询博访二三有道仁人君子，以求治道。他又强调此时卫国已由前日淫乱无礼转向深谋望治，故能再造侯服。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"term","layerLabel":"字词注","targetText":"孑孑干旄，在浚之郊。素絲紕之，良馬四之。彼姝者子，何以畀之。孑孑干旟，在浚之都。素絲組之，良馬五之。彼姝者子，何以予之。孑孑干旌，在浚之城。素絲祝之，良馬六之。彼姝者子，何以告之。","targetNotes":"《集釋》撮要。","sourceLabel":null,"sourceNotes":"对应 EPUB《集釋》段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"集释","text":"方玉润《集释》汇通《集传》、孔疏、董逌、姚际恒等说，依次解释“孑孑”“干旄”“浚”“紕”“四之”“姝”“畀”“旟”“都”“祝”等词，并说明“五之、六之”由少而多，见其车马与礼意之盛。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"標韻旄郊通韻紕四畀本韻旟都通韻組五予通韻旌城本韻祝六告通韻","targetNotes":"《標韻》撮要。","sourceLabel":null,"sourceNotes":"对应 EPUB《標韻》段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":"标韵","text":"方玉润《標韻》分章列出韵部：首章以“旄、郊”为通韵，“紕、四、畀”为本韵；次章以“旟、都”为通韵，“組、五、予”为通韵；末章以“旌、城”为本韵，“祝、六、告”为通韵。","notes":null}]}]}}}
