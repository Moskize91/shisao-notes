{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/174-liao-xiao/chenhuan-chuanshu","dataHref":"/__data/shijing/annotation/174-liao-xiao/chenhuan-chuanshu/data.json","title":"詩毛氏傳疏 · 蓼蕭 · 注释总览","description":"雅 · 小雅 · 蓼蕭 · 汇集《詩毛氏傳疏》关于《蓼蕭》的 1 条注释，含 1 条注脚。"},"payload":{"detail":{"route":{"poemId":"174-liao-xiao","materialId":"chenhuan-chuanshu"},"href":"/shijing/annotation/174-liao-xiao/chenhuan-chuanshu","poem":{"id":"174-liao-xiao","title":"蓼蕭","categoryId":"ya","subcategoryId":"xiaoya","path":["雅","小雅","蓼蕭"],"segments":[{"id":"seg-001","text":"蓼彼蕭斯","isActive":true},{"id":"seg-002","text":"零露湑兮","isActive":true},{"id":"seg-003","text":"既見君子","isActive":true},{"id":"seg-004","text":"我心寫兮","isActive":true},{"id":"seg-005","text":"燕笑語兮","isActive":true},{"id":"seg-006","text":"是以有譽處兮","isActive":true},{"id":"seg-007","text":"蓼彼蕭斯","isActive":true},{"id":"seg-008","text":"零露瀼瀼","isActive":true},{"id":"seg-009","text":"既見君子","isActive":true},{"id":"seg-010","text":"爲龍爲光","isActive":true},{"id":"seg-011","text":"其德不爽","isActive":true},{"id":"seg-012","text":"壽考不忘","isActive":true},{"id":"seg-013","text":"蓼彼蕭斯","isActive":true},{"id":"seg-014","text":"零露泥泥","isActive":true},{"id":"seg-015","text":"既見君子","isActive":true},{"id":"seg-016","text":"孔燕豈弟","isActive":true},{"id":"seg-017","text":"宜兄宜弟","isActive":true},{"id":"seg-018","text":"令德壽豈","isActive":true},{"id":"seg-019","text":"蓼彼蕭斯","isActive":true},{"id":"seg-020","text":"零露濃濃","isActive":true},{"id":"seg-021","text":"既見君子","isActive":true},{"id":"seg-022","text":"鞗革沖沖","isActive":true},{"id":"seg-023","text":"和鸞雝雝","isActive":true},{"id":"seg-024","text":"萬福攸同","isActive":true}]},"material":{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","authors":["陳奐"],"contributorLine":"清 · 陳奐","era":"清","publicationYear":1847,"carrier":"PDF"},"stats":{"annotationCount":1,"glossCount":1},"annotations":[{"id":"0001","order":1,"total":1,"layer":"span","layerLabel":"诗句片段","targetText":"蓼彼蕭斯，零露湑兮。既見君子，我心寫兮。燕笑語兮，是以有譽處兮。蓼彼蕭斯，零露瀼瀼。既見君子，爲龍爲光。其德不爽，壽考不忘。蓼彼蕭斯，零露泥泥。既見君子，孔燕豈弟。宜兄宜弟，令德壽豈。蓼彼蕭斯，零露濃濃。既見君子，鞗革沖沖。和鸞雝雝，萬福攸同。","targetNotes":"页图可辨《蓼蕭》全文及篇内传疏。","sourceLabel":"第 334-335 页","sourceNotes":"据《诗毛氏传疏》第 334-335 页相关页图保守整理《蓼蕭》篇内经文与传疏。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"页图","sectionLabel":null}]}]}}}
