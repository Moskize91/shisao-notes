","order":2,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"总评","targetNotes":"通篇总评。","sourceLabel":null,"sourceNotes":"对应 EPUB item 总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"总评","text":"方玉润总评引《大序》“公子頑通乎君母”与《集傳》“理或然也”，谓衛宫淫乱未必始于宣姜，而宣姜为尤甚。其以《静女》《新臺》《牆茨》《偕老》诸篇相互发明，指出诗人“不忍道、不忍詳、不忍讀”而圣人仍录入经，以为万世戒。又引杨氏“闺中之恶无隐不彰”之说，并以后世吕雉、武曌为宣姜后尘，申明录诗之训戒意义。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"term","layerLabel":"字词注","targetText":"牆有茨中冓之言","targetNotes":"集释撮要。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"集释","text":"方玉润集释先释“茨”字，举《説文》《書》《周禮》以见其义；又释“中冓”为室中结构深密之处。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"标韵","targetNotes":"三章韵脚撮述。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标韵段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":"标韵","text":"方玉润标出《牆有茨》韵脚：首章“掃、道、醜”为叶韵；次章“襄、詳、長”为本韵；末章“束、讀、辱”为通韵。","notes":null}]}]}}}
