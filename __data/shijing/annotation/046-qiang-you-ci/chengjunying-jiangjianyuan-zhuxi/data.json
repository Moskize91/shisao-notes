{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/046-qiang-you-ci/chengjunying-jiangjianyuan-zhuxi","dataHref":"/__data/shijing/annotation/046-qiang-you-ci/chengjunying-jiangjianyuan-zhuxi/data.json","title":"詩經注析 · 牆有茨 · 注释总览","description":"風 · 鄘風 · 牆有茨 · 汇集《詩經注析》关于《牆有茨》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"046-qiang-you-ci","materialId":"chengjunying-jiangjianyuan-zhuxi"},"href":"/shijing/annotation/046-qiang-you-ci/chengjunying-jiangjianyuan-zhuxi","poem":{"id":"046-qiang-you-ci","title":"牆有茨","categoryId":"feng","subcategoryId":"yongfeng","path":["風","鄘風","牆有茨"],"segments":[{"id":"seg-001","text":"墙有茨","isActive":false},{"id":"seg-002","text":"不可扫也","isActive":false},{"id":"seg-003","text":"中冓之言","isActive":false},{"id":"seg-004","text":"不可道也","isActive":false},{"id":"seg-005","text":"所可道也","isActive":false},{"id":"seg-006","text":"言之丑也","isActive":false},{"id":"seg-007","text":"墙有茨","isActive":false},{"id":"seg-008","text":"不可襄也","isActive":false},{"id":"seg-009","text":"中冓之言","isActive":false},{"id":"seg-010","text":"不可详也","isActive":false},{"id":"seg-011","text":"所可详也","isActive":false},{"id":"seg-012","text":"言之长也","isActive":false},{"id":"seg-013","text":"墙有茨","isActive":false},{"id":"seg-014","text":"不可束也","isActive":false},{"id":"seg-015","text":"中冓之言","isActive":false},{"id":"seg-016","text":"不可读也","isActive":false},{"id":"seg-017","text":"所可读也","isActive":false},{"id":"seg-018","text":"言之辱也","isActive":false}]},"material":{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","authors":["程俊英","蔣見元"],"contributorLine":"现代 · 程俊英、蔣見元","era":"现代","publicationYear":1991,"carrier":"PDF"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"题解","targetNotes":"题解总说。","sourceLabel":"第 96 页","sourceNotes":"书内页 96《题解》段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"题解认为《墙有茨》揭露、讽刺卫国统治阶级的淫乱无耻，并据《左传》、毛序及齐鲁诗说，指出讽刺对象当与宣姜及其乱伦行为相关。程、蒋又强调此诗写法“尖锐而不直露”，以“所可道也？言之丑也”等自问自答收束，将丑恶程度留待读者由言外想象。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"墙有茨，不可扫也。中冓之言，不可道也。所可道也？言之丑也。","targetNotes":"第一章。","sourceLabel":"第 97 页","sourceNotes":"书内页 97 第一章注析。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","text":"首章以“墙有茨，不可扫也”起兴，程、蒋释“茨”为蒺藜，指出墙茨有防闲、蔽恶之意。又释“中冓”为宫闱内部，故“中冓之言，不可道也”是说宫中丑闻不可外扬。末二句“所可道也？言之丑也”自问自答，点明其事一经言说便成丑闻。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"墙有茨，不可襄也。中冓之言，不可详也。所可详也？言之长也。","targetNotes":"第二章。","sourceLabel":"第 97 页","sourceNotes":"书内页 97 第二章注析。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","text":"次章承首章递进。程、蒋释“襄”为除去，“详”为细说，谓宫闱秽事既难尽除，也不可细陈；若细说其详，则“所可详也？言之长也”，反令丑语牵引滋长。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"墙有茨，不可束也。中冓之言，不可读也。所可读也？言之辱也。","targetNotes":"第三章。","sourceLabel":"第 97 页","sourceNotes":"书内页 97 第三章注析。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","text":"末章再进一层。程、蒋释“束”为打扫干净，较“扫”“襄”义更进；又释“读”为反复地说。故“中冓之言，不可读也”言其丑行不堪传述，“所可读也？言之辱也”则点出凡可传诵者终归为辱。","notes":null}]}]}}}
