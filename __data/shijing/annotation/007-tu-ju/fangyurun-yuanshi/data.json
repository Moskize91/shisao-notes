{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/007-tu-ju/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/007-tu-ju/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 兔罝 · 注释总览","description":"風 · 周南 · 兔罝 · 汇集《诗经原始(上下)》关于《兔罝》的 8 条注释，含 8 条注脚。"},"payload":{"detail":{"route":{"poemId":"007-tu-ju","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/007-tu-ju/fangyurun-yuanshi","poem":{"id":"007-tu-ju","title":"兔罝","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","兔罝"],"segments":[{"id":"seg-001","text":"肅肅兔罝","isActive":false},{"id":"seg-002","text":"㭬之丁丁","isActive":false},{"id":"seg-003","text":"赳赳武夫","isActive":false},{"id":"seg-004","text":"公侯干城","isActive":false},{"id":"seg-005","text":"肅肅兔罝","isActive":false},{"id":"seg-006","text":"施于中逵","isActive":false},{"id":"seg-007","text":"赳赳武夫","isActive":false},{"id":"seg-008","text":"公侯好仇","isActive":false},{"id":"seg-009","text":"肅肅兔罝","isActive":false},{"id":"seg-010","text":"施于中林","isActive":false},{"id":"seg-011","text":"赳赳武夫","isActive":false},{"id":"seg-012","text":"公侯腹心","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":8,"glossCount":8},"annotations":[{"id":"0001","order":1,"total":8,"layer":"global","layerLabel":"全篇总说","targetText":"题注","targetNotes":"对应 item-0016 题注。","sourceLabel":null,"sourceNotes":"item-0016.txt 第 3 行。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注","text":"题注为“美獵士爲王氣所特鍾也”，先点出此篇并非泛美野人，而是称美随王游猎的武士独得王气钟灵。","notes":null}]},{"id":"0002","order":2,"total":8,"layer":"span","layerLabel":"诗句片段","targetText":"肅肅兔罝，㭬之丁丁。赳赳武夫，公侯干城。","targetNotes":"第一章。","sourceLabel":null,"sourceNotes":"item-0016.txt 第 5 行。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":null,"text":"首章云“此層淺”，由“肅肅”写军容严肃之貌，先以“干城”点出这些武夫足为公侯屏翰。","notes":null}]},{"id":"0003","order":3,"total":8,"layer":"span","layerLabel":"诗句片段","targetText":"肅肅兔罝，施于中逵。赳赳武夫，公侯好仇。","targetNotes":"第二章。","sourceLabel":null,"sourceNotes":"item-0016.txt 第 6 行。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":null,"text":"次章云“此層深”，由“干城”进一步写到“好仇”，谓其不但可御侮，且足与公侯相匹配。","notes":null}]},{"id":"0004","order":4,"total":8,"layer":"span","layerLabel":"诗句片段","targetText":"肅肅兔罝，施于中林。赳赳武夫，公侯腹心。","targetNotes":"第三章。","sourceLabel":null,"sourceNotes":"item-0016.txt 第 7 行。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":null,"text":"三章云“此層更深”，以“腹心”收束，见这些武夫已深得信任，可以托为心膂之寄。","notes":null}]},{"id":"0005","order":5,"total":8,"layer":"global","layerLabel":"全篇总说","targetText":"总评","targetNotes":"对应 item-0016 总评。","sourceLabel":null,"sourceNotes":"item-0016.txt 第 9 行。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"方玉润","sectionLabel":"总评","text":"方玉润力驳《小序》所谓“后妃之化”与《集传》所谓德化俗美之说，认为都属无征附会。其转引《墨子》“文王舉閎夭、太顛於罝網之中”之说后，又进一步指出此篇所咏更像羽林卫士扈蹕游猎，英姿魁梧，令人由其从龙者之众而知西伯王气必昌，故“干城”“好仇”“腹心”皆是王气所钟之征。","notes":null}]},{"id":"0006","order":6,"total":8,"layer":"global","layerLabel":"全篇总说","targetText":"眉评","targetNotes":"对应 item-0016 眉评。","sourceLabel":null,"sourceNotes":"item-0016.txt 第 11 行。","notes":null,"glosses":[{"key":"0006-1","attributionLabel":"方玉润","sectionLabel":"眉评","text":"眉评认为首章“肅肅”二字便写尽军容严肃，而“干城、好仇、腹心”三层递进都可从此二字生发，寥寥数语已足统摄大赋写猎的气象。","notes":null}]},{"id":"0007","order":7,"total":8,"layer":"global","layerLabel":"全篇总说","targetText":"集释","targetNotes":"对应 item-0016 集释。","sourceLabel":null,"sourceNotes":"item-0016.txt 第 13 行。","notes":null,"glosses":[{"key":"0007-1","attributionLabel":"方玉润","sectionLabel":"集释","text":"集释依次解释罝、丁丁、赳赳、逵、好仇、腹心诸词，并引《爾雅》、李巡注与许氏恒说，说明张罝捕兔、击橛张网之法，以及“腹心”即同心同德、可为心膂之助。","notes":null}]},{"id":"0008","order":8,"total":8,"layer":"global","layerLabel":"全篇总说","targetText":"标韵","targetNotes":"对应 item-0016 标韵。","sourceLabel":null,"sourceNotes":"item-0016.txt 第 15 行。","notes":null,"glosses":[{"key":"0008-1","attributionLabel":"方玉润","sectionLabel":"标韵","text":"标韵以“罝、夫”通韵，首章又见“丁、城”相协；二章“逵、仇”叶韵；三章“林、心”本韵相承。","notes":null}]}]}}}
