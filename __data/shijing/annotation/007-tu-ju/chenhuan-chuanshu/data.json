{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/007-tu-ju/chenhuan-chuanshu","dataHref":"/__data/shijing/annotation/007-tu-ju/chenhuan-chuanshu/data.json","title":"詩毛氏傳疏 · 兔罝 · 注释总览","description":"風 · 周南 · 兔罝 · 汇集《詩毛氏傳疏》关于《兔罝》的 5 条 annotation，含 5 条 gloss。"},"payload":{"detail":{"route":{"poemId":"007-tu-ju","materialId":"chenhuan-chuanshu"},"href":"/shijing/annotation/007-tu-ju/chenhuan-chuanshu","poem":{"id":"007-tu-ju","title":"兔罝","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","兔罝"],"segments":[{"id":"seg-001","text":"肅肅兔罝","isActive":false},{"id":"seg-002","text":"㭬之丁丁","isActive":false},{"id":"seg-003","text":"赳赳武夫","isActive":false},{"id":"seg-004","text":"公侯干城","isActive":false},{"id":"seg-005","text":"肅肅兔罝","isActive":false},{"id":"seg-006","text":"施于中逵","isActive":false},{"id":"seg-007","text":"赳赳武夫","isActive":false},{"id":"seg-008","text":"公侯好仇","isActive":false},{"id":"seg-009","text":"肅肅兔罝","isActive":false},{"id":"seg-010","text":"施于中林","isActive":false},{"id":"seg-011","text":"赳赳武夫","isActive":false},{"id":"seg-012","text":"公侯腹心","isActive":false}]},"material":{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","authors":["陳奐"],"contributorLine":"清 · 陳奐","era":"清","publicationYear":1847,"carrier":"PDF"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"preface","layerLabel":"篇序","targetText":"序《兔罝》","targetNotes":"篇首引用后妃之化并引《集传》和《墨子》之说。","sourceLabel":"第 37 页","sourceNotes":"PDF 第 37 页页首。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"疏：此诗承《桃夭》诸篇而申后妃之化，谓自《关雎》起天下人皆好德、贤才众多，至罝兔猎者亦能恭敬可用，文王驾猎遇英帅，王气所钟。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"肅肅兔罝，㭬之丁丁。赳赳武夫，公侯干城。","targetNotes":"首章传疏。","sourceLabel":"第 37-38 页","sourceNotes":"PDF 第 37-38 页的首章注。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"疏称“肅肅”写军容严肃，兔罝捕猎之人恭敬如仪，公侯令其守城为干城之用，足见贤才众多。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"肅肅兔罝，施于中逵。赳赳武夫，公侯好仇。","targetNotes":"第二章传疏。","sourceLabel":"第 38 页","sourceNotes":"PDF 第 38 页中段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"疏云“逵”即九达之道，抒文王驾猎之路连绵，武夫之人能匹公侯为“好仇”，见其可与贤者匹配。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"肅肅兔罝，施于中林。赳赳武夫，公侯腹心。","targetNotes":"第三章传疏。","sourceLabel":"第 38-39 页","sourceNotes":"PDF 第 38-39 页的末章与收尾。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"疏称“腹心”乃同心同德之臣，诗借此结尾，强调罝兔之人不仅能御侮，更可为腹心之臣、行攻伐之计。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"兔罝三章章四句","targetNotes":"章句总说。","sourceLabel":"第 39 页","sourceNotes":"PDF 第 39 页末段“兔罝三章章四句”。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"疏附“章四句”，称诸章皆在述王气所钟之精锐，结尾以三章四句汇总，呼应前文所述军容、好仇、腹心三层。","notes":null}]}]}}}
