{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/007-tu-ju/zhuxi-shijichuan-kr1c0009","dataHref":"/__data/shijing/annotation/007-tu-ju/zhuxi-shijichuan-kr1c0009/data.json","title":"詩集傳 · 兔罝 · 注释总览","description":"風 · 周南 · 兔罝 · 汇集《詩集傳》关于《兔罝》的 4 条注释，含 6 条注脚。"},"payload":{"detail":{"route":{"poemId":"007-tu-ju","materialId":"zhuxi-shijichuan-kr1c0009"},"href":"/shijing/annotation/007-tu-ju/zhuxi-shijichuan-kr1c0009","poem":{"id":"007-tu-ju","title":"兔罝","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","兔罝"],"segments":[{"id":"seg-001","text":"肅肅兔罝","isActive":true},{"id":"seg-002","text":"椓之丁丁","isActive":true},{"id":"seg-003","text":"﨣﨣武夫","isActive":true},{"id":"seg-004","text":"公矦干城","isActive":true},{"id":"seg-005","text":"肅肅兔罝","isActive":false},{"id":"seg-006","text":"施于中逵","isActive":false},{"id":"seg-007","text":"﨣﨣武夫","isActive":false},{"id":"seg-008","text":"公矦好仇","isActive":false},{"id":"seg-009","text":"肅肅兔罝","isActive":false},{"id":"seg-010","text":"施于中林","isActive":false},{"id":"seg-011","text":"﨣﨣武夫","isActive":false},{"id":"seg-012","text":"公矦腹心","isActive":false}]},"material":{"id":"zhuxi-shijichuan-kr1c0009","title":"詩集傳","authors":["朱熹"],"contributorLine":"宋 · 朱熹","era":"宋","publicationYear":1186,"carrier":"TXT"},"stats":{"annotationCount":4,"glossCount":6},"annotations":[{"id":"0001","order":1,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"肅肅兔罝，椓之丁丁。﨣﨣武夫，公矦干城。","targetNotes":"首章并章句说明。","sourceLabel":null,"sourceNotes":"对应 txt 155-159 行。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"朱熹","sectionLabel":"传","text":"興也。肅肅，整飭貌。罝，罟也。丁丁，椓杙聲也。﨣﨣，武貌。干，盾也。干城，皆所以扞外而衛内者。","notes":null},{"key":"0001-2","attributionLabel":"朱熹","sectionLabel":"传","text":"化行俗美，賢才衆多，雖罝兔之野人而其才之可用猶如此，故詩人因其所事以起興而美之，而文王德化之盛因可見矣。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"肅肅兔罝，施于中逵。﨣﨣武夫，公矦好仇。","targetNotes":"第二章并章句说明。","sourceLabel":null,"sourceNotes":"对应 txt 159-161 行。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"朱熹","sectionLabel":"传","text":"興也。逵，九達之道。仇與逑同。康衡引《關雎》亦作仇字。","notes":null},{"key":"0002-2","attributionLabel":"朱熹","sectionLabel":"传","text":"公矦善匹，猶曰聖人之耦，則非特干城而已，歎美之無已也。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"肅肅兔罝，施于中林。﨣﨣武夫，公矦腹心。","targetNotes":"第三章并章句说明。","sourceLabel":null,"sourceNotes":"对应 txt 163-165 行。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"朱熹","sectionLabel":"传","text":"興也。中林，林中。腹心，同心同德之謂，則又非特好仇而已也。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"兔罝三章章四句","targetNotes":"章句总说。","sourceLabel":null,"sourceNotes":"对应 txt 166 行。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"朱熹","sectionLabel":"总评","text":"兔罝三章章四句。","notes":null}]}]}}}
