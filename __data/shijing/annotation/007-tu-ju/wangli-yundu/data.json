{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/007-tu-ju/wangli-yundu","dataHref":"/__data/shijing/annotation/007-tu-ju/wangli-yundu/data.json","title":"詩經韻讀 · 兔罝 · 注释总览","description":"風 · 周南 · 兔罝 · 汇集《詩經韻讀》关于《兔罝》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"007-tu-ju","materialId":"wangli-yundu"},"href":"/shijing/annotation/007-tu-ju/wangli-yundu","poem":{"id":"007-tu-ju","title":"兔罝","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","兔罝"],"segments":[{"id":"seg-001","text":"肅肅兔罝","isActive":false},{"id":"seg-002","text":"椓之丁丁","isActive":false},{"id":"seg-003","text":"赳赳武夫","isActive":false},{"id":"seg-004","text":"公侯干城","isActive":false},{"id":"seg-005","text":"肅肅兔罝","isActive":false},{"id":"seg-006","text":"施于中逵","isActive":false},{"id":"seg-007","text":"赳赳武夫","isActive":false},{"id":"seg-008","text":"公侯好仇","isActive":false},{"id":"seg-009","text":"肅肅兔罝","isActive":false},{"id":"seg-010","text":"施于中林","isActive":false},{"id":"seg-011","text":"赳赳武夫","isActive":false},{"id":"seg-012","text":"公侯腹心","isActive":false}]},"material":{"id":"wangli-yundu","title":"詩經韻讀","authors":["王力"],"contributorLine":"现代 · 王力","era":"现代","publicationYear":1980,"carrier":"PDF"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"《兔罝》韵读段","targetNotes":"书页 140 的整段韵读说明。","sourceLabel":"第 140 页局部","sourceNotes":"页图 /tmp/wangli-scan/148.png。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"王力","sectionLabel":"韵读","text":"整段继续沿用本书的韵读体例：每小节末句括注拟音并标出所属韵部，强调“干城”、“好仇”、“腹心”三层递进。条目后附注音字母与部类，供诗词发音参考。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"肅肅兔罝，椓之丁丁。赳赳武夫，公侯干城。","targetNotes":"首章。","sourceLabel":"第 140 页局部","sourceNotes":"页图 /tmp/wangli-scan/148.png 上半段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"王力","sectionLabel":"韵读","text":"首章括注“tia”、“丁丁”等拟音，并按鱼部列出“干城”，强调首章描写的武夫之威武。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"肅肅兔罝，施于中逵。赳赳武夫，公侯好仇。","targetNotes":"第二章。","sourceLabel":"第 140 页局部","sourceNotes":"页图 /tmp/wangli-scan/148.png 中段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"王力","sectionLabel":"韵读","text":"第二章注音“giu”、“giu”表示“逵”与“仇”的韵脚，说明此处诗人把武力与交往之道并列。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"肅肅兔罝，施于中林。赳赳武夫，公侯腹心。","targetNotes":"第三章。","sourceLabel":"第 140 页局部","sourceNotes":"页图 /tmp/wangli-scan/148.png 下段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"王力","sectionLabel":"韵读","text":"第三章附注“liam”、“siam”分别指“林”“腹心”，并标出真部，强调这些武夫已成为公侯腹心之臣。","notes":null}]}]}}}
