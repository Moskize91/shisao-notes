{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/007-tu-ju/maoheng-zhushu-kr1c0004","dataHref":"/__data/shijing/annotation/007-tu-ju/maoheng-zhushu-kr1c0004/data.json","title":"毛詩注疏 · 兔罝 · 注释总览","description":"風 · 周南 · 兔罝 · 汇集《毛詩注疏》关于《兔罝》的 5 条注释，含 9 条注脚。"},"payload":{"detail":{"route":{"poemId":"007-tu-ju","materialId":"maoheng-zhushu-kr1c0004"},"href":"/shijing/annotation/007-tu-ju/maoheng-zhushu-kr1c0004","poem":{"id":"007-tu-ju","title":"兔罝","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","兔罝"],"segments":[{"id":"seg-001","text":"肅肅兔罝","isActive":false},{"id":"seg-002","text":"㭬之丁丁","isActive":false},{"id":"seg-003","text":"赳赳武夫","isActive":false},{"id":"seg-004","text":"公侯干城","isActive":false},{"id":"seg-005","text":"肅肅兔罝","isActive":false},{"id":"seg-006","text":"施于中逵","isActive":false},{"id":"seg-007","text":"赳赳武夫","isActive":false},{"id":"seg-008","text":"公侯好仇","isActive":false},{"id":"seg-009","text":"肅肅兔罝","isActive":false},{"id":"seg-010","text":"施于中林","isActive":false},{"id":"seg-011","text":"赳赳武夫","isActive":false},{"id":"seg-012","text":"公侯腹心","isActive":false}]},"material":{"id":"maoheng-zhushu-kr1c0004","title":"毛詩注疏","authors":["毛亨","鄭氏","孔穎達"],"contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","era":"漢唐","publicationYear":653,"carrier":"TXT"},"stats":{"annotationCount":5,"glossCount":9},"annotations":[{"id":"0001","order":1,"total":5,"layer":"preface","layerLabel":"篇序","targetText":"序《兔罝》","targetNotes":"篇首小序与孔疏提要。","sourceLabel":null,"sourceNotes":"对应 txt 981-991 行。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序","text":"序：兔罝，后妃之化也。關雎之化行則莫不好德，賢人衆多也。","notes":null},{"key":"0001-2","attributionLabel":"孔疏","sectionLabel":null,"text":"疏：此篇承《桃夭》以下诸篇而申后妃之化，谓由《關雎》之化行於天下，故人皆好德，賢者衆多，至於罝兔之人亦能恭敬可用。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"肅肅兔罝，㭬之丁丁。赳赳武夫，公侯干城。","targetNotes":"首章。","sourceLabel":null,"sourceNotes":"对应 txt 992-1012 行。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：肅肅，敬也。兔罝，兔罟也。丁丁，㭬杙聲也。赳赳，武貌。干，扞也。","notes":null},{"key":"0002-2","attributionLabel":"郑笺","sectionLabel":null,"text":"箋云：罝兔之人，鄙賤之事猶能恭敬，則是賢者衆多也。干也、城也，皆以禦難也。此罝兔之人賢者也，有武力可任為將帥之德，諸侯可任以國守，扞城其民，折衝禦難於未然。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"肅肅兔罝，施于中逵。赳赳武夫，公侯好仇。","targetNotes":"第二章。","sourceLabel":null,"sourceNotes":"对应 txt 1013-1022 行。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：逵，九達之道。","notes":null},{"key":"0003-2","attributionLabel":"郑笺","sectionLabel":null,"text":"箋云：怨耦曰仇。此罝兔之人，敵國有來侵伐者，可使和好之，亦言賢也。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"肅肅兔罝，施于中林。赳赳武夫，公侯腹心。","targetNotes":"第三章。","sourceLabel":null,"sourceNotes":"对应 txt 1023-1032 行。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：中林，林中。可以制斷公侯之腹心。","notes":null},{"key":"0004-2","attributionLabel":"郑笺","sectionLabel":null,"text":"箋云：此罝兔之人於行攻伐，可用為策謀之臣，使之慮無，亦言賢也。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"兔罝三章章四句","targetNotes":"章句总说。","sourceLabel":null,"sourceNotes":"对应 txt 1034 行。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"章句","sectionLabel":null,"text":"兔罝三章章四句。","notes":null}]}]}}}
