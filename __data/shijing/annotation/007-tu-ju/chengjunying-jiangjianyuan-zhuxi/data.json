{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/007-tu-ju/chengjunying-jiangjianyuan-zhuxi","dataHref":"/__data/shijing/annotation/007-tu-ju/chengjunying-jiangjianyuan-zhuxi/data.json","title":"詩經注析 · 兔罝 · 注释总览","description":"風 · 周南 · 兔罝 · 汇集《詩經注析》关于《兔罝》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"007-tu-ju","materialId":"chengjunying-jiangjianyuan-zhuxi"},"href":"/shijing/annotation/007-tu-ju/chengjunying-jiangjianyuan-zhuxi","poem":{"id":"007-tu-ju","title":"兔罝","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","兔罝"],"segments":[{"id":"seg-001","text":"肅肅兔罝","isActive":false},{"id":"seg-002","text":"椓之丁丁","isActive":false},{"id":"seg-003","text":"赳赳武夫","isActive":false},{"id":"seg-004","text":"公侯干城","isActive":false},{"id":"seg-005","text":"肅肅兔罝","isActive":false},{"id":"seg-006","text":"施于中逵","isActive":false},{"id":"seg-007","text":"赳赳武夫","isActive":false},{"id":"seg-008","text":"公侯好仇","isActive":false},{"id":"seg-009","text":"肅肅兔罝","isActive":false},{"id":"seg-010","text":"施于中林","isActive":false},{"id":"seg-011","text":"赳赳武夫","isActive":false},{"id":"seg-012","text":"公侯腹心","isActive":false}]},"material":{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","authors":["程俊英","蔣見元"],"contributorLine":"现代 · 程俊英、蔣見元","era":"现代","publicationYear":1991,"carrier":"PDF"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"题解","targetNotes":"依照书中题解与引文说明。","sourceLabel":"第 39 页","sourceNotes":"第 39 页题解段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"题解称《兔罝》是赞颂美猎士的诗，吟在路上远观英勇猎人设网捕兔，连想起这些武者可保家国的才力，因而以“肅肅”写出严整军容，并借《说文》《文王》诸说说明此诗所叙的猎人与治世之德紧密相联。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"肅肅兔罝，椓之丁丁。赳赳武夫，公侯干城。","targetNotes":"首章注释。","sourceLabel":"第 39 页","sourceNotes":"第 39 页首章段落。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"首章以“肅肅”展开军容，写猎人以丁丁之声击网、手持武器，形容其武夫仪态，言其可做公侯的干城、守护国家的屏翰。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"肅肅兔罝，施于中逵。赳赳武夫，公侯好仇。","targetNotes":"第二章注释。","sourceLabel":"第 39-40 页","sourceNotes":"第 39-40 页中段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"第二章承上写“施于中逵”，以逵九达之道比喻猎人可匹敌豪杰，并说“赳赳武夫”不只可扞城，且能与公侯好仇，暗含此人兼具文武，可垂名于朝。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"肅肅兔罝，施于中林。赳赳武夫，公侯腹心。","targetNotes":"第三章注释。","sourceLabel":"第 40 页","sourceNotes":"第 40 页下段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"第三章以“腹心”收束，指这些武夫可作心膂之力，书中引《礼》说其能制断公侯腹心，即表示长傅之职与谋略才能。","notes":null}]}]}}}
