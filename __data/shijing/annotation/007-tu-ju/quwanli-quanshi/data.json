{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/007-tu-ju/quwanli-quanshi","dataHref":"/__data/shijing/annotation/007-tu-ju/quwanli-quanshi/data.json","title":"詩經詮釋 · 兔罝 · 注释总览","description":"風 · 周南 · 兔罝 · 汇集《詩經詮釋》关于《兔罝》的 1 条 annotation，含 11 条 gloss。"},"payload":{"detail":{"route":{"poemId":"007-tu-ju","materialId":"quwanli-quanshi"},"href":"/shijing/annotation/007-tu-ju/quwanli-quanshi","poem":{"id":"007-tu-ju","title":"兔罝","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","兔罝"],"segments":[{"id":"seg-001","text":"肅肅兔罝","isActive":true},{"id":"seg-002","text":"㭬之丁丁","isActive":true},{"id":"seg-003","text":"赳赳武夫","isActive":true},{"id":"seg-004","text":"公侯干城","isActive":true},{"id":"seg-005","text":"肅肅兔罝","isActive":true},{"id":"seg-006","text":"施于中逵","isActive":true},{"id":"seg-007","text":"赳赳武夫","isActive":true},{"id":"seg-008","text":"公侯好仇","isActive":true},{"id":"seg-009","text":"肅肅兔罝","isActive":true},{"id":"seg-010","text":"施于中林","isActive":true},{"id":"seg-011","text":"赳赳武夫","isActive":true},{"id":"seg-012","text":"公侯腹心","isActive":true}]},"material":{"id":"quwanli-quanshi","title":"詩經詮釋","authors":["屈萬里"],"contributorLine":"现代 · 屈萬里","era":"现代","publicationYear":1983,"carrier":"PDF"},"stats":{"annotationCount":1,"glossCount":11},"annotations":[{"id":"0001","order":1,"total":1,"layer":"global","layerLabel":"全篇总说","targetText":"肅肅兔罝，㭬之丁丁。赳赳武夫，公侯干城。肅肅兔罝，施于中逵。赳赳武夫，公侯好仇。肅肅兔罝，施于中林。赳赳武夫，公侯腹心。","targetNotes":"全诗正文与第 49 页注释连贯。","sourceLabel":"第 49 页局部","sourceNotes":"第 49-50 页《注释》及续注段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"屈万里","sectionLabel":"注释","text":"此颂武人之诗。","notes":null},{"key":"0001-2","attributionLabel":"屈万里","sectionLabel":"注释","text":"肃肃兔罝，盖缩缩之假借。近人朱氏云：“缩，敛也，即密也。”","notes":null},{"key":"0001-3","attributionLabel":"屈万里","sectionLabel":"注释","text":"兔罝，兔网也。罝，音宜。","notes":null},{"key":"0001-4","attributionLabel":"屈万里","sectionLabel":"注释","text":"椓，音豚，击也。","notes":null},{"key":"0001-5","attributionLabel":"屈万里","sectionLabel":"注释","text":"丁，音争。丁丁，击杙（椓子）声。","notes":null},{"key":"0001-6","attributionLabel":"屈万里","sectionLabel":"注释","text":"赳，音纠。赳赳，勇武貌。","notes":null},{"key":"0001-7","attributionLabel":"屈万里","sectionLabel":"注释","text":"干，盾也。盾以护身，城以阻敌。干城，犹言护卫也。","notes":null},{"key":"0001-8","attributionLabel":"屈万里","sectionLabel":"注释","text":"施，置也，布也。","notes":null},{"key":"0001-9","attributionLabel":"屈万里","sectionLabel":"注释","text":"逵，说文：九达之道也。按：九达之道，非施兔罝之所。疑逵为原处。中逵，违中也。","notes":null},{"key":"0001-10","attributionLabel":"屈万里","sectionLabel":"注释","text":"仇，同逑，匹也。此好仇犹言良伴。","notes":null},{"key":"0001-11","attributionLabel":"屈万里","sectionLabel":"注释","text":"中林，林中也。","notes":null}]}]}}}
