{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/063-you-hu/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/063-you-hu/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 有狐 · 注释总览","description":"風 · 衛風 · 有狐 · 汇集《诗经原始(上下)》关于《有狐》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"063-you-hu","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/063-you-hu/fangyurun-yuanshi","poem":{"id":"063-you-hu","title":"有狐","categoryId":"feng","subcategoryId":"weifeng","path":["風","衛風","有狐"],"segments":[{"id":"seg-001","text":"有狐綏綏","isActive":false},{"id":"seg-002","text":"在彼淇梁","isActive":false},{"id":"seg-003","text":"心之憂矣","isActive":false},{"id":"seg-004","text":"之子無裳","isActive":false},{"id":"seg-005","text":"有狐綏綏","isActive":false},{"id":"seg-006","text":"在彼淇厲","isActive":false},{"id":"seg-007","text":"心之憂矣","isActive":false},{"id":"seg-008","text":"之子無帶","isActive":false},{"id":"seg-009","text":"有狐綏綏","isActive":false},{"id":"seg-010","text":"在彼淇側","isActive":false},{"id":"seg-011","text":"心之憂矣","isActive":false},{"id":"seg-012","text":"之子無服","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"有狐㊟婦人憂夫久役無衣也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标题段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注"}]},{"id":"0002","order":2,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"右《有狐》三章，章四句。《小序》謂「刺時」。《大序》以爲「衛之男女失時，喪其妃耦焉」，已非詩意。《集傳》竟以爲「有寡婦見鰥夫而欲嫁之」，不知何以見其爲寡婦，何以見其爲鰥夫，更何以見其爲而欲嫁之？夫曰「之子」，則明明指其夫矣。曰「無裳」、「無帶」、「無服」，則明明憂其夫之無裳、無帶、無服矣。以有狐作比者，狐性善疑，雖日在「淇梁」、「淇厲」、「淇側」，而終遲疑不渡，故曰「綏綏」也。此必其夫久役在外，淹滯不歸，或有所戀而忘返，故婦人憂之，以爲久羈逆旅，必至金盡裘敝而難歸耳。本無他義，亦少深情，聖人存之，不解何故。","targetNotes":"通篇总评原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"总评"}]},{"id":"0003","order":3,"total":4,"layer":"term","layerLabel":"字词注","targetText":"集釋狐獸名，性淫而多疑。綏綏〔嚴氏粲曰〕綏，本訓安。則綏綏，安綏之意也。狐性多疑，綏綏則獨行而遲疑也。梁橋也。厲深水可涉處也。帶所以申束衣也。","targetNotes":"集释原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"集释"}]},{"id":"0004","order":4,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"標韻梁七陽。裳同。本韻。厲八霽。帶九泰。通韻。側十三職。服一屋，叶蒲北反。叶韻。","targetNotes":"标韵原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标韵段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":"标韵"}]}]}}}
