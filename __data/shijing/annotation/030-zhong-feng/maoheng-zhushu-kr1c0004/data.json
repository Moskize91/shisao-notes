{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/030-zhong-feng/maoheng-zhushu-kr1c0004","dataHref":"/__data/shijing/annotation/030-zhong-feng/maoheng-zhushu-kr1c0004/data.json","title":"毛詩注疏 · 終風 · 注释总览","description":"風 · 邶風 · 終風 · 汇集《毛詩注疏》关于《終風》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"030-zhong-feng","materialId":"maoheng-zhushu-kr1c0004"},"href":"/shijing/annotation/030-zhong-feng/maoheng-zhushu-kr1c0004","poem":{"id":"030-zhong-feng","title":"終風","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","終風"],"segments":[{"id":"seg-001","text":"終風且暴","isActive":false},{"id":"seg-002","text":"顧我則笑","isActive":false},{"id":"seg-003","text":"謔浪笑敖","isActive":false},{"id":"seg-004","text":"中心是悼","isActive":false},{"id":"seg-005","text":"終風且霾","isActive":false},{"id":"seg-006","text":"惠然肯來","isActive":false},{"id":"seg-007","text":"莫往莫來","isActive":false},{"id":"seg-008","text":"悠悠我思","isActive":false},{"id":"seg-009","text":"終風且曀","isActive":false},{"id":"seg-010","text":"不日有曀","isActive":false},{"id":"seg-011","text":"寤言不寐","isActive":false},{"id":"seg-012","text":"願言則嚏","isActive":false},{"id":"seg-013","text":"曀曀其陰","isActive":false},{"id":"seg-014","text":"虺虺其靁","isActive":false},{"id":"seg-015","text":"寤言不寐","isActive":false},{"id":"seg-016","text":"願言則懷","isActive":false}]},"material":{"id":"maoheng-zhushu-kr1c0004","title":"毛詩注疏","authors":["毛亨","鄭氏","孔穎達"],"contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","era":"漢唐","publicationYear":653,"carrier":"TXT"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"preface","layerLabel":"篇序","targetText":"終風衛莊姜傷己也遭州吁之暴見侮慢而不能正也","targetNotes":"篇首小序。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》終風序文。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序","text":"序：《終風》，衛莊姜傷己也。遭州吁之暴，見侮慢而不能正也。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"終風且暴顧我則笑謔浪笑敖中心是悼","targetNotes":"首章。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》首章。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：暴，疾也。謔，戲也。浪，笑貌。敖，戲謔也。中心是悼，動于中而傷于心也。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"終風且霾惠然肯來莫往莫來悠悠我思","targetNotes":"第二章。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》第二章。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：霾，雨土也。惠，順也。莫，無也。悠悠，思也。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"終風且曀不日有曀寤言不寐願言則嚏","targetNotes":"第三章。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》第三章。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：曀，陰而風也。有，又也。嚏，跲也。寤言不寐，覺而有言且不能寐也。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"曀曀其陰虺虺其靁寤言不寐願言則懷","targetNotes":"第四章。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》第四章。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：曀曀，陰貌。虺虺，雷聲也。懷，思也。","notes":null}]}]}}}
