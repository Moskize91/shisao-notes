{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/030-zhong-feng/chengjunying-jiangjianyuan-zhuxi","dataHref":"/__data/shijing/annotation/030-zhong-feng/chengjunying-jiangjianyuan-zhuxi/data.json","title":"詩經注析 · 終風 · 注释总览","description":"風 · 邶風 · 終風 · 汇集《詩經注析》关于《終風》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"030-zhong-feng","materialId":"chengjunying-jiangjianyuan-zhuxi"},"href":"/shijing/annotation/030-zhong-feng/chengjunying-jiangjianyuan-zhuxi","poem":{"id":"030-zhong-feng","title":"終風","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","終風"],"segments":[{"id":"seg-001","text":"终风且暴","isActive":false},{"id":"seg-002","text":"顾我则笑","isActive":false},{"id":"seg-003","text":"谑浪笑敖","isActive":false},{"id":"seg-004","text":"中心是悼","isActive":false},{"id":"seg-005","text":"终风且霾","isActive":false},{"id":"seg-006","text":"惠然肯来","isActive":false},{"id":"seg-007","text":"莫往莫来","isActive":false},{"id":"seg-008","text":"悠悠我思","isActive":false},{"id":"seg-009","text":"终风且曀","isActive":false},{"id":"seg-010","text":"不日有曀","isActive":false},{"id":"seg-011","text":"寤言不寐","isActive":false},{"id":"seg-012","text":"愿言则嚏","isActive":false},{"id":"seg-013","text":"曀曀其阴","isActive":false},{"id":"seg-014","text":"虺虺其雷","isActive":false},{"id":"seg-015","text":"寤言不寐","isActive":false},{"id":"seg-016","text":"愿言则怀","isActive":false}]},"material":{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","authors":["程俊英","蔣見元"],"contributorLine":"现代 · 程俊英、蔣見元","era":"现代","publicationYear":1991,"carrier":"PDF"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"题解","targetNotes":"题解总说。","sourceLabel":"第 57-58 页","sourceNotes":"书内页 57 下半至 58《题解》段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"程、蒋认为《终风》写的是一位妇女被丈夫轻薄、玩弄、冷落后的怨恋之情。题解指出《毛序》以庄姜遭州吁之暴为说，既与诗中“顾我则笑”“惠然肯来”等辞不合，也无足够确据；就诗意看，四章层层写出既恨其轻狂、又不能断绝思念的矛盾心理。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"终风且暴，顾我则笑。谑浪笑敖，中心是悼。","targetNotes":"首章。","sourceLabel":"第 58 页","sourceNotes":"书内页 58 首章注析。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"注析","text":"程、蒋释“暴”为迅疾，以疾风兴丈夫的狂暴轻薄；“谑浪笑敖”则写其调戏放纵、把玩取笑。“中心是悼”不是单纯恐惧，而是因被轻侮而又无法摆脱其人，于是心中伤悼交集。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"终风且霾，惠然肯来。莫往莫来，悠悠我思。","targetNotes":"第二章。","sourceLabel":"第 59 页","sourceNotes":"书内页 59 第二章注析。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"注析","text":"此章语气一转。程、蒋以“霾”写风尘昏暗，比丈夫心意阴晦无常；“惠然肯来”只是她对其回心转意的希冀，而“莫往莫来”却又写现实中终不见其往来，于是思念绵长，怨中仍带恋意。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"终风且曀，不日有曀。寤言不寐，愿言则嚏。","targetNotes":"第三章。","sourceLabel":"第 59 页","sourceNotes":"书内页 59 第三章注析。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"注析","text":"程、蒋释“曀”为阴而有风，“不日有曀”是说刚见暂时开朗，不久又复阴晦，比其丈夫偶有转机而终究复蔽。女子因此彻夜不眠，希望对方也能因思己而打喷嚏，写出无望中仍不肯自断的痴想。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"曀曀其阴，虺虺其雷。寤言不寐，愿言则怀。","targetNotes":"第四章。","sourceLabel":"第 59 页","sourceNotes":"书内页 59 第四章注析。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"注析","text":"末章把风雷阴翳写得更重。程、蒋据旧注以“虺虺”为雷将发之声，“怀”为思念，并指出这里已不只盼对方知我思念，更隐含希望其反过来思我、悔悟前非。全诗至此，把弃妇既怨又恋的矛盾心理推到极致。","notes":null}]}]}}}
