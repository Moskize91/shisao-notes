{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/030-zhong-feng/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/030-zhong-feng/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 終風 · 注释总览","description":"風 · 邶風 · 終風 · 汇集《诗经原始(上下)》关于《終風》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"030-zhong-feng","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/030-zhong-feng/fangyurun-yuanshi","poem":{"id":"030-zhong-feng","title":"終風","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","終風"],"segments":[{"id":"seg-001","text":"終風且暴","isActive":false},{"id":"seg-002","text":"顧我則笑","isActive":false},{"id":"seg-003","text":"謔浪笑敖","isActive":false},{"id":"seg-004","text":"中心是悼","isActive":false},{"id":"seg-005","text":"終風且霾","isActive":false},{"id":"seg-006","text":"惠然肯來","isActive":false},{"id":"seg-007","text":"莫往莫來","isActive":false},{"id":"seg-008","text":"悠悠我思","isActive":false},{"id":"seg-009","text":"終風且曀","isActive":false},{"id":"seg-010","text":"不日有曀","isActive":false},{"id":"seg-011","text":"寤言不寐","isActive":false},{"id":"seg-012","text":"願言則嚏","isActive":false},{"id":"seg-013","text":"曀曀其陰","isActive":false},{"id":"seg-014","text":"虺虺其靁","isActive":false},{"id":"seg-015","text":"寤言不寐","isActive":false},{"id":"seg-016","text":"願言則懷","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"終風㊟衛莊姜傷所遇不淑也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标题段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注","text":"方玉润在题注中将《終風》径定为卫庄姜伤所遇不淑之诗，直指其所遭者是庄公而非州吁。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"总评","targetNotes":"通篇总评。","sourceLabel":null,"sourceNotes":"对应 EPUB item 总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"总评","text":"方玉润明言《序》以州吁之暴说《終風》不通，因为“顧我則笑”“惠然肯來”绝非子对母所宜出之语；仍从朱熹，以为庄姜伤庄公而作。他解释前二章写庄公狂荡暴疾、来往无定，后二章则写庄姜度日如终风阴曀、忧郁成疾，并强调“終風”诸句当作兴不作比，诗意方能曲折深长。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"term","layerLabel":"字词注","targetText":"終風且暴謔浪笑敖中心是悼終風且霾惠然肯來終風且曀願言則嚏曀曀其陰虺虺其靁願言則懷","targetNotes":"集释撮要。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"集释","text":"方玉润集释云：“終風”为终日之风，“暴”为疾，“謔”为戏言，“浪”为放荡，“悼”为伤，“霾”为雨土蒙雾，“惠”为顺，“曀”为阴而风，“嚏”为鼽嚏，“曀曀”为阴貌，“虺虺”为雷将发而未震之声，“懷”为怀抱不释。整组训诂皆为说明所遇之人狂荡反覆。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"标韵","targetNotes":"四章韵脚撮述。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标韵段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":"标韵","text":"方玉润分章标出韵脚：首章“暴、笑、敖、悼”通韵，次章“霾、來、來、思”通韵，三章“曀、曀、嚏”为本韵，四章“靁、懷”通韵。其标韵与总评相呼应，见四章层次分明而情绪一气贯穿。","notes":null}]}]}}}
