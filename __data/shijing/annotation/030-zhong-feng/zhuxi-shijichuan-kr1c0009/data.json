{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/030-zhong-feng/zhuxi-shijichuan-kr1c0009","dataHref":"/__data/shijing/annotation/030-zhong-feng/zhuxi-shijichuan-kr1c0009/data.json","title":"詩集傳 · 終風 · 注释总览","description":"風 · 邶風 · 終風 · 汇集《詩集傳》关于《終風》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"030-zhong-feng","materialId":"zhuxi-shijichuan-kr1c0009"},"href":"/shijing/annotation/030-zhong-feng/zhuxi-shijichuan-kr1c0009","poem":{"id":"030-zhong-feng","title":"終風","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","終風"],"segments":[{"id":"seg-001","text":"終風且暴","isActive":true},{"id":"seg-002","text":"顧我則笑","isActive":true},{"id":"seg-003","text":"謔浪笑敖","isActive":true},{"id":"seg-004","text":"中心是悼","isActive":true},{"id":"seg-005","text":"終風且霾","isActive":false},{"id":"seg-006","text":"惠然肯來","isActive":false},{"id":"seg-007","text":"莫往莫來","isActive":false},{"id":"seg-008","text":"悠悠我思","isActive":false},{"id":"seg-009","text":"終風且曀","isActive":false},{"id":"seg-010","text":"不日有曀","isActive":false},{"id":"seg-011","text":"寤言不寐","isActive":false},{"id":"seg-012","text":"願言則嚏","isActive":false},{"id":"seg-013","text":"曀曀其陰","isActive":false},{"id":"seg-014","text":"虺虺其靁","isActive":false},{"id":"seg-015","text":"寤言不寐","isActive":false},{"id":"seg-016","text":"願言則懷","isActive":false}]},"material":{"id":"zhuxi-shijichuan-kr1c0009","title":"詩集傳","authors":["朱熹"],"contributorLine":"宋 · 朱熹","era":"宋","publicationYear":1186,"carrier":"TXT"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"終風且暴，顧我則笑。謔浪笑敖，中心是悼。","targetNotes":"首章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》終風首章。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"朱熹","sectionLabel":null,"text":"比也。朱熹从庄姜伤庄公说，以终风暴疾比其人狂荡轻薄；“顧我則笑”“謔浪笑敖”写其见侮慢而失礼，故妇人中心伤悼。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"終風且霾，惠然肯來。莫往莫來，悠悠我思。","targetNotes":"第二章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》終風第二章。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"朱熹","sectionLabel":null,"text":"比也。朱熹认为第二章语意已转，从首章之伤转入思望；“惠然肯來”只是冀望之辞，而“莫往莫來”终归于其不至，于是悠悠之思愈长。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"終風且曀，不日有曀。寤言不寐，願言則嚏。","targetNotes":"第三章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》終風第三章。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"朱熹","sectionLabel":null,"text":"比也。朱熹以“不日有曀”为暂开而复蔽，仍比其人情意反复；“願言則嚏”则承思望而来，写其想念之深，至于觉而有言、终夜不寐。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"曀曀其陰，虺虺其靁。寤言不寐，願言則懷。","targetNotes":"第四章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》終風第四章。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"朱熹","sectionLabel":null,"text":"比也。朱熹认为末章风雷愈甚，比其狂惑愈深；而“願言則懷”则比前三章更进一步，不仅我思其人，更希望其人念我。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"終風四章章四句","targetNotes":"章句总说。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》終風章句总说。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"朱熹","sectionLabel":null,"text":"朱熹记《終風》为四章、章四句，并以庄姜伤庄公之说统摄全篇，故章解都兼见见侮之怨与不能已之思。","notes":null}]}]}}}
