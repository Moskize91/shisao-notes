{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/025-zou-yu/chenhuan-chuanshu","dataHref":"/__data/shijing/annotation/025-zou-yu/chenhuan-chuanshu/data.json","title":"詩毛氏傳疏 · 騶虞 · 注释总览","description":"風 · 召南 · 騶虞 · 汇集《詩毛氏傳疏》关于《騶虞》的 2 条注释，含 2 条注脚。"},"payload":{"detail":{"route":{"poemId":"025-zou-yu","materialId":"chenhuan-chuanshu"},"href":"/shijing/annotation/025-zou-yu/chenhuan-chuanshu","poem":{"id":"025-zou-yu","title":"騶虞","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","騶虞"],"segments":[{"id":"seg-001","text":"彼茁者葭","isActive":false},{"id":"seg-002","text":"壹發五豝","isActive":false},{"id":"seg-003","text":"于嗟乎騶虞","isActive":false},{"id":"seg-004","text":"彼茁者蓬","isActive":false},{"id":"seg-005","text":"壹發五豵","isActive":false},{"id":"seg-006","text":"于嗟乎騶虞","isActive":false}]},"material":{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","authors":["陳奐"],"contributorLine":"清 · 陳奐","era":"清","publicationYear":1847,"carrier":"PDF"},"stats":{"annotationCount":2,"glossCount":2},"annotations":[{"id":"0001","order":1,"total":2,"layer":"preface","layerLabel":"篇序","targetText":"騶虞鵲巢之應也鵲巢之化行人倫既正朝廷既治天下純被文王之化則庶類蕃殖蒐田以時仁如騶虞則王道成也","targetNotes":"篇首序文。","sourceLabel":"第 47 页","sourceNotes":"据第 47 页《騶虞》序义。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序","text":"序：《騶虞》，鵲巢之應也。鵲巢之化行，人倫既正，朝廷既治，天下純被文王之化，則庶類蕃殖，蒐田以時，仁如騶虞，則王道成也。","notes":null}]},{"id":"0002","order":2,"total":2,"layer":"span","layerLabel":"诗句片段","targetText":"彼茁者葭，壹發五豝，于嗟乎騶虞。彼茁者蓬，壹發五豵，于嗟乎騶虞。","targetNotes":"通篇经传疏解。","sourceLabel":"第 47-48 页","sourceNotes":"据第 47-48 页《騶虞》经传疏。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"陈奂遵《序》与毛郑旧义，把《騶虞》看作文王化行、蒐田以时而庶类蕃殖的颂辞。“壹發五豝”“壹發五豵”皆被解释为虞人翼兽以待君发，意在见其不尽杀之仁；末句“于嗟乎騶虞”则是借义兽以叹仁人，归结到王道已成。","notes":null}]}]}}}
