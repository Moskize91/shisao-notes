{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/025-zou-yu/wangli-yundu","dataHref":"/__data/shijing/annotation/025-zou-yu/wangli-yundu/data.json","title":"詩經韻讀 · 騶虞 · 注释总览","description":"風 · 召南 · 騶虞 · 汇集《詩經韻讀》关于《騶虞》的 2 条注释，含 2 条注脚。"},"payload":{"detail":{"route":{"poemId":"025-zou-yu","materialId":"wangli-yundu"},"href":"/shijing/annotation/025-zou-yu/wangli-yundu","poem":{"id":"025-zou-yu","title":"騶虞","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","騶虞"],"segments":[{"id":"seg-001","text":"彼茁者葭","isActive":false},{"id":"seg-002","text":"壹发五豝","isActive":false},{"id":"seg-003","text":"于嗟乎驺虞","isActive":false},{"id":"seg-004","text":"彼茁者蓬","isActive":false},{"id":"seg-005","text":"壹发五豵","isActive":false},{"id":"seg-006","text":"于嗟乎驺虞","isActive":false}]},"material":{"id":"wangli-yundu","title":"詩經韻讀","authors":["王力"],"contributorLine":"现代 · 王力","era":"现代","publicationYear":1980,"carrier":"PDF"},"stats":{"annotationCount":2,"glossCount":2},"annotations":[{"id":"0001","order":1,"total":2,"layer":"global","layerLabel":"全篇总说","targetText":"《驺虞》韵读总说","targetNotes":"书页 149 的诗号 25 全段。","sourceLabel":"第 149 页局部","sourceNotes":"书页 149《驺虞》韵读。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"王力","sectionLabel":"韵读","text":"王力将《驺虞》读作两章分换韵：首章“葭(kea)、豝(pea)”同在鱼部，而“驺虞(ngiua)”入鱼部相协；次章“蓬(bong)、豵(tzong)”转东部，煞句“驺虞”则与上章遥应。两章句短而节奏劲利。","notes":null}]},{"id":"0002","order":2,"total":2,"layer":"span","layerLabel":"诗句片段","targetText":"彼茁者葭，壹发五豝。于嗟乎驺虞！彼茁者蓬，壹发五豵。于嗟乎驺虞！","targetNotes":"现存页图可见全篇。","sourceLabel":"第 149 页局部","sourceNotes":"书页 149《驺虞》全篇韵读。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"王力","sectionLabel":"韵读","text":"页图可读首章“彼茁者葭(kea)、壹发五豝(pea)、于嗟乎驺虞(ngiua)”同属鱼部；次章“彼茁者蓬(bong)、壹发五豵(tzong)”转东部，而末句“驺虞”与上章通押。王力据此把此诗视为短章急调的田猎之作。","notes":null}]}]}}}
