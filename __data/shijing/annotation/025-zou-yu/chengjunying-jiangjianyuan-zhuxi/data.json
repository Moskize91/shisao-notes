{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/025-zou-yu/chengjunying-jiangjianyuan-zhuxi","dataHref":"/__data/shijing/annotation/025-zou-yu/chengjunying-jiangjianyuan-zhuxi/data.json","title":"詩經注析 · 騶虞 · 注释总览","description":"風 · 召南 · 騶虞 · 汇集《詩經注析》关于《騶虞》的 3 条注释，含 3 条注脚。"},"payload":{"detail":{"route":{"poemId":"025-zou-yu","materialId":"chengjunying-jiangjianyuan-zhuxi"},"href":"/shijing/annotation/025-zou-yu/chengjunying-jiangjianyuan-zhuxi","poem":{"id":"025-zou-yu","title":"騶虞","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","騶虞"],"segments":[{"id":"seg-001","text":"彼茁者葭","isActive":false},{"id":"seg-002","text":"壹发五豝","isActive":false},{"id":"seg-003","text":"于嗟乎驺虞","isActive":false},{"id":"seg-004","text":"彼茁者蓬","isActive":false},{"id":"seg-005","text":"壹发五豵","isActive":false},{"id":"seg-006","text":"于嗟乎驺虞","isActive":false}]},"material":{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","authors":["程俊英","蔣見元"],"contributorLine":"现代 · 程俊英、蔣見元","era":"现代","publicationYear":1991,"carrier":"PDF"},"stats":{"annotationCount":3,"glossCount":3},"annotations":[{"id":"0001","order":1,"total":3,"layer":"global","layerLabel":"全篇总说","targetText":"题解","targetNotes":"题解总说。","sourceLabel":"第 44-45 页","sourceNotes":"书内页 44-45《题解》段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"题解把《驺虞》定为赞美猎人的诗。编者认为“于嗟乎驺虞”中的叹词短促有力，配合两章复沓，写出射猎时强烈而波动的情绪；而一发五豝、一发五豵，并不必拘泥为实数，重点仍在夸示勇健善射，所以全篇主旨在赞叹猎获之盛与猎人的敏捷。","notes":null}]},{"id":"0002","order":2,"total":3,"layer":"span","layerLabel":"诗句片段","targetText":"彼茁者葭，壹发五豝。于嗟乎驺虞！","targetNotes":"首章。","sourceLabel":"第 45 页","sourceNotes":"书内页 45 首章与注释。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"首章释“茁”为草木初生而壮盛，“葭”为初生芦苇，“豝”为母猪或猎场所见大兽。程、蒋指出“一发五豝”当是极写射者的勇武与技艺，不必胶着实数；末句“于嗟乎驺虞”则用赞叹口吻收束，形成猎场呼喝般的声势。","notes":null}]},{"id":"0003","order":3,"total":3,"layer":"span","layerLabel":"诗句片段","targetText":"彼茁者蓬，壹发五豵。于嗟乎驺虞！","targetNotes":"第二章。","sourceLabel":"第 45 页","sourceNotes":"书内页 45 第二章与注释。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"第二章换以蓬草、豵豕复沓前意。“豵”为小猪，和首章“大兽”对举，使猎获更见丰富。编者认为两章同用“于嗟乎驺虞”反复收束，正显示诗歌从猎场打猎的劳动与武勇里取材，而不是借义兽之名空作祥瑞颂辞。","notes":null}]}]}}}
