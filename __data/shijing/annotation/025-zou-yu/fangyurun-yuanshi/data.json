{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/025-zou-yu/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/025-zou-yu/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 騶虞 · 注释总览","description":"風 · 召南 · 騶虞 · 汇集《诗经原始(上下)》关于《騶虞》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"025-zou-yu","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/025-zou-yu/fangyurun-yuanshi","poem":{"id":"025-zou-yu","title":"騶虞","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","騶虞"],"segments":[{"id":"seg-001","text":"彼茁者葭","isActive":false},{"id":"seg-002","text":"壹發五豝","isActive":false},{"id":"seg-003","text":"于嗟乎騶虞","isActive":false},{"id":"seg-004","text":"彼茁者蓬","isActive":false},{"id":"seg-005","text":"壹發五豵","isActive":false},{"id":"seg-006","text":"于嗟乎騶虞","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"騶虞㊟獵不盡殺也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标题段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注","text":"方玉润在题注中把《騶虞》定为“猎不尽杀”之诗，直接从田猎礼意入手，不以騶虞当作义兽实指。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"彼茁者葭，壹發五豝。于嗟乎，騶虞！彼茁者蓬，壹發五豵。于嗟乎，騶虞！","targetNotes":"通篇总评。","sourceLabel":null,"sourceNotes":"对应 EPUB item 正文与总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":null,"text":"方玉润力辨《毛传》《集传》把騶虞当作义兽、并据此附会文王化行的读法，认为“騶虞”更当作騶囿、虞官一类职官名。全诗所咏，不过是田猎时不合围、不尽杀物的礼意，借“一发五豝”“一发五豵”夸写猎获之盛，而末句转美虞人，实即不敢斥君而归功于国君之仁。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"眉评","targetNotes":"眉评短语。","sourceLabel":null,"sourceNotes":"对应 EPUB item 眉评段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"眉评","text":"眉评谓末句虽与“于嗟麟兮”相似，实则不同；正因通章未先以騶虞为比，反足证“騶虞”并非兽名。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"term","layerLabel":"字词注","targetText":"彼茁者葭彼茁者蓬","targetNotes":"集释所及名物字义。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"集释","sectionLabel":null,"text":"集释释“茁”为生出壮盛之貌，“葭”为初生芦苇，“蓬”为蒿类野草。所举草木都取其春猎时生意蓬勃之状，以衬猎场时令。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"标韵","targetNotes":"各章韵脚与通韵说明。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标韵段。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"标韵","sectionLabel":null,"text":"标韵以首章“葭”“豝”为麻部本韵，“乎”“虞”为虞部本韵；次章“蓬”“豵”则转东部，而“虞”与上章遥应。方玉润并借此驳正诸家把末句强作叶音的做法。","notes":null}]}]}}}
