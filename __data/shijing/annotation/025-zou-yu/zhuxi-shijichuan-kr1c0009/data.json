{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/025-zou-yu/zhuxi-shijichuan-kr1c0009","dataHref":"/__data/shijing/annotation/025-zou-yu/zhuxi-shijichuan-kr1c0009/data.json","title":"詩集傳 · 騶虞 · 注释总览","description":"風 · 召南 · 騶虞 · 汇集《詩集傳》关于《騶虞》的 3 条注释，含 3 条注脚。"},"payload":{"detail":{"route":{"poemId":"025-zou-yu","materialId":"zhuxi-shijichuan-kr1c0009"},"href":"/shijing/annotation/025-zou-yu/zhuxi-shijichuan-kr1c0009","poem":{"id":"025-zou-yu","title":"騶虞","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","騶虞"],"segments":[{"id":"seg-001","text":"彼茁者葭","isActive":true},{"id":"seg-002","text":"壹發五豝","isActive":true},{"id":"seg-003","text":"于嗟乎騶虞","isActive":true},{"id":"seg-004","text":"彼茁者蓬","isActive":false},{"id":"seg-005","text":"壹發五豵","isActive":false},{"id":"seg-006","text":"于嗟乎騶虞","isActive":false}]},"material":{"id":"zhuxi-shijichuan-kr1c0009","title":"詩集傳","authors":["朱熹"],"contributorLine":"宋 · 朱熹","era":"宋","publicationYear":1186,"carrier":"TXT"},"stats":{"annotationCount":3,"glossCount":3},"annotations":[{"id":"0001","order":1,"total":3,"layer":"span","layerLabel":"诗句片段","targetText":"彼茁者葭，壹發五豝。于嗟乎騶虞。","targetNotes":"首章。","sourceLabel":null,"sourceNotes":"对应 txt 424-430 行。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"朱熹","sectionLabel":null,"text":"賦也。茁，生出壯盛之貌；葭，蘆也，亦名葦；發，發矢也；豝，牡豕也。一發五豝，猶言中必疊雙。騶虞，獸名，白虎黑文，不食生物者。朱熹以此章美南國諸侯承文王之化，春田之際草木茂、禽獸多，而其仁及庶類。","notes":null}]},{"id":"0002","order":2,"total":3,"layer":"span","layerLabel":"诗句片段","targetText":"彼茁者蓬，壹發五豵。于嗟乎騶虞。","targetNotes":"第二章。","sourceLabel":null,"sourceNotes":"对应 txt 430-432 行。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"朱熹","sectionLabel":null,"text":"賦也。蓬，草名；豵，一歲豕，亦小豕也。朱熹以第二章仍承首章之意，用草木与禽兽之多反覆形容文王之化流被庶类。","notes":null}]},{"id":"0003","order":3,"total":3,"layer":"global","layerLabel":"全篇总说","targetText":"騶虞二章章三句","targetNotes":"章句总说。","sourceLabel":null,"sourceNotes":"对应 txt 433-438 行。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"朱熹","sectionLabel":null,"text":"朱熹记《騶虞》为二章、章三句，并以为文王之化始于《關雎》、深于《麟趾》，形于《鵲巢》而及于《騶虞》，足见其泽之及物者广。","notes":null}]}]}}}
