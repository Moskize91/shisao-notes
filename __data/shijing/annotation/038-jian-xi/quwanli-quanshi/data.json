{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/038-jian-xi/quwanli-quanshi","dataHref":"/__data/shijing/annotation/038-jian-xi/quwanli-quanshi/data.json","title":"詩經詮釋 · 簡兮 · 注释总览","description":"風 · 邶風 · 簡兮 · 汇集《詩經詮釋》关于《簡兮》的 2 条注释，含 2 条注脚。"},"payload":{"detail":{"route":{"poemId":"038-jian-xi","materialId":"quwanli-quanshi"},"href":"/shijing/annotation/038-jian-xi/quwanli-quanshi","poem":{"id":"038-jian-xi","title":"簡兮","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","簡兮"],"segments":[{"id":"seg-001","text":"簡兮簡兮","isActive":false},{"id":"seg-002","text":"方將萬舞","isActive":false},{"id":"seg-003","text":"日之方中","isActive":false},{"id":"seg-004","text":"在前上處","isActive":false},{"id":"seg-005","text":"碩人俣俣","isActive":false},{"id":"seg-006","text":"公庭萬舞","isActive":false},{"id":"seg-007","text":"有力如虎","isActive":false},{"id":"seg-008","text":"執轡如組","isActive":false},{"id":"seg-009","text":"左手執籥","isActive":false},{"id":"seg-010","text":"右手秉翟","isActive":false},{"id":"seg-011","text":"赫如渥赭","isActive":false},{"id":"seg-012","text":"公言錫爵","isActive":false},{"id":"seg-013","text":"山有榛","isActive":false},{"id":"seg-014","text":"隰有苓","isActive":false},{"id":"seg-015","text":"云誰之思","isActive":false},{"id":"seg-016","text":"西方美人","isActive":false},{"id":"seg-017","text":"彼美人兮","isActive":false},{"id":"seg-018","text":"西方之人兮","isActive":false}]},"material":{"id":"quwanli-quanshi","title":"詩經詮釋","authors":["屈萬里"],"contributorLine":"现代 · 屈萬里","era":"现代","publicationYear":1983,"carrier":"PDF"},"stats":{"annotationCount":2,"glossCount":2},"annotations":[{"id":"0001","order":1,"total":2,"layer":"global","layerLabel":"全篇总说","targetText":"簡兮","targetNotes":"诗旨总说。","sourceLabel":"第 46 页","sourceNotes":"书页 46 题下总说。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"屈万里","sectionLabel":"总说","text":"屈万里以《簡兮》为女子见舞师表演萬舞而爱慕之诗，不从《毛序》“刺不用贤”说。他认为前三章虽写舞场与舞容，实已层层烘托爱意，末章“西方美人”才将情思明白点出。","notes":null}]},{"id":"0002","order":2,"total":2,"layer":"term","layerLabel":"字词注","targetText":"簡兮簡兮，方將萬舞。日之方中，在前上處。碩人俣俣，公庭萬舞。有力如虎，執轡如組。左手執籥，右手秉翟。赫如渥赭，公言錫爵。山有榛，隰有苓。云誰之思，西方美人。彼美人兮，西方之人兮。","targetNotes":"词注撮要。","sourceLabel":"第 46 页","sourceNotes":"书页 46 词注页。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"屈万里","sectionLabel":"注释","text":"屈万里此页逐条解释“簡”“方將”“在前上處”“碩”“俣俣”“公庭”“轡”“組”“籥”“翟”“赫”“渥”“錫”“爵”“榛”“隰”“苓”“云”“之”“美人”等词，并引《國語》、吴语注、毛传、朱传等互证。其中“西方美人”引朱熹说，指西周之盛王。","notes":null}]}]}}}
