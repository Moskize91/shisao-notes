{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/038-jian-xi/maoheng-zhushu-kr1c0004","dataHref":"/__data/shijing/annotation/038-jian-xi/maoheng-zhushu-kr1c0004/data.json","title":"毛詩注疏 · 簡兮 · 注释总览","description":"風 · 邶風 · 簡兮 · 汇集《毛詩注疏》关于《簡兮》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"038-jian-xi","materialId":"maoheng-zhushu-kr1c0004"},"href":"/shijing/annotation/038-jian-xi/maoheng-zhushu-kr1c0004","poem":{"id":"038-jian-xi","title":"簡兮","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","簡兮"],"segments":[{"id":"seg-001","text":"簡兮簡兮","isActive":false},{"id":"seg-002","text":"方將萬舞","isActive":false},{"id":"seg-003","text":"日之方中","isActive":false},{"id":"seg-004","text":"在前上處","isActive":false},{"id":"seg-005","text":"碩人俁俁","isActive":false},{"id":"seg-006","text":"公庭萬舞","isActive":false},{"id":"seg-007","text":"有力如虎","isActive":false},{"id":"seg-008","text":"執轡如組","isActive":false},{"id":"seg-009","text":"左手執籥","isActive":false},{"id":"seg-010","text":"右手秉翟","isActive":false},{"id":"seg-011","text":"赫如渥赭","isActive":false},{"id":"seg-012","text":"公言錫爵","isActive":false},{"id":"seg-013","text":"山有榛","isActive":false},{"id":"seg-014","text":"隰有苓","isActive":false},{"id":"seg-015","text":"雲誰之思","isActive":false},{"id":"seg-016","text":"西方美人","isActive":false},{"id":"seg-017","text":"彼美人兮","isActive":false},{"id":"seg-018","text":"西方之人兮","isActive":false}]},"material":{"id":"maoheng-zhushu-kr1c0004","title":"毛詩注疏","authors":["毛亨","鄭氏","孔穎達"],"contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","era":"漢唐","publicationYear":653,"carrier":"TXT"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"preface","layerLabel":"篇序","targetText":"簡兮刺不用賢也衛之賢者仕於伶官皆可以承事王者也","targetNotes":"篇首小序。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》簡兮序文。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序"}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"簡兮簡兮，方將萬舞。日之方中，在前上處。碩人俁俁，公庭萬舞。","targetNotes":"首章毛传、郑笺与孔疏。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》簡兮首章。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"毛传","sectionLabel":"傳"}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"有力如虎，執轡如組。左手執籥，右手秉翟。赫如渥赭，公言錫爵。","targetNotes":"次章毛传、郑笺与孔疏。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》簡兮次章。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"毛传","sectionLabel":"傳"}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"山有榛，隰有苓。雲誰之思？西方美人。彼美人兮，西方之人兮！","targetNotes":"末章毛传、郑笺与孔疏。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》簡兮末章。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"毛传","sectionLabel":"傳"}]}]}}}
