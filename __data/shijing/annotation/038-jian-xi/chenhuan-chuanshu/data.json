{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/038-jian-xi/chenhuan-chuanshu","dataHref":"/__data/shijing/annotation/038-jian-xi/chenhuan-chuanshu/data.json","title":"詩毛氏傳疏 · 簡兮 · 注释总览","description":"風 · 邶風 · 簡兮 · 汇集《詩毛氏傳疏》关于《簡兮》的 2 条注释，含 2 条注脚。"},"payload":{"detail":{"route":{"poemId":"038-jian-xi","materialId":"chenhuan-chuanshu"},"href":"/shijing/annotation/038-jian-xi/chenhuan-chuanshu","poem":{"id":"038-jian-xi","title":"簡兮","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","簡兮"],"segments":[{"id":"seg-001","text":"簡兮簡兮","isActive":false},{"id":"seg-002","text":"方將萬舞","isActive":false},{"id":"seg-003","text":"日之方中","isActive":false},{"id":"seg-004","text":"在前上處","isActive":false},{"id":"seg-005","text":"碩人俣俣","isActive":false},{"id":"seg-006","text":"公庭萬舞","isActive":false},{"id":"seg-007","text":"有力如虎","isActive":false},{"id":"seg-008","text":"執轡如組","isActive":false},{"id":"seg-009","text":"左手執籥","isActive":false},{"id":"seg-010","text":"右手秉翟","isActive":false},{"id":"seg-011","text":"赫如渥赭","isActive":false},{"id":"seg-012","text":"公言錫爵","isActive":false},{"id":"seg-013","text":"山有榛","isActive":false},{"id":"seg-014","text":"隰有苓","isActive":false},{"id":"seg-015","text":"云誰之思","isActive":false},{"id":"seg-016","text":"西方美人","isActive":false},{"id":"seg-017","text":"彼美人兮","isActive":false},{"id":"seg-018","text":"西方之人兮","isActive":false}]},"material":{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","authors":["陳奐"],"contributorLine":"清 · 陳奐","era":"清","publicationYear":1847,"carrier":"PDF"},"stats":{"annotationCount":2,"glossCount":2},"annotations":[{"id":"0001","order":1,"total":2,"layer":"preface","layerLabel":"篇序","targetText":"簡兮刺不用賢也衛之賢者仕於伶官皆可以承事王者也","targetNotes":"篇首小序。","sourceLabel":"第 64 页","sourceNotes":"书内页 64 篇首序文。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序","text":"序：《簡兮》，刺不用賢也。衛之賢者仕於伶官，皆可以承事王者也。","notes":null}]},{"id":"0002","order":2,"total":2,"layer":"span","layerLabel":"诗句片段","targetText":"簡兮簡兮，方將萬舞。日之方中，在前上處。碩人俣俣，公庭萬舞。有力如虎，執轡如組。左手執籥，右手秉翟。赫如渥赭，公言錫爵。山有榛，隰有苓。云誰之思，西方美人。彼美人兮，西方之人兮。","targetNotes":"通篇经传疏解。","sourceLabel":"第 64-66 页","sourceNotes":"据第 64-66 页《簡兮》经传疏。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"陈奂疏《簡兮》时力辨朱熹“簡易不恭”之说，主张当从《序》作刺不用贤读。其疏以前三章皆陈舞人文武容仪与受礼之盛，说明“有力如虎”“左手執籥，右手秉翟”“赫如渥赭，公言錫爵”都不是夸张自侈；末章“西方美人”“西方之人”则归为怀思西周盛时与圣王之意，不当解作思遇明主。","notes":null}]}]}}}
