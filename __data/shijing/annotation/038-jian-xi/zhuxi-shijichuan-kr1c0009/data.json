{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/038-jian-xi/zhuxi-shijichuan-kr1c0009","dataHref":"/__data/shijing/annotation/038-jian-xi/zhuxi-shijichuan-kr1c0009/data.json","title":"詩集傳 · 簡兮 · 注释总览","description":"風 · 邶風 · 簡兮 · 汇集《詩集傳》关于《簡兮》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"038-jian-xi","materialId":"zhuxi-shijichuan-kr1c0009"},"href":"/shijing/annotation/038-jian-xi/zhuxi-shijichuan-kr1c0009","poem":{"id":"038-jian-xi","title":"簡兮","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","簡兮"],"segments":[{"id":"seg-001","text":"簡兮簡兮","isActive":true},{"id":"seg-002","text":"方將萬舞","isActive":true},{"id":"seg-003","text":"日之方中","isActive":true},{"id":"seg-004","text":"在前上處","isActive":true},{"id":"seg-005","text":"碩人俁俁","isActive":false},{"id":"seg-006","text":"公庭萬舞","isActive":false},{"id":"seg-007","text":"有力如虎","isActive":false},{"id":"seg-008","text":"執轡如組","isActive":false},{"id":"seg-009","text":"左手執籥","isActive":false},{"id":"seg-010","text":"右手秉翟","isActive":false},{"id":"seg-011","text":"赫如渥赭","isActive":false},{"id":"seg-012","text":"公言錫爵","isActive":false},{"id":"seg-013","text":"山有榛","isActive":false},{"id":"seg-014","text":"隰有苓","isActive":false},{"id":"seg-015","text":"雲誰之思","isActive":false},{"id":"seg-016","text":"西方美人","isActive":false},{"id":"seg-017","text":"彼美人兮","isActive":false},{"id":"seg-018","text":"西方之人兮","isActive":false}]},"material":{"id":"zhuxi-shijichuan-kr1c0009","title":"詩集傳","authors":["朱熹"],"contributorLine":"宋 · 朱熹","era":"宋","publicationYear":1186,"carrier":"TXT"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"簡兮簡兮，方將萬舞。日之方中，在前上處。","targetNotes":"首章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》簡兮首章。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"朱熹","sectionLabel":null,"text":"賦也。朱熹释“簡”为简易不恭之意，“萬舞”为舞之总名，武舞用干戚，文舞用羽籥；又以“日之方中，在前上處”为当处明显之地。朱熹并以为贤者不得志而仕于伶官，故其语若自誉而自嘲，见轻世肆志之心。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"碩人俁俁，公庭萬舞。有力如虎，執轡如組。","targetNotes":"第2章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》簡兮第2章。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"朱熹","sectionLabel":null,"text":"賦也。朱熹以“碩人俁俁”言其魁大之貌，又释“轡”为今之韁、“組”为织丝所成，以善御者使马顺则轡柔如组；全章仍是自誉其才无所不备，承上章之意。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"左手執籥，右手秉翟。赫如渥赭，公言錫爵。","targetNotes":"第3章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》簡兮第3章。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"朱熹","sectionLabel":null,"text":"賦也。朱熹释“執籥秉翟”为文舞，“籥”如笛而有孔，“翟”为雉羽；又以“赫如渥赭”言其颜色充盛，“公言錫爵”则是燕饮时献工之礼。朱熹以为碩人而得此本亦为辱，诗人却反夸其亲洽，正见玩世不恭之意。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"山有榛，隰有苓。雲誰之思，西方美人。彼美人兮，西方之人兮。","targetNotes":"第4章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》簡兮第4章。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"朱熹","sectionLabel":null,"text":"興也。朱熹释“榛”为似栗而小，“隰”为下湿之地，“苓”即今甘草，并谓“西方美人”是假托以指西周盛王，“西方之人”是叹其远而不得见。全章所写，是贤者不得志于衰世下国而思盛际显王，其意深远。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"簡兮四章三章章四句一章六句舊三章章六句今改定","targetNotes":"章句总说。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》簡兮章句总说。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"朱熹","sectionLabel":"章句","text":"朱熹总云《簡兮》四章，其中三章章四句，一章六句；旧本作三章章六句，今改定。","notes":null}]}]}}}
