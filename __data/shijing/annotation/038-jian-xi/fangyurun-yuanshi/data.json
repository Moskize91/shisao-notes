{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/038-jian-xi/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/038-jian-xi/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 簡兮 · 注释总览","description":"風 · 邶風 · 簡兮 · 汇集《诗经原始(上下)》关于《簡兮》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"038-jian-xi","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/038-jian-xi/fangyurun-yuanshi","poem":{"id":"038-jian-xi","title":"簡兮","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","簡兮"],"segments":[{"id":"seg-001","text":"簡兮簡兮","isActive":false},{"id":"seg-002","text":"方將萬舞","isActive":false},{"id":"seg-003","text":"日之方中","isActive":false},{"id":"seg-004","text":"在前上處","isActive":false},{"id":"seg-005","text":"碩人俣俣","isActive":false},{"id":"seg-006","text":"公庭萬舞","isActive":false},{"id":"seg-007","text":"有力如虎","isActive":false},{"id":"seg-008","text":"執轡如組","isActive":false},{"id":"seg-009","text":"左手執籥","isActive":false},{"id":"seg-010","text":"右手秉翟","isActive":false},{"id":"seg-011","text":"赫如渥赭","isActive":false},{"id":"seg-012","text":"公言錫爵","isActive":false},{"id":"seg-013","text":"山有榛","isActive":false},{"id":"seg-014","text":"隰有苓","isActive":false},{"id":"seg-015","text":"云誰之思","isActive":false},{"id":"seg-016","text":"西方美人","isActive":false},{"id":"seg-017","text":"彼美人兮","isActive":false},{"id":"seg-018","text":"西方之人兮","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"簡兮㊟賢者自傷失位而抒所懷也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标题段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注","text":"方玉润题注把《簡兮》定为贤者自伤失位、借叙舞抒怀之作。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"总评","targetNotes":"通篇总评。","sourceLabel":null,"sourceNotes":"对应 EPUB item 总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"总评","text":"方玉润总评力驳朱熹“簡易不恭”及自夸狂狷之说，认为前三章是贤者自叙将舞、分文武而尽职受赏，末章则另有所怀，借“西方美人”托想西京圣王。全篇不是轻狂傲慢，而是抱负不凡、怀盛世而伤今。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"眉评","targetNotes":"篇中眉评撮要。","sourceLabel":null,"sourceNotes":"对应 EPUB item 眉评内容。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"眉评","text":"方玉润眉评只拈首章“从将舞叙起”与末章“慨然遐想，有高乎一世之志”，以示本篇由叙舞层层推进，最后转入高远之思。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"term","layerLabel":"字词注","targetText":"簡兮簡兮方將萬舞日之方中碩人俣俣有力如虎執轡如組左手執籥右手秉翟赫如渥赭公言錫爵山有榛隰有苓西方美人","targetNotes":"集释撮要。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":"集释","text":"方玉润集释辨“簡”为分别舞人，“萬舞”为舞之总名，兼及“日之方中”“碩人”“俣俣”“轡”“組”“籥”“翟”“赫”“渥”“赭”“錫爵”“榛”“隰”“苓”等词义，并借“西方美人”申明所怀实在西京圣王，不是男女私情。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"标韵","targetNotes":"四章韵脚撮述。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标韵段。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"方玉润","sectionLabel":"标韵","text":"方玉润标出《簡兮》四章韵脚：首章“舞、處”通韵，次章“俣、舞、虎、組”为本韵，三章“籥、翟、爵”叶转，末章“榛、苓、人”再通。其标韵显示全篇在叙舞与寄怀之间层层换韵。","notes":null}]}]}}}
