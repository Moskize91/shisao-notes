{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/038-jian-xi/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/038-jian-xi/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 簡兮 · 注释总览","description":"風 · 邶風 · 簡兮 · 汇集《诗经原始(上下)》关于《簡兮》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"038-jian-xi","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/038-jian-xi/fangyurun-yuanshi","poem":{"id":"038-jian-xi","title":"簡兮","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","簡兮"],"segments":[{"id":"seg-001","text":"簡兮簡兮","isActive":false},{"id":"seg-002","text":"方將萬舞","isActive":false},{"id":"seg-003","text":"日之方中","isActive":false},{"id":"seg-004","text":"在前上處","isActive":false},{"id":"seg-005","text":"碩人俣俣","isActive":false},{"id":"seg-006","text":"公庭萬舞","isActive":false},{"id":"seg-007","text":"有力如虎","isActive":false},{"id":"seg-008","text":"執轡如組","isActive":false},{"id":"seg-009","text":"左手執籥","isActive":false},{"id":"seg-010","text":"右手秉翟","isActive":false},{"id":"seg-011","text":"赫如渥赭","isActive":false},{"id":"seg-012","text":"公言錫爵","isActive":false},{"id":"seg-013","text":"山有榛","isActive":false},{"id":"seg-014","text":"隰有苓","isActive":false},{"id":"seg-015","text":"云誰之思","isActive":false},{"id":"seg-016","text":"西方美人","isActive":false},{"id":"seg-017","text":"彼美人兮","isActive":false},{"id":"seg-018","text":"西方之人兮","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"簡兮㊟賢者自傷失位而抒所懷也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标题段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注"}]},{"id":"0002","order":2,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"总评","targetNotes":"通篇总评。","sourceLabel":null,"sourceNotes":"对应 EPUB item 总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"总评"}]},{"id":"0003","order":3,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"眉評〔一章〕從將舞叙起。〔四章〕慨然遐想，有高乎一世之志。","targetNotes":"篇中眉评原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 眉评内容。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"眉评"}]},{"id":"0004","order":4,"total":5,"layer":"term","layerLabel":"字词注","targetText":"集釋簡〔姚氏際恒曰〕簡，《説文》：分别之也。謂方將萬舞，故先分别舞人，如諸侯用六是也。萬舞〔《集傳》曰〕萬者，舞之總名。武用干戚，文用羽籥也。〔姚氏際恒曰〕萬舞，《商頌》曰「萬舞有奕」，則其名已久。《毛傳》謂干羽，按干爲武舞，羽爲文舞，兼文武言。鄭氏謂干武則單指武舞，因引《左傳》「振萬」之言，以萬舞爲武舞，與諸説異，存參。日之方中〔姚氏曰〕孔氏引《月令》「仲春之月，命樂正習舞入學」，謂「二月日夜中」也，亦通。碩人碩，大也。〔朱氏道行曰〕稱人而曰碩，重其品也。愚謂碩人不必重，看對下「有力如虎」可知。俣俣大貌。〔朱氏曰〕指形體，亦帶威儀説。轡韁也。組織絲爲之，言其柔也。籥如笛而小。〔孔氏穎達曰〕樂雖吹器，舞時與羽並執，故得舞名。《賓之初筵》云「籥舞笙鼓」是也。翟雉羽也。赫赤貌。渥〔孔氏穎達曰〕渥者，浸潤之名。赭赤色，言其顔色之充盛也。錫爵〔徐氏鳳彩曰〕工告樂備，則主人獻工。主人，宰夫也。然必錫之於君，故曰「公言錫爵」，重君命也。榛似栗而小。隰下濕曰隰。苓〔《集傳》曰〕苓，一名大苦，葉似地黄，即今甘草也。","targetNotes":"集释撮要。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":"集释"}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"标韵","targetNotes":"四章韵脚撮述。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标韵段。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"方玉润","sectionLabel":"标韵"}]}]}}}
