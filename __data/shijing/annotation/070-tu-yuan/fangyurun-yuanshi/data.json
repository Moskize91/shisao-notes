{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/070-tu-yuan/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/070-tu-yuan/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 兔爰 · 注释总览","description":"風 · 王風 · 兔爰 · 汇集《诗经原始(上下)》关于《兔爰》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"070-tu-yuan","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/070-tu-yuan/fangyurun-yuanshi","poem":{"id":"070-tu-yuan","title":"兔爰","categoryId":"feng","subcategoryId":"wangfeng","path":["風","王風","兔爰"],"segments":[{"id":"seg-001","text":"有兔爰爰","isActive":false},{"id":"seg-002","text":"雉離于羅","isActive":false},{"id":"seg-003","text":"我生之初","isActive":false},{"id":"seg-004","text":"尚無爲","isActive":false},{"id":"seg-005","text":"我生之後","isActive":false},{"id":"seg-006","text":"逢此百罹","isActive":false},{"id":"seg-007","text":"尚寐無吪","isActive":false},{"id":"seg-008","text":"有兔爰爰","isActive":false},{"id":"seg-009","text":"雉離于罦","isActive":false},{"id":"seg-010","text":"我生之初","isActive":false},{"id":"seg-011","text":"尚無造","isActive":false},{"id":"seg-012","text":"我生之後","isActive":false},{"id":"seg-013","text":"逢此百憂","isActive":false},{"id":"seg-014","text":"尚寐無覺","isActive":false},{"id":"seg-015","text":"有兔爰爰","isActive":false},{"id":"seg-016","text":"雉離于罿","isActive":false},{"id":"seg-017","text":"我生之初","isActive":false},{"id":"seg-018","text":"尚無庸","isActive":false},{"id":"seg-019","text":"我生之後","isActive":false},{"id":"seg-020","text":"逢此百凶","isActive":false},{"id":"seg-021","text":"尚寐無聰","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"兔爰㊟傷亂始也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标题段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注","text":"方玉润题注直断《兔爰》为“傷亂始”之诗，先将其置于王纲陵迟、祸乱初起的政治语境中来读。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"总评","targetNotes":"通篇总评。","sourceLabel":null,"sourceNotes":"对应 EPUB item 总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"总评","text":"方玉润总评先驳《序》与《集传》把此诗说成求死之解，指出“無吪”“無覺”“無聰”并非欲寐而死，而是不欲言、不欲见、不欲闻乱世。其又将诗意系于平王东迁后王纲愈坠、百凶并见之世，谓诗人回忆生初尚无此患，故宁长睡不醒，以隔绝眼前祸乱。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"眉評","targetNotes":"篇中眉评撮要。","sourceLabel":null,"sourceNotes":"对应 EPUB item 眉评内容。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"眉评","text":"方玉润眉评仅下一语，谓此诗“詞意悽愴，聲情激越”，并说阮步兵专学此种，以点出其慷慨悲凉的声情路数。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"term","layerLabel":"字词注","targetText":"有兔爰爰雉離于羅逢此百罹尚寐無吪雉離于罦尚無造尚寐無覺尚無庸","targetNotes":"集释撮要。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":"集释","text":"方玉润集释依次训“爰爰”“雉”“離”“羅”“罹”“吪”“罦”“造”“覺”“庸”：以“爰爰”为兔之缓行，“雉”性耿介，“離”为丽着，“羅”为网，“罹”为忧；又据旧说与姚际恒，释“無吪”为不言，“罦”为覆车之网，“造”为为也，“覺”为寤也，“庸”为用也。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"標韻","targetNotes":"三章韵脚撮述。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标韵段。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"方玉润","sectionLabel":"标韵","text":"方玉润标出《兔爰》三章用韵：首章“羅、爲、罹、吪”入歌部，次章“罦、憂”为尤部而“造、覺”另转效部叶韵，末章“罿、庸、凶、聰”归东部。其标韵显示此诗随章换部，而每章句末皆以重叠收煞。","notes":null}]}]}}}
