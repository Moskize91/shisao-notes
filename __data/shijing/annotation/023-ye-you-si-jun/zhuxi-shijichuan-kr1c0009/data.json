{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/023-ye-you-si-jun/zhuxi-shijichuan-kr1c0009","dataHref":"/__data/shijing/annotation/023-ye-you-si-jun/zhuxi-shijichuan-kr1c0009/data.json","title":"詩集傳 · 野有死麕 · 注释总览","description":"風 · 召南 · 野有死麕 · 汇集《詩集傳》关于《野有死麕》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"023-ye-you-si-jun","materialId":"zhuxi-shijichuan-kr1c0009"},"href":"/shijing/annotation/023-ye-you-si-jun/zhuxi-shijichuan-kr1c0009","poem":{"id":"023-ye-you-si-jun","title":"野有死麕","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","野有死麕"],"segments":[{"id":"seg-001","text":"野有死麕","isActive":true},{"id":"seg-002","text":"白茅包之","isActive":true},{"id":"seg-003","text":"有女懷春","isActive":true},{"id":"seg-004","text":"吉士誘之","isActive":true},{"id":"seg-005","text":"林有樸樕","isActive":false},{"id":"seg-006","text":"野有死鹿","isActive":false},{"id":"seg-007","text":"白茅純束","isActive":false},{"id":"seg-008","text":"有女如玉","isActive":false},{"id":"seg-009","text":"舒而脫脫兮","isActive":false},{"id":"seg-010","text":"無感我帨兮","isActive":false},{"id":"seg-011","text":"無使尨也吠","isActive":false}]},"material":{"id":"zhuxi-shijichuan-kr1c0009","title":"詩集傳","authors":["朱熹"],"contributorLine":"宋 · 朱熹","era":"宋","publicationYear":1186,"carrier":"TXT"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"野有死麕，白茅包之。有女懷春，吉士誘之。","targetNotes":"首章。","sourceLabel":null,"sourceNotes":"对应 txt 392-396 行。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"朱熹","sectionLabel":null,"text":"興也。麕，獐也，鹿屬無角。懷春，當春而有懷也。吉士猶美士也。朱熹承其说，以为南國被文王之化，女子有貞潔自守，不为强暴所污，故诗人因所见以兴其事而美之；或曰即赋，言吉士以白茅包死麕而诱怀春之女。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"林有樸樕，野有死鹿。白茅純束，有女如玉。","targetNotes":"第二章。","sourceLabel":null,"sourceNotes":"对应 txt 396-399 行。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"朱熹","sectionLabel":null,"text":"興也。樸樕，小木也。鹿，獸名有角。純束猶包之也。如玉者，美其色也。朱熹说此章以上三句兴下一句，亦或直赋，谓吉士以樸樕藉死鹿、白茅束之，以诱如玉之女。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"舒而脫脫兮，無感我帨兮，無使尨也吠。","targetNotes":"第三章。","sourceLabel":null,"sourceNotes":"对应 txt 399-405 行。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"朱熹","sectionLabel":null,"text":"賦也。舒，遲緩也。脫脫，舒緩貌。感，動。帨，巾。尨，犬。朱熹以此章为女子拒绝之辞，谓其使男子徐徐而来，勿动我帨，勿惊我犬，以甚言其不可相及，凛然不可犯之意可见。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"野有死麕三章二章章四句一章三句","targetNotes":"章句总说。","sourceLabel":null,"sourceNotes":"对应 txt 406 行。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"朱熹","sectionLabel":null,"text":"朱熹记《野有死麕》为三章，前二章各四句，末章三句。","notes":null}]}]}}}
