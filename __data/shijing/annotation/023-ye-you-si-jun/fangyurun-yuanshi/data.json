{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/023-ye-you-si-jun/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/023-ye-you-si-jun/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 野有死麕 · 注释总览","description":"風 · 召南 · 野有死麕 · 汇集《诗经原始(上下)》关于《野有死麕》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"023-ye-you-si-jun","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/023-ye-you-si-jun/fangyurun-yuanshi","poem":{"id":"023-ye-you-si-jun","title":"野有死麕","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","野有死麕"],"segments":[{"id":"seg-001","text":"野有死麕","isActive":false},{"id":"seg-002","text":"白茅包之","isActive":false},{"id":"seg-003","text":"有女懷春","isActive":false},{"id":"seg-004","text":"吉士誘之","isActive":false},{"id":"seg-005","text":"林有樸樕","isActive":false},{"id":"seg-006","text":"野有死鹿","isActive":false},{"id":"seg-007","text":"白茅純束","isActive":false},{"id":"seg-008","text":"有女如玉","isActive":false},{"id":"seg-009","text":"舒而脱脱兮","isActive":false},{"id":"seg-010","text":"無感我帨兮","isActive":false},{"id":"seg-011","text":"無使尨也吠","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"野有死麕㊟拒招隱也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标题段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注","text":"方玉润在题注中径改旧说，认为《野有死麕》并非淫诗或拒暴之辞，而是托怀春之女拒绝招隐，以比高人逸士不肯出山用世。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"野有死麕，白茅包之。有女懷春，吉士誘之。林有樸樕，野有死鹿。白茅純束，有女如玉。舒而脱脱兮，無感我帨兮，無使尨也吠。","targetNotes":"通篇总评。","sourceLabel":null,"sourceNotes":"对应 EPUB item 正文与总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":null,"text":"方玉润历数恶无礼、凶荒婚礼、淫诗、刺淫、贞女拒暴等旧解，皆以为未安，最后从章潢、范处义而更推进之，断定此诗通篇是比体：所谓怀春之女、吉士相诱，实喻招贤求隐；所谓“有女如玉”，比其洁白无瑕；第三章则是逸士婉谢招徕，愿对方徐徐而来，勿惊其衣冠犬吠，深意在于不肯出仕。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"眉评","targetNotes":"眉评短语。","sourceLabel":null,"sourceNotes":"对应 EPUB item 眉评段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"眉评","text":"眉评谓首章四句翻起，通篇全用比体；后二章拍合正位，末章拒辞意微而婉。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"term","layerLabel":"字词注","targetText":"野有死麕林有樸樕野有死鹿舒而脱脱兮無感我帨兮無使尨也吠","targetNotes":"集释所及名物字义。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"集释","sectionLabel":null,"text":"集释释“麕”为獐，“樸樕”为小木，“鹿”为有角兽，又释“脱脱”为舒缓貌，“感”为动，“帨”为巾，“尨”为犬。方玉润并借这些名物训释加强其比兴说，认为白茅、死麕、死鹿都不必拘作实景。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"标韵","targetNotes":"各章韵脚与通韵说明。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标韵段。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"标韵","sectionLabel":null,"text":"标韵以首章“麕”“春”归真部本韵，而“包”“誘”另作叶韵；次章“樕”“鹿”“束”“玉”屋沃通韵；三章“脱”“帨”“吠”三字转韵。三章句式不齐而韵脚安排颇活。","notes":null}]}]}}}
