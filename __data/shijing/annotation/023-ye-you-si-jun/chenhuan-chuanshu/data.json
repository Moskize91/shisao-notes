{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/023-ye-you-si-jun/chenhuan-chuanshu","dataHref":"/__data/shijing/annotation/023-ye-you-si-jun/chenhuan-chuanshu/data.json","title":"詩毛氏傳疏 · 野有死麕 · 注释总览","description":"風 · 召南 · 野有死麕 · 汇集《詩毛氏傳疏》关于《野有死麕》的 2 条注释，含 2 条注脚。"},"payload":{"detail":{"route":{"poemId":"023-ye-you-si-jun","materialId":"chenhuan-chuanshu"},"href":"/shijing/annotation/023-ye-you-si-jun/chenhuan-chuanshu","poem":{"id":"023-ye-you-si-jun","title":"野有死麕","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","野有死麕"],"segments":[{"id":"seg-001","text":"野有死麕","isActive":false},{"id":"seg-002","text":"白茅包之","isActive":false},{"id":"seg-003","text":"有女懷春","isActive":false},{"id":"seg-004","text":"吉士誘之","isActive":false},{"id":"seg-005","text":"林有樸樕","isActive":false},{"id":"seg-006","text":"野有死鹿","isActive":false},{"id":"seg-007","text":"白茅純束","isActive":false},{"id":"seg-008","text":"有女如玉","isActive":false},{"id":"seg-009","text":"舒而脫脫兮","isActive":false},{"id":"seg-010","text":"無感我帨兮","isActive":false},{"id":"seg-011","text":"無使尨也吠","isActive":false}]},"material":{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","authors":["陳奐"],"contributorLine":"清 · 陳奐","era":"清","publicationYear":1847,"carrier":"PDF"},"stats":{"annotationCount":2,"glossCount":2},"annotations":[{"id":"0001","order":1,"total":2,"layer":"preface","layerLabel":"篇序","targetText":"野有死麕惡無禮也天下大亂強暴相陵遂成淫風被文王之化雖當亂世猶惡無禮也","targetNotes":"诗序。","sourceLabel":"第 54 页","sourceNotes":"据第54页左侧《野有死麕》题下诗序。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序"}]},{"id":"0002","order":2,"total":2,"layer":"span","layerLabel":"诗句片段","targetText":"野有死麕，白茅包之。有女懷春，吉士誘之。林有樸樕，野有死鹿。白茅純束，有女如玉。舒而脫脫兮，無感我帨兮，無使尨也吠。","targetNotes":"通篇经文。","sourceLabel":"第 54-55 页","sourceNotes":"据第54-55页《野有死麕》经传疏；第54页仅自左侧《野有死麕》部分起取，第55页仍未转入下一首。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"陈奂","sectionLabel":"疏"}]}]}}}
