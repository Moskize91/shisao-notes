{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/023-ye-you-si-jun/chenhuan-chuanshu","dataHref":"/__data/shijing/annotation/023-ye-you-si-jun/chenhuan-chuanshu/data.json","title":"詩毛氏傳疏 · 野有死麕 · 注释总览","description":"風 · 召南 · 野有死麕 · 汇集《詩毛氏傳疏》关于《野有死麕》的 2 条注释，含 2 条注脚。"},"payload":{"detail":{"route":{"poemId":"023-ye-you-si-jun","materialId":"chenhuan-chuanshu"},"href":"/shijing/annotation/023-ye-you-si-jun/chenhuan-chuanshu","poem":{"id":"023-ye-you-si-jun","title":"野有死麕","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","野有死麕"],"segments":[{"id":"seg-001","text":"野有死麕","isActive":false},{"id":"seg-002","text":"白茅包之","isActive":false},{"id":"seg-003","text":"有女懷春","isActive":false},{"id":"seg-004","text":"吉士誘之","isActive":false},{"id":"seg-005","text":"林有樸樕","isActive":false},{"id":"seg-006","text":"野有死鹿","isActive":false},{"id":"seg-007","text":"白茅純束","isActive":false},{"id":"seg-008","text":"有女如玉","isActive":false},{"id":"seg-009","text":"舒而脫脫兮","isActive":false},{"id":"seg-010","text":"無感我帨兮","isActive":false},{"id":"seg-011","text":"無使尨也吠","isActive":false}]},"material":{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","authors":["陳奐"],"contributorLine":"清 · 陳奐","era":"清","publicationYear":1847,"carrier":"PDF"},"stats":{"annotationCount":2,"glossCount":2},"annotations":[{"id":"0001","order":1,"total":2,"layer":"preface","layerLabel":"篇序","targetText":"野有死麕惡無禮也天下大亂強暴相陵遂成淫風被文王之化雖當亂世猶惡無禮也","targetNotes":"篇首序文。","sourceLabel":"第 45 页","sourceNotes":"据第 45 页《野有死麕》序义。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序","text":"序：《野有死麕》，惡無禮也。天下大亂，強暴相陵，遂成淫風。被文王之化，雖當亂世，猶惡無禮也。","notes":null}]},{"id":"0002","order":2,"total":2,"layer":"span","layerLabel":"诗句片段","targetText":"野有死麕，白茅包之。有女懷春，吉士誘之。林有樸樕，野有死鹿。白茅純束，有女如玉。舒而脫脫兮，無感我帨兮，無使尨也吠。","targetNotes":"通篇经传疏解。","sourceLabel":"第 45-46 页","sourceNotes":"据第 45-46 页《野有死麕》经传疏。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"陈奂循《序》以为此篇旨在恶无礼，认为首二章写强暴男子以死麕死鹿为诱具而求近女子，第三章则是女子警拒之辞。其疏尤重“脱脱”“无感我帨”“无使尨也吠”数语，谓女子虽辞意婉曲，实含严正防闲，不许对方以非礼相干，故仍足见文王之化未坠。","notes":null}]}]}}}
