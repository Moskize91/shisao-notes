{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/023-ye-you-si-jun/quwanli-quanshi","dataHref":"/__data/shijing/annotation/023-ye-you-si-jun/quwanli-quanshi/data.json","title":"詩經詮釋 · 野有死麕 · 注释总览","description":"風 · 召南 · 野有死麕 · 汇集《詩經詮釋》关于《野有死麕》的 2 条注释，含 2 条注脚。"},"payload":{"detail":{"route":{"poemId":"023-ye-you-si-jun","materialId":"quwanli-quanshi"},"href":"/shijing/annotation/023-ye-you-si-jun/quwanli-quanshi","poem":{"id":"023-ye-you-si-jun","title":"野有死麕","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","野有死麕"],"segments":[{"id":"seg-001","text":"野有死麕","isActive":false},{"id":"seg-002","text":"白茅包之","isActive":false},{"id":"seg-003","text":"有女怀春","isActive":false},{"id":"seg-004","text":"吉士诱之","isActive":false},{"id":"seg-005","text":"林有朴樕","isActive":false},{"id":"seg-006","text":"野有死鹿","isActive":false},{"id":"seg-007","text":"白茅纯束","isActive":false},{"id":"seg-008","text":"有女如玉","isActive":false},{"id":"seg-009","text":"舒而脱脱兮","isActive":false},{"id":"seg-010","text":"无感我帨兮","isActive":false},{"id":"seg-011","text":"无使尨也吠","isActive":false}]},"material":{"id":"quwanli-quanshi","title":"詩經詮釋","authors":["屈萬里"],"contributorLine":"现代 · 屈萬里","era":"现代","publicationYear":1983,"carrier":"PDF"},"stats":{"annotationCount":2,"glossCount":2},"annotations":[{"id":"0001","order":1,"total":2,"layer":"global","layerLabel":"全篇总说","targetText":"《野有死麕》全篇旨意","targetNotes":"全篇总说。","sourceLabel":"第 25 页","sourceNotes":"第 25 页《注释》①。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"屈万里","sectionLabel":"注释","text":"此男女相悦之诗。","notes":null}]},{"id":"0002","order":2,"total":2,"layer":"term","layerLabel":"字词注","targetText":"野有死麕白茅包之林有朴樕白茅纯束舒而脱脱兮无感我帨兮无使尨也吠","targetNotes":"《注释》②至⑫。","sourceLabel":"第 25 页","sourceNotes":"第 25 页《注释》②至⑫。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"屈万里","sectionLabel":"注释","text":"屈万里释“麕”为獐，“白茅”是春时先开的草，“怀”即思，“朴樕”为小木，“纯”犹束，“脱脱”为舒缓貌，“感”为动，“帨”为佩巾，“尨”为长毛犬，并据此认定全诗是男女相悦而女方微作矜持的情态写照。","notes":null}]}]}}}
