{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/023-ye-you-si-jun/chengjunying-jiangjianyuan-zhuxi","dataHref":"/__data/shijing/annotation/023-ye-you-si-jun/chengjunying-jiangjianyuan-zhuxi/data.json","title":"詩經注析 · 野有死麕 · 注释总览","description":"風 · 召南 · 野有死麕 · 汇集《詩經注析》关于《野有死麕》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"023-ye-you-si-jun","materialId":"chengjunying-jiangjianyuan-zhuxi"},"href":"/shijing/annotation/023-ye-you-si-jun/chengjunying-jiangjianyuan-zhuxi","poem":{"id":"023-ye-you-si-jun","title":"野有死麕","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","野有死麕"],"segments":[{"id":"seg-001","text":"野有死麕","isActive":false},{"id":"seg-002","text":"白茅包之","isActive":false},{"id":"seg-003","text":"有女怀春","isActive":false},{"id":"seg-004","text":"吉士诱之","isActive":false},{"id":"seg-005","text":"林有朴樕","isActive":false},{"id":"seg-006","text":"野有死鹿","isActive":false},{"id":"seg-007","text":"白茅纯束","isActive":false},{"id":"seg-008","text":"有女如玉","isActive":false},{"id":"seg-009","text":"舒而脱脱兮","isActive":false},{"id":"seg-010","text":"无感我帨兮","isActive":false},{"id":"seg-011","text":"无使尨也吠","isActive":false}]},"material":{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","authors":["程俊英","蔣見元"],"contributorLine":"现代 · 程俊英、蔣見元","era":"现代","publicationYear":1991,"carrier":"PDF"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"题解","targetNotes":"题解总说。","sourceLabel":"第 41 页","sourceNotes":"书内页 41《题解》段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"题解把《野有死麕》定为青年男女恋爱的情诗，认为它写猎人以死獐、白茅为礼物向少女求爱。编者强调此诗并不涉“淫奔”或“恶无礼”，而是以质朴而富野趣的语言，写女子既有羞怯防闲，又并非全然拒绝的微妙心理，第三章“无感我帨兮，无使尨也吠”尤见其半推半就、活泼传神。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"野有死麕，白茅包之。有女怀春，吉士诱之。","targetNotes":"首章。","sourceLabel":"第 41 页","sourceNotes":"书内页 41 首章与注释。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"首章释“麕”为獐，“包”为裹，“怀春”即女子怀有春情，“吉士”指美好的青年。编者据此认为死麕与白茅是猎人奉赠的礼物，正用来引逗怀春少女，所以通章是一幅山野求偶的生动开场。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"林有朴樕，野有死鹿，白茅纯束，有女如玉。","targetNotes":"第二章。","sourceLabel":"第 42 页","sourceNotes":"书内页 42 第二章与注释。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"第二章改以死鹿、白茅纯束重申求爱之礼，并以“有女如玉”转出对女方姿质的赞美。编者指出“朴樕”是丛生小木，衬出山林景象；“如玉”既美其色，也暗写其洁白可亲，使情调由首章的挑逗转向柔美。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"舒而脱脱兮，无感我帨兮，无使尨也吠。","targetNotes":"第三章。","sourceLabel":"第 42 页","sourceNotes":"书内页 42 第三章与注释。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"第三章写女子答语。“舒而脱脱”是从容舒缓之貌，“帨”为佩巾，“尨”为多毛犬。编者认为这不是凛然拒绝，而是提醒男子放慢脚步、勿惊动衣饰和犬吠，以免幽会暴露。因而此章最能显出少女嗔中含喜、欲拒还迎的神态。","notes":null}]}]}}}
