{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/049-chun-zhi-ben-ben/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/049-chun-zhi-ben-ben/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 鶉之奔奔 · 注释总览","description":"風 · 鄘風 · 鶉之奔奔 · 汇集《诗经原始(上下)》关于《鶉之奔奔》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"049-chun-zhi-ben-ben","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/049-chun-zhi-ben-ben/fangyurun-yuanshi","poem":{"id":"049-chun-zhi-ben-ben","title":"鶉之奔奔","categoryId":"feng","subcategoryId":"yongfeng","path":["風","鄘風","鶉之奔奔"],"segments":[{"id":"seg-001","text":"鶉之奔奔","isActive":false},{"id":"seg-002","text":"鵲之彊彊","isActive":false},{"id":"seg-003","text":"人之無良","isActive":false},{"id":"seg-004","text":"我以爲兄","isActive":false},{"id":"seg-005","text":"鵲之彊彊","isActive":false},{"id":"seg-006","text":"鶉之奔奔","isActive":false},{"id":"seg-007","text":"人之無良","isActive":false},{"id":"seg-008","text":"我以爲君","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"鶉之奔奔㊟代衛公子刺宣公也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标题段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注","text":"方玉润题注以“代衛公子刺宣公”定篇，主张此诗为借卫公子之口而刺宣公。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"总评","targetNotes":"通篇总评。","sourceLabel":null,"sourceNotes":"对应 EPUB item 总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"总评","text":"方玉润总评先列《序》与《集傳》“刺衛宣姜”说，继而质疑“惠公刺母”之解于人伦难通，认为“兄”“君”指向及“我”之身份皆多疑难。其引姚际恒“人我一体、刺宣公”之说，以为较顺；并谓此诗词意过率，近于直诋，故存其异说而不遽定论。方氏又称，若从姚说，当作“人雖無良，我不敢不以爲兄，不敢不以爲君”之意，方合温柔敦厚之旨。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"term","layerLabel":"字词注","targetText":"鶉之奔奔鵲之彊彊","targetNotes":"集释撮要。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"集释","text":"方玉润集释云：鶉，䳺屬，并引寇宗奭谓鶉四时异名。奔奔，《左傳》作“賁賁”。彊彊，居有常匹、飛則相隨之貌，并引陸德明《韓詩》“奔奔彊彊，乘匹之貌”说。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"标韵","targetNotes":"两章韵脚撮述。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标韵段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":"标韵","text":"方玉润标出《鶉之奔奔》韵脚：首章“彊”属七阳，“兄”属八庚，为转韵；次章“奔”属十三元，“君”属十三文，为通韵。","notes":null}]}]}}}
