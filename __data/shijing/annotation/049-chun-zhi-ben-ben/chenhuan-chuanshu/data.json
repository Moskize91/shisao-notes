{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/049-chun-zhi-ben-ben/chenhuan-chuanshu","dataHref":"/__data/shijing/annotation/049-chun-zhi-ben-ben/chenhuan-chuanshu/data.json","title":"詩毛氏傳疏 · 鶉之奔奔 · 注释总览","description":"風 · 鄘風 · 鶉之奔奔 · 汇集《詩毛氏傳疏》关于《鶉之奔奔》的 2 条注释，含 2 条注脚。"},"payload":{"detail":{"route":{"poemId":"049-chun-zhi-ben-ben","materialId":"chenhuan-chuanshu"},"href":"/shijing/annotation/049-chun-zhi-ben-ben/chenhuan-chuanshu","poem":{"id":"049-chun-zhi-ben-ben","title":"鶉之奔奔","categoryId":"feng","subcategoryId":"yongfeng","path":["風","鄘風","鶉之奔奔"],"segments":[{"id":"seg-001","text":"鶉之奔奔","isActive":false},{"id":"seg-002","text":"鵲之彊彊","isActive":false},{"id":"seg-003","text":"人之無良","isActive":false},{"id":"seg-004","text":"我以爲兄","isActive":false},{"id":"seg-005","text":"鵲之彊彊","isActive":false},{"id":"seg-006","text":"鶉之奔奔","isActive":false},{"id":"seg-007","text":"人之無良","isActive":false},{"id":"seg-008","text":"我以爲君","isActive":false}]},"material":{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","authors":["陳奐"],"contributorLine":"清 · 陳奐","era":"清","publicationYear":1847,"carrier":"PDF"},"stats":{"annotationCount":2,"glossCount":2},"annotations":[{"id":"0001","order":1,"total":2,"layer":"preface","layerLabel":"篇序","targetText":"鶉之奔奔刺衛宣姜也衛人以爲宣姜鶉鵲之不若也","targetNotes":"篇首小序。","sourceLabel":"第 7 页","sourceNotes":"卷四页七前段《鶉之奔奔》小序。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序","text":"序：《鶉之奔奔》，刺衛宣姜也。衛人以爲宣姜，鶉鵲之不若也。","notes":null}]},{"id":"0002","order":2,"total":2,"layer":"span","layerLabel":"诗句片段","targetText":"鶉之奔奔，鵲之彊彊。人之無良，我以爲兄。鵲之彊彊，鶉之奔奔。人之無良，我以爲君。","targetNotes":"通篇经传疏解。","sourceLabel":"第 7-9 页","sourceNotes":"据卷四页七至页九《鶉之奔奔》经传疏。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"陈奂疏《鶉之奔奔》时，先据《序》“刺衛宣姜也……鶉鵲之不若也”申明此篇主刺宣姜与公子頑失伦。其释首章“鶉之奔奔，鵲之彊彊。人之無良，我以爲兄”，引传笺以奔奔、彊彊为有常匹、飞则相随之状，反衬宣姜与頑非匹耦而相从；“兄”则就惠公之辞，指其兄頑。次章“鵲之彊彊，鶉之奔奔。人之無良，我以爲君”，则以“君”为小君，指宣姜；两章重言互见，专以禽鸟有耦，深刺人伦之失。","notes":null}]}]}}}
