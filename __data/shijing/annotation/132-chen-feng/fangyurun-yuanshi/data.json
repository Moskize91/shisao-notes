{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/132-chen-feng/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/132-chen-feng/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 晨風 · 注释总览","description":"風 · 秦風 · 晨風 · 汇集《诗经原始(上下)》关于《晨風》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"132-chen-feng","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/132-chen-feng/fangyurun-yuanshi","poem":{"id":"132-chen-feng","title":"晨風","categoryId":"feng","subcategoryId":"qinfeng","path":["風","秦風","晨風"],"segments":[{"id":"seg-001","text":"鴥彼晨風","isActive":false},{"id":"seg-002","text":"鬰彼北林","isActive":false},{"id":"seg-003","text":"未見君子","isActive":false},{"id":"seg-004","text":"憂心欽欽","isActive":false},{"id":"seg-005","text":"如何如何","isActive":false},{"id":"seg-006","text":"忘我實多","isActive":false},{"id":"seg-007","text":"山有苞櫟","isActive":false},{"id":"seg-008","text":"隰有六駁","isActive":false},{"id":"seg-009","text":"未見君子","isActive":false},{"id":"seg-010","text":"憂心靡樂","isActive":false},{"id":"seg-011","text":"如何如何","isActive":false},{"id":"seg-012","text":"忘我實多","isActive":false},{"id":"seg-013","text":"山有苞棣","isActive":false},{"id":"seg-014","text":"隰有樹檖","isActive":false},{"id":"seg-015","text":"未見君子","isActive":false},{"id":"seg-016","text":"憂心如醉","isActive":false},{"id":"seg-017","text":"如何如何","isActive":false},{"id":"seg-018","text":"忘我實多","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"晨風㊟未詳。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"依据 materials/searchable/epub/cache/text/诗经原始_方玉润_李先耕点校_上下/item-0153.txt 的题注段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注"}]},{"id":"0002","order":2,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"右《晨風》三章，章六句。《序》謂「康公棄其賢臣」，僞傳謂「秦君遇賢，始勤終怠」。二説未甚相遠。惟《集傳》則以爲婦人念其君子之詞，又引《扊扅歌》以證秦俗，與古《序》大相反。今觀詩詞，以爲刺康公者固無據，以爲婦人思夫者亦未足憑。總之，男女情與君臣義，原本相通。詩既不露其旨，人固難以意測。與其妄逞臆説，不如闕疑存參。且其詩無甚精義，置焉可也。","targetNotes":"对应 item-0153 中“右《晨风》三章”开篇的分析段。","sourceLabel":null,"sourceNotes":"定位 materials/searchable/epub/cache/text/诗经原始_方玉润_李先耕点校_上下/item-0153.txt 中“右《晨风》三章”的论述。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"右《晨风》"}]},{"id":"0003","order":3,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"集釋鴥疾飛貌。晨風鸇也。鬱茂盛貌。欽欽憂而不忘之貌。駁〔《集傳》〕駁，梓榆也。其色青白如駁。檖〔郭氏璞曰〕今楊檖也。〔《集傳》〕檖，赤羅也。實似梨而小，酢可食。","targetNotes":"集释原文。","sourceLabel":null,"sourceNotes":"集释段源自同一 EPUB item。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"集释"}]},{"id":"0004","order":4,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"標韻風一東，叶孚愔反。林十二侵。欽同。叶韻。何五歌。多同。本韻。櫟十二錫，叶奪名反。駁三覺。樂十藥。叶韻。棣八霽。檖四寘。醉同。通韻。","targetNotes":"标韵说明。","sourceLabel":null,"sourceNotes":"标韵段来自同一 EPUB item 。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":"标韵"}]}]}}}
