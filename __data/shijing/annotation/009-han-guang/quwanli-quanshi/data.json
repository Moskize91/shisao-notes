{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/009-han-guang/quwanli-quanshi","dataHref":"/__data/shijing/annotation/009-han-guang/quwanli-quanshi/data.json","title":"詩經詮釋 · 漢廣 · 注释总览","description":"風 · 周南 · 漢廣 · 汇集《詩經詮釋》关于《漢廣》的 4 条 annotation，含 8 条 gloss。"},"payload":{"detail":{"route":{"poemId":"009-han-guang","materialId":"quwanli-quanshi"},"href":"/shijing/annotation/009-han-guang/quwanli-quanshi","poem":{"id":"009-han-guang","title":"漢廣","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","漢廣"],"segments":[{"id":"seg-001","text":"南有喬木","isActive":false},{"id":"seg-002","text":"不可休息","isActive":false},{"id":"seg-003","text":"漢有游女","isActive":false},{"id":"seg-004","text":"不可求思","isActive":false},{"id":"seg-005","text":"漢之廣矣","isActive":false},{"id":"seg-006","text":"不可泳思","isActive":false},{"id":"seg-007","text":"江之永矣","isActive":false},{"id":"seg-008","text":"不可方思","isActive":false},{"id":"seg-009","text":"翹翹錯薪","isActive":false},{"id":"seg-010","text":"言刈其楚","isActive":false},{"id":"seg-011","text":"之子于歸","isActive":false},{"id":"seg-012","text":"言秣其馬","isActive":false},{"id":"seg-013","text":"漢之廣矣","isActive":false},{"id":"seg-014","text":"不可泳思","isActive":false},{"id":"seg-015","text":"江之永矣","isActive":false},{"id":"seg-016","text":"不可方思","isActive":false},{"id":"seg-017","text":"翹翹錯薪","isActive":false},{"id":"seg-018","text":"言刈其蔞","isActive":false},{"id":"seg-019","text":"之子于歸","isActive":false},{"id":"seg-020","text":"言秣其駒","isActive":false},{"id":"seg-021","text":"漢之廣矣","isActive":false},{"id":"seg-022","text":"不可泳思","isActive":false},{"id":"seg-023","text":"江之永矣","isActive":false},{"id":"seg-024","text":"不可方思","isActive":false}]},"material":{"id":"quwanli-quanshi","title":"詩經詮釋","authors":["屈萬里"],"contributorLine":"现代 · 屈萬里","era":"现代","publicationYear":1983,"carrier":"PDF"},"stats":{"annotationCount":4,"glossCount":8},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"題注與章次總說","targetNotes":"页图上缘的题注与开篇段落。","sourceLabel":"第 51 页局部","sourceNotes":"第 51 页上半段题注，称此为“江干樵唱”并简述三章结构。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"屈万里","sectionLabel":"题注","text":"题注谓此诗为江干樵唱，三章层层铺出汉广的江水与游女，借樵人唱词反复在江汉之上呼唤道德。","notes":null},{"key":"0001-2","attributionLabel":"屈万里","sectionLabel":"题注","text":"作者强调“漢之廣矣”“江之永矣”乃呈现江汉之浩渺，诗人借此反复写出游女不可得、德化不绝的感慨。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"南有喬木，不可休息。漢有游女，不可求思。漢之廣矣，不可泳思。江之永矣，不可方思。","targetNotes":"第一章的开头与江景描写。","sourceLabel":"第 51-52 页","sourceNotes":"第 51-52 页开头段落与旁注。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"屈万里","sectionLabel":null,"text":"屈氏以“喬木”“江之永”作比，赞赏游女如高木般不可逼近，又借江汉广阔说明她已脱离旧俗之境。","notes":null},{"key":"0002-2","attributionLabel":"屈万里","sectionLabel":null,"text":"“游女不可求思”一语，借江边游女的寂寞推出其守礼的节操，并以水永长、方不可渡来象征德化之广被。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"翹翹錯薪，言刈其楚。之子于歸，言秣其馬。漢之廣矣，不可泳思。江之永矣，不可方思。","targetNotes":"第二章的樵人采薪与告白。","sourceLabel":"第 51-52 页","sourceNotes":"第 51-52 页中段对第二章的注释。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"屈万里","sectionLabel":null,"text":"屈氏解“翹翹錯薪”为樵人高起的薪束，以“之子于歸”指向欲嫁之女，“言秣其馬”表明男方已准备礼物而身在江广之上。","notes":null},{"key":"0003-2","attributionLabel":"屈万里","sectionLabel":null,"text":"再咏“漢之廣”“江之永”则隐喻世间多饥荒而游女之坚贞不可求，既崇高又保密。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"翹翹錯薪，言刈其蔞。之子于歸，言秣其駒。漢之廣矣，不可泳思。江之永矣，不可方思。","targetNotes":"第三章续写“刈蔞”“秣駒”及江景收束。","sourceLabel":"第 51-52 页","sourceNotes":"第 52 页底段注释转入第三章。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"屈万里","sectionLabel":null,"text":"注释称“蔞”“駒”为寓意清新的香草与小马，写樵人送别的温情并借江景收束全诗，语中仍显江汉之宽广不可渡。","notes":null},{"key":"0004-2","attributionLabel":"屈万里","sectionLabel":null,"text":"最后再次顶“江之永”“不可方”，以三次重复增强吟唱之感并说明登江而不得的隐忍。","notes":null}]}]}}}
