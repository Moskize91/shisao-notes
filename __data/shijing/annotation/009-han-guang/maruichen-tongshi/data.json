{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/009-han-guang/maruichen-tongshi","dataHref":"/__data/shijing/annotation/009-han-guang/maruichen-tongshi/data.json","title":"毛詩傳箋通釋 · 漢廣 · 注释总览","description":"風 · 周南 · 漢廣 · 汇集《毛詩傳箋通釋》关于《漢廣》的 4 条 annotation，含 4 条 gloss。"},"payload":{"detail":{"route":{"poemId":"009-han-guang","materialId":"maruichen-tongshi"},"href":"/shijing/annotation/009-han-guang/maruichen-tongshi","poem":{"id":"009-han-guang","title":"漢廣","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","漢廣"],"segments":[{"id":"seg-001","text":"南有喬木","isActive":false},{"id":"seg-002","text":"不可休息","isActive":false},{"id":"seg-003","text":"漢有游女","isActive":false},{"id":"seg-004","text":"不可求思","isActive":false},{"id":"seg-005","text":"漢之廣矣","isActive":false},{"id":"seg-006","text":"不可泳思","isActive":false},{"id":"seg-007","text":"江之永矣","isActive":false},{"id":"seg-008","text":"不可方思","isActive":false},{"id":"seg-009","text":"翹翹錯薪","isActive":false},{"id":"seg-010","text":"言刈其楚","isActive":false},{"id":"seg-011","text":"之子于歸","isActive":false},{"id":"seg-012","text":"言秣其馬","isActive":false},{"id":"seg-013","text":"漢之廣矣","isActive":false},{"id":"seg-014","text":"不可泳思","isActive":false},{"id":"seg-015","text":"江之永矣","isActive":false},{"id":"seg-016","text":"不可方思","isActive":false},{"id":"seg-017","text":"翹翹錯薪","isActive":false},{"id":"seg-018","text":"言刈其蔞","isActive":false},{"id":"seg-019","text":"之子于歸","isActive":false},{"id":"seg-020","text":"言秣其駒","isActive":false},{"id":"seg-021","text":"漢之廣矣","isActive":false},{"id":"seg-022","text":"不可泳思","isActive":false},{"id":"seg-023","text":"江之永矣","isActive":false},{"id":"seg-024","text":"不可方思","isActive":false}]},"material":{"id":"maruichen-tongshi","title":"毛詩傳箋通釋","authors":["馬瑞辰"],"contributorLine":"清 · 馬瑞辰","era":"清","publicationYear":1989,"carrier":"PDF"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"《漢廣》江漢比興與不可求之旨","targetNotes":"篇首总释。","sourceLabel":"第 92-93 页","sourceNotes":"位于 /tmp/hanguang-pages/maruichen-1.png 与 /tmp/hanguang-pages/maruichen-2.png 的总说与训释段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"马瑞辰","sectionLabel":"按","text":"瑞辰总论《漢廣》时，仍承毛、郑以江汉游女不可求见文王德化之说，同时细辨“休息”“求思”“泳”“方”等字义，认为首章先以乔木起兴，再以江汉广长为比，重在写游女守礼不可犯，而不是徒作男女私情之歌。","notes":"依据第 92-93 页总释提要。"}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"南有喬木，不可休息。漢有游女，不可求思。漢之廣矣，不可泳思。江之永矣，不可方思。","targetNotes":"首章考释。","sourceLabel":"第 92-93 页","sourceNotes":"第 92 页起首章注释，续见 /tmp/hanguang-pages/maruichen-2.png 上段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"马瑞辰","sectionLabel":"按","text":"瑞辰释“喬木”为高而难就之木，借以兴游女之不可狎；又辨“休息”古本或作“休思”，“思”仍为语辞。其尤着力于“泳”“方”二字，谓前者是潜行涉水，后者是凭桴横渡，皆从不可渡写到不可求，故首章四句层层转深。","notes":"依据第 92-93 页首章提要。"}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"翹翹錯薪，言刈其楚。之子于歸，言秣其馬。漢之廣矣，不可泳思。江之永矣，不可方思。","targetNotes":"第二章考释。","sourceLabel":"第 93 页","sourceNotes":"第 93 页中段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"马瑞辰","sectionLabel":"按","text":"瑞辰以“翹翹錯薪”为高起错杂之薪束，认为“言刈其楚”并非徒叙樵采，而是借取其尤美者以比所慕之女；“之子于歸，言秣其馬”则转为设想其嫁时备马致礼，以见爱慕而不失于礼，末仍以江汉叠句收回不可得之意。","notes":"依据第 93 页第二章提要。"}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"翹翹錯薪，言刈其蔞。之子于歸，言秣其駒。漢之廣矣，不可泳思。江之永矣，不可方思。","targetNotes":"第三章考释。","sourceLabel":"第 94 页","sourceNotes":"第 94 页上段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"马瑞辰","sectionLabel":"按","text":"瑞辰以第三章的“蔞”“駒”承上章“楚”“馬”而加细，谓由刈薪备马进到刈蔞秣駒，礼意更具体，思慕也更深；但全章终以“漢之廣矣”四句反复收束，说明虽有爱敬之诚，终不敢越礼求之。","notes":"依据第 94 页第三章提要。"}]}]}}}
