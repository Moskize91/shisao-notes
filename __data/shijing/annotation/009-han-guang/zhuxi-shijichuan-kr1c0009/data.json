{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/009-han-guang/zhuxi-shijichuan-kr1c0009","dataHref":"/__data/shijing/annotation/009-han-guang/zhuxi-shijichuan-kr1c0009/data.json","title":"詩集傳 · 漢廣 · 注释总览","description":"風 · 周南 · 漢廣 · 汇集《詩集傳》关于《漢廣》的 4 条注释，含 6 条注脚。"},"payload":{"detail":{"route":{"poemId":"009-han-guang","materialId":"zhuxi-shijichuan-kr1c0009"},"href":"/shijing/annotation/009-han-guang/zhuxi-shijichuan-kr1c0009","poem":{"id":"009-han-guang","title":"漢廣","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","漢廣"],"segments":[{"id":"seg-001","text":"南有喬木","isActive":true},{"id":"seg-002","text":"不可休息","isActive":true},{"id":"seg-003","text":"漢有游女","isActive":true},{"id":"seg-004","text":"不可求思","isActive":true},{"id":"seg-005","text":"漢之廣矣","isActive":true},{"id":"seg-006","text":"不可泳思","isActive":true},{"id":"seg-007","text":"江之永矣","isActive":true},{"id":"seg-008","text":"不可方思","isActive":true},{"id":"seg-009","text":"翹翹錯薪","isActive":false},{"id":"seg-010","text":"言刈其楚","isActive":false},{"id":"seg-011","text":"之子于歸","isActive":false},{"id":"seg-012","text":"言秣其馬","isActive":false},{"id":"seg-013","text":"漢之廣矣","isActive":false},{"id":"seg-014","text":"不可泳思","isActive":false},{"id":"seg-015","text":"江之永矣","isActive":false},{"id":"seg-016","text":"不可方思","isActive":false},{"id":"seg-017","text":"翹翹錯薪","isActive":false},{"id":"seg-018","text":"言刈其蔞","isActive":false},{"id":"seg-019","text":"之子于歸","isActive":false},{"id":"seg-020","text":"言秣其駒","isActive":false},{"id":"seg-021","text":"漢之廣矣","isActive":false},{"id":"seg-022","text":"不可泳思","isActive":false},{"id":"seg-023","text":"江之永矣","isActive":false},{"id":"seg-024","text":"不可方思","isActive":false}]},"material":{"id":"zhuxi-shijichuan-kr1c0009","title":"詩集傳","authors":["朱熹"],"contributorLine":"宋 · 朱熹","era":"宋","publicationYear":1186,"carrier":"TXT"},"stats":{"annotationCount":4,"glossCount":6},"annotations":[{"id":"0001","order":1,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"南有喬木，不可休息。漢有游女，不可求思。漢之廣矣，不可泳思。江之永矣，不可方思。","targetNotes":"首章。","sourceLabel":null,"sourceNotes":"对应 txt 177-185 行。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"朱熹","sectionLabel":"传","text":"興而比也。上竦無枝曰喬。思，語辭也。篇内同。漢水出興元府嶓冡山，至漢陽軍大别山入江。江水出永康軍岷山，東流與漢水合，東北入海。永，長也。方，桴也。","notes":null},{"key":"0001-2","attributionLabel":"朱熹","sectionLabel":"传","text":"文王之化自近而逺，先及於江漢之閒，而有以變其淫亂之俗，故其出游之女人望見之而知其端莊靜一，非復前日之可求矣。因以喬木起興，江漢爲比，而反復詠歎之也。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"翹翹錯薪，言刈其楚。之子于歸，言秣其馬。漢之廣矣，不可泳思。江之永矣，不可方思。","targetNotes":"第二章。","sourceLabel":null,"sourceNotes":"对应 txt 187-191 行。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"朱熹","sectionLabel":"传","text":"興而比也。翹翹，秀起之貌。錯，雜也。楚，木名，荆屬。之子，指游女也。秣，飼也。","notes":null},{"key":"0002-2","attributionLabel":"朱熹","sectionLabel":"传","text":"以錯薪起興而欲秣其馬，則恱之至；以江漢爲比而歎其終不可求，則敬之深。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"翹翹錯薪，言刈其蔞。之子于歸，言秣其駒。漢之廣矣，不可泳思。江之永矣，不可方思。","targetNotes":"第三章。","sourceLabel":null,"sourceNotes":"对应 txt 191-195 行。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"朱熹","sectionLabel":"传","text":"興而比也。蔞，蔞蒿也，葉似艾，青白色，長數寸，生水澤中。駒，馬之小者。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"漢廣三章章八句","targetNotes":"章句总说。","sourceLabel":null,"sourceNotes":"对应 txt 196 行。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"朱熹","sectionLabel":"总评","text":"漢廣三章章八句。","notes":null}]}]}}}
