{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/009-han-guang/maoheng-zhushu-kr1c0004","dataHref":"/__data/shijing/annotation/009-han-guang/maoheng-zhushu-kr1c0004/data.json","title":"毛詩注疏 · 漢廣 · 注释总览","description":"風 · 周南 · 漢廣 · 汇集《毛詩注疏》关于《漢廣》的 5 条注释，含 8 条注脚。"},"payload":{"detail":{"route":{"poemId":"009-han-guang","materialId":"maoheng-zhushu-kr1c0004"},"href":"/shijing/annotation/009-han-guang/maoheng-zhushu-kr1c0004","poem":{"id":"009-han-guang","title":"漢廣","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","漢廣"],"segments":[{"id":"seg-001","text":"南有喬木","isActive":false},{"id":"seg-002","text":"不可休息","isActive":false},{"id":"seg-003","text":"漢有游女","isActive":false},{"id":"seg-004","text":"不可求思","isActive":false},{"id":"seg-005","text":"漢之廣矣","isActive":false},{"id":"seg-006","text":"不可泳思","isActive":false},{"id":"seg-007","text":"江之永矣","isActive":false},{"id":"seg-008","text":"不可方思","isActive":false},{"id":"seg-009","text":"翹翹錯薪","isActive":false},{"id":"seg-010","text":"言刈其楚","isActive":false},{"id":"seg-011","text":"之子于歸","isActive":false},{"id":"seg-012","text":"言秣其馬","isActive":false},{"id":"seg-013","text":"漢之廣矣","isActive":false},{"id":"seg-014","text":"不可泳思","isActive":false},{"id":"seg-015","text":"江之永矣","isActive":false},{"id":"seg-016","text":"不可方思","isActive":false},{"id":"seg-017","text":"翹翹錯薪","isActive":false},{"id":"seg-018","text":"言刈其蔞","isActive":false},{"id":"seg-019","text":"之子于歸","isActive":false},{"id":"seg-020","text":"言秣其駒","isActive":false},{"id":"seg-021","text":"漢之廣矣","isActive":false},{"id":"seg-022","text":"不可泳思","isActive":false},{"id":"seg-023","text":"江之永矣","isActive":false},{"id":"seg-024","text":"不可方思","isActive":false}]},"material":{"id":"maoheng-zhushu-kr1c0004","title":"毛詩注疏","authors":["毛亨","鄭氏","孔穎達"],"contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","era":"漢唐","publicationYear":653,"carrier":"TXT"},"stats":{"annotationCount":5,"glossCount":8},"annotations":[{"id":"0001","order":1,"total":5,"layer":"preface","layerLabel":"篇序","targetText":"序《漢廣》","targetNotes":"篇首小序与郑笺。","sourceLabel":null,"sourceNotes":"对应 txt 1073-1084 行。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序","text":"序：漢廣，徳廣所及也。文王之道被于南國，美化行乎江漢之域，無思犯禮，求而不可得也。","notes":null},{"key":"0001-2","attributionLabel":"郑笺","sectionLabel":null,"text":"箋：紂時淫風徧於天下，維江漢之域先受文王之教化。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"南有喬木，不可休息。漢有游女，不可求思。漢之廣矣，不可泳思。江之永矣，不可方思。","targetNotes":"首章。","sourceLabel":null,"sourceNotes":"对应 txt 1085-1118 行。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：興也。南方之木美喬，上竦也。思，辭也。漢上游女，無求思者。潜行為泳。永，長。方，泭也。","notes":null},{"key":"0002-2","attributionLabel":"郑笺","sectionLabel":null,"text":"箋云：不可者，本有可道也。木以高其枝葉之故，故人不得就而止息也；興者喻賢女雖出游流水之上，人無欲求犯禮者，亦由貞潔使之然。漢也江也，其欲渡之者必有潜行乘泭之道，今以廣長之故，故不可也；又喻女之貞潔，犯禮而徃，将不至也。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"翹翹錯薪，言刈其楚。之子于歸，言秣其馬。漢之廣矣，不可泳思。江之永矣，不可方思。","targetNotes":"第二章。","sourceLabel":null,"sourceNotes":"对应 txt 1119-1139 行。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：翹翹，薪貌。錯，雜也。秣，養也。六尺以上曰馬。","notes":null},{"key":"0003-2","attributionLabel":"郑笺","sectionLabel":null,"text":"箋云：楚，雜薪之中尤翹翹者，我欲刈取之，以喻衆女皆貞潔，我又欲取其尤高潔者。之子，是子也，謙不敢斥其適己。於是子之嫁我，願秣其馬，致禮餼，示有意焉。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"翹翹錯薪，言刈其蔞。之子于歸，言秣其駒。漢之廣矣，不可泳思。江之永矣，不可方思。","targetNotes":"第三章。","sourceLabel":null,"sourceNotes":"对应 txt 1140-1149 行。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：蔞，草中之翹翹然。五尺以上曰駒。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"漢廣三章章八句","targetNotes":"章句总说。","sourceLabel":null,"sourceNotes":"对应 txt 1151 行。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"章句","sectionLabel":null,"text":"漢廣三章章八句。","notes":null}]}]}}}
