{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/009-han-guang/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/009-han-guang/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 漢廣 · 注释总览","description":"風 · 周南 · 漢廣 · 汇集《诗经原始(上下)》关于《漢廣》的 8 条 annotation，含 8 条 gloss。"},"payload":{"detail":{"route":{"poemId":"009-han-guang","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/009-han-guang/fangyurun-yuanshi","poem":{"id":"009-han-guang","title":"漢廣","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","漢廣"],"segments":[{"id":"seg-001","text":"南有喬木","isActive":false},{"id":"seg-002","text":"不可休息","isActive":false},{"id":"seg-003","text":"漢有游女","isActive":false},{"id":"seg-004","text":"不可求思","isActive":false},{"id":"seg-005","text":"漢之廣矣","isActive":false},{"id":"seg-006","text":"不可泳思","isActive":false},{"id":"seg-007","text":"江之永矣","isActive":false},{"id":"seg-008","text":"不可方思","isActive":false},{"id":"seg-009","text":"翹翹錯薪","isActive":false},{"id":"seg-010","text":"言刈其楚","isActive":false},{"id":"seg-011","text":"之子于歸","isActive":false},{"id":"seg-012","text":"言秣其馬","isActive":false},{"id":"seg-013","text":"漢之廣矣","isActive":false},{"id":"seg-014","text":"不可泳思","isActive":false},{"id":"seg-015","text":"江之永矣","isActive":false},{"id":"seg-016","text":"不可方思","isActive":false},{"id":"seg-017","text":"翹翹錯薪","isActive":false},{"id":"seg-018","text":"言刈其蔞","isActive":false},{"id":"seg-019","text":"之子于歸","isActive":false},{"id":"seg-020","text":"言秣其駒","isActive":false},{"id":"seg-021","text":"漢之廣矣","isActive":false},{"id":"seg-022","text":"不可泳思","isActive":false},{"id":"seg-023","text":"江之永矣","isActive":false},{"id":"seg-024","text":"不可方思","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":8,"glossCount":8},"annotations":[{"id":"0001","order":1,"total":8,"layer":"global","layerLabel":"全篇总说","targetText":"题注与三章章次总提","targetNotes":"对应 item-0018 题注与章次总提。","sourceLabel":null,"sourceNotes":"item-0018.txt 第 3-7 行。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注","text":"题注为“江干樵唱騐德化之廣被也”。并概述三章层次：首章借乔木、游女与江景起情，二章以刈楚、秣马推进，三章再以刈蔞、秣駒收束，反复以江汉广大咏叹不可求之意。","notes":null}]},{"id":"0002","order":2,"total":8,"layer":"span","layerLabel":"诗句片段","targetText":"南有喬木，不可休息。漢有游女，不可求思。漢之廣矣，不可泳思。江之永矣，不可方思。","targetNotes":"第一章。","sourceLabel":null,"sourceNotes":"item-0018.txt 第 5 行。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":null,"text":"首章以“漢有游女，不可求思”主言情，又以“漢之廣矣”以下写景。方氏特别标出《韩诗》作“思”，并把全章看作借江汉烟波与乔木高起，衬出游女不可求的悠远情味。","notes":null}]},{"id":"0003","order":3,"total":8,"layer":"span","layerLabel":"诗句片段","targetText":"翹翹錯薪，言刈其楚。之子于歸，言秣其馬。漢之廣矣，不可泳思。江之永矣，不可方思。","targetNotes":"第二章。","sourceLabel":null,"sourceNotes":"item-0018.txt 第 6 行。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":null,"text":"二章以“翹翹錯薪，言刈其楚”转入正面樵唱，把“之子于歸，言秣其馬”看作进一层言情，随后再咏江景。方氏认为这里并非空设游女情事，而是樵子歌中夹带爱慕幽思。","notes":null}]},{"id":"0004","order":4,"total":8,"layer":"span","layerLabel":"诗句片段","targetText":"翹翹錯薪，言刈其蔞。之子于歸，言秣其駒。漢之廣矣，不可泳思。江之永矣，不可方思。","targetNotes":"第三章。","sourceLabel":null,"sourceNotes":"item-0018.txt 第 7 行。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":null,"text":"三章再咏“刈蔞”“秣駒”，仍以江景作结。方氏特别指出三咏江景有“篇終接混茫”之意，认为章法尤奇，使全诗在樵唱之中自然收出烟水浩渺、可望不可即的余韵。","notes":null}]},{"id":"0005","order":5,"total":8,"layer":"global","layerLabel":"全篇总说","targetText":"总评与篇旨辨析","targetNotes":"右《漢廣》三章后总评。","sourceLabel":null,"sourceNotes":"item-0018.txt 第 9 行。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"方玉润","sectionLabel":"总评","text":"方氏驳《小序》《大序》及《集传》一系把此诗坐实为文王德化下江汉游女不可求之说，认为“翹翹錯薪”“刈楚”“刈蔞”若离开樵唱背景便无著落。其定论是此诗本为山樵之歌，诗人取其男女相赠答而仍能以礼自持之意，故既可写游女不可求，亦可见周家德化所及。","notes":null}]},{"id":"0006","order":6,"total":8,"layer":"global","layerLabel":"全篇总说","targetText":"眉评","targetNotes":"篇后眉评。","sourceLabel":null,"sourceNotes":"item-0018.txt 第 11 行。","notes":null,"glosses":[{"key":"0006-1","attributionLabel":"方玉润","sectionLabel":"眉评","text":"眉评谓首章从乔木兴起，为下文刈薪张本；后二章的刈楚、刈蔞乃写正面，仍带定游女，妙在有意无意之间。又称“漢廣”三章叠咏，一字不易，正是一唱三叹的遗音。","notes":null}]},{"id":"0007","order":7,"total":8,"layer":"term","layerLabel":"字词注","targetText":"喬／休息／漢／泳／江／永／方／翹翹錯薪／楚／秣／蔞／駒","targetNotes":"集释中关键训诂组。","sourceLabel":null,"sourceNotes":"item-0018.txt 第 13 行。","notes":null,"glosses":[{"key":"0007-1","attributionLabel":"集释","sectionLabel":null,"text":"集释汇孔颖达、《集传》《皇舆表》等说，释喬为高、汉江水道、泳为潜行、永为长、方为桴，又释翹翹错薪之貌、楚为荆属、秣为饲、蔞为蒿类、駒为小马，并保留《韩诗》与古本“休思”异文之辨。","notes":null}]},{"id":"0008","order":8,"total":8,"layer":"global","layerLabel":"全篇总说","targetText":"标韵","targetNotes":"各章韵脚与通韵说明。","sourceLabel":null,"sourceNotes":"item-0018.txt 第 15 行。","notes":null,"glosses":[{"key":"0008-1","attributionLabel":"标韵","sectionLabel":null,"text":"标韵以“休”“求”为尤部，“廣”为养部，“方”为阳部，“泳”“永”为敬、梗叶韵，并指出二句意本不相连而韵自叶；后二章则以“楚、馬”“蔞、駒”各自成韵，仍与江汉四句的叶韵相间。","notes":null}]}]}}}
