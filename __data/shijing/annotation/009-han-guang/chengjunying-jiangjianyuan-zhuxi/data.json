{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/009-han-guang/chengjunying-jiangjianyuan-zhuxi","dataHref":"/__data/shijing/annotation/009-han-guang/chengjunying-jiangjianyuan-zhuxi/data.json","title":"詩經注析 · 漢廣 · 注释总览","description":"風 · 周南 · 漢廣 · 汇集《詩經注析》关于《漢廣》的 4 条 annotation，含 4 条 gloss。"},"payload":{"detail":{"route":{"poemId":"009-han-guang","materialId":"chengjunying-jiangjianyuan-zhuxi"},"href":"/shijing/annotation/009-han-guang/chengjunying-jiangjianyuan-zhuxi","poem":{"id":"009-han-guang","title":"漢廣","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","漢廣"],"segments":[{"id":"seg-001","text":"南有喬木","isActive":false},{"id":"seg-002","text":"不可休息","isActive":false},{"id":"seg-003","text":"漢有游女","isActive":false},{"id":"seg-004","text":"不可求思","isActive":false},{"id":"seg-005","text":"漢之廣矣","isActive":false},{"id":"seg-006","text":"不可泳思","isActive":false},{"id":"seg-007","text":"江之永矣","isActive":false},{"id":"seg-008","text":"不可方思","isActive":false},{"id":"seg-009","text":"翹翹錯薪","isActive":false},{"id":"seg-010","text":"言刈其楚","isActive":false},{"id":"seg-011","text":"之子于歸","isActive":false},{"id":"seg-012","text":"言秣其馬","isActive":false},{"id":"seg-013","text":"漢之廣矣","isActive":false},{"id":"seg-014","text":"不可泳思","isActive":false},{"id":"seg-015","text":"江之永矣","isActive":false},{"id":"seg-016","text":"不可方思","isActive":false},{"id":"seg-017","text":"翹翹錯薪","isActive":false},{"id":"seg-018","text":"言刈其蔞","isActive":false},{"id":"seg-019","text":"之子于歸","isActive":false},{"id":"seg-020","text":"言秣其駒","isActive":false},{"id":"seg-021","text":"漢之廣矣","isActive":false},{"id":"seg-022","text":"不可泳思","isActive":false},{"id":"seg-023","text":"江之永矣","isActive":false},{"id":"seg-024","text":"不可方思","isActive":false}]},"material":{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","authors":["程俊英","蔣見元"],"contributorLine":"现代 · 程俊英、蔣見元","era":"现代","publicationYear":1991,"carrier":"PDF"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"preface","layerLabel":"篇序","targetText":"题解","targetNotes":"依照书中题解段。","sourceLabel":"第 41 页","sourceNotes":"/tmp/hanguang-pages/cheng-1.png 上段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"题解将《漢廣》置于江汉之间的风物背景：以乔木与江水比兴，说明文王德化已被沿江之地所感化，游女虽出行于汉水却仍守礼，不可轻易为人所求。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"南有喬木，不可休息。漢有游女，不可求思。漢之廣矣，不可泳思。江之永矣，不可方思。","targetNotes":"首章。","sourceLabel":"第 41-42 页","sourceNotes":"/tmp/hanguang-pages/cheng-1.png 章首与注。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"章首以乔木高耸与汉水之广作比，写游女虽可出游江汉却不敢越礼，借乔木之伟与江水之不可渡象征文王德化使人自持节操。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"翹翹錯薪，言刈其楚。之子于歸，言秣其馬。漢之廣矣，不可泳思。江之永矣，不可方思。","targetNotes":"第二章。","sourceLabel":"第 42 页","sourceNotes":"/tmp/hanguang-pages/cheng-1.png 下段与 /tmp/hanguang-pages/cheng-2.png 上段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"次章从‘翹翹錯薪’入手，把楚薪喻作游女的忠洁，并以刈楚秣马之语将樵子与女子的仪礼融合，进一步将汉水之远与游女之可慕并置。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"翹翹錯薪，言刈其蔞。之子于歸，言秣其駒。漢之廣矣，不可泳思。江之永矣，不可方思。","targetNotes":"第三章。","sourceLabel":"第 42-43 页","sourceNotes":"/tmp/hanguang-pages/cheng-2.png 下段与 /tmp/hanguang-pages/cheng-3.png 上段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"第三章再以‘刈蔞’‘秣駒’收束，仍以江汉四句对应，称整首诗在樵唱之间却保持礼义，将游女与男子的情感用江水之远与自守之正拉回。","notes":null}]}]}}}
