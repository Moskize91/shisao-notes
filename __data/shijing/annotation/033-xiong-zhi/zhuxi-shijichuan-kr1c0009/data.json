{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/033-xiong-zhi/zhuxi-shijichuan-kr1c0009","dataHref":"/__data/shijing/annotation/033-xiong-zhi/zhuxi-shijichuan-kr1c0009/data.json","title":"詩集傳 · 雄雉 · 注释总览","description":"風 · 邶風 · 雄雉 · 汇集《詩集傳》关于《雄雉》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"033-xiong-zhi","materialId":"zhuxi-shijichuan-kr1c0009"},"href":"/shijing/annotation/033-xiong-zhi/zhuxi-shijichuan-kr1c0009","poem":{"id":"033-xiong-zhi","title":"雄雉","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","雄雉"],"segments":[{"id":"seg-001","text":"雄雉于飛","isActive":true},{"id":"seg-002","text":"泄泄其羽","isActive":true},{"id":"seg-003","text":"我之懷矣","isActive":true},{"id":"seg-004","text":"自貽伊阻","isActive":true},{"id":"seg-005","text":"雄雉于飛","isActive":false},{"id":"seg-006","text":"下上其音","isActive":false},{"id":"seg-007","text":"展矣君子","isActive":false},{"id":"seg-008","text":"實勞我心","isActive":false},{"id":"seg-009","text":"瞻彼日月","isActive":false},{"id":"seg-010","text":"悠悠我思","isActive":false},{"id":"seg-011","text":"道之云遠","isActive":false},{"id":"seg-012","text":"曷云能來","isActive":false},{"id":"seg-013","text":"百爾君子","isActive":false},{"id":"seg-014","text":"不知德行","isActive":false},{"id":"seg-015","text":"不忮不求","isActive":false},{"id":"seg-016","text":"何用不臧","isActive":false}]},"material":{"id":"zhuxi-shijichuan-kr1c0009","title":"詩集傳","authors":["朱熹"],"contributorLine":"宋 · 朱熹","era":"宋","publicationYear":1186,"carrier":"TXT"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"雄雉于飛。泄泄其羽。我之懷矣，自貽伊阻。","targetNotes":"首章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》雄雉首章。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"朱熹","sectionLabel":null,"text":"興也。朱熹以為婦人見雄雉飛行舒緩自得，而反興起對從役君子的思念；“自詒伊阻”則點出阻隔之苦，亦若其人自致遠役。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"雄雉于飛。下上其音。展矣君子，實勞我心。","targetNotes":"第二章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》第二章。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"朱熹","sectionLabel":null,"text":"興也。朱熹說下上其音是雉飛鳴自得之狀，“展矣君子，實勞我心”則反覆加重所思君子勞我心之深。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"瞻彼日月，悠悠我思。道之云遠，曷云能來。","targetNotes":"第三章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》第三章。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"朱熹","sectionLabel":null,"text":"賦也。朱熹直以此章寫見日月往來而思君子從役之久，道路既遠，故不知何時能來。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"百爾君子，不知德行。不忮不求，何用不臧。","targetNotes":"第四章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》第四章。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"朱熹","sectionLabel":null,"text":"賦也。朱熹解“百”為凡，認為此章是憂其遠行之犯患，而冀其善處得全；只要不忮害、不貪求，則無往而不善。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"雄雉四章章四句","targetNotes":"章句总说。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》雄雉章句总说。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"朱熹","sectionLabel":null,"text":"朱熹记《雄雉》为四章、章四句，并通篇视作婦人念夫從役于外之辭。","notes":null}]}]}}}
