{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/033-xiong-zhi/maoheng-zhushu-kr1c0004","dataHref":"/__data/shijing/annotation/033-xiong-zhi/maoheng-zhushu-kr1c0004/data.json","title":"毛詩注疏 · 雄雉 · 注释总览","description":"風 · 邶風 · 雄雉 · 汇集《毛詩注疏》关于《雄雉》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"033-xiong-zhi","materialId":"maoheng-zhushu-kr1c0004"},"href":"/shijing/annotation/033-xiong-zhi/maoheng-zhushu-kr1c0004","poem":{"id":"033-xiong-zhi","title":"雄雉","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","雄雉"],"segments":[{"id":"seg-001","text":"雄雉於飛","isActive":false},{"id":"seg-002","text":"泄泄其羽","isActive":false},{"id":"seg-003","text":"我之懷矣","isActive":false},{"id":"seg-004","text":"自詒伊阻","isActive":false},{"id":"seg-005","text":"雄雉於飛","isActive":false},{"id":"seg-006","text":"下上其音","isActive":false},{"id":"seg-007","text":"展矣君子","isActive":false},{"id":"seg-008","text":"實勞我心","isActive":false},{"id":"seg-009","text":"瞻彼日月","isActive":false},{"id":"seg-010","text":"悠悠我思","isActive":false},{"id":"seg-011","text":"道之云遠","isActive":false},{"id":"seg-012","text":"曷云能來","isActive":false},{"id":"seg-013","text":"百爾君子","isActive":false},{"id":"seg-014","text":"不知德行","isActive":false},{"id":"seg-015","text":"不忮不求","isActive":false},{"id":"seg-016","text":"何用不臧","isActive":false}]},"material":{"id":"maoheng-zhushu-kr1c0004","title":"毛詩注疏","authors":["毛亨","鄭氏","孔穎達"],"contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","era":"漢唐","publicationYear":653,"carrier":"TXT"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"preface","layerLabel":"篇序","targetText":"雄雉刺衛宣公也淫亂不恤國事軍旅數起大夫久役男女怨曠國人患之而作是詩","targetNotes":"篇首小序。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》雄雉序文。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序","text":"序：《雄雉》，刺衛宣公也。淫亂不恤國事，軍旅數起，大夫久役，男女怨曠，國人患之而作是詩。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"雄雉於飛泄泄其羽我之懷矣自詒伊阻","targetNotes":"首章。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》首章。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：雄雉見雌雉飛，而鼓其翼泄泄然。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"雄雉於飛下上其音展矣君子實勞我心","targetNotes":"第二章。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》第二章。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：展，誠也。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"瞻彼日月悠悠我思道之云遠曷云能來","targetNotes":"第三章。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》第三章。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：瞻，視也。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"百爾君子不知德行不忮不求何用不臧","targetNotes":"第四章。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》第四章。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：忮，害。臧，善也。","notes":null}]}]}}}
