{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/033-xiong-zhi/chengjunying-jiangjianyuan-zhuxi","dataHref":"/__data/shijing/annotation/033-xiong-zhi/chengjunying-jiangjianyuan-zhuxi/data.json","title":"詩經注析 · 雄雉 · 注释总览","description":"風 · 邶風 · 雄雉 · 汇集《詩經注析》关于《雄雉》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"033-xiong-zhi","materialId":"chengjunying-jiangjianyuan-zhuxi"},"href":"/shijing/annotation/033-xiong-zhi/chengjunying-jiangjianyuan-zhuxi","poem":{"id":"033-xiong-zhi","title":"雄雉","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","雄雉"],"segments":[{"id":"seg-001","text":"雄雉于飞","isActive":false},{"id":"seg-002","text":"泄泄其羽","isActive":false},{"id":"seg-003","text":"我之怀矣","isActive":false},{"id":"seg-004","text":"自诒伊阻","isActive":false},{"id":"seg-005","text":"雄雉于飞","isActive":false},{"id":"seg-006","text":"下上其音","isActive":false},{"id":"seg-007","text":"展矣君子","isActive":false},{"id":"seg-008","text":"实劳我心","isActive":false},{"id":"seg-009","text":"瞻彼日月","isActive":false},{"id":"seg-010","text":"悠悠我思","isActive":false},{"id":"seg-011","text":"道之云远","isActive":false},{"id":"seg-012","text":"曷云能来","isActive":false},{"id":"seg-013","text":"百尔君子","isActive":false},{"id":"seg-014","text":"不知德行","isActive":false},{"id":"seg-015","text":"不忮不求","isActive":false},{"id":"seg-016","text":"何用不臧","isActive":false}]},"material":{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","authors":["程俊英","蔣見元"],"contributorLine":"现代 · 程俊英、蔣見元","era":"现代","publicationYear":1991,"carrier":"PDF"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"题解","targetNotes":"题解总说。","sourceLabel":"第 65 页","sourceNotes":"书内页 65《题解》段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"程、蒋将《雄雉》解释为妇女思念久役丈夫之诗。题解虽提到方玉润曾改作朋友互勉之说，但认为前三章的思念语气和“钟惺评曰：百尔君子，非妇人语”之类并不足推翻旧解，末章不过是思妇对丈夫的规诫与祝愿。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"雄雉于飞，泄泄其羽。我之怀矣，自诒伊阻。","targetNotes":"首章。","sourceLabel":"第 65 页","sourceNotes":"书内页 65 首章注析。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"注析","text":"程、蒋释“泄泄”为飞貌舒缓自得，“伊”为是，“阻”为隔。首章借雄雉高飞自得起兴，反衬所怀之人远役在外，而其远离之苦又像是他自己求取功名所致。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"雄雉于飞，下上其音。展矣君子，实劳我心。","targetNotes":"第二章。","sourceLabel":"第 65-66 页","sourceNotes":"书内页 65-66 第二章注析。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"注析","text":"程、蒋释“下上其音”为鸣声往复，“展”为诚。此章由见雉闻声转入对所怀君子的诚念，点出“实劳我心”，将思念从景物兴发推进为直接抒情。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"瞻彼日月，悠悠我思。道之云远，曷云能来？","targetNotes":"第三章。","sourceLabel":"第 66 页","sourceNotes":"书内页 66 第三章注析。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"注析","text":"在程、蒋看来，第三章写得最为直露：望日月而知岁月空过，思念绵邈不绝；又因道路遥远而发“曷云能来”之叹，把久役难归的现实推到眼前。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"百尔君子，不知德行。不忮不求，何用不臧？","targetNotes":"第四章。","sourceLabel":"第 66 页","sourceNotes":"书内页 66 第四章注析。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"注析","text":"程、蒋将末章看作思妇对丈夫的劝勉与宽慰：只要不忮害、不贪求，自可保身全德，不必以仕进逐名。章末虽像议论，却正是前面忧思的反折。","notes":null}]}]}}}
