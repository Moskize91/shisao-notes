{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/071-ge-lei/quwanli-quanshi","dataHref":"/__data/shijing/annotation/071-ge-lei/quwanli-quanshi/data.json","title":"詩經詮釋 · 葛藟 · 注释总览","description":"風 · 王風 · 葛藟 · 汇集《詩經詮釋》关于《葛藟》的 1 条注释，含 1 条注脚。"},"payload":{"detail":{"route":{"poemId":"071-ge-lei","materialId":"quwanli-quanshi"},"href":"/shijing/annotation/071-ge-lei/quwanli-quanshi","poem":{"id":"071-ge-lei","title":"葛藟","categoryId":"feng","subcategoryId":"wangfeng","path":["風","王風","葛藟"],"segments":[{"id":"seg-001","text":"緜緜葛藟","isActive":true},{"id":"seg-002","text":"在河之滸","isActive":true},{"id":"seg-003","text":"終遠兄弟","isActive":true},{"id":"seg-004","text":"謂他人父","isActive":true},{"id":"seg-005","text":"謂他人父","isActive":true},{"id":"seg-006","text":"亦莫我顧","isActive":true},{"id":"seg-007","text":"緜緜葛藟","isActive":true},{"id":"seg-008","text":"在河之涘","isActive":true},{"id":"seg-009","text":"終遠兄弟","isActive":true},{"id":"seg-010","text":"謂他人母","isActive":true},{"id":"seg-011","text":"謂他人母","isActive":true},{"id":"seg-012","text":"亦莫我有","isActive":true},{"id":"seg-013","text":"緜緜葛藟","isActive":true},{"id":"seg-014","text":"在河之漘","isActive":true},{"id":"seg-015","text":"終遠兄弟","isActive":true},{"id":"seg-016","text":"謂他人昆","isActive":true},{"id":"seg-017","text":"謂他人昆","isActive":true},{"id":"seg-018","text":"亦莫我聞","isActive":true}]},"material":{"id":"quwanli-quanshi","title":"詩經詮釋","authors":["屈萬里"],"contributorLine":"现代 · 屈萬里","era":"现代","publicationYear":1983,"carrier":"PDF"},"stats":{"annotationCount":1,"glossCount":1},"annotations":[{"id":"0001","order":1,"total":1,"layer":"span","layerLabel":"诗句片段","targetText":"緜緜葛藟，在河之滸。終遠兄弟，謂他人父。謂他人父，亦莫我顧。緜緜葛藟，在河之涘。終遠兄弟，謂他人母。謂他人母，亦莫我有。緜緜葛藟，在河之漘。終遠兄弟，謂他人昆。謂他人昆，亦莫我聞。","targetNotes":"全篇注释。","sourceLabel":"第 87 页","sourceNotes":"据 /private/tmp/071-qu/p002.png（页眉 87）定位；下一页 /private/tmp/071-qu/p003.png 已转《采葛》。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"屈万里","sectionLabel":"注释","text":"屈万里释《葛藟》，以为流落异乡者感伤之诗。其指出“滸”“涘”“漘”皆水边之地，而“終”字每章连用，写远离兄弟之后，虽欲认他人为父母昆弟，终究仍不得其亲。","notes":null}]}]}}}
