{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/071-ge-lei/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/071-ge-lei/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 葛藟 · 注释总览","description":"風 · 王風 · 葛藟 · 汇集《诗经原始(上下)》关于《葛藟》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"071-ge-lei","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/071-ge-lei/fangyurun-yuanshi","poem":{"id":"071-ge-lei","title":"葛藟","categoryId":"feng","subcategoryId":"wangfeng","path":["風","王風","葛藟"],"segments":[{"id":"seg-001","text":"緜緜葛藟","isActive":false},{"id":"seg-002","text":"在河之滸","isActive":false},{"id":"seg-003","text":"終遠兄弟","isActive":false},{"id":"seg-004","text":"謂他人父","isActive":false},{"id":"seg-005","text":"謂他人父","isActive":false},{"id":"seg-006","text":"亦莫我顧","isActive":false},{"id":"seg-007","text":"緜緜葛藟","isActive":false},{"id":"seg-008","text":"在河之涘","isActive":false},{"id":"seg-009","text":"終遠兄弟","isActive":false},{"id":"seg-010","text":"謂他人母","isActive":false},{"id":"seg-011","text":"謂他人母","isActive":false},{"id":"seg-012","text":"亦莫我有","isActive":false},{"id":"seg-013","text":"緜緜葛藟","isActive":false},{"id":"seg-014","text":"在河之漘","isActive":false},{"id":"seg-015","text":"終遠兄弟","isActive":false},{"id":"seg-016","text":"謂他人昆","isActive":false},{"id":"seg-017","text":"謂他人昆","isActive":false},{"id":"seg-018","text":"亦莫我聞","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"葛藟㊟民窮無所依也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标题段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注","text":"方玉润题注直断《葛藟》为“民窮無所依”之诗，先从流离失所、举目无亲的处境定下全篇基调。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"总评","targetNotes":"通篇总评。","sourceLabel":null,"sourceNotes":"对应 EPUB item 总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"总评","text":"方玉润总评承《集传》“世衰民散，有去其鄉里家族而流離失所之作”之说，认为《葛藟》所写正是离乡失宗之民。其以葛藟本须附木，而今独在河滸、河涘、河漘，无高木可依，比兴流民远兄弟、托父母昆弟而终不得其亲，由此见世道人情之薄。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"眉評","targetNotes":"篇中眉评撮要。","sourceLabel":null,"sourceNotes":"对应 EPUB item 眉评内容。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"眉评","text":"方玉润眉评仅下一语，谓此诗“沉痛語，不忍卒讀”，直点其哀恸沉痛的情感强度。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"term","layerLabel":"字词注","targetText":"在河之滸在河之涘在河之漘","targetNotes":"集释撮要。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":"集释","text":"方玉润集释依次训“滸”“涘”“漘”：据《毛传》以“滸”为水厓，据孔疏引《释丘》以“涘”为厓，又引许谦说“漘”为岸上平夷而下为水所齧入若脣。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"標韻","targetNotes":"三章韵脚撮述。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标韵段。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"方玉润","sectionLabel":"标韵","text":"方玉润标出《葛藟》三章用韵：首章“滸、父、顧”叶韵，次章“涘、母、有”叶韵，末章“漘、昆、聞”通韵。其标韵显示三章各以河岸词与亲属词相配，而末句“不顾”“不有”“不闻”逐层转深。","notes":null}]}]}}}
