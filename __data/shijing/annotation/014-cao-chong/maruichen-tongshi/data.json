{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/014-cao-chong/maruichen-tongshi","dataHref":"/__data/shijing/annotation/014-cao-chong/maruichen-tongshi/data.json","title":"毛詩傳箋通釋 · 草蟲 · 注释总览","description":"風 · 召南 · 草蟲 · 汇集《毛詩傳箋通釋》关于《草蟲》的 2 条注释，含 2 条注脚。"},"payload":{"detail":{"route":{"poemId":"014-cao-chong","materialId":"maruichen-tongshi"},"href":"/shijing/annotation/014-cao-chong/maruichen-tongshi","poem":{"id":"014-cao-chong","title":"草蟲","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","草蟲"],"segments":[{"id":"seg-001","text":"喓喓草蟲","isActive":true},{"id":"seg-002","text":"趯趯阜螽","isActive":true},{"id":"seg-003","text":"未見君子","isActive":true},{"id":"seg-004","text":"憂心忡忡","isActive":true},{"id":"seg-005","text":"亦既見止","isActive":false},{"id":"seg-006","text":"亦既覯止","isActive":false},{"id":"seg-007","text":"我心則降","isActive":false},{"id":"seg-008","text":"陟彼南山","isActive":false},{"id":"seg-009","text":"言采其蕨","isActive":false},{"id":"seg-010","text":"未見君子","isActive":false},{"id":"seg-011","text":"憂心惙惙","isActive":false},{"id":"seg-012","text":"亦既見止","isActive":false},{"id":"seg-013","text":"亦既覯止","isActive":false},{"id":"seg-014","text":"我心則說","isActive":false},{"id":"seg-015","text":"陟彼南山","isActive":false},{"id":"seg-016","text":"言采其薇","isActive":false},{"id":"seg-017","text":"未見君子","isActive":false},{"id":"seg-018","text":"我心傷悲","isActive":false},{"id":"seg-019","text":"亦既見止","isActive":false},{"id":"seg-020","text":"亦既覯止","isActive":false},{"id":"seg-021","text":"我心則夷","isActive":false}]},"material":{"id":"maruichen-tongshi","title":"毛詩傳箋通釋","authors":["馬瑞辰"],"contributorLine":"清 · 馬瑞辰","era":"清","publicationYear":1989,"carrier":"PDF"},"stats":{"annotationCount":2,"glossCount":2},"annotations":[{"id":"0001","order":1,"total":2,"layer":"span","layerLabel":"诗句片段","targetText":"喓喓草蟲，趯趯阜螽。未見君子，憂心忡忡。","targetNotes":"首章名物与情状。","sourceLabel":"第 99-100 页","sourceNotes":"依据 /tmp/maruichen-title-scan/p099.png 右半与 /tmp/maruichen-title-scan/p100.png 右半中草蟲、負蠜、喓喓、忡忡诸条。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"马瑞辰","sectionLabel":"按","text":"瑞辰先据《草木疏》辨“草蟲”一名“負蠜”，谓其大小如蝗，青色，好在茅草中；并斥旧以“蟲”为“蠶”之假借不合。又谓诗称“喓喓”，正取其善鸣；“忡忡”则是动心之貌，引《楚辞·九歌》“极劳心兮忡忡”为证，以见未见君子时忧思内迫。","notes":null}]},{"id":"0002","order":2,"total":2,"layer":"span","layerLabel":"诗句片段","targetText":"亦既見止，亦既覯止，我心則降。亦既見止，亦既覯止，我心則說。","targetNotes":"首章与第二章复沓句中的情意转折。","sourceLabel":"第 100 页","sourceNotes":"依据 /tmp/maruichen-title-scan/p100.png 中“牟服”“悦服”“作降”等释义段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"马瑞辰","sectionLabel":"按","text":"瑞辰据《说文》“说，牟服也”以及旧注“说，悦也”“悦服也”，指出既见既覯之后的情意是由忧转释、由悬念转为心服安定。因此首章“我心则降”与第二章“我心则说”实相贯通，都是写见君子后内心顿然宽解。","notes":null}]}]}}}
