{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/014-cao-chong/chenhuan-chuanshu","dataHref":"/__data/shijing/annotation/014-cao-chong/chenhuan-chuanshu/data.json","title":"詩毛氏傳疏 · 草蟲 · 注释总览","description":"風 · 召南 · 草蟲 · 汇集《詩毛氏傳疏》关于《草蟲》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"014-cao-chong","materialId":"chenhuan-chuanshu"},"href":"/shijing/annotation/014-cao-chong/chenhuan-chuanshu","poem":{"id":"014-cao-chong","title":"草蟲","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","草蟲"],"segments":[{"id":"seg-001","text":"喓喓草蟲","isActive":false},{"id":"seg-002","text":"趯趯阜螽","isActive":false},{"id":"seg-003","text":"未見君子","isActive":false},{"id":"seg-004","text":"憂心忡忡","isActive":false},{"id":"seg-005","text":"亦旣見止","isActive":false},{"id":"seg-006","text":"亦旣覯止","isActive":false},{"id":"seg-007","text":"我心則降","isActive":false},{"id":"seg-008","text":"陟彼南山","isActive":false},{"id":"seg-009","text":"言采其蕨","isActive":false},{"id":"seg-010","text":"未見君子","isActive":false},{"id":"seg-011","text":"憂心惙惙","isActive":false},{"id":"seg-012","text":"亦旣見止","isActive":false},{"id":"seg-013","text":"亦旣覯止","isActive":false},{"id":"seg-014","text":"我心則說","isActive":false},{"id":"seg-015","text":"陟彼南山","isActive":false},{"id":"seg-016","text":"言采其薇","isActive":false},{"id":"seg-017","text":"未見君子","isActive":false},{"id":"seg-018","text":"我心傷悲","isActive":false},{"id":"seg-019","text":"亦旣見止","isActive":false},{"id":"seg-020","text":"亦旣覯止","isActive":false},{"id":"seg-021","text":"我心則夷","isActive":false}]},"material":{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","authors":["陳奐"],"contributorLine":"清 · 陳奐","era":"清","publicationYear":1847,"carrier":"PDF"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"preface","layerLabel":"篇序","targetText":"草蟲，大夫妻能以禮自防也。","targetNotes":"篇首序文。","sourceLabel":"第 41 页","sourceNotes":"据第 41 页右侧《草蟲》篇首序义。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"疏承《序》以《草蟲》为大夫妻能以礼自防之诗，认为其旨不在泛写思妇哀怨，而在说明卿大夫妻待礼而行、随从君子，虽怀思不安而终不逾礼。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"喓喓草蟲，趯趯阜螽。未見君子，憂心忡忡。亦旣見止，亦旣覯止，我心則降。","targetNotes":"首章与疏义。","sourceLabel":"第 41 页","sourceNotes":"据第 41 页《草蟲》首章疏义提要。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"疏以阜螽之随草蟲起兴，认为正用以比大夫妻随从君子而行；“未见君子”以下则为明言其中心所苦，既写未见时忧心忡忡，又以“既见既覯，我心则降”反衬其思念之深而仍不失礼防。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"陟彼南山，言采其蕨。未見君子，憂心惙惙。亦旣見止，亦旣覯止，我心則說。陟彼南山，言采其薇。未見君子，我心傷悲。亦旣見止，亦旣覯止，我心則夷。","targetNotes":"后二章与疏义。","sourceLabel":"第 41-42 页","sourceNotes":"据第 41 页下半至第 42 页右半《草蟲》后二章疏义提要。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"疏将二、三章视为顺首章递进：由南山采蕨、采薇见时物迁改，故“惙惙”“傷悲”较“忡忡”更深一层；而“見止”“覯止”“說”“夷”皆是未見时反设得見之后心绪平释之辞，所以全篇虽反复申写思君，终归于礼意自守。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"草蟲三章章七句","targetNotes":"章句总说。","sourceLabel":"第 42 页","sourceNotes":"据第 42 页右半章句总说。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"疏以“三章章七句”总束全篇，认为首章因物起兴而点明怀思，后二章因采蕨采薇层层加深，写法递进而义旨一贯，皆所以发明《序》所谓“大夫妻能以礼自防”。","notes":null}]}]}}}
