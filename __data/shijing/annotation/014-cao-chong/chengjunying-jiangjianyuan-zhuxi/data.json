{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/014-cao-chong/chengjunying-jiangjianyuan-zhuxi","dataHref":"/__data/shijing/annotation/014-cao-chong/chengjunying-jiangjianyuan-zhuxi/data.json","title":"詩經注析 · 草蟲 · 注释总览","description":"風 · 召南 · 草蟲 · 汇集《詩經注析》关于《草蟲》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"014-cao-chong","materialId":"chengjunying-jiangjianyuan-zhuxi"},"href":"/shijing/annotation/014-cao-chong/chengjunying-jiangjianyuan-zhuxi","poem":{"id":"014-cao-chong","title":"草蟲","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","草蟲"],"segments":[{"id":"seg-001","text":"喓喓草虫","isActive":false},{"id":"seg-002","text":"趯趯阜螽","isActive":false},{"id":"seg-003","text":"未见君子","isActive":false},{"id":"seg-004","text":"忧心忡忡","isActive":false},{"id":"seg-005","text":"亦既见止","isActive":false},{"id":"seg-006","text":"亦既觏止","isActive":false},{"id":"seg-007","text":"我心则降","isActive":false},{"id":"seg-008","text":"陟彼南山","isActive":false},{"id":"seg-009","text":"言采其蕨","isActive":false},{"id":"seg-010","text":"未见君子","isActive":false},{"id":"seg-011","text":"忧心惙惙","isActive":false},{"id":"seg-012","text":"亦既见止","isActive":false},{"id":"seg-013","text":"亦既觏止","isActive":false},{"id":"seg-014","text":"我心则说","isActive":false},{"id":"seg-015","text":"陟彼南山","isActive":false},{"id":"seg-016","text":"言采其薇","isActive":false},{"id":"seg-017","text":"未见君子","isActive":false},{"id":"seg-018","text":"我心伤悲","isActive":false},{"id":"seg-019","text":"亦既见止","isActive":false},{"id":"seg-020","text":"亦既觏止","isActive":false},{"id":"seg-021","text":"我心则夷","isActive":false}]},"material":{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","authors":["程俊英","蔣見元"],"contributorLine":"现代 · 程俊英、蔣見元","era":"现代","publicationYear":1991,"carrier":"PDF"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"题解","targetNotes":"题解总说。","sourceLabel":"第 26 页","sourceNotes":"书内页 26《草虫》题解。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"题解将此篇视为思妇怀念行役丈夫之诗，认为三章从秋虫、采蕨到采薇，借时物迁变层层加深别离之苦；又指出每章“既见”“既觏”都是想象之辞，通过今昔对照与乐景反衬来强化“未见君子”时的忧伤，并以春秋景物变换见其思念之久。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"喓喓草虫，趯趯阜螽。未见君子，忧心忡忡。亦既见止，亦既觏止，我心则降。","targetNotes":"首章。","sourceLabel":"第 27 页","sourceNotes":"书内页 27 首章与注释。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"注释以“喓喓”为虫鸣声、“草虫”即草螽、“趯趯”为跳跃貌、“阜螽”为幼蝗，并释“忡忡”为心神摇荡；又据《经传释词》等说说明“亦”为“若”、“止”为语尾词、“觏”为遇、“降”为放心，由此见首章一面写秋虫相从触发思念，一面以想象得见来反照现实愁苦。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"陟彼南山，言采其蕨。未见君子，忧心惙惙。亦既见止，亦既觏止，我心则说。","targetNotes":"第二章。","sourceLabel":"第 27 页","sourceNotes":"书内页 27 第二章与注释。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"此章释“陟”为登，“蕨”为山菜，又引唐释玄应语释“惙惙”为忧气貌；并指出本章声调转入祭部与宵部，承上章而情绪更急，仍以“既见既觏，我心则说”的假想安慰自己。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"陟彼南山，言采其薇。未见君子，我心伤悲。亦既见止，亦既觏止，我心则夷。","targetNotes":"第三章。","sourceLabel":"第 27 页","sourceNotes":"书内页 27 第三章与注释。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"末章释“薇”为野豌豆苗，又释“夷”为平易，指出这里专写心安平静；全章由“伤悲”推进到“则夷”，仍是借设想重逢后情绪平复来反衬当前未见之痛，从而完成三章递深的结构。","notes":null}]}]}}}
