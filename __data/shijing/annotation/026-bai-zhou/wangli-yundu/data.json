{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/026-bai-zhou/wangli-yundu","dataHref":"/__data/shijing/annotation/026-bai-zhou/wangli-yundu/data.json","title":"詩經韻讀 · 柏舟 · 注释总览","description":"風 · 邶風 · 柏舟 · 汇集《詩經韻讀》关于《柏舟》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"026-bai-zhou","materialId":"wangli-yundu"},"href":"/shijing/annotation/026-bai-zhou/wangli-yundu","poem":{"id":"026-bai-zhou","title":"柏舟","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","柏舟"],"segments":[{"id":"seg-001","text":"汎彼柏舟","isActive":true},{"id":"seg-002","text":"亦汎其流","isActive":true},{"id":"seg-003","text":"耿耿不寐","isActive":true},{"id":"seg-004","text":"如有隱憂","isActive":true},{"id":"seg-005","text":"微我無酒","isActive":true},{"id":"seg-006","text":"以敖以遊","isActive":true},{"id":"seg-007","text":"我心匪鑒","isActive":false},{"id":"seg-008","text":"不可以茹","isActive":false},{"id":"seg-009","text":"亦有兄弟","isActive":false},{"id":"seg-010","text":"不可以據","isActive":false},{"id":"seg-011","text":"薄言往愬","isActive":false},{"id":"seg-012","text":"逢彼之怒","isActive":false},{"id":"seg-013","text":"我心匪石","isActive":false},{"id":"seg-014","text":"不可轉也","isActive":false},{"id":"seg-015","text":"我心匪席","isActive":false},{"id":"seg-016","text":"不可卷也","isActive":false},{"id":"seg-017","text":"威儀棣棣","isActive":false},{"id":"seg-018","text":"不可選也","isActive":false},{"id":"seg-019","text":"憂心悄悄","isActive":false},{"id":"seg-020","text":"慍于群小","isActive":false},{"id":"seg-021","text":"覯閔既多","isActive":false},{"id":"seg-022","text":"受侮不少","isActive":false},{"id":"seg-023","text":"靜言思之","isActive":false},{"id":"seg-024","text":"寤辟有摽","isActive":false},{"id":"seg-025","text":"日居月諸","isActive":false},{"id":"seg-026","text":"胡迭而微","isActive":false},{"id":"seg-027","text":"心之憂矣","isActive":false},{"id":"seg-028","text":"如匪澣衣","isActive":false},{"id":"seg-029","text":"靜言思之","isActive":false},{"id":"seg-030","text":"不能奮飛","isActive":false}]},"material":{"id":"wangli-yundu","title":"詩經韻讀","authors":["王力"],"contributorLine":"现代 · 王力","era":"现代","publicationYear":1980,"carrier":"PDF"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"汎彼柏舟，亦汎其流。耿耿不寐，如有隱憂。微我無酒，以敖以遊。","targetNotes":"首章。","sourceLabel":"第 150 页局部","sourceNotes":"第 150 页《柏舟》首章。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"王力","sectionLabel":"韵读"}]},{"id":"0002","order":2,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"我心匪鑒，不可以茹。亦有兄弟，不可以據。薄言往愬，逢彼之怒。","targetNotes":"第二章。","sourceLabel":"第 150 页局部","sourceNotes":"第 150 页《柏舟》第二章。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"王力","sectionLabel":"韵读"}]},{"id":"0003","order":3,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"我心匪石，不可轉也。我心匪席，不可卷也。威儀棣棣，不可選也。","targetNotes":"第三章。","sourceLabel":"第 150 页局部","sourceNotes":"第 150 页《柏舟》第三章。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"王力","sectionLabel":"韵读"}]},{"id":"0004","order":4,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"憂心悄悄，慍于群小。覯閔既多，受侮不少。靜言思之，寤辟有摽。","targetNotes":"第四章。","sourceLabel":"第 150 页局部","sourceNotes":"第 150 页《柏舟》第四章。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"王力","sectionLabel":"韵读"}]},{"id":"0005","order":5,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"日居月諸，胡迭而微？心之憂矣，如匪澣衣。靜言思之，不能奮飛。","targetNotes":"第五章。","sourceLabel":"第 150 页局部","sourceNotes":"第 150 页《柏舟》第五章。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"王力","sectionLabel":"韵读"}]}]}}}
