{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/026-bai-zhou/chenhuan-chuanshu","dataHref":"/__data/shijing/annotation/026-bai-zhou/chenhuan-chuanshu/data.json","title":"詩毛氏傳疏 · 柏舟 · 注释总览","description":"風 · 邶風 · 柏舟 · 汇集《詩毛氏傳疏》关于《柏舟》的 2 条注释，含 2 条注脚。"},"payload":{"detail":{"route":{"poemId":"026-bai-zhou","materialId":"chenhuan-chuanshu"},"href":"/shijing/annotation/026-bai-zhou/chenhuan-chuanshu","poem":{"id":"026-bai-zhou","title":"柏舟","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","柏舟"],"segments":[{"id":"seg-001","text":"汎彼柏舟","isActive":false},{"id":"seg-002","text":"亦汎其流","isActive":false},{"id":"seg-003","text":"耿耿不寐","isActive":false},{"id":"seg-004","text":"如有隱憂","isActive":false},{"id":"seg-005","text":"微我無酒","isActive":false},{"id":"seg-006","text":"以遨以遊","isActive":false},{"id":"seg-007","text":"我心匪鑒","isActive":false},{"id":"seg-008","text":"不可以茹","isActive":false},{"id":"seg-009","text":"亦有兄弟","isActive":false},{"id":"seg-010","text":"不可以據","isActive":false},{"id":"seg-011","text":"薄言往愬","isActive":false},{"id":"seg-012","text":"逢彼之怒","isActive":false},{"id":"seg-013","text":"我心匪石","isActive":false},{"id":"seg-014","text":"不可轉也","isActive":false},{"id":"seg-015","text":"我心匪席","isActive":false},{"id":"seg-016","text":"不可卷也","isActive":false},{"id":"seg-017","text":"威儀棣棣","isActive":false},{"id":"seg-018","text":"不可選也","isActive":false},{"id":"seg-019","text":"憂心悄悄","isActive":false},{"id":"seg-020","text":"慍于群小","isActive":false},{"id":"seg-021","text":"覯閔既多","isActive":false},{"id":"seg-022","text":"受侮不少","isActive":false},{"id":"seg-023","text":"靜言思之","isActive":false},{"id":"seg-024","text":"寤辟有摽","isActive":false},{"id":"seg-025","text":"日居月諸","isActive":false},{"id":"seg-026","text":"胡迭而微","isActive":false},{"id":"seg-027","text":"心之憂矣","isActive":false},{"id":"seg-028","text":"如匪澣衣","isActive":false},{"id":"seg-029","text":"靜言思之","isActive":false},{"id":"seg-030","text":"不能奮飛","isActive":false}]},"material":{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","authors":["陳奐"],"contributorLine":"清 · 陳奐","era":"清","publicationYear":1847,"carrier":"PDF"},"stats":{"annotationCount":2,"glossCount":2},"annotations":[{"id":"0001","order":1,"total":2,"layer":"preface","layerLabel":"篇序","targetText":"柏舟言仁而不遇也衛頃公之時仁人不遇小人在側","targetNotes":"篇首小序。","sourceLabel":"第 49 页","sourceNotes":"书内页 49 篇首序文。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序","text":"序：《柏舟》，言仁而不遇也。衛頃公之時，仁人不遇，小人在側。","notes":null}]},{"id":"0002","order":2,"total":2,"layer":"span","layerLabel":"诗句片段","targetText":"汎彼柏舟，亦汎其流。耿耿不寐，如有隱憂。微我無酒，以遨以遊。我心匪鑒，不可以茹。亦有兄弟，不可以據。薄言往愬，逢彼之怒。我心匪石，不可轉也。我心匪席，不可卷也。威儀棣棣，不可選也。憂心悄悄，慍于群小。覯閔既多，受侮不少。靜言思之，寤辟有摽。日居月諸，胡迭而微？心之憂矣，如匪澣衣。靜言思之，不能奮飛。","targetNotes":"通篇经传疏解。","sourceLabel":"第 49-50 页","sourceNotes":"据第 49-50 页《柏舟》经传疏。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"陈奂遵《序》旧说，把《柏舟》解释为仁臣当衛頃公之世而遭谗不遇之辞。其疏先以柏木坚致、舟流中河比贤者操守孤立，继而将“兄弟不可据”“逢彼之怒”“愠于群小”诸句都读作小人在侧、谗毁交集；末章则归到君恩乍微、贤者欲去不得的感慨，整体仍属臣子忧乱自伤之作。","notes":null}]}]}}}
