{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/026-bai-zhou/zhuxi-shijichuan-kr1c0009","dataHref":"/__data/shijing/annotation/026-bai-zhou/zhuxi-shijichuan-kr1c0009/data.json","title":"詩集傳 · 柏舟 · 注释总览","description":"風 · 邶風 · 柏舟 · 汇集《詩集傳》关于《柏舟》的 6 条注释，含 6 条注脚。"},"payload":{"detail":{"route":{"poemId":"026-bai-zhou","materialId":"zhuxi-shijichuan-kr1c0009"},"href":"/shijing/annotation/026-bai-zhou/zhuxi-shijichuan-kr1c0009","poem":{"id":"026-bai-zhou","title":"柏舟","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","柏舟"],"segments":[{"id":"seg-001","text":"汎彼柏舟","isActive":true},{"id":"seg-002","text":"亦汎其流","isActive":true},{"id":"seg-003","text":"耿耿不寐","isActive":true},{"id":"seg-004","text":"如有隱憂","isActive":true},{"id":"seg-005","text":"微我無酒","isActive":true},{"id":"seg-006","text":"以遨以遊","isActive":true},{"id":"seg-007","text":"我心匪鑒","isActive":false},{"id":"seg-008","text":"不可以茹","isActive":false},{"id":"seg-009","text":"亦有兄弟","isActive":false},{"id":"seg-010","text":"不可以據","isActive":false},{"id":"seg-011","text":"薄言往愬","isActive":false},{"id":"seg-012","text":"逢彼之怒","isActive":false},{"id":"seg-013","text":"我心匪石","isActive":false},{"id":"seg-014","text":"不可轉也","isActive":false},{"id":"seg-015","text":"我心匪席","isActive":false},{"id":"seg-016","text":"不可卷也","isActive":false},{"id":"seg-017","text":"威儀棣棣","isActive":false},{"id":"seg-018","text":"不可選也","isActive":false},{"id":"seg-019","text":"憂心悄悄","isActive":false},{"id":"seg-020","text":"慍于群小","isActive":false},{"id":"seg-021","text":"覯閔既多","isActive":false},{"id":"seg-022","text":"受侮不少","isActive":false},{"id":"seg-023","text":"靜言思之","isActive":false},{"id":"seg-024","text":"寤辟有摽","isActive":false},{"id":"seg-025","text":"日居月諸","isActive":false},{"id":"seg-026","text":"胡迭而微","isActive":false},{"id":"seg-027","text":"心之憂矣","isActive":false},{"id":"seg-028","text":"如匪澣衣","isActive":false},{"id":"seg-029","text":"靜言思之","isActive":false},{"id":"seg-030","text":"不能奮飛","isActive":false}]},"material":{"id":"zhuxi-shijichuan-kr1c0009","title":"詩集傳","authors":["朱熹"],"contributorLine":"宋 · 朱熹","era":"宋","publicationYear":1186,"carrier":"TXT"},"stats":{"annotationCount":6,"glossCount":6},"annotations":[{"id":"0001","order":1,"total":6,"layer":"span","layerLabel":"诗句片段","targetText":"汎彼柏舟，亦汎其流。耿耿不寐，如有隱憂。微我無酒，以遨以遊。","targetNotes":"首章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》柏舟首章。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"朱熹","sectionLabel":null,"text":"興也。朱熹以《柏舟》为妇人不得于其夫之诗，故以柏舟自比其操守。首章言舟在流中而无所依，正如其人耿耿不寐、忧不可解；“微我無酒，以遨以遊”则是说此忧非饮酒游乐所能释。","notes":null}]},{"id":"0002","order":2,"total":6,"layer":"span","layerLabel":"诗句片段","targetText":"我心匪鑒，不可以茹。亦有兄弟，不可以據。薄言往愬，逢彼之怒。","targetNotes":"第二章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》柏舟第二章。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"朱熹","sectionLabel":null,"text":"賦也。鑒虽明而妍媸并见，我心则不能如镜之兼容；據是依靠，愬是诉告。朱熹以为此章写其虽有兄弟而不可信据，勉强往诉反遭其怒，故更见闺中孤苦。","notes":null}]},{"id":"0003","order":3,"total":6,"layer":"span","layerLabel":"诗句片段","targetText":"我心匪石，不可轉也。我心匪席，不可卷也。威儀棣棣，不可選也。","targetNotes":"第三章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》柏舟第三章。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"朱熹","sectionLabel":null,"text":"賦也。石可转而我心不可移，席可卷而我心不可屈；棣棣谓富而闲习，选训数。朱熹认为此章正写其志操端严、威仪整饬，不因失意而改节。","notes":null}]},{"id":"0004","order":4,"total":6,"layer":"span","layerLabel":"诗句片段","targetText":"憂心悄悄，慍于群小。覯閔既多，受侮不少。靜言思之，寤辟有摽。","targetNotes":"第四章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》柏舟第四章。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"朱熹","sectionLabel":null,"text":"賦也。悄悄为忧貌，慍含怒意，覯为见，閔为病，寤辟有摽则是醒来拊心而悸。朱熹以此章写其既为群小所陵，又屡遭忧患侮辱，故静夜思之而惊心自击。","notes":null}]},{"id":"0005","order":5,"total":6,"layer":"span","layerLabel":"诗句片段","targetText":"日居月諸，胡迭而微？心之憂矣，如匪澣衣。靜言思之，不能奮飛。","targetNotes":"第五章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》柏舟第五章。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"朱熹","sectionLabel":null,"text":"賦也。朱熹以“日居月諸，胡迭而微”比夫恩之不常，如日月本当递明而忽微；“如匪澣衣”则言忧垢著身，洗之不去；终曰“不能奮飛”，写其欲去而不得去。","notes":null}]},{"id":"0006","order":6,"total":6,"layer":"global","layerLabel":"全篇总说","targetText":"柏舟五章章六句","targetNotes":"章句总说。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》柏舟章句总说。","notes":null,"glosses":[{"key":"0006-1","attributionLabel":"朱熹","sectionLabel":null,"text":"朱熹记《柏舟》为五章、章六句，并将其明确归入妇人不得于夫之作，所以通篇比兴、赋辞都围绕失宠自伤与守志不改展开。","notes":null}]}]}}}
