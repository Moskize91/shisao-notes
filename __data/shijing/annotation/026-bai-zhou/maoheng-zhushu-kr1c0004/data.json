{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/026-bai-zhou/maoheng-zhushu-kr1c0004","dataHref":"/__data/shijing/annotation/026-bai-zhou/maoheng-zhushu-kr1c0004/data.json","title":"毛詩注疏 · 柏舟 · 注释总览","description":"風 · 邶風 · 柏舟 · 汇集《毛詩注疏》关于《柏舟》的 6 条注释，含 6 条注脚。"},"payload":{"detail":{"route":{"poemId":"026-bai-zhou","materialId":"maoheng-zhushu-kr1c0004"},"href":"/shijing/annotation/026-bai-zhou/maoheng-zhushu-kr1c0004","poem":{"id":"026-bai-zhou","title":"柏舟","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","柏舟"],"segments":[{"id":"seg-001","text":"汎彼柏舟","isActive":false},{"id":"seg-002","text":"亦汎其流","isActive":false},{"id":"seg-003","text":"耿耿不寐","isActive":false},{"id":"seg-004","text":"如有隱憂","isActive":false},{"id":"seg-005","text":"微我無酒","isActive":false},{"id":"seg-006","text":"以遨以遊","isActive":false},{"id":"seg-007","text":"我心匪鑒","isActive":false},{"id":"seg-008","text":"不可以茹","isActive":false},{"id":"seg-009","text":"亦有兄弟","isActive":false},{"id":"seg-010","text":"不可以據","isActive":false},{"id":"seg-011","text":"薄言往愬","isActive":false},{"id":"seg-012","text":"逢彼之怒","isActive":false},{"id":"seg-013","text":"我心匪石","isActive":false},{"id":"seg-014","text":"不可轉也","isActive":false},{"id":"seg-015","text":"我心匪席","isActive":false},{"id":"seg-016","text":"不可卷也","isActive":false},{"id":"seg-017","text":"威儀棣棣","isActive":false},{"id":"seg-018","text":"不可選也","isActive":false},{"id":"seg-019","text":"憂心悄悄","isActive":false},{"id":"seg-020","text":"慍于群小","isActive":false},{"id":"seg-021","text":"覯閔既多","isActive":false},{"id":"seg-022","text":"受侮不少","isActive":false},{"id":"seg-023","text":"靜言思之","isActive":false},{"id":"seg-024","text":"寤辟有摽","isActive":false},{"id":"seg-025","text":"日居月諸","isActive":false},{"id":"seg-026","text":"胡迭而微","isActive":false},{"id":"seg-027","text":"心之憂矣","isActive":false},{"id":"seg-028","text":"如匪澣衣","isActive":false},{"id":"seg-029","text":"靜言思之","isActive":false},{"id":"seg-030","text":"不能奮飛","isActive":false}]},"material":{"id":"maoheng-zhushu-kr1c0004","title":"毛詩注疏","authors":["毛亨","鄭氏","孔穎達"],"contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","era":"漢唐","publicationYear":653,"carrier":"TXT"},"stats":{"annotationCount":6,"glossCount":6},"annotations":[{"id":"0001","order":1,"total":6,"layer":"preface","layerLabel":"篇序","targetText":"柏舟言仁而不遇也衛頃公之時仁人不遇小人在側","targetNotes":"篇首小序。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》柏舟序文。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序","text":"序：《柏舟》，言仁而不遇也。衛頃公之時，仁人不遇，小人在側。","notes":null}]},{"id":"0002","order":2,"total":6,"layer":"span","layerLabel":"诗句片段","targetText":"汎彼柏舟亦汎其流耿耿不寐如有隱憂微我無酒以遨以遊","targetNotes":"首章。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》首章。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：興也。汎，流貌。柏木宜為舟，故取以為喻。耿耿，猶儆儆也；隱，痛也。微，非也，言非我無酒可以遨遊忘憂也。","notes":null}]},{"id":"0003","order":3,"total":6,"layer":"span","layerLabel":"诗句片段","targetText":"我心匪鑒不可以茹亦有兄弟不可以據薄言往愬逢彼之怒","targetNotes":"第二章。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》第二章。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：鑒，所以察形也。茹，度也。據，依也。薄，辭也。愬，告也。","notes":null}]},{"id":"0004","order":4,"total":6,"layer":"span","layerLabel":"诗句片段","targetText":"我心匪石不可轉也我心匪席不可卷也威儀棣棣不可選也","targetNotes":"第三章。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》第三章。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：石雖堅，尚可轉；席雖平，尚可卷。威儀棣棣，富而閑也。選，數也。","notes":null}]},{"id":"0005","order":5,"total":6,"layer":"span","layerLabel":"诗句片段","targetText":"憂心悄悄慍于群小覯閔既多受侮不少靜言思之寤辟有摽","targetNotes":"第四章。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》第四章。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：悄悄，憂貌。慍，怒也。覯，見也。閔，病也。辟，拊心也。摽，拊心貌。","notes":null}]},{"id":"0006","order":6,"total":6,"layer":"span","layerLabel":"诗句片段","targetText":"日居月諸胡迭而微心之憂矣如匪澣衣靜言思之不能奮飛","targetNotes":"第五章。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》第五章。","notes":null,"glosses":[{"key":"0006-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：日乎月乎，常迭而明者，胡為迭而微滅乎。不能奮飛，不得去也。","notes":null}]}]}}}
