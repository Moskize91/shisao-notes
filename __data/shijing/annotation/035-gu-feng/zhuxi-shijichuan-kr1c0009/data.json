{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/035-gu-feng/zhuxi-shijichuan-kr1c0009","dataHref":"/__data/shijing/annotation/035-gu-feng/zhuxi-shijichuan-kr1c0009/data.json","title":"詩集傳 · 谷風 · 注释总览","description":"風 · 邶風 · 谷風 · 汇集《詩集傳》关于《谷風》的 7 条注释，含 7 条注脚。"},"payload":{"detail":{"route":{"poemId":"035-gu-feng","materialId":"zhuxi-shijichuan-kr1c0009"},"href":"/shijing/annotation/035-gu-feng/zhuxi-shijichuan-kr1c0009","poem":{"id":"035-gu-feng","title":"谷風","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","谷風"],"segments":[{"id":"seg-001","text":"習習谷風","isActive":true},{"id":"seg-002","text":"以陰以雨","isActive":true},{"id":"seg-003","text":"黽勉同心","isActive":true},{"id":"seg-004","text":"不宜有怒","isActive":true},{"id":"seg-005","text":"采葑采菲","isActive":true},{"id":"seg-006","text":"無以下體","isActive":true},{"id":"seg-007","text":"德音莫違","isActive":true},{"id":"seg-008","text":"及爾同死","isActive":true},{"id":"seg-009","text":"行道遲遲","isActive":false},{"id":"seg-010","text":"中心有違","isActive":false},{"id":"seg-011","text":"不遠伊邇","isActive":false},{"id":"seg-012","text":"薄送我畿","isActive":false},{"id":"seg-013","text":"誰謂荼苦","isActive":false},{"id":"seg-014","text":"其甘如薺","isActive":false},{"id":"seg-015","text":"宴爾新昏","isActive":false},{"id":"seg-016","text":"如兄如弟","isActive":false},{"id":"seg-017","text":"涇以渭濁","isActive":false},{"id":"seg-018","text":"湜湜其沚","isActive":false},{"id":"seg-019","text":"宴爾新昏","isActive":false},{"id":"seg-020","text":"不我屑以","isActive":false},{"id":"seg-021","text":"毋逝我梁","isActive":false},{"id":"seg-022","text":"毋發我笱","isActive":false},{"id":"seg-023","text":"我躬不閲","isActive":false},{"id":"seg-024","text":"遑恤我後","isActive":false},{"id":"seg-025","text":"就其深矣","isActive":false},{"id":"seg-026","text":"方之舟之","isActive":false},{"id":"seg-027","text":"就其淺矣","isActive":false},{"id":"seg-028","text":"泳之游之","isActive":false},{"id":"seg-029","text":"何有何亡","isActive":false},{"id":"seg-030","text":"黽勉求之","isActive":false},{"id":"seg-031","text":"凡民有喪","isActive":false},{"id":"seg-032","text":"匍匐救之","isActive":false},{"id":"seg-033","text":"不我能慉","isActive":false},{"id":"seg-034","text":"反以我爲讎","isActive":false},{"id":"seg-035","text":"既阻我德","isActive":false},{"id":"seg-036","text":"賈用不售","isActive":false},{"id":"seg-037","text":"昔育恐育鞫","isActive":false},{"id":"seg-038","text":"及爾顛覆","isActive":false},{"id":"seg-039","text":"既生既育","isActive":false},{"id":"seg-040","text":"比予于毒","isActive":false},{"id":"seg-041","text":"我有旨蓄","isActive":false},{"id":"seg-042","text":"亦以御冬","isActive":false},{"id":"seg-043","text":"宴爾新昏","isActive":false},{"id":"seg-044","text":"以我御窮","isActive":false},{"id":"seg-045","text":"有洸有潰","isActive":false},{"id":"seg-046","text":"既詒我肄","isActive":false},{"id":"seg-047","text":"不念昔者","isActive":false},{"id":"seg-048","text":"伊余來塈","isActive":false}]},"material":{"id":"zhuxi-shijichuan-kr1c0009","title":"詩集傳","authors":["朱熹"],"contributorLine":"宋 · 朱熹","era":"宋","publicationYear":1186,"carrier":"TXT"},"stats":{"annotationCount":7,"glossCount":7},"annotations":[{"id":"0001","order":1,"total":7,"layer":"span","layerLabel":"诗句片段","targetText":"習習谷風，以陰以雨。黽勉同心，不宜有怒。采葑采菲，無以下體。德音莫違，及爾同死。","targetNotes":"第1章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》第1章。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"朱熹","sectionLabel":"集传","text":"朱熹释首章云此诗为妇人为夫所弃而作。以习习谷风、阴雨兴夫心变异，以采葑采菲无以下体比夫弃德取色，而“德音莫违，及尔同死”则追述昔日誓辞。","notes":null}]},{"id":"0002","order":2,"total":7,"layer":"span","layerLabel":"诗句片段","targetText":"行道遲遲，中心有違。不遠伊邇，薄送我畿。誰謂荼苦，其甘如薺。宴爾新昏，如兄如弟。","targetNotes":"第2章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》第2章。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"朱熹","sectionLabel":"集传","text":"朱熹释次章，以“行道遲遲”见其被弃而不忍遽去，“不遠伊邇，薄送我畿”见尚望其近送；“誰謂荼苦，其甘如薺”写心苦过于荼，而“宴爾新昏，如兄如弟”正见新欢相得。","notes":null}]},{"id":"0003","order":3,"total":7,"layer":"span","layerLabel":"诗句片段","targetText":"涇以渭濁，湜湜其沚。宴爾新昏，不我屑以。毋逝我梁，毋發我笱。我躬不閲，遑恤我後。","targetNotes":"第3章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》第3章。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"朱熹","sectionLabel":"集传","text":"朱熹释三章，以涇渭之清浊喻自己与新人相形；“不我屑以”是不以我为洁，“毋逝我梁，毋發我笱”则是虽不见容，犹顾其家事而自伤其后。","notes":null}]},{"id":"0004","order":4,"total":7,"layer":"span","layerLabel":"诗句片段","targetText":"就其深矣，方之舟之。就其淺矣，泳之游之。何有何亡，黽勉求之。凡民有喪，匍匐救之。","targetNotes":"第4章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》第4章。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"朱熹","sectionLabel":"集传","text":"朱熹释四章，以深浅涉水比治家勤劬，言其于家务无论难易、有无，都尽力营求；“凡民有喪，匍匐救之”又见其本性忠厚，遇人有急亦往援手。","notes":null}]},{"id":"0005","order":5,"total":7,"layer":"span","layerLabel":"诗句片段","targetText":"不我能慉，反以我爲讎。既阻我德，賈用不售。昔育恐育鞫，及爾顛覆。既生既育，比予于毒。","targetNotes":"第5章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》第5章。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"朱熹","sectionLabel":"集传","text":"朱熹释五章，从“不我能慉，反以我爲讎”直写夫心反覆；“既阻我德，賈用不售”言有德而不见取；后四句则追忆昔日与夫共经穷困颠覆，而今反比己于毒。","notes":null}]},{"id":"0006","order":6,"total":7,"layer":"span","layerLabel":"诗句片段","targetText":"我有旨蓄，亦以御冬。宴爾新昏，以我御窮。有洸有潰，既詒我肄。不念昔者，伊余來塈。","targetNotes":"第6章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》第6章。","notes":null,"glosses":[{"key":"0006-1","attributionLabel":"朱熹","sectionLabel":"集传","text":"朱熹释六章，言我有旨蓄，可以御冬与御穷，足见旧日持家之劳；“有洸有潰，既詒我肄”则写夫今但以怒色与劳役加我。收以“不念昔者，伊余來塈”，尤见恋旧而伤今。","notes":null}]},{"id":"0007","order":7,"total":7,"layer":"global","layerLabel":"全篇总说","targetText":"谷風六章章八句","targetNotes":"章句总说。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》章句总说。","notes":null,"glosses":[{"key":"0007-1","attributionLabel":"朱熹","sectionLabel":"章句","text":"朱熹总以《谷風》为赋体弃妇自诉之诗，六章章八句，层层从旧誓、送别、泾渭、勤劳、患难直到冬蓄旧恩，一气贯穿，皆为见弃妇人之怨。","notes":null}]}]}}}
