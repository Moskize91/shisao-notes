{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/035-gu-feng/chengjunying-jiangjianyuan-zhuxi","dataHref":"/__data/shijing/annotation/035-gu-feng/chengjunying-jiangjianyuan-zhuxi/data.json","title":"詩經注析 · 谷風 · 注释总览","description":"風 · 邶風 · 谷風 · 汇集《詩經注析》关于《谷風》的 7 条注释，含 7 条注脚。"},"payload":{"detail":{"route":{"poemId":"035-gu-feng","materialId":"chengjunying-jiangjianyuan-zhuxi"},"href":"/shijing/annotation/035-gu-feng/chengjunying-jiangjianyuan-zhuxi","poem":{"id":"035-gu-feng","title":"谷風","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","谷風"],"segments":[{"id":"seg-001","text":"习习谷风","isActive":false},{"id":"seg-002","text":"以阴以雨","isActive":false},{"id":"seg-003","text":"黾勉同心","isActive":false},{"id":"seg-004","text":"不宜有怒","isActive":false},{"id":"seg-005","text":"采葑采菲","isActive":false},{"id":"seg-006","text":"无以下体","isActive":false},{"id":"seg-007","text":"德音莫违","isActive":false},{"id":"seg-008","text":"及尔同死","isActive":false},{"id":"seg-009","text":"行道迟迟","isActive":false},{"id":"seg-010","text":"中心有违","isActive":false},{"id":"seg-011","text":"不远伊迩","isActive":false},{"id":"seg-012","text":"薄送我畿","isActive":false},{"id":"seg-013","text":"谁谓荼苦","isActive":false},{"id":"seg-014","text":"其甘如荠","isActive":false},{"id":"seg-015","text":"宴尔新昏","isActive":false},{"id":"seg-016","text":"如兄如弟","isActive":false},{"id":"seg-017","text":"泾以渭浊","isActive":false},{"id":"seg-018","text":"湜湜其沚","isActive":false},{"id":"seg-019","text":"宴尔新昏","isActive":false},{"id":"seg-020","text":"不我屑以","isActive":false},{"id":"seg-021","text":"毋逝我梁","isActive":false},{"id":"seg-022","text":"毋发我笱","isActive":false},{"id":"seg-023","text":"我躬不阅","isActive":false},{"id":"seg-024","text":"遑恤我后","isActive":false},{"id":"seg-025","text":"就其深矣","isActive":false},{"id":"seg-026","text":"方之舟之","isActive":false},{"id":"seg-027","text":"就其浅矣","isActive":false},{"id":"seg-028","text":"泳之游之","isActive":false},{"id":"seg-029","text":"何有何亡","isActive":false},{"id":"seg-030","text":"黾勉求之","isActive":false},{"id":"seg-031","text":"凡民有丧","isActive":false},{"id":"seg-032","text":"匍匐救之","isActive":false},{"id":"seg-033","text":"不我能慉","isActive":false},{"id":"seg-034","text":"反以我为雠","isActive":false},{"id":"seg-035","text":"既阻我德","isActive":false},{"id":"seg-036","text":"贾用不售","isActive":false},{"id":"seg-037","text":"昔育恐育鞫","isActive":false},{"id":"seg-038","text":"及尔颠覆","isActive":false},{"id":"seg-039","text":"既生既育","isActive":false},{"id":"seg-040","text":"比予于毒","isActive":false},{"id":"seg-041","text":"我有旨蓄","isActive":false},{"id":"seg-042","text":"亦以御冬","isActive":false},{"id":"seg-043","text":"宴尔新昏","isActive":false},{"id":"seg-044","text":"以我御穷","isActive":false},{"id":"seg-045","text":"有洸有溃","isActive":false},{"id":"seg-046","text":"既诒我肄","isActive":false},{"id":"seg-047","text":"不念昔者","isActive":false},{"id":"seg-048","text":"伊余来塈","isActive":false}]},"material":{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","authors":["程俊英","蔣見元"],"contributorLine":"现代 · 程俊英、蔣見元","era":"现代","publicationYear":1991,"carrier":"PDF"},"stats":{"annotationCount":7,"glossCount":7},"annotations":[{"id":"0001","order":1,"total":7,"layer":"global","layerLabel":"全篇总说","targetText":"题解","targetNotes":"题解总说。","sourceLabel":"第 70 页","sourceNotes":"书内页 70《题解》段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"程俊英、蒋见元将《谷风》定为弃妇诉苦诗，基本承朱熹“妇人为夫所弃”之说，不取方玉润“逐臣自伤”的解释。题解强调此诗缠绵悱恻、怨而不怒，以女子自诉的委婉口吻写薄情负心与人世炎凉。","notes":null}]},{"id":"0002","order":2,"total":7,"layer":"span","layerLabel":"诗句片段","targetText":"习习谷风，以阴以雨。黾勉同心，不宜有怒。采葑采菲，无以下体。德音莫违，及尔同死。","targetNotes":"第一章。","sourceLabel":"第 71 页","sourceNotes":"书内页 71 首章注析。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","text":"首章以山谷大风和阴雨兴丈夫暴怒无常，又以“采葑采菲，无以下体”比丈夫娶妻只取颜色而不取德行。程、蒋据此指出，女子虽被弃，仍先追述“及尔同死”的旧誓，写她守信重德而对方先负其言。","notes":null}]},{"id":"0003","order":3,"total":7,"layer":"span","layerLabel":"诗句片段","targetText":"行道迟迟，中心有违。不远伊迩，薄送我畿。谁谓荼苦，其甘如荠。宴尔新昏，如兄如弟。","targetNotes":"第二章。","sourceLabel":"第 72 页","sourceNotes":"书内页 72 次章注析。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","text":"次章写弃妇离门时仍不忍遽去，只盼丈夫至少近送到门内。程、蒋解释“谁谓荼苦，其甘如荠”为以极苦衬心苦更甚，“宴尔新昏，如兄如弟”则以表面宽语写对方与新人安乐亲昵，益见旧人情痴而新宠正浓。","notes":null}]},{"id":"0004","order":4,"total":7,"layer":"span","layerLabel":"诗句片段","targetText":"泾以渭浊，湜湜其沚。宴尔新昏，不我屑以。毋逝我梁，毋发我笱。我躬不阅，遑恤我后。","targetNotes":"第三章。","sourceLabel":"第 72-73 页","sourceNotes":"书内页 72-73 三章注析。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","text":"三章以泾浊渭清比自己与新人相较时虽显憔悴，却仍清白有德；“不我屑以”即丈夫不再把她看作洁美可取之人。下半章“毋逝我梁，毋发我笱”写她虽已不见容，却仍顾念旧日家计和捕鱼器用，语意愈婉而情愈悲。","notes":null}]},{"id":"0005","order":5,"total":7,"layer":"span","layerLabel":"诗句片段","targetText":"就其深矣，方之舟之。就其浅矣，泳之游之。何有何亡，黾勉求之。凡民有丧，匍匐救之。","targetNotes":"第四章。","sourceLabel":"第 73 页","sourceNotes":"书内页 73 四章注析。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","text":"四章转写她治理家务的勤劳能干：深水浅水都能设法渡过，有无多少都尽力营求，别人有难也匍匐往救。程、蒋认为这不仅是自陈勤苦，更是为下章“既阻我德，贾用不售”蓄势，表明被弃绝非因自身失德。","notes":null}]},{"id":"0006","order":6,"total":7,"layer":"span","layerLabel":"诗句片段","targetText":"不我能慉，反以我为雠。既阻我德，贾用不售。昔育恐育鞫，及尔颠覆。既生既育，比予于毒。","targetNotes":"第五章。","sourceLabel":"第 74 页","sourceNotes":"书内页 74 五章注析。","notes":null,"glosses":[{"key":"0006-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","text":"五章直陈夫心反覆：不但不能蓄养，反把旧人当仇；既拒其德，又使其劳苦无所售。程、蒋尤其指出“昔育恐育鞫，及尔颠覆，既生既育，比予于毒”一串今昔对比最为惊心，把共同熬过贫困艰危与今日翻脸成仇并置，怨中带厉。","notes":null}]},{"id":"0007","order":7,"total":7,"layer":"span","layerLabel":"诗句片段","targetText":"我有旨蓄，亦以御冬。宴尔新昏，以我御穷。有洸有溃，既诒我肄。不念昔者，伊余来塈。","targetNotes":"第六章。","sourceLabel":"第 74-75 页","sourceNotes":"书内页 74-75 六章注析。","notes":null,"glosses":[{"key":"0007-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","text":"末章由“旨蓄”“御冬”“御穷”追忆自己昔日储蓄操劳、共渡贫冬的旧事，再以“有洸有潰，既詒我肄”点出丈夫盛气凌人、把劳苦都留给旧妻。收在“不念昔者，伊余来塈”，正是追念初来时厚待与同心，如今一切俱非。","notes":null}]}]}}}
