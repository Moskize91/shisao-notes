{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/035-gu-feng/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/035-gu-feng/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 谷風 · 注释总览","description":"風 · 邶風 · 谷風 · 汇集《诗经原始(上下)》关于《谷風》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"035-gu-feng","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/035-gu-feng/fangyurun-yuanshi","poem":{"id":"035-gu-feng","title":"谷風","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","谷風"],"segments":[{"id":"seg-001","text":"習習谷風","isActive":false},{"id":"seg-002","text":"以陰以雨","isActive":false},{"id":"seg-003","text":"黽勉同心","isActive":false},{"id":"seg-004","text":"不宜有怒","isActive":false},{"id":"seg-005","text":"采葑采菲","isActive":false},{"id":"seg-006","text":"無以下體","isActive":false},{"id":"seg-007","text":"德音莫違","isActive":false},{"id":"seg-008","text":"及爾同死","isActive":false},{"id":"seg-009","text":"行道遲遲","isActive":false},{"id":"seg-010","text":"中心有違","isActive":false},{"id":"seg-011","text":"不遠伊邇","isActive":false},{"id":"seg-012","text":"薄送我畿","isActive":false},{"id":"seg-013","text":"誰謂荼苦","isActive":false},{"id":"seg-014","text":"其甘如薺","isActive":false},{"id":"seg-015","text":"宴爾新昏","isActive":false},{"id":"seg-016","text":"如兄如弟","isActive":false},{"id":"seg-017","text":"涇以渭濁","isActive":false},{"id":"seg-018","text":"湜湜其沚","isActive":false},{"id":"seg-019","text":"宴爾新昏","isActive":false},{"id":"seg-020","text":"不我屑以","isActive":false},{"id":"seg-021","text":"毋逝我梁","isActive":false},{"id":"seg-022","text":"毋發我笱","isActive":false},{"id":"seg-023","text":"我躬不閲","isActive":false},{"id":"seg-024","text":"遑恤我後","isActive":false},{"id":"seg-025","text":"就其深矣","isActive":false},{"id":"seg-026","text":"方之舟之","isActive":false},{"id":"seg-027","text":"就其淺矣","isActive":false},{"id":"seg-028","text":"泳之游之","isActive":false},{"id":"seg-029","text":"何有何亡","isActive":false},{"id":"seg-030","text":"黽勉求之","isActive":false},{"id":"seg-031","text":"凡民有喪","isActive":false},{"id":"seg-032","text":"匍匐救之","isActive":false},{"id":"seg-033","text":"不我能慉","isActive":false},{"id":"seg-034","text":"反以我爲讎","isActive":false},{"id":"seg-035","text":"既阻我德","isActive":false},{"id":"seg-036","text":"賈用不售","isActive":false},{"id":"seg-037","text":"昔育恐育鞫","isActive":false},{"id":"seg-038","text":"及爾顛覆","isActive":false},{"id":"seg-039","text":"既生既育","isActive":false},{"id":"seg-040","text":"比予于毒","isActive":false},{"id":"seg-041","text":"我有旨蓄","isActive":false},{"id":"seg-042","text":"亦以御冬","isActive":false},{"id":"seg-043","text":"宴爾新昏","isActive":false},{"id":"seg-044","text":"以我御窮","isActive":false},{"id":"seg-045","text":"有洸有潰","isActive":false},{"id":"seg-046","text":"既詒我肄","isActive":false},{"id":"seg-047","text":"不念昔者","isActive":false},{"id":"seg-048","text":"伊余來塈","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"谷風㊟逐臣自傷也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标题段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注","text":"方玉润题注径以《谷風》为“逐臣自伤”之作，不从弃妇怨夫一路解释，先把全篇的抒情主体转向遭谗见逐、借夫妇词写臣子失意的人。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"总评","targetNotes":"通篇总评。","sourceLabel":null,"sourceNotes":"对应 EPUB item 总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"总评","text":"方玉润总评力驳《序》与朱熹一路的弃妇说，认为“凡民有喪，匍匐救之”“昔育恐育鞫，及爾顛覆”等语非寻常妇人所能道，故知通篇皆是忠臣义士托为夫妇词，以写无罪见逐、怨抑难申之状。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"眉评","targetNotes":"篇中眉评撮要。","sourceLabel":null,"sourceNotes":"对应 EPUB item 眉评内容。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"眉评","text":"方玉润眉评将六章章法分明：首章先冒夫妇常理，二章即从辞别写见弃，三章推见弃之故在色衰而不在德失，四章自道勤劳，五章写苦乐易位，六章由琐细旧事掉转作收，称其“章法完密”。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"term","layerLabel":"字词注","targetText":"習習谷風黽勉同心采葑采菲德音莫違薄送我畿誰謂荼苦其甘如薺涇以渭濁湜湜其沚不我屑以毋逝我梁毋發我笱我躬不閲方之舟之匍匐救之不我能慉賈用不售昔育恐育鞫及爾顛覆我有旨蓄亦以御冬有洸有潰伊余來塈","targetNotes":"集释撮要。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":"集释","text":"方玉润集释中重辨“谷風”为大谷之风而非生长之风，“葑”“菲”皆可食而“無以下體”专喻弃德取色；又以涇渭、梁笱、方舟、匍匐、能慉、育鞫、旨蓄、洸潰、來塈等字逐一引诸家训诂，支撑其“借夫妇词写逐臣情”的大旨。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"标韵","targetNotes":"六章韵脚撮述。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标韵段。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"方玉润","sectionLabel":"标韵","text":"方玉润标出《谷風》六章换韵层次：首章以“雨、怒”与“體、死”转韵，二章“違、畿”与“薺、弟”互见，三章“沚、以”与“笱、後”分组，四章“舟、游、求、救”为一转，五章“讎、售”与“覆、毒”再转，六章则以“冬、窮”并“肄、塈”收束。","notes":null}]}]}}}
