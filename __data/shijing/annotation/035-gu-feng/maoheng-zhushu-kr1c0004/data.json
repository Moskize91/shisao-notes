{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/035-gu-feng/maoheng-zhushu-kr1c0004","dataHref":"/__data/shijing/annotation/035-gu-feng/maoheng-zhushu-kr1c0004/data.json","title":"毛詩注疏 · 谷風 · 注释总览","description":"風 · 邶風 · 谷風 · 汇集《毛詩注疏》关于《谷風》的 7 条注释，含 7 条注脚。"},"payload":{"detail":{"route":{"poemId":"035-gu-feng","materialId":"maoheng-zhushu-kr1c0004"},"href":"/shijing/annotation/035-gu-feng/maoheng-zhushu-kr1c0004","poem":{"id":"035-gu-feng","title":"谷風","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","谷風"],"segments":[{"id":"seg-001","text":"習習谷風","isActive":false},{"id":"seg-002","text":"以陰以雨","isActive":false},{"id":"seg-003","text":"黽勉同心","isActive":false},{"id":"seg-004","text":"不宜有怒","isActive":false},{"id":"seg-005","text":"采葑采菲","isActive":false},{"id":"seg-006","text":"無以下體","isActive":false},{"id":"seg-007","text":"德音莫違","isActive":false},{"id":"seg-008","text":"及爾同死","isActive":false},{"id":"seg-009","text":"行道遲遲","isActive":false},{"id":"seg-010","text":"中心有違","isActive":false},{"id":"seg-011","text":"不遠伊邇","isActive":false},{"id":"seg-012","text":"薄送我畿","isActive":false},{"id":"seg-013","text":"誰謂荼苦","isActive":false},{"id":"seg-014","text":"其甘如薺","isActive":false},{"id":"seg-015","text":"宴爾新昏","isActive":false},{"id":"seg-016","text":"如兄如弟","isActive":false},{"id":"seg-017","text":"涇以渭濁","isActive":false},{"id":"seg-018","text":"湜湜其沚","isActive":false},{"id":"seg-019","text":"宴爾新昏","isActive":false},{"id":"seg-020","text":"不我屑以","isActive":false},{"id":"seg-021","text":"毋逝我梁","isActive":false},{"id":"seg-022","text":"毋發我笱","isActive":false},{"id":"seg-023","text":"我躬不閲","isActive":false},{"id":"seg-024","text":"遑恤我後","isActive":false},{"id":"seg-025","text":"就其深矣","isActive":false},{"id":"seg-026","text":"方之舟之","isActive":false},{"id":"seg-027","text":"就其淺矣","isActive":false},{"id":"seg-028","text":"泳之游之","isActive":false},{"id":"seg-029","text":"何有何亡","isActive":false},{"id":"seg-030","text":"黽勉求之","isActive":false},{"id":"seg-031","text":"凡民有喪","isActive":false},{"id":"seg-032","text":"匍匐救之","isActive":false},{"id":"seg-033","text":"不我能慉","isActive":false},{"id":"seg-034","text":"反以我爲讎","isActive":false},{"id":"seg-035","text":"既阻我德","isActive":false},{"id":"seg-036","text":"賈用不售","isActive":false},{"id":"seg-037","text":"昔育恐育鞫","isActive":false},{"id":"seg-038","text":"及爾顛覆","isActive":false},{"id":"seg-039","text":"既生既育","isActive":false},{"id":"seg-040","text":"比予于毒","isActive":false},{"id":"seg-041","text":"我有旨蓄","isActive":false},{"id":"seg-042","text":"亦以御冬","isActive":false},{"id":"seg-043","text":"宴爾新昏","isActive":false},{"id":"seg-044","text":"以我御窮","isActive":false},{"id":"seg-045","text":"有洸有潰","isActive":false},{"id":"seg-046","text":"既詒我肄","isActive":false},{"id":"seg-047","text":"不念昔者","isActive":false},{"id":"seg-048","text":"伊余來塈","isActive":false}]},"material":{"id":"maoheng-zhushu-kr1c0004","title":"毛詩注疏","authors":["毛亨","鄭氏","孔穎達"],"contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","era":"漢唐","publicationYear":653,"carrier":"TXT"},"stats":{"annotationCount":7,"glossCount":7},"annotations":[{"id":"0001","order":1,"total":7,"layer":"preface","layerLabel":"篇序","targetText":"谷風刺夫婦失道也衛人化其上淫於新昏而棄其舊室夫婦離絶國俗傷敗焉","targetNotes":"篇首小序。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》篇首小序。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序","text":"序：《谷風》，刺夫婦失道也。衛人化其上，淫於新昏，而棄其舊室。夫婦離絶，國俗傷敗焉。","notes":null}]},{"id":"0002","order":2,"total":7,"layer":"span","layerLabel":"诗句片段","targetText":"習習谷風，以陰以雨。黽勉同心，不宜有怒。采葑采菲，無以下體。德音莫違，及爾同死。","targetNotes":"第1章毛傳撮要。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》第1章。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"毛传","sectionLabel":"傳","text":"毛传以“谷風”为东风和生之气，以阴雨写久阴不霁，兴夫妇失和。又训“葑”“菲”为菜，“無以下體”比弃妇色衰而德未衰，故首章全在追述旧誓与反明夫失道。","notes":null}]},{"id":"0003","order":3,"total":7,"layer":"span","layerLabel":"诗句片段","targetText":"行道遲遲，中心有違。不遠伊邇，薄送我畿。誰謂荼苦，其甘如薺。宴爾新昏，如兄如弟。","targetNotes":"第2章毛傳撮要。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》第2章。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"毛传","sectionLabel":"傳","text":"毛传、郑笺以“遲遲”为舒行，“畿”为近门之地；“誰謂荼苦，其甘如薺”则见心苦逾荼。次章用不忍遽去、望其短送与新昏相乐，写见弃之情最切。","notes":null}]},{"id":"0004","order":4,"total":7,"layer":"span","layerLabel":"诗句片段","targetText":"涇以渭濁，湜湜其沚。宴爾新昏，不我屑以。毋逝我梁，毋發我笱。我躬不閲，遑恤我後。","targetNotes":"第3章毛傳撮要。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》第3章。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"毛传","sectionLabel":"傳","text":"毛传训“湜湜”为清见底，“屑”为洁，“梁”为石梁，“笱”为取鱼竹器，“閲”为容。此章以涇渭喻己与新人，以梁笱写旧室器用，见其虽不见容而犹念其后。","notes":null}]},{"id":"0005","order":5,"total":7,"layer":"span","layerLabel":"诗句片段","targetText":"就其深矣，方之舟之。就其淺矣，泳之游之。何有何亡，黽勉求之。凡民有喪，匍匐救之。","targetNotes":"第4章毛傳撮要。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》第4章。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"毛传","sectionLabel":"傳","text":"毛传以“方”“舟”皆为渡水之具，“泳游”为涉浅深之法；“黽勉求之”“匍匐救之”则极写旧妻凡事尽力、见人有丧亦往救的勤劳厚道。","notes":null}]},{"id":"0006","order":6,"total":7,"layer":"span","layerLabel":"诗句片段","targetText":"不我能慉，反以我爲讎。既阻我德，賈用不售。昔育恐育鞫，及爾顛覆。既生既育，比予于毒。","targetNotes":"第5章毛傳撮要。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》第5章。","notes":null,"glosses":[{"key":"0006-1","attributionLabel":"毛传","sectionLabel":"傳","text":"毛传训“慉”为养，“讎”为怨偶，“阻”为却，“賈用不售”比美德无所售，“鞫”为穷困，“顛覆”为险难，“毒”为苦。此章从不见养反成怨，一路追到共患难时。","notes":null}]},{"id":"0007","order":7,"total":7,"layer":"span","layerLabel":"诗句片段","targetText":"我有旨蓄，亦以御冬。宴爾新昏，以我御窮。有洸有潰，既詒我肄。不念昔者，伊余來塈。","targetNotes":"第6章毛傳撮要。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》第6章。","notes":null,"glosses":[{"key":"0007-1","attributionLabel":"毛传","sectionLabel":"傳","text":"毛传训“旨蓄”为美积之蓄，“御冬”“御窮”皆指昔日持家应贫，“洸”“潰”为怒色武貌，“肄”为劳，“來塈”为初来息家。末章在琐屑旧事中见夫之忍薄。","notes":null}]}]}}}
