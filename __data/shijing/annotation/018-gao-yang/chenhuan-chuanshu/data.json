{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/018-gao-yang/chenhuan-chuanshu","dataHref":"/__data/shijing/annotation/018-gao-yang/chenhuan-chuanshu/data.json","title":"詩毛氏傳疏 · 羔羊 · 注释总览","description":"風 · 召南 · 羔羊 · 汇集《詩毛氏傳疏》关于《羔羊》的 2 条注释，含 2 条注脚。"},"payload":{"detail":{"route":{"poemId":"018-gao-yang","materialId":"chenhuan-chuanshu"},"href":"/shijing/annotation/018-gao-yang/chenhuan-chuanshu","poem":{"id":"018-gao-yang","title":"羔羊","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","羔羊"],"segments":[{"id":"seg-001","text":"羔羊之皮","isActive":false},{"id":"seg-002","text":"素絲五紽","isActive":false},{"id":"seg-003","text":"退食自公","isActive":false},{"id":"seg-004","text":"委蛇委蛇","isActive":false},{"id":"seg-005","text":"羔羊之革","isActive":false},{"id":"seg-006","text":"素絲五緎","isActive":false},{"id":"seg-007","text":"委蛇委蛇","isActive":false},{"id":"seg-008","text":"自公退食","isActive":false},{"id":"seg-009","text":"羔羊之縫","isActive":false},{"id":"seg-010","text":"素絲五總","isActive":false},{"id":"seg-011","text":"委蛇委蛇","isActive":false},{"id":"seg-012","text":"退食自公","isActive":false}]},"material":{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","authors":["陳奐"],"contributorLine":"清 · 陳奐","era":"清","publicationYear":1847,"carrier":"PDF"},"stats":{"annotationCount":2,"glossCount":2},"annotations":[{"id":"0001","order":1,"total":2,"layer":"preface","layerLabel":"篇序","targetText":"羔羊，《鵲巢》之功致也。","targetNotes":"篇首序文。","sourceLabel":"第 48 页","sourceNotes":"据第 48 页《羔羊》序义。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"陈奂承《序》以《羔羊》为《鵲巢》之化所致，谓召南在位者受文王之政教，故能节俭正直而德与服相称；诗人正是因羔裘之制与其委蛇之容，见其内在德行。","notes":null}]},{"id":"0002","order":2,"total":2,"layer":"span","layerLabel":"诗句片段","targetText":"羔羊之皮，素絲五紽。退食自公，委蛇委蛇。羔羊之革，素絲五緎。委蛇委蛇，自公退食。羔羊之縫，素絲五總。委蛇委蛇，退食自公。","targetNotes":"通篇经传疏解。","sourceLabel":"第 48 页","sourceNotes":"据第 48 页《羔羊》经传疏。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"疏解以毛郑孔义为纲，认为羔裘之皮、革、缝三章，层层写其裘服得制，素丝五紽、五緎、五總皆见缝饰有法；而“退食自公”“自公退食”“委蛇委蛇”则写其出入公门、行动从容，可见其心志安定、节俭正直之德。陈奂尤重“德称其服”之旨，故由衣服外貌反证在位者内行之美。","notes":null}]}]}}}
