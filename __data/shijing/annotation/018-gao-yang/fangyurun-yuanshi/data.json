{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/018-gao-yang/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/018-gao-yang/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 羔羊 · 注释总览","description":"風 · 召南 · 羔羊 · 汇集《诗经原始(上下)》关于《羔羊》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"018-gao-yang","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/018-gao-yang/fangyurun-yuanshi","poem":{"id":"018-gao-yang","title":"羔羊","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","羔羊"],"segments":[{"id":"seg-001","text":"羔羊之皮","isActive":false},{"id":"seg-002","text":"素絲五紽","isActive":false},{"id":"seg-003","text":"退食自公","isActive":false},{"id":"seg-004","text":"委蛇委蛇","isActive":false},{"id":"seg-005","text":"羔羊之革","isActive":false},{"id":"seg-006","text":"素絲五緎","isActive":false},{"id":"seg-007","text":"委蛇委蛇","isActive":false},{"id":"seg-008","text":"自公退食","isActive":false},{"id":"seg-009","text":"羔羊之縫","isActive":false},{"id":"seg-010","text":"素絲五總","isActive":false},{"id":"seg-011","text":"委蛇委蛇","isActive":false},{"id":"seg-012","text":"退食自公","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"羔羊㊟美召伯儉而能久也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标题段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注","text":"方玉润以“美召伯俭而能久”概括此篇宗旨，重点不在泛说“在位皆节俭正直”，而在咏一位德行久而不改、衣履行止自见其俭德的具体贤者。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"羔羊之皮，素絲五紽。退食自公，委蛇委蛇。羔羊之革，素絲五緎。委蛇委蛇，自公退食。羔羊之縫，素絲五總。委蛇委蛇，退食自公。","targetNotes":"通篇总评。","sourceLabel":null,"sourceNotes":"对应 EPUB item 正文与右《羔羊》总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":null,"text":"方玉润反对以“德如羔羊”与“在位皆节俭正直”作泛说，主张此诗所咏必有其人，当是久见其服与貌皆无改易的一位贤者。其解“五紽、五緎、五總”皆为一裘之缝际层次，认为一裘而五缝仍不肯弃，正足见其节俭；而“委蛇委蛇”则写其雍容自得、无所矜饰，所以外仪足见内德，末节亦可征全德。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"眉评","targetNotes":"眉评。","sourceLabel":null,"sourceNotes":"对应 EPUB item 眉评段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"眉评","text":"眉评点出此篇最工处在“摹神”，并谓三章回环反复，愈见久而不变其度，因此诗意不在一时一事，而在历久所见的德容常态。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"term","layerLabel":"字词注","targetText":"羔羊之皮羔羊之革羔羊之縫素絲五總","targetNotes":"集释所及名物字义。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"集释","sectionLabel":null,"text":"集释释“羔羊”为小曰羔、大曰羊，又释“革”为皮，“縫”为皮缝际，“總”为合众皮为一。整组训释集中在衣裘名物与缝合层次，为通篇“俭而能久”的物质形象作注。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"标韵","targetNotes":"标韵总说。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标韵段。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"标韵","sectionLabel":null,"text":"标韵将首章归支歌相叶，次章归陌职通韵，三章归冬东通韵。方玉润借韵部转移，显示三章虽句式回环，而用韵亦各有层次变化。","notes":null}]}]}}}
