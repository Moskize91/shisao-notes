{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/018-gao-yang/chengjunying-jiangjianyuan-zhuxi","dataHref":"/__data/shijing/annotation/018-gao-yang/chengjunying-jiangjianyuan-zhuxi/data.json","title":"詩經注析 · 羔羊 · 注释总览","description":"風 · 召南 · 羔羊 · 汇集《詩經注析》关于《羔羊》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"018-gao-yang","materialId":"chengjunying-jiangjianyuan-zhuxi"},"href":"/shijing/annotation/018-gao-yang/chengjunying-jiangjianyuan-zhuxi","poem":{"id":"018-gao-yang","title":"羔羊","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","羔羊"],"segments":[{"id":"seg-001","text":"羔羊之皮","isActive":false},{"id":"seg-002","text":"素丝五紽","isActive":false},{"id":"seg-003","text":"退食自公","isActive":false},{"id":"seg-004","text":"委蛇委蛇","isActive":false},{"id":"seg-005","text":"羔羊之革","isActive":false},{"id":"seg-006","text":"素丝五緎","isActive":false},{"id":"seg-007","text":"委蛇委蛇","isActive":false},{"id":"seg-008","text":"自公退食","isActive":false},{"id":"seg-009","text":"羔羊之缝","isActive":false},{"id":"seg-010","text":"素丝五总","isActive":false},{"id":"seg-011","text":"委蛇委蛇","isActive":false},{"id":"seg-012","text":"退食自公","isActive":false}]},"material":{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","authors":["程俊英","蔣見元"],"contributorLine":"现代 · 程俊英、蔣見元","era":"现代","publicationYear":1991,"carrier":"PDF"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"题解","targetNotes":"题解总说。","sourceLabel":"第 33 页","sourceNotes":"书内页 33《羔羊》题解。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"题解指出此篇是一首通过衣饰步履来讽刺统治阶级官僚的诗。编者综合朱熹、崔述与姚际恒等说，强调诗中并无直陈议论，只是反复描摹“服羔裘而退食、委蛇而行”的形态，由极平淡客观的细节写出其优游自适、无所事事，从而显出讽刺意味。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"羔羊之皮，素丝五紽。退食自公，委蛇委蛇。","targetNotes":"首章。","sourceLabel":"第 34 页","sourceNotes":"书内页 34 首章与注释。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"首章释“素丝”为洁白丝线，认为“五紽”之“五”是交午之形，指交错缝饰而非数目，“紽”即皮衣上交加的丝饰。又释“公”为公门治事之所，“退食自公”为退朝食于公家后出门归家；“委蛇”则据韩诗旧说训为逶迤、袤去貌，写悠闲得意、步履舒徐的神态。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"羔羊之革，素丝五緎。委蛇委蛇，自公退食。","targetNotes":"第二章。","sourceLabel":"第 34 页","sourceNotes":"书内页 34 第二章与注释。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"第二章释“革”为皮袄里子，指出此章与上章分写表里；“五緎”所指仍与上章“五紽”同义，皆写白丝交错缝缀羔裘之制。章法上首章言“退食自公”，次章改为“自公退食”，回环复沓而略变其辞，更见其行止安闲。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"羔羊之缝，素丝五总。委蛇委蛇，退食自公。","targetNotes":"第三章。","sourceLabel":"第 34 页","sourceNotes":"书内页 34 第三章与注释。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"第三章释“缝”为衣服缝制得合身，由针线之缝引申为裁制之合；“总”则训为数密、细密，故“五总”承前二章而更言其缝缀周密。三章层层写裘衣表、里与缝合之工，连同“委蛇委蛇”的常态描写，共同构成对官僚优游闲适生活的讽刺。","notes":null}]}]}}}
