{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/042-jing-nv/chengjunying-jiangjianyuan-zhuxi","dataHref":"/__data/shijing/annotation/042-jing-nv/chengjunying-jiangjianyuan-zhuxi/data.json","title":"詩經注析 · 静女 · 注释总览","description":"風 · 邶風 · 静女 · 汇集《詩經注析》关于《静女》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"042-jing-nv","materialId":"chengjunying-jiangjianyuan-zhuxi"},"href":"/shijing/annotation/042-jing-nv/chengjunying-jiangjianyuan-zhuxi","poem":{"id":"042-jing-nv","title":"静女","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","静女"],"segments":[{"id":"seg-001","text":"静女其姝","isActive":false},{"id":"seg-002","text":"俟我于城隅","isActive":false},{"id":"seg-003","text":"爱而不见","isActive":false},{"id":"seg-004","text":"搔首踟蹰","isActive":false},{"id":"seg-005","text":"静女其娈","isActive":false},{"id":"seg-006","text":"贻我彤管","isActive":false},{"id":"seg-007","text":"彤管有炜","isActive":false},{"id":"seg-008","text":"说怿女美","isActive":false},{"id":"seg-009","text":"自牧归荑","isActive":false},{"id":"seg-010","text":"洵美且异","isActive":false},{"id":"seg-011","text":"匪女之为美","isActive":false},{"id":"seg-012","text":"美人之贻","isActive":false}]},"material":{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","authors":["程俊英","蔣見元"],"contributorLine":"现代 · 程俊英、蔣見元","era":"现代","publicationYear":1991,"carrier":"PDF"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"题解","targetNotes":"题解总说。","sourceLabel":"第 89 页","sourceNotes":"书内页 89《题解》段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"题解将《静女》定为男女幽会的情诗，认为《毛序》“刺时”说不合诗意，也不取将其贬作“淫奔期会”的道学化解读。程、蒋强调此诗以男子口吻写赴约与受赠的欢悦：由“爱而不见，搔首踟蹰”写候会焦灼，由“说怿女美”“匪女之为美，美人之贻”写因人及物的恋爱情绪。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"静女其姝，俟我于城隅。爱而不见，搔首踟蹰。","targetNotes":"第一章。","sourceLabel":"第 89-90 页","sourceNotes":"书内页 89 下栏至 90 上栏首章注析。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","text":"首章写赴约与候见。程、蒋释“静”为“靖”之假借，“姝”为美好女子；“城隅”指城角。又以“爱而不见”释为女子故作藏身、迟迟未出，遂使男子“搔首踟蹰”，呈现徘徊焦急的情态。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"静女其娈，贻我彤管。彤管有炜，说怿女美。","targetNotes":"第二章。","sourceLabel":"第 90 页","sourceNotes":"书内页 90 第二章注析。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","text":"次章转写受赠。程、蒋释“娈”为美好；“彤管”为女子所赠之物，旧说有赤管之笔、管乐器、红草等异说，未可遽定，并以“炜”释为红而有光。又释“说”为“悦”，“女”同“汝”指彤管，故“说怿女美”是因所爱之人所赠而更觉其美。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"自牧归荑，洵美且异。匪女之为美，美人之贻。","targetNotes":"第三章。","sourceLabel":"第 90 页","sourceNotes":"书内页 90 第三章注析。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","text":"末章写受物生情。程、蒋释“牧”为郊外，“归”通“馈”，“荑”为初生白茅，谓女子自郊外采荑相赠；又释“洵”为诚然。二人强调“匪女之为美，美人之贻”并非徒称物美，而是爱其所从来，深写恋人间因人及物的情感投射。","notes":null}]}]}}}
