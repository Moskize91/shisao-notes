{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/042-jing-nv/chenhuan-chuanshu","dataHref":"/__data/shijing/annotation/042-jing-nv/chenhuan-chuanshu/data.json","title":"詩毛氏傳疏 · 静女 · 注释总览","description":"風 · 邶風 · 静女 · 汇集《詩毛氏傳疏》关于《静女》的 2 条注释，含 2 条注脚。"},"payload":{"detail":{"route":{"poemId":"042-jing-nv","materialId":"chenhuan-chuanshu"},"href":"/shijing/annotation/042-jing-nv/chenhuan-chuanshu","poem":{"id":"042-jing-nv","title":"静女","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","静女"],"segments":[{"id":"seg-001","text":"靜女其姝","isActive":false},{"id":"seg-002","text":"俟我於城隅","isActive":false},{"id":"seg-003","text":"愛而不見","isActive":false},{"id":"seg-004","text":"搔首踟躕","isActive":false},{"id":"seg-005","text":"靜女其孌","isActive":false},{"id":"seg-006","text":"貽我彤管","isActive":false},{"id":"seg-007","text":"彤管有煒","isActive":false},{"id":"seg-008","text":"說懌女美","isActive":false},{"id":"seg-009","text":"自牧歸荑","isActive":false},{"id":"seg-010","text":"洵美且異","isActive":false},{"id":"seg-011","text":"匪女之爲美","isActive":false},{"id":"seg-012","text":"美人之貽","isActive":false}]},"material":{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","authors":["陳奐"],"contributorLine":"清 · 陳奐","era":"清","publicationYear":1847,"carrier":"PDF"},"stats":{"annotationCount":2,"glossCount":2},"annotations":[{"id":"0001","order":1,"total":2,"layer":"preface","layerLabel":"篇序","targetText":"靜女刺時也衛君無道夫人無德","targetNotes":"篇首小序。","sourceLabel":"第 74 页","sourceNotes":"书内页 74 篇首序文。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序","text":"序：《靜女》，刺時也。衛君無道，夫人無德。","notes":null}]},{"id":"0002","order":2,"total":2,"layer":"span","layerLabel":"诗句片段","targetText":"靜女其姝，俟我於城隅。愛而不見，搔首踟躕。靜女其孌，貽我彤管。彤管有煒，說懌女美。自牧歸荑，洵美且異。匪女之爲美，美人之貽。","targetNotes":"通篇经传疏解。","sourceLabel":"第 74-75 页","sourceNotes":"据第 74-75 页《靜女》经传疏。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"陈奂疏《靜女》时，以《序》“刺時也。衛君無道，夫人無德”定其讽旨。其释首章“靜女其姝，俟我於城隅”“愛而不見，搔首踟躕”，疏通“靜”为貞靜有法，“姝”为美色，“城隅”喻其自防高深，“踟躕”见其志往而行正。次章“靜女其孌，貽我彤管”“彤管有煒，說懌女美”，则详女史彤管之法，以“煒”明赤貌，见女子能守内则而成其美。末章“自牧歸荑，洵美且異”“匪女之爲美，美人之貽”，陈奂就“牧”“荑”“洵”诸字申训，归结为非徒爱其物，实重其人之德与所贻之义。","notes":null}]}]}}}
