{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/042-jing-nv/zhuxi-shijichuan-kr1c0009","dataHref":"/__data/shijing/annotation/042-jing-nv/zhuxi-shijichuan-kr1c0009/data.json","title":"詩集傳 · 静女 · 注释总览","description":"風 · 邶風 · 静女 · 汇集《詩集傳》关于《静女》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"042-jing-nv","materialId":"zhuxi-shijichuan-kr1c0009"},"href":"/shijing/annotation/042-jing-nv/zhuxi-shijichuan-kr1c0009","poem":{"id":"042-jing-nv","title":"静女","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","静女"],"segments":[{"id":"seg-001","text":"靜女其姝","isActive":true},{"id":"seg-002","text":"俟我於城隅","isActive":true},{"id":"seg-003","text":"愛而不見","isActive":true},{"id":"seg-004","text":"搔首踟躕","isActive":true},{"id":"seg-005","text":"靜女其孌","isActive":false},{"id":"seg-006","text":"貽我彤管","isActive":false},{"id":"seg-007","text":"彤管有煒","isActive":false},{"id":"seg-008","text":"說懌女美","isActive":false},{"id":"seg-009","text":"自牧歸荑","isActive":false},{"id":"seg-010","text":"洵美且異","isActive":false},{"id":"seg-011","text":"匪女之爲美","isActive":false},{"id":"seg-012","text":"美人之貽","isActive":false}]},"material":{"id":"zhuxi-shijichuan-kr1c0009","title":"詩集傳","authors":["朱熹"],"contributorLine":"宋 · 朱熹","era":"宋","publicationYear":1186,"carrier":"TXT"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"靜女其姝，俟我於城隅。愛而不見，搔首踟躕。","targetNotes":"首章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》靜女首章。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"朱熹","sectionLabel":null,"text":"賦也。朱熹释“靜”为閒雅之意，“姝”为美色；“城隅”为幽僻之处，“不見”是期而不至，“踟躕”犹躑躅。故朱熹判此章为淫奔期会之诗。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"靜女其孌，貽我彤管。彤管有煒，說懌女美。","targetNotes":"次章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》靜女次章。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"朱熹","sectionLabel":null,"text":"賦也。朱熹谓“孌”为好貌，至此则与靜女相见。“彤管”未详何物，盖是相赠以结殷勤之意；“煒”为赤貌，言既得此物，又悅懌此女美。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"自牧歸荑，洵美且異。匪女之爲美，美人之貽。","targetNotes":"末章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》靜女末章。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"朱熹","sectionLabel":null,"text":"賦也。朱熹曰“牧”为外野，“歸”亦貽，“荑”为芽之始生者，“洵”为信，“女”指荑而言。又说“匪女之爲美，美人之貽”，意谓并非荑自美，特以美人所贈，故其物亦美。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"靜女三章章四句","targetNotes":"章句总说。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》靜女章句总说。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"朱熹","sectionLabel":null,"text":"朱熹记《靜女》三章，章四句。","notes":null}]}]}}}
