{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/011-lin-zhi-zhi/chengjunying-jiangjianyuan-zhuxi","dataHref":"/__data/shijing/annotation/011-lin-zhi-zhi/chengjunying-jiangjianyuan-zhuxi/data.json","title":"詩經注析 · 麟之趾 · 注释总览","description":"風 · 周南 · 麟之趾 · 汇集《詩經注析》关于《麟之趾》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"011-lin-zhi-zhi","materialId":"chengjunying-jiangjianyuan-zhuxi"},"href":"/shijing/annotation/011-lin-zhi-zhi/chengjunying-jiangjianyuan-zhuxi","poem":{"id":"011-lin-zhi-zhi","title":"麟之趾","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","麟之趾"],"segments":[{"id":"seg-001","text":"麟之趾","isActive":false},{"id":"seg-002","text":"振振公子","isActive":false},{"id":"seg-003","text":"于嗟麟兮","isActive":false},{"id":"seg-004","text":"麟之定","isActive":false},{"id":"seg-005","text":"振振公姓","isActive":false},{"id":"seg-006","text":"于嗟麟兮","isActive":false},{"id":"seg-007","text":"麟之角","isActive":false},{"id":"seg-008","text":"振振公族","isActive":false},{"id":"seg-009","text":"于嗟麟兮","isActive":false}]},"material":{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","authors":["程俊英","蔣見元"],"contributorLine":"现代 · 程俊英、蔣見元","era":"现代","publicationYear":1991,"carrier":"PDF"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"題解","targetNotes":"题解总说。","sourceLabel":"第 21 页","sourceNotes":"/tmp/lin-pages/cheng-lin-3.png 中段题解。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"题解将此篇视为赞美统治者子孙繁盛的诗，指出全篇兼具汉、欧重复咏叹的歌唱性：汉广是四句叠咏，此篇则一句重咏，三次“麟兮”使赞美之辞更显有神。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"麟之趾，振振公子。于嗟麟兮！","targetNotes":"首章。","sourceLabel":"第 21 页","sourceNotes":"/tmp/lin-pages/cheng-lin-3.png 下段首章。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"注释先释麟为传说中的仁兽，又引毛传、郑笺辨“麐”“麟”字形；进而以“振振”为有兴有盛之貌，认为“公子”在诗中兼指年轻贵族，首章先就最亲近的子弟起赞。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"麟之定，振振公姓。于嗟麟兮！","targetNotes":"第二章。","sourceLabel":"第 22 页","sourceNotes":"/tmp/lin-pages/cheng-lin-4.png 上半第二章。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"此章释“定”为额，并说明“姓”即所生、在这里是公姓子孙之意；因此第二章把赞美范围由公子推展到同姓宗支，保持层层展开的结构。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"麟之角，振振公族。于嗟麟兮！","targetNotes":"第三章。","sourceLabel":"第 22 页","sourceNotes":"/tmp/lin-pages/cheng-lin-4.png 中段第三章；页底已转《召南》。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"注释以“公族”为诸侯留都以下所称公族，并引汾渭通毛传“公族，公属也”；至第三章，称美对象扩展到整个宗族系统，完成由公子、公姓到公族的递进。","notes":null}]}]}}}
