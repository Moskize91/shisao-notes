{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/011-lin-zhi-zhi/zhuxi-shijichuan-kr1c0009","dataHref":"/__data/shijing/annotation/011-lin-zhi-zhi/zhuxi-shijichuan-kr1c0009/data.json","title":"詩集傳 · 麟之趾 · 注释总览","description":"風 · 周南 · 麟之趾 · 汇集《詩集傳》关于《麟之趾》的 4 条 annotation，含 4 条 gloss。"},"payload":{"detail":{"route":{"poemId":"011-lin-zhi-zhi","materialId":"zhuxi-shijichuan-kr1c0009"},"href":"/shijing/annotation/011-lin-zhi-zhi/zhuxi-shijichuan-kr1c0009","poem":{"id":"011-lin-zhi-zhi","title":"麟之趾","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","麟之趾"],"segments":[{"id":"seg-001","text":"麟之趾","isActive":false},{"id":"seg-002","text":"振振公子","isActive":false},{"id":"seg-003","text":"于嗟麟兮","isActive":false},{"id":"seg-004","text":"麟之定","isActive":false},{"id":"seg-005","text":"振振公姓","isActive":false},{"id":"seg-006","text":"于嗟麟兮","isActive":false},{"id":"seg-007","text":"麟之角","isActive":false},{"id":"seg-008","text":"振振公族","isActive":false},{"id":"seg-009","text":"于嗟麟兮","isActive":false}]},"material":{"id":"zhuxi-shijichuan-kr1c0009","title":"詩集傳","authors":["朱熹"],"contributorLine":"宋 · 朱熹","era":"宋","publicationYear":1186,"carrier":"TXT"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"麟之趾三章章三句","targetNotes":"章句总说。","sourceLabel":null,"sourceNotes":"对应 txt 227 行。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"朱熹","sectionLabel":"章次","text":"朱熹以此篇为三章三句，承后妃之德化而转写文王子孙宗族之善，虽附记《序》说其为《关雎》之应，但重心仍在公子、公姓、公族皆化于仁厚。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"麟之趾振振公子于嗟麟兮","targetNotes":"第一章。","sourceLabel":null,"sourceNotes":"对应 txt 216-221 行。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"朱熹","sectionLabel":null,"text":"朱熹以麟为仁厚之兽，谓其足不践生草、不履生虫，故借“麟之趾”兴“振振公子”，用以称美文王后妃之德修于身而子孙化于善。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"麟之定振振公姓于嗟麟兮","targetNotes":"第二章。","sourceLabel":null,"sourceNotes":"对应 txt 222-223 行。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"朱熹","sectionLabel":null,"text":"此章以“定”为额，认为麟之额虽有形而不用以抵触，所以转喻公姓之人亦能各安其分；“姓”在此指公孙一系，较公子稍疏而仍在化内。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"麟之角振振公族于嗟麟兮","targetNotes":"第三章。","sourceLabel":null,"sourceNotes":"对应 txt 224-225 行。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"朱熹","sectionLabel":null,"text":"朱熹以麟之一角而角端有肉，说明其虽有武备而不妄用；于是以“振振公族”承前两章，把受化范围推至同高祖而祖庙未毁的宗亲。","notes":null}]}]}}}
