{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/011-lin-zhi-zhi/maoheng-zhushu-kr1c0004","dataHref":"/__data/shijing/annotation/011-lin-zhi-zhi/maoheng-zhushu-kr1c0004/data.json","title":"毛詩注疏 · 麟之趾 · 注释总览","description":"風 · 周南 · 麟之趾 · 汇集《毛詩注疏》关于《麟之趾》的 5 条注释，含 9 条注脚。"},"payload":{"detail":{"route":{"poemId":"011-lin-zhi-zhi","materialId":"maoheng-zhushu-kr1c0004"},"href":"/shijing/annotation/011-lin-zhi-zhi/maoheng-zhushu-kr1c0004","poem":{"id":"011-lin-zhi-zhi","title":"麟之趾","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","麟之趾"],"segments":[{"id":"seg-001","text":"麟之趾","isActive":false},{"id":"seg-002","text":"振振公子","isActive":false},{"id":"seg-003","text":"于嗟麟兮","isActive":false},{"id":"seg-004","text":"麟之定","isActive":false},{"id":"seg-005","text":"振振公姓","isActive":false},{"id":"seg-006","text":"于嗟麟兮","isActive":false},{"id":"seg-007","text":"麟之角","isActive":false},{"id":"seg-008","text":"振振公族","isActive":false},{"id":"seg-009","text":"于嗟麟兮","isActive":false}]},"material":{"id":"maoheng-zhushu-kr1c0004","title":"毛詩注疏","authors":["毛亨","鄭氏","孔穎達"],"contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","era":"漢唐","publicationYear":653,"carrier":"TXT"},"stats":{"annotationCount":5,"glossCount":9},"annotations":[{"id":"0001","order":1,"total":5,"layer":"preface","layerLabel":"篇序","targetText":"序麟之趾關雎之應也","targetNotes":"篇首小序与郑笺。","sourceLabel":null,"sourceNotes":"对应 txt 1220-1246 行。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序","text":"序：麟之趾，關雎之應也。關雎之化行，則天下無犯非禮；雖衰世之公子，皆信厚如麟趾之時也。","notes":null},{"key":"0001-2","attributionLabel":"郑笺","sectionLabel":null,"text":"箋云：關雎之時以麟為應；後世雖衰，猶存關雎之化者，君之宗族尚振振然，有似麟應之時無以過也。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"麟之趾振振公子于嗟麟兮","targetNotes":"首章。","sourceLabel":null,"sourceNotes":"对应 txt 1247-1261 行。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：興也。趾，足也。麟信而應禮，以足至者也。振振，信厚也。于嗟，歎辭。","notes":null},{"key":"0002-2","attributionLabel":"郑笺","sectionLabel":null,"text":"箋云：興者喻今公子亦信厚，與禮相應，有似於麟。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"麟之定振振公姓于嗟麟兮","targetNotes":"第二章。","sourceLabel":null,"sourceNotes":"对应 txt 1262-1272 行。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：定，題也。公姓，公同姓。","notes":null},{"key":"0003-2","attributionLabel":"孔颖达疏","sectionLabel":"疏","text":"疏申明“定”即额，且以“公姓”指与国君同姓而较疏于同祖者，故此章由公子推及宗姓，层次较前一章稍远。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"麟之角振振公族于嗟麟兮","targetNotes":"第三章。","sourceLabel":null,"sourceNotes":"对应 txt 1273-1279 行。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：麟角所以表其德也。公族，公同祖也。","notes":null},{"key":"0004-2","attributionLabel":"郑笺","sectionLabel":null,"text":"箋云：麟角之末有肉，示有武而不用。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"麟之趾三章章三句","targetNotes":"章句总说。","sourceLabel":null,"sourceNotes":"对应 txt 1280 行。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"章句","sectionLabel":null,"text":"麟之趾三章章三句。","notes":null}]}]}}}
