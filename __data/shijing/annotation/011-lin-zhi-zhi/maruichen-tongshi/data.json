{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/011-lin-zhi-zhi/maruichen-tongshi","dataHref":"/__data/shijing/annotation/011-lin-zhi-zhi/maruichen-tongshi/data.json","title":"毛詩傳箋通釋 · 麟之趾 · 注释总览","description":"風 · 周南 · 麟之趾 · 汇集《毛詩傳箋通釋》关于《麟之趾》的 4 条 annotation，含 4 条 gloss。"},"payload":{"detail":{"route":{"poemId":"011-lin-zhi-zhi","materialId":"maruichen-tongshi"},"href":"/shijing/annotation/011-lin-zhi-zhi/maruichen-tongshi","poem":{"id":"011-lin-zhi-zhi","title":"麟之趾","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","麟之趾"],"segments":[{"id":"seg-001","text":"麟之趾","isActive":false},{"id":"seg-002","text":"振振公子","isActive":false},{"id":"seg-003","text":"于嗟麟兮","isActive":false},{"id":"seg-004","text":"麟之定","isActive":false},{"id":"seg-005","text":"振振公姓","isActive":false},{"id":"seg-006","text":"于嗟麟兮","isActive":false},{"id":"seg-007","text":"麟之角","isActive":false},{"id":"seg-008","text":"振振公族","isActive":false},{"id":"seg-009","text":"于嗟麟兮","isActive":false}]},"material":{"id":"maruichen-tongshi","title":"毛詩傳箋通釋","authors":["馬瑞辰"],"contributorLine":"清 · 馬瑞辰","era":"清","publicationYear":1989,"carrier":"PDF"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"preface","layerLabel":"篇序","targetText":"题解","targetNotes":"马瑞辰于篇首总说。","sourceLabel":"第 96-97 页","sourceNotes":"依据 /tmp/lin-pages/maruichen-2.png 与 /tmp/lin-pages/maruichen-3.png 的篇首总说。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"马瑞辰","sectionLabel":"按","text":"瑞辰总说此篇借麟起兴，以“趾、定、角”自下而上铺排，而“公子、公姓、公族”则由亲而疏展开；篇旨不在瑞兽本身，而在赞美周家宗族皆信厚有礼。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"麟之趾，振振公子，于嗟麟兮。","targetNotes":"第一章。","sourceLabel":"第 97 页","sourceNotes":"依据 /tmp/lin-pages/maruichen-4.png 首章段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"马瑞辰","sectionLabel":null,"text":"首章以“麟之趾”发端，瑞辰释为借麟足之应礼以比公子之信厚；“振振”着重宗枝盛美而不轻佻，故诗人叹美之辞紧随其后。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"麟之定，振振公姓，于嗟麟兮。","targetNotes":"第二章。","sourceLabel":"第 97-98 页","sourceNotes":"依据 /tmp/lin-pages/maruichen-4.png 中段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"马瑞辰","sectionLabel":null,"text":"次章改言“定”，瑞辰仍从麟体取义，认为额象端正而不触犯；由公子推及公姓，见周家同姓支派亦皆振振可称。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"麟之角，振振公族，于嗟麟兮。","targetNotes":"第三章。","sourceLabel":"第 98 页","sourceNotes":"依据 /tmp/lin-pages/maruichen-4.png 下段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"马瑞辰","sectionLabel":null,"text":"末章以麟角收束，瑞辰指出角有武象而不见伤害之用，因此特别能比公族兼具威仪与信厚，成为全篇叹美之极点。","notes":null}]}]}}}
