{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/011-lin-zhi-zhi/wangli-yundu","dataHref":"/__data/shijing/annotation/011-lin-zhi-zhi/wangli-yundu/data.json","title":"詩經韻讀 · 麟之趾 · 注释总览","description":"風 · 周南 · 麟之趾 · 汇集《詩經韻讀》关于《麟之趾》的 4 条 annotation，含 4 条 gloss。"},"payload":{"detail":{"route":{"poemId":"011-lin-zhi-zhi","materialId":"wangli-yundu"},"href":"/shijing/annotation/011-lin-zhi-zhi/wangli-yundu","poem":{"id":"011-lin-zhi-zhi","title":"麟之趾","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","麟之趾"],"segments":[{"id":"seg-001","text":"麟之趾","isActive":false},{"id":"seg-002","text":"振振公子","isActive":false},{"id":"seg-003","text":"于嗟麟兮","isActive":false},{"id":"seg-004","text":"麟之定","isActive":false},{"id":"seg-005","text":"振振公姓","isActive":false},{"id":"seg-006","text":"于嗟麟兮","isActive":false},{"id":"seg-007","text":"麟之角","isActive":false},{"id":"seg-008","text":"振振公族","isActive":false},{"id":"seg-009","text":"于嗟麟兮","isActive":false}]},"material":{"id":"wangli-yundu","title":"詩經韻讀","authors":["王力"],"contributorLine":"现代 · 王力","era":"现代","publicationYear":1980,"carrier":"PDF"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"《麟之趾》韵读段","targetNotes":"书页 142-143 上整段韵读说明。","sourceLabel":"第 142 页局部","sourceNotes":"/tmp/lin-pages/wangli-3.png 下半与 /tmp/lin-pages/wangli-4.png 上半共覆盖《麟之趾》全段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"王力","sectionLabel":"韵读","text":"整段沿用本书韵读格式，为《麟之趾》三章逐句标拟音与韵部；三次“麟”皆归真部叶韵，“子”“姓”“族”分别分属之、耕、屋等部，呈现此篇短章反复的音节组织。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"麟之趾，振振公子。于嗟麟兮！","targetNotes":"首章韵读。","sourceLabel":"第 142 页局部","sourceNotes":"/tmp/lin-pages/wangli-3.png 下半。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"王力","sectionLabel":"韵读","text":"首章把“趾(tjia)”与“子(tzia)”同归之部，又注“麟(lien)”与第二章通韵，显示王力把三章都读成短句叠响、句末同叶的形式。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"麟之定，振振公姓。于嗟麟兮！","targetNotes":"第二章韵读。","sourceLabel":"第 142 页局部","sourceNotes":"/tmp/lin-pages/wangli-3.png 末段续至 /tmp/lin-pages/wangli-4.png 页首。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"王力","sectionLabel":"韵读","text":"第二章标“定(dyeng)”入耕部、“姓(sieng)”仍押耕部，而“麟”继续与首章相叶，显示这一章在换用新韵脚时仍保持全篇反复的尾音结构。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"麟之角，振振公族。于嗟麟兮！","targetNotes":"第三章韵读。","sourceLabel":"第 143 页局部","sourceNotes":"/tmp/lin-pages/wangli-4.png 上半；下半已转《召南》。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"王力","sectionLabel":"韵读","text":"第三章列“角(keok)”与“族(dzok)”为屋部相协，句末“麟”仍归真部，形成前两字换部而尾句复沓不变的收束方式。","notes":null}]}]}}}
