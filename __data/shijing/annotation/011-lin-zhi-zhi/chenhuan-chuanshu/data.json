{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/011-lin-zhi-zhi/chenhuan-chuanshu","dataHref":"/__data/shijing/annotation/011-lin-zhi-zhi/chenhuan-chuanshu/data.json","title":"詩毛氏傳疏 · 麟之趾 · 注释总览","description":"風 · 周南 · 麟之趾 · 汇集《詩毛氏傳疏》关于《麟之趾》的 5 条 annotation，含 5 条 gloss。"},"payload":{"detail":{"route":{"poemId":"011-lin-zhi-zhi","materialId":"chenhuan-chuanshu"},"href":"/shijing/annotation/011-lin-zhi-zhi/chenhuan-chuanshu","poem":{"id":"011-lin-zhi-zhi","title":"麟之趾","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","麟之趾"],"segments":[{"id":"seg-001","text":"麟之趾","isActive":false},{"id":"seg-002","text":"振振公子","isActive":false},{"id":"seg-003","text":"于嗟麟兮","isActive":false},{"id":"seg-004","text":"麟之定","isActive":false},{"id":"seg-005","text":"振振公姓","isActive":false},{"id":"seg-006","text":"于嗟麟兮","isActive":false},{"id":"seg-007","text":"麟之角","isActive":false},{"id":"seg-008","text":"振振公族","isActive":false},{"id":"seg-009","text":"于嗟麟兮","isActive":false}]},"material":{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","authors":["陳奐"],"contributorLine":"清 · 陳奐","era":"清","publicationYear":1847,"carrier":"PDF"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"preface","layerLabel":"篇序","targetText":"序《麟之趾》關雎之應也","targetNotes":"篇首序文与总疏。","sourceLabel":"第 45 页","sourceNotes":"/tmp/lin-pages/chenhuan-3.png 上半页序文。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"疏承《序》以《麟之趾》为《关雎》之应，认为后妃之化既行，故公子、公姓、公族皆信厚近礼；麟不过是假物取兴，用来见周宗之善类日盛。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"麟之趾，振振公子。于嗟麟兮。","targetNotes":"首章。","sourceLabel":"第 45 页","sourceNotes":"/tmp/lin-pages/chenhuan-3.png 中段首章。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"疏释首章时，以麟趾之仁厚比振振公子，谓“振振”是德容整饬、信厚可嘉之貌；先言公子，是由最近于君者写起，见周家近支已各有善声。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"麟之定，振振公姓。于嗟麟兮。","targetNotes":"第二章。","sourceLabel":"第 45-46 页","sourceNotes":"/tmp/lin-pages/chenhuan-3.png 下段续至 /tmp/lin-pages/chenhuan-4.png 上段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"疏以“定”为额，由麟之额转喻公姓，说明这一章是从公子推及同姓宗支；其意仍不离信厚守礼，只是把称美对象由亲近子弟扩展到较疏宗姓。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"麟之角，振振公族。于嗟麟兮。","targetNotes":"第三章。","sourceLabel":"第 46 页","sourceNotes":"/tmp/lin-pages/chenhuan-4.png 中段至下段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"疏以麟角有武而不伤为比，转美公族虽有才能而不失礼法；至此由公子、公姓递推到公族，完成宗族之盛与德教之广的铺写。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"麟之趾三章章三句","targetNotes":"章句总说。","sourceLabel":"第 46 页","sourceNotes":"/tmp/lin-pages/chenhuan-4.png 下段“麟之趾三章章三句”。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"疏以三章三句总束全篇，认为此诗借麟之趾、定、角层层推美周家宗支，归结到公族公姓皆可见《关雎》遗化未坠。","notes":null}]}]}}}
