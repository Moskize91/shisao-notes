EPUB item 总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"总评","text":"总评中方玉润从庄姜说出发，认为首二章用绿黄、表里、上下比嫡妾贵贱倒置，三章则由“绿兮丝兮”回溯未染之前，怨意最深而不露，四章又以絺綌不宜寒风喻失时见弃。其评强调全诗温柔敦厚、怨而不怒，最能见庄姜之贤。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"眉评","targetNotes":"姚际恒眉评摘录。","sourceLabel":null,"sourceNotes":"对应 EPUB item 眉评段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"眉评","text":"眉评引姚际恒谓此诗先从“绿衣”言“黄里”，又从“绿衣”转言“丝”，再由“丝”及“絺綌”，若断若连，最足玩味。方玉润借此强调本篇结构绵密，不是单纯铺叙怨词。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"term","layerLabel":"字词注","targetText":"緑兮衣兮緑衣黄裏緑衣黄裳女所治兮俾無訧兮","targetNotes":"集释条目汇总。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":"集释","text":"集释明言“绿”为间色、“黄”为正色，“衣上曰衣，裳下曰裳”；又释“治”为治理丝帛，“訧”为过。方玉润借这些训释，把首二章的颜色礼制、后三章的妇功与得失都扣回庄姜失位之旨。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"标韵","targetNotes":"各章韵脚与部类。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标韵段。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"标韵","sectionLabel":null,"text":"标韵以首章“裏”“已”入纸部，次章“裳”“亡”入阳部，三章“絲”“治”“訧”本支而末句叶尤，四章“風”“心”则东侵通叶。章章换韵而情绪递转。","notes":null}]}]}}}
