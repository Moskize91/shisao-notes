{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/027-lv-yi/chenhuan-chuanshu","dataHref":"/__data/shijing/annotation/027-lv-yi/chenhuan-chuanshu/data.json","title":"詩毛氏傳疏 · 緑衣 · 注释总览","description":"風 · 邶風 · 緑衣 · 汇集《詩毛氏傳疏》关于《緑衣》的 2 条注释，含 2 条注脚。"},"payload":{"detail":{"route":{"poemId":"027-lv-yi","materialId":"chenhuan-chuanshu"},"href":"/shijing/annotation/027-lv-yi/chenhuan-chuanshu","poem":{"id":"027-lv-yi","title":"緑衣","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","緑衣"],"segments":[{"id":"seg-001","text":"綠兮衣兮","isActive":false},{"id":"seg-002","text":"綠衣黃裏","isActive":false},{"id":"seg-003","text":"心之憂矣","isActive":false},{"id":"seg-004","text":"曷維其已","isActive":false},{"id":"seg-005","text":"綠兮衣兮","isActive":false},{"id":"seg-006","text":"綠衣黃裳","isActive":false},{"id":"seg-007","text":"心之憂矣","isActive":false},{"id":"seg-008","text":"曷維其亡","isActive":false},{"id":"seg-009","text":"綠兮絲兮","isActive":false},{"id":"seg-010","text":"女所治兮","isActive":false},{"id":"seg-011","text":"我思古人","isActive":false},{"id":"seg-012","text":"俾無訧兮","isActive":false},{"id":"seg-013","text":"絺兮綌兮","isActive":false},{"id":"seg-014","text":"淒其以風","isActive":false},{"id":"seg-015","text":"我思古人","isActive":false},{"id":"seg-016","text":"實獲我心","isActive":false}]},"material":{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","authors":["陳奐"],"contributorLine":"清 · 陳奐","era":"清","publicationYear":1847,"carrier":"PDF"},"stats":{"annotationCount":2,"glossCount":2},"annotations":[{"id":"0001","order":1,"total":2,"layer":"preface","layerLabel":"篇序","targetText":"綠衣衛莊姜傷己也妾上僭夫人失位而作是詩也","targetNotes":"篇首小序。","sourceLabel":"第 54 页","sourceNotes":"书内页 54 篇首序文。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序","text":"序：《綠衣》，衛莊姜傷己也。妾上僭，夫人失位而作是詩也。","notes":null}]},{"id":"0002","order":2,"total":2,"layer":"span","layerLabel":"诗句片段","targetText":"綠兮衣兮，綠衣黃裏。心之憂矣，曷維其已。綠兮衣兮，綠衣黃裳。心之憂矣，曷維其亡。綠兮絲兮，女所治兮。我思古人，俾無訧兮。絺兮綌兮，淒其以風。我思古人，實獲我心。","targetNotes":"通篇经传疏解。","sourceLabel":"第 54-55 页","sourceNotes":"据第 54-55 页《綠衣》经传疏。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"陈奂遵《序》旧说，以《綠衣》为庄姜伤己、嫡妾失位之辞。其疏重申“绿”为间色、“黄”为正色，以衣里、衣裳、丝帛与絺綌层层设喻，写妾僭而夫人见疏；末二章又从旧物缝治与寒风失时，转见庄姜自伤而怨不怒。","notes":null}]}]}}}
