{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/027-lv-yi/chengjunying-jiangjianyuan-zhuxi","dataHref":"/__data/shijing/annotation/027-lv-yi/chengjunying-jiangjianyuan-zhuxi/data.json","title":"詩經注析 · 緑衣 · 注释总览","description":"風 · 邶風 · 緑衣 · 汇集《詩經注析》关于《緑衣》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"027-lv-yi","materialId":"chengjunying-jiangjianyuan-zhuxi"},"href":"/shijing/annotation/027-lv-yi/chengjunying-jiangjianyuan-zhuxi","poem":{"id":"027-lv-yi","title":"緑衣","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","緑衣"],"segments":[{"id":"seg-001","text":"绿兮衣兮","isActive":false},{"id":"seg-002","text":"绿衣黄里","isActive":false},{"id":"seg-003","text":"心之忧矣","isActive":false},{"id":"seg-004","text":"曷维其已","isActive":false},{"id":"seg-005","text":"绿兮衣兮","isActive":false},{"id":"seg-006","text":"绿衣黄裳","isActive":false},{"id":"seg-007","text":"心之忧矣","isActive":false},{"id":"seg-008","text":"曷维其亡","isActive":false},{"id":"seg-009","text":"绿兮丝兮","isActive":false},{"id":"seg-010","text":"女所治兮","isActive":false},{"id":"seg-011","text":"我思古人","isActive":false},{"id":"seg-012","text":"俾无訧兮","isActive":false},{"id":"seg-013","text":"絺兮綌兮","isActive":false},{"id":"seg-014","text":"凄其以风","isActive":false},{"id":"seg-015","text":"我思古人","isActive":false},{"id":"seg-016","text":"实获我心","isActive":false}]},"material":{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","authors":["程俊英","蔣見元"],"contributorLine":"现代 · 程俊英、蔣見元","era":"现代","publicationYear":1991,"carrier":"PDF"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"题解","targetNotes":"题解总说。","sourceLabel":"第 50-51 页","sourceNotes":"书内页 50-51《题解》段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"程、蒋将《绿衣》读为睹物怀人、追念亡妻之诗，认为旧说庄姜伤己、嫡妾失位虽可备存，但细味全篇更近悼亡。题解强调诗人反复咏叹的只是亡妻旧衣，由“绿衣”“絺綌”牵出触目伤心之情，故此诗可视作后世悼亡诗的滥觞。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"绿兮衣兮，绿衣黄里。心之忧矣，曷维其已！","targetNotes":"首章。","sourceLabel":"第 51-52 页","sourceNotes":"书内页 51-52 首章及注释。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"首章从眼前所见的绿衣黄里写起。程、蒋认为“绿衣”并非比兴深喻，而是亡妻旧衣触发的真实联想；“曷维其已”则直接写出哀思无已，正与悼亡语气相合。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"绿兮衣兮，绿衣黄裳。心之忧矣，曷维其亡！","targetNotes":"第二章。","sourceLabel":"第 52 页","sourceNotes":"书内页 52 第二章及注释。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"次章仍承首章复沓，“黄裳”由衣里转到下裳，只是把所见旧衣从里及表写得更具体。程、蒋把“亡”释作忘，认为这一章仍是写哀念不能忘怀。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"绿兮丝兮，女所治兮。我思古人，俾无訧兮。","targetNotes":"第三章。","sourceLabel":"第 52 页","sourceNotes":"书内页 52 第三章及注释。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"三章由衣追想到衣料与缝治之人。“女所治兮”点出此衣出自故妻之手，“俾无訧兮”则称其生前足以辅佐、使己少过。程、蒋认为这一转进最见亡妻贤德，所以怀思更深。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"絺兮綌兮，凄其以风。我思古人，实获我心。","targetNotes":"第四章。","sourceLabel":"第 52 页","sourceNotes":"书内页 52 第四章及注释。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"末章由夏葛逢风而生凉意，引出“我思古人，实获我心”。程、蒋指出这里既写时令凄清，也写作者念及亡妻最能体贴己心，由是把全篇悼亡之意收束得更沉挚。","notes":null}]}]}}}
