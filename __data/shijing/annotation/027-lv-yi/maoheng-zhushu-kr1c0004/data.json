{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/027-lv-yi/maoheng-zhushu-kr1c0004","dataHref":"/__data/shijing/annotation/027-lv-yi/maoheng-zhushu-kr1c0004/data.json","title":"毛詩注疏 · 緑衣 · 注释总览","description":"風 · 邶風 · 緑衣 · 汇集《毛詩注疏》关于《緑衣》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"027-lv-yi","materialId":"maoheng-zhushu-kr1c0004"},"href":"/shijing/annotation/027-lv-yi/maoheng-zhushu-kr1c0004","poem":{"id":"027-lv-yi","title":"緑衣","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","緑衣"],"segments":[{"id":"seg-001","text":"綠兮衣兮","isActive":false},{"id":"seg-002","text":"綠衣黃裏","isActive":false},{"id":"seg-003","text":"心之憂矣","isActive":false},{"id":"seg-004","text":"曷維其已","isActive":false},{"id":"seg-005","text":"綠兮衣兮","isActive":false},{"id":"seg-006","text":"綠衣黃裳","isActive":false},{"id":"seg-007","text":"心之憂矣","isActive":false},{"id":"seg-008","text":"曷維其亡","isActive":false},{"id":"seg-009","text":"綠兮絲兮","isActive":false},{"id":"seg-010","text":"女所治兮","isActive":false},{"id":"seg-011","text":"我思古人","isActive":false},{"id":"seg-012","text":"俾無訧兮","isActive":false},{"id":"seg-013","text":"絺兮綌兮","isActive":false},{"id":"seg-014","text":"淒其以風","isActive":false},{"id":"seg-015","text":"我思古人","isActive":false},{"id":"seg-016","text":"實獲我心","isActive":false}]},"material":{"id":"maoheng-zhushu-kr1c0004","title":"毛詩注疏","authors":["毛亨","鄭氏","孔穎達"],"contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","era":"漢唐","publicationYear":653,"carrier":"TXT"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"preface","layerLabel":"篇序","targetText":"綠衣衛莊姜傷己也妾上僭夫人失位而作是詩也","targetNotes":"篇首小序。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》綠衣序文。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序","text":"序：《綠衣》，衛莊姜傷己也。妾上僭，夫人失位而作是詩也。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"綠兮衣兮綠衣黃裏心之憂矣曷維其已","targetNotes":"首章。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》首章。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：綠，間色。黃，正色。間色之綠衣，黃裏之。黃裏，黃之閒也。已，止也。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"綠兮衣兮綠衣黃裳心之憂矣曷維其亡","targetNotes":"第二章。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》第二章。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：上曰衣，下曰裳。亡，忘也。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"綠兮絲兮女所治兮我思古人俾無訧兮","targetNotes":"第三章。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》第三章。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：女，女功也。古人，古之人，謂夫人也。訧，過也。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"絺兮綌兮淒其以風我思古人實獲我心","targetNotes":"第四章。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》第四章。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：絺，細葛也。綌，麤葛也。淒，寒風也。實，是也。獲，得也。","notes":null}]}]}}}
