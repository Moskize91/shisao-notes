{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/037-mao-qiu/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/037-mao-qiu/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 旄丘 · 注释总览","description":"風 · 邶風 · 旄丘 · 汇集《诗经原始(上下)》关于《旄丘》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"037-mao-qiu","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/037-mao-qiu/fangyurun-yuanshi","poem":{"id":"037-mao-qiu","title":"旄丘","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","旄丘"],"segments":[{"id":"seg-001","text":"旄丘之葛兮","isActive":false},{"id":"seg-002","text":"何誕之節兮","isActive":false},{"id":"seg-003","text":"叔兮伯兮","isActive":false},{"id":"seg-004","text":"何多日也","isActive":false},{"id":"seg-005","text":"何其處也","isActive":false},{"id":"seg-006","text":"必有與也","isActive":false},{"id":"seg-007","text":"何其久也","isActive":false},{"id":"seg-008","text":"必有以也","isActive":false},{"id":"seg-009","text":"狐裘蒙戎","isActive":false},{"id":"seg-010","text":"匪車不東","isActive":false},{"id":"seg-011","text":"叔兮伯兮","isActive":false},{"id":"seg-012","text":"靡所與同","isActive":false},{"id":"seg-013","text":"瑣兮尾兮","isActive":false},{"id":"seg-014","text":"流離之子","isActive":false},{"id":"seg-015","text":"叔兮伯兮","isActive":false},{"id":"seg-016","text":"褎如充耳","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"旄丘㊟黎臣勸君勿望救於衛也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标题段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注","text":"方玉润题注把《旄丘》径定为黎臣劝君勿再望卫之救、当早归自振之诗。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"总评","targetNotes":"通篇总评。","sourceLabel":null,"sourceNotes":"对应 EPUB item 总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"总评","text":"方玉润总评力转《序》“责卫伯不能救黎”之说，认为黎国自身不振，卫不来救未足深责；全诗虽若责人，意实劝君。四章从犹有望救之心写到知其无意于我，最后归结为“不如谋归故国之为愈”，仍是一片忧国爱君之心。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"眉评","targetNotes":"篇中眉评撮要。","sourceLabel":null,"sourceNotes":"对应 EPUB item 眉评内容。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"眉评","text":"方玉润只拈出第二章，称“自问自答，望人情景如画”，以点明本篇妙处正在盼望者心态的层层自解与自破。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"term","layerLabel":"字词注","targetText":"旄丘之葛兮何誕之節兮必有與也必有以也狐裘蒙戎匪車不東流離之子褎如充耳","targetNotes":"集释撮要。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":"集释","text":"方玉润集释辨“旄丘”为前高后下之丘，“誕”当从延长义，“與”为与我伐狄，“以”为所以左右之；又训“狐裘”“蒙戎”“不東”“流離”“褎”“充耳”等，以证明卫国诸臣盛服自安而无意东来，正是末路绝望之根由。","notes":null}]}]}}}
