{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/037-mao-qiu/chengjunying-jiangjianyuan-zhuxi","dataHref":"/__data/shijing/annotation/037-mao-qiu/chengjunying-jiangjianyuan-zhuxi/data.json","title":"詩經注析 · 旄丘 · 注释总览","description":"風 · 邶風 · 旄丘 · 汇集《詩經注析》关于《旄丘》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"037-mao-qiu","materialId":"chengjunying-jiangjianyuan-zhuxi"},"href":"/shijing/annotation/037-mao-qiu/chengjunying-jiangjianyuan-zhuxi","poem":{"id":"037-mao-qiu","title":"旄丘","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","旄丘"],"segments":[{"id":"seg-001","text":"旄丘之葛兮","isActive":false},{"id":"seg-002","text":"何诞之节兮","isActive":false},{"id":"seg-003","text":"叔兮伯兮","isActive":false},{"id":"seg-004","text":"何多日也","isActive":false},{"id":"seg-005","text":"何其处也","isActive":false},{"id":"seg-006","text":"必有与也","isActive":false},{"id":"seg-007","text":"何其久也","isActive":false},{"id":"seg-008","text":"必有以也","isActive":false},{"id":"seg-009","text":"狐裘蒙戎","isActive":false},{"id":"seg-010","text":"匪车不东","isActive":false},{"id":"seg-011","text":"叔兮伯兮","isActive":false},{"id":"seg-012","text":"靡所与同","isActive":false},{"id":"seg-013","text":"琐兮尾兮","isActive":false},{"id":"seg-014","text":"流离之子","isActive":false},{"id":"seg-015","text":"叔兮伯兮","isActive":false},{"id":"seg-016","text":"褎如充耳","isActive":false}]},"material":{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","authors":["程俊英","蔣見元"],"contributorLine":"现代 · 程俊英、蔣見元","era":"现代","publicationYear":1991,"carrier":"PDF"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"题解","targetNotes":"题解总说。","sourceLabel":"第 77 页","sourceNotes":"书内页 77《题解》段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"程俊英、蒋见元把《旄丘》解释为流亡到卫国的黎国人盼卫救济而久不得助之诗，基本承《诗序》“责卫伯不能修方伯连率之职”一路，但强调诗中最终情绪已从责卫转成绝望，实含劝归之意。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"旄丘之葛兮，何诞之节兮。叔兮伯兮，何多日也。","targetNotes":"第一章。","sourceLabel":"第 77 页","sourceNotes":"书内页 77 首章注析。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","text":"首章以旄丘之葛起兴，问葛何以蔓延如此，又转问“叔兮伯兮，何多日也”。程、蒋认为此处所呼“叔伯”即卫国贵族，首章主要写流亡者久盼救援不至，怀着希望而发问。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"何其处也，必有与也。何其久也，必有以也。","targetNotes":"第二章。","sourceLabel":"第 77-78 页","sourceNotes":"书内页 77-78 次章注析。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","text":"第二章连用两组设问而自答：“必有与也”“必有以也”。程、蒋解释为流亡者给自己寻找理由，设想卫国或许别有所待、别有所挟，所以迟迟不来；言外正见其久盼久候而仍不忍断绝希望。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"狐裘蒙戎，匪车不东。叔兮伯兮，靡所与同。","targetNotes":"第三章。","sourceLabel":"第 78 页","sourceNotes":"书内页 78 三章注析。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","text":"三章改用赋法，以“狐裘蒙戎，匪车不东”写卫国贵族衣冠整肃而车辆终不东来救黎。程、蒋认为这一章标志诗意转折：此前的希望至此开始破灭，诗人意识到卫国贵族与自己并不同心。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"琐兮尾兮，流离之子。叔兮伯兮，褎如充耳。","targetNotes":"第四章。","sourceLabel":"第 78-79 页","sourceNotes":"书内页 78-79 四章注析。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","text":"末章以“琐兮尾兮，流离之子”自写流亡困苦、细碎疲敝之状，而卫国诸臣却“褎如充耳”，盛服若聋，置若罔闻。程、蒋据此指出，这已不是单纯责卫，而是绝望之后转为劝君早归故国。","notes":null}]}]}}}
