{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/037-mao-qiu/wangli-yundu","dataHref":"/__data/shijing/annotation/037-mao-qiu/wangli-yundu/data.json","title":"詩經韻讀 · 旄丘 · 注释总览","description":"風 · 邶風 · 旄丘 · 汇集《詩經韻讀》关于《旄丘》的 2 条注释，含 2 条注脚。"},"payload":{"detail":{"route":{"poemId":"037-mao-qiu","materialId":"wangli-yundu"},"href":"/shijing/annotation/037-mao-qiu/wangli-yundu","poem":{"id":"037-mao-qiu","title":"旄丘","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","旄丘"],"segments":[{"id":"seg-001","text":"旄丘之葛兮","isActive":false},{"id":"seg-002","text":"何诞之节兮","isActive":false},{"id":"seg-003","text":"叔兮伯兮","isActive":false},{"id":"seg-004","text":"何多日也","isActive":false},{"id":"seg-005","text":"何其处也","isActive":false},{"id":"seg-006","text":"必有与也","isActive":false},{"id":"seg-007","text":"何其久也","isActive":false},{"id":"seg-008","text":"必有以也","isActive":false},{"id":"seg-009","text":"狐裘蒙戎","isActive":false},{"id":"seg-010","text":"匪车不东","isActive":false},{"id":"seg-011","text":"叔兮伯兮","isActive":false},{"id":"seg-012","text":"靡所与同","isActive":false},{"id":"seg-013","text":"琐兮尾兮","isActive":false},{"id":"seg-014","text":"流离之子","isActive":false},{"id":"seg-015","text":"叔兮伯兮","isActive":false},{"id":"seg-016","text":"褎如充耳","isActive":false}]},"material":{"id":"wangli-yundu","title":"詩經韻讀","authors":["王力"],"contributorLine":"现代 · 王力","era":"现代","publicationYear":1980,"carrier":"PDF"},"stats":{"annotationCount":2,"glossCount":2},"annotations":[{"id":"0001","order":1,"total":2,"layer":"global","layerLabel":"全篇总说","targetText":"韵读总说","targetNotes":"全篇韵读总说。","sourceLabel":"第 158 页","sourceNotes":"书内页 158《旄丘》全篇。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"王力","sectionLabel":"韵读","text":"王力《诗经韵读》把《旄丘》列为四章四句，各章自成韵转：首章“节、日”通韵，二章“处、与、久、以”间见叶转，三章“戎、东、同”为一部，四章“子、耳”再收。全篇在重章短句中形成连续催迫之势。","notes":null}]},{"id":"0002","order":2,"total":2,"layer":"span","layerLabel":"诗句片段","targetText":"旄丘之葛兮，何诞之节兮。叔兮伯兮，何多日也。何其处也，必有与也。何其久也，必有以也。狐裘蒙戎，匪车不东。叔兮伯兮，靡所与同。琐兮尾兮，流离之子。叔兮伯兮，褎如充耳。","targetNotes":"全篇韵读。","sourceLabel":"第 158 页","sourceNotes":"依据页图 /tmp/037-mao-qiu-wangli/p166.png；书内页 158 收《旄丘》全篇韵读。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"王力","sectionLabel":"韵读","text":"王力在全篇韵读中标出《旄丘》各句拟音与韵部：首章“节、日”相通，二章“处、与、久、以”层层叶转，三章“戎、东、同”归东部，四章“子、耳”入纸部。四章转韵紧凑，正与全诗由盼望转为斥绝的情势相配。","notes":null}]}]}}}
