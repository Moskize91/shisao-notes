{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/037-mao-qiu/maoheng-zhushu-kr1c0004","dataHref":"/__data/shijing/annotation/037-mao-qiu/maoheng-zhushu-kr1c0004/data.json","title":"毛詩注疏 · 旄丘 · 注释总览","description":"風 · 邶風 · 旄丘 · 汇集《毛詩注疏》关于《旄丘》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"037-mao-qiu","materialId":"maoheng-zhushu-kr1c0004"},"href":"/shijing/annotation/037-mao-qiu/maoheng-zhushu-kr1c0004","poem":{"id":"037-mao-qiu","title":"旄丘","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","旄丘"],"segments":[{"id":"seg-001","text":"旄丘之葛兮","isActive":false},{"id":"seg-002","text":"何誕之節兮","isActive":false},{"id":"seg-003","text":"叔兮伯兮","isActive":false},{"id":"seg-004","text":"何多日也","isActive":false},{"id":"seg-005","text":"何其處也","isActive":false},{"id":"seg-006","text":"必有與也","isActive":false},{"id":"seg-007","text":"何其久也","isActive":false},{"id":"seg-008","text":"必有以也","isActive":false},{"id":"seg-009","text":"狐裘蒙戎","isActive":false},{"id":"seg-010","text":"匪車不東","isActive":false},{"id":"seg-011","text":"叔兮伯兮","isActive":false},{"id":"seg-012","text":"靡所與同","isActive":false},{"id":"seg-013","text":"瑣兮尾兮","isActive":false},{"id":"seg-014","text":"流離之子","isActive":false},{"id":"seg-015","text":"叔兮伯兮","isActive":false},{"id":"seg-016","text":"褎如充耳","isActive":false}]},"material":{"id":"maoheng-zhushu-kr1c0004","title":"毛詩注疏","authors":["毛亨","鄭氏","孔穎達"],"contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","era":"漢唐","publicationYear":653,"carrier":"TXT"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"preface","layerLabel":"篇序","targetText":"旄丘責衛伯也狄人迫逐黎侯黎侯寓於衛衛不能脩方伯連率之職黎之臣子以責於衛也","targetNotes":"篇首小序。","sourceLabel":null,"sourceNotes":"对应《毛詩正義/卷二》篇首小序。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序","text":"序：《旄丘》，責衛伯也。狄人迫逐黎侯，黎侯寓於衛，衛不能脩方伯連率之職，黎之臣子以責於衛也。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"旄丘之葛兮，何誕之節兮。叔兮伯兮，何多日也。","targetNotes":"第1章毛傳撮要。","sourceLabel":null,"sourceNotes":"对应《毛詩正義/卷二》第1章。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"毛传","sectionLabel":"傳","text":"毛传以旄丘之葛起兴，训“誕”为阔大，由葛之延蔓写时日之久；“叔”“伯”皆指卫之诸臣。首章即从久望不至发问，起责卫之端。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"何其處也，必有與也。何其久也，必有以也。","targetNotes":"第2章毛傳撮要。","sourceLabel":null,"sourceNotes":"对应《毛詩正義/卷二》第2章。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"毛传","sectionLabel":"傳","text":"毛传释“與”为与国相待而俱来，“以”为他故。第二章连续设想卫迟来必另有缘由，是黎臣强作解慰之辞，反显久待之切。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"狐裘蒙戎，匪車不東。叔兮伯兮，靡所與同。","targetNotes":"第3章毛傳撮要。","sourceLabel":null,"sourceNotes":"对应《毛詩正義/卷二》第3章。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"毛传","sectionLabel":"傳","text":"毛传训“蒙戎”为乱貌弊敝，“不東”谓卫车不向东来；“靡所與同”则明言卫之诸臣与我不同心。三章在希望之后转为失望。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"瑣兮尾兮，流離之子。叔兮伯兮，褎如充耳。","targetNotes":"第4章毛傳撮要。","sourceLabel":null,"sourceNotes":"对应《毛詩正義/卷二》第4章。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"毛传","sectionLabel":"傳","text":"毛传释“瑣”为细，“尾”为末，“流離”为流散，“褎如充耳”为盛服而塞耳不闻。末章极写流亡者困苦与卫臣充耳不闻之冷漠，责意毕见。","notes":null}]}]}}}
