{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/037-mao-qiu/chenhuan-chuanshu","dataHref":"/__data/shijing/annotation/037-mao-qiu/chenhuan-chuanshu/data.json","title":"詩毛氏傳疏 · 旄丘 · 注释总览","description":"風 · 邶風 · 旄丘 · 汇集《詩毛氏傳疏》关于《旄丘》的 2 条注释，含 2 条注脚。"},"payload":{"detail":{"route":{"poemId":"037-mao-qiu","materialId":"chenhuan-chuanshu"},"href":"/shijing/annotation/037-mao-qiu/chenhuan-chuanshu","poem":{"id":"037-mao-qiu","title":"旄丘","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","旄丘"],"segments":[{"id":"seg-001","text":"旄丘之葛兮","isActive":false},{"id":"seg-002","text":"何誕之節兮","isActive":false},{"id":"seg-003","text":"叔兮伯兮","isActive":false},{"id":"seg-004","text":"何多日也","isActive":false},{"id":"seg-005","text":"何其處也","isActive":false},{"id":"seg-006","text":"必有與也","isActive":false},{"id":"seg-007","text":"何其久也","isActive":false},{"id":"seg-008","text":"必有以也","isActive":false},{"id":"seg-009","text":"狐裘蒙戎","isActive":false},{"id":"seg-010","text":"匪車不東","isActive":false},{"id":"seg-011","text":"叔兮伯兮","isActive":false},{"id":"seg-012","text":"靡所與同","isActive":false},{"id":"seg-013","text":"瑣兮尾兮","isActive":false},{"id":"seg-014","text":"流離之子","isActive":false},{"id":"seg-015","text":"叔兮伯兮","isActive":false},{"id":"seg-016","text":"褎如充耳","isActive":false}]},"material":{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","authors":["陳奐"],"contributorLine":"清 · 陳奐","era":"清","publicationYear":1847,"carrier":"PDF"},"stats":{"annotationCount":2,"glossCount":2},"annotations":[{"id":"0001","order":1,"total":2,"layer":"preface","layerLabel":"篇序","targetText":"旄丘責衛伯也狄人迫逐黎侯黎侯寓於衛衛不能脩方伯連率之職黎之臣子以責於衛也","targetNotes":"篇首小序。","sourceLabel":"第 61 页","sourceNotes":"书内页 61 篇首序文。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序","text":"序：《旄丘》，責衛伯也。狄人迫逐黎侯，黎侯寓於衛，衛不能脩方伯連率之職，黎之臣子以責於衛也。","notes":null}]},{"id":"0002","order":2,"total":2,"layer":"span","layerLabel":"诗句片段","targetText":"旄丘之葛兮，何誕之節兮。叔兮伯兮，何多日也。何其處也，必有與也。何其久也，必有以也。狐裘蒙戎，匪車不東。叔兮伯兮，靡所與同。瑣兮尾兮，流離之子。叔兮伯兮，褎如充耳。","targetNotes":"通篇经传疏解。","sourceLabel":"第 61-62 页","sourceNotes":"据第 61-62 页《旄丘》经传疏。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"陈奂疏《旄丘》时紧承《序》责卫伯说，认为全诗从久望其来、为其迟来设辞，到见其狐裘乘车而终不东来，再至末章责其盛服充耳、绝无同心，层层写出黎臣责卫不修方伯之职。其疏重心在于坐实诗旨为责卫，而非泛写流离之苦。","notes":null}]}]}}}
