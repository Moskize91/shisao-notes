{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/012-que-chao/chengjunying-jiangjianyuan-zhuxi","dataHref":"/__data/shijing/annotation/012-que-chao/chengjunying-jiangjianyuan-zhuxi/data.json","title":"詩經注析 · 鵲巢 · 注释总览","description":"風 · 召南 · 鵲巢 · 汇集《詩經注析》关于《鵲巢》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"012-que-chao","materialId":"chengjunying-jiangjianyuan-zhuxi"},"href":"/shijing/annotation/012-que-chao/chengjunying-jiangjianyuan-zhuxi","poem":{"id":"012-que-chao","title":"鵲巢","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","鵲巢"],"segments":[{"id":"seg-001","text":"維鵲有巢","isActive":false},{"id":"seg-002","text":"維鳩居之","isActive":false},{"id":"seg-003","text":"之子于歸","isActive":false},{"id":"seg-004","text":"百兩御之","isActive":false},{"id":"seg-005","text":"維鵲有巢","isActive":false},{"id":"seg-006","text":"維鳩方之","isActive":false},{"id":"seg-007","text":"之子于歸","isActive":false},{"id":"seg-008","text":"百兩將之","isActive":false},{"id":"seg-009","text":"維鵲有巢","isActive":false},{"id":"seg-010","text":"維鳩盈之","isActive":false},{"id":"seg-011","text":"之子于歸","isActive":false},{"id":"seg-012","text":"百兩成之","isActive":false}]},"material":{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","authors":["程俊英","蔣見元"],"contributorLine":"现代 · 程俊英、蔣見元","era":"现代","publicationYear":1991,"carrier":"PDF"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"題解","targetNotes":"题解总说。","sourceLabel":"第 22 页","sourceNotes":"书内页 22《鹊巢》题解。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"题解将此篇视为一首颂新娘的诗，认为诗人见鸠居鹊巢而联想到女子出嫁住进男家，故借此起兴；又因诗中写迎亲车辆众多，所以判断新娘出身贵族。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"維鵲有巢，維鳩居之。之子于歸，百兩御之。","targetNotes":"首章。","sourceLabel":"第 22 页","sourceNotes":"书内页 22 首章与注释。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"注释以“维”为语首助词，释“鹊”为喜鹊，“鸠”从王先谦等说作今之八哥，并引其乘鹊空巢而居的解释；又以“百两”为车乘众多、“御”为迎接，说明首章写迎亲之盛。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"維鵲有巢，維鳩方之。之子于歸，百兩將之。","targetNotes":"第二章。","sourceLabel":"第 23 页","sourceNotes":"书内页 23 第二章与注释。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"此章释“方”为占有，并据校勘指出毛传“有之也”中的“之”或为衍字；又把“將”解释为护卫、扶持，援引马瑞辰之说说明二章所写是迎妇在途时的护送场景。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"維鵲有巢，維鳩盈之。之子于歸，百兩成之。","targetNotes":"第三章。","sourceLabel":"第 23 页","sourceNotes":"书内页 23 第三章与注释。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"末章以“盈”为住满，解释为陪嫁媵从甚多；又以“成”为婚礼告成，援引郑笺与毛传说明此章所写是女方既至、礼成而婚姻圆满的阶段。","notes":null}]}]}}}
