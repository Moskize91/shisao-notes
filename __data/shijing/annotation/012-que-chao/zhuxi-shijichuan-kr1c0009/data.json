{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/012-que-chao/zhuxi-shijichuan-kr1c0009","dataHref":"/__data/shijing/annotation/012-que-chao/zhuxi-shijichuan-kr1c0009/data.json","title":"詩集傳 · 鵲巢 · 注释总览","description":"風 · 召南 · 鵲巢 · 汇集《詩集傳》关于《鵲巢》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"012-que-chao","materialId":"zhuxi-shijichuan-kr1c0009"},"href":"/shijing/annotation/012-que-chao/zhuxi-shijichuan-kr1c0009","poem":{"id":"012-que-chao","title":"鵲巢","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","鵲巢"],"segments":[{"id":"seg-001","text":"維鵲有巢","isActive":false},{"id":"seg-002","text":"維鳩居之","isActive":false},{"id":"seg-003","text":"之子于歸","isActive":false},{"id":"seg-004","text":"百兩御之","isActive":false},{"id":"seg-005","text":"維鵲有巢","isActive":false},{"id":"seg-006","text":"維鳩方之","isActive":false},{"id":"seg-007","text":"之子于歸","isActive":false},{"id":"seg-008","text":"百兩將之","isActive":false},{"id":"seg-009","text":"維鵲有巢","isActive":false},{"id":"seg-010","text":"維鳩盈之","isActive":false},{"id":"seg-011","text":"之子于歸","isActive":false},{"id":"seg-012","text":"百兩成之","isActive":false}]},"material":{"id":"zhuxi-shijichuan-kr1c0009","title":"詩集傳","authors":["朱熹"],"contributorLine":"宋 · 朱熹","era":"宋","publicationYear":1186,"carrier":"TXT"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"鵲巢三章章四句","targetNotes":"章句总说。","sourceLabel":null,"sourceNotes":"对应 txt 256 行。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"朱熹","sectionLabel":"章次","text":"朱熹以此篇为三章四句，认为南国诸侯受文王之化，其女子又被后妃之德，所以出嫁于诸侯而家人作诗美之；全诗借鹊巢鸠居起兴，意近《周南》之《关雎》。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"維鵲有巢維鳩居之之子于歸百兩御之","targetNotes":"第一章。","sourceLabel":null,"sourceNotes":"对应 txt 245-252 行。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"朱熹","sectionLabel":null,"text":"朱熹释首章为兴，谓鹊已成巢而鸠来居之，用以比南国诸侯之女出嫁于诸侯；“百两御之”则写众多车乘前来迎妇，见其礼备而家人称美。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"維鵲有巢維鳩方之之子于歸百兩將之","targetNotes":"第二章。","sourceLabel":null,"sourceNotes":"对应 txt 252-253 行。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"朱熹","sectionLabel":null,"text":"此章承首章而进一步说明“方”是有之，“將”是送之，仍从鸠据鹊巢起兴，转写女子既归而送嫁成行，婚礼秩序井然。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"維鵲有巢維鳩盈之之子于歸百兩成之","targetNotes":"第三章。","sourceLabel":null,"sourceNotes":"对应 txt 254-255 行。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"朱熹","sectionLabel":null,"text":"朱熹以“盈”训满，指众多媵、姪、娣从嫁而来；“成”则为成其礼，故末章写婚礼圆成，既见车马之盛，也见宗姻配合之备。","notes":null}]}]}}}
