{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/012-que-chao/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/012-que-chao/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 鵲巢 · 注释总览","description":"風 · 召南 · 鵲巢 · 汇集《诗经原始(上下)》关于《鵲巢》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"012-que-chao","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/012-que-chao/fangyurun-yuanshi","poem":{"id":"012-que-chao","title":"鵲巢","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","鵲巢"],"segments":[{"id":"seg-001","text":"維鵲有巢","isActive":false},{"id":"seg-002","text":"維鳩居之","isActive":false},{"id":"seg-003","text":"之子于歸","isActive":false},{"id":"seg-004","text":"百兩御之","isActive":false},{"id":"seg-005","text":"維鵲有巢","isActive":false},{"id":"seg-006","text":"維鳩方之","isActive":false},{"id":"seg-007","text":"之子于歸","isActive":false},{"id":"seg-008","text":"百兩將之","isActive":false},{"id":"seg-009","text":"維鵲有巢","isActive":false},{"id":"seg-010","text":"維鳩盈之","isActive":false},{"id":"seg-011","text":"之子于歸","isActive":false},{"id":"seg-012","text":"百兩成之","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"鵲巢㊟昏禮告廟詞也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 item-0023.txt 第 3 行。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注","text":"方玉润开篇即把《鵲巢》定为婚礼告庙之词，认为它不是泛论妇德，而是与新昏礼仪直接相关的祝告歌章。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"維鵲有巢，維鳩居之。之子于歸，百兩御之。","targetNotes":"第一章。","sourceLabel":null,"sourceNotes":"对应 item-0023.txt 第 5 行。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":null,"text":"方玉润以鹊巢比他人成室，以鸠比新昏之人，首章借已有巢室与来居其中的鸠写女子于归、百辆迎御的婚仪场面，语气近于祝词。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"維鵲有巢，維鳩方之。之子于歸，百兩將之。","targetNotes":"第二章。","sourceLabel":null,"sourceNotes":"对应 item-0023.txt 第 6 行。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":null,"text":"此章以“方”“將”推进礼成的过程，在方玉润看来，重点仍是写新妇既归而送嫁成行，并非旧说所谓鹊巧鸠拙、女子借男室而居的牵强比附。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"維鵲有巢，維鳩盈之。之子于歸，百兩成之。","targetNotes":"第三章。","sourceLabel":null,"sourceNotes":"对应 item-0023.txt 第 7 行。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":null,"text":"末章以“盈”“成”收束全篇，方玉润据此强调婚礼既盛且成，既可见媵从充盈、室家辉煌，也可见祝其多男、肯堂肯构的意味。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"右《鵲巢》三章，章四句。","targetNotes":"章句总说与总评。","sourceLabel":null,"sourceNotes":"对应 item-0023.txt 第 9-17 行。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"方玉润","sectionLabel":"总评","text":"方玉润总论此篇时，反对《序》《传》以来把鹊巢鸠居硬解为女居男室的附会，主张鹊巢是比他人成室，鸠是借譬新昏之人，故全诗本旨在歌咏婚礼告庙与室家成就，而非空谈妇德。","notes":null}]}]}}}
