{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/012-que-chao/chenhuan-chuanshu","dataHref":"/__data/shijing/annotation/012-que-chao/chenhuan-chuanshu/data.json","title":"詩毛氏傳疏 · 鵲巢 · 注释总览","description":"風 · 召南 · 鵲巢 · 汇集《詩毛氏傳疏》关于《鵲巢》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"012-que-chao","materialId":"chenhuan-chuanshu"},"href":"/shijing/annotation/012-que-chao/chenhuan-chuanshu","poem":{"id":"012-que-chao","title":"鵲巢","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","鵲巢"],"segments":[{"id":"seg-001","text":"維鵲有巢","isActive":false},{"id":"seg-002","text":"維鳩居之","isActive":false},{"id":"seg-003","text":"之子于歸","isActive":false},{"id":"seg-004","text":"百兩御之","isActive":false},{"id":"seg-005","text":"維鵲有巢","isActive":false},{"id":"seg-006","text":"維鳩方之","isActive":false},{"id":"seg-007","text":"之子于歸","isActive":false},{"id":"seg-008","text":"百兩將之","isActive":false},{"id":"seg-009","text":"維鵲有巢","isActive":false},{"id":"seg-010","text":"維鳩盈之","isActive":false},{"id":"seg-011","text":"之子于歸","isActive":false},{"id":"seg-012","text":"百兩成之","isActive":false}]},"material":{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","authors":["陳奐"],"contributorLine":"清 · 陳奐","era":"清","publicationYear":1847,"carrier":"PDF"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"preface","layerLabel":"篇序","targetText":"鵲巢，夫人之德也。國君積行累功，以致爵位。夫人起家而居有之。德如鳩，乃可以配焉。","targetNotes":"篇首序文。","sourceLabel":"第 38-39 页","sourceNotes":"据第 38-39 页《召南》下《鵲巢》篇首序义。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"疏承《序》以《鵲巢》为夫人有德足以配君之诗，认为国君积行累功而得其位，夫人亦须有德而后可居其室；鸠居鹊巢之兴，正是以居位得配来明婚配相称。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"維鵲有巢。維鳩居之。之子于歸。百兩御之。","targetNotes":"第一章。","sourceLabel":"第 38 页","sourceNotes":"据第 38 页中段《鵲巢》首章。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"疏以鹊巢既成而鸠来居起兴，申说有德者乃可居其位；“百兩御之”则从迎妇车马之盛写夫人将归，见其礼备而足称嘉偶。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"維鵲有巢。維鳩方之。之子于歸。百兩將之。","targetNotes":"第二章。","sourceLabel":"第 38-39 页","sourceNotes":"据第 38 页下段续至第 39 页上段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"疏释二章时，围绕“方”“將”分说鸠既据巢、送嫁在途之义，认为诗意由居室之譬推进到迎送之礼，显其婚仪有序而宗姻相将。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"維鵲有巢。維鳩盈之。之子于歸。百兩成之。","targetNotes":"第三章。","sourceLabel":"第 39 页","sourceNotes":"据第 39 页中段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"疏释末章以“盈”为满，见媵从之众；以“成”为成礼，指女既至而礼成，故以从行繁盛与婚仪圆备收束全篇。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"鵲巢三章章四句","targetNotes":"章句总说。","sourceLabel":"第 37 页","sourceNotes":"据第 37 页中部章句总说。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"疏以“鵲巢三章章四句”总束全篇，表明此诗依三章重章递进，由居巢起兴而终归礼成之盛。","notes":null}]}]}}}
