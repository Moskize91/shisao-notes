{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/036-shi-wei/chenhuan-chuanshu","dataHref":"/__data/shijing/annotation/036-shi-wei/chenhuan-chuanshu/data.json","title":"詩毛氏傳疏 · 式微 · 注释总览","description":"風 · 邶風 · 式微 · 汇集《詩毛氏傳疏》关于《式微》的 2 条注释，含 2 条注脚。"},"payload":{"detail":{"route":{"poemId":"036-shi-wei","materialId":"chenhuan-chuanshu"},"href":"/shijing/annotation/036-shi-wei/chenhuan-chuanshu","poem":{"id":"036-shi-wei","title":"式微","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","式微"],"segments":[{"id":"seg-001","text":"式微式微","isActive":false},{"id":"seg-002","text":"胡不歸","isActive":false},{"id":"seg-003","text":"微君之故","isActive":false},{"id":"seg-004","text":"胡爲乎中露","isActive":false},{"id":"seg-005","text":"式微式微","isActive":false},{"id":"seg-006","text":"胡不歸","isActive":false},{"id":"seg-007","text":"微君之躬","isActive":false},{"id":"seg-008","text":"胡爲乎泥中","isActive":false}]},"material":{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","authors":["陳奐"],"contributorLine":"清 · 陳奐","era":"清","publicationYear":1847,"carrier":"PDF"},"stats":{"annotationCount":2,"glossCount":2},"annotations":[{"id":"0001","order":1,"total":2,"layer":"preface","layerLabel":"篇序","targetText":"式微黎侯寓于衛其臣勸以歸也","targetNotes":"篇首小序。","sourceLabel":"第 60 页","sourceNotes":"书内页 60 篇首序文。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序","text":"序：《式微》，黎侯寓于衛，其臣勸以歸也。","notes":null}]},{"id":"0002","order":2,"total":2,"layer":"span","layerLabel":"诗句片段","targetText":"式微式微，胡不歸。微君之故，胡爲乎中露。式微式微，胡不歸。微君之躬，胡爲乎泥中。","targetNotes":"通篇经传疏解。","sourceLabel":"第 60-61 页","sourceNotes":"据第 60-61 页《式微》经传疏。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"陈奂疏《式微》时遵《序》说，以为黎侯失国寓卫，其臣见其久居异国、露处泥行，故作诗促其早归。其疏围绕“微君之故”“微君之躬”两句，分辨一章责为君事劳苦，二章责亲从君身而陷泥涂，语短而意益切。","notes":null}]}]}}}
