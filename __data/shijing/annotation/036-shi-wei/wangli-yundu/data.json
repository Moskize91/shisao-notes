{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/036-shi-wei/wangli-yundu","dataHref":"/__data/shijing/annotation/036-shi-wei/wangli-yundu/data.json","title":"詩經韻讀 · 式微 · 注释总览","description":"風 · 邶風 · 式微 · 汇集《詩經韻讀》关于《式微》的 2 条注释，含 2 条注脚。"},"payload":{"detail":{"route":{"poemId":"036-shi-wei","materialId":"wangli-yundu"},"href":"/shijing/annotation/036-shi-wei/wangli-yundu","poem":{"id":"036-shi-wei","title":"式微","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","式微"],"segments":[{"id":"seg-001","text":"式微式微","isActive":false},{"id":"seg-002","text":"胡不归","isActive":false},{"id":"seg-003","text":"微君之故","isActive":false},{"id":"seg-004","text":"胡为乎中露","isActive":false},{"id":"seg-005","text":"式微式微","isActive":false},{"id":"seg-006","text":"胡不归","isActive":false},{"id":"seg-007","text":"微君之躬","isActive":false},{"id":"seg-008","text":"胡为乎泥中","isActive":false}]},"material":{"id":"wangli-yundu","title":"詩經韻讀","authors":["王力"],"contributorLine":"现代 · 王力","era":"现代","publicationYear":1980,"carrier":"PDF"},"stats":{"annotationCount":2,"glossCount":2},"annotations":[{"id":"0001","order":1,"total":2,"layer":"global","layerLabel":"全篇总说","targetText":"韵读总说","targetNotes":"全篇韵读总说。","sourceLabel":"第 157 页","sourceNotes":"书内页 157《式微》全篇。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"王力","sectionLabel":"韵读","text":"王力《诗经韵读》把《式微》列为二章四句，首章以“归”属微部、“露”属鱼部，次章以“归”仍归微部、“躬”“中”转入中部。全篇以极短篇幅完成一次重复和一次转韵，声调上正与反复设问的句法相应。","notes":null}]},{"id":"0002","order":2,"total":2,"layer":"span","layerLabel":"诗句片段","targetText":"式微式微，胡不归。微君之故，胡为乎中露。式微式微，胡不归。微君之躬，胡为乎泥中。","targetNotes":"全篇韵读。","sourceLabel":"第 157 页","sourceNotes":"依据页图 /tmp/036-shi-wei-wangli/p165.png；书内页 157 收《式微》全篇韵读。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"王力","sectionLabel":"韵读","text":"王力在全篇韵读中标出《式微》两章拟音与韵部：首章“归”入微部，“故、露”入鱼部；次章仍以“归”承微部，而“躬、中”则转入中部。两章只换结句用韵，最能显出重章叠唱中语意的微妙转深。","notes":null}]}]}}}
