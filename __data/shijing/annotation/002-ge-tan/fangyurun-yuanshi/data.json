{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/002-ge-tan/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/002-ge-tan/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 葛覃 · 注释总览","description":"風 · 周南 · 葛覃 · 汇集《诗经原始(上下)》关于《葛覃》的 7 条注释，含 7 条注脚。"},"payload":{"detail":{"route":{"poemId":"002-ge-tan","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/002-ge-tan/fangyurun-yuanshi","poem":{"id":"002-ge-tan","title":"葛覃","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","葛覃"],"segments":[{"id":"seg-001","text":"葛之覃兮","isActive":false},{"id":"seg-002","text":"施于中谷","isActive":false},{"id":"seg-003","text":"維葉萋萋","isActive":false},{"id":"seg-004","text":"黄鳥于飛","isActive":false},{"id":"seg-005","text":"集于灌木","isActive":false},{"id":"seg-006","text":"其鳴喈喈","isActive":false},{"id":"seg-007","text":"葛之覃兮","isActive":false},{"id":"seg-008","text":"施于中谷","isActive":false},{"id":"seg-009","text":"維葉莫莫","isActive":false},{"id":"seg-010","text":"是刈是濩","isActive":false},{"id":"seg-011","text":"爲絺爲綌","isActive":false},{"id":"seg-012","text":"服之無斁","isActive":false},{"id":"seg-013","text":"言告師氏","isActive":false},{"id":"seg-014","text":"言告言歸","isActive":false},{"id":"seg-015","text":"薄污我私","isActive":false},{"id":"seg-016","text":"薄澣我衣","isActive":false},{"id":"seg-017","text":"害澣害否","isActive":false},{"id":"seg-018","text":"歸寧父母","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":7,"glossCount":7},"annotations":[{"id":"0001","order":1,"total":7,"layer":"global","layerLabel":"全篇总说","targetText":"题注与章次总提","targetNotes":"对应 item-0011 开头题注与三章章次。","sourceLabel":null,"sourceNotes":"item-0011.txt 第 3-7 行。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注","text":"题注为“因歸寧而敦婦本也”。作者并以三章次第总提：首章“略點景物”，次章“一篇之主”，末章点明“歸寧”。","notes":null}]},{"id":"0002","order":2,"total":7,"layer":"span","layerLabel":"诗句片段","targetText":"葛之覃兮，施于中谷，維葉萋萋。黄鳥于飛，集于灌木，其鳴喈喈。","targetNotes":"第一章。","sourceLabel":null,"sourceNotes":"item-0011.txt 第 5 行第一分句。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":null,"text":"方氏将首章概为“略點景物”，视其为由葛叶、黄鸟、灌木、和鸣景象起笔，以便后文从见物而联想到治葛、服葛与归宁之事。","notes":null}]},{"id":"0003","order":3,"total":7,"layer":"span","layerLabel":"诗句片段","targetText":"葛之覃兮，施于中谷，維葉莫莫。是刈是濩，爲絺爲綌，服之無斁。","targetNotes":"第二章。","sourceLabel":null,"sourceNotes":"item-0011.txt 第 6 行。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":null,"text":"方氏以“是刈是濩，爲絺爲綌，服之無斁”为“一篇之主”，认为本诗核心在于由治葛成布写出勤俭妇德，并为第三章的污澣与归宁作铺垫。","notes":null}]},{"id":"0004","order":4,"total":7,"layer":"span","layerLabel":"诗句片段","targetText":"言告師氏，言告言歸。薄污我私，薄澣我衣。害澣害否，歸寧父母。","targetNotes":"第三章及眉评。","sourceLabel":null,"sourceNotes":"item-0011.txt 第 7-11 行。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":"眉评","text":"第三章点明归宁。眉评又指出正面三“言”字、两“薄”字、两“害”字，说得从容不迫，正见大家闺范贤媛口吻。","notes":null}]},{"id":"0005","order":5,"total":7,"layer":"global","layerLabel":"全篇总说","targetText":"总评与篇旨辨析","targetNotes":"右《葛覃》三章后总评。","sourceLabel":null,"sourceNotes":"item-0011.txt 第 9 行。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"方玉润","sectionLabel":"总评","text":"方氏反对把《葛覃》直解为“后妃所自作”，认为此诗与《關雎》同属房中乐，不过彼写初昏，此写归宁。其义脉是因归宁而污澣，因污澣而念絺綌，因絺綌而追想到葛之初生至刈濩，以见一物成就不易、服之不当厌弃；同时也借此见周家王业以勤俭为本，民间妇道因而成风。","notes":null}]},{"id":"0006","order":6,"total":7,"layer":"term","layerLabel":"字词注","targetText":"葛之覃兮／黄鳥于飛／集于灌木／其鳴喈喈／維葉莫莫／爲絺爲綌／服之無斁／言告師氏／薄污我私／薄澣我衣／害澣害否／歸寧父母","targetNotes":"集释中关键训诂组。","sourceLabel":null,"sourceNotes":"item-0011.txt 第 13 行。","notes":null,"glosses":[{"key":"0006-1","attributionLabel":"集释","sectionLabel":null,"text":"集释汇总《集传》、陆玑、毛萇、陆德明、王安石、姚际恒诸说：释葛为可作絺綌之草，黄鸟为鸝并引诸名，灌木为叢木，喈喈为和声，莫莫为茂密；又释絺綌精麤之别、斁为厌、师氏为女师，污与澣的用力层次、私衣与礼衣之分、害为何、归宁为归问父母安。","notes":null}]},{"id":"0007","order":7,"total":7,"layer":"global","layerLabel":"全篇总说","targetText":"标韵","targetNotes":"各章韵脚与通韵说明。","sourceLabel":null,"sourceNotes":"item-0011.txt 第 15 行。","notes":null,"glosses":[{"key":"0007-1","attributionLabel":"标韵","sectionLabel":null,"text":"标韵将首章归“谷一屋”“木同”本韵，并以“萋”“喈”为通韵隔句叶；次章以“莫”“濩”为本韵，“綌”“斁”转入陌韵并说明“斁”又与遇韵相叶；末章则以“歸”“衣”通韵，“否”“母”同押有韵。","notes":null}]}]}}}
