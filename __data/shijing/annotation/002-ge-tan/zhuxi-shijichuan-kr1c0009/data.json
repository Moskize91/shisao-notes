{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/002-ge-tan/zhuxi-shijichuan-kr1c0009","dataHref":"/__data/shijing/annotation/002-ge-tan/zhuxi-shijichuan-kr1c0009/data.json","title":"詩集傳 · 葛覃 · 注释总览","description":"風 · 周南 · 葛覃 · 汇集《詩集傳》关于《葛覃》的 4 条注释，含 8 条注脚。"},"payload":{"detail":{"route":{"poemId":"002-ge-tan","materialId":"zhuxi-shijichuan-kr1c0009"},"href":"/shijing/annotation/002-ge-tan/zhuxi-shijichuan-kr1c0009","poem":{"id":"002-ge-tan","title":"葛覃","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","葛覃"],"segments":[{"id":"seg-001","text":"葛之覃兮","isActive":true},{"id":"seg-002","text":"施于中谷","isActive":true},{"id":"seg-003","text":"維葉萋萋","isActive":true},{"id":"seg-004","text":"黃鳥于飛","isActive":true},{"id":"seg-005","text":"集于灌木","isActive":true},{"id":"seg-006","text":"其鳴喈喈","isActive":true},{"id":"seg-007","text":"葛之覃兮","isActive":false},{"id":"seg-008","text":"施于中谷","isActive":false},{"id":"seg-009","text":"維葉莫莫","isActive":false},{"id":"seg-010","text":"是刈是濩","isActive":false},{"id":"seg-011","text":"為絺為綌","isActive":false},{"id":"seg-012","text":"服之無斁","isActive":false},{"id":"seg-013","text":"言告師氏","isActive":false},{"id":"seg-014","text":"言告言歸","isActive":false},{"id":"seg-015","text":"薄汙我私","isActive":false},{"id":"seg-016","text":"薄澣我衣","isActive":false},{"id":"seg-017","text":"害澣害否","isActive":false},{"id":"seg-018","text":"歸寧父母","isActive":false}]},"material":{"id":"zhuxi-shijichuan-kr1c0009","title":"詩集傳","authors":["朱熹"],"contributorLine":"宋 · 朱熹","era":"宋","publicationYear":1186,"carrier":"TXT"},"stats":{"annotationCount":4,"glossCount":8},"annotations":[{"id":"0001","order":1,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"葛之覃兮，施于中谷，維葉萋萋。黃鳥于飛，集于灌木，其鳴喈喈。","targetNotes":"首章并章句说明。","sourceLabel":null,"sourceNotes":"对应 txt 83-87 行。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"朱熹","sectionLabel":"传","text":"賦也。葛，草名，蔓生，可爲絺綌者。覃，延。施，移也。中谷，谷中也。萋萋，盛貌。黃鳥，鸝也。灌木，叢木也。喈喈，和聲之遠聞也。","notes":null},{"key":"0001-2","attributionLabel":"朱熹","sectionLabel":"传","text":"蓋后妃旣成絺綌，而賦其事，追叙初夏之時葛葉方盛而有黃鳥鳴於其上也。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"葛之覃兮，施于中谷，維葉莫莫。是刈是濩，為絺為綌，服之無斁。","targetNotes":"次章并章句说明。","sourceLabel":null,"sourceNotes":"对应 txt 88-93 行。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"朱熹","sectionLabel":"传","text":"賦也。莫莫，茂密貌。刈，斬。濩，煮也。精曰絺，麤曰綌。斁，厭也。","notes":null},{"key":"0002-2","attributionLabel":"朱熹","sectionLabel":"传","text":"此言盛夏之時葛旣成矣，於是治以爲布，而服之無厭。蓋親執其勞而知其成之不易，所以心誠愛之，雖極垢弊而不忍厭弃也。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"言告師氏，言告言歸。薄汙我私，薄澣我衣。害澣害否，歸寧父母。","targetNotes":"末章并章句说明。","sourceLabel":null,"sourceNotes":"对应 txt 94-101 行。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"朱熹","sectionLabel":"传","text":"賦也。言，辭也。師，女師也。薄，猶少也。汙，煩撋之以去其汙，猶治亂而曰亂也。澣，則濯之而已。私，燕服也。衣，禮服也。害，何也。寧，安也，謂問安也。","notes":null},{"key":"0003-2","attributionLabel":"朱熹","sectionLabel":"传","text":"上章旣成絺綌之服矣，此章遂告其師氏，使告于君子以將歸寧之意。且曰：盍治其私服之汙，而澣其禮服之衣乎？何者當澣，而何者可以未澣乎？我將服之以歸寧於父母矣。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"篇末总评","targetNotes":"全篇章法与义旨总结。","sourceLabel":null,"sourceNotes":"对应 txt 102-106 行。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"朱熹","sectionLabel":"总评","text":"此詩后妃所自作，故無贊美之詞；然於此可以見其已貴而能勤，已富而能儉，已長而敬不弛於師傅，已嫁而孝不衰於父母，是皆德之厚而人所難也。","notes":null},{"key":"0004-2","attributionLabel":"朱熹","sectionLabel":"总评","text":"小序以爲后妃之本，庶幾近之。","notes":null}]}]}}}
