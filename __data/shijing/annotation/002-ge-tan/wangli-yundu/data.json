der":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"葛之覃兮，施于中谷／维叶萋萋／黄鸟于飞／集于灌木／其鸣喈喈","targetNotes":"首章。","sourceLabel":"第 146 页","sourceNotes":"第 146 页《葛覃》首章。","notes":"本条对应首章韵读。","glosses":[{"key":"0002-1","attributionLabel":"王力","sectionLabel":"韵读","text":"葛之覃兮，施于中谷(kok)。（与“木”协）维叶萋萋(tsyei)。黄鸟于飞(piuai)，集于灌木(mok)。（屋部）其鸣喈喈(kei)。（脂微合韵）","notes":"据页图转写，保留句末拟音与韵部。"}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"葛之覃兮，施于中谷／维叶莫莫／是刈是濩／为絺为绤／服之无斁","targetNotes":"第二章。","sourceLabel":"第 146 页","sourceNotes":"第 146 页《葛覃》第二章。","notes":"本条对应第二章韵读。","glosses":[{"key":"0003-1","attributionLabel":"王力","sectionLabel":"韵读","text":"葛之覃兮，施于中谷(kok)。（与上章遥韵）维叶莫莫(mak)。是刈是濩(huak)，为絺为绤(khyak)，服之无斁(yiak)。（铎部）","notes":"据页图转写，保留句末拟音与韵部。"}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"言告师氏，言告言归／薄污我私，薄浣我衣／害浣害否／归宁父母","targetNotes":"第三章。","sourceLabel":"第 146 页局部","sourceNotes":"仅取第 146 页《葛覃》第三章，后文已转入《卷耳》。","notes":"本条对应第三章韵读。","glosses":[{"key":"0004-1","attributionLabel":"王力","sectionLabel":"韵读","text":"言告师氏，言告言归(kiuai)。薄污我私，薄浣我衣(iai)。（微部）害浣害否(piua)，归宁父母(ma)。（之部）","notes":"据页图转写，保留句末拟音与韵部。"}]}]}}}
