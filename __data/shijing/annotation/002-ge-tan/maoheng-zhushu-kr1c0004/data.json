{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/002-ge-tan/maoheng-zhushu-kr1c0004","dataHref":"/__data/shijing/annotation/002-ge-tan/maoheng-zhushu-kr1c0004/data.json","title":"毛詩注疏 · 葛覃 · 注释总览","description":"風 · 周南 · 葛覃 · 汇集《毛詩注疏》关于《葛覃》的 5 条注释，含 9 条注脚。"},"payload":{"detail":{"route":{"poemId":"002-ge-tan","materialId":"maoheng-zhushu-kr1c0004"},"href":"/shijing/annotation/002-ge-tan/maoheng-zhushu-kr1c0004","poem":{"id":"002-ge-tan","title":"葛覃","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","葛覃"],"segments":[{"id":"seg-001","text":"葛之覃兮","isActive":false},{"id":"seg-002","text":"施于中谷","isActive":false},{"id":"seg-003","text":"維葉萋萋","isActive":false},{"id":"seg-004","text":"黃鳥于飛","isActive":false},{"id":"seg-005","text":"集于灌木","isActive":false},{"id":"seg-006","text":"其鳴喈喈","isActive":false},{"id":"seg-007","text":"葛之覃兮","isActive":false},{"id":"seg-008","text":"施于中谷","isActive":false},{"id":"seg-009","text":"維葉莫莫","isActive":false},{"id":"seg-010","text":"是刈是濩","isActive":false},{"id":"seg-011","text":"為絺為綌","isActive":false},{"id":"seg-012","text":"服之無斁","isActive":false},{"id":"seg-013","text":"言告師氏","isActive":false},{"id":"seg-014","text":"言告言歸","isActive":false},{"id":"seg-015","text":"薄汙我私","isActive":false},{"id":"seg-016","text":"薄澣我衣","isActive":false},{"id":"seg-017","text":"害澣害否","isActive":false},{"id":"seg-018","text":"歸寧父母","isActive":false}]},"material":{"id":"maoheng-zhushu-kr1c0004","title":"毛詩注疏","authors":["毛亨","鄭氏","孔穎達"],"contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","era":"漢唐","publicationYear":653,"carrier":"TXT"},"stats":{"annotationCount":5,"glossCount":9},"annotations":[{"id":"0001","order":1,"total":5,"layer":"preface","layerLabel":"篇序","targetText":"序《葛覃》","targetNotes":"篇首小序与郑笺。","sourceLabel":null,"sourceNotes":"对应 txt 约 586-603 行。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序","text":"序：葛覃，后妃之本也。后妃在父母家，則志在於女功之事，躬儉節用，服澣濯之衣，尊敬師傅，則可以歸安父母，化天下以婦道也。","notes":null},{"key":"0001-2","attributionLabel":"郑笺","sectionLabel":null,"text":"箋云：躬儉節用由於師傅之教，而後言尊敬師傅者，欲見其性亦自然。可以歸安父母，言嫁而得意猶不忘孝。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"葛之覃兮，施于中谷，維葉萋萋。黃鳥于飛，集于灌木，其鳴喈喈。","targetNotes":"首章。","sourceLabel":null,"sourceNotes":"对应 txt 约 604-633 行。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：興也。覃，延也。葛所以為絺綌，女功之事煩辱者。施，移也。中谷，谷中也。萋萋，茂盛貌。黃鳥，摶黍也。灌木，叢木也。喈喈，和聲之遠聞也。","notes":null},{"key":"0002-2","attributionLabel":"郑笺","sectionLabel":null,"text":"箋云：葛者婦人之所有事也，此因葛之性以興焉。葛延蔓于谷中，喻女在父母之家形體浸浸日長大；葉萋萋然，喻其容色美盛。飛集叢木，興女有嫁于君子之道；和聲之遠聞，興女有才美之稱達於遠方。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"葛之覃兮，施于中谷，維葉莫莫。是刈是濩，為絺為綌，服之無斁。","targetNotes":"二章。","sourceLabel":null,"sourceNotes":"对应 txt 约 634-665 行。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：莫莫，成就之貌。濩，煮之也。精曰絺，麤曰綌。斁，厭也。","notes":null},{"key":"0003-2","attributionLabel":"郑笺","sectionLabel":null,"text":"箋云：成就者，其可采用之時。女在父母之家，未知將所適，故習之以絺綌煩辱之事，乃能整治之無厭倦，是其性貞專。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"言告師氏，言告言歸。薄汙我私，薄澣我衣。害澣害否，歸寧父母。","targetNotes":"三章。","sourceLabel":null,"sourceNotes":"对应 txt 约 666-741 行。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：言，我也。師，女師也。古者女師教以婦德、婦言、婦容、婦功。婦人謂嫁曰歸。汙，煩也。私，燕服也。害，何也。寧，安也。父母在則有時歸寧耳。","notes":null},{"key":"0004-2","attributionLabel":"郑笺","sectionLabel":null,"text":"箋云：我告師氏者，我見教告于女師也；重言我者，尊重師教也。衣謂褘衣以下至褖衣。言害澣害否者，言常自潔清以事君子。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"葛覃三章章六句","targetNotes":"章句总说。","sourceLabel":null,"sourceNotes":"对应 txt 约 742 行。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"章句","sectionLabel":null,"text":"葛覃三章章六句。","notes":null}]}]}}}
