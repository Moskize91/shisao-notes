total":5,"layer":"span","layerLabel":"诗句片段","targetText":"葛之覃兮，施于中谷，維葉萋萋。黃鳥于飛，集于灌木，其鳴喈喈。","targetNotes":"首章。","sourceLabel":null,"sourceNotes":"对应 txt 约 604-633 行。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"毛传","sectionLabel":null},{"key":"0002-2","attributionLabel":"郑笺","sectionLabel":null}]},{"id":"0003","order":3,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"葛之覃兮，施于中谷，維葉莫莫。是刈是濩，為絺為綌，服之無斁。","targetNotes":"二章。","sourceLabel":null,"sourceNotes":"对应 txt 约 634-665 行。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"毛传","sectionLabel":null},{"key":"0003-2","attributionLabel":"郑笺","sectionLabel":null}]},{"id":"0004","order":4,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"言告師氏，言告言歸。薄汙我私，薄澣我衣。害澣害否，歸寧父母。","targetNotes":"三章。","sourceLabel":null,"sourceNotes":"对应 txt 约 666-741 行。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"毛传","sectionLabel":null},{"key":"0004-2","attributionLabel":"郑笺","sectionLabel":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"葛覃三章章六句","targetNotes":"章句总说。","sourceLabel":null,"sourceNotes":"对应 txt 约 742 行。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"章句","sectionLabel":null}]}]}}}
