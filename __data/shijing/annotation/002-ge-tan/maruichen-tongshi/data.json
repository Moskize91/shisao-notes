s":"首章与训诂。","sourceLabel":"第 67-69 页","sourceNotes":"第 67 页下半起，续至第 69 页上半。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"马瑞辰","sectionLabel":"按"}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"葛之覃兮，施于中谷，維葉莫莫。是刈是濩，為絺為綌，服之無斁。","targetNotes":"二章与训诂。","sourceLabel":"第 69-70 页","sourceNotes":"第 69 页中后段至第 70 页上半。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"马瑞辰","sectionLabel":"按"}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"言告師氏，言告言歸。薄汙我私，薄澣我衣。害澣害否，歸寧父母。","targetNotes":"三章与训诂。","sourceLabel":"第 70-72 页","sourceNotes":"第 70 页中段至第 72 页《卷耳》标题前。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"马瑞辰","sectionLabel":"按"}]}]}}}
