{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/002-ge-tan/chenhuan-chuanshu","dataHref":"/__data/shijing/annotation/002-ge-tan/chenhuan-chuanshu/data.json","title":"詩毛氏傳疏 · 葛覃 · 注释总览","description":"風 · 周南 · 葛覃 · 汇集《詩毛氏傳疏》关于《葛覃》的 4 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"002-ge-tan","materialId":"chenhuan-chuanshu"},"href":"/shijing/annotation/002-ge-tan/chenhuan-chuanshu","poem":{"id":"002-ge-tan","title":"葛覃","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","葛覃"],"segments":[{"id":"seg-001","text":"葛之覃兮","isActive":false},{"id":"seg-002","text":"施于中谷","isActive":false},{"id":"seg-003","text":"維葉萋萋","isActive":false},{"id":"seg-004","text":"黃鳥于飛","isActive":false},{"id":"seg-005","text":"集于灌木","isActive":false},{"id":"seg-006","text":"其鳴喈喈","isActive":false},{"id":"seg-007","text":"葛之覃兮","isActive":false},{"id":"seg-008","text":"施于中谷","isActive":false},{"id":"seg-009","text":"維葉莫莫","isActive":false},{"id":"seg-010","text":"是刈是濩","isActive":false},{"id":"seg-011","text":"為絺為綌","isActive":false},{"id":"seg-012","text":"服之無斁","isActive":false},{"id":"seg-013","text":"言告師氏","isActive":false},{"id":"seg-014","text":"言告言歸","isActive":false},{"id":"seg-015","text":"薄汙我私","isActive":false},{"id":"seg-016","text":"薄澣我衣","isActive":false},{"id":"seg-017","text":"害澣害否","isActive":false},{"id":"seg-018","text":"歸寧父母","isActive":false}]},"material":{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","authors":["陳奐"],"contributorLine":"清 · 陳奐","era":"清","publicationYear":1847,"carrier":"PDF"},"stats":{"annotationCount":4,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":4,"layer":"preface","layerLabel":"篇序","targetText":"序《葛覃》","targetNotes":"篇首小序与陈奂疏义。","sourceLabel":"第 15 页","sourceNotes":"PDF 15 页起为《葛覃》序文与篇首疏。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序","text":"序：葛覃，后妃之本也。后妃在父母家，則志在于女功之事，躬儉節用，服澣濯之衣，敬師傅，則可以歸安父母，化天下以婦道也。","notes":"录篇首序文主干。"},{"key":"0001-2","attributionLabel":"陈奂","sectionLabel":"疏","text":"陈奂承序义指出，《葛覃》所谓“本”在未嫁时已专志女功、躬俭节用、敬事师傅；及既嫁而得意，仍不忘孝，故归宁父母可见其德本深厚。其疏义仍以卒章“言告師氏”“歸寧父母”回证序文。","notes":"据 PDF 15 页疏文提要。"}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"葛之覃兮，施于中谷。維葉萋萋。黃鳥于飛，集于灌木，其鳴喈喈。","targetNotes":"首章与陈奂疏义。","sourceLabel":"第 15-16 页","sourceNotes":"PDF 15 页中后段至 16 页上半。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"陈奂释首章仍以毛郑为本：覃为延，施为移，中谷即谷中，萋萋为叶盛之貌。又以黃鳥、灌木、喈喈诸象与声皆为兴，谓其由葛蔓日长、黄鸟和鸣，引出女子在父母家成长而将有归嫁之义。","notes":"据 PDF 15-16 页疏义提要。"}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"葛之覃兮，施于中谷。維葉莫莫。是刈是濩，為絺為綌，服之無斁。","targetNotes":"二章与陈奂疏义。","sourceLabel":"第 16-17 页","sourceNotes":"PDF 16 页中段至 17 页。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"陈奂承传笺旧义，释莫莫为成就盛密之貌，刈濩为采葛煮治之次第，絺綌则仍分精麤。其所以反复申说“服之無斁”，在于见女既躬亲其劳，则知成物不易，故能爱惜其衣，不以已贵而废勤俭。","notes":"据 PDF 16-17 页疏义提要。"}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"言告師氏，言告言歸。薄汙我私，薄澣我衣。害澣害否，歸寧父母。","targetNotes":"三章与陈奂疏义。","sourceLabel":"第 18-19 页","sourceNotes":"PDF 18-19 页。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"陈奂于卒章仍以师教、澣衣、归宁互相发明：言告師氏见受教之敬，薄汙薄澣则明先治私衣而后及礼衣，害澣害否是斟酌所当澣与否。至歸寧父母，则用以回证序所谓既嫁而犹不忘孝，故全篇以女功成其本，以孝敬成其终。","notes":"据 PDF 18-19 页疏义提要。"}]}]}}}
