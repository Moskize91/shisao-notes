{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/051-di-dong/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/051-di-dong/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 蝃蝀 · 注释总览","description":"風 · 鄘風 · 蝃蝀 · 汇集《诗经原始(上下)》关于《蝃蝀》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"051-di-dong","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/051-di-dong/fangyurun-yuanshi","poem":{"id":"051-di-dong","title":"蝃蝀","categoryId":"feng","subcategoryId":"yongfeng","path":["風","鄘風","蝃蝀"],"segments":[{"id":"seg-001","text":"蝃蝀在東","isActive":false},{"id":"seg-002","text":"莫之敢指","isActive":false},{"id":"seg-003","text":"女子有行","isActive":false},{"id":"seg-004","text":"遠父母兄弟","isActive":false},{"id":"seg-005","text":"朝隮于西","isActive":false},{"id":"seg-006","text":"崇朝其雨","isActive":false},{"id":"seg-007","text":"女子有行","isActive":false},{"id":"seg-008","text":"遠兄弟父母","isActive":false},{"id":"seg-009","text":"乃如之人也","isActive":false},{"id":"seg-010","text":"懷昏姻也","isActive":false},{"id":"seg-011","text":"大無信也","isActive":false},{"id":"seg-012","text":"不知命也","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"蝃蝀㊟代衛宣姜答《新臺》也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标题段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注","text":"方玉润题注以“代衛宣姜答《新臺》”定篇，谓此诗为设宣姜口吻对《新臺》作答。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"总评","targetNotes":"通篇总评。","sourceLabel":null,"sourceNotes":"对应 EPUB item 总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"总评","text":"方玉润总评先辨《小序》《大序》“止奔”“美文公”两说皆未得其要，谓若专作刺淫则“遠父母兄弟”“大無信”“不知命”难通。其又议何楷“刺宣公夺伋妇”说虽近似，然《邶風》既有《新臺》，不当重出；遂据姚际恒说，转定此篇为与《新臺》相唱答的代言讽刺：设宣姜自述远嫁无依、遭卫宣无信夺妇，虽知其非而无从控告，正如蝃蝀淫邪之气朝西暮东、忽晴忽雨。末言此解可使全诗豁然，但因无实证，故仍存疑而不遽定。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"眉评","targetNotes":"篇中眉评撮要。","sourceLabel":null,"sourceNotes":"对应 EPUB item 眉评段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"眉评","text":"方玉润眉评谓：以蝃蝀忽雨忽晴、东西无定之象，比卫宣失德，譬喻巧切。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"term","layerLabel":"字词注","targetText":"蝃蝀在東朝隮于西崇朝其雨","targetNotes":"集释撮要。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":"集释","text":"方玉润集释引《集傳》谓蝃蝀为虹，是阴阳不当交之“淫气”，随日影而“朝西暮东”，故“在東”指暮虹。又据《周禮》十煇注与姚际恒说，释“朝隮”为朝虹，如自下升；“崇”训终，“崇朝其雨”即终朝有雨，并称今人误认虹惟止雨，多因朝虹不易见。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"标韵","targetNotes":"三章韵脚撮述。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标韵段。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"方玉润","sectionLabel":"标韵","text":"方玉润标韵云：首章“指”四紙与“弟”八薺通韵；次章“雨”七麌与“母”二十五有叶韵；末章“人、姻”为十一真本韵，“信”十二震与“命”二十四敬通韵。","notes":null}]}]}}}
