{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/051-di-dong/quwanli-quanshi","dataHref":"/__data/shijing/annotation/051-di-dong/quwanli-quanshi/data.json","title":"詩經詮釋 · 蝃蝀 · 注释总览","description":"風 · 鄘風 · 蝃蝀 · 汇集《詩經詮釋》关于《蝃蝀》的 2 条注释，含 2 条注脚。"},"payload":{"detail":{"route":{"poemId":"051-di-dong","materialId":"quwanli-quanshi"},"href":"/shijing/annotation/051-di-dong/quwanli-quanshi","poem":{"id":"051-di-dong","title":"蝃蝀","categoryId":"feng","subcategoryId":"yongfeng","path":["風","鄘風","蝃蝀"],"segments":[{"id":"seg-001","text":"蝃蝀在東","isActive":false},{"id":"seg-002","text":"莫之敢指","isActive":false},{"id":"seg-003","text":"女子有行","isActive":false},{"id":"seg-004","text":"遠父母兄弟","isActive":false},{"id":"seg-005","text":"朝隮于西","isActive":false},{"id":"seg-006","text":"崇朝其雨","isActive":false},{"id":"seg-007","text":"女子有行","isActive":false},{"id":"seg-008","text":"遠兄弟父母","isActive":false},{"id":"seg-009","text":"乃如之人也","isActive":false},{"id":"seg-010","text":"懷昏姻也","isActive":false},{"id":"seg-011","text":"大無信也","isActive":false},{"id":"seg-012","text":"不知命也","isActive":false}]},"material":{"id":"quwanli-quanshi","title":"詩經詮釋","authors":["屈萬里"],"contributorLine":"现代 · 屈萬里","era":"现代","publicationYear":1983,"carrier":"PDF"},"stats":{"annotationCount":2,"glossCount":2},"annotations":[{"id":"0001","order":1,"total":2,"layer":"global","layerLabel":"全篇总说","targetText":"蝃蝀","targetNotes":"诗旨总说。","sourceLabel":"第 62 页","sourceNotes":"书页 62《注釋》①。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"屈万里","sectionLabel":"总说","text":"屈万里谓《蝃蝀》“此盖既嫁之女而拒其他求婚者之诗”。","notes":null}]},{"id":"0002","order":2,"total":2,"layer":"term","layerLabel":"字词注","targetText":"蝃蝀在東，莫之敢指。女子有行，遠父母兄弟。朝隮于西，崇朝其雨。女子有行，遠兄弟父母。乃如之人也，懷昏姻也。大無信也，不知命也。","targetNotes":"《注釋》②至⑪撮要。","sourceLabel":"第 62 页","sourceNotes":"书页 62《注釋》②至⑪。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"屈万里","sectionLabel":"注释","text":"屈万里释“蝃蝀”为虹，音帝东，并记北方旧俗戒小儿指虹，故“莫之敢指”未必专牵附淫奔。又释“有行”为出嫁，“隮”为虹，并引“东虹晴，西虹雨”以释“崇朝其雨”。末章释“乃如”为转语词，“之”为是，“大”读为“太”，据“大無信也”疑其人昔曾约婚而未践言；并释“命”为命运。","notes":null}]}]}}}
