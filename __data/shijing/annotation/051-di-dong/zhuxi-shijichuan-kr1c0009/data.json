{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/051-di-dong/zhuxi-shijichuan-kr1c0009","dataHref":"/__data/shijing/annotation/051-di-dong/zhuxi-shijichuan-kr1c0009/data.json","title":"詩集傳 · 蝃蝀 · 注释总览","description":"風 · 鄘風 · 蝃蝀 · 汇集《詩集傳》关于《蝃蝀》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"051-di-dong","materialId":"zhuxi-shijichuan-kr1c0009"},"href":"/shijing/annotation/051-di-dong/zhuxi-shijichuan-kr1c0009","poem":{"id":"051-di-dong","title":"蝃蝀","categoryId":"feng","subcategoryId":"yongfeng","path":["風","鄘風","蝃蝀"],"segments":[{"id":"seg-001","text":"蝃蝀在東","isActive":true},{"id":"seg-002","text":"莫之敢指","isActive":true},{"id":"seg-003","text":"女子有行","isActive":true},{"id":"seg-004","text":"遠父母兄弟","isActive":true},{"id":"seg-005","text":"朝隮于西","isActive":false},{"id":"seg-006","text":"崇朝其雨","isActive":false},{"id":"seg-007","text":"女子有行","isActive":false},{"id":"seg-008","text":"遠兄弟父母","isActive":false},{"id":"seg-009","text":"乃如之人也","isActive":false},{"id":"seg-010","text":"懷昬姻也","isActive":false},{"id":"seg-011","text":"大無信也","isActive":false},{"id":"seg-012","text":"不知命也","isActive":false}]},"material":{"id":"zhuxi-shijichuan-kr1c0009","title":"詩集傳","authors":["朱熹"],"contributorLine":"宋 · 朱熹","era":"宋","publicationYear":1186,"carrier":"TXT"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"蝃蝀在東莫之敢指女子有行遠父母兄弟","targetNotes":"首章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》蝃蝀首章。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"朱熹","sectionLabel":null,"text":"比也。蝃蝀、虹也。日與雨交、倐然成質。似有血氣之類。乃陰陽之氣、不當交而交者。蓋天地之淫氣也。在東者、莫虹也。虹隨日所映。故朝西而莫東也。○此刺淫奔之詩。言蝃蝀在東、而人不敢指、以比淫奔之惡。人不可道。況女子有行、當遠其父母兄弟。豈可不顧此而冒行乎。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"朝隮于西崇朝其雨女子有行遠兄弟父母","targetNotes":"次章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》蝃蝀次章。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"朱熹","sectionLabel":null,"text":"○比也。隮、升也。周禮十惲、九曰隮。注以爲虹。蓋忽然而見、如自下而升也。崇、終也。從旦至食時爲終朝。言方雨而虹見、則其雨終朝而止矣。蓋淫慝之氣、有害於陰陽之和也。今俗謂虹能蔵雨。信然。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"乃如之人也懷昬姻也大無信也不知命也","targetNotes":"三章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》蝃蝀三章。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"朱熹","sectionLabel":null,"text":"賦也。乃如之人、指淫奔者而言。婚姻、謂男女之欲。程子曰、女子以不自失爲信。命、正理也。○言此淫奔之人、但知思念男女之欲。是不能自守其貞信之節、而不知天理之正也。程子曰、人雖不能無欲、然當有以制之。無以制之、而惟欲之從、則人道廢而入於禽獸矣。以道制欲、則能順命。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"蝃蝀三章章四句","targetNotes":"章句总说。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》蝃蝀章句总说。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"朱熹","sectionLabel":null,"text":"蝃蝀三章章四句。","notes":null}]}]}}}
