{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/051-di-dong/chenhuan-chuanshu","dataHref":"/__data/shijing/annotation/051-di-dong/chenhuan-chuanshu/data.json","title":"詩毛氏傳疏 · 蝃蝀 · 注释总览","description":"風 · 鄘風 · 蝃蝀 · 汇集《詩毛氏傳疏》关于《蝃蝀》的 2 条注释，含 2 条注脚。"},"payload":{"detail":{"route":{"poemId":"051-di-dong","materialId":"chenhuan-chuanshu"},"href":"/shijing/annotation/051-di-dong/chenhuan-chuanshu","poem":{"id":"051-di-dong","title":"蝃蝀","categoryId":"feng","subcategoryId":"yongfeng","path":["風","鄘風","蝃蝀"],"segments":[{"id":"seg-001","text":"蝃蝀在東","isActive":false},{"id":"seg-002","text":"莫之敢指","isActive":false},{"id":"seg-003","text":"女子有行","isActive":false},{"id":"seg-004","text":"遠父母兄弟","isActive":false},{"id":"seg-005","text":"朝隮于西","isActive":false},{"id":"seg-006","text":"崇朝其雨","isActive":false},{"id":"seg-007","text":"女子有行","isActive":false},{"id":"seg-008","text":"遠兄弟父母","isActive":false},{"id":"seg-009","text":"乃如之人也","isActive":false},{"id":"seg-010","text":"懷婚姻也","isActive":false},{"id":"seg-011","text":"大無信也","isActive":false},{"id":"seg-012","text":"不知命也","isActive":false}]},"material":{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","authors":["陳奐"],"contributorLine":"清 · 陳奐","era":"清","publicationYear":1847,"carrier":"PDF"},"stats":{"annotationCount":2,"glossCount":2},"annotations":[{"id":"0001","order":1,"total":2,"layer":"preface","layerLabel":"篇序","targetText":"蝃蝀止奔也衛文公能以道化其民淫奔之恥國人不齒也","targetNotes":"篇首小序。","sourceLabel":"第 13 页","sourceNotes":"卷四页十三前段《蝃蝀》小序。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序","text":"序：《蝃蝀》，止奔也。衛文公能以道化其民，淫奔之恥，國人不齒也。","notes":null}]},{"id":"0002","order":2,"total":2,"layer":"span","layerLabel":"诗句片段","targetText":"蝃蝀在東，莫之敢指。女子有行，遠父母兄弟。朝隮于西，崇朝其雨。女子有行，遠兄弟父母。乃如之人也，懷婚姻也。大無信也，不知命也。","targetNotes":"通篇经传疏解。","sourceLabel":"第 13-14 页","sourceNotes":"据卷四页十三至页十四《蝃蝀》经传疏。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"陈奂疏《蝃蝀》时，先据《序》“止奔也……國人不齒也”申明此篇主旨在刺淫奔、正风俗。其释首章“蝃蝀在東，莫之敢指。女子有行，遠父母兄弟”，以蝃蝀为阴阳失和之戒，言虹见尚不敢指，况淫奔之行尤为国人所恶；并申女子有常道，当远其父母兄弟而适人，不当越礼自媒。次章“朝隮于西，崇朝其雨。女子有行，遠兄弟父母”，以“隮”为虹气上升，言气象感应可验，则男女之分、嫁娶之礼亦有常则，不可违其伦序。末章“乃如之人也，懷婚姻也。大無信也，不知命也”，直斥淫奔者惟务私欲，失其贞信，不知婚姻当待父母之命，故篇意归于深恶而严戒之。","notes":null}]}]}}}
