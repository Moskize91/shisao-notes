{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/054-zai-chi/chengjunying-jiangjianyuan-zhuxi","dataHref":"/__data/shijing/annotation/054-zai-chi/chengjunying-jiangjianyuan-zhuxi/data.json","title":"詩經注析 · 載馳 · 注释总览","description":"風 · 鄘風 · 載馳 · 汇集《詩經注析》关于《載馳》的 6 条注释，含 6 条注脚。"},"payload":{"detail":{"route":{"poemId":"054-zai-chi","materialId":"chengjunying-jiangjianyuan-zhuxi"},"href":"/shijing/annotation/054-zai-chi/chengjunying-jiangjianyuan-zhuxi","poem":{"id":"054-zai-chi","title":"載馳","categoryId":"feng","subcategoryId":"yongfeng","path":["風","鄘風","載馳"],"segments":[{"id":"seg-001","text":"载驰载驱","isActive":false},{"id":"seg-002","text":"归唁卫侯","isActive":false},{"id":"seg-003","text":"驱马悠悠","isActive":false},{"id":"seg-004","text":"言至于漕","isActive":false},{"id":"seg-005","text":"大夫跋涉","isActive":false},{"id":"seg-006","text":"我心则忧","isActive":false},{"id":"seg-007","text":"既不我嘉","isActive":false},{"id":"seg-008","text":"不能旋反","isActive":false},{"id":"seg-009","text":"视尔不臧","isActive":false},{"id":"seg-010","text":"我思不远","isActive":false},{"id":"seg-011","text":"既不我嘉","isActive":false},{"id":"seg-012","text":"不能旋济","isActive":false},{"id":"seg-013","text":"视尔不臧","isActive":false},{"id":"seg-014","text":"我思不閟","isActive":false},{"id":"seg-015","text":"陟彼阿丘","isActive":false},{"id":"seg-016","text":"言采其蝱","isActive":false},{"id":"seg-017","text":"女子善怀","isActive":false},{"id":"seg-018","text":"亦各有行","isActive":false},{"id":"seg-019","text":"许人尤之","isActive":false},{"id":"seg-020","text":"众稚且狂","isActive":false},{"id":"seg-021","text":"我行其野","isActive":false},{"id":"seg-022","text":"芃芃其麦","isActive":false},{"id":"seg-023","text":"控于大邦","isActive":false},{"id":"seg-024","text":"谁因谁极","isActive":false},{"id":"seg-025","text":"大夫君子","isActive":false},{"id":"seg-026","text":"无我有尤","isActive":false},{"id":"seg-027","text":"百尔所思","isActive":false},{"id":"seg-028","text":"不如我所之","isActive":false}]},"material":{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","authors":["程俊英","蔣見元"],"contributorLine":"现代 · 程俊英、蔣見元","era":"现代","publicationYear":1991,"carrier":"PDF"},"stats":{"annotationCount":6,"glossCount":6},"annotations":[{"id":"0001","order":1,"total":6,"layer":"global","layerLabel":"全篇总说","targetText":"《载驰》题解","targetNotes":"题解总说。","sourceLabel":"第 115-116 页","sourceNotes":"书内页 115-116《题解》。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"程、蒋把《载驰》解释为许穆夫人回漕吊唁卫侯、并向许大夫表明救卫主张的诗，强调“控于大邦，谁因谁极”是全诗主旨。他们从《左传》与王先谦等说出发，主张夫人实已奔至漕邑，而非仅作设想；又据陈奂意见把全诗分为五章，并称其风格沉郁顿挫、层层逼进，最能见许穆夫人的爱国心与识见。","notes":null}]},{"id":"0002","order":2,"total":6,"layer":"span","layerLabel":"诗句片段","targetText":"载驰载驱，归唁卫侯。驱马悠悠，言至于漕。大夫跋涉，我心则忧。","targetNotes":"第一章。","sourceLabel":"第 116-117 页","sourceNotes":"书内页 116-117 首章注析。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","text":"程、蒋释首章时，详解“载”为发语词兼可作连词，“驰”“驱”是快马加鞭；“唁”是吊人失国，“漕”为卫邑。又说“大夫跋涉”既可指追来劝阻许穆夫人的许臣，也可兼通卫大夫奔告亡国消息之义；首章因此奠定全诗忧卫、归唁而又受阻的情境。","notes":null}]},{"id":"0003","order":3,"total":6,"layer":"span","layerLabel":"诗句片段","targetText":"既不我嘉，不能旋反。视尔不臧，我思不远。既不我嘉，不能旋济。视尔不臧，我思不閟。","targetNotes":"第二、三章。","sourceLabel":"第 117 页","sourceNotes":"书内页 117 二、三章注析。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","text":"程、蒋指出二、三章连续责许人“不我嘉”“不臧”。其中“嘉”为赞同，“旋反”“旋济”皆言返还、渡济；“视”取比较义，“不臧”即不善；“思”解作计谋，“不远”谓并非迂远难行，“不閟”谓其谋并不闭塞。两章重沓写法，正见夫人虽被阻止而忧思不息。","notes":null}]},{"id":"0004","order":4,"total":6,"layer":"span","layerLabel":"诗句片段","targetText":"陟彼阿丘，言采其蝱。女子善怀，亦各有行。许人尤之，众稚且狂。","targetNotes":"第四章。","sourceLabel":"第 118 页","sourceNotes":"书内页 118 四章注析。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","text":"程、蒋释“阿丘”为偏高山坡，“蝱”为可疗郁结的贝母；“女子善怀”即女子多能怀思，“亦各有行”谓各有道理。故“许人尤之，众稚且狂”是夫人反责许人：既不救卫，又拘泥常礼阻其归唁，只见众人幼稚狂妄，不知宗国败亡的非常之变。","notes":null}]},{"id":"0005","order":5,"total":6,"layer":"span","layerLabel":"诗句片段","targetText":"我行其野，芃芃其麦。控于大邦，谁因谁极！大夫君子，无我有尤。百尔所思，不如我所之。","targetNotes":"第五章。","sourceLabel":"第 118-119 页","sourceNotes":"书内页 118-119 五章注析。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","text":"末章中，程、蒋释“芃芃”为麦盛貌，谓夫人见祖国田野麦盛而丧乱无人收割，因而倍增哀痛；“控”即赴告大邦，“因”为所依，“极”为所至，核心仍在求齐等大国援卫。结末“大夫君子，无我有尤。百尔所思，不如我所之”则转为直接申责，断言许人百般谋议皆不如己见切中要害。","notes":null}]},{"id":"0006","order":6,"total":6,"layer":"global","layerLabel":"全篇总说","targetText":"《载驰》五章分章说明","targetNotes":"章法说明。","sourceLabel":"第 116 页","sourceNotes":"书内页 116 分章讨论。","notes":null,"glosses":[{"key":"0006-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章法","text":"程、蒋从陈奂说，把《载驰》定为五章，理由是《左传》赋诗称“载驰之四章”不举卒章，反证全诗尚有第五章。此分章也与他们对全诗情绪推进的理解相合：首章起势，二三章缠绵，四章直抒胸臆，末章斩钉截铁。","notes":null}]}]}}}
