i","title":"詩經注析","authors":["程俊英","蔣見元"],"contributorLine":"现代 · 程俊英、蔣見元","era":"现代","publicationYear":1991,"carrier":"PDF"},"stats":{"annotationCount":6,"glossCount":6},"annotations":[{"id":"0001","order":1,"total":6,"layer":"global","layerLabel":"全篇总说","targetText":"《载驰》题解","targetNotes":"题解总说。","sourceLabel":"第 115-116 页","sourceNotes":"书内页 115-116《题解》。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解"}]},{"id":"0002","order":2,"total":6,"layer":"span","layerLabel":"诗句片段","targetText":"载驰载驱，归唁卫侯。驱马悠悠，言至于漕。大夫跋涉，我心则忧。","targetNotes":"第一章。","sourceLabel":"第 117 页","sourceNotes":"书内页 117 首章注析。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解"}]},{"id":"0003","order":3,"total":6,"layer":"span","layerLabel":"诗句片段","targetText":"既不我嘉，不能旋反。视尔不臧，我思不远。既不我嘉，不能旋济。视尔不臧，我思不閟。","targetNotes":"第二、三章。","sourceLabel":"第 118 页","sourceNotes":"书内页 118 二、三章注析。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解"}]},{"id":"0004","order":4,"total":6,"layer":"span","layerLabel":"诗句片段","targetText":"陟彼阿丘，言采其蝱。女子善怀，亦各有行。许人尤之，众稚且狂。","targetNotes":"第四章。","sourceLabel":"第 118-119 页","sourceNotes":"书内页 118-119 四章注析。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解"}]},{"id":"0005","order":5,"total":6,"layer":"span","layerLabel":"诗句片段","targetText":"我行其野，芃芃其麦。控于大邦，谁因谁极！大夫君子，无我有尤。百尔所思，不如我所之。","targetNotes":"第五章。","sourceLabel":"第 119 页","sourceNotes":"书内页 119 五章注析。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解"}]},{"id":"0006","order":6,"total":6,"layer":"global","layerLabel":"全篇总说","targetText":"《载驰》五章分章说明","targetNotes":"章法说明。","sourceLabel":"第 116-117 页","sourceNotes":"书内页 116-117 分章与章法说明。","notes":null,"glosses":[{"key":"0006-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章法"}]}]}}}
