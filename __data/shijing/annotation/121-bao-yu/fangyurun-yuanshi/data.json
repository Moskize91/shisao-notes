{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/121-bao-yu/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/121-bao-yu/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 鴇羽 · 注释总览","description":"風 · 唐風 · 鴇羽 · 汇集《诗经原始(上下)》关于《鴇羽》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"121-bao-yu","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/121-bao-yu/fangyurun-yuanshi","poem":{"id":"121-bao-yu","title":"鴇羽","categoryId":"feng","subcategoryId":"tangfeng","path":["風","唐風","鴇羽"],"segments":[{"id":"seg-001","text":"肅肅鴇羽","isActive":false},{"id":"seg-002","text":"集于苞栩","isActive":false},{"id":"seg-003","text":"王事靡盬","isActive":false},{"id":"seg-004","text":"不能蓺稷黍","isActive":false},{"id":"seg-005","text":"父母何怙","isActive":false},{"id":"seg-006","text":"悠悠蒼天","isActive":false},{"id":"seg-007","text":"曷其有所","isActive":false},{"id":"seg-008","text":"肅肅鴇翼","isActive":false},{"id":"seg-009","text":"集于苞棘","isActive":false},{"id":"seg-010","text":"王事靡盬","isActive":false},{"id":"seg-011","text":"不能蓺黍稷","isActive":false},{"id":"seg-012","text":"父母何食","isActive":false},{"id":"seg-013","text":"悠悠蒼天","isActive":false},{"id":"seg-014","text":"曷其有極","isActive":false},{"id":"seg-015","text":"肅肅鴇行","isActive":false},{"id":"seg-016","text":"集于苞桑","isActive":false},{"id":"seg-017","text":"王事靡盬","isActive":false},{"id":"seg-018","text":"不能蓺稻粱","isActive":false},{"id":"seg-019","text":"父母何嘗","isActive":false},{"id":"seg-020","text":"悠悠蒼天","isActive":false},{"id":"seg-021","text":"曷其有常","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"刺征役苦民也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 篇首题注。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注"}]},{"id":"0002","order":2,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"右《鴇羽》三章，章七句。此詩《序》謂「刺時。晉昭公之後，大亂五世。君子下從征役，不得養其父母之作」。何氏楷以篇中有「蓺黍稷」等語，似與君子不類而疑之。姚氏際恒又以詩中有「王事」二字而信其説。總之，此等議論，無關風人要旨。勤勞王事，詎分君子、小民？不得養親，同此呼天籲地。人不傷心，何煩泣訴？始則痛居處之無定，繼則念征役之何極，終則恨舊樂之難復。民情至此，咨怨極矣。而爲之上者，猶不知所以體恤而安輯之。則養生送死之無望，仰事俯育之難酬，民又何樂此邦而不他適？而詩但歸之於天，不敢有懈王事，則忠厚之心又何切也。論者謂唐人質朴，猶有堯之遺風，不於此可見歟？","targetNotes":"总评原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"总评"}]},{"id":"0003","order":3,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"肅肅羽聲。鴇〔《集傳》〕鴇，鳥名。似雁而大，無後趾。〔陸氏璣曰〕鴇鳥連啼，「啼」，《毛詩正義》作「蹄」。性不樹止，樹止則爲苦。集止也。苞叢生也。栩〔《集傳》〕栩，柞櫟也。其子爲皂斗，殼可以染皂者是也。〔陸氏璣曰〕徐州人謂櫟爲杼，或謂之爲栩。盬〔孔氏穎達曰〕盬爲蠱，字異義同。《左傳》云：「於文皿蟲爲蠱，穀之飛亦爲蠱。」然則蟲害器、敗穀者，皆謂之蠱。是盬爲不攻牢不堅緻之意也。蓺樹也。怙恃也。行列也。〔陸氏佃曰〕《説文》曰：「鴇相次也。」蓋鴇性群居如雁，自然而有行列。故從鴇。《詩》曰「鴇行」，以此故也。粱粟類也。〔王氏逢曰〕《本草》注：凡云粱米，皆是粟類。青粱，殼穗有毛，粒青，米亦微青，而細於黄白粱。黄粱，穗大毛長，穀米俱麤於白粱。嘗食也。常復其常也。","targetNotes":"集释原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"集釋"}]},{"id":"0004","order":4,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"羽七麌。栩同。黍六語。怙七麌。所六語。通韻。翼十三職。棘、稷、食、極並同。本韻。行七陽。桑、粱、嘗、常並同。本韻。","targetNotes":"标韵原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标韵段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":"標韻"}]}]}}}
