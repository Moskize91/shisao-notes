{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/022-jiang-you-si/wangli-yundu","dataHref":"/__data/shijing/annotation/022-jiang-you-si/wangli-yundu/data.json","title":"詩經韻讀 · 江有汜 · 注释总览","description":"風 · 召南 · 江有汜 · 汇集《詩經韻讀》关于《江有汜》的 2 条注释，含 2 条注脚。"},"payload":{"detail":{"route":{"poemId":"022-jiang-you-si","materialId":"wangli-yundu"},"href":"/shijing/annotation/022-jiang-you-si/wangli-yundu","poem":{"id":"022-jiang-you-si","title":"江有汜","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","江有汜"],"segments":[{"id":"seg-001","text":"江有汜","isActive":false},{"id":"seg-002","text":"之子归","isActive":false},{"id":"seg-003","text":"不我以","isActive":false},{"id":"seg-004","text":"不我以","isActive":false},{"id":"seg-005","text":"其后也悔","isActive":false},{"id":"seg-006","text":"江有渚","isActive":false},{"id":"seg-007","text":"之子归","isActive":false},{"id":"seg-008","text":"不我与","isActive":false},{"id":"seg-009","text":"不我与","isActive":false},{"id":"seg-010","text":"其后也处","isActive":false},{"id":"seg-011","text":"江有沱","isActive":false},{"id":"seg-012","text":"之子归","isActive":false},{"id":"seg-013","text":"不我过","isActive":false},{"id":"seg-014","text":"不我过","isActive":false},{"id":"seg-015","text":"其啸也歌","isActive":false}]},"material":{"id":"wangli-yundu","title":"詩經韻讀","authors":["王力"],"contributorLine":"现代 · 王力","era":"现代","publicationYear":1980,"carrier":"PDF"},"stats":{"annotationCount":2,"glossCount":2},"annotations":[{"id":"0001","order":1,"total":2,"layer":"global","layerLabel":"全篇总说","targetText":"《江有汜》韵读总说","targetNotes":"书页 148 的诗号 22 全段。","sourceLabel":"第 148 页局部","sourceNotes":"书页 148 上半覆盖《江有汜》全篇。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"王力","sectionLabel":"韵读","text":"王力将《江有汜》读作三章三换韵：首章“汜(zia)、以(jia)、悔(xua)”属之部通叶；次章“渚(tjia)、與(jia)、處(thjia)”属鱼部；第三章“沱(dai)、過(kuai)、歌(kai)”属歌部。三章都以叠句反复增强回环感，而各章韵部整齐递换。","notes":null}]},{"id":"0002","order":2,"total":2,"layer":"span","layerLabel":"诗句片段","targetText":"江有汜，之子归，不我以。不我以，其后也悔。江有渚，之子归，不我与。不我与，其后也处。江有沱，之子归，不我过。不我过，其啸也歌。","targetNotes":"现存页图可见全篇。","sourceLabel":"第 148 页局部","sourceNotes":"书页 148《江有汜》全篇韵读。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"王力","sectionLabel":"韵读","text":"页图可读首章以“汜(zia)、以(jia)、悔(xua)”为主要韵脚；第二章转为“渚(tjia)、與(jia)、處(thjia)”鱼部；第三章则以“沱(dai)、過(kuai)、歌(kai)”收在歌部。王力由此把《江有汜》视为章章换韵而句法反复的一篇。","notes":null}]}]}}}
