{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/022-jiang-you-si/chenhuan-chuanshu","dataHref":"/__data/shijing/annotation/022-jiang-you-si/chenhuan-chuanshu/data.json","title":"詩毛氏傳疏 · 江有汜 · 注释总览","description":"風 · 召南 · 江有汜 · 汇集《詩毛氏傳疏》关于《江有汜》的 2 条注释，含 2 条注脚。"},"payload":{"detail":{"route":{"poemId":"022-jiang-you-si","materialId":"chenhuan-chuanshu"},"href":"/shijing/annotation/022-jiang-you-si/chenhuan-chuanshu","poem":{"id":"022-jiang-you-si","title":"江有汜","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","江有汜"],"segments":[{"id":"seg-001","text":"江有汜","isActive":false},{"id":"seg-002","text":"之子歸","isActive":false},{"id":"seg-003","text":"不我以","isActive":false},{"id":"seg-004","text":"不我以","isActive":false},{"id":"seg-005","text":"其後也悔","isActive":false},{"id":"seg-006","text":"江有渚","isActive":false},{"id":"seg-007","text":"之子歸","isActive":false},{"id":"seg-008","text":"不我與","isActive":false},{"id":"seg-009","text":"不我與","isActive":false},{"id":"seg-010","text":"其後也處","isActive":false},{"id":"seg-011","text":"江有沱","isActive":false},{"id":"seg-012","text":"之子歸","isActive":false},{"id":"seg-013","text":"不我過","isActive":false},{"id":"seg-014","text":"不我過","isActive":false},{"id":"seg-015","text":"其嘯也歌","isActive":false}]},"material":{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","authors":["陳奐"],"contributorLine":"清 · 陳奐","era":"清","publicationYear":1847,"carrier":"PDF"},"stats":{"annotationCount":2,"glossCount":2},"annotations":[{"id":"0001","order":1,"total":2,"layer":"preface","layerLabel":"篇序","targetText":"江有汜美媵也勤而無怨嫡能悔過也","targetNotes":"篇首序文。","sourceLabel":"第 53 页","sourceNotes":"据第 53 页《江有汜》序义。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序","text":"序：《江有汜》，美媵也。勤而無怨，嫡能悔過也。","notes":null}]},{"id":"0002","order":2,"total":2,"layer":"span","layerLabel":"诗句片段","targetText":"江有汜，之子歸，不我以。不我以，其後也悔。江有渚，之子歸，不我與。不我與，其後也處。江有沱，之子歸，不我過。不我過，其嘯也歌。","targetNotes":"通篇经传疏解。","sourceLabel":"第 53-54 页","sourceNotes":"据第 53-54 页《江有汜》经传疏。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"陈奂遵毛序而以此篇为媵妾被嫡妻遗弃时所作。首章“江有汜”兴嫡妻归宁不挟己同行，“不我以”是不用我同往；二章“不我與”又进为不与我同居，三章“不我過”则并其庐舍亦不肯经过。其疏尤其着重“嘯歌”并非真乐，乃媵妾怨而能自抑、久而望其悔过之辞，所以仍可归入勤而无怨之美。","notes":null}]}]}}}
