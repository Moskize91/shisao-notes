应维基文库《詩經/江有汜》首章。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：汜，決復入為汜。之子，嫡也。歸，嫁也。以，與也。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"江有渚之子歸不我與不我與其後也處","targetNotes":"第二章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經/江有汜》第二章。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：渚，小洲也。與，猶以也。處，止也。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"江有沱之子歸不我過不我過其嘯也歌","targetNotes":"第三章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經/江有汜》第三章。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：沱，江之別者。過，至也。嘯，蹙口出聲也。","notes":null}]}]}}}
