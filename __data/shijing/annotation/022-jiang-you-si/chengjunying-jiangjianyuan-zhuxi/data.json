{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/022-jiang-you-si/chengjunying-jiangjianyuan-zhuxi","dataHref":"/__data/shijing/annotation/022-jiang-you-si/chengjunying-jiangjianyuan-zhuxi/data.json","title":"詩經注析 · 江有汜 · 注释总览","description":"風 · 召南 · 江有汜 · 汇集《詩經注析》关于《江有汜》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"022-jiang-you-si","materialId":"chengjunying-jiangjianyuan-zhuxi"},"href":"/shijing/annotation/022-jiang-you-si/chengjunying-jiangjianyuan-zhuxi","poem":{"id":"022-jiang-you-si","title":"江有汜","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","江有汜"],"segments":[{"id":"seg-001","text":"江有汜","isActive":false},{"id":"seg-002","text":"之子归","isActive":false},{"id":"seg-003","text":"不我以","isActive":false},{"id":"seg-004","text":"不我以","isActive":false},{"id":"seg-005","text":"其后也悔","isActive":false},{"id":"seg-006","text":"江有渚","isActive":false},{"id":"seg-007","text":"之子归","isActive":false},{"id":"seg-008","text":"不我与","isActive":false},{"id":"seg-009","text":"不我与","isActive":false},{"id":"seg-010","text":"其后也处","isActive":false},{"id":"seg-011","text":"江有沱","isActive":false},{"id":"seg-012","text":"之子归","isActive":false},{"id":"seg-013","text":"不我过","isActive":false},{"id":"seg-014","text":"不我过","isActive":false},{"id":"seg-015","text":"其啸也歌","isActive":false}]},"material":{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","authors":["程俊英","蔣見元"],"contributorLine":"现代 · 程俊英、蔣見元","era":"现代","publicationYear":1991,"carrier":"PDF"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"题解","targetNotes":"题解总说。","sourceLabel":"第 41 页","sourceNotes":"书内页 41《题解》段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"题解把《江有汜》定为弃妇自伤自解之诗。编者认为三章以江汜、江渚、江沱层层换景，与“不我以”“不我与”“不我过”的递进并行，既写出妇人被弃后由盼其后悔、望其安处，到终以长啸放歌自遣的情绪转折，也保留了国风敦厚而不尽怨詈的格调。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"江有汜，之子归，不我以。不我以，其后也悔。","targetNotes":"首章。","sourceLabel":"第 40 页","sourceNotes":"书内页 40 首章与注释。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"首章释“汜”为长江决复入之支流，以江水离合起兴，映衬夫归而不携己同行的现实。“以”训用，亦即不用我、不需要我；“其后也悔”则是弃妇自宽之辞，仍望对方后来知悔。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"江有渚，之子归，不我与。不我与，其后也处。","targetNotes":"第二章。","sourceLabel":"第 40 页","sourceNotes":"书内页 40 第二章与注释。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"第二章以江中小洲起兴。“与”训偕，也就是不与我同居同行；“处”则转作居止安处之意。编者据此指出，此章语气较首章更进一步，从望其后悔推进到设想其终能回顾安顿自己。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"江有沱，之子归，不我过。不我过，其啸也歌。","targetNotes":"第三章。","sourceLabel":"第 40-41 页","sourceNotes":"书内页 40 末至 41 页上半第三章与注释。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"第三章释“沱”为长江支流，“过”为经过我处而不来。“啸”与“歌”并非欢快逢迎，而是弃妇在江边长啸放歌以自遣其悲。编者认为三章至此把自怨而自宽的心理推到极致，感情更激切，却仍不失温柔敦厚。","notes":null}]}]}}}
