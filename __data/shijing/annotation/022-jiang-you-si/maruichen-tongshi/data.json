{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/022-jiang-you-si/maruichen-tongshi","dataHref":"/__data/shijing/annotation/022-jiang-you-si/maruichen-tongshi/data.json","title":"毛詩傳箋通釋 · 江有汜 · 注释总览","description":"風 · 召南 · 江有汜 · 汇集《毛詩傳箋通釋》关于《江有汜》的 1 条注释，含 1 条注脚。"},"payload":{"detail":{"route":{"poemId":"022-jiang-you-si","materialId":"maruichen-tongshi"},"href":"/shijing/annotation/022-jiang-you-si/maruichen-tongshi","poem":{"id":"022-jiang-you-si","title":"江有汜","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","江有汜"],"segments":[{"id":"seg-001","text":"江有汜","isActive":true},{"id":"seg-002","text":"之子歸","isActive":true},{"id":"seg-003","text":"不我以","isActive":true},{"id":"seg-004","text":"不我以","isActive":true},{"id":"seg-005","text":"其後也悔","isActive":true},{"id":"seg-006","text":"江有渚","isActive":true},{"id":"seg-007","text":"之子歸","isActive":true},{"id":"seg-008","text":"不我與","isActive":true},{"id":"seg-009","text":"不我與","isActive":true},{"id":"seg-010","text":"其後也處","isActive":true},{"id":"seg-011","text":"江有沱","isActive":true},{"id":"seg-012","text":"之子歸","isActive":true},{"id":"seg-013","text":"不我過","isActive":true},{"id":"seg-014","text":"不我過","isActive":true},{"id":"seg-015","text":"其嘯也歌","isActive":true}]},"material":{"id":"maruichen-tongshi","title":"毛詩傳箋通釋","authors":["馬瑞辰"],"contributorLine":"清 · 馬瑞辰","era":"清","publicationYear":1989,"carrier":"PDF"},"stats":{"annotationCount":1,"glossCount":1},"annotations":[{"id":"0001","order":1,"total":1,"layer":"span","layerLabel":"诗句片段","targetText":"江有汜，之子歸，不我以。不我以，其後也悔。江有渚，之子歸，不我與。不我與，其後也處。江有沱，之子歸，不我過。不我過，其嘯也歌。","targetNotes":"整篇按语与字义考。","sourceLabel":"第 95-96 页","sourceNotes":"依据 /tmp/jiang-you-si-maruichen/p127.png 与 /tmp/jiang-you-si-maruichen/p128.png 中《江有汜》条。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"马瑞辰","sectionLabel":"按","text":"瑞辰疏通三章递进之势，以为“以”“與”“過”一层深于一层：初犹不肯携行，继则不同居，终且过门不入。其考证尤其着重“嘯歌”二字，认为“嘯”本含舒愤之声，“歌”则非真乐，乃怨而能自遣的表现。故此诗虽写被弃之痛，仍可见其能克己不怨的厚意。","notes":null}]}]}}}
