{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/022-jiang-you-si/zhuxi-shijichuan-kr1c0009","dataHref":"/__data/shijing/annotation/022-jiang-you-si/zhuxi-shijichuan-kr1c0009/data.json","title":"詩集傳 · 江有汜 · 注释总览","description":"風 · 召南 · 江有汜 · 汇集《詩集傳》关于《江有汜》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"022-jiang-you-si","materialId":"zhuxi-shijichuan-kr1c0009"},"href":"/shijing/annotation/022-jiang-you-si/zhuxi-shijichuan-kr1c0009","poem":{"id":"022-jiang-you-si","title":"江有汜","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","江有汜"],"segments":[{"id":"seg-001","text":"江有汜","isActive":true},{"id":"seg-002","text":"之子歸","isActive":true},{"id":"seg-003","text":"不我以","isActive":true},{"id":"seg-004","text":"不我以","isActive":true},{"id":"seg-005","text":"其後也悔","isActive":true},{"id":"seg-006","text":"江有渚","isActive":false},{"id":"seg-007","text":"之子歸","isActive":false},{"id":"seg-008","text":"不我與","isActive":false},{"id":"seg-009","text":"不我與","isActive":false},{"id":"seg-010","text":"其後也處","isActive":false},{"id":"seg-011","text":"江有沱","isActive":false},{"id":"seg-012","text":"之子歸","isActive":false},{"id":"seg-013","text":"不我過","isActive":false},{"id":"seg-014","text":"不我過","isActive":false},{"id":"seg-015","text":"其嘯也歌","isActive":false}]},"material":{"id":"zhuxi-shijichuan-kr1c0009","title":"詩集傳","authors":["朱熹"],"contributorLine":"宋 · 朱熹","era":"宋","publicationYear":1186,"carrier":"TXT"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"江有汜，之子歸，不我以。不我以，其後也悔。","targetNotes":"首章。","sourceLabel":null,"sourceNotes":"对应 txt 376-382 行。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"朱熹","sectionLabel":null,"text":"興也。汜，水決復入為汜。之子，媵妾指嫡妻而言；婦人謂嫁曰歸。我，媵自我也；以，謂挾己而偕行。朱熹以為汜水旁有待年之媵，遭嫡不肯偕行，故見江猶有汜而起興，自言雖今不我以，其後亦將悔之。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"江有渚，之子歸，不我與。不我與，其後也處。","targetNotes":"第二章。","sourceLabel":null,"sourceNotes":"对应 txt 382-384 行。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"朱熹","sectionLabel":null,"text":"興也。渚，小洲也。與猶以也。處，安也，得其所安也。朱熹认为此章仍承首章之意，写嫡妻后来悔悟，不但肯携媵同行，而且能使之得所安处。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"江有沱，之子歸，不我過。不我過，其嘯也歌。","targetNotes":"第三章。","sourceLabel":null,"sourceNotes":"对应 txt 384-388 行。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"朱熹","sectionLabel":null,"text":"興也。沱，江之别者。過，謂過我而與俱也。嘯，蹙口出聲以舒憤懣之氣；歌，则得其所处而乐矣。朱熹以此章为嫡既悔而过我相迎，媵妾遂得所处，故至于嘯歌。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"江有汜三章章五句","targetNotes":"章句总说。","sourceLabel":null,"sourceNotes":"对应 txt 389 行。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"朱熹","sectionLabel":null,"text":"朱熹记《江有汜》为三章，每章五句，并引陈氏语以比照《小星》之夫人惠及媵妾而此诗所写者则惠不及。","notes":null}]}]}}}
