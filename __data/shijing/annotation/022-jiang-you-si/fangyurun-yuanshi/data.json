{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/022-jiang-you-si/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/022-jiang-you-si/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 江有汜 · 注释总览","description":"風 · 召南 · 江有汜 · 汇集《诗经原始(上下)》关于《江有汜》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"022-jiang-you-si","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/022-jiang-you-si/fangyurun-yuanshi","poem":{"id":"022-jiang-you-si","title":"江有汜","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","江有汜"],"segments":[{"id":"seg-001","text":"江有汜","isActive":false},{"id":"seg-002","text":"之子歸","isActive":false},{"id":"seg-003","text":"不我以","isActive":false},{"id":"seg-004","text":"不我以","isActive":false},{"id":"seg-005","text":"其後也悔","isActive":false},{"id":"seg-006","text":"江有渚","isActive":false},{"id":"seg-007","text":"之子歸","isActive":false},{"id":"seg-008","text":"不我與","isActive":false},{"id":"seg-009","text":"不我與","isActive":false},{"id":"seg-010","text":"其後也處","isActive":false},{"id":"seg-011","text":"江有沱","isActive":false},{"id":"seg-012","text":"之子歸","isActive":false},{"id":"seg-013","text":"不我過","isActive":false},{"id":"seg-014","text":"不我過","isActive":false},{"id":"seg-015","text":"其嘯也歌","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"江有汜㊟商婦爲夫所棄而無懟也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标题段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注","text":"方玉润于题注中改定此诗为商人妻妾或弃妇之辞，总之是为夫所弃而仍不怨怼，不取诸儒泥于媵妾备数的传统说法。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"江有汜，之子歸，不我以。不我以，其後也悔。江有渚，之子歸，不我與。不我與，其後也處。江有沱，之子歸，不我過。不我過，其嘯也歌。","targetNotes":"通篇总评。","sourceLabel":null,"sourceNotes":"对应 EPUB item 正文与总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":null,"text":"方玉润承认《序》所谓“嫡不以媵备数，嫡亦自悔”大意未必全非，但力辨此诗未必专为媵妾作，更可能是商人妻妾或弃妇自叹之词。他尤其指出“嘯歌”并非和乐，而是借长啸悲歌发泄郁积；三章由“不我以”至“不我與”再至“不我過”，正写被弃者从尚盼回顾到终被遗绝，只得自宽自解。故此诗虽可怨，而终不失忠厚。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"term","layerLabel":"字词注","targetText":"江有汜江有渚江有沱","targetNotes":"集释所及名物字义。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"集释","sectionLabel":null,"text":"集释释“汜”为江水决而复入者，“渚”为小洲，“沱”为江之别流。三字所指皆是江水分合变迁的地貌，因此最能与诗中离合去留的情绪互相发明。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"标韵","targetNotes":"各章韵脚与通韵说明。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标韵段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"标韵","sectionLabel":null,"text":"标韵以首章“汜”“以”“悔”列纸、止、贿通韵；次章“渚”“與”“處”归语部本韵；末章“沱”“過”“歌”归歌部本韵。三章章章换部，而章法整齐。","notes":null}]}]}}}
