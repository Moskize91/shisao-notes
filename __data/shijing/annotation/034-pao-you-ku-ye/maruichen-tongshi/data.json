{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/034-pao-you-ku-ye/maruichen-tongshi","dataHref":"/__data/shijing/annotation/034-pao-you-ku-ye/maruichen-tongshi/data.json","title":"毛詩傳箋通釋 · 匏有苦葉 · 注释总览","description":"風 · 邶風 · 匏有苦葉 · 汇集《毛詩傳箋通釋》关于《匏有苦葉》的 1 条注释，含 1 条注脚。"},"payload":{"detail":{"route":{"poemId":"034-pao-you-ku-ye","materialId":"maruichen-tongshi"},"href":"/shijing/annotation/034-pao-you-ku-ye/maruichen-tongshi","poem":{"id":"034-pao-you-ku-ye","title":"匏有苦葉","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","匏有苦葉"],"segments":[{"id":"seg-001","text":"匏有苦葉","isActive":true},{"id":"seg-002","text":"濟有深涉","isActive":true},{"id":"seg-003","text":"深則厲","isActive":true},{"id":"seg-004","text":"淺則揭","isActive":true},{"id":"seg-005","text":"有瀰濟盈","isActive":true},{"id":"seg-006","text":"有鷕雉鳴","isActive":true},{"id":"seg-007","text":"濟盈不濡軌","isActive":true},{"id":"seg-008","text":"雉鳴求其牡","isActive":true},{"id":"seg-009","text":"雝雝鳴雁","isActive":true},{"id":"seg-010","text":"旭日始旦","isActive":true},{"id":"seg-011","text":"士如歸妻","isActive":true},{"id":"seg-012","text":"迨冰未泮","isActive":true},{"id":"seg-013","text":"招招舟子","isActive":true},{"id":"seg-014","text":"人涉卬否","isActive":true},{"id":"seg-015","text":"人涉卬否","isActive":true},{"id":"seg-016","text":"卬須我友","isActive":true}]},"material":{"id":"maruichen-tongshi","title":"毛詩傳箋通釋","authors":["馬瑞辰"],"contributorLine":"清 · 馬瑞辰","era":"清","publicationYear":1989,"carrier":"PDF"},"stats":{"annotationCount":1,"glossCount":1},"annotations":[{"id":"0001","order":1,"total":1,"layer":"span","layerLabel":"诗句片段","targetText":"匏有苦葉，濟有深涉。深則厲，淺則揭。有瀰濟盈，有鷕雉鳴。濟盈不濡軌，雉鳴求其牡。雝雝鳴雁，旭日始旦。士如歸妻，迨冰未泮。招招舟子，人涉卬否。人涉卬否，卬須我友。","targetNotes":"整篇按语与字义考。","sourceLabel":"第 61-62 页","sourceNotes":"依据 /tmp/pao-maruichen/p115.png 与 /tmp/pao-maruichen/p116.png 中《匏有苦葉》条。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"马瑞辰","sectionLabel":"按","text":"马瑞辰论《匏有苦葉》时，细辨“匏”“厲”“揭”“鷕”“求牡”“歸妻”等字义，并反复讨论毛、郑与三家诗说。其按语重心在于说明诗中涉水、鸣雉、鸣雁、舟子诸喻如何层层牵引出婚姻礼义与配偶相须之义。","notes":null}]}]}}}
