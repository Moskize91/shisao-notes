{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/034-pao-you-ku-ye/maoheng-zhushu-kr1c0004","dataHref":"/__data/shijing/annotation/034-pao-you-ku-ye/maoheng-zhushu-kr1c0004/data.json","title":"毛詩注疏 · 匏有苦葉 · 注释总览","description":"風 · 邶風 · 匏有苦葉 · 汇集《毛詩注疏》关于《匏有苦葉》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"034-pao-you-ku-ye","materialId":"maoheng-zhushu-kr1c0004"},"href":"/shijing/annotation/034-pao-you-ku-ye/maoheng-zhushu-kr1c0004","poem":{"id":"034-pao-you-ku-ye","title":"匏有苦葉","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","匏有苦葉"],"segments":[{"id":"seg-001","text":"匏有苦葉","isActive":false},{"id":"seg-002","text":"濟有深涉","isActive":false},{"id":"seg-003","text":"深則厲","isActive":false},{"id":"seg-004","text":"淺則揭","isActive":false},{"id":"seg-005","text":"有瀰濟盈","isActive":false},{"id":"seg-006","text":"有鷕雉鳴","isActive":false},{"id":"seg-007","text":"濟盈不濡軌","isActive":false},{"id":"seg-008","text":"雉鳴求其牡","isActive":false},{"id":"seg-009","text":"雝雝鳴雁","isActive":false},{"id":"seg-010","text":"旭日始旦","isActive":false},{"id":"seg-011","text":"士如歸妻","isActive":false},{"id":"seg-012","text":"迨冰未泮","isActive":false},{"id":"seg-013","text":"招招舟子","isActive":false},{"id":"seg-014","text":"人涉卬否","isActive":false},{"id":"seg-015","text":"人涉卬否","isActive":false},{"id":"seg-016","text":"卬須我友","isActive":false}]},"material":{"id":"maoheng-zhushu-kr1c0004","title":"毛詩注疏","authors":["毛亨","鄭氏","孔穎達"],"contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","era":"漢唐","publicationYear":653,"carrier":"TXT"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"preface","layerLabel":"篇序","targetText":"匏有苦葉刺衛宣公也公與夫人並爲淫亂","targetNotes":"篇首小序。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》匏有苦葉序文。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序","text":"序：《匏有苦葉》，刺衛宣公也。公與夫人並爲淫亂。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"匏有苦葉濟有深涉深則厲淺則揭","targetNotes":"首章。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》首章。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：匏謂之瓠，瓠葉苦不可食也。濟，渡也。以衣涉水為厲。揭，褰衣也。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"有瀰濟盈有鷕雉鳴濟盈不濡軌雉鳴求其牡","targetNotes":"第二章。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》第二章。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：瀰，深水也。盈，滿也。鷕，雌雉聲也。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"雝雝鳴雁旭日始旦士如歸妻迨冰未泮","targetNotes":"第三章。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》第三章。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：雝雝，雁聲和也。旭日始出。迨，及。泮，散也。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"招招舟子人涉卬否人涉卬否卬須我友","targetNotes":"第四章。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》第四章。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：招招，號召之貌。舟子，舟人，主濟渡者。卬，我也。","notes":null}]}]}}}
