{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/034-pao-you-ku-ye/chenhuan-chuanshu","dataHref":"/__data/shijing/annotation/034-pao-you-ku-ye/chenhuan-chuanshu/data.json","title":"詩毛氏傳疏 · 匏有苦葉 · 注释总览","description":"風 · 邶風 · 匏有苦葉 · 汇集《詩毛氏傳疏》关于《匏有苦葉》的 2 条注释，含 2 条注脚。"},"payload":{"detail":{"route":{"poemId":"034-pao-you-ku-ye","materialId":"chenhuan-chuanshu"},"href":"/shijing/annotation/034-pao-you-ku-ye/chenhuan-chuanshu","poem":{"id":"034-pao-you-ku-ye","title":"匏有苦葉","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","匏有苦葉"],"segments":[{"id":"seg-001","text":"匏有苦葉","isActive":false},{"id":"seg-002","text":"濟有深涉","isActive":false},{"id":"seg-003","text":"深則厲","isActive":false},{"id":"seg-004","text":"淺則揭","isActive":false},{"id":"seg-005","text":"有瀰濟盈","isActive":false},{"id":"seg-006","text":"有鷕雉鳴","isActive":false},{"id":"seg-007","text":"濟盈不濡軌","isActive":false},{"id":"seg-008","text":"雉鳴求其牡","isActive":false},{"id":"seg-009","text":"雝雝鳴雁","isActive":false},{"id":"seg-010","text":"旭日始旦","isActive":false},{"id":"seg-011","text":"士如歸妻","isActive":false},{"id":"seg-012","text":"迨冰未泮","isActive":false},{"id":"seg-013","text":"招招舟子","isActive":false},{"id":"seg-014","text":"人涉卬否","isActive":false},{"id":"seg-015","text":"人涉卬否","isActive":false},{"id":"seg-016","text":"卬須我友","isActive":false}]},"material":{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","authors":["陳奐"],"contributorLine":"清 · 陳奐","era":"清","publicationYear":1847,"carrier":"PDF"},"stats":{"annotationCount":2,"glossCount":2},"annotations":[{"id":"0001","order":1,"total":2,"layer":"preface","layerLabel":"篇序","targetText":"匏有苦葉刺衛宣公也公與夫人並爲淫亂","targetNotes":"篇首小序。","sourceLabel":"第 56 页","sourceNotes":"书内页 56 篇首序文。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序","text":"序：《匏有苦葉》，刺衛宣公也。公與夫人並爲淫亂。","notes":null}]},{"id":"0002","order":2,"total":2,"layer":"span","layerLabel":"诗句片段","targetText":"匏有苦葉，濟有深涉。深則厲，淺則揭。有瀰濟盈，有鷕雉鳴。濟盈不濡軌，雉鳴求其牡。雝雝鳴雁，旭日始旦。士如歸妻，迨冰未泮。招招舟子，人涉卬否。人涉卬否，卬須我友。","targetNotes":"通篇经传疏解。","sourceLabel":"第 56-57 页","sourceNotes":"据第 56-57 页《匏有苦葉》经传疏。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"陈奂疏《匏有苦葉》时遵《序》刺宣公及夷姜淫乱说，认为首、三章责宣公不依礼娶，二、四章责夫人犯礼求公。其疏紧扣“深浅”“雉鸣求牡”“归妻”“卬须我友”等语，反复申明婚姻应有礼义与配耦次序。","notes":null}]}]}}}
