{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/034-pao-you-ku-ye/zhuxi-shijichuan-kr1c0009","dataHref":"/__data/shijing/annotation/034-pao-you-ku-ye/zhuxi-shijichuan-kr1c0009/data.json","title":"詩集傳 · 匏有苦葉 · 注释总览","description":"風 · 邶風 · 匏有苦葉 · 汇集《詩集傳》关于《匏有苦葉》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"034-pao-you-ku-ye","materialId":"zhuxi-shijichuan-kr1c0009"},"href":"/shijing/annotation/034-pao-you-ku-ye/zhuxi-shijichuan-kr1c0009","poem":{"id":"034-pao-you-ku-ye","title":"匏有苦葉","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","匏有苦葉"],"segments":[{"id":"seg-001","text":"匏有苦葉","isActive":true},{"id":"seg-002","text":"濟有深涉","isActive":true},{"id":"seg-003","text":"深則厲","isActive":true},{"id":"seg-004","text":"淺則揭","isActive":true},{"id":"seg-005","text":"有瀰濟盈","isActive":false},{"id":"seg-006","text":"有鷕雉鳴","isActive":false},{"id":"seg-007","text":"濟盈不濡軌","isActive":false},{"id":"seg-008","text":"雉鳴求其牡","isActive":false},{"id":"seg-009","text":"雝雝鳴雁","isActive":false},{"id":"seg-010","text":"旭日始旦","isActive":false},{"id":"seg-011","text":"士如歸妻","isActive":false},{"id":"seg-012","text":"迨冰未泮","isActive":false},{"id":"seg-013","text":"招招舟子","isActive":false},{"id":"seg-014","text":"人涉卬否","isActive":false},{"id":"seg-015","text":"人涉卬否","isActive":false},{"id":"seg-016","text":"卬須我友","isActive":false}]},"material":{"id":"zhuxi-shijichuan-kr1c0009","title":"詩集傳","authors":["朱熹"],"contributorLine":"宋 · 朱熹","era":"宋","publicationYear":1186,"carrier":"TXT"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"匏有苦葉、濟有深涉。深則厲、淺則揭。","targetNotes":"首章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》匏有苦葉首章。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"朱熹","sectionLabel":null,"text":"比也。朱熹以苦匏未可用、而濟水方深作比，认为男女之际也当量度礼义而行，首章即以涉水浅深喻男女交际之分寸。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"有瀰濟盈、有鷕雉鳴。濟盈不濡軌、雉鳴求其牡。","targetNotes":"第二章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》第二章。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"朱熹","sectionLabel":null,"text":"比也。朱熹认为“濟盈必濡其軌，雉鳴當求其雄”才是常理，而今反说不濡轨、求其牡，是借反常之辞比淫乱之人不度礼义、非其配耦而相求。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"雝雝鳴雁、旭日始旦。士如歸妻、迨冰未泮。","targetNotes":"第三章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》第三章。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"朱熹","sectionLabel":null,"text":"賦也。朱熹说雁、旭日、归妻、冰未泮都是古人婚姻行礼的时令与程序，意在以古礼之有节深刺淫乱之人。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"招招舟子、人涉卬否。人涉卬否、卬須我友。","targetNotes":"第四章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》第四章。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"朱熹","sectionLabel":null,"text":"比也。朱熹以舟人招人渡水比媒人会合男女，众人皆从而我独否，则是待我配偶而后从之；此章明说男女必待其配耦而相从。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"匏有苦葉四章章四句","targetNotes":"章句总说。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》匏有苦葉章句总说。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"朱熹","sectionLabel":null,"text":"朱熹记《匏有苦葉》为四章、章四句，并总以刺淫乱之诗视之。","notes":null}]}]}}}
