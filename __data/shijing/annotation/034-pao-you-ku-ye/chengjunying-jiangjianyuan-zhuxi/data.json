{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/034-pao-you-ku-ye/chengjunying-jiangjianyuan-zhuxi","dataHref":"/__data/shijing/annotation/034-pao-you-ku-ye/chengjunying-jiangjianyuan-zhuxi/data.json","title":"詩經注析 · 匏有苦葉 · 注释总览","description":"風 · 邶風 · 匏有苦葉 · 汇集《詩經注析》关于《匏有苦葉》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"034-pao-you-ku-ye","materialId":"chengjunying-jiangjianyuan-zhuxi"},"href":"/shijing/annotation/034-pao-you-ku-ye/chengjunying-jiangjianyuan-zhuxi","poem":{"id":"034-pao-you-ku-ye","title":"匏有苦葉","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","匏有苦葉"],"segments":[{"id":"seg-001","text":"匏有苦叶","isActive":false},{"id":"seg-002","text":"济有深涉","isActive":false},{"id":"seg-003","text":"深则厉","isActive":false},{"id":"seg-004","text":"浅则揭","isActive":false},{"id":"seg-005","text":"有瀰济盈","isActive":false},{"id":"seg-006","text":"有鷕雉鸣","isActive":false},{"id":"seg-007","text":"济盈不濡轨","isActive":false},{"id":"seg-008","text":"雉鸣求其牡","isActive":false},{"id":"seg-009","text":"雝雝鸣雁","isActive":false},{"id":"seg-010","text":"旭日始旦","isActive":false},{"id":"seg-011","text":"士如归妻","isActive":false},{"id":"seg-012","text":"迨冰未泮","isActive":false},{"id":"seg-013","text":"招招舟子","isActive":false},{"id":"seg-014","text":"人涉卬否","isActive":false},{"id":"seg-015","text":"人涉卬否","isActive":false},{"id":"seg-016","text":"卬须我友","isActive":false}]},"material":{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","authors":["程俊英","蔣見元"],"contributorLine":"现代 · 程俊英、蔣見元","era":"现代","publicationYear":1991,"carrier":"PDF"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"题解","targetNotes":"题解总说。","sourceLabel":"第 67 页","sourceNotes":"书内页 67《题解》段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"程、蒋将《匏有苦叶》解释为女子在济水边等待未婚夫时所唱的诗，不取毛序“刺卫宣公、与夫人淫乱”的旧说。题解引朱熹、王引之以来诸说，认为这是一篇由渡口景物层层兴起、写待婚女子心急而又自持的作品。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"匏有苦叶，济有深涉。深则厉，浅则揭。","targetNotes":"首章。","sourceLabel":"第 68 页","sourceNotes":"书内页 68 首章注析。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"注析","text":"程、蒋释“匏”为葫芦，“厉”“揭”皆涉水之法，认为首章以济水深浅设喻，点出渡口环境与择偶行事都须审度时机，是全篇起意之纲领。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"有瀰济盈，有鷕雉鸣。济盈不濡轨，雉鸣求其牡。","targetNotes":"第二章。","sourceLabel":"第 68-69 页","sourceNotes":"书内页 68-69 第二章注析。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"注析","text":"在程、蒋看来，第二章由渡口之水满与雌雉求偶的鸣声，进一步托出婚嫁情意已迫近成熟。“济盈不濡轨”与“求其牡”都带着试探和盼望，隐约写出女子心动而未敢直言。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"雝雝鸣雁，旭日始旦。士如归妻，迨冰未泮。","targetNotes":"第三章。","sourceLabel":"第 69 页","sourceNotes":"书内页 69 第三章注析。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"注析","text":"程、蒋释鸣雁、旭日为婚礼时令之景，认为本章已从泛写景物转入正意，明说婚娶应当趁冰未泮的适时完成，表现待嫁女子既有向往也有催促。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"招招舟子，人涉卬否。人涉卬否，卬须我友。","targetNotes":"第四章。","sourceLabel":"第 69 页","sourceNotes":"书内页 69 第四章注析。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"注析","text":"末章里程、蒋将“卬须我友”解作我还要等待我的配偶，认为这是女子终于现身说话，既不肯草率涉水，也不肯草率嫁人，全诗于是从景兴转为人物收束。","notes":null}]}]}}}
