{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/034-pao-you-ku-ye/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/034-pao-you-ku-ye/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 匏有苦葉 · 注释总览","description":"風 · 邶風 · 匏有苦葉 · 汇集《诗经原始(上下)》关于《匏有苦葉》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"034-pao-you-ku-ye","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/034-pao-you-ku-ye/fangyurun-yuanshi","poem":{"id":"034-pao-you-ku-ye","title":"匏有苦葉","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","匏有苦葉"],"segments":[{"id":"seg-001","text":"匏有苦葉","isActive":false},{"id":"seg-002","text":"濟有深涉","isActive":false},{"id":"seg-003","text":"深則厲","isActive":false},{"id":"seg-004","text":"淺則揭","isActive":false},{"id":"seg-005","text":"有瀰濟盈","isActive":false},{"id":"seg-006","text":"有鷕雉鳴","isActive":false},{"id":"seg-007","text":"濟盈不濡軌","isActive":false},{"id":"seg-008","text":"雉鳴求其牡","isActive":false},{"id":"seg-009","text":"雝雝鳴雁","isActive":false},{"id":"seg-010","text":"旭日始旦","isActive":false},{"id":"seg-011","text":"士如歸妻","isActive":false},{"id":"seg-012","text":"迨冰未泮","isActive":false},{"id":"seg-013","text":"招招舟子","isActive":false},{"id":"seg-014","text":"人涉卬否","isActive":false},{"id":"seg-015","text":"人涉卬否","isActive":false},{"id":"seg-016","text":"卬須我友","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"匏有苦葉㊟刺世禮義澌滅也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标题段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注","text":"方玉润在题注中径定《匏有苦葉》为“刺世禮義澌滅”之诗，不专坐实于卫宣公、夷姜一事。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"总评","targetNotes":"通篇总评。","sourceLabel":null,"sourceNotes":"对应 EPUB item 总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"总评","text":"方玉润总评中力驳《序》与姚际恒将四章割裂、拘于“雉鸣求其牡”实指宣公之说，认为通篇原是一篇讽世座右铭。首章借涉水喻涉世，次章从不知深浅引出越礼犯分之人，三、四章则转入婚姻与同舟之道，以正反开合铺写礼义纲纪。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"眉评","targetNotes":"篇中眉评撮要。","sourceLabel":null,"sourceNotes":"对应 EPUB item 眉评内容。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"眉评","text":"方玉润眉评称首章“正起”，二章“翻承”，三、四章分正、转两层说，全篇以涉水喻处世，雉雁喻伦物，局阵离奇而脉络井然。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"term","layerLabel":"字词注","targetText":"匏有苦葉濟有深涉深則厲有瀰濟盈有鷕雉鳴濟盈不濡軌雉鳴求其牡雝雝鳴雁士如歸妻招招舟子卬須我友","targetNotes":"集释撮要。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":"集释","text":"方玉润集释云：“匏”性善浮可涉水，“濟”为渡处，“厲揭”为涉水深浅之法，“瀰”为水满，“鷕”为雌雉声，“求牡”意在喻亂倫之人不顾匹偶，“雁”因昏礼用之，“招招”为号召貌，“卬”为我。整组训诂都用来支撑他所说“涉水即处世、婚姻即伦行”的双层结构。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"标韵","targetNotes":"四章韵脚撮述。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标韵段。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"方玉润","sectionLabel":"标韵","text":"方玉润标出《匏有苦葉》四章韵脚：首章“葉、涉、揭”通韵，第二章“盈、鳴”本韵而“軌、牡”叶韵，第三章“旦、泮”本韵，第四章“否、友”本韵。每章自成一转。","notes":null}]}]}}}
