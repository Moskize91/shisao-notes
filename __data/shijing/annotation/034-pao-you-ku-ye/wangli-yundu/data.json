"glosses":[{"key":"0002-1","attributionLabel":"王力","sectionLabel":"韵读"}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"雝雝鸣雁，旭日始旦。士如归妻，迨冰未泮。","targetNotes":"第三章。","sourceLabel":"第 155 页局部","sourceNotes":"第 155 页《匏有苦叶》第三章。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"王力","sectionLabel":"韵读"}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"招招舟子，人涉卬否。人涉卬否，卬须我友。","targetNotes":"第四章。","sourceLabel":"第 155 页局部","sourceNotes":"第 155 页《匏有苦叶》第四章；下接《谷风》。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"王力","sectionLabel":"韵读"}]}]}}}
