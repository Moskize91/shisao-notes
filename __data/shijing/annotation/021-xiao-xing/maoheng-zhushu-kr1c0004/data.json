{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/021-xiao-xing/maoheng-zhushu-kr1c0004","dataHref":"/__data/shijing/annotation/021-xiao-xing/maoheng-zhushu-kr1c0004/data.json","title":"毛詩注疏 · 小星 · 注释总览","description":"風 · 召南 · 小星 · 汇集《毛詩注疏》关于《小星》的 3 条注释，含 3 条注脚。"},"payload":{"detail":{"route":{"poemId":"021-xiao-xing","materialId":"maoheng-zhushu-kr1c0004"},"href":"/shijing/annotation/021-xiao-xing/maoheng-zhushu-kr1c0004","poem":{"id":"021-xiao-xing","title":"小星","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","小星"],"segments":[{"id":"seg-001","text":"嘒彼小星","isActive":false},{"id":"seg-002","text":"三五在東","isActive":false},{"id":"seg-003","text":"肅肅宵征","isActive":false},{"id":"seg-004","text":"夙夜在公","isActive":false},{"id":"seg-005","text":"寔命不同","isActive":false},{"id":"seg-006","text":"嘒彼小星","isActive":false},{"id":"seg-007","text":"維參與昴","isActive":false},{"id":"seg-008","text":"肅肅宵征","isActive":false},{"id":"seg-009","text":"抱衾與裯","isActive":false},{"id":"seg-010","text":"寔命不猶","isActive":false}]},"material":{"id":"maoheng-zhushu-kr1c0004","title":"毛詩注疏","authors":["毛亨","鄭氏","孔穎達"],"contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","era":"漢唐","publicationYear":653,"carrier":"TXT"},"stats":{"annotationCount":3,"glossCount":3},"annotations":[{"id":"0001","order":1,"total":3,"layer":"preface","layerLabel":"篇序","targetText":"小星惠及下也夫人無妬忌之行惠及賤妾進御於君知其命有貴賤能盡其心矣","targetNotes":"篇首小序。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經/小星》序文。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序","text":"序：《小星》，惠及下也。夫人無妬忌之行，惠及賤妾，進御於君，知其命有貴賤，能盡其心矣。","notes":null}]},{"id":"0002","order":2,"total":3,"layer":"span","layerLabel":"诗句片段","targetText":"嘒彼小星三五在東肅肅宵征夙夜在公寔命不同","targetNotes":"首章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經/小星》首章。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：嘒，微貌。三五，心噣也。肅肅，疾貌。夙夜，早夜也。寔，是也。","notes":null}]},{"id":"0003","order":3,"total":3,"layer":"span","layerLabel":"诗句片段","targetText":"嘒彼小星維參與昴肅肅宵征抱衾與裯寔命不猶","targetNotes":"第二章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經/小星》第二章。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：參，伐也。昴，留也。衾，被也。裯，禪被也。猶，若也。","notes":null}]}]}}}
