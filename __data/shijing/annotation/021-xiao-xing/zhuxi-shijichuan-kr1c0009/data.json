{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/021-xiao-xing/zhuxi-shijichuan-kr1c0009","dataHref":"/__data/shijing/annotation/021-xiao-xing/zhuxi-shijichuan-kr1c0009/data.json","title":"詩集傳 · 小星 · 注释总览","description":"風 · 召南 · 小星 · 汇集《詩集傳》关于《小星》的 3 条注释，含 3 条注脚。"},"payload":{"detail":{"route":{"poemId":"021-xiao-xing","materialId":"zhuxi-shijichuan-kr1c0009"},"href":"/shijing/annotation/021-xiao-xing/zhuxi-shijichuan-kr1c0009","poem":{"id":"021-xiao-xing","title":"小星","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","小星"],"segments":[{"id":"seg-001","text":"嘒彼小星","isActive":true},{"id":"seg-002","text":"三五在東","isActive":true},{"id":"seg-003","text":"肅肅宵征","isActive":true},{"id":"seg-004","text":"夙夜在公","isActive":true},{"id":"seg-005","text":"寔命不同","isActive":true},{"id":"seg-006","text":"嘒彼小星","isActive":false},{"id":"seg-007","text":"維參與昴","isActive":false},{"id":"seg-008","text":"肅肅宵征","isActive":false},{"id":"seg-009","text":"抱衾與裯","isActive":false},{"id":"seg-010","text":"寔命不猶","isActive":false}]},"material":{"id":"zhuxi-shijichuan-kr1c0009","title":"詩集傳","authors":["朱熹"],"contributorLine":"宋 · 朱熹","era":"宋","publicationYear":1186,"carrier":"TXT"},"stats":{"annotationCount":3,"glossCount":3},"annotations":[{"id":"0001","order":1,"total":3,"layer":"span","layerLabel":"诗句片段","targetText":"嘒彼小星，三五在東。肅肅宵征，夙夜在公，寔命不同。","targetNotes":"首章。","sourceLabel":null,"sourceNotes":"对应 txt 363-369 行。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"朱熹","sectionLabel":null,"text":"興也。嘒，微貌。三五言其稀，蓋初昏或將旦時也。肅肅，齊遫貌；宵征，夜行也。命不同，謂天所賦之分不同。朱熹承序說，以為南國夫人能惠及眾妾，故其進御於君夕往晨還，因見小星在東與夙夜在公而起興，自知命分不及貴者，故雖勤勞往來而不敢致怨。","notes":null}]},{"id":"0002","order":2,"total":3,"layer":"span","layerLabel":"诗句片段","targetText":"嘒彼小星，維參與昴。肅肅宵征，抱衾與裯，寔命不猶。","targetNotes":"第二章。","sourceLabel":null,"sourceNotes":"对应 txt 369-373 行。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"朱熹","sectionLabel":null,"text":"興也。參、昴為西方二宿之名，衾為被，裯為襌被；“與昴”“與裯”相應，亦以見興。“不猶”亦是不同之意。朱熹以為次章仍寫眾妾奉召夜行，自攜衾裯而往，愈見其勞，而所以能安其命者，正在感夫人之惠，不敢怨其來往之勤。","notes":null}]},{"id":"0003","order":3,"total":3,"layer":"global","layerLabel":"全篇总说","targetText":"小星二章章五句","targetNotes":"章句总说。","sourceLabel":null,"sourceNotes":"对应 txt 374 行。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"朱熹","sectionLabel":null,"text":"朱熹记《小星》为二章，每章五句，并引吕氏语以申说夫人无妒忌而贱妾安其命。","notes":null}]}]}}}
