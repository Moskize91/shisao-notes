{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/021-xiao-xing/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/021-xiao-xing/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 小星 · 注释总览","description":"風 · 召南 · 小星 · 汇集《诗经原始(上下)》关于《小星》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"021-xiao-xing","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/021-xiao-xing/fangyurun-yuanshi","poem":{"id":"021-xiao-xing","title":"小星","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","小星"],"segments":[{"id":"seg-001","text":"嘒彼小星","isActive":false},{"id":"seg-002","text":"三五在東","isActive":false},{"id":"seg-003","text":"肅肅宵征","isActive":false},{"id":"seg-004","text":"夙夜在公","isActive":false},{"id":"seg-005","text":"寔命不同","isActive":false},{"id":"seg-006","text":"嘒彼小星","isActive":false},{"id":"seg-007","text":"維參與昴","isActive":false},{"id":"seg-008","text":"肅肅宵征","isActive":false},{"id":"seg-009","text":"抱衾與裯","isActive":false},{"id":"seg-010","text":"寔命不猶","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"小星㊟小臣行役自甘也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标题段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注","text":"方玉润在题注中直断《小星》为小臣行役之作，并强调其人虽夙夜奔走而能安命自甘，不取《序》与《集传》所谓夫人惠及贱妾的旧解。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"嘒彼小星，三五在東。肅肅宵征，夙夜在公。寔命不同。嘒彼小星，維參與昴。肅肅宵征，抱衾與裯。寔命不猶。","targetNotes":"通篇总评。","sourceLabel":null,"sourceNotes":"对应 EPUB item 正文与总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":null,"text":"方玉润力斥《小序》《大序》及朱熹把此篇解作众妾进御的旧说，认为除“抱衾與裯”外全诗都不类闺词，而更合章俊卿、姚际恒所谓“小臣行役”之旨。在他看来，“肅肅宵征”“夙夜在公”明写勤劳王事，“寔命不同”则指臣工位次有别、劳逸悬殊；诗人既知命分不同而仍各安其职、不敢有怨，正见文王用人得平，下士虽劳而能自甘。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"term","layerLabel":"字词注","targetText":"嘒彼小星三五在東維參與昴抱衾與裯寔命不猶","targetNotes":"集释所及名物字义。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"集释","sectionLabel":null,"text":"集释释“嘒”为微貌，“三五”指初昏或将旦时所见稀星，“參”“昴”为西方二宿之名；又解“衾”为被、“裯”为单被，“猶”为同类相若。整组训释都围绕夜行见星、抱被在外的行役处境展开。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"标韵","targetNotes":"各章韵脚与通韵说明。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标韵段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"标韵","sectionLabel":null,"text":"标韵以首章“東”“公”“同”归东部本韵；次章则将“昴”依旧说读作“留”，与“裯”“猶”同收尤部。两章各自成韵，而第二章特别说明“昴”须改读以就韵。","notes":null}]}]}}}
