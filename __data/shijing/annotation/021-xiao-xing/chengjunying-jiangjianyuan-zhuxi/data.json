{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/021-xiao-xing/chengjunying-jiangjianyuan-zhuxi","dataHref":"/__data/shijing/annotation/021-xiao-xing/chengjunying-jiangjianyuan-zhuxi/data.json","title":"詩經注析 · 小星 · 注释总览","description":"風 · 召南 · 小星 · 汇集《詩經注析》关于《小星》的 3 条注释，含 3 条注脚。"},"payload":{"detail":{"route":{"poemId":"021-xiao-xing","materialId":"chengjunying-jiangjianyuan-zhuxi"},"href":"/shijing/annotation/021-xiao-xing/chengjunying-jiangjianyuan-zhuxi","poem":{"id":"021-xiao-xing","title":"小星","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","小星"],"segments":[{"id":"seg-001","text":"嘒彼小星","isActive":false},{"id":"seg-002","text":"三五在东","isActive":false},{"id":"seg-003","text":"肃肃宵征","isActive":false},{"id":"seg-004","text":"夙夜在公","isActive":false},{"id":"seg-005","text":"实命不同","isActive":false},{"id":"seg-006","text":"嘒彼小星","isActive":false},{"id":"seg-007","text":"维参与昴","isActive":false},{"id":"seg-008","text":"肃肃宵征","isActive":false},{"id":"seg-009","text":"抱衾与裯","isActive":false},{"id":"seg-010","text":"实命不犹","isActive":false}]},"material":{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","authors":["程俊英","蔣見元"],"contributorLine":"现代 · 程俊英、蔣見元","era":"现代","publicationYear":1991,"carrier":"PDF"},"stats":{"annotationCount":3,"glossCount":3},"annotations":[{"id":"0001","order":1,"total":3,"layer":"global","layerLabel":"全篇总说","targetText":"题解","targetNotes":"题解总说。","sourceLabel":"第 38 页","sourceNotes":"书内页 38《题解》段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"题解把《小星》定为小臣夙夜行役而自伤命分不齐之诗，认为诗中“夙夜在公”“抱衾与裯”都更像在外供职奔走，而不像后妃众妾进御之辞。编者梳理洪迈、程大昌、姚际恒、方玉润诸说，整体上取“小臣行役”一路，以见下级吏士勤劳奉公而不得与贵者同命的感慨。","notes":null}]},{"id":"0002","order":2,"total":3,"layer":"span","layerLabel":"诗句片段","targetText":"嘒彼小星，三五在东。肃肃宵征，夙夜在公，实命不同。","targetNotes":"首章。","sourceLabel":"第 39 页","sourceNotes":"书内页 39 首章与注释。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"首章释“嘒”为微光闪烁，“三五”指初昏或将旦时稀疏可见的数星；“肃肃宵征”则是夜行疾趋之貌。编者进而将“夙夜在公”解释为早晚都在官事之中，“实命不同”点出职位贵贱有别，所以通章所写不是宫中恩宠，而是下位者劳于王事的现实。","notes":null}]},{"id":"0003","order":3,"total":3,"layer":"span","layerLabel":"诗句片段","targetText":"嘒彼小星，维参与昴。肃肃宵征，抱衾与裯，实命不犹。","targetNotes":"第二章。","sourceLabel":"第 39 页","sourceNotes":"书内页 39 第二章与注释。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"第二章补释“参”“昴”为星宿名，又以“抱衾与裯”说明行役者夜宿在外，自携寝具，不得安居。“不犹”训为不若、不如，与首章“不同”互文见义。这样两章前后相承，把小臣戴星夜行、勤于公职而自知命分不齐的处境写得更为具体。","notes":null}]}]}}}
