{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/003-juan-er/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/003-juan-er/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 卷耳 · 注释总览","description":"風 · 周南 · 卷耳 · 汇集《诗经原始(上下)》关于《卷耳》的 9 条 annotation，含 9 条 gloss。"},"payload":{"detail":{"route":{"poemId":"003-juan-er","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/003-juan-er/fangyurun-yuanshi","poem":{"id":"003-juan-er","title":"卷耳","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","卷耳"],"segments":[{"id":"seg-001","text":"采采卷耳","isActive":false},{"id":"seg-002","text":"不盈頃筐","isActive":false},{"id":"seg-003","text":"嗟我懷人","isActive":false},{"id":"seg-004","text":"寘彼周行","isActive":false},{"id":"seg-005","text":"陟彼崔嵬","isActive":false},{"id":"seg-006","text":"我馬虺隤","isActive":false},{"id":"seg-007","text":"我姑酌彼金罍","isActive":false},{"id":"seg-008","text":"維以不永懷","isActive":false},{"id":"seg-009","text":"陟彼高岡","isActive":false},{"id":"seg-010","text":"我馬玄黄","isActive":false},{"id":"seg-011","text":"我姑酌彼兕觥","isActive":false},{"id":"seg-012","text":"維以不永傷","isActive":false},{"id":"seg-013","text":"陟彼砠矣","isActive":false},{"id":"seg-014","text":"我馬瘏矣","isActive":false},{"id":"seg-015","text":"我僕痡矣","isActive":false},{"id":"seg-016","text":"云何吁矣","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":9,"glossCount":9},"annotations":[{"id":"0001","order":1,"total":9,"layer":"global","layerLabel":"全篇总说","targetText":"题注与四章章次总提","targetNotes":"对应 item-0012 题注与章次总提。","sourceLabel":null,"sourceNotes":"item-0012.txt 第 3-8 行。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注","text":"题注为“念行役而知婦情之篤也”。并以四章次第铺陈，由采卷耳起念而层递想像行役劳苦。","notes":null}]},{"id":"0002","order":2,"total":9,"layer":"span","layerLabel":"诗句片段","targetText":"采采卷耳，不盈頃筐。嗟我懷人，寘彼周行。","targetNotes":"第一章。","sourceLabel":null,"sourceNotes":"item-0012.txt 第 5 行。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":null,"text":"首章写采卷耳而忽起懷人，故筐未满即“寘彼周行”。方氏并提示“後三章從此生出”，以此为全诗发端。","notes":null}]},{"id":"0003","order":3,"total":9,"layer":"span","layerLabel":"诗句片段","targetText":"陟彼崔嵬，我馬虺隤。我姑酌彼金罍，維以不永懷。","targetNotes":"第二章。","sourceLabel":null,"sourceNotes":"item-0012.txt 第 6 行。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":null,"text":"次章转作对面想像：跋涉崔嵬而馬已虺隤，故欲酌彼金罍以宽久懷。方氏并注“我馬”之“我”是对夫馬的亲呼，“我姑酌彼”之“我”则为懷人者自我。","notes":null}]},{"id":"0004","order":4,"total":9,"layer":"span","layerLabel":"诗句片段","targetText":"陟彼高岡，我馬玄黄。我姑酌彼兕觥，維以不永傷。","targetNotes":"第三章。","sourceLabel":null,"sourceNotes":"item-0012.txt 第 7 行。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":null,"text":"三章承上，更想其行役至高岡而馬色玄黄。又以“我姑酌彼兕觥，維以不永傷”写强自排忧。","notes":null}]},{"id":"0005","order":5,"total":9,"layer":"span","layerLabel":"诗句片段","targetText":"陟彼砠矣，我馬瘏矣，我僕痡矣，云何吁矣。","targetNotes":"第四章。","sourceLabel":null,"sourceNotes":"item-0012.txt 第 8 行。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"方玉润","sectionLabel":null,"text":"末章极写劳苦：馬瘏、僕痡，终至“云何吁矣”而无可奈何。方氏评“四矣字，節短音長，虚收有神”，以声情收束全篇。","notes":null}]},{"id":"0006","order":6,"total":9,"layer":"global","layerLabel":"全篇总说","targetText":"总评与篇旨辨析","targetNotes":"右《卷耳》四章后总评。","sourceLabel":null,"sourceNotes":"item-0012.txt 第 10 行。","notes":null,"glosses":[{"key":"0006-1","attributionLabel":"方玉润","sectionLabel":"总评","text":"方氏驳《小序》《大序》以后妃求贤审官说，认为多由《左传》断章取义而误。其定论是此诗当作妇人念夫行役而悯其劳苦，编在《葛覃》之后，一见女工之勤，一见妇情之笃，同属房中乐。若作托辞，也应泛指借夫妇情寓君臣朋友义，不必拘定后妃。","notes":null}]},{"id":"0007","order":7,"total":9,"layer":"global","layerLabel":"全篇总说","targetText":"眉评","targetNotes":"篇后眉评。","sourceLabel":null,"sourceNotes":"item-0012.txt 第 12 行。","notes":null,"glosses":[{"key":"0007-1","attributionLabel":"方玉润","sectionLabel":"眉评","text":"眉评谓首章因采卷耳而动怀人念，故未盈筐即“寘彼周行”，已见一往深情。又谓下三章皆从对面着笔，历想行役劳苦，虽强自宽而终不能宽，末段声情有急管繁弦之势。","notes":null}]},{"id":"0008","order":8,"total":9,"layer":"term","layerLabel":"字词注","targetText":"采采卷耳／不盈頃筐／寘彼周行／陟彼崔嵬／我馬虺隤／我姑酌彼金罍／我姑酌彼兕觥／陟彼砠矣／我馬瘏矣／我僕痡矣","targetNotes":"集释中关键训诂组。","sourceLabel":null,"sourceNotes":"item-0012.txt 第 14 行。","notes":null,"glosses":[{"key":"0008-1","attributionLabel":"集释","sectionLabel":null,"text":"集释汇毛萇、陆璣、郭璞、朱子、姚际恒等说，释卷耳为苓耳、蒼耳之类，并释頃筐、寘、周行诸义。又释崔嵬、虺隤、罍、兕觥、砠、瘏、痡等字词，兼辨《卷耳》《鹿鸣》《大东》三“周行”之异同。","notes":null}]},{"id":"0009","order":9,"total":9,"layer":"global","layerLabel":"全篇总说","targetText":"标韵","targetNotes":"各章韵脚与通韵说明。","sourceLabel":null,"sourceNotes":"item-0012.txt 第 16 行。","notes":null,"glosses":[{"key":"0009-1","attributionLabel":"标韵","sectionLabel":null,"text":"标韵以“筐”为阳部、“人”为真部、“行”为阳部，并谓首章通韵；次章以“嵬、隤、罍、懷”为灰部本韵；三章以“岡、黄”为阳并与“觥”通韵；四章以“砠、瘏、痡、吁”为虞部本韵。并指出此诗除首句外句句用韵。","notes":null}]}]}}}
