{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/003-juan-er/zhuxi-shijichuan-kr1c0009","dataHref":"/__data/shijing/annotation/003-juan-er/zhuxi-shijichuan-kr1c0009/data.json","title":"詩集傳 · 卷耳 · 注释总览","description":"風 · 周南 · 卷耳 · 汇集《詩集傳》关于《卷耳》的 5 条注释，含 8 条注脚。"},"payload":{"detail":{"route":{"poemId":"003-juan-er","materialId":"zhuxi-shijichuan-kr1c0009"},"href":"/shijing/annotation/003-juan-er/zhuxi-shijichuan-kr1c0009","poem":{"id":"003-juan-er","title":"卷耳","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","卷耳"],"segments":[{"id":"seg-001","text":"采采卷耳","isActive":true},{"id":"seg-002","text":"不盈頃筐","isActive":true},{"id":"seg-003","text":"嗟我懷人","isActive":true},{"id":"seg-004","text":"寘彼周行","isActive":true},{"id":"seg-005","text":"陟彼崔嵬","isActive":false},{"id":"seg-006","text":"我馬虺隤","isActive":false},{"id":"seg-007","text":"我姑酌彼金罍","isActive":false},{"id":"seg-008","text":"維以不永懷","isActive":false},{"id":"seg-009","text":"陟彼高岡","isActive":false},{"id":"seg-010","text":"我馬玄黃","isActive":false},{"id":"seg-011","text":"我姑酌彼兕觥","isActive":false},{"id":"seg-012","text":"維以不永傷","isActive":false},{"id":"seg-013","text":"陟彼砠矣","isActive":false},{"id":"seg-014","text":"我馬瘏矣","isActive":false},{"id":"seg-015","text":"我僕痡矣","isActive":false},{"id":"seg-016","text":"云何吁矣","isActive":false}]},"material":{"id":"zhuxi-shijichuan-kr1c0009","title":"詩集傳","authors":["朱熹"],"contributorLine":"宋 · 朱熹","era":"宋","publicationYear":1186,"carrier":"TXT"},"stats":{"annotationCount":5,"glossCount":8},"annotations":[{"id":"0001","order":1,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"采采卷耳，不盈頃筐。嗟我懷人，寘彼周行。","targetNotes":"首章并章句说明。","sourceLabel":null,"sourceNotes":"对应 txt 107-111 行。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"朱熹","sectionLabel":"传","text":"賦也。采采，非二采也。卷耳，枲耳，葉如鼠耳，叢生如盤。頃，欹也。筐，竹器。懷，思也。人，蓋謂文王也。寘，舍也。周行，大道也。","notes":null},{"key":"0001-2","attributionLabel":"朱熹","sectionLabel":"传","text":"后妃以君子不在而思念之，故賦此詩，託言方采卷耳，未滿頃筐，而心適念其君子，故不能復采而寘之大道之旁也。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"陟彼崔嵬，我馬虺隤。我姑酌彼金罍，維以不永懷。","targetNotes":"二章并章句说明。","sourceLabel":null,"sourceNotes":"对应 txt 111-117 行。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"朱熹","sectionLabel":"传","text":"賦也。陟，升也。崔嵬，土山之戴石者。虺隤，馬罷不能升高之病。姑，且也。罍，酒器，刻爲雲雷之象，以黃金飾之。永，長也。","notes":null},{"key":"0002-2","attributionLabel":"朱熹","sectionLabel":"传","text":"此又託言欲登此崔嵬之山，以望所懷之人而往從之；則馬罷病而不能進，於是且酌金罍之酒，而欲其不至於長以爲念也。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"陟彼高岡，我馬玄黃。我姑酌彼兕觥，維以不永傷。","targetNotes":"三章并章句说明。","sourceLabel":null,"sourceNotes":"对应 txt 117-120 行。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"朱熹","sectionLabel":"传","text":"賦也。山脊曰岡。玄黃，玄馬而黃，病極而變色也。兕，野牛，一角青色，重千斤。觥，爵也，以兕角爲爵也。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"陟彼砠矣，我馬瘏矣。我僕痡矣，云何吁矣。","targetNotes":"四章并章句说明。","sourceLabel":null,"sourceNotes":"对应 txt 120-124 行。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"朱熹","sectionLabel":"传","text":"賦也。石山戴土曰砠。瘏，馬病不能進也。痡，人病不能行也。吁，憂嘆也。爾雅注引此作盱，張目望遠也，詳見何人斯篇。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"篇末总评","targetNotes":"章句与义旨总结。","sourceLabel":null,"sourceNotes":"对应 txt 125-127 行。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"朱熹","sectionLabel":"总评","text":"卷耳四章章四句。","notes":null},{"key":"0005-2","attributionLabel":"朱熹","sectionLabel":"总评","text":"此亦后妃所自作，可以見其貞靜專一之至矣。豈當文王朝會征伐之時，羑里拘幽之日而作歟？然不可考矣。","notes":null}]}]}}}
