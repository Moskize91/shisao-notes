{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/003-juan-er/quwanli-quanshi","dataHref":"/__data/shijing/annotation/003-juan-er/quwanli-quanshi/data.json","title":"詩經詮釋 · 卷耳 · 注释总览","description":"風 · 周南 · 卷耳 · 汇集《詩經詮釋》关于《卷耳》的 5 条 annotation，含 5 条 gloss。"},"payload":{"detail":{"route":{"poemId":"003-juan-er","materialId":"quwanli-quanshi"},"href":"/shijing/annotation/003-juan-er/quwanli-quanshi","poem":{"id":"003-juan-er","title":"卷耳","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","卷耳"],"segments":[{"id":"seg-001","text":"采采卷耳","isActive":false},{"id":"seg-002","text":"不盈頃筐","isActive":false},{"id":"seg-003","text":"嗟我懷人","isActive":false},{"id":"seg-004","text":"寘彼周行","isActive":false},{"id":"seg-005","text":"陟彼崔嵬","isActive":false},{"id":"seg-006","text":"我馬虺隤","isActive":false},{"id":"seg-007","text":"我姑酌彼金罍","isActive":false},{"id":"seg-008","text":"維以不永懷","isActive":false},{"id":"seg-009","text":"陟彼高岡","isActive":false},{"id":"seg-010","text":"我馬玄黃","isActive":false},{"id":"seg-011","text":"我姑酌彼兕觥","isActive":false},{"id":"seg-012","text":"維以不永傷","isActive":false},{"id":"seg-013","text":"陟彼砠矣","isActive":false},{"id":"seg-014","text":"我馬瘏矣","isActive":false},{"id":"seg-015","text":"我僕痡矣","isActive":false},{"id":"seg-016","text":"云何吁矣","isActive":false}]},"material":{"id":"quwanli-quanshi","title":"詩經詮釋","authors":["屈萬里"],"contributorLine":"现代 · 屈萬里","era":"现代","publicationYear":1983,"carrier":"PDF"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"《卷耳》全篇旨意","targetNotes":"全篇总说。","sourceLabel":"第 46 页","sourceNotes":"第 46 页《注释》①。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"屈万里","sectionLabel":"注释","text":"此當是行役者思家之詩。首章述家人思己之苦，二、三、四章則行役者自述思家之情；觀其有使有馬，似亦非平民或士卒。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"term","layerLabel":"字词注","targetText":"采采卷耳，不盈頃筐。嗟我懷人，寘彼周行。","targetNotes":"首章训释。","sourceLabel":"第 46 页","sourceNotes":"第 46 页《注释》②至⑦。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"屈万里","sectionLabel":"注释","text":"“采采”是采而又采；“卷耳”即苓耳，一年生草，葉背有微毛，嫩葉可食；“頃筐”為前低后高的淺筐。又釋“懷”為念，“寘”同置，“周行”即周之國道，猶言大道。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"term","layerLabel":"字词注","targetText":"陟彼崔嵬，我馬虺隤。我姑酌彼金罍，維以不永懷。","targetNotes":"第二章训释。","sourceLabel":"第 46 页","sourceNotes":"第 46 页《注释》⑧至⑪。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"屈万里","sectionLabel":"注释","text":"“陟”為登；“崔嵬”訓高峻不平之貌；“虺隤”音灰頹，為疲病貌；“罍”是酒器，金罍即金屬之罍。屈氏並以此章寫行役登高而馬已勞病。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"term","layerLabel":"字词注","targetText":"陟彼高岡，我馬玄黃。我姑酌彼兕觥，維以不永傷。","targetNotes":"第三章训释。","sourceLabel":"第 46-47 页","sourceNotes":"第 46 页末至第 47 页《注释》⑫至⑭。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"屈万里","sectionLabel":"注释","text":"“玄黃”為病貌；“兕觥”因兕角小而杯大，或有足有蓋，蓋皆作牛角形；“傷”即憂。屈氏以此章承前而寫馬病益甚，行役者愁苦更深。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"term","layerLabel":"字词注","targetText":"陟彼砠矣，我馬瘏矣，我僕痡矣，云何吁矣！","targetNotes":"第四章训释。","sourceLabel":"第 47 页","sourceNotes":"第 47 页《注释》⑮至⑱。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"屈万里","sectionLabel":"注释","text":"“砠”音阻，指石山之戴土者；“瘏”音塗，病也；“痡”音敷，小病也；“云何”猶言如何，“吁”是歎聲。此章以山險、馬病、僕勞層層加重，寫行役窮極之情。","notes":null}]}]}}}
