{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/003-juan-er/maoheng-zhushu-kr1c0004","dataHref":"/__data/shijing/annotation/003-juan-er/maoheng-zhushu-kr1c0004/data.json","title":"毛詩注疏 · 卷耳 · 注释总览","description":"風 · 周南 · 卷耳 · 汇集《毛詩注疏》关于《卷耳》的 6 条 annotation，含 11 条 gloss。"},"payload":{"detail":{"route":{"poemId":"003-juan-er","materialId":"maoheng-zhushu-kr1c0004"},"href":"/shijing/annotation/003-juan-er/maoheng-zhushu-kr1c0004","poem":{"id":"003-juan-er","title":"卷耳","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","卷耳"],"segments":[{"id":"seg-001","text":"采采卷耳","isActive":false},{"id":"seg-002","text":"不盈頃筐","isActive":false},{"id":"seg-003","text":"嗟我懷人","isActive":false},{"id":"seg-004","text":"寘彼周行","isActive":false},{"id":"seg-005","text":"陟彼崔嵬","isActive":false},{"id":"seg-006","text":"我馬虺隤","isActive":false},{"id":"seg-007","text":"我姑酌彼金罍","isActive":false},{"id":"seg-008","text":"維以不永懷","isActive":false},{"id":"seg-009","text":"陟彼高岡","isActive":false},{"id":"seg-010","text":"我馬玄黃","isActive":false},{"id":"seg-011","text":"我姑酌彼兕觥","isActive":false},{"id":"seg-012","text":"維以不永傷","isActive":false},{"id":"seg-013","text":"陟彼砠矣","isActive":false},{"id":"seg-014","text":"我馬瘏矣","isActive":false},{"id":"seg-015","text":"我僕痡矣","isActive":false},{"id":"seg-016","text":"云何吁矣","isActive":false}]},"material":{"id":"maoheng-zhushu-kr1c0004","title":"毛詩注疏","authors":["毛亨","鄭氏","孔穎達"],"contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","era":"漢唐","publicationYear":653,"carrier":"TXT"},"stats":{"annotationCount":6,"glossCount":11},"annotations":[{"id":"0001","order":1,"total":6,"layer":"preface","layerLabel":"篇序","targetText":"序《卷耳》","targetNotes":"篇首小序与郑笺。","sourceLabel":null,"sourceNotes":"对应 txt 743-747 行。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序","text":"序：卷耳，后妃之志也。又當輔佐君子，求賢審官，知臣下之勤勞，内有進賢之志，而無險詖私謁之心，朝夕思念，至於憂勤也。","notes":null},{"key":"0001-2","attributionLabel":"郑笺","sectionLabel":null,"text":"箋：謁，請也。","notes":null}]},{"id":"0002","order":2,"total":6,"layer":"span","layerLabel":"诗句片段","targetText":"采采卷耳，不盈頃筐。嗟我懷人，寘彼周行。","targetNotes":"首章。","sourceLabel":null,"sourceNotes":"对应 txt 758-783 行。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：憂者之興也。采采，事采之也。卷耳，苓耳也。頃筐，畚屬易盈之器也。懷，思。寘，置。行，列也。","notes":null},{"key":"0002-2","attributionLabel":"郑笺","sectionLabel":null,"text":"箋云：器之易盈而不盈者，志在輔佐君子，憂思深也。思君子官賢人，置周之列位。","notes":null}]},{"id":"0003","order":3,"total":6,"layer":"span","layerLabel":"诗句片段","targetText":"陟彼崔嵬，我馬虺隤。我姑酌彼金罍，維以不永懷。","targetNotes":"第二章。","sourceLabel":null,"sourceNotes":"对应 txt 784-817 行。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：陟，升也。崔嵬，土山之戴石者。虺隤，病也。姑，且也。人君黃金罍。永，長也。","notes":null},{"key":"0003-2","attributionLabel":"郑笺","sectionLabel":null,"text":"箋云：我，我使臣也。臣以兵役之事行，出離其列位，身勤勞於山險，而馬又病，君子宜知其然。我，我君也。臣出使功成而反，君且當設饗燕之禮，與之飲酒以勞之，我則以是不復長憂思也。言且者，君賞功臣或多於此。","notes":null}]},{"id":"0004","order":4,"total":6,"layer":"span","layerLabel":"诗句片段","targetText":"陟彼高岡，我馬玄黃。我姑酌彼兕觥，維以不永傷。","targetNotes":"第三章。","sourceLabel":null,"sourceNotes":"对应 txt 818-846 行。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：山脊曰岡。玄馬病則黃。兕觥，角爵也。傷，思也。","notes":null},{"key":"0004-2","attributionLabel":"郑笺","sectionLabel":null,"text":"箋云：此章為意不盡，申殷勤也。觥，罰爵也。饗燕所以有之者，飲酒禮自立司正之後，旅醻必有醉而失禮者，罰之亦所以為樂。","notes":null}]},{"id":"0005","order":5,"total":6,"layer":"span","layerLabel":"诗句片段","targetText":"陟彼砠矣，我馬瘏矣。我僕痡矣，云何吁矣。","targetNotes":"第四章。","sourceLabel":null,"sourceNotes":"对应 txt 846-848 行。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：石山戴土曰砠。瘏，病也。痡亦病也。吁，憂也。","notes":null},{"key":"0005-2","attributionLabel":"郑笺","sectionLabel":null,"text":"箋云：此章言臣既勤勞於外，僕馬皆病，而今云何乎其亦憂矣，深閔之辭。","notes":null}]},{"id":"0006","order":6,"total":6,"layer":"global","layerLabel":"全篇总说","targetText":"卷耳四章章四句","targetNotes":"章句总说。","sourceLabel":null,"sourceNotes":"对应 txt 848 行。","notes":null,"glosses":[{"key":"0006-1","attributionLabel":"章句","sectionLabel":null,"text":"卷耳四章章四句。","notes":null}]}]}}}
