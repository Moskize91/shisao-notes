{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/073-da-che/chenhuan-chuanshu","dataHref":"/__data/shijing/annotation/073-da-che/chenhuan-chuanshu/data.json","title":"詩毛氏傳疏 · 大車 · 注释总览","description":"風 · 王風 · 大車 · 汇集《詩毛氏傳疏》关于《大車》的 1 条注释，含 1 条注脚。"},"payload":{"detail":{"route":{"poemId":"073-da-che","materialId":"chenhuan-chuanshu"},"href":"/shijing/annotation/073-da-che/chenhuan-chuanshu","poem":{"id":"073-da-che","title":"大車","categoryId":"feng","subcategoryId":"wangfeng","path":["風","王風","大車"],"segments":[{"id":"seg-001","text":"大車檻檻","isActive":true},{"id":"seg-002","text":"毳衣如菼","isActive":true},{"id":"seg-003","text":"豈不爾思","isActive":true},{"id":"seg-004","text":"畏子不敢","isActive":true},{"id":"seg-005","text":"大車啍啍","isActive":true},{"id":"seg-006","text":"毳衣如璊","isActive":true},{"id":"seg-007","text":"豈不爾思","isActive":true},{"id":"seg-008","text":"畏子不奔","isActive":true},{"id":"seg-009","text":"穀則異室","isActive":true},{"id":"seg-010","text":"死則同穴","isActive":true},{"id":"seg-011","text":"謂予不信","isActive":true},{"id":"seg-012","text":"有如皦日","isActive":true}]},"material":{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","authors":["陳奐"],"contributorLine":"清 · 陳奐","era":"清","publicationYear":1847,"carrier":"PDF"},"stats":{"annotationCount":1,"glossCount":1},"annotations":[{"id":"0001","order":1,"total":1,"layer":"span","layerLabel":"诗句片段","targetText":"大車檻檻，毳衣如菼。豈不爾思？畏子不敢。大車啍啍，毳衣如璊。豈不爾思？畏子不奔。穀則異室，死則同穴。謂予不信，有如皦日。","targetNotes":"全篇疏义。","sourceLabel":"第 75 页","sourceNotes":"据 PDF 页图 /tmp/072-chenhuan/p85.png 定位；/tmp/072-chenhuan/p84.png 尚属《采葛》，/tmp/073-chen-more/p001.png 已转《丘中有麻》。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"陈奂疏《大車》，以“子”为大夫，“毳衣”为大夫之服，并据疏文申明诗中所思者即大夫，而“彼大夫之车不来东也”所以见其不来迎。故前二章以“豈不爾思”“畏子不敢”“畏子不奔”写女子虽思而有所畏，末章则以“穀則異室，死則同穴”见情意之决绝。","notes":"依据 PDF 页图 /tmp/072-chenhuan/p85.png 保守摘录。"}]}]}}}
