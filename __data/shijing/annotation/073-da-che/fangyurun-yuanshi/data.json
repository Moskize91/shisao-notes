{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/073-da-che/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/073-da-che/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 大車 · 注释总览","description":"風 · 王風 · 大車 · 汇集《诗经原始(上下)》关于《大車》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"073-da-che","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/073-da-che/fangyurun-yuanshi","poem":{"id":"073-da-che","title":"大車","categoryId":"feng","subcategoryId":"wangfeng","path":["風","王風","大車"],"segments":[{"id":"seg-001","text":"大車檻檻","isActive":false},{"id":"seg-002","text":"毳衣如菼","isActive":false},{"id":"seg-003","text":"豈不爾思","isActive":false},{"id":"seg-004","text":"畏子不敢","isActive":false},{"id":"seg-005","text":"大車啍啍","isActive":false},{"id":"seg-006","text":"毳衣如璊","isActive":false},{"id":"seg-007","text":"豈不爾思","isActive":false},{"id":"seg-008","text":"畏子不奔","isActive":false},{"id":"seg-009","text":"穀則異室","isActive":false},{"id":"seg-010","text":"死則同穴","isActive":false},{"id":"seg-011","text":"謂予不信","isActive":false},{"id":"seg-012","text":"有如皦日","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"大車㊟征夫歎也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 90 标题段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注","text":"方玉润题注直断《大車》为征夫思室家之叹，先把全篇安置在久役离别、临行诀绝的语境之中。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"总评","targetNotes":"通篇总评。","sourceLabel":null,"sourceNotes":"对应 EPUB item 90 总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"总评","text":"方玉润总评力辨《序》所谓“陳古以刺今”与《集传》所谓“淫奔有所畏”两说都难通，指出“穀則異室”“死則同穴”若作刺今或淫奔语都难以解释。其转从姚际恒“周人從軍，訊其室家”之说，认为周衰世乱、征伐无宁，征夫恐终身不得团聚，故念及室家而发此决绝之辞。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"term","layerLabel":"字词注","targetText":"大車檻檻毳衣如菼豈不爾思畏子不敢大車啍啍毳衣如璊穀則異室死則同穴有如皦日","targetNotes":"集释撮要。","sourceLabel":null,"sourceNotes":"对应 EPUB item 90 集释段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"集释","text":"方玉润集释依次训“大車”为牛车，“毳衣”为毛布衣，“菼”为初生芦苇；又说明“爾”指室家、“子”指主之者，“啍啍”为车行重迟之貌，“璊”为赤玉色，“穀”为生、“穴”为圹、“皦”为白。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"標韻","targetNotes":"三章韵脚撮述。","sourceLabel":null,"sourceNotes":"对应 EPUB item 90 标韵段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":"标韵","text":"方玉润标出《大車》三章用韵：首章“檻、菼、敢”通韵，次章“啍、璊、奔”本韵，末章“室、穴、日”通韵。其标韵与诗意相应，前两章由车声衣色写离情，末章转到“死則同穴”“有如皦日”，誓辞尤见决绝。","notes":null}]}]}}}
