{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/082-nv-yue-ji-ming/chenhuan-chuanshu","dataHref":"/__data/shijing/annotation/082-nv-yue-ji-ming/chenhuan-chuanshu/data.json","title":"詩毛氏傳疏 · 女曰鷄鳴 · 注释总览","description":"風 · 鄭風 · 女曰鷄鳴 · 汇集《詩毛氏傳疏》关于《女曰鷄鳴》的 1 条注释，含 1 条注脚。"},"payload":{"detail":{"route":{"poemId":"082-nv-yue-ji-ming","materialId":"chenhuan-chuanshu"},"href":"/shijing/annotation/082-nv-yue-ji-ming/chenhuan-chuanshu","poem":{"id":"082-nv-yue-ji-ming","title":"女曰鷄鳴","categoryId":"feng","subcategoryId":"zhengfeng","path":["風","鄭風","女曰鷄鳴"],"segments":[{"id":"seg-001","text":"女曰鷄鳴","isActive":true},{"id":"seg-002","text":"士曰昧旦","isActive":true},{"id":"seg-003","text":"子興視夜","isActive":true},{"id":"seg-004","text":"明星有爛","isActive":true},{"id":"seg-005","text":"將翺將翔","isActive":true},{"id":"seg-006","text":"弋鳧與鴈","isActive":true},{"id":"seg-007","text":"弋言加之","isActive":true},{"id":"seg-008","text":"與子宜之","isActive":true},{"id":"seg-009","text":"宜言飲酒","isActive":true},{"id":"seg-010","text":"與子偕老","isActive":true},{"id":"seg-011","text":"琴瑟在御","isActive":true},{"id":"seg-012","text":"莫不靜好","isActive":true},{"id":"seg-013","text":"知子之來之","isActive":true},{"id":"seg-014","text":"雜佩以贈之","isActive":true},{"id":"seg-015","text":"知子之順之","isActive":true},{"id":"seg-016","text":"雜佩以問之","isActive":true},{"id":"seg-017","text":"知子之好之","isActive":true},{"id":"seg-018","text":"雜佩以報之","isActive":true}]},"material":{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","authors":["陳奐"],"contributorLine":"清 · 陳奐","era":"清","publicationYear":1847,"carrier":"PDF"},"stats":{"annotationCount":1,"glossCount":1},"annotations":[{"id":"0001","order":1,"total":1,"layer":"span","layerLabel":"诗句片段","targetText":"女曰鷄鳴，士曰昧旦。子興視夜，明星有爛。將翺將翔，弋鳧與鴈。弋言加之，與子宜之。宜言飲酒，與子偕老。琴瑟在御，莫不靜好。知子之來之，雜佩以贈之。知子之順之，雜佩以問之。知子之好之，雜佩以報之。","targetNotes":"全篇疏解。","sourceLabel":"第 93-94 页","sourceNotes":"据 /private/tmp/chen-juan8-193.png 及 /private/tmp/chen-juan8-194.png 定位。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"陳奂","sectionLabel":"疏","text":"陳奂疏《女曰鷄鳴》，申《序》所謂不說其德而見其德，謂首章雞鳴視夜是婦人勉夫勤起，次章酒食琴瑟見宜家靜好，三章雜佩贈問報則見夫婦德音相感。","notes":null}]}]}}}
