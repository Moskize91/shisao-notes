{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/082-nv-yue-ji-ming/quwanli-quanshi","dataHref":"/__data/shijing/annotation/082-nv-yue-ji-ming/quwanli-quanshi/data.json","title":"詩經詮釋 · 女曰鷄鳴 · 注释总览","description":"風 · 鄭風 · 女曰鷄鳴 · 汇集《詩經詮釋》关于《女曰鷄鳴》的 1 条注释，含 1 条注脚。"},"payload":{"detail":{"route":{"poemId":"082-nv-yue-ji-ming","materialId":"quwanli-quanshi"},"href":"/shijing/annotation/082-nv-yue-ji-ming/quwanli-quanshi","poem":{"id":"082-nv-yue-ji-ming","title":"女曰鷄鳴","categoryId":"feng","subcategoryId":"zhengfeng","path":["風","鄭風","女曰鷄鳴"],"segments":[{"id":"seg-001","text":"女曰雞鳴","isActive":true},{"id":"seg-002","text":"士曰昧旦","isActive":true},{"id":"seg-003","text":"子興視夜","isActive":true},{"id":"seg-004","text":"明星有爛","isActive":true},{"id":"seg-005","text":"將翱將翔","isActive":true},{"id":"seg-006","text":"弋鳧與鴈","isActive":true},{"id":"seg-007","text":"弋言加之","isActive":true},{"id":"seg-008","text":"與子宜之","isActive":true},{"id":"seg-009","text":"宜言飲酒","isActive":true},{"id":"seg-010","text":"與子偕老","isActive":true},{"id":"seg-011","text":"琴瑟在御","isActive":true},{"id":"seg-012","text":"莫不靜好","isActive":true},{"id":"seg-013","text":"知子之來之","isActive":true},{"id":"seg-014","text":"雜佩以贈之","isActive":true},{"id":"seg-015","text":"知子之順之","isActive":true},{"id":"seg-016","text":"雜佩以問之","isActive":true},{"id":"seg-017","text":"知子之好之","isActive":true},{"id":"seg-018","text":"雜佩以報之","isActive":true}]},"material":{"id":"quwanli-quanshi","title":"詩經詮釋","authors":["屈萬里"],"contributorLine":"现代 · 屈萬里","era":"现代","publicationYear":1983,"carrier":"PDF"},"stats":{"annotationCount":1,"glossCount":1},"annotations":[{"id":"0001","order":1,"total":1,"layer":"span","layerLabel":"诗句片段","targetText":"女曰雞鳴，士曰昧旦。子興視夜，明星有爛。將翱將翔，弋鳧與鴈。弋言加之，與子宜之。宜言飲酒，與子偕老。琴瑟在御，莫不靜好。知子之來之，雜佩以贈之。知子之順之，雜佩以問之。知子之好之，雜佩以報之。","targetNotes":"全篇注释。","sourceLabel":"第 99-100 页","sourceNotes":"据 /private/tmp/qu81-p138.png 及 /private/tmp/qu81-p139.png 定位。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"屈万里","sectionLabel":"注释","text":"屈万里以《女曰雞鳴》为男女相悦而能相勉之诗，释昧旦为天未大明，弋鳧與鴈为射禽，宜为肴，静好为和悦，来、顺、好皆为女子称美其夫而赠答杂佩。","notes":null}]}]}}}
