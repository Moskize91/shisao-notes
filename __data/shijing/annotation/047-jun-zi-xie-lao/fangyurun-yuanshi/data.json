{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/047-jun-zi-xie-lao/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/047-jun-zi-xie-lao/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 君子偕老 · 注释总览","description":"風 · 鄘風 · 君子偕老 · 汇集《诗经原始(上下)》关于《君子偕老》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"047-jun-zi-xie-lao","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/047-jun-zi-xie-lao/fangyurun-yuanshi","poem":{"id":"047-jun-zi-xie-lao","title":"君子偕老","categoryId":"feng","subcategoryId":"yongfeng","path":["風","鄘風","君子偕老"],"segments":[{"id":"seg-001","text":"君子偕老","isActive":false},{"id":"seg-002","text":"副笄六珈","isActive":false},{"id":"seg-003","text":"委委佗佗","isActive":false},{"id":"seg-004","text":"如山如河","isActive":false},{"id":"seg-005","text":"象服是宜","isActive":false},{"id":"seg-006","text":"子之不淑","isActive":false},{"id":"seg-007","text":"云如之何","isActive":false},{"id":"seg-008","text":"玼兮玼兮","isActive":false},{"id":"seg-009","text":"其之翟也","isActive":false},{"id":"seg-010","text":"鬒髮如雲","isActive":false},{"id":"seg-011","text":"不屑髢也","isActive":false},{"id":"seg-012","text":"玉之瑱也","isActive":false},{"id":"seg-013","text":"象之揥也","isActive":false},{"id":"seg-014","text":"揚且之晳也","isActive":false},{"id":"seg-015","text":"胡然而天也","isActive":false},{"id":"seg-016","text":"胡然而帝也","isActive":false},{"id":"seg-017","text":"瑳兮瑳兮","isActive":false},{"id":"seg-018","text":"其之展也","isActive":false},{"id":"seg-019","text":"蒙彼縐絺","isActive":false},{"id":"seg-020","text":"是紲袢也","isActive":false},{"id":"seg-021","text":"子之清揚","isActive":false},{"id":"seg-022","text":"揚且之顔也","isActive":false},{"id":"seg-023","text":"展如之人兮","isActive":false},{"id":"seg-024","text":"邦之媛也","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"君子偕老㊟刺衛夫人宣姜也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标题段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注","text":"方玉润题注以“刺衛夫人宣姜”定篇，直指本诗所刺为卫宣姜。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"总评","targetNotes":"通篇总评。","sourceLabel":null,"sourceNotes":"对应 EPUB item 总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"总评","text":"方玉润总评谓《君子偕老》“刺宣姜无疑”，篇眼在首句“君子偕老”。其析宣姜先为伋子妻、继为宣公妾、终与公子顽相配，已失与君子同德偕老之义，故虽服饰极盛而“不淑”愈显。二章写严妆祭服，有“天人帝女”之观；三章写靓妆见宾客，则由母仪转为媚态。方氏据此谓诗于服饰盛衰间寓褒贬，并有《春秋》笔法。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"眉评","targetNotes":"篇中眉评撮要。","sourceLabel":null,"sourceNotes":"对应 EPUB item 眉评内容。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"眉评","text":"方玉润眉评谓首章先就“象服”立论，收束于“不淑”以起后二章；次章写其严妆，俨若天神帝女下降；末章写其淡妆，则仅为国色娇姿。两面对观，褒贬自见。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"term","layerLabel":"字词注","targetText":"副笄六珈委委佗佗如山如河象服是宜子之不淑玼兮玼兮其之翟也鬒髮如雲不屑髢也玉之瑱也象之揥也揚且之晳也胡然而天也胡然而帝也瑳兮瑳兮其之展也蒙彼縐絺是紲袢也子之清揚揚且之顔也","targetNotes":"集释撮要。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":"集释","text":"方玉润集释连缀名物训诂：释“副”“笄”“珈”“委委佗佗”“如山如河”“象服”“淑”；又释“玼”“翟”“鬒”“不屑”“髢”“瑱”“揥”“揚”“晳”及“胡然而天、胡然而帝”；并释“瑳”“展”“蒙”“縐絺”“紲袢”“清揚”“顔”等词义。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"标韵","targetNotes":"三章韵脚撮述。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标韵段。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"方玉润","sectionLabel":"标韵","text":"方玉润标出《君子偕老》韵脚：首章“珈、佗、河、何”为叶韵；次章“翟、髢、揥、晳、帝”为叶韵；末章“展、袢、顔、媛”为叶韵，并于各字下附反切及韵部说明。","notes":null}]}]}}}
