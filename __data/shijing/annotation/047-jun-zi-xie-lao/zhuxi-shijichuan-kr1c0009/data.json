der":1,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"君子偕老、副筓六珈。委委佗佗、如山如河、象服是宜。子之不淑、云如之何。","targetNotes":"首章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》君子偕老首章。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"朱熹","sectionLabel":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"玼兮玼兮、其之翟也。鬒髮如雲、不屑髢也。玉之瑱也、象之揥也、揚且之皙也。胡然而天也、胡然而帝也。","targetNotes":"次章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》君子偕老次章。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"朱熹","sectionLabel":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"瑳兮瑳兮、其之展也。蒙彼縐絺、是紲袢也。子之淸揚、揚且之顏也。展如之人兮、邦之媛也。","targetNotes":"卒章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》君子偕老卒章。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"朱熹","sectionLabel":null}]},{"id":"0004","order":4,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"君子偕老三章一章七句一章九句一章八句東萊呂氏曰首章之末云子之不淑云如之何責之也二章之末云胡然而天也胡然而帝也問之也三章之末云展如之人兮邦之媛也惜之也辭益婉而意益深矣","targetNotes":"章句总说与东莱吕氏后附语。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》君子偕老章句总说与东莱吕氏后附语。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"朱熹","sectionLabel":null}]}]}}}
