":[{"id":"0001","order":1,"total":4,"layer":"preface","layerLabel":"篇序","targetText":"君子偕老刺衛夫人也夫人淫亂失事君子之道故陳人君之德服飾之盛宜與君子偕老也","targetNotes":"篇首小序。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷三》君子偕老序文。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序"}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"君子偕老副笄六珈委委佗佗如山如河象服是宜子之不淑雲如之何","targetNotes":"首章。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷三》君子偕老首章。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"毛传","sectionLabel":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"玼兮玼兮其之翟也鬒髮如雲不屑髢也玉之瑱也象之揥也揚且之晳也胡然而天也胡然而帝也","targetNotes":"次章。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷三》君子偕老次章。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"毛传","sectionLabel":null}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"瑳兮瑳兮其之展也蒙彼縐絺是紲袢也子之清揚揚且之顏也展如之人兮邦之媛也","targetNotes":"卒章。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷三》君子偕老卒章。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"毛传","sectionLabel":null}]}]}}}
