ionCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"题解","targetNotes":"题解总说。","sourceLabel":"第 98 页","sourceNotes":"书内页 98《题解》段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解"}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"君子偕老，副笄六珈。委委佗佗，如山如河。象服是宜。子之不淑，云如之何！","targetNotes":"第一章。","sourceLabel":"第 99-100 页","sourceNotes":"书内页 99-100 第一章注析。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解"}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"玼兮玼兮，其之翟也。鬒发如云，不屑髢也。玉之瑱也，象之揥也。扬且之皙也。胡然而天也？胡然而帝也？","targetNotes":"第二章。","sourceLabel":"第 100-101 页","sourceNotes":"书内页 100-101 第二章注析。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解"}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"瑳兮瑳兮，其之展也。蒙彼绉絺，是绁袢也。子之清扬，扬且之颜也。展如之人兮，邦之媛也。","targetNotes":"第三章。","sourceLabel":"第 101 页","sourceNotes":"书内页 101 第三章注析。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解"}]}]}}}
