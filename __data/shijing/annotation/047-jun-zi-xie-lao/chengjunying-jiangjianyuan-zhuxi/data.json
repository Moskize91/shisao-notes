{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/047-jun-zi-xie-lao/chengjunying-jiangjianyuan-zhuxi","dataHref":"/__data/shijing/annotation/047-jun-zi-xie-lao/chengjunying-jiangjianyuan-zhuxi/data.json","title":"詩經注析 · 君子偕老 · 注释总览","description":"風 · 鄘風 · 君子偕老 · 汇集《詩經注析》关于《君子偕老》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"047-jun-zi-xie-lao","materialId":"chengjunying-jiangjianyuan-zhuxi"},"href":"/shijing/annotation/047-jun-zi-xie-lao/chengjunying-jiangjianyuan-zhuxi","poem":{"id":"047-jun-zi-xie-lao","title":"君子偕老","categoryId":"feng","subcategoryId":"yongfeng","path":["風","鄘風","君子偕老"],"segments":[{"id":"seg-001","text":"君子偕老","isActive":false},{"id":"seg-002","text":"副笄六珈","isActive":false},{"id":"seg-003","text":"委委佗佗","isActive":false},{"id":"seg-004","text":"如山如河","isActive":false},{"id":"seg-005","text":"象服是宜","isActive":false},{"id":"seg-006","text":"子之不淑","isActive":false},{"id":"seg-007","text":"云如之何","isActive":false},{"id":"seg-008","text":"玼兮玼兮","isActive":false},{"id":"seg-009","text":"其之翟也","isActive":false},{"id":"seg-010","text":"鬒发如云","isActive":false},{"id":"seg-011","text":"不屑髢也","isActive":false},{"id":"seg-012","text":"玉之瑱也","isActive":false},{"id":"seg-013","text":"象之揥也","isActive":false},{"id":"seg-014","text":"扬且之皙也","isActive":false},{"id":"seg-015","text":"胡然而天也","isActive":false},{"id":"seg-016","text":"胡然而帝也","isActive":false},{"id":"seg-017","text":"瑳兮瑳兮","isActive":false},{"id":"seg-018","text":"其之展也","isActive":false},{"id":"seg-019","text":"蒙彼绉絺","isActive":false},{"id":"seg-020","text":"是绁袢也","isActive":false},{"id":"seg-021","text":"子之清扬","isActive":false},{"id":"seg-022","text":"扬且之颜也","isActive":false},{"id":"seg-023","text":"展如之人兮","isActive":false},{"id":"seg-024","text":"邦之媛也","isActive":false}]},"material":{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","authors":["程俊英","蔣見元"],"contributorLine":"现代 · 程俊英、蔣見元","era":"现代","publicationYear":1991,"carrier":"PDF"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"题解","targetNotes":"题解总说。","sourceLabel":"第 98 页","sourceNotes":"书内页 98《题解》段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"题解指出《君子偕老》与《墙有茨》同刺卫宣姜淫乱失德，但本诗不作直斥，而以反复铺写服饰仪容之盛来形成委婉讽刺。程、蒋引沈德潜、王照圆之说，强调全篇虽多赞辞，实以“子之不淑，云如之何”与“邦之媛也”等句含蓄逼出贬意，体现“用丽辞写丑行”的笔法。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"君子偕老，副笄六珈。委委佗佗，如山如河。象服是宜。子之不淑，云如之何！","targetNotes":"第一章。","sourceLabel":"第 99-100 页","sourceNotes":"书内页 99-100 第一章注析。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","text":"首章“君子偕老”本是夫妻相与终老之辞，程、蒋指出移用于宣姜处境即带讽刺。又释“副笄六珈”为诸侯夫人盛饰，足见其位尊；“委委佗佗，如山如河”写其仪容步态之美，“象服是宜”言其外饰合乎国母身份。末句“子之不淑，云如之何”则突然转为责问，点出德行与盛饰不相副的核心讥刺。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"玼兮玼兮，其之翟也。鬒发如云，不屑髢也。玉之瑱也，象之揥也。扬且之皙也。胡然而天也？胡然而帝也？","targetNotes":"第二章。","sourceLabel":"第 100-101 页","sourceNotes":"书内页 100-101 第二章注析。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","text":"次章先写“玼兮玼兮，其之翟也”，释其翟为祭服翟衣，见衣饰鲜盛；继释“鬒发如云，不屑髢也”言发黑而密，不须假发，并申“玉之瑱也，象之揥也，扬且之皙也”皆写饰物与容色之美。至“胡然而天也？胡然而帝也？”程、蒋认为是设问反讽：若徒有服饰容貌而行为不正，岂真可尊比天仙帝女。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"瑳兮瑳兮，其之展也。蒙彼绉絺，是绁袢也。子之清扬，扬且之颜也。展如之人兮，邦之媛也。","targetNotes":"第三章。","sourceLabel":"第 101 页","sourceNotes":"书内页 101 第三章注析。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","text":"末章释“瑳兮瑳兮，其之展也”为展衣鲜明，展衣即夏日见君宾之礼服；“蒙彼绉絺，是绁袢也”则言细布内衣外罩鲜丽展衣。又释“子之清扬，扬且之颜也”指眉目颜色之美，至“展如之人兮，邦之媛也”写其可称国色。程、蒋指出结句仍含反讽，即德与色不相副之意未尝放松。","notes":null}]}]}}}
