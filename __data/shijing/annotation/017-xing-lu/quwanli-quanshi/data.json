{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/017-xing-lu/quwanli-quanshi","dataHref":"/__data/shijing/annotation/017-xing-lu/quwanli-quanshi/data.json","title":"詩經詮釋 · 行露 · 注释总览","description":"風 · 召南 · 行露 · 汇集《詩經詮釋》关于《行露》的 3 条注释，含 3 条注脚。"},"payload":{"detail":{"route":{"poemId":"017-xing-lu","materialId":"quwanli-quanshi"},"href":"/shijing/annotation/017-xing-lu/quwanli-quanshi","poem":{"id":"017-xing-lu","title":"行露","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","行露"],"segments":[{"id":"seg-001","text":"厭浥行露","isActive":false},{"id":"seg-002","text":"豈不夙夜","isActive":false},{"id":"seg-003","text":"謂行多露","isActive":false},{"id":"seg-004","text":"誰謂雀無角","isActive":false},{"id":"seg-005","text":"何以穿我屋","isActive":false},{"id":"seg-006","text":"誰謂女無家","isActive":false},{"id":"seg-007","text":"何以速我獄","isActive":false},{"id":"seg-008","text":"雖速我獄","isActive":false},{"id":"seg-009","text":"室家不足","isActive":false},{"id":"seg-010","text":"誰謂鼠無牙","isActive":false},{"id":"seg-011","text":"何以穿我墉","isActive":false},{"id":"seg-012","text":"誰謂女無家","isActive":false},{"id":"seg-013","text":"何以速我訟","isActive":false},{"id":"seg-014","text":"雖速我訟","isActive":false},{"id":"seg-015","text":"亦不女從","isActive":false}]},"material":{"id":"quwanli-quanshi","title":"詩經詮釋","authors":["屈萬里"],"contributorLine":"现代 · 屈萬里","era":"现代","publicationYear":1983,"carrier":"PDF"},"stats":{"annotationCount":3,"glossCount":3},"annotations":[{"id":"0001","order":1,"total":3,"layer":"global","layerLabel":"全篇总说","targetText":"《行露》全篇旨意","targetNotes":"全篇总说。","sourceLabel":"第 20 页","sourceNotes":"第 20 页《注释》①。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"屈万里","sectionLabel":"注释","text":"此女子拒婚之詩。","notes":null}]},{"id":"0002","order":2,"total":3,"layer":"term","layerLabel":"字词注","targetText":"厭浥行露謂行多露誰謂雀無角何以穿我屋誰謂女無家","targetNotes":"《注释》②至⑥。","sourceLabel":"第 20 页","sourceNotes":"第 20 页《注释》②至⑥。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"屈万里","sectionLabel":"注释","text":"“厭浥”是湿貌；“行”训道路，“岂不夙夜，谓行多露”是说并非不早行，只是怕道上露多；“角”即鸟喙；“家”难以嫁娶求居室之家为训。屈万里借这些基本字义说明首章是借行露起兴，后二章则转到婚家与诉狱的现实语境。","notes":null}]},{"id":"0003","order":3,"total":3,"layer":"term","layerLabel":"字词注","targetText":"何以速我獄雖速我獄室家不足何以穿我墉何以速我訟亦不女從","targetNotes":"《注释》⑦至⑩。","sourceLabel":"第 21 页","sourceNotes":"第 21 页页首《注释》⑦至⑩。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"屈万里","sectionLabel":"注释","text":"“速”是招致，“訟”是讼也；“室家”谓求室家之礼不备；“墉”即墙。页首续注把二、三章的关键词补足，显示诗中主旨并不在单纯嗟怨，而在指出对方虽以狱讼相迫，却终究欠缺合礼成婚的凭据，所以“亦不女从”。","notes":null}]}]}}}
