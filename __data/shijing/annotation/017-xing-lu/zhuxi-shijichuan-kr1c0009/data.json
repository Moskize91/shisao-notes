{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/017-xing-lu/zhuxi-shijichuan-kr1c0009","dataHref":"/__data/shijing/annotation/017-xing-lu/zhuxi-shijichuan-kr1c0009/data.json","title":"詩集傳 · 行露 · 注释总览","description":"風 · 召南 · 行露 · 汇集《詩集傳》关于《行露》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"017-xing-lu","materialId":"zhuxi-shijichuan-kr1c0009"},"href":"/shijing/annotation/017-xing-lu/zhuxi-shijichuan-kr1c0009","poem":{"id":"017-xing-lu","title":"行露","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","行露"],"segments":[{"id":"seg-001","text":"厭浥行露","isActive":true},{"id":"seg-002","text":"豈不夙夜","isActive":true},{"id":"seg-003","text":"謂行多露","isActive":true},{"id":"seg-004","text":"誰謂雀無角","isActive":false},{"id":"seg-005","text":"何以穿我屋","isActive":false},{"id":"seg-006","text":"誰謂女無家","isActive":false},{"id":"seg-007","text":"何以速我獄","isActive":false},{"id":"seg-008","text":"雖速我獄","isActive":false},{"id":"seg-009","text":"室家不足","isActive":false},{"id":"seg-010","text":"誰謂鼠無牙","isActive":false},{"id":"seg-011","text":"何以穿我墉","isActive":false},{"id":"seg-012","text":"誰謂女無家","isActive":false},{"id":"seg-013","text":"何以速我訟","isActive":false},{"id":"seg-014","text":"雖速我訟","isActive":false},{"id":"seg-015","text":"亦不女從","isActive":false}]},"material":{"id":"zhuxi-shijichuan-kr1c0009","title":"詩集傳","authors":["朱熹"],"contributorLine":"宋 · 朱熹","era":"宋","publicationYear":1186,"carrier":"TXT"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"厭浥行露，豈不夙夜？謂行多露。","targetNotes":"首章。","sourceLabel":null,"sourceNotes":"对应 txt 309-315 行。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"朱熹","sectionLabel":null,"text":"賦也。厭浥，濕意。行，道。夙，早也。南國之人遵召伯之教，服文王之化，有以革其前日淫亂之俗，故女子有能以禮自守而不爲強暴所汚者，自述己志作此詩以絶其人。言道閒之露方濕，我豈不欲早夜而行乎？畏多露之沾濡而不敢爾。蓋以女子早夜獨行或有強暴侵陵之患，故託以行多露而畏其沾濡也。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"誰謂雀無角，何以穿我屋？誰謂女無家，何以速我獄？雖速我獄，室家不足。","targetNotes":"第二章。","sourceLabel":null,"sourceNotes":"对应 txt 315-321 行。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"朱熹","sectionLabel":null,"text":"興也。家，謂以媒聘求爲室家之禮也。速，召致也。貞女之自守如此，然猶或見訟而召致於獄。因自訴而言人皆謂雀有角，故能穿我屋，以興人皆謂汝於我嘗有求爲室家之禮，故能致我於獄；然不知汝雖能致我於獄，而求爲室家之禮初未嘗備，如雀雖能穿屋而實未嘗有角也。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"誰謂鼠無牙，何以穿我墉？誰謂女無家，何以速我訟？雖速我訟，亦不女從。","targetNotes":"第三章。","sourceLabel":null,"sourceNotes":"对应 txt 322-325 行。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"朱熹","sectionLabel":null,"text":"興也。牙，牡齒也。墉，墻也。言汝雖能致我於訟，然其求爲室家之禮有所不足，則我亦終不汝從矣。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"行露三章一章三句二章章六句","targetNotes":"章句总说。","sourceLabel":null,"sourceNotes":"对应 txt 326-327 行。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"朱熹","sectionLabel":null,"text":"章法先以行露起興，後二章轉入雀鼠穿屋穿墉之喻，重申其人求婚之禮不備，雖致之於獄訟而終不肯從。","notes":null}]}]}}}
