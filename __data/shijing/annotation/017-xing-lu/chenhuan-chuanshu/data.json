{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/017-xing-lu/chenhuan-chuanshu","dataHref":"/__data/shijing/annotation/017-xing-lu/chenhuan-chuanshu/data.json","title":"詩毛氏傳疏 · 行露 · 注释总览","description":"風 · 召南 · 行露 · 汇集《詩毛氏傳疏》关于《行露》的 3 条注释，含 3 条注脚。"},"payload":{"detail":{"route":{"poemId":"017-xing-lu","materialId":"chenhuan-chuanshu"},"href":"/shijing/annotation/017-xing-lu/chenhuan-chuanshu","poem":{"id":"017-xing-lu","title":"行露","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","行露"],"segments":[{"id":"seg-001","text":"厭浥行露","isActive":false},{"id":"seg-002","text":"豈不夙夜","isActive":false},{"id":"seg-003","text":"謂行多露","isActive":false},{"id":"seg-004","text":"誰謂雀無角","isActive":false},{"id":"seg-005","text":"何以穿我屋","isActive":false},{"id":"seg-006","text":"誰謂女無家","isActive":false},{"id":"seg-007","text":"何以速我獄","isActive":false},{"id":"seg-008","text":"雖速我獄","isActive":false},{"id":"seg-009","text":"室家不足","isActive":false},{"id":"seg-010","text":"誰謂鼠無牙","isActive":false},{"id":"seg-011","text":"何以穿我墉","isActive":false},{"id":"seg-012","text":"誰謂女無家","isActive":false},{"id":"seg-013","text":"何以速我訟","isActive":false},{"id":"seg-014","text":"雖速我訟","isActive":false},{"id":"seg-015","text":"亦不女從","isActive":false}]},"material":{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","authors":["陳奐"],"contributorLine":"清 · 陳奐","era":"清","publicationYear":1847,"carrier":"PDF"},"stats":{"annotationCount":3,"glossCount":3},"annotations":[{"id":"0001","order":1,"total":3,"layer":"preface","layerLabel":"篇序","targetText":"行露，召伯聽訟也。","targetNotes":"篇首序文。","sourceLabel":"第 45 页","sourceNotes":"据第 45 页右侧《行露》篇首序义。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"疏承《序》以《行露》为召伯听断男女室家之讼之诗，强调文王之化已久，虽强暴之俗未尽，而贞信之教已足使女子守礼不从，故其事终于成讼而见断于召伯。","notes":null}]},{"id":"0002","order":2,"total":3,"layer":"span","layerLabel":"诗句片段","targetText":"厭浥行露，豈不夙夜？謂行多露。誰謂雀無角，何以穿我屋？誰謂女無家，何以速我獄？雖速我獄，室家不足。誰謂鼠無牙，何以穿我墉？誰謂女無家，何以速我訟？雖速我訟，亦不女從。","targetNotes":"通篇与疏义。","sourceLabel":"第 45-46 页","sourceNotes":"据第 45 页至第 46 页《行露》疏义提要。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"疏通解三章，认为首章以“行露”起兴，不过是假露以拒男，真正所惧者是违礼污身；后二章则连用雀无角、鼠无牙反诘，申明男子虽以狱讼相迫，其求为室家之礼其实并不足备，故贞女终不肯从。陈奂尤重经文所见乃实讼之辞，而非徒察民风俗之虚设。","notes":null}]},{"id":"0003","order":3,"total":3,"layer":"global","layerLabel":"全篇总说","targetText":"行露三章一章三句二章章六句","targetNotes":"章句总说。","sourceLabel":"第 46 页","sourceNotes":"据第 46 页左侧章句总说。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"疏以“一章三句，二章章六句”总束全篇，认为首章先标起兴之端，后二章乃陈男女对讼之实辞；章法由婉而峻，由避嫌而至明拒，正见贞女守礼不可夺。","notes":null}]}]}}}
