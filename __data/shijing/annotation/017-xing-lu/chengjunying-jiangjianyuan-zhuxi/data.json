{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/017-xing-lu/chengjunying-jiangjianyuan-zhuxi","dataHref":"/__data/shijing/annotation/017-xing-lu/chengjunying-jiangjianyuan-zhuxi/data.json","title":"詩經注析 · 行露 · 注释总览","description":"風 · 召南 · 行露 · 汇集《詩經注析》关于《行露》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"017-xing-lu","materialId":"chengjunying-jiangjianyuan-zhuxi"},"href":"/shijing/annotation/017-xing-lu/chengjunying-jiangjianyuan-zhuxi","poem":{"id":"017-xing-lu","title":"行露","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","行露"],"segments":[{"id":"seg-001","text":"厌浥行露","isActive":false},{"id":"seg-002","text":"岂不夙夜","isActive":false},{"id":"seg-003","text":"谓行多露","isActive":false},{"id":"seg-004","text":"谁谓雀无角","isActive":false},{"id":"seg-005","text":"何以穿我屋","isActive":false},{"id":"seg-006","text":"谁谓女无家","isActive":false},{"id":"seg-007","text":"何以速我狱","isActive":false},{"id":"seg-008","text":"虽速我狱","isActive":false},{"id":"seg-009","text":"室家不足","isActive":false},{"id":"seg-010","text":"谁谓鼠无牙","isActive":false},{"id":"seg-011","text":"何以穿我墉","isActive":false},{"id":"seg-012","text":"谁谓女无家","isActive":false},{"id":"seg-013","text":"何以速我讼","isActive":false},{"id":"seg-014","text":"虽速我讼","isActive":false},{"id":"seg-015","text":"亦不女从","isActive":false}]},"material":{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","authors":["程俊英","蔣見元"],"contributorLine":"现代 · 程俊英、蔣見元","era":"现代","publicationYear":1991,"carrier":"PDF"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"题解","targetNotes":"题解总说。","sourceLabel":"第 31 页","sourceNotes":"书内页 31《行露》题解。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"题解将此篇解释为女子拒婚之诗，认为诗中以一连串反诘语逼视对方，比起直斥其恶，更显出对方行径之不可容忍与自我守贞的无法退让。编者同时指出，全诗借“行露”起兴、继以雀鼠反问，正是用比兴与反语相配，表达一种决绝不二的感情。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"厌浥行露，岂不夙夜？谓行多露。","targetNotes":"首章。","sourceLabel":"第 32 页","sourceNotes":"书内页 32 首章与注释。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"首章释“厌浥”为露水潮湿貌，“夙夜”指早夜天未明时，“谓”通“畏”。整章用“行露”起兴，假托畏露沾衣，实际所畏是女子早行独处时可能遭遇的强暴与污辱，因此一开篇便把拒绝非礼逼迫的心理说得极婉而极深。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"谁谓雀无角？何以穿我屋？谁谓女无家？何以速我狱？虽速我狱，室家不足！","targetNotes":"第二章。","sourceLabel":"第 32 页","sourceNotes":"书内页 32 第二章与注释。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"第二章释“角”为鸟喙，“女”与“汝”古通，“家”是娶妻成家的礼意，“速”为召致，“狱”为诉讼之所，“室家不足”则是说求婚之礼不备。编者指出，本章借雀本无角却能穿屋的反诘，比拟对方虽以狱讼相逼，实则并无完备婚礼可据，因此她即使被迫受审，也决不承认这桩婚事成立。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"谁谓鼠无牙？何以穿我墉？谁谓女无家？何以速我讼？虽速我讼，亦不女从。","targetNotes":"第三章。","sourceLabel":"第 33 页","sourceNotes":"书内页 33 第三章与注释。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"第三章释“牙”为牡齿，“墉”为墙，“讼”为争讼，“从”即顺从。与第二章相比，本章把受逼后的态度说得更决绝，强调即使被拖入诉讼，也绝不屈从。鼠穿墙、雀穿屋的反复比喻，使全诗拒婚守礼的意志层层加强，直到收尾处形成斩断情面的硬语。","notes":null}]}]}}}
