{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/044-er-zi-cheng-zhou/quwanli-quanshi","dataHref":"/__data/shijing/annotation/044-er-zi-cheng-zhou/quwanli-quanshi/data.json","title":"詩經詮釋 · 二子乘舟 · 注释总览","description":"風 · 邶風 · 二子乘舟 · 汇集《詩經詮釋》关于《二子乘舟》的 2 条注释，含 2 条注脚。"},"payload":{"detail":{"route":{"poemId":"044-er-zi-cheng-zhou","materialId":"quwanli-quanshi"},"href":"/shijing/annotation/044-er-zi-cheng-zhou/quwanli-quanshi","poem":{"id":"044-er-zi-cheng-zhou","title":"二子乘舟","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","二子乘舟"],"segments":[{"id":"seg-001","text":"二子乘舟","isActive":false},{"id":"seg-002","text":"汎汎其景","isActive":false},{"id":"seg-003","text":"願言思子","isActive":false},{"id":"seg-004","text":"中心養養","isActive":false},{"id":"seg-005","text":"二子乘舟","isActive":false},{"id":"seg-006","text":"汎汎其逝","isActive":false},{"id":"seg-007","text":"願言思子","isActive":false},{"id":"seg-008","text":"不瑕有害","isActive":false}]},"material":{"id":"quwanli-quanshi","title":"詩經詮釋","authors":["屈萬里"],"contributorLine":"现代 · 屈萬里","era":"现代","publicationYear":1983,"carrier":"PDF"},"stats":{"annotationCount":2,"glossCount":2},"annotations":[{"id":"0001","order":1,"total":2,"layer":"global","layerLabel":"全篇总说","targetText":"二子乘舟","targetNotes":"诗旨总说。","sourceLabel":"第 53 页","sourceNotes":"书页 53《注释》①。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"屈万里","sectionLabel":"总说","text":"屈万里引《詩序》以伋、壽争相赴死为此篇背景，兼录姚际恒疑《詩序》附会之说，并引郑笺叙伋、壽遇害始末。","notes":null}]},{"id":"0002","order":2,"total":2,"layer":"term","layerLabel":"字词注","targetText":"二子乘舟，汎汎其景。願言思子，中心養養。二子乘舟，汎汎其逝。願言思子，不瑕有害。","targetNotes":"《注释》②至⑧撮要。","sourceLabel":"第 53 页","sourceNotes":"书页 53《注释》②至⑧。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"屈万里","sectionLabel":"注释","text":"屈万里释“二子”为伋与壽，“汎汎”为漂浮貌，“景”读如《魯頌》“憬”并训远行。又释“願”为念，“養養”为憂不知所定之貌。次章释“逝”为往，“不瑕”義詳《泉水》。","notes":null}]}]}}}
