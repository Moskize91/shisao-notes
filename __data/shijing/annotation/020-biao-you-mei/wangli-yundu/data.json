{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/020-biao-you-mei/wangli-yundu","dataHref":"/__data/shijing/annotation/020-biao-you-mei/wangli-yundu/data.json","title":"詩經韻讀 · 摽有梅 · 注释总览","description":"風 · 召南 · 摽有梅 · 汇集《詩經韻讀》关于《摽有梅》的 2 条注释，含 2 条注脚。"},"payload":{"detail":{"route":{"poemId":"020-biao-you-mei","materialId":"wangli-yundu"},"href":"/shijing/annotation/020-biao-you-mei/wangli-yundu","poem":{"id":"020-biao-you-mei","title":"摽有梅","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","摽有梅"],"segments":[{"id":"seg-001","text":"摽有梅","isActive":false},{"id":"seg-002","text":"其实七兮","isActive":false},{"id":"seg-003","text":"求我庶士","isActive":false},{"id":"seg-004","text":"迨其吉兮","isActive":false},{"id":"seg-005","text":"摽有梅","isActive":false},{"id":"seg-006","text":"其实三兮","isActive":false},{"id":"seg-007","text":"求我庶士","isActive":false},{"id":"seg-008","text":"迨其今兮","isActive":false},{"id":"seg-009","text":"摽有梅","isActive":false},{"id":"seg-010","text":"顷筐墍之","isActive":false},{"id":"seg-011","text":"求我庶士","isActive":false},{"id":"seg-012","text":"迨其谓之","isActive":false}]},"material":{"id":"wangli-yundu","title":"詩經韻讀","authors":["王力"],"contributorLine":"现代 · 王力","era":"现代","publicationYear":1980,"carrier":"PDF"},"stats":{"annotationCount":2,"glossCount":2},"annotations":[{"id":"0001","order":1,"total":2,"layer":"global","layerLabel":"全篇总说","targetText":"《摽有梅》韵读总说","targetNotes":"书页 147 的诗号 20 全段。","sourceLabel":"第 147 页局部","sourceNotes":"书页 147 下半覆盖《摽有梅》全篇，页底已转《小星》。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"王力","sectionLabel":"韵读","text":"王力将《摽有梅》读作三章三换韵：首章“七(tsiet)、吉(kiet)”归质部，次章“三(səm)、今(kiəm)”归侵覃通协，末章“墍(xiɑt)、谓(hiuɑt)”归物部。三章都以同样章法而逐章换部，音节紧促，与诗意的层层催迫正相配合。","notes":null}]},{"id":"0002","order":2,"total":2,"layer":"span","layerLabel":"诗句片段","targetText":"摽有梅，其实七兮。求我庶士，迨其吉兮。摽有梅，其实三兮。求我庶士，迨其今兮。摽有梅，顷筐墍之。求我庶士，迨其谓之。","targetNotes":"现存页图可见全篇。","sourceLabel":"第 147 页局部","sourceNotes":"书页 147《摽有梅》全篇韵读。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"王力","sectionLabel":"韵读","text":"页图可读首章“七(tsiet)、吉(kiet)”叶质部；第二章“三(səm)、今(kiəm)”转为侵覃通韵；第三章则以“墍(xiɑt)、谓(hiuɑt)”收在物部。每章都只取后二句为主要韵脚，显示《摽有梅》在王力系统中是一篇章章换韵而节奏递紧的作品。","notes":null}]}]}}}
