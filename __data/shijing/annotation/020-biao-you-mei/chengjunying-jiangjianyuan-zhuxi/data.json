{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/020-biao-you-mei/chengjunying-jiangjianyuan-zhuxi","dataHref":"/__data/shijing/annotation/020-biao-you-mei/chengjunying-jiangjianyuan-zhuxi/data.json","title":"詩經注析 · 摽有梅 · 注释总览","description":"風 · 召南 · 摽有梅 · 汇集《詩經注析》关于《摽有梅》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"020-biao-you-mei","materialId":"chengjunying-jiangjianyuan-zhuxi"},"href":"/shijing/annotation/020-biao-you-mei/chengjunying-jiangjianyuan-zhuxi","poem":{"id":"020-biao-you-mei","title":"摽有梅","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","摽有梅"],"segments":[{"id":"seg-001","text":"摽有梅","isActive":false},{"id":"seg-002","text":"其实七兮","isActive":false},{"id":"seg-003","text":"求我庶士","isActive":false},{"id":"seg-004","text":"迨其吉兮","isActive":false},{"id":"seg-005","text":"摽有梅","isActive":false},{"id":"seg-006","text":"其实三兮","isActive":false},{"id":"seg-007","text":"求我庶士","isActive":false},{"id":"seg-008","text":"迨其今兮","isActive":false},{"id":"seg-009","text":"摽有梅","isActive":false},{"id":"seg-010","text":"顷筐塈之","isActive":false},{"id":"seg-011","text":"求我庶士","isActive":false},{"id":"seg-012","text":"迨其谓之","isActive":false}]},"material":{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","authors":["程俊英","蔣見元"],"contributorLine":"现代 · 程俊英、蔣見元","era":"现代","publicationYear":1991,"carrier":"PDF"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"题解","targetNotes":"题解总说。","sourceLabel":"第 36-37 页","sourceNotes":"书内页 36 题解起，续至 37 页上半。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"题解把此篇定为待嫁女子伤春而自择良偶之诗。作者认为梅子落地最易引起青春将逝的感伤，三章又由“迨其吉”递到“迨其今”再到“迨其谓之”，把女子从尚可从容等待写到急欲成婚的心理层次，故与《桃夭》同属婚嫁题材而情绪更为迫切。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"摽有梅，其实七兮。求我庶士，迨其吉兮。","targetNotes":"首章。","sourceLabel":"第 37 页","sourceNotes":"书内页 37 首章与注释。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"首章释“摽”为梅落，又引训诂说明“庶士”是众士、即众求婚者，“迨”为及。编者据此认为梅树尚有七成实，象征女子虽已到婚龄却仍可从容择配，所以“迨其吉兮”还带有等待吉日、未甚迫切之意。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"摽有梅，其实三兮。求我庶士，迨其今兮。","targetNotes":"第二章。","sourceLabel":"第 37 页","sourceNotes":"书内页 37 第二章与注释。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"第二章说树上梅子只剩三成，借以提示女子年龄渐长、婚期更迫。“今”释为今日，不再等待吉期，因此“迨其今兮”比首章更显急切，正合题解所谓一层紧过一层的写法。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"摽有梅，顷筐塈之。求我庶士，迨其谓之。","targetNotes":"第三章。","sourceLabel":"第 37 页","sourceNotes":"书内页 37 第三章与注释。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"末章释“顷筐”为浅筐，“塈”为取，“谓”则通“会”，指通过媒妁相约。诗意写到梅子尽收筐中，已无再待之余地，于是女子索性要求众士立刻约婚，显示全诗情绪至此达到最高点。","notes":null}]}]}}}
