{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/041-bei-feng/chengjunying-jiangjianyuan-zhuxi","dataHref":"/__data/shijing/annotation/041-bei-feng/chengjunying-jiangjianyuan-zhuxi/data.json","title":"詩經注析 · 北風 · 注释总览","description":"風 · 邶風 · 北風 · 汇集《詩經注析》关于《北風》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"041-bei-feng","materialId":"chengjunying-jiangjianyuan-zhuxi"},"href":"/shijing/annotation/041-bei-feng/chengjunying-jiangjianyuan-zhuxi","poem":{"id":"041-bei-feng","title":"北風","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","北風"],"segments":[{"id":"seg-001","text":"北风其凉","isActive":false},{"id":"seg-002","text":"雨雪其雱","isActive":false},{"id":"seg-003","text":"惠而好我","isActive":false},{"id":"seg-004","text":"携手同行","isActive":false},{"id":"seg-005","text":"其虚其邪","isActive":false},{"id":"seg-006","text":"既亟只且","isActive":false},{"id":"seg-007","text":"北风其喈","isActive":false},{"id":"seg-008","text":"雨雪其霏","isActive":false},{"id":"seg-009","text":"惠而好我","isActive":false},{"id":"seg-010","text":"携手同归","isActive":false},{"id":"seg-011","text":"其虚其邪","isActive":false},{"id":"seg-012","text":"既亟只且","isActive":false},{"id":"seg-013","text":"莫赤匪狐","isActive":false},{"id":"seg-014","text":"莫黑匪乌","isActive":false},{"id":"seg-015","text":"惠而好我","isActive":false},{"id":"seg-016","text":"携手同车","isActive":false},{"id":"seg-017","text":"其虚其邪","isActive":false},{"id":"seg-018","text":"既亟只且","isActive":false}]},"material":{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","authors":["程俊英","蔣見元"],"contributorLine":"现代 · 程俊英、蔣見元","era":"现代","publicationYear":1991,"carrier":"PDF"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"题解","targetNotes":"题解总说。","sourceLabel":"第 87 页","sourceNotes":"书内页 87《题解》段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"题解将《北风》解释为人民不堪虐政、相呼逃亡的诗，认为《毛序》“刺虐”大体切合诗意；并强调全诗最突出的艺术效果是通过风雪意象与重章叠句造成紧张恐惧气氛，层层推进到“莫赤匪狐，莫黑匪乌”的不祥象征，从而强化对黑暗统治的感受。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"北风其凉，雨雪其雱。惠而好我，携手同行。其虚其邪？既亟只且！","targetNotes":"第一章。","sourceLabel":"第 87-88 页","sourceNotes":"书内页 87 首章注析，续至 88 页上半。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","text":"首章以“北风其凉，雨雪其雱”先写风雪盛急的环境，并释“雱”为雪盛貌。程、蒋又解“惠而好我，携手同行”之“行”为道路，谓与相好者同道而去；“其虚其邪？既亟只且！”则以“虚”释舒缓、“邪”通“徐”、“亟”为紧急，点出祸乱逼迫、不可不速去。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"北风其喈，雨雪其霏。惠而好我，携手同归。其虚其邪？既亟只且！","targetNotes":"第二章。","sourceLabel":"第 88 页","sourceNotes":"书内页 88 第二章注析。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","text":"第二章在首章基础上递进，释“喈”为寒凉急疾之声，“霏”为雪花纷飞分散之状；“携手同归”则由“同行”进一步写到共同离去并不再返回。反复出现“其虚其邪？既亟只且！”继续强调局势紧迫，不能迟疑。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"莫赤匪狐，莫黑匪乌。惠而好我，携手同车。其虚其邪？既亟只且！","targetNotes":"第三章。","sourceLabel":"第 88 页","sourceNotes":"书内页 88 第三章注析。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","text":"末章“莫赤匪狐，莫黑匪乌”以狐乌不祥意象指向黑暗时局；程、蒋并引朱熹“同车则贵者亦去”之说，指出由“同行”到“同归”再到“同车”，显示逃离者范围由一般人扩大到贵者。章末“其虚其邪？既亟只且！”复叠旧语，收束全诗紧迫情绪。","notes":null}]}]}}}
