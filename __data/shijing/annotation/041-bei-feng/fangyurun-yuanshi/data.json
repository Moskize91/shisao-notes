{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/041-bei-feng/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/041-bei-feng/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 北風 · 注释总览","description":"風 · 邶風 · 北風 · 汇集《诗经原始(上下)》关于《北風》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"041-bei-feng","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/041-bei-feng/fangyurun-yuanshi","poem":{"id":"041-bei-feng","title":"北風","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","北風"],"segments":[{"id":"seg-001","text":"北風其涼","isActive":false},{"id":"seg-002","text":"雨雪其雱","isActive":false},{"id":"seg-003","text":"惠而好我","isActive":false},{"id":"seg-004","text":"攜手同行","isActive":false},{"id":"seg-005","text":"其虚其邪","isActive":false},{"id":"seg-006","text":"既亟只且","isActive":false},{"id":"seg-007","text":"北風其喈","isActive":false},{"id":"seg-008","text":"雨雪其霏","isActive":false},{"id":"seg-009","text":"惠而好我","isActive":false},{"id":"seg-010","text":"攜手同歸","isActive":false},{"id":"seg-011","text":"其虚其邪","isActive":false},{"id":"seg-012","text":"既亟只且","isActive":false},{"id":"seg-013","text":"莫赤匪狐","isActive":false},{"id":"seg-014","text":"莫黑匪烏","isActive":false},{"id":"seg-015","text":"惠而好我","isActive":false},{"id":"seg-016","text":"攜手同車","isActive":false},{"id":"seg-017","text":"其虚其邪","isActive":false},{"id":"seg-018","text":"既亟只且","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"北風㊟賢者見幾而作也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标题段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注"}]},{"id":"0002","order":2,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"右《北風》三章，章六句。姚氏際恒云：「此篇自是賢者見幾之作，不必説及百姓。」是。蓋見幾唯賢者乃早，百姓豈能及也。愚觀詩詞，始則氣象愁慘，繼則怪異頻興，率皆不祥兆，所謂國家將亡，必有妖孽時也。赤狐、黑烏，當時或有其怪，或聞是謡，皆不可知。總之敗亡兆耳。故賢者相率而去其國也。但不知其爲衛作乎？抑爲邶言乎？若以詩編《邶風》内，則當爲邶言爲是，與首篇《柏舟》憂讒憫亂之作相應。蓋彼知其將亂而不忍去，此則見其將亡而必速去。一明哲以保身，一忠貞而受禍。雖曰時位不同，亦各行其志焉已矣。","targetNotes":"通篇总评原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"总评"}]},{"id":"0003","order":3,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"眉評〔一章〕氣象愁慘。〔二章〕妖孽頻興，造語奇闢，似古童謡。","targetNotes":"篇中眉评原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 眉评内容。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"眉评"}]},{"id":"0004","order":4,"total":5,"layer":"term","layerLabel":"字词注","targetText":"集釋雱雪盛貌。惠愛也。虚寬貌。邪〔陸氏德明曰〕《爾雅》作徐。亟急也。只且〔歐陽氏脩曰〕「其虚其邪，既亟只且」者，言無暇寬徐，當亟去也。喈疾聲也。狐獸名。〔陸氏佃曰〕舊説以狐有媚珠，善變化，其爲物妖淫，故詩以刺惡。烏〔陸氏佃曰〕烏，一名鴉，其名自呼，體全黑。","targetNotes":"集释原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":"集释"}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"標韻涼七陽。雱、行並同。本韻。邪音徐，六魚。且同。本韻。喈九佳。霏五微。歸同。通韻。狐七虞。烏同。車六魚。通韻。","targetNotes":"标韵原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标韵段。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"方玉润","sectionLabel":"标韵"}]}]}}}
