{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/041-bei-feng/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/041-bei-feng/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 北風 · 注释总览","description":"風 · 邶風 · 北風 · 汇集《诗经原始(上下)》关于《北風》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"041-bei-feng","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/041-bei-feng/fangyurun-yuanshi","poem":{"id":"041-bei-feng","title":"北風","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","北風"],"segments":[{"id":"seg-001","text":"北風其涼","isActive":false},{"id":"seg-002","text":"雨雪其雱","isActive":false},{"id":"seg-003","text":"惠而好我","isActive":false},{"id":"seg-004","text":"攜手同行","isActive":false},{"id":"seg-005","text":"其虚其邪","isActive":false},{"id":"seg-006","text":"既亟只且","isActive":false},{"id":"seg-007","text":"北風其喈","isActive":false},{"id":"seg-008","text":"雨雪其霏","isActive":false},{"id":"seg-009","text":"惠而好我","isActive":false},{"id":"seg-010","text":"攜手同歸","isActive":false},{"id":"seg-011","text":"其虚其邪","isActive":false},{"id":"seg-012","text":"既亟只且","isActive":false},{"id":"seg-013","text":"莫赤匪狐","isActive":false},{"id":"seg-014","text":"莫黑匪烏","isActive":false},{"id":"seg-015","text":"惠而好我","isActive":false},{"id":"seg-016","text":"攜手同車","isActive":false},{"id":"seg-017","text":"其虚其邪","isActive":false},{"id":"seg-018","text":"既亟只且","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"北風㊟賢者見幾而作也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标题段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注","text":"方玉润题注直定《北風》为贤者见几而作，重在先见时变、及早远祸，而不以寻常流民离散之诗读之。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"总评","targetNotes":"通篇总评。","sourceLabel":null,"sourceNotes":"对应 EPUB item 总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"总评","text":"方玉润总评采姚际恒“此篇自是贤者见几之作，不必说及百姓”之说，并强调见几唯贤者乃早。其读法以诗中风雪愁惨与狐乌怪异皆为不祥亡兆，故贤者相率去国。又推《北風》或为邶士所作，并与《柏舟》对照：彼知将乱而不忍去，此见将亡而必速去，一明哲保身，一忠贞受祸，各行其志。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"眉评","targetNotes":"篇中眉评撮要。","sourceLabel":null,"sourceNotes":"对应 EPUB item 眉评内容。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"眉评","text":"方玉润眉评只点两层：首章主在“气象愁惨”；次章见“妖孽频兴”，并称其造语奇辟，近于古童谣。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"term","layerLabel":"字词注","targetText":"雨雪其雱惠而好我其虚其邪既亟只且北風其喈莫赤匪狐莫黑匪烏","targetNotes":"集释撮要。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":"集释","text":"方玉润集释依次解释“雱”“惠”“虚”“邪”“亟”“只且”“喈”“狐”“烏”等词义：以“雱”为雪盛貌，“惠”为爱，“虚”为宽貌，“邪”据《尔雅》作“徐”，“亟”为急，“只且”引欧阳修说为“无暇宽徐，当亟去”之辞，“喈”为疾声；又引陆佃分别说狐性妖淫、烏体全黑，以见其刺恶象意。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"标韵","targetNotes":"三章韵脚撮述。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标韵段。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"方玉润","sectionLabel":"标韵","text":"方玉润标出《北風》韵脚：首章“涼、雱、行”为阳部本韵，另以“邪、且”为鱼部本韵；次章“喈、霏、歸”通韵；末章“狐、烏、車”亦通韵。其标韵显示此篇随章换部，并由“其虚其邪，既亟只且”反复句形成回环。","notes":null}]}]}}}
