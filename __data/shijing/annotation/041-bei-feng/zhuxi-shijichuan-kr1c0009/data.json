{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/041-bei-feng/zhuxi-shijichuan-kr1c0009","dataHref":"/__data/shijing/annotation/041-bei-feng/zhuxi-shijichuan-kr1c0009/data.json","title":"詩集傳 · 北風 · 注释总览","description":"風 · 邶風 · 北風 · 汇集《詩集傳》关于《北風》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"041-bei-feng","materialId":"zhuxi-shijichuan-kr1c0009"},"href":"/shijing/annotation/041-bei-feng/zhuxi-shijichuan-kr1c0009","poem":{"id":"041-bei-feng","title":"北風","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","北風"],"segments":[{"id":"seg-001","text":"北風其凉","isActive":true},{"id":"seg-002","text":"雨雪其雱","isActive":true},{"id":"seg-003","text":"惠而好我","isActive":true},{"id":"seg-004","text":"攜手同行","isActive":true},{"id":"seg-005","text":"其虛其邪","isActive":true},{"id":"seg-006","text":"旣亟只且","isActive":true},{"id":"seg-007","text":"北風其喈","isActive":false},{"id":"seg-008","text":"雨雪其霏","isActive":false},{"id":"seg-009","text":"惠而好我","isActive":false},{"id":"seg-010","text":"攜手同歸","isActive":false},{"id":"seg-011","text":"其虛其邪","isActive":false},{"id":"seg-012","text":"旣亟只且","isActive":false},{"id":"seg-013","text":"莫赤匪狐","isActive":false},{"id":"seg-014","text":"莫黑匪烏","isActive":false},{"id":"seg-015","text":"惠而好我","isActive":false},{"id":"seg-016","text":"攜手同車","isActive":false},{"id":"seg-017","text":"其虛其邪","isActive":false},{"id":"seg-018","text":"旣亟只且","isActive":false}]},"material":{"id":"zhuxi-shijichuan-kr1c0009","title":"詩集傳","authors":["朱熹"],"contributorLine":"宋 · 朱熹","era":"宋","publicationYear":1186,"carrier":"TXT"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"北風其凉，雨雪其雱。惠而好我，攜手同行。其虛其邪，旣亟只且。","targetNotes":"首章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》北風首章。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"朱熹","sectionLabel":null,"text":"比也。朱熹释“北風”为寒凉之风，“凉”为寒气，“雱”为雪盛之貌；又以“惠”为爱、“行”为去、“虛”为宽、“邪”读为“徐”、“亟”为急，“只且”为语助辞。故本章以北风雨雪比国家危乱将至，气象愁惨，故欲与相好之人速去以避祸。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"北風其喈，雨雪其霏。惠而好我，攜手同歸。其虛其邪，旣亟只且。","targetNotes":"次章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》北風次章。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"朱熹","sectionLabel":null,"text":"比也。朱熹谓“喈”为疾声，“霏”为雨雪分散之状；又说“同歸”之“歸”，是去而不返之辞。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"莫赤匪狐，莫黑匪烏。惠而好我，攜手同車。其虛其邪，旣亟只且。","targetNotes":"末章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》北風末章。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"朱熹","sectionLabel":null,"text":"比也。朱熹以“狐”为黄赤之兽、“烏”为黑色之鸟，皆是人所恶见的不祥之物；若所见无非此类，即可知国将危乱。又言“同行”“同歸”尚是贱者之去，“同車”则连贵者亦去矣。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"北風三章章六句","targetNotes":"章句总说。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》北風章句总说。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"朱熹","sectionLabel":null,"text":"朱熹记《北風》三章，章六句。","notes":null}]}]}}}
