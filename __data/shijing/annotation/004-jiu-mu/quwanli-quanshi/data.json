{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/004-jiu-mu/quwanli-quanshi","dataHref":"/__data/shijing/annotation/004-jiu-mu/quwanli-quanshi/data.json","title":"詩經詮釋 · 樛木 · 注释总览","description":"風 · 周南 · 樛木 · 汇集《詩經詮釋》关于《樛木》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"004-jiu-mu","materialId":"quwanli-quanshi"},"href":"/shijing/annotation/004-jiu-mu/quwanli-quanshi","poem":{"id":"004-jiu-mu","title":"樛木","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","樛木"],"segments":[{"id":"seg-001","text":"南有樛木","isActive":false},{"id":"seg-002","text":"葛藟纍之","isActive":false},{"id":"seg-003","text":"樂只君子","isActive":false},{"id":"seg-004","text":"福履綏之","isActive":false},{"id":"seg-005","text":"南有樛木","isActive":false},{"id":"seg-006","text":"葛藟荒之","isActive":false},{"id":"seg-007","text":"樂只君子","isActive":false},{"id":"seg-008","text":"福履將之","isActive":false},{"id":"seg-009","text":"南有樛木","isActive":false},{"id":"seg-010","text":"葛藟縈之","isActive":false},{"id":"seg-011","text":"樂只君子","isActive":false},{"id":"seg-012","text":"福履成之","isActive":false}]},"material":{"id":"quwanli-quanshi","title":"詩經詮釋","authors":["屈萬里"],"contributorLine":"现代 · 屈萬里","era":"现代","publicationYear":1983,"carrier":"PDF"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"《樛木》全篇旨意","targetNotes":"全篇总说。","sourceLabel":"第 47 页局部","sourceNotes":"第 47 页《注释》①。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"屈万里","sectionLabel":"注释","text":"此祝福之詩，所以之君子，蓋亦有官爵者。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"term","layerLabel":"字词注","targetText":"南有樛木，葛藟纍之。樂只君子，福履綏之。","targetNotes":"首章训释。","sourceLabel":"第 47 页局部","sourceNotes":"第 47 页《注释》②至④。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"屈万里","sectionLabel":"注释","text":"“南”指南土、南都、南国之间；樛谓木下曲；葛藟即葛类蔓生植物，亦通作藟；“纍”训缘也，写葛藟攀附樛木之状。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"term","layerLabel":"字词注","targetText":"南有樛木，葛藟荒之。樂只君子，福履將之。","targetNotes":"二章训释。","sourceLabel":"第 47 页局部","sourceNotes":"第 47 页《注释》⑤至⑥。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"屈万里","sectionLabel":"注释","text":"“只”为语助词；“樂只”猶言快乐。“將”即扶助、将肆之将，因而此章所祝福履更进一层。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"term","layerLabel":"字词注","targetText":"南有樛木，葛藟縈之。樂只君子，福履成之。","targetNotes":"三章训释。","sourceLabel":"第 47 页局部","sourceNotes":"第 47 页《注释》⑦。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"屈万里","sectionLabel":"注释","text":"“縈”為縈绕之义，“成”為成就。三章递进到此，所祝愿者由绥、将而终于成。","notes":null}]}]}}}
