{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/004-jiu-mu/maoheng-zhushu-kr1c0004","dataHref":"/__data/shijing/annotation/004-jiu-mu/maoheng-zhushu-kr1c0004/data.json","title":"毛詩注疏 · 樛木 · 注释总览","description":"風 · 周南 · 樛木 · 汇集《毛詩注疏》关于《樛木》的 5 条注释，含 8 条注脚。"},"payload":{"detail":{"route":{"poemId":"004-jiu-mu","materialId":"maoheng-zhushu-kr1c0004"},"href":"/shijing/annotation/004-jiu-mu/maoheng-zhushu-kr1c0004","poem":{"id":"004-jiu-mu","title":"樛木","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","樛木"],"segments":[{"id":"seg-001","text":"南有樛木","isActive":false},{"id":"seg-002","text":"葛藟纍之","isActive":false},{"id":"seg-003","text":"樂只君子","isActive":false},{"id":"seg-004","text":"福履綏之","isActive":false},{"id":"seg-005","text":"南有樛木","isActive":false},{"id":"seg-006","text":"葛藟荒之","isActive":false},{"id":"seg-007","text":"樂只君子","isActive":false},{"id":"seg-008","text":"福履將之","isActive":false},{"id":"seg-009","text":"南有樛木","isActive":false},{"id":"seg-010","text":"葛藟縈之","isActive":false},{"id":"seg-011","text":"樂只君子","isActive":false},{"id":"seg-012","text":"福履成之","isActive":false}]},"material":{"id":"maoheng-zhushu-kr1c0004","title":"毛詩注疏","authors":["毛亨","鄭氏","孔穎達"],"contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","era":"漢唐","publicationYear":653,"carrier":"TXT"},"stats":{"annotationCount":5,"glossCount":8},"annotations":[{"id":"0001","order":1,"total":5,"layer":"preface","layerLabel":"篇序","targetText":"序《樛木》","targetNotes":"篇首小序与郑笺。","sourceLabel":null,"sourceNotes":"对应 txt 849-855 行。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序","text":"序：樛木，后妃逮下也。言能逮下而無嫉妬之心焉。","notes":null},{"key":"0001-2","attributionLabel":"郑笺","sectionLabel":null,"text":"箋云：后妃能和諧衆妾，不嫉妬其容貌，恒以善言逮下而安之。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"南有樛木，葛藟纍之。樂只君子，福履綏之。","targetNotes":"首章。","sourceLabel":null,"sourceNotes":"对应 txt 856-881 行。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：興也。南，南土也。木下曲曰樛。纍，纒繞也。履，祿。綏，安也。","notes":null},{"key":"0002-2","attributionLabel":"郑笺","sectionLabel":null,"text":"箋云：木枝以下垂之故，葛藟得纍而蔓之，興后妃能以恩意下逮衆妾，使得其次序，則衆妾上附事之而禮義俱盛。妃妾又以禮義和合，能以禮樂樂其君子，使為福禄所安。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"南有樛木，葛藟荒之。樂只君子，福履將之。","targetNotes":"第二章。","sourceLabel":null,"sourceNotes":"对应 txt 882-883 行。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：荒，奄。將，大也。","notes":null},{"key":"0003-2","attributionLabel":"郑笺","sectionLabel":null,"text":"箋云：此章申殷勤之意，將猶扶助也。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"南有樛木，葛藟縈之。樂只君子，福履成之。","targetNotes":"第三章。","sourceLabel":null,"sourceNotes":"对应 txt 884-885 行。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：縈，旋也。成，就也。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"樛木三章章四句","targetNotes":"章句总说。","sourceLabel":null,"sourceNotes":"对应 txt 886 行。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"章句","sectionLabel":null,"text":"樛木三章章四句。","notes":null}]}]}}}
