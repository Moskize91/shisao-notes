{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/004-jiu-mu/chenhuan-chuanshu","dataHref":"/__data/shijing/annotation/004-jiu-mu/chenhuan-chuanshu/data.json","title":"詩毛氏傳疏 · 樛木 · 注释总览","description":"風 · 周南 · 樛木 · 汇集《詩毛氏傳疏》关于《樛木》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"004-jiu-mu","materialId":"chenhuan-chuanshu"},"href":"/shijing/annotation/004-jiu-mu/chenhuan-chuanshu","poem":{"id":"004-jiu-mu","title":"樛木","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","樛木"],"segments":[{"id":"seg-001","text":"南有樛木","isActive":false},{"id":"seg-002","text":"葛藟纍之","isActive":false},{"id":"seg-003","text":"樂只君子","isActive":false},{"id":"seg-004","text":"福履綏之","isActive":false},{"id":"seg-005","text":"南有樛木","isActive":false},{"id":"seg-006","text":"葛藟荒之","isActive":false},{"id":"seg-007","text":"樂只君子","isActive":false},{"id":"seg-008","text":"福履將之","isActive":false},{"id":"seg-009","text":"南有樛木","isActive":false},{"id":"seg-010","text":"葛藟縈之","isActive":false},{"id":"seg-011","text":"樂只君子","isActive":false},{"id":"seg-012","text":"福履成之","isActive":false}]},"material":{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","authors":["陳奐"],"contributorLine":"清 · 陳奐","era":"清","publicationYear":1847,"carrier":"PDF"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"《樛木》后妃逮下之义","targetNotes":"篇首总义与陈奂疏义。","sourceLabel":"第 28 页","sourceNotes":"PDF 28 页篇题后总说。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"陈奂承《序》义，以《樛木》为后妃逮下、无嫉妒之心之诗。其说重在后妃能和谐众妾，使众妾皆乐其君子而为之祝福，故诗中不以木尊葛卑为比贱，而以樛木下曲、葛藟附丽之象见德之柔和。","notes":"据 PDF 28 页疏义提要。"}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"南有樛木，葛藟纍之。樂只君子，福履綏之。","targetNotes":"首章与疏义。","sourceLabel":"第 28 页","sourceNotes":"PDF 28 页中段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"陈奂释首章，以樛木为下曲之木，葛藟为延蔓附木之草，纍则状其相缀不绝。所谓“樂只君子，福履綏之”，在陈奂看来正是众妾因后妃能逮下而和悦无争，故同声祝愿君子福履安绥。","notes":"据 PDF 28 页疏义提要。"}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"南有樛木，葛藟荒之。樂只君子，福履將之。","targetNotes":"二章与疏义。","sourceLabel":"第 28-29 页","sourceNotes":"PDF 28 页后段至 29 页前段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"陈奂于二章释“荒”为广覆，“將”为大而扶助。较首章之“綏”，此章所愿更进一步，见众妾不但愿君子福履安和，且愿其福祚增长广大，这也正从侧面写出后妃之德日益孚洽于下。","notes":"据 PDF 28-29 页疏义提要。"}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"南有樛木，葛藟縈之。樂只君子，福履成之。","targetNotes":"三章与疏义。","sourceLabel":"第 29 页","sourceNotes":"PDF 29 页《漢廣》标题前。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"陈奂以末章“縈”为回旋缠绕，“成”为成就，谓三章所陈福履由綏而將，终于成。至此后妃和谐众妾之德既备，众妾对君子之祝愿亦告圆足，全篇遂以逮下和嫔之义归结。","notes":"据 PDF 29 页疏义提要。"}]}]}}}
