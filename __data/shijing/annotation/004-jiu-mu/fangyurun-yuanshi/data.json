{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/004-jiu-mu/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/004-jiu-mu/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 樛木 · 注释总览","description":"風 · 周南 · 樛木 · 汇集《诗经原始(上下)》关于《樛木》的 8 条注释，含 8 条注脚。"},"payload":{"detail":{"route":{"poemId":"004-jiu-mu","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/004-jiu-mu/fangyurun-yuanshi","poem":{"id":"004-jiu-mu","title":"樛木","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","樛木"],"segments":[{"id":"seg-001","text":"南有樛木","isActive":false},{"id":"seg-002","text":"葛藟纍之","isActive":false},{"id":"seg-003","text":"樂只君子","isActive":false},{"id":"seg-004","text":"福履綏之","isActive":false},{"id":"seg-005","text":"南有樛木","isActive":false},{"id":"seg-006","text":"葛藟荒之","isActive":false},{"id":"seg-007","text":"樂只君子","isActive":false},{"id":"seg-008","text":"福履將之","isActive":false},{"id":"seg-009","text":"南有樛木","isActive":false},{"id":"seg-010","text":"葛藟縈之","isActive":false},{"id":"seg-011","text":"樂只君子","isActive":false},{"id":"seg-012","text":"福履成之","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":8,"glossCount":8},"annotations":[{"id":"0001","order":1,"total":8,"layer":"global","layerLabel":"全篇总说","targetText":"题注","targetNotes":"对应 item-0013 题注。","sourceLabel":null,"sourceNotes":"item-0013.txt 第 3 行。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注","text":"题注为“祝所天也”，以“所天”揭示此篇在于称颂夫妇相依之义。","notes":null}]},{"id":"0002","order":2,"total":8,"layer":"span","layerLabel":"诗句片段","targetText":"南有樛木，葛藟纍之。樂只君子，福履綏之。","targetNotes":"第一章。","sourceLabel":null,"sourceNotes":"item-0013.txt 第 5 行。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":null,"text":"首章以樛木与葛藟之比兴起笔，写葛藟纍附樛木，转祝“樂只君子，福履綏之”，先出依附而蒙福之意。","notes":null}]},{"id":"0003","order":3,"total":8,"layer":"span","layerLabel":"诗句片段","targetText":"南有樛木，葛藟荒之。樂只君子，福履將之。","targetNotes":"第二章。","sourceLabel":null,"sourceNotes":"item-0013.txt 第 6 行。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":null,"text":"次章换“荒”字承上，仍以葛藟附木之象反复咏叹，并以“福履將之”申言扶助成福。","notes":null}]},{"id":"0004","order":4,"total":8,"layer":"span","layerLabel":"诗句片段","targetText":"南有樛木，葛藟縈之。樂只君子，福履成之。","targetNotes":"第三章。","sourceLabel":null,"sourceNotes":"item-0013.txt 第 7 行。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":null,"text":"三章再易“縈”“成”二字，写缠绕愈深、福履愈成，以重章复沓收束主旨。","notes":null}]},{"id":"0005","order":5,"total":8,"layer":"global","layerLabel":"全篇总说","targetText":"总评与篇旨辨析","targetNotes":"右《樛木》三章后总评。","sourceLabel":null,"sourceNotes":"item-0013.txt 第 9 行。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"方玉润","sectionLabel":"总评","text":"方氏先述《小序》《大序》《集传》以后妃、衆妾之说，继而指出诗词本身并无“乐德”与“无嫉妒心”之证。其据“纍、荒、縈”等字有缠绵依附意，谓更近夫妇之情；又引伪传“南国诸侯慕文王之化，而归心于周”之说为可通。末归结君臣夫妇义本相通，诗人可借夫妇情喻君臣义，亦可实指文王，不必拘为衆妾所作。","notes":null}]},{"id":"0006","order":6,"total":8,"layer":"global","layerLabel":"全篇总说","targetText":"眉评","targetNotes":"篇后眉评。","sourceLabel":null,"sourceNotes":"item-0013.txt 第 11 行。","notes":null,"glosses":[{"key":"0006-1","attributionLabel":"方玉润","sectionLabel":"眉评","text":"眉评谓三章只易六字，而往复疊咏，慇懃之意自见。","notes":null}]},{"id":"0007","order":7,"total":8,"layer":"term","layerLabel":"字词注","targetText":"南有樛木／葛藟纍之／樂只君子／福履綏之／葛藟荒之／福履將之／葛藟縈之／福履成之","targetNotes":"集释中关键训诂组。","sourceLabel":null,"sourceNotes":"item-0013.txt 第 13 行。","notes":null,"glosses":[{"key":"0007-1","attributionLabel":"集释","sectionLabel":null,"text":"集释依次训“樛木”之“樛”为木下曲，又释藟为葛类并引陆璣“一名巨苽，似燕薁，亦延蔓生”；释“纍”为繫，“只”为语助辞；释“福履”为动罔不吉，并释“綏”为安、“荒”为芘覆、“將”为扶助、“縈”为旋绕之周、“成”为就。","notes":null}]},{"id":"0008","order":8,"total":8,"layer":"global","layerLabel":"全篇总说","targetText":"标韵","targetNotes":"各章韵脚与同韵说明。","sourceLabel":null,"sourceNotes":"item-0013.txt 第 15 行。","notes":null,"glosses":[{"key":"0008-1","attributionLabel":"标韵","sectionLabel":null,"text":"标韵以“纍”为四支韵，“綏”同部本韵；次章“荒”为七阳韵，“將”同部本韵；三章“縈”为八庚韵，“成”同部本韵。","notes":null}]}]}}}
