{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/004-jiu-mu/chengjunying-jiangjianyuan-zhuxi","dataHref":"/__data/shijing/annotation/004-jiu-mu/chengjunying-jiangjianyuan-zhuxi/data.json","title":"詩經注析 · 樛木 · 注释总览","description":"風 · 周南 · 樛木 · 汇集《詩經注析》关于《樛木》的 4 条 annotation，含 4 条 gloss。"},"payload":{"detail":{"route":{"poemId":"004-jiu-mu","materialId":"chengjunying-jiangjianyuan-zhuxi"},"href":"/shijing/annotation/004-jiu-mu/chengjunying-jiangjianyuan-zhuxi","poem":{"id":"004-jiu-mu","title":"樛木","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","樛木"],"segments":[{"id":"seg-001","text":"南有樛木","isActive":false},{"id":"seg-002","text":"葛藟累之","isActive":false},{"id":"seg-003","text":"乐只君子","isActive":false},{"id":"seg-004","text":"福履绥之","isActive":false},{"id":"seg-005","text":"南有樛木","isActive":false},{"id":"seg-006","text":"葛藟荒之","isActive":false},{"id":"seg-007","text":"乐只君子","isActive":false},{"id":"seg-008","text":"福履将之","isActive":false},{"id":"seg-009","text":"南有樛木","isActive":false},{"id":"seg-010","text":"葛藟萦之","isActive":false},{"id":"seg-011","text":"乐只君子","isActive":false},{"id":"seg-012","text":"福履成之","isActive":false}]},"material":{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","authors":["程俊英","蔣見元"],"contributorLine":"现代 · 程俊英、蔣見元","era":"现代","publicationYear":1991,"carrier":"PDF"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"这是一首祝贺新郎的诗。书中认为“君子”当指称化为君子的上层人物，并指出上句取兴于葛藟依附樛木的艺术手法。","targetNotes":"题解与结构说明。","sourceLabel":"第 34-35 页","sourceNotes":"第 34 页《题解》至第 35 页上半。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"题解把《樛木》定为祝贺新郎之诗，认为君子应是称化为君子的上层人物。作者又引李注、孔疏等说，指出“南有樛木，葛藟累之”本是以葛藟附木起兴，后人据此多把它视作新婚祝辞的根源。","notes":"据 page 34-35 题解。"}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"南有樛木葛藟累之乐只君子福履绥之","targetNotes":"首章与训释。","sourceLabel":"第 35 页","sourceNotes":"第 35 页首章注释。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"注释","text":"注释释“南”为南土、南都、南国之间，“樛”为弯曲下垂的树枝；“葛藟”是蔓生植物，亦通作藟，“累”本义系累，引申为攀缘。“福履”即福禄幸福，“绥”训安，引申为爱与安定。","notes":"据 page 35 首章逐条注释。"}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"南有樛木葛藟荒之乐只君子福履将之","targetNotes":"二章与训释。","sourceLabel":"第 35 页","sourceNotes":"第 35 页二章注释。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"注释","text":"注释将“荒”释作覆盖、奄有，一曰草掩地貌而与荒通；“将”则释为扶助、送助之义。书中据此说明二章从“绥”推进到“将”，所祝愿的福履更深一层。","notes":"据 page 35 二章逐条注释。"}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"南有樛木葛藟萦之乐只君子福履成之","targetNotes":"三章与训释。","sourceLabel":"第 35 页","sourceNotes":"第 35 页三章注释。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"注释","text":"注释以“萦”为旋绕，“成”为成就，并据陈奂等说指出三章由绥、将而终于成，表示福履的祝愿已达到圆满完成。","notes":"据 page 35 三章逐条注释。"}]}]}}}
