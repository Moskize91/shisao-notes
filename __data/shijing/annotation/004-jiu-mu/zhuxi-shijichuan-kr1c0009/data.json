{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/004-jiu-mu/zhuxi-shijichuan-kr1c0009","dataHref":"/__data/shijing/annotation/004-jiu-mu/zhuxi-shijichuan-kr1c0009/data.json","title":"詩集傳 · 樛木 · 注释总览","description":"風 · 周南 · 樛木 · 汇集《詩集傳》关于《樛木》的 4 条 annotation，含 5 条 gloss。"},"payload":{"detail":{"route":{"poemId":"004-jiu-mu","materialId":"zhuxi-shijichuan-kr1c0009"},"href":"/shijing/annotation/004-jiu-mu/zhuxi-shijichuan-kr1c0009","poem":{"id":"004-jiu-mu","title":"樛木","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","樛木"],"segments":[{"id":"seg-001","text":"南有樛木","isActive":true},{"id":"seg-002","text":"葛藟纍之","isActive":true},{"id":"seg-003","text":"樂只君子","isActive":true},{"id":"seg-004","text":"福履綏之","isActive":true},{"id":"seg-005","text":"南有樛木","isActive":false},{"id":"seg-006","text":"葛藟荒之","isActive":false},{"id":"seg-007","text":"樂只君子","isActive":false},{"id":"seg-008","text":"福履將之","isActive":false},{"id":"seg-009","text":"南有樛木","isActive":false},{"id":"seg-010","text":"葛藟縈之","isActive":false},{"id":"seg-011","text":"樂只君子","isActive":false},{"id":"seg-012","text":"福履成之","isActive":false}]},"material":{"id":"zhuxi-shijichuan-kr1c0009","title":"詩集傳","authors":["朱熹"],"contributorLine":"宋 · 朱熹","era":"宋","publicationYear":1186,"carrier":"TXT"},"stats":{"annotationCount":4,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"南有樛木，葛藟纍之。樂只君子，福履綏之。","targetNotes":"首章并章句说明。","sourceLabel":null,"sourceNotes":"对应 txt 128-133 行。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"朱熹","sectionLabel":"传","text":"興也。南，南山也。木下曲曰樛。藟，葛類。纍，猶繫也。只，語助辭。君子，自衆妾而指后妃，猶言小君內子也。履，祿。綏，安也。","notes":null},{"key":"0001-2","attributionLabel":"朱熹","sectionLabel":"传","text":"后妃能逮下而無嫉妬之心，故衆妾樂其德而稱願之曰：南有樛木，則葛藟纍之矣；樂只君子，則福履綏之矣。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"南有樛木，葛藟荒之。樂只君子，福履將之。","targetNotes":"第二章并章句说明。","sourceLabel":null,"sourceNotes":"对应 txt 133-134 行。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"朱熹","sectionLabel":"传","text":"興也。荒，奄也。將，猶扶助也。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"南有樛木，葛藟縈之。樂只君子，福履成之。","targetNotes":"第三章并章句说明。","sourceLabel":null,"sourceNotes":"对应 txt 135-136 行。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"朱熹","sectionLabel":"传","text":"興也。縈，旋也。成，就也。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"樛木三章章四句","targetNotes":"章句总说。","sourceLabel":null,"sourceNotes":"对应 txt 138 行。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"朱熹","sectionLabel":"总评","text":"樛木三章章四句。","notes":null}]}]}}}
