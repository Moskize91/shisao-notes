{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/015-cai-ping/zhuxi-shijichuan-kr1c0009","dataHref":"/__data/shijing/annotation/015-cai-ping/zhuxi-shijichuan-kr1c0009/data.json","title":"詩集傳 · 采蘋 · 注释总览","description":"風 · 召南 · 采蘋 · 汇集《詩集傳》关于《采蘋》的 4 条注释，含 7 条注脚。"},"payload":{"detail":{"route":{"poemId":"015-cai-ping","materialId":"zhuxi-shijichuan-kr1c0009"},"href":"/shijing/annotation/015-cai-ping/zhuxi-shijichuan-kr1c0009","poem":{"id":"015-cai-ping","title":"采蘋","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","采蘋"],"segments":[{"id":"seg-001","text":"于以采蘋","isActive":true},{"id":"seg-002","text":"南㵎之濱","isActive":true},{"id":"seg-003","text":"于以采藻","isActive":true},{"id":"seg-004","text":"于彼行潦","isActive":true},{"id":"seg-005","text":"于以盛之","isActive":false},{"id":"seg-006","text":"維筐及筥","isActive":false},{"id":"seg-007","text":"于以湘之","isActive":false},{"id":"seg-008","text":"維錡及釡","isActive":false},{"id":"seg-009","text":"于以奠之","isActive":false},{"id":"seg-010","text":"宗室牖下","isActive":false},{"id":"seg-011","text":"誰其尸之","isActive":false},{"id":"seg-012","text":"有齊季女","isActive":false}]},"material":{"id":"zhuxi-shijichuan-kr1c0009","title":"詩集傳","authors":["朱熹"],"contributorLine":"宋 · 朱熹","era":"宋","publicationYear":1186,"carrier":"TXT"},"stats":{"annotationCount":4,"glossCount":7},"annotations":[{"id":"0001","order":1,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"于以采蘋，南㵎之濱，于以采藻，于彼行潦。","targetNotes":"首章。","sourceLabel":null,"sourceNotes":"对应 txt 285-288 行。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"朱熹","sectionLabel":null,"text":"賦也。蘋，水上浮萍也，江東人謂之䕯。濱，厓也。藻，聚藻也，生水底，莖如釵股，葉如蓬蒿。行潦，流潦也。","notes":null},{"key":"0001-2","attributionLabel":"朱熹","sectionLabel":null,"text":"南國被文王之化，大夫妻能奉祭祀，而其家人叙其事以美之也。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"于以盛之，維筐及筥，于以湘之，維錡及釡。","targetNotes":"第二章。","sourceLabel":null,"sourceNotes":"对应 txt 288-292 行。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"朱熹","sectionLabel":null,"text":"賦也。方曰筐，圎曰筥。湘，烹也，蓋粗熟而淹以爲菹也。錡，釡屬，有足曰錡，無足曰釡。","notes":null},{"key":"0002-2","attributionLabel":"朱熹","sectionLabel":null,"text":"此足以見其循序有常，嚴敬整飭之意。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"于以奠之，宗室牖下，誰其尸之，有齊季女。","targetNotes":"第三章。","sourceLabel":null,"sourceNotes":"对应 txt 293-296 行。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"朱熹","sectionLabel":null,"text":"賦也。奠，置也。宗室，大宗之廟也。大夫士祭於宗室。牖下，室西南隅，所謂奥也。尸，主也。齊，敬貌。季，少也。","notes":null},{"key":"0003-2","attributionLabel":"朱熹","sectionLabel":null,"text":"祭祀之禮主婦主薦豆實以蘋藻，少女而能敬，尤見其質之美而化之所從來者遠矣。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"采蘋三章章四句","targetNotes":"章句总说。","sourceLabel":null,"sourceNotes":"对应 txt 297 行。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"朱熹","sectionLabel":"章次","text":"朱熹定此篇为三章章四句，并把篇旨归于南国大夫妻承文王之化而能敬奉祭祀，家人因叙其事以成美刺。","notes":null}]}]}}}
