lse},{"id":"seg-032","text":"釜","isActive":false},{"id":"seg-033","text":"于","isActive":false},{"id":"seg-034","text":"以","isActive":false},{"id":"seg-035","text":"奠","isActive":false},{"id":"seg-036","text":"之","isActive":false},{"id":"seg-037","text":"宗","isActive":false},{"id":"seg-038","text":"室","isActive":false},{"id":"seg-039","text":"牖","isActive":false},{"id":"seg-040","text":"下","isActive":false},{"id":"seg-041","text":"谁","isActive":false},{"id":"seg-042","text":"其","isActive":false},{"id":"seg-043","text":"尸","isActive":false},{"id":"seg-044","text":"之","isActive":false},{"id":"seg-045","text":"有","isActive":false},{"id":"seg-046","text":"齐","isActive":false},{"id":"seg-047","text":"季","isActive":false},{"id":"seg-048","text":"女","isActive":false}]},"material":{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","authors":["程俊英","蔣見元"],"contributorLine":"现代 · 程俊英、蔣見元","era":"现代","publicationYear":1991,"carrier":"PDF"},"stats":{"annotationCount":19,"glossCount":19},"annotations":[{"id":"0001","order":1,"total":19,"layer":"preface","layerLabel":"篇序","targetText":"【题解】","targetNotes":null,"sourceLabel":"第 28 页","sourceNotes":"书内页 28《采苹》题解。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解"}]},{"id":"0002","order":2,"total":19,"layer":"global","layerLabel":"全篇总说","targetText":"这是一首叙述女子祭祖的诗。毛传：“古之将嫁女者，必先礼之于宗室，牲用鱼，芼之以苹藻。”这可能是当时的风俗习尚。明何楷诗经世本古义根据左传襄公二十八年的记载，中有“济泽之阿，行潦之苹藻，寘诸宗室，季兰尸之，敬也。敬可弃乎？”数语，认为“故为诗人美卫庄姜庶妃送归妾妃，能修此礼而作”。虽言之成理，但总嫌证据不足。","targetNotes":"题解段","sourceLabel":"第 28 页","sourceNotes":"书内页 28《采苹》题解。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解"}]},{"id":"0003","order":3,"total":19,"layer":"global","layerLabel":"全篇总说","targetText":"此诗连用五个“于以”一个“谁”，一问一答，气势壮阔，如黄河之水，盘涡激转；群山万壑，奔赴荆门。至末二句笔锋陡转，忽然表出诗中人物。又如“万壑飞流，突然一注”（戴君恩读风臆评）。","targetNotes":"题解段","sourceLabel":"第 28 页","sourceNotes":"书内页 28《采苹》题解。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"程俊英、蒋见元","sectionLabel"