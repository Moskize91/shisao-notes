{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/015-cai-ping/chengjunying-jiangjianyuan-zhuxi","dataHref":"/__data/shijing/annotation/015-cai-ping/chengjunying-jiangjianyuan-zhuxi/data.json","title":"詩經注析 · 采蘋 · 注释总览","description":"風 · 召南 · 采蘋 · 汇集《詩經注析》关于《采蘋》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"015-cai-ping","materialId":"chengjunying-jiangjianyuan-zhuxi"},"href":"/shijing/annotation/015-cai-ping/chengjunying-jiangjianyuan-zhuxi","poem":{"id":"015-cai-ping","title":"采蘋","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","采蘋"],"segments":[{"id":"seg-001","text":"于以采苹","isActive":false},{"id":"seg-002","text":"南涧之滨","isActive":false},{"id":"seg-003","text":"于以采藻","isActive":false},{"id":"seg-004","text":"于彼行潦","isActive":false},{"id":"seg-005","text":"于以盛之","isActive":false},{"id":"seg-006","text":"维筐及筥","isActive":false},{"id":"seg-007","text":"于以湘之","isActive":false},{"id":"seg-008","text":"维锜及釜","isActive":false},{"id":"seg-009","text":"于以奠之","isActive":false},{"id":"seg-010","text":"宗室牖下","isActive":false},{"id":"seg-011","text":"谁其尸之","isActive":false},{"id":"seg-012","text":"有齐季女","isActive":false}]},"material":{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","authors":["程俊英","蔣見元"],"contributorLine":"现代 · 程俊英、蔣見元","era":"现代","publicationYear":1991,"carrier":"PDF"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"题解","targetNotes":"题解总说。","sourceLabel":"第 28 页","sourceNotes":"书内页 28《采苹》题解。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"题解将此篇解释为女子将嫁前祭告祖先之诗，肯定毛传所说“将嫁女者先礼于宗室、以蘋藻芼鱼”的婚前告庙礼俗；并指出三章依次铺写采具祭品、陈设器物、奠祭地点与主祭者，层层递进，中心落在季女之“敬”。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"于以采苹？南涧之滨。于以采藻？于彼行潦。","targetNotes":"首章。","sourceLabel":"第 28 页","sourceNotes":"书内页 28 首章与注释。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"首章注释“苹”为水生植物，大者曰苹；“藻”为水草，可食；“行”借为道路之“行”，“潦”为积水，故“行潦”即道路上流行之水。借此可见首章专写祭品来源与采择之地，并以真、宵两部押韵分明其声调层次。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"于以盛之？维筐及筥。于以湘之？维锜及釜。","targetNotes":"第二章。","sourceLabel":"第 29 页","sourceNotes":"书内页 29 第二章与注释。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"此章释“维”为发语词，“筐”“筥”是方圆不同的竹制盛器；“湘”训煮、与《韩诗》作“鬺”义同；“锜”是三足釜，“釜”为烹煮器。全章由盛物到烹治，显示婚前告庙所用祭品与器具皆有定制。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"于以奠之？宗室牖下。谁其尸之？有齐季女。","targetNotes":"第三章。","sourceLabel":"第 29 页","sourceNotes":"书内页 29 第三章与注释。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"末章释“奠”为置，“宗室”为宗庙，“牖”为窗，“尸”为主祭者；又据古训解释“齐”为恭敬貌、“季女”为少女，从而强调诗中主人公是主持设奠的未嫁少女，主题核心就在季女对祖先所持的敬慎态度。","notes":null}]}]}}}
