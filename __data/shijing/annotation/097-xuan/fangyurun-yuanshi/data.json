{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/097-xuan/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/097-xuan/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 還 · 注释总览","description":"風 · 齊風 · 還 · 汇集《诗经原始(上下)》关于《還》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"097-xuan","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/097-xuan/fangyurun-yuanshi","poem":{"id":"097-xuan","title":"還","categoryId":"feng","subcategoryId":"qifeng","path":["風","齊風","還"],"segments":[{"id":"seg-001","text":"子之還兮","isActive":false},{"id":"seg-002","text":"遭我乎峱之間兮","isActive":false},{"id":"seg-003","text":"並驅從兩肩兮","isActive":false},{"id":"seg-004","text":"揖我謂我儇兮","isActive":false},{"id":"seg-005","text":"子之茂兮","isActive":false},{"id":"seg-006","text":"遭我乎峱之道兮","isActive":false},{"id":"seg-007","text":"並驅從兩牡兮","isActive":false},{"id":"seg-008","text":"揖我謂我好兮","isActive":false},{"id":"seg-009","text":"子之昌兮","isActive":false},{"id":"seg-010","text":"遭我乎峱之陽兮","isActive":false},{"id":"seg-011","text":"並驅從兩狼兮","isActive":false},{"id":"seg-012","text":"揖我謂我臧兮","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"刺齊俗以弋獵相矜尚也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 篇首题注。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注"}]},{"id":"0002","order":2,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"右《還》三章，章四句。《序》謂「刺哀公」。然詩無「君」、「公」字，胡以知其然耶？此不過獵者互相稱譽，詩人從旁微哂，因直述其詞，不加一語，自成篇章，而齊俗急功利、喜夸詐之風，自在言外，亦不刺之刺也。至其用筆之妙，則章氏潢云：「子之還兮」，己譽人也；「謂我儇兮」，人譽己也；「並驅」，則人己皆與有能也。寥寥數語，自具分合變化之妙。獵固便捷，詩亦輕利。神乎技矣！","targetNotes":"总评原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"总评"}]},{"id":"0003","order":3,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"還便捷之貌。峱山名。〔許氏慎曰〕峱山，在齊地。從逐也。肩〔陸氏德明曰〕肩，《説文》云：「三歲豕，肩相及者。」本亦作豜，音同。〔孔氏穎達曰〕《大司馬》云「大獸公之」，《七月》云「獻豜于公」，則肩是大獸。儇利也。茂美也。昌盛也。狼獸名，似犬。〔孔氏穎達曰〕舍人曰：「狼，牡名貛，牝名狼。」臧善也。","targetNotes":"集释原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"集釋"}]},{"id":"0004","order":4,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"還十五删。間同。肩一先。儇同。通韻。茂二十六宥。道十九皓，叶徒厚反。牡二十五有。好十九皓，叶許厚反。叶韻。昌七陽。陽、狼、臧並同。本韻。","targetNotes":"标韵原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标韵段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":"標韻"}]}]}}}
