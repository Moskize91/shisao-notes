{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/031-ji-gu/chengjunying-jiangjianyuan-zhuxi","dataHref":"/__data/shijing/annotation/031-ji-gu/chengjunying-jiangjianyuan-zhuxi/data.json","title":"詩經注析 · 擊鼓 · 注释总览","description":"風 · 邶風 · 擊鼓 · 汇集《詩經注析》关于《擊鼓》的 6 条注释，含 6 条注脚。"},"payload":{"detail":{"route":{"poemId":"031-ji-gu","materialId":"chengjunying-jiangjianyuan-zhuxi"},"href":"/shijing/annotation/031-ji-gu/chengjunying-jiangjianyuan-zhuxi","poem":{"id":"031-ji-gu","title":"擊鼓","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","擊鼓"],"segments":[{"id":"seg-001","text":"击鼓其镗","isActive":false},{"id":"seg-002","text":"踊跃用兵","isActive":false},{"id":"seg-003","text":"土国城漕","isActive":false},{"id":"seg-004","text":"我独南行","isActive":false},{"id":"seg-005","text":"从孙子仲","isActive":false},{"id":"seg-006","text":"平陈与宋","isActive":false},{"id":"seg-007","text":"不我以归","isActive":false},{"id":"seg-008","text":"忧心有忡","isActive":false},{"id":"seg-009","text":"爰居爰处","isActive":false},{"id":"seg-010","text":"爰丧其马","isActive":false},{"id":"seg-011","text":"于以求之","isActive":false},{"id":"seg-012","text":"于林之下","isActive":false},{"id":"seg-013","text":"死生契阔","isActive":false},{"id":"seg-014","text":"与子成说","isActive":false},{"id":"seg-015","text":"执子之手","isActive":false},{"id":"seg-016","text":"与子偕老","isActive":false},{"id":"seg-017","text":"于嗟阔兮","isActive":false},{"id":"seg-018","text":"不我活兮","isActive":false},{"id":"seg-019","text":"于嗟洵兮","isActive":false},{"id":"seg-020","text":"不我信兮","isActive":false}]},"material":{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","authors":["程俊英","蔣見元"],"contributorLine":"现代 · 程俊英、蔣見元","era":"现代","publicationYear":1991,"carrier":"PDF"},"stats":{"annotationCount":6,"glossCount":6},"annotations":[{"id":"0001","order":1,"total":6,"layer":"global","layerLabel":"全篇总说","targetText":"题解","targetNotes":"题解总说。","sourceLabel":"第 60 页","sourceNotes":"书内页 60《题解》段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"程、蒋将《击鼓》定为卫国戍卒久戍思归不得之诗。题解回顾《序》以来多附会州吁伐郑、平陈与宋等史事，但强调全篇真正动人的核心不在某一战役，而在征人由从军劳苦、行伍离散，进而追忆夫妻别誓、终至怨叹久役无归的心路层递。","notes":null}]},{"id":"0002","order":2,"total":6,"layer":"span","layerLabel":"诗句片段","targetText":"击鼓其镗，踊跃用兵。土国城漕，我独南行。","targetNotes":"首章。","sourceLabel":"第 60-61 页","sourceNotes":"书内页 60-61 首章注析。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"注析","text":"程、蒋释“镗”为击鼓声，“兵”为兵器，“土国城漕”谓在国内服役土工、于漕邑筑城，而“我独南行”则写自己偏被派赴南征。首章通过与境内劳役相陪衬，突出远戍者处境尤苦。","notes":null}]},{"id":"0003","order":3,"total":6,"layer":"span","layerLabel":"诗句片段","targetText":"从孙子仲，平陈与宋。不我以归，忧心有忡。","targetNotes":"第二章。","sourceLabel":"第 61 页","sourceNotes":"书内页 61 第二章注析。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"注析","text":"程、蒋释孙子仲为卫将，认为“平陈与宋”可指当时相关军行，而“不我以归”即不让我回来，“有忡”为忧惧不安。此章点明久役不得归队返家的现实，是全篇怨情的正面落点。","notes":null}]},{"id":"0004","order":4,"total":6,"layer":"span","layerLabel":"诗句片段","targetText":"爰居爰处，爰丧其马。于以求之，于林之下。","targetNotes":"第三章。","sourceLabel":"第 61 页","sourceNotes":"书内页 61 第三章注析。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"注析","text":"程、蒋认为此章最见军伍离散之状：士卒散处无纪，乃至丧马、入林求觅。“爰居爰处”与“爰丧其马”并列，使征戍之乱象在短短四句中显得格外具体。","notes":null}]},{"id":"0005","order":5,"total":6,"layer":"span","layerLabel":"诗句片段","targetText":"死生契阔，与子成说。执子之手，与子偕老。","targetNotes":"第四章。","sourceLabel":"第 61-62 页","sourceNotes":"书内页 61-62 第四章注析。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"注析","text":"程、蒋释“契阔”为结合与离别对举的誓词回忆，认为这一章忽然转入夫妻临别盟誓，使前面战乱劳苦都被映照得更可悲。全篇最著名的名句，在这里是征人思室家不得的情感高潮，而非单独的情爱小唱。","notes":null}]},{"id":"0006","order":6,"total":6,"layer":"span","layerLabel":"诗句片段","targetText":"于嗟阔兮，不我活兮。于嗟洵兮，不我信兮。","targetNotes":"第五章。","sourceLabel":"第 62 页","sourceNotes":"书内页 62 第五章注析。","notes":null,"glosses":[{"key":"0006-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"注析","text":"末章中程、蒋释“活”为聚会、“信”为守约，认为这是对久役不返最直接的怨叹：昔日所誓今皆落空，夫妻长隔，不得团聚，前盟亦不能再申。全诗以此收束，既有兵役无已之怨，也有室家离散之悲。","notes":null}]}]}}}
