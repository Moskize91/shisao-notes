{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/031-ji-gu/maoheng-zhushu-kr1c0004","dataHref":"/__data/shijing/annotation/031-ji-gu/maoheng-zhushu-kr1c0004/data.json","title":"毛詩注疏 · 擊鼓 · 注释总览","description":"風 · 邶風 · 擊鼓 · 汇集《毛詩注疏》关于《擊鼓》的 6 条注释，含 6 条注脚。"},"payload":{"detail":{"route":{"poemId":"031-ji-gu","materialId":"maoheng-zhushu-kr1c0004"},"href":"/shijing/annotation/031-ji-gu/maoheng-zhushu-kr1c0004","poem":{"id":"031-ji-gu","title":"擊鼓","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","擊鼓"],"segments":[{"id":"seg-001","text":"擊鼓其鏜","isActive":false},{"id":"seg-002","text":"踊躍用兵","isActive":false},{"id":"seg-003","text":"土國城漕","isActive":false},{"id":"seg-004","text":"我獨南行","isActive":false},{"id":"seg-005","text":"從孫子仲","isActive":false},{"id":"seg-006","text":"平陳與宋","isActive":false},{"id":"seg-007","text":"不我以歸","isActive":false},{"id":"seg-008","text":"憂心有忡","isActive":false},{"id":"seg-009","text":"爰居爰處","isActive":false},{"id":"seg-010","text":"爰喪其馬","isActive":false},{"id":"seg-011","text":"于以求之","isActive":false},{"id":"seg-012","text":"于林之下","isActive":false},{"id":"seg-013","text":"死生契闊","isActive":false},{"id":"seg-014","text":"與子成說","isActive":false},{"id":"seg-015","text":"執子之手","isActive":false},{"id":"seg-016","text":"與子偕老","isActive":false},{"id":"seg-017","text":"于嗟闊兮","isActive":false},{"id":"seg-018","text":"不我活兮","isActive":false},{"id":"seg-019","text":"于嗟洵兮","isActive":false},{"id":"seg-020","text":"不我信兮","isActive":false}]},"material":{"id":"maoheng-zhushu-kr1c0004","title":"毛詩注疏","authors":["毛亨","鄭氏","孔穎達"],"contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","era":"漢唐","publicationYear":653,"carrier":"TXT"},"stats":{"annotationCount":6,"glossCount":6},"annotations":[{"id":"0001","order":1,"total":6,"layer":"preface","layerLabel":"篇序","targetText":"擊鼓怨州吁也衛州吁用兵暴亂使公孫文仲將而平陳與宋國人怨其勇而無禮也","targetNotes":"篇首小序。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》擊鼓序文。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序","text":"序：《擊鼓》，怨州吁也。衛州吁用兵暴亂，使公孫文仲將而平陳與宋，國人怨其勇而無禮也。","notes":null}]},{"id":"0002","order":2,"total":6,"layer":"span","layerLabel":"诗句片段","targetText":"擊鼓其鏜踊躍用兵土國城漕我獨南行","targetNotes":"首章。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》首章。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：鏜，擊鼓聲也。踊躍，武貌。土，國內之事。漕，衛邑也。","notes":null}]},{"id":"0003","order":3,"total":6,"layer":"span","layerLabel":"诗句片段","targetText":"從孫子仲平陳與宋不我以歸憂心有忡","targetNotes":"第二章。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》第二章。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：孫子仲，惠公孫文仲也。平，和也。忡，憂也。","notes":null}]},{"id":"0004","order":4,"total":6,"layer":"span","layerLabel":"诗句片段","targetText":"爰居爰處爰喪其馬于以求之于林之下","targetNotes":"第三章。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》第三章。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：爰，於也。不還者及其馬亡，則求之林下。","notes":null}]},{"id":"0005","order":5,"total":6,"layer":"span","layerLabel":"诗句片段","targetText":"死生契闊與子成說執子之手與子偕老","targetNotes":"第四章。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》第四章。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：契闊，勤苦也。成說，成其相與之約。","notes":null}]},{"id":"0006","order":6,"total":6,"layer":"span","layerLabel":"诗句片段","targetText":"于嗟闊兮不我活兮于嗟洵兮不我信兮","targetNotes":"第五章。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》第五章。","notes":null,"glosses":[{"key":"0006-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：闊，遠也。活，會也。洵，遠也。信，極也。","notes":null}]}]}}}
