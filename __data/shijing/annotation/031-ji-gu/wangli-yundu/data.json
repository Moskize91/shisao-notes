{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/031-ji-gu/wangli-yundu","dataHref":"/__data/shijing/annotation/031-ji-gu/wangli-yundu/data.json","title":"詩經韻讀 · 擊鼓 · 注释总览","description":"風 · 邶風 · 擊鼓 · 汇集《詩經韻讀》关于《擊鼓》的 2 条注释，含 2 条注脚。"},"payload":{"detail":{"route":{"poemId":"031-ji-gu","materialId":"wangli-yundu"},"href":"/shijing/annotation/031-ji-gu/wangli-yundu","poem":{"id":"031-ji-gu","title":"擊鼓","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","擊鼓"],"segments":[{"id":"seg-001","text":"击鼓其镗","isActive":false},{"id":"seg-002","text":"踊跃用兵","isActive":false},{"id":"seg-003","text":"土国城漕","isActive":false},{"id":"seg-004","text":"我独南行","isActive":false},{"id":"seg-005","text":"从孙子仲","isActive":false},{"id":"seg-006","text":"平陈与宋","isActive":false},{"id":"seg-007","text":"不我以归","isActive":false},{"id":"seg-008","text":"忧心有忡","isActive":false},{"id":"seg-009","text":"爰居爰处","isActive":false},{"id":"seg-010","text":"爰丧其马","isActive":false},{"id":"seg-011","text":"于以求之","isActive":false},{"id":"seg-012","text":"于林之下","isActive":false},{"id":"seg-013","text":"死生契阔","isActive":false},{"id":"seg-014","text":"与子成说","isActive":false},{"id":"seg-015","text":"执子之手","isActive":false},{"id":"seg-016","text":"与子偕老","isActive":false},{"id":"seg-017","text":"于嗟阔兮","isActive":false},{"id":"seg-018","text":"不我活兮","isActive":false},{"id":"seg-019","text":"于嗟洵兮","isActive":false},{"id":"seg-020","text":"不我信兮","isActive":false}]},"material":{"id":"wangli-yundu","title":"詩經韻讀","authors":["王力"],"contributorLine":"现代 · 王力","era":"现代","publicationYear":1980,"carrier":"PDF"},"stats":{"annotationCount":2,"glossCount":2},"annotations":[{"id":"0001","order":1,"total":2,"layer":"global","layerLabel":"全篇总说","targetText":"《击鼓》韵读总说","targetNotes":"书页 153-154 的诗号 31 全段。","sourceLabel":"第 153-154 页","sourceNotes":"书页 153-154《击鼓》韵读。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"王力","sectionLabel":"韵读","text":"王力将《击鼓》分作五章换韵：首章“鏜(thang)、行(heang)”与“兵(pyang)”为阳部，次章“仲(dium)、宋(suom)、忡(thiuam)”入侵东通摄，三章“處(thjia)、馬(mea)、下(hea)”入鱼部，四章“闊(khuat)、説(sjuat)”与“老(lu)”分月幽两层，第五章“闊(khuat)、活(huat)”入月部，而“洵(siuen)、信(sien)”转真部。全诗声律随章法递转。","notes":null}]},{"id":"0002","order":2,"total":2,"layer":"span","layerLabel":"诗句片段","targetText":"击鼓其镗，踊跃用兵。土国城漕，我独南行。从孙子仲，平陈与宋。不我以归，忧心有忡。爰居爰处，爰丧其马。于以求之，于林之下。死生契阔，与子成说；执子之手，与子偕老。于嗟阔兮，不我活兮。于嗟洵兮，不我信兮。","targetNotes":"现存页图可见全篇。","sourceLabel":"第 153-154 页","sourceNotes":"书页 153-154《击鼓》全篇韵读。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"王力","sectionLabel":"韵读","text":"页图可读《击鼓》五章韵部层次分明，由阳、侵、鱼而转入月幽、月真。王力所记注音表明，后两章虽为传诵名句，但在韵读上仍严格依章换韵，不是一味平铺。","notes":null}]}]}}}
