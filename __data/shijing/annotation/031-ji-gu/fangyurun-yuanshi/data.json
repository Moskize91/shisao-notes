{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/031-ji-gu/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/031-ji-gu/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 擊鼓 · 注释总览","description":"風 · 邶風 · 擊鼓 · 汇集《诗经原始(上下)》关于《擊鼓》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"031-ji-gu","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/031-ji-gu/fangyurun-yuanshi","poem":{"id":"031-ji-gu","title":"擊鼓","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","擊鼓"],"segments":[{"id":"seg-001","text":"擊鼓其鏜","isActive":false},{"id":"seg-002","text":"踊躍用兵","isActive":false},{"id":"seg-003","text":"土國城漕","isActive":false},{"id":"seg-004","text":"我獨南行","isActive":false},{"id":"seg-005","text":"從孫子仲","isActive":false},{"id":"seg-006","text":"平陳與宋","isActive":false},{"id":"seg-007","text":"不我以歸","isActive":false},{"id":"seg-008","text":"憂心有忡","isActive":false},{"id":"seg-009","text":"爰居爰處","isActive":false},{"id":"seg-010","text":"爰喪其馬","isActive":false},{"id":"seg-011","text":"于以求之","isActive":false},{"id":"seg-012","text":"于林之下","isActive":false},{"id":"seg-013","text":"死生契濶","isActive":false},{"id":"seg-014","text":"與子成説","isActive":false},{"id":"seg-015","text":"執子之手","isActive":false},{"id":"seg-016","text":"與子偕老","isActive":false},{"id":"seg-017","text":"于嗟濶兮","isActive":false},{"id":"seg-018","text":"不我活兮","isActive":false},{"id":"seg-019","text":"于嗟洵兮","isActive":false},{"id":"seg-020","text":"不我信兮","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"擊鼓㊟衛戍卒思歸不得也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标题段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注","text":"方玉润在题注中径定《擊鼓》为卫戍卒思归不得之诗，不从《小序》怨州吁的旧说。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"总评","targetNotes":"通篇总评。","sourceLabel":null,"sourceNotes":"对应 EPUB item 总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"总评","text":"方玉润详驳《小序》与郑笺以州吁伐郑实之的说法，认为只凭“平陳與宋”“不我以歸”二语即可见其多有不合。依他看，此诗当作于救陈之后边防久戍之时，先叙南行之故，次写军伍懈散，再追忆室家叙别之盟，末以久戍不归、前言尽负作结，最足见戍卒思归不得之苦。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"眉评","targetNotes":"篇中眉评撮要。","sourceLabel":null,"sourceNotes":"对应 EPUB item 眉评内容。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"眉评","text":"方玉润眉评特别称道第四章追叙前盟，使文势转曲，与下章连用“于嗟”反转上意相配，最见章法之妙。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"term","layerLabel":"字词注","targetText":"擊鼓其鏜踊躍用兵土國城漕從孫子仲爰居爰處死生契濶于嗟濶兮于嗟洵兮","targetNotes":"集释撮要。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":"集释","text":"方玉润集释云：“鏜”为鼓声，“土”为土功，“漕”为卫邑，“孫子仲”为所从之帅，“爰”为於也，“契濶”为隔远，“成説”为约誓有成言，“活”为生还，“洵”为信，“信”与申同。整组训诂都服务于戍卒久役离家、盟言难践的诗旨。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"标韵","targetNotes":"五章韵脚撮述。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标韵段。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"方玉润","sectionLabel":"标韵","text":"方玉润分章标出韵脚：首章“鏜、兵、行”转韵，二章“仲、宋、忡”叶韵，三章“馬、下”本韵，四章“濶、説”转韵而“手、老”叶韵，五章“濶、活”本韵，“洵、信”本韵。多层换韵配合章法递进。","notes":null}]}]}}}
