{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/031-ji-gu/maruichen-tongshi","dataHref":"/__data/shijing/annotation/031-ji-gu/maruichen-tongshi/data.json","title":"毛詩傳箋通釋 · 擊鼓 · 注释总览","description":"風 · 邶風 · 擊鼓 · 汇集《毛詩傳箋通釋》关于《擊鼓》的 1 条注释，含 1 条注脚。"},"payload":{"detail":{"route":{"poemId":"031-ji-gu","materialId":"maruichen-tongshi"},"href":"/shijing/annotation/031-ji-gu/maruichen-tongshi","poem":{"id":"031-ji-gu","title":"擊鼓","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","擊鼓"],"segments":[{"id":"seg-001","text":"擊鼓其鏜","isActive":true},{"id":"seg-002","text":"踊躍用兵","isActive":true},{"id":"seg-003","text":"土國城漕","isActive":true},{"id":"seg-004","text":"我獨南行","isActive":true},{"id":"seg-005","text":"從孫子仲","isActive":true},{"id":"seg-006","text":"平陳與宋","isActive":true},{"id":"seg-007","text":"不我以歸","isActive":true},{"id":"seg-008","text":"憂心有忡","isActive":true},{"id":"seg-009","text":"爰居爰處","isActive":true},{"id":"seg-010","text":"爰喪其馬","isActive":true},{"id":"seg-011","text":"于以求之","isActive":true},{"id":"seg-012","text":"于林之下","isActive":true},{"id":"seg-013","text":"死生契闊","isActive":true},{"id":"seg-014","text":"與子成説","isActive":true},{"id":"seg-015","text":"執子之手","isActive":true},{"id":"seg-016","text":"與子偕老","isActive":true},{"id":"seg-017","text":"于嗟闊兮","isActive":true},{"id":"seg-018","text":"不我活兮","isActive":true},{"id":"seg-019","text":"于嗟洵兮","isActive":true},{"id":"seg-020","text":"不我信兮","isActive":true}]},"material":{"id":"maruichen-tongshi","title":"毛詩傳箋通釋","authors":["馬瑞辰"],"contributorLine":"清 · 馬瑞辰","era":"清","publicationYear":1989,"carrier":"PDF"},"stats":{"annotationCount":1,"glossCount":1},"annotations":[{"id":"0001","order":1,"total":1,"layer":"span","layerLabel":"诗句片段","targetText":"擊鼓其鏜，踊躍用兵。土國城漕，我獨南行。從孫子仲，平陳與宋。不我以歸，憂心有忡。爰居爰處，爰喪其馬。于以求之，于林之下。死生契闊，與子成説。執子之手，與子偕老。于嗟闊兮，不我活兮。于嗟洵兮，不我信兮。","targetNotes":"整篇按语与字义考。","sourceLabel":"第 111-112 页","sourceNotes":"依据 /tmp/ji-gu-maruichen/p144.png 与 /tmp/ji-gu-maruichen/p145.png 中《擊鼓》条。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"马瑞辰","sectionLabel":"按"}]}]}}}
