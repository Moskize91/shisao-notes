{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/016-gan-tang/chengjunying-jiangjianyuan-zhuxi","dataHref":"/__data/shijing/annotation/016-gan-tang/chengjunying-jiangjianyuan-zhuxi/data.json","title":"詩經注析 · 甘棠 · 注释总览","description":"風 · 召南 · 甘棠 · 汇集《詩經注析》关于《甘棠》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"016-gan-tang","materialId":"chengjunying-jiangjianyuan-zhuxi"},"href":"/shijing/annotation/016-gan-tang/chengjunying-jiangjianyuan-zhuxi","poem":{"id":"016-gan-tang","title":"甘棠","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","甘棠"],"segments":[{"id":"seg-001","text":"蔽芾甘棠","isActive":false},{"id":"seg-002","text":"勿剪勿伐","isActive":false},{"id":"seg-003","text":"召伯所茇","isActive":false},{"id":"seg-004","text":"蔽芾甘棠","isActive":false},{"id":"seg-005","text":"勿剪勿败","isActive":false},{"id":"seg-006","text":"召伯所憩","isActive":false},{"id":"seg-007","text":"蔽芾甘棠","isActive":false},{"id":"seg-008","text":"勿剪勿拜","isActive":false},{"id":"seg-009","text":"召伯所说","isActive":false}]},"material":{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","authors":["程俊英","蔣見元"],"contributorLine":"现代 · 程俊英、蔣見元","era":"现代","publicationYear":1991,"carrier":"PDF"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"题解","targetNotes":"题解总说。","sourceLabel":"第 30 页","sourceNotes":"书内页 30《甘棠》题解。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"题解将此篇解释为南国人民追思召伯遗爱之诗，指出甘棠并非写景主角，而是召伯曾憩息其下的德政见证。三章连续以“勿伐”“勿败”“勿拜”递进，层层加重不可毁伤之意，正用这种反复递深的句法写出爱树即思人的感情。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"蔽芾甘棠，勿剪勿伐，召伯所茇。","targetNotes":"首章。","sourceLabel":"第 30 页","sourceNotes":"书内页 30 首章与注释。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"首章注释“蔽芾”为树荫繁茂下垂貌，“甘棠”即棠梨一类树木，“茇”是草舍或止宿之处。章意先点出召伯曾在树下憩居，所以南国之人不忍伤其枝干，爱树之情从一开始就与怀人之意相连。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"蔽芾甘棠，勿剪勿败，召伯所憩。","targetNotes":"第二章。","sourceLabel":"第 31 页","sourceNotes":"书内页 31 第二章与注释。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"第二章以“败”承“伐”而更进一步，释为毁伤，较单说砍伐更严；“憩”是休息。编者指出这层递进表现出思召伯之情愈发深重，已经不是不去砍树而已，而是连任何损伤都不忍加诸其上。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"蔽芾甘棠，勿剪勿拜，召伯所说。","targetNotes":"第三章。","sourceLabel":"第 31 页","sourceNotes":"书内页 31 第三章与注释。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"第三章注“拜”为拔地而去，“说”为舍止。比起前两章的伐与败，这里连将树连根移去都不肯，说明爱棠之情推到最极处；三章正是借词义由轻而重的层层推进，完成对召伯遗爱的赞美。","notes":null}]}]}}}
