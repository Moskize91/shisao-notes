{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/016-gan-tang/maruichen-tongshi","dataHref":"/__data/shijing/annotation/016-gan-tang/maruichen-tongshi/data.json","title":"毛詩傳箋通釋 · 甘棠 · 注释总览","description":"風 · 召南 · 甘棠 · 汇集《毛詩傳箋通釋》关于《甘棠》的 2 条注释，含 2 条注脚。"},"payload":{"detail":{"route":{"poemId":"016-gan-tang","materialId":"maruichen-tongshi"},"href":"/shijing/annotation/016-gan-tang/maruichen-tongshi","poem":{"id":"016-gan-tang","title":"甘棠","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","甘棠"],"segments":[{"id":"seg-001","text":"蔽芾甘棠","isActive":true},{"id":"seg-002","text":"勿翦勿伐","isActive":true},{"id":"seg-003","text":"召伯所茇","isActive":true},{"id":"seg-004","text":"蔽芾甘棠","isActive":false},{"id":"seg-005","text":"勿翦勿敗","isActive":false},{"id":"seg-006","text":"召伯所憩","isActive":false},{"id":"seg-007","text":"蔽芾甘棠","isActive":false},{"id":"seg-008","text":"勿翦勿拜","isActive":false},{"id":"seg-009","text":"召伯所說","isActive":false}]},"material":{"id":"maruichen-tongshi","title":"毛詩傳箋通釋","authors":["馬瑞辰"],"contributorLine":"清 · 馬瑞辰","era":"清","publicationYear":1989,"carrier":"PDF"},"stats":{"annotationCount":2,"glossCount":2},"annotations":[{"id":"0001","order":1,"total":2,"layer":"span","layerLabel":"诗句片段","targetText":"蔽芾甘棠，勿翦勿伐，召伯所茇。","targetNotes":"首章树名与止舍义。","sourceLabel":"第 107 页","sourceNotes":"依据 /tmp/maruichen-gan-tang/p107.png 中蔽芾、甘棠、茇诸条。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"马瑞辰","sectionLabel":"按","text":"瑞辰辨“蔽芾”当从《尔雅》训为小貌而兼有盛密下垂之意，不专主蔽障一义；又详论“甘棠”与棠、杜之别，认为诗中即棠梨之属。至“茇”，他申明为草舍、止宿之处，故首章正是借召伯尝憩于棠下，发明百姓爱树怀人之意。","notes":null}]},{"id":"0002","order":2,"total":2,"layer":"span","layerLabel":"诗句片段","targetText":"蔽芾甘棠，勿翦勿敗，召伯所憩。蔽芾甘棠，勿翦勿拜，召伯所說。","targetNotes":"后二章递进词义。","sourceLabel":"第 108 页","sourceNotes":"依据 /tmp/maruichen-gan-tang/p108.png 中敗、憩、拜、說诸条。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"马瑞辰","sectionLabel":"按","text":"瑞辰以为“敗”当作毁败解，“憩”即息，“說”为舍；又据古书语例说明“拜”当通拔地之拔。于是后二章由不可败伤而至不可拔去，正见爱棠之情递深；与“憩”“說”相参，也可看出召伯暂止其下的遗迹如何被民间反复追怀。","notes":null}]}]}}}
