{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/016-gan-tang/chenhuan-chuanshu","dataHref":"/__data/shijing/annotation/016-gan-tang/chenhuan-chuanshu/data.json","title":"詩毛氏傳疏 · 甘棠 · 注释总览","description":"風 · 召南 · 甘棠 · 汇集《詩毛氏傳疏》关于《甘棠》的 3 条注释，含 3 条注脚。"},"payload":{"detail":{"route":{"poemId":"016-gan-tang","materialId":"chenhuan-chuanshu"},"href":"/shijing/annotation/016-gan-tang/chenhuan-chuanshu","poem":{"id":"016-gan-tang","title":"甘棠","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","甘棠"],"segments":[{"id":"seg-001","text":"蔽芾甘棠","isActive":false},{"id":"seg-002","text":"勿翦勿伐","isActive":false},{"id":"seg-003","text":"召伯所茇","isActive":false},{"id":"seg-004","text":"蔽芾甘棠","isActive":false},{"id":"seg-005","text":"勿翦勿敗","isActive":false},{"id":"seg-006","text":"召伯所憩","isActive":false},{"id":"seg-007","text":"蔽芾甘棠","isActive":false},{"id":"seg-008","text":"勿翦勿拜","isActive":false},{"id":"seg-009","text":"召伯所說","isActive":false}]},"material":{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","authors":["陳奐"],"contributorLine":"清 · 陳奐","era":"清","publicationYear":1847,"carrier":"PDF"},"stats":{"annotationCount":3,"glossCount":3},"annotations":[{"id":"0001","order":1,"total":3,"layer":"preface","layerLabel":"篇序","targetText":"甘棠，美召伯也。","targetNotes":"篇首序文。","sourceLabel":"第 44 页","sourceNotes":"据第 44 页右侧《甘棠》篇首序义。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"疏承《序》以《甘棠》为美召伯之诗，强调其所以见美，不只在召伯曾止息棠下，更在其听讼行教、明于南国，故百姓爱其人并及其树。","notes":null}]},{"id":"0002","order":2,"total":3,"layer":"span","layerLabel":"诗句片段","targetText":"蔽芾甘棠，勿翦勿伐，召伯所茇。蔽芾甘棠，勿翦勿敗，召伯所憩。蔽芾甘棠，勿翦勿拜，召伯所說。","targetNotes":"三章通篇与疏义。","sourceLabel":"第 44-45 页","sourceNotes":"据第 44 页至第 45 页《甘棠》疏义提要。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"疏通解三章，认为诗旨在于民思召伯之德而推及其憩息之棠。首章言不伐其木，次章进一步至不毁伤其枝，三章又加重为不拔其根，正见爱之愈久而愈深。陈奂尤重召伯“听男女之讼于棠下，不重烦劳百姓”这一背景，故爱树实是感其仁政。","notes":null}]},{"id":"0003","order":3,"total":3,"layer":"global","layerLabel":"全篇总说","targetText":"甘棠三章章三句","targetNotes":"章句总说。","sourceLabel":"第 45 页","sourceNotes":"据第 45 页左侧章句总说。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"疏以“三章章三句”总束全篇，认为三章并非平列复沓，而是借“伐”“敗”“拜”层层递进，写出南国之人于召伯遗爱久而弥深的感情，所以虽句数极简，章法却最为警切。","notes":null}]}]}}}
