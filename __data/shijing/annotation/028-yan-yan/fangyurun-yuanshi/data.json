{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/028-yan-yan/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/028-yan-yan/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 燕燕 · 注释总览","description":"風 · 邶風 · 燕燕 · 汇集《诗经原始(上下)》关于《燕燕》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"028-yan-yan","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/028-yan-yan/fangyurun-yuanshi","poem":{"id":"028-yan-yan","title":"燕燕","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","燕燕"],"segments":[{"id":"seg-001","text":"燕燕于飛","isActive":false},{"id":"seg-002","text":"差池其羽","isActive":false},{"id":"seg-003","text":"之子于歸","isActive":false},{"id":"seg-004","text":"遠送于野","isActive":false},{"id":"seg-005","text":"瞻望弗及","isActive":false},{"id":"seg-006","text":"泣涕如雨","isActive":false},{"id":"seg-007","text":"燕燕于飛","isActive":false},{"id":"seg-008","text":"頡之頏之","isActive":false},{"id":"seg-009","text":"之子于歸","isActive":false},{"id":"seg-010","text":"遠于將之","isActive":false},{"id":"seg-011","text":"瞻望弗及","isActive":false},{"id":"seg-012","text":"佇立以泣","isActive":false},{"id":"seg-013","text":"燕燕于飛","isActive":false},{"id":"seg-014","text":"上下其音","isActive":false},{"id":"seg-015","text":"之子于歸","isActive":false},{"id":"seg-016","text":"遠送于南","isActive":false},{"id":"seg-017","text":"瞻望弗及","isActive":false},{"id":"seg-018","text":"實勞我心","isActive":false},{"id":"seg-019","text":"仲氏任只","isActive":false},{"id":"seg-020","text":"其心塞淵","isActive":false},{"id":"seg-021","text":"終温且惠","isActive":false},{"id":"seg-022","text":"淑慎其身","isActive":false},{"id":"seg-023","text":"先君之思","isActive":false},{"id":"seg-024","text":"以勗寡人","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"燕燕㊟衛莊姜送歸妾也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标题段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注","text":"方玉润在题注中径定《燕燕》为卫庄姜送归妾之诗，与《序》说一致。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"总评","targetNotes":"通篇总评。","sourceLabel":null,"sourceNotes":"对应 EPUB item 总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"总评","text":"总评中方玉润明言《序》说与《左传》可互相证成，被送者即戴嬀；他尤其称道庄姜对戴嬀情义之深，认为前三章送别已极凄楚，末章再历叙其贤，更见非寻常妇人离别之情所可比。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"眉评","targetNotes":"眉评摘录。","sourceLabel":null,"sourceNotes":"对应 EPUB item 眉评段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"眉评","text":"眉评指出前三章不过写送别情景，末章追念其贤，因而更觉难舍；又说“先君相勖，而竟不能长相保”，语意沉痛，不忍卒读。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"term","layerLabel":"字词注","targetText":"燕燕于飛差池其羽之子于歸頡之頏之佇立以泣其心塞淵以勗寡人","targetNotes":"集释条目汇总。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":"集释","text":"集释详考“燕燕”为鳦，“差池”为不齐貌，“歸”为大归之辞；又释“頡頏”为飞势高下，“佇立”为久立，“塞淵”言心诚实而深，“勗”为勉励。诸条都用来支撑庄姜送戴嬀且称美其德的解读。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"标韵","targetNotes":"各章韵脚与部类。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标韵段。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"标韵","sectionLabel":null,"text":"标韵以首章“羽”“雨”并“野”叶麌马通韵，次章“頏”“將”与“及”“泣”分阳、缉两收，三章“音”“南”“心”侵覃通韵，四章“淵”“身”“人”则真先通叶。章章换韵而情绪层递。","notes":null}]}]}}}
