{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/028-yan-yan/chengjunying-jiangjianyuan-zhuxi","dataHref":"/__data/shijing/annotation/028-yan-yan/chengjunying-jiangjianyuan-zhuxi/data.json","title":"詩經注析 · 燕燕 · 注释总览","description":"風 · 邶風 · 燕燕 · 汇集《詩經注析》关于《燕燕》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"028-yan-yan","materialId":"chengjunying-jiangjianyuan-zhuxi"},"href":"/shijing/annotation/028-yan-yan/chengjunying-jiangjianyuan-zhuxi","poem":{"id":"028-yan-yan","title":"燕燕","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","燕燕"],"segments":[{"id":"seg-001","text":"燕燕于飞","isActive":false},{"id":"seg-002","text":"差池其羽","isActive":false},{"id":"seg-003","text":"之子于归","isActive":false},{"id":"seg-004","text":"远送于野","isActive":false},{"id":"seg-005","text":"瞻望弗及","isActive":false},{"id":"seg-006","text":"泣涕如雨","isActive":false},{"id":"seg-007","text":"燕燕于飞","isActive":false},{"id":"seg-008","text":"颉之颃之","isActive":false},{"id":"seg-009","text":"之子于归","isActive":false},{"id":"seg-010","text":"远于将之","isActive":false},{"id":"seg-011","text":"瞻望弗及","isActive":false},{"id":"seg-012","text":"伫立以泣","isActive":false},{"id":"seg-013","text":"燕燕于飞","isActive":false},{"id":"seg-014","text":"下上其音","isActive":false},{"id":"seg-015","text":"之子于归","isActive":false},{"id":"seg-016","text":"远送于南","isActive":false},{"id":"seg-017","text":"瞻望弗及","isActive":false},{"id":"seg-018","text":"实劳我心","isActive":false},{"id":"seg-019","text":"仲氏任只","isActive":false},{"id":"seg-020","text":"其心塞渊","isActive":false},{"id":"seg-021","text":"终温且惠","isActive":false},{"id":"seg-022","text":"淑慎其身","isActive":false},{"id":"seg-023","text":"先君之思","isActive":false},{"id":"seg-024","text":"以勖寡人","isActive":false}]},"material":{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","authors":["程俊英","蔣見元"],"contributorLine":"现代 · 程俊英、蔣見元","era":"现代","publicationYear":1991,"carrier":"PDF"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"题解","targetNotes":"题解总说。","sourceLabel":"第 53 页","sourceNotes":"书内页 53《题解》段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"程、蒋把《燕燕》定为送人远嫁之诗，认为全篇核心在兄长送妹出嫁的惜别情境，不必拘泥于庄姜送归妾说。题解强调前三章极写送别时“瞻望弗及”的远望与泣立，四章再追述仲氏之贤，于惜别之外更添不忍遽舍之意，因此被后人称为送别诗之祖。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"燕燕于飞，差池其羽。之子于归，远送于野。瞻望弗及，泣涕如雨！","targetNotes":"首章。","sourceLabel":"第 54 页","sourceNotes":"书内页 54 首章及注释。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"首章用燕子翩飞、羽毛参差起兴，渲染送别情景。程、蒋认为“之子于归”明确是女子出嫁，“远送于野”与“泣涕如雨”则把送别者目送不及、涕泣交流的情态一下写出，奠定全篇凄恻基调。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"燕燕于飞，颉之颃之。之子于归，远于将之。瞻望弗及，伫立以泣。","targetNotes":"第二章。","sourceLabel":"第 54 页","sourceNotes":"书内页 54 第二章及注释。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"次章改写燕飞顿仰高低，与送者目送愈远相呼应；“远于将之”是送到更远处去，“伫立以泣”则由首章的“泣涕如雨”转成久久伫立，更见依恋难舍。程、蒋据此指出本篇善于以重复递进加深别情。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"燕燕于飞，下上其音。之子于归，远送于南。瞻望弗及，实劳我心。","targetNotes":"第三章。","sourceLabel":"第 54-55 页","sourceNotes":"书内页 54-55 第三章及注释。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"三章将燕声随飞上下的听觉描写加进来，使送别场面更为立体；“远送于南”表明送行渐行渐远，“实劳我心”则从外在景象收回到内心劳思。程、蒋认为前三章层层复沓，正是本诗传神处。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"仲氏任只，其心塞渊。终温且惠，淑慎其身。先君之思，以勖寡人。","targetNotes":"第四章。","sourceLabel":"第 55 页","sourceNotes":"书内页 55 第四章及注释。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"末章转而追叙仲氏德行，称其诚信深厚、温惠淑慎，并能承先君遗意以勉励寡人。程、蒋认为这使全诗从一般送别上升到对被送者人格的追怀，也因此别情更显沉痛。","notes":null}]}]}}}
