001","order":1,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"题解","targetNotes":"题解总说。","sourceLabel":"第 53 页","sourceNotes":"书内页 53《题解》段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解"}]},{"id":"0002","order":2,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"燕燕于飞，差池其羽。之子于归，远送于野。瞻望弗及，泣涕如雨！","targetNotes":"首章。","sourceLabel":"第 54 页","sourceNotes":"书内页 54 首章及注释。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null}]},{"id":"0003","order":3,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"燕燕于飞，颉之颃之。之子于归，远于将之。瞻望弗及，伫立以泣。","targetNotes":"第二章。","sourceLabel":"第 54 页","sourceNotes":"书内页 54 第二章及注释。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null}]},{"id":"0004","order":4,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"燕燕于飞，下上其音。之子于归，远送于南。瞻望弗及，实劳我心。","targetNotes":"第三章。","sourceLabel":"第 54-55 页","sourceNotes":"书内页 54-55 第三章及注释。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null}]},{"id":"0005","order":5,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"仲氏任只，其心塞渊。终温且惠，淑慎其身。先君之思，以勖寡人。","targetNotes":"第四章。","sourceLabel":"第 55 页","sourceNotes":"书内页 55 第四章及注释。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null}]}]}}}
