{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/028-yan-yan/chenhuan-chuanshu","dataHref":"/__data/shijing/annotation/028-yan-yan/chenhuan-chuanshu/data.json","title":"詩毛氏傳疏 · 燕燕 · 注释总览","description":"風 · 邶風 · 燕燕 · 汇集《詩毛氏傳疏》关于《燕燕》的 2 条注释，含 2 条注脚。"},"payload":{"detail":{"route":{"poemId":"028-yan-yan","materialId":"chenhuan-chuanshu"},"href":"/shijing/annotation/028-yan-yan/chenhuan-chuanshu","poem":{"id":"028-yan-yan","title":"燕燕","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","燕燕"],"segments":[{"id":"seg-001","text":"燕燕于飛","isActive":false},{"id":"seg-002","text":"差池其羽","isActive":false},{"id":"seg-003","text":"之子于歸","isActive":false},{"id":"seg-004","text":"遠送于野","isActive":false},{"id":"seg-005","text":"瞻望弗及","isActive":false},{"id":"seg-006","text":"泣涕如雨","isActive":false},{"id":"seg-007","text":"燕燕于飛","isActive":false},{"id":"seg-008","text":"頡之頏之","isActive":false},{"id":"seg-009","text":"之子于歸","isActive":false},{"id":"seg-010","text":"遠于將之","isActive":false},{"id":"seg-011","text":"瞻望弗及","isActive":false},{"id":"seg-012","text":"佇立以泣","isActive":false},{"id":"seg-013","text":"燕燕于飛","isActive":false},{"id":"seg-014","text":"上下其音","isActive":false},{"id":"seg-015","text":"之子于歸","isActive":false},{"id":"seg-016","text":"遠送于南","isActive":false},{"id":"seg-017","text":"瞻望弗及","isActive":false},{"id":"seg-018","text":"實勞我心","isActive":false},{"id":"seg-019","text":"仲氏任只","isActive":false},{"id":"seg-020","text":"其心塞淵","isActive":false},{"id":"seg-021","text":"終温且惠","isActive":false},{"id":"seg-022","text":"淑慎其身","isActive":false},{"id":"seg-023","text":"先君之思","isActive":false},{"id":"seg-024","text":"以勗寡人","isActive":false}]},"material":{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","authors":["陳奐"],"contributorLine":"清 · 陳奐","era":"清","publicationYear":1847,"carrier":"PDF"},"stats":{"annotationCount":2,"glossCount":2},"annotations":[{"id":"0001","order":1,"total":2,"layer":"preface","layerLabel":"篇序","targetText":"燕燕衛莊姜送歸妾也","targetNotes":"篇首小序。","sourceLabel":"第 55 页","sourceNotes":"书内页 55 篇首序文。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序","text":"序：《燕燕》，衛莊姜送歸妾也。","notes":null}]},{"id":"0002","order":2,"total":2,"layer":"span","layerLabel":"诗句片段","targetText":"燕燕于飛，差池其羽。之子于歸，遠送于野。瞻望弗及，泣涕如雨。燕燕于飛，頡之頏之。之子于歸，遠于將之。瞻望弗及，佇立以泣。燕燕于飛，上下其音。之子于歸，遠送于南。瞻望弗及，實勞我心。仲氏任只，其心塞淵。終温且惠，淑慎其身。先君之思，以勗寡人。","targetNotes":"通篇经传疏解。","sourceLabel":"第 55-56 页","sourceNotes":"据第 55-56 页《燕燕》经传疏。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"陈奂遵《序》旧说，以《燕燕》为庄姜送归戴嬀之作。其疏重在据《左传》及卫国世系说明被送者可为州吁之母戴嬀，前三章皆写送别不忍，末章历叙其温惠淑慎与相勗之德，由此见庄姜之贤与二人情义之深。","notes":null}]}]}}}
