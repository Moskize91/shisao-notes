{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/165-fa-mu/quwanli-quanshi","dataHref":"/__data/shijing/annotation/165-fa-mu/quwanli-quanshi/data.json","title":"詩經詮釋 · 伐木 · 注释总览","description":"雅 · 小雅 · 伐木 · 汇集《詩經詮釋》关于《伐木》的 1 条注释，含 1 条注脚。"},"payload":{"detail":{"route":{"poemId":"165-fa-mu","materialId":"quwanli-quanshi"},"href":"/shijing/annotation/165-fa-mu/quwanli-quanshi","poem":{"id":"165-fa-mu","title":"伐木","categoryId":"ya","subcategoryId":"xiaoya","path":["雅","小雅","伐木"],"segments":[{"id":"seg-001","text":"伐木丁丁","isActive":true},{"id":"seg-002","text":"鸟鸣嘤嘤","isActive":true},{"id":"seg-003","text":"出自幽谷","isActive":true},{"id":"seg-004","text":"迁于乔木","isActive":true},{"id":"seg-005","text":"嘤其鸣矣","isActive":true},{"id":"seg-006","text":"求其友声","isActive":true},{"id":"seg-007","text":"相彼鸟矣","isActive":true},{"id":"seg-008","text":"犹求友声","isActive":true},{"id":"seg-009","text":"矧伊人矣","isActive":true},{"id":"seg-010","text":"不求友生","isActive":true},{"id":"seg-011","text":"神之听之","isActive":true},{"id":"seg-012","text":"终和且平","isActive":true},{"id":"seg-013","text":"伐木许许","isActive":true},{"id":"seg-014","text":"酾酒有藇","isActive":true},{"id":"seg-015","text":"既有肥羜","isActive":true},{"id":"seg-016","text":"以速诸父","isActive":true},{"id":"seg-017","text":"宁适不来","isActive":true},{"id":"seg-018","text":"微我弗顾","isActive":true},{"id":"seg-019","text":"于粲洒扫","isActive":true},{"id":"seg-020","text":"陈馈八簋","isActive":true},{"id":"seg-021","text":"既有肥牡","isActive":true},{"id":"seg-022","text":"以速诸舅","isActive":true},{"id":"seg-023","text":"宁适不来","isActive":true},{"id":"seg-024","text":"微我有咎","isActive":true},{"id":"seg-025","text":"伐木于阪","isActive":true},{"id":"seg-026","text":"酾酒有衍","isActive":true},{"id":"seg-027","text":"笾豆有践","isActive":true},{"id":"seg-028","text":"兄弟无远","isActive":true},{"id":"seg-029","text":"民之失德","isActive":true},{"id":"seg-030","text":"乾餱以愆","isActive":true},{"id":"seg-031","text":"有酒湑我","isActive":true},{"id":"seg-032","text":"无酒酤我","isActive":true},{"id":"seg-033","text":"坎坎鼓我","isActive":true},{"id":"seg-034","text":"蹲蹲舞我","isActive":true},{"id":"seg-035","text":"迨我暇矣","isActive":true},{"id":"seg-036","text":"饮此湑矣","isActive":true}]},"material":{"id":"quwanli-quanshi","title":"詩經詮釋","authors":["屈萬里"],"contributorLine":"现代 · 屈萬里","era":"现代","publicationYear":1983,"carrier":"PDF"},"stats":{"annotationCount":1,"glossCount":1},"annotations":[{"id":"0001","order":1,"total":1,"layer":"span","layerLabel":"诗句片段","targetText":"伐木丁丁，鸟鸣嘤嘤。出自幽谷，迁于乔木。嘤其鸣矣，求其友声。相彼鸟矣，犹求友声。矧伊人矣，不求友生。神之听之，终和且平。伐木许许，酾酒有藇。既有肥羜，以速诸父。宁适不来，微我弗顾。于粲洒扫，陈馈八簋。既有肥牡，以速诸舅。宁适不来，微我有咎。伐木于阪，酾酒有衍。笾豆有践，兄弟无远。民之失德，乾餱以愆。有酒湑我，无酒酤我。坎坎鼓我，蹲蹲舞我。迨我暇矣，饮此湑矣。","targetNotes":"整篇正文。","sourceLabel":"第 237 页","sourceNotes":"第 237 页《伐木》正文。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"屈万里","sectionLabel":"正文"}]}]}}}
