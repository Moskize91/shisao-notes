{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/052-xiang-shu/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/052-xiang-shu/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 相鼠 · 注释总览","description":"風 · 鄘風 · 相鼠 · 汇集《诗经原始(上下)》关于《相鼠》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"052-xiang-shu","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/052-xiang-shu/fangyurun-yuanshi","poem":{"id":"052-xiang-shu","title":"相鼠","categoryId":"feng","subcategoryId":"yongfeng","path":["風","鄘風","相鼠"],"segments":[{"id":"seg-001","text":"相鼠有皮","isActive":false},{"id":"seg-002","text":"人而無儀","isActive":false},{"id":"seg-003","text":"人而無儀","isActive":false},{"id":"seg-004","text":"不死何爲","isActive":false},{"id":"seg-005","text":"相鼠有齒","isActive":false},{"id":"seg-006","text":"人而無止","isActive":false},{"id":"seg-007","text":"人而無止","isActive":false},{"id":"seg-008","text":"不死何俟","isActive":false},{"id":"seg-009","text":"相鼠有體","isActive":false},{"id":"seg-010","text":"人而無禮","isActive":false},{"id":"seg-011","text":"人而無禮","isActive":false},{"id":"seg-012","text":"胡不遄死","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"相鼠㊟刺無禮也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标题段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注","text":"方玉润题注径以“刺無禮”定篇，与《序》说相同。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"总评","targetNotes":"通篇总评。","sourceLabel":null,"sourceNotes":"对应 EPUB item 总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"总评","text":"方玉润总评谓：《序》以“刺無禮”解此篇，诸家大抵皆从。其不同意旧说把“鼠尚有皮，人而無儀”解成“人不若鼠”，认为这样反轻了礼仪；应理解为人若去礼义威仪而不自检，则虽具皮齿形体，不过与鼠辈同类，甚且不如禽兽之长，故诗人直斥其“不如速死”。末又存录“卫文公训诰臣民”一说，以备参考。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"集釋","targetNotes":"集释撮要。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"集释","text":"方玉润集释称鼠为蟲类中最可贱恶者，又引陆佃“礼鼠”、吕祖谦引韩愈“礼鼠拱而立”等说补充鼠之异闻。并释“止”为容止，“遄”为速，以申明三章皆由鼠之一体兴人之失礼。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"標韻","targetNotes":"三章韵脚撮述。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标韵段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":"标韵","text":"方玉润标韵云：首章“皮”四支，“儀、爲”并同本韵；次章“齒”四紙，“止、俟”并同本韵；末章“體”八薺与“禮”同部，“死”四紙通韵。","notes":null}]}]}}}
