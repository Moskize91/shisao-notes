ue},{"id":"seg-030","text":"抑鬯弓忌","isActive":true}]},"material":{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","authors":["程俊英","蔣見元"],"contributorLine":"现代 · 程俊英、蔣見元","era":"现代","publicationYear":1991,"carrier":"PDF"},"stats":{"annotationCount":1,"glossCount":1},"annotations":[{"id":"0001","order":1,"total":1,"layer":"span","layerLabel":"诗句片段","targetText":"叔于田，乘乘马。执辔如组，两骖如舞。叔在薮，火烈具举。袒裼暴虎，献于公所。将叔无狃，戒其伤女。叔于田，乘乘黄。两服上襄，两骖雁行。叔在薮，火烈具扬。叔善射忌，又良御忌。抑磬控忌，抑纵送忌。叔于田，乘乘鸨。两服齐首，两骖如手。叔在薮，火烈具阜。叔马慢忌，叔发罕忌。抑释掤忌，抑鬯弓忌。","targetNotes":"全篇题解与注释。","sourceLabel":"第 175-177 页","sourceNotes":"据 /private/tmp/078-cheng-hi-p200.png、/private/tmp/078-cheng-p201.png、/private/tmp/078-cheng-p202.png 定位。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英","sectionLabel":"题解"}]}]}}}
