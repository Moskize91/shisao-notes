{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/074-qiu-zhong/chenhuan-chuanshu","dataHref":"/__data/shijing/annotation/074-qiu-zhong/chenhuan-chuanshu/data.json","title":"詩毛氏傳疏 · 丘中 · 注释总览","description":"風 · 王風 · 丘中 · 汇集《詩毛氏傳疏》关于《丘中》的 1 条注释，含 1 条注脚。"},"payload":{"detail":{"route":{"poemId":"074-qiu-zhong","materialId":"chenhuan-chuanshu"},"href":"/shijing/annotation/074-qiu-zhong/chenhuan-chuanshu","poem":{"id":"074-qiu-zhong","title":"丘中","categoryId":"feng","subcategoryId":"wangfeng","path":["風","王風","丘中"],"segments":[{"id":"seg-001","text":"丘中有麻","isActive":true},{"id":"seg-002","text":"彼留子嗟","isActive":true},{"id":"seg-003","text":"彼留子嗟","isActive":true},{"id":"seg-004","text":"將其來施施","isActive":true},{"id":"seg-005","text":"丘中有麥","isActive":true},{"id":"seg-006","text":"彼留子國","isActive":true},{"id":"seg-007","text":"彼留子國","isActive":true},{"id":"seg-008","text":"將其來食","isActive":true},{"id":"seg-009","text":"丘中有李","isActive":true},{"id":"seg-010","text":"彼留之子","isActive":true},{"id":"seg-011","text":"彼留之子","isActive":true},{"id":"seg-012","text":"貽我佩玖","isActive":true}]},"material":{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","authors":["陳奐"],"contributorLine":"清 · 陳奐","era":"清","publicationYear":1847,"carrier":"PDF"},"stats":{"annotationCount":1,"glossCount":1},"annotations":[{"id":"0001","order":1,"total":1,"layer":"span","layerLabel":"诗句片段","targetText":"丘中有麻，彼留子嗟。彼留子嗟，將其來施施。丘中有麥，彼留子國。彼留子國，將其來食。丘中有李，彼留之子。彼留之子，貽我佩玖。","targetNotes":"全篇疏义。","sourceLabel":"第 76-77 页","sourceNotes":"据 /private/tmp/074-chenhuan/p86.png（书页 76，《丘中》正文与疏）及 /private/tmp/074-chenhuan/p87.png（书页 77，疏续）定位。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"陈奂疏《丘中》，仍以《序》“思贤”为旨，释“留”为大夫氏，“子嗟”“子國”为字，并据《左传》所见刘地以证“刘”“留”可通。又谓“施施”当见难进之意，南本单作“施”；并以“子國”为子嗟之父，“玖”为非玉之黑石，可佩以为饰。","notes":"依据 /private/tmp/074-chenhuan/p86.png、p87.png 及检得的《詩毛氏傳疏》相关 OCR 片段保守整理。"}]}]}}}
