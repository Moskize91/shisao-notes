{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/074-qiu-zhong/quwanli-quanshi","dataHref":"/__data/shijing/annotation/074-qiu-zhong/quwanli-quanshi/data.json","title":"詩經詮釋 · 丘中 · 注释总览","description":"風 · 王風 · 丘中 · 汇集《詩經詮釋》关于《丘中》的 1 条注释，含 1 条注脚。"},"payload":{"detail":{"route":{"poemId":"074-qiu-zhong","materialId":"quwanli-quanshi"},"href":"/shijing/annotation/074-qiu-zhong/quwanli-quanshi","poem":{"id":"074-qiu-zhong","title":"丘中","categoryId":"feng","subcategoryId":"wangfeng","path":["風","王風","丘中"],"segments":[{"id":"seg-001","text":"丘中有麻","isActive":true},{"id":"seg-002","text":"彼留子嗟","isActive":true},{"id":"seg-003","text":"彼留子嗟","isActive":true},{"id":"seg-004","text":"將其來施","isActive":true},{"id":"seg-005","text":"丘中有麥","isActive":true},{"id":"seg-006","text":"彼留子國","isActive":true},{"id":"seg-007","text":"彼留子國","isActive":true},{"id":"seg-008","text":"將其來食","isActive":true},{"id":"seg-009","text":"丘中有李","isActive":true},{"id":"seg-010","text":"彼留之子","isActive":true},{"id":"seg-011","text":"彼留之子","isActive":true},{"id":"seg-012","text":"貽我佩玖","isActive":true}]},"material":{"id":"quwanli-quanshi","title":"詩經詮釋","authors":["屈萬里"],"contributorLine":"现代 · 屈萬里","era":"现代","publicationYear":1983,"carrier":"PDF"},"stats":{"annotationCount":1,"glossCount":1},"annotations":[{"id":"0001","order":1,"total":1,"layer":"span","layerLabel":"诗句片段","targetText":"丘中有麻，彼留子嗟。彼留子嗟，將其來施。丘中有麥，彼留子國。彼留子國，將其來食。丘中有李，彼留之子。彼留之子，貽我佩玖。","targetNotes":"全篇注释。","sourceLabel":"第 89-90 页","sourceNotes":"据 /private/tmp/071-qu/p004.png（页眉 89，《丘中有麻》正文与注释起始）及 /private/tmp/071-qu/p005.png（页眉 90，注释续页）定位。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"屈万里","sectionLabel":"注释","text":"屈万里释《丘中有麻》为男女相悦之诗，并依次训“留”为氏，“子嗟”“子國”为字，“將”为语词，“施施”是徐行貌或单作“施”，“玖”为石之次玉，且指出诗中的“彼”是留氏之人。","notes":null}]}]}}}
