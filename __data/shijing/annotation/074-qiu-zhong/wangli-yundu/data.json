{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/074-qiu-zhong/wangli-yundu","dataHref":"/__data/shijing/annotation/074-qiu-zhong/wangli-yundu/data.json","title":"詩經韻讀 · 丘中 · 注释总览","description":"風 · 王風 · 丘中 · 汇集《詩經韻讀》关于《丘中》的 1 条注释，含 1 条注脚。"},"payload":{"detail":{"route":{"poemId":"074-qiu-zhong","materialId":"wangli-yundu"},"href":"/shijing/annotation/074-qiu-zhong/wangli-yundu","poem":{"id":"074-qiu-zhong","title":"丘中","categoryId":"feng","subcategoryId":"wangfeng","path":["風","王風","丘中"],"segments":[{"id":"seg-001","text":"丘中有麻","isActive":true},{"id":"seg-002","text":"彼留子嗟","isActive":true},{"id":"seg-003","text":"彼留子嗟","isActive":true},{"id":"seg-004","text":"将其来施","isActive":true},{"id":"seg-005","text":"丘中有麦","isActive":true},{"id":"seg-006","text":"彼留子国","isActive":true},{"id":"seg-007","text":"彼留子国","isActive":true},{"id":"seg-008","text":"将其来食","isActive":true},{"id":"seg-009","text":"丘中有李","isActive":true},{"id":"seg-010","text":"彼留之子","isActive":true},{"id":"seg-011","text":"彼留之子","isActive":true},{"id":"seg-012","text":"贻我佩玖","isActive":true}]},"material":{"id":"wangli-yundu","title":"詩經韻讀","authors":["王力"],"contributorLine":"现代 · 王力","era":"现代","publicationYear":1980,"carrier":"PDF"},"stats":{"annotationCount":1,"glossCount":1},"annotations":[{"id":"0001","order":1,"total":1,"layer":"span","layerLabel":"诗句片段","targetText":"丘中有麻，彼留子嗟。彼留子嗟，将其来施。丘中有麦，彼留子国。彼留子国，将其来食。丘中有李，彼留之子。彼留之子，贻我佩玖。","targetNotes":"全篇韵读。","sourceLabel":"第 181 页","sourceNotes":"据 /private/tmp/071-wangli/p003.png（页码 181，《丘中有麻》全诗）定位；/private/tmp/071-wangli/p004.png 已转入郑风《缁衣》。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"王力","sectionLabel":"韵读","text":"王力录《丘中有麻》三章，首章“麻、嗟、施”入歌部，次章“麦、国、食”入职部，末章“李、子、玖”入之部。三章皆以丘中之物起兴，而中间两句重复其人名或称谓，形成民歌式回环。","notes":null}]}]}}}
