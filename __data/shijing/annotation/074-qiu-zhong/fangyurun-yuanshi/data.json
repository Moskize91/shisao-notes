{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/074-qiu-zhong/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/074-qiu-zhong/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 丘中 · 注释总览","description":"風 · 王風 · 丘中 · 汇集《诗经原始(上下)》关于《丘中》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"074-qiu-zhong","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/074-qiu-zhong/fangyurun-yuanshi","poem":{"id":"074-qiu-zhong","title":"丘中","categoryId":"feng","subcategoryId":"wangfeng","path":["風","王風","丘中"],"segments":[{"id":"seg-001","text":"丘中有麻","isActive":false},{"id":"seg-002","text":"彼留子嗟","isActive":false},{"id":"seg-003","text":"彼留子嗟","isActive":false},{"id":"seg-004","text":"將其來施施","isActive":false},{"id":"seg-005","text":"丘中有麥","isActive":false},{"id":"seg-006","text":"彼留子國","isActive":false},{"id":"seg-007","text":"彼留子國","isActive":false},{"id":"seg-008","text":"將其來食","isActive":false},{"id":"seg-009","text":"丘中有李","isActive":false},{"id":"seg-010","text":"彼留之子","isActive":false},{"id":"seg-011","text":"彼留之子","isActive":false},{"id":"seg-012","text":"貽我佩玖","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"丘中㊟招賢偕隱也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 91 标题段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注","text":"方玉润题注直断《丘中》为招贤偕隐之诗，先把全篇安置在乱世之中相招退处丘园的语境内。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"总评","targetNotes":"通篇总评。","sourceLabel":null,"sourceNotes":"对应 EPUB item 91 总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"总评","text":"方玉润总评力辨《小序》“思賢”与《集传》“婦人望其所與私者”两说，认为前者失之未明，后者更近逆理。其主张“子嗟”“子國”并非父子二人，而是虚拟招贤之辞：丘中有麻可绩而衣，有麦可种而食，有李可相馈遗，正是互相招集、退处丘园以自乐的意思。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"term","layerLabel":"字词注","targetText":"丘中有麻將其來施施","targetNotes":"集释撮要。","sourceLabel":null,"sourceNotes":"对应 EPUB item 91 集释段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"集释","text":"方玉润集释据《集传》训“麻”为子可食、皮可绩布之谷，又引吕氏说“施施”为喜悦徐行之意。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"標韻","targetNotes":"三章韵脚撮述。","sourceLabel":null,"sourceNotes":"对应 EPUB item 91 标韵段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":"标韵","text":"方玉润标出《丘中》三章用韵：首章“麻、嗟、施”叶韵，次章“麥、國、食”通韵，末章“李、子、玖”叶韵。三章皆以丘中之物起兴，而所望之人则由“子嗟”“子國”转到“之子”。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"以上王詩，凡十篇。","targetNotes":"卷末王风总论。","sourceLabel":null,"sourceNotes":"对应 EPUB item 91 zong 段。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"方玉润","sectionLabel":"王风总论","text":"方玉润以《丘中》后的总论收束王风十篇，谓其皆乱离后作，音多怨怒哀思，见王纲不振、贤人退隐、小人得志之势；并以杜甫乱后诸篇作后世同调之证。","notes":null}]}]}}}
