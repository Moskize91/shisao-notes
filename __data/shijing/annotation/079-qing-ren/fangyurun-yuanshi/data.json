{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/079-qing-ren/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/079-qing-ren/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 清人 · 注释总览","description":"風 · 鄭風 · 清人 · 汇集《诗经原始(上下)》关于《清人》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"079-qing-ren","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/079-qing-ren/fangyurun-yuanshi","poem":{"id":"079-qing-ren","title":"清人","categoryId":"feng","subcategoryId":"zhengfeng","path":["風","鄭風","清人"],"segments":[{"id":"seg-001","text":"清人在彭","isActive":false},{"id":"seg-002","text":"駟介旁旁","isActive":false},{"id":"seg-003","text":"二矛重英","isActive":false},{"id":"seg-004","text":"河上乎翺翔","isActive":false},{"id":"seg-005","text":"清人在消","isActive":false},{"id":"seg-006","text":"駟介麃麃","isActive":false},{"id":"seg-007","text":"二矛重喬","isActive":false},{"id":"seg-008","text":"河上乎逍遥","isActive":false},{"id":"seg-009","text":"清人在軸","isActive":false},{"id":"seg-010","text":"駟介陶陶","isActive":false},{"id":"seg-011","text":"左旋右抽","isActive":false},{"id":"seg-012","text":"中軍作好","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"刺鄭文公棄其師也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 篇首题注。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注"}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"右《清人》三章，章四句。《序》本《左傳》，高克棄師奔陳，鄭人爲賦此詩。事有明文，固勿庸議。即彭、消、軸，或以爲地名，或以爲非地名，皆不可考。惟鄭文公惡高克而使之擁兵在外，此召亂之本也。幸而師散將逃，國得無恙。使其反戈相向，何以禦之？由斯以觀，高克亦無能輩耳，何以見惡於文公耶？詩曰「翺翔」，曰「逍遥」，曰「左旋右抽，中軍作好」，所謂霸上諸軍直同兒戲，即使作亂亦易制服。詩人固早有以知其必不然也，若文公者則不能無所議焉。故刺之。","targetNotes":"总评原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"总评"}]},{"id":"0003","order":3,"total":4,"layer":"term","layerLabel":"字词注","targetText":"清邑名。駟介四馬而被甲也。旁旁馳驅不息之貌。二矛酋矛、夷矛也。酋矛長二丈，夷矛長二丈四尺，並建於車上。英以朱羽爲矛飾，重疊而見。翺翔遊戲之貌。麃麃武貌。喬矛之上勾曰喬。陶陶樂貌。左旋右抽〔《集傳》〕左，謂御在將軍之左，執轡而御馬者也。旋，還車也。右，謂勇力之士在將軍之右，執兵以擊刺者也。抽，拔刃也。中軍〔《集傳》〕中軍，謂將在鼓下，居車之中，即高克也。好容好也。","targetNotes":"集释原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"集释"}]},{"id":"0004","order":4,"total":4,"layer":"term","layerLabel":"字词注","targetText":"彭七陽。旁同。英八庚。翔七陽。通韻。消二蕭。麃、喬、遥並同。本韻。軸一屋，叶音胄。陶四豪，叶徒侯反。抽十一尤，叶輟救反。好二十號。叶韻。","targetNotes":"标韵原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标韵段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":"标韵"}]}]}}}
