{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/155-chi-xiao/chengjunying-jiangjianyuan-zhuxi","dataHref":"/__data/shijing/annotation/155-chi-xiao/chengjunying-jiangjianyuan-zhuxi/data.json","title":"詩經注析 · 鴟鴞 · 注释总览","description":"風 · 豳風 · 鴟鴞 · 汇集《詩經注析》关于《鴟鴞》的 1 条注释，含 1 条注脚。"},"payload":{"detail":{"route":{"poemId":"155-chi-xiao","materialId":"chengjunying-jiangjianyuan-zhuxi"},"href":"/shijing/annotation/155-chi-xiao/chengjunying-jiangjianyuan-zhuxi","poem":{"id":"155-chi-xiao","title":"鴟鴞","categoryId":"feng","subcategoryId":"binfeng","path":["風","豳風","鴟鴞"],"segments":[{"id":"seg-001","text":"鴟鴞鴟鴞","isActive":true},{"id":"seg-002","text":"既取我子","isActive":true},{"id":"seg-003","text":"無毁我室","isActive":true},{"id":"seg-004","text":"恩斯勤斯","isActive":true},{"id":"seg-005","text":"鬻子之閔斯","isActive":true},{"id":"seg-006","text":"迨天之未陰雨","isActive":true},{"id":"seg-007","text":"徹彼桑土","isActive":true},{"id":"seg-008","text":"綢繆牖戶","isActive":true},{"id":"seg-009","text":"今女下民","isActive":true},{"id":"seg-010","text":"或敢侮予","isActive":true},{"id":"seg-011","text":"予手拮据","isActive":true},{"id":"seg-012","text":"予所捋荼","isActive":true},{"id":"seg-013","text":"予所蓄租","isActive":true},{"id":"seg-014","text":"予口卒瘏","isActive":true},{"id":"seg-015","text":"曰予未有室家","isActive":true},{"id":"seg-016","text":"予羽譙譙","isActive":true},{"id":"seg-017","text":"予尾翛翛","isActive":true},{"id":"seg-018","text":"予室翹翹","isActive":true},{"id":"seg-019","text":"風雨所漂搖","isActive":true},{"id":"seg-020","text":"予維音哓哓","isActive":true}]},"material":{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","authors":["程俊英","蔣見元"],"contributorLine":"现代 · 程俊英、蔣見元","era":"现代","publicationYear":1991,"carrier":"PDF"},"stats":{"annotationCount":1,"glossCount":1},"annotations":[{"id":"0001","order":1,"total":1,"layer":"span","layerLabel":"诗句片段","targetText":"鴟鴞鴟鴞，既取我子，無毁我室。恩斯勤斯，鬻子之閔斯。迨天之未陰雨，徹彼桑土，綢繆牖戶。今女下民，或敢侮予。予手拮据，予所捋荼。予所蓄租，予口卒瘏。曰予未有室家。予羽譙譙，予尾翛翛。予室翹翹，風雨所漂搖。予維音哓哓。","targetNotes":"整篇