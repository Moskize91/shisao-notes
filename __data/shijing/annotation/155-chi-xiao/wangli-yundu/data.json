{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/155-chi-xiao/wangli-yundu","dataHref":"/__data/shijing/annotation/155-chi-xiao/wangli-yundu/data.json","title":"詩經韻讀 · 鴟鴞 · 注释总览","description":"風 · 豳風 · 鴟鴞 · 汇集《詩經韻讀》关于《鴟鴞》的 1 条注释，含 1 条注脚。"},"payload":{"detail":{"route":{"poemId":"155-chi-xiao","materialId":"wangli-yundu"},"href":"/shijing/annotation/155-chi-xiao/wangli-yundu","poem":{"id":"155-chi-xiao","title":"鴟鴞","categoryId":"feng","subcategoryId":"binfeng","path":["風","豳風","鴟鴞"],"segments":[{"id":"seg-001","text":"鸱鸮鸱鸮","isActive":true},{"id":"seg-002","text":"既取我子","isActive":true},{"id":"seg-003","text":"无毁我室","isActive":true},{"id":"seg-004","text":"恩斯勤斯","isActive":true},{"id":"seg-005","text":"鬻子之闵斯","isActive":true},{"id":"seg-006","text":"迨天之未阴雨","isActive":true},{"id":"seg-007","text":"彻彼桑土","isActive":true},{"id":"seg-008","text":"绸缪牖户","isActive":true},{"id":"seg-009","text":"今女下民","isActive":true},{"id":"seg-010","text":"或敢侮予","isActive":true},{"id":"seg-011","text":"予手拮据","isActive":true},{"id":"seg-012","text":"予所捋荼","isActive":true},{"id":"seg-013","text":"予所蓄租","isActive":true},{"id":"seg-014","text":"予口卒瘏","isActive":true},{"id":"seg-015","text":"曰予未有室家","isActive":true},{"id":"seg-016","text":"予羽谯谯","isActive":true},{"id":"seg-017","text":"予尾修修","isActive":true},{"id":"seg-018","text":"予室翘翘","isActive":true},{"id":"seg-019","text":"风雨所漂摇","isActive":true},{"id":"seg-020","text":"予维音晓哓","isActive":true}]},"material":{"id":"wangli-yundu","title":"詩經韻讀","authors":["王力"],"contributorLine":"现代 · 王力","era":"现代","publicationYear":1980,"carrier":"PDF"},"stats":{"annotationCount":1,"glossCount":1},"annotations":[{"id":"0001","order":1,"total":1,"layer":"span","layerLabel":"诗句片段","targetText":"鸱鸮鸱鸮，既取我子，无毁我室。恩斯勤斯，鬻子之闵斯。迨天之未阴雨，彻彼桑土，绸缪牖户。今女下民，或敢侮予。予手拮据，予所捋荼，予所蓄租，予口卒瘏。曰予未有室家。予羽谯谯，予尾修修。予室翘翘，风雨所漂摇。予维音晓哓。","targetNotes":"正文整篇。","sourceLabel":"第 237-238 页","sourceNotes":"第 237-238 页《鴟鴞》整篇韵读。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"王力","sectionLabel":"韵读"}]}]}}}
