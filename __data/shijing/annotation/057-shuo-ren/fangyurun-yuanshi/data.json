{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/057-shuo-ren/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/057-shuo-ren/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 碩人 · 注释总览","description":"風 · 衛風 · 碩人 · 汇集《诗经原始(上下)》关于《碩人》的 1 条注释，含 1 条注脚。"},"payload":{"detail":{"route":{"poemId":"057-shuo-ren","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/057-shuo-ren/fangyurun-yuanshi","poem":{"id":"057-shuo-ren","title":"碩人","categoryId":"feng","subcategoryId":"weifeng","path":["風","衛風","碩人"],"segments":[{"id":"seg-001","text":"碩人其頎","isActive":true},{"id":"seg-002","text":"衣錦褧衣","isActive":true},{"id":"seg-003","text":"齊侯之子","isActive":true},{"id":"seg-004","text":"衛侯之妻","isActive":true},{"id":"seg-005","text":"東宮之妹","isActive":true},{"id":"seg-006","text":"邢侯之姨","isActive":true},{"id":"seg-007","text":"譚公維私","isActive":true},{"id":"seg-008","text":"手如柔荑","isActive":true},{"id":"seg-009","text":"膚如凝脂","isActive":true},{"id":"seg-010","text":"領如蝤蠐","isActive":true},{"id":"seg-011","text":"齒如瓠犀","isActive":true},{"id":"seg-012","text":"螓首蛾眉","isActive":true},{"id":"seg-013","text":"巧笑倩兮","isActive":true},{"id":"seg-014","text":"美目盼兮","isActive":true},{"id":"seg-015","text":"碩人敖敖","isActive":true},{"id":"seg-016","text":"説于農郊","isActive":true},{"id":"seg-017","text":"四牡有驕","isActive":true},{"id":"seg-018","text":"朱幩鑣鑣","isActive":true},{"id":"seg-019","text":"翟茀以朝","isActive":true},{"id":"seg-020","text":"大夫夙退","isActive":true},{"id":"seg-021","text":"無使君勞","isActive":true},{"id":"seg-022","text":"河水洋洋","isActive":true},{"id":"seg-023","text":"北流活活","isActive":true},{"id":"seg-024","text":"施罛濊濊","isActive":true},{"id":"seg-025","text":"鱣鮪發發","isActive":true},{"id":"seg-026","text":"葭菼揭揭","isActive":true},{"id":"seg-027","text":"庶姜孽孽","isActive":true},{"id":"seg-028","text":"庶士有朅","isActive":true}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":1,"glossCount":1},"annotations":[{"id":"0001","order":1,"total":1,"layer":"span","layerLabel":"诗句片段","targetText":"碩人其頎，衣錦褧衣。齊侯之子，衛侯之妻。東宮之妹，邢侯之姨，譚公維私。手如柔荑，膚如凝脂，領如蝤蠐，齒如瓠犀，螓首蛾眉。巧笑倩兮，美目盼兮。碩人敖敖，説于農郊。四牡有驕，朱幩鑣鑣，翟茀以朝。大夫夙退，無使君勞。河水洋洋，北流活活。施罛濊濊，鱣鮪發發，葭菼揭揭。庶姜孽孽，庶士有朅。","targetNotes":"全篇与总评。","sourceLabel":null,"sourceNotes":"对应 EPUB《詩經原始》卷四《碩人》正文及总评。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"总评","text":"方玉潤明言《碩人》是衛人頌莊姜美而賢，非閔之。其以“碩人”為有德之尊稱，又謂詩雖鋪寫“美目盼兮”“説于農郊”“庶姜孽孽”等富貴儀盛，正所以旁寫其賢。","notes":null}]}]}}}
