r":"PDF"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"硕人其颀，衣锦褧衣，齐侯之子，卫侯之妻，东宫之妹，邢侯之姨，谭公维私。","targetNotes":"第一章。","sourceLabel":"第 170 页局部","sourceNotes":"第 170 页《硕人》第一章。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"王力","sectionLabel":"韵读"}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"手如柔荑，肤如凝脂，领如蝤蛴，齿如瓠犀，螓首蛾眉，巧笑倩兮，美目盼兮。","targetNotes":"第二章。","sourceLabel":"第 170 页局部","sourceNotes":"第 170 页《硕人》第二章。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"王力","sectionLabel":"韵读"}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"硕人敖敖，说于农郊，四牡有骄，朱帻镳镳，翟茀以朝，大夫夙退，无使君劳。","targetNotes":"第三章。","sourceLabel":"第 170-171 页","sourceNotes":"第 170-171 页《硕人》第三章，末句续至第 171 页。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"王力","sectionLabel":"韵读"}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"河水洋洋，北流活活，施罛濊濊，鳣鲔发发，葭菼揭揭，庶姜孽孽，庶士有朅。","targetNotes":"第四章。","sourceLabel":"第 171 页局部","sourceNotes":"第 171 页《硕人》第四章；下接《氓》。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"王力","sectionLabel":"韵读"}]}]}}}
