{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/006-tao-yao/maoheng-zhushu-kr1c0004","dataHref":"/__data/shijing/annotation/006-tao-yao/maoheng-zhushu-kr1c0004/data.json","title":"毛詩注疏 · 桃夭 · 注释总览","description":"風 · 周南 · 桃夭 · 汇集《毛詩注疏》关于《桃夭》的 5 条注释，含 9 条注脚。"},"payload":{"detail":{"route":{"poemId":"006-tao-yao","materialId":"maoheng-zhushu-kr1c0004"},"href":"/shijing/annotation/006-tao-yao/maoheng-zhushu-kr1c0004","poem":{"id":"006-tao-yao","title":"桃夭","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","桃夭"],"segments":[{"id":"seg-001","text":"桃之夭夭","isActive":false},{"id":"seg-002","text":"灼灼其華","isActive":false},{"id":"seg-003","text":"之子于歸","isActive":false},{"id":"seg-004","text":"宜其室家","isActive":false},{"id":"seg-005","text":"桃之夭夭","isActive":false},{"id":"seg-006","text":"有蕡其實","isActive":false},{"id":"seg-007","text":"之子于歸","isActive":false},{"id":"seg-008","text":"宜其家室","isActive":false},{"id":"seg-009","text":"桃之夭夭","isActive":false},{"id":"seg-010","text":"其葉蓁蓁","isActive":false},{"id":"seg-011","text":"之子于歸","isActive":false},{"id":"seg-012","text":"宜其家人","isActive":false}]},"material":{"id":"maoheng-zhushu-kr1c0004","title":"毛詩注疏","authors":["毛亨","鄭氏","孔穎達"],"contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","era":"漢唐","publicationYear":653,"carrier":"TXT"},"stats":{"annotationCount":5,"glossCount":9},"annotations":[{"id":"0001","order":1,"total":5,"layer":"preface","layerLabel":"篇序","targetText":"序《桃夭》","targetNotes":"篇首小序与孔疏提要。","sourceLabel":null,"sourceNotes":"对应 txt 930-959 行。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序","text":"序：桃夭，后妃之所致也。不妬忌則男女以正，昬姻以時，國無鰥民也。","notes":null},{"key":"0001-2","attributionLabel":"孔疏","sectionLabel":null,"text":"疏：此篇承《螽斯》而申后妃不妬忌所致，並以三章上二句說男女得其正年，下二句說昬姻得其時，又以此推見國中無失時鰥民。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"桃之夭夭，灼灼其華。之子于歸，宜其室家。","targetNotes":"首章。","sourceLabel":null,"sourceNotes":"对应 txt 960-971 行。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：興也。桃有華之盛者，夭夭，其少壯也。灼灼，華之盛也。之子，嫁子也。于，往也。宜，以有室家無踰時者。","notes":null},{"key":"0002-2","attributionLabel":"郑笺","sectionLabel":null,"text":"箋云：興者，喻時婦人皆得以年盛時行也。宜者，謂男女年時俱當。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"桃之夭夭，有蕡其實。之子于歸，宜其家室。","targetNotes":"第二章。","sourceLabel":null,"sourceNotes":"对应 txt 972-973 行。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：蕡，實貌。非但有華色，又有婦德。家室，猶室家也。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"桃之夭夭，其葉蓁蓁。之子于歸，宜其家人。","targetNotes":"第三章。","sourceLabel":null,"sourceNotes":"对应 txt 974-978 行。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：蓁蓁，至盛貌。有色有德，形體至盛也。一家之人盡以為宜。","notes":null},{"key":"0004-2","attributionLabel":"郑笺","sectionLabel":null,"text":"箋云：家人，猶室家也。","notes":null},{"key":"0004-3","attributionLabel":"孔疏","sectionLabel":null,"text":"疏：此章變文作“家人”，仍據夫婦室家立義，不當橫解為一家諸人。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"桃夭三章章四句","targetNotes":"章句总说。","sourceLabel":null,"sourceNotes":"对应 txt 980 行。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"章句","sectionLabel":null,"text":"桃夭三章章四句。","notes":null}]}]}}}
