{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/006-tao-yao/chenhuan-chuanshu","dataHref":"/__data/shijing/annotation/006-tao-yao/chenhuan-chuanshu/data.json","title":"詩毛氏傳疏 · 桃夭 · 注释总览","description":"風 · 周南 · 桃夭 · 汇集《詩毛氏傳疏》关于《桃夭》的 4 条 annotation，含 4 条 gloss。"},"payload":{"detail":{"route":{"poemId":"006-tao-yao","materialId":"chenhuan-chuanshu"},"href":"/shijing/annotation/006-tao-yao/chenhuan-chuanshu","poem":{"id":"006-tao-yao","title":"桃夭","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","桃夭"],"segments":[{"id":"seg-001","text":"桃之夭夭","isActive":false},{"id":"seg-002","text":"灼灼其華","isActive":false},{"id":"seg-003","text":"之子于歸","isActive":false},{"id":"seg-004","text":"宜其室家","isActive":false},{"id":"seg-005","text":"桃之夭夭","isActive":false},{"id":"seg-006","text":"有蕡其實","isActive":false},{"id":"seg-007","text":"之子于歸","isActive":false},{"id":"seg-008","text":"宜其家室","isActive":false},{"id":"seg-009","text":"桃之夭夭","isActive":false},{"id":"seg-010","text":"其葉蓁蓁","isActive":false},{"id":"seg-011","text":"之子于歸","isActive":false},{"id":"seg-012","text":"宜其家人","isActive":false}]},"material":{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","authors":["陳奐"],"contributorLine":"清 · 陳奐","era":"清","publicationYear":1847,"carrier":"PDF"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"《桃夭》后妃所致与婚姻以时之义","targetNotes":"篇首总义与陈奂疏义。","sourceLabel":"第 34 页","sourceNotes":"PDF 34 页篇题后总说。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"陈奂承《序》义，以《桃夭》为后妃不妒忌、婚姻以时之诗，认为其旨在见文王之化自家及国，女子得年盛而归，故能宜其室家。","notes":"据 PDF 34 页疏义提要。"}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"桃之夭夭灼灼其華之子于歸宜其室家","targetNotes":"首章传疏。","sourceLabel":"第 34-35 页","sourceNotes":"PDF 34-35 页首章传疏。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"陈奂于首章承毛、郑旧解，释“夭夭”为少盛，“灼灼”为华盛；“之子”即嫁子，“于归”是妇人之嫁辞；“宜其室家”则见婚嫁得时，女子归后能安其夫妇之居。","notes":"据 PDF 34-35 页首章疏义提要。"}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"桃之夭夭有蕡其實之子于歸宜其家室","targetNotes":"第二章传疏。","sourceLabel":"第 35-36 页","sourceNotes":"PDF 35-36 页第二章疏义。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"陈奂释“蕡”为实盛，不徒有花色，兼见结实繁多，故可以比女子既有容德，亦将宜于生育；“家室”则仍与“室家”同义，皆是祝其善处夫妇与家内。","notes":"据 PDF 35-36 页第二章疏义提要。"}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"桃之夭夭其葉蓁蓁之子于歸宜其家人","targetNotes":"第三章传疏。","sourceLabel":"第 36-37 页","sourceNotes":"PDF 36-37 页第三章与尾疏。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"陈奂以“蓁蓁”为叶盛之貌，认为三章由花至实至叶，层层递进，以见婚姻得时而妇德日备；“家人”则为一家之人，末章所祝较前二章更广。","notes":"据 PDF 36-37 页第三章与尾疏提要。"}]}]}}}
