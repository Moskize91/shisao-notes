{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/006-tao-yao/zhuxi-shijichuan-kr1c0009","dataHref":"/__data/shijing/annotation/006-tao-yao/zhuxi-shijichuan-kr1c0009/data.json","title":"詩集傳 · 桃夭 · 注释总览","description":"風 · 周南 · 桃夭 · 汇集《詩集傳》关于《桃夭》的 4 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"006-tao-yao","materialId":"zhuxi-shijichuan-kr1c0009"},"href":"/shijing/annotation/006-tao-yao/zhuxi-shijichuan-kr1c0009","poem":{"id":"006-tao-yao","title":"桃夭","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","桃夭"],"segments":[{"id":"seg-001","text":"桃之夭夭","isActive":true},{"id":"seg-002","text":"灼灼其華","isActive":true},{"id":"seg-003","text":"之子于歸","isActive":true},{"id":"seg-004","text":"宜其室家","isActive":true},{"id":"seg-005","text":"桃之夭夭","isActive":false},{"id":"seg-006","text":"有蕡其實","isActive":false},{"id":"seg-007","text":"之子于歸","isActive":false},{"id":"seg-008","text":"宜其家室","isActive":false},{"id":"seg-009","text":"桃之夭夭","isActive":false},{"id":"seg-010","text":"其葉蓁蓁","isActive":false},{"id":"seg-011","text":"之子于歸","isActive":false},{"id":"seg-012","text":"宜其家人","isActive":false}]},"material":{"id":"zhuxi-shijichuan-kr1c0009","title":"詩集傳","authors":["朱熹"],"contributorLine":"宋 · 朱熹","era":"宋","publicationYear":1186,"carrier":"TXT"},"stats":{"annotationCount":4,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"桃之夭夭，灼灼其華。之子于歸，宜其室家。","targetNotes":"首章并章句说明。","sourceLabel":null,"sourceNotes":"本地 kanseki 文本约在 149-152 行；后经维基文库《诗经集传/卷之一》215 行核定。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"朱熹","sectionLabel":"传","text":"興也。桃，木名。華紅實可食。夭夭，少好之貌。灼灼，華之盛也。木少則華盛。之子，是子也。此指嫁者而言也。婦人謂嫁曰歸。周禮仲春令會男女。然則桃之有華，正婚姻之時也。宜者，和順之意。室，謂夫婦所居。家，謂一門之内。","notes":null},{"key":"0001-2","attributionLabel":"朱熹","sectionLabel":"传","text":"文王之化，自家而國，男女以正，婚姻以時。故詩人因所見，以起興而歎其女子之賢。知其必有以宜其室家也。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"桃之夭夭，有蕡其實。之子于歸，宜其家室。","targetNotes":"第二章并章句说明。","sourceLabel":null,"sourceNotes":"维基文库《诗经集传/卷之一》217 行。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"朱熹","sectionLabel":"传","text":"興也。蕡，實之盛也。家室，猶室家也。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"桃之夭夭，其葉蓁蓁。之子于歸，宜其家人。","targetNotes":"第三章并章句说明。","sourceLabel":null,"sourceNotes":"维基文库《诗经集传/卷之一》219 行。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"朱熹","sectionLabel":"传","text":"興也。蓁蓁，葉之盛也。家人，一家之人也。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"桃夭三章章四句","targetNotes":"章句总说。","sourceLabel":null,"sourceNotes":"维基文库《诗经集传/卷之一》221 行。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"朱熹","sectionLabel":"总评","text":"桃夭三章章四句。","notes":null}]}]}}}
