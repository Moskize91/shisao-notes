{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/006-tao-yao/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/006-tao-yao/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 桃夭 · 注释总览","description":"風 · 周南 · 桃夭 · 汇集《诗经原始(上下)》关于《桃夭》的 8 条 annotation，含 8 条 gloss。"},"payload":{"detail":{"route":{"poemId":"006-tao-yao","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/006-tao-yao/fangyurun-yuanshi","poem":{"id":"006-tao-yao","title":"桃夭","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","桃夭"],"segments":[{"id":"seg-001","text":"桃之夭夭","isActive":false},{"id":"seg-002","text":"灼灼其華","isActive":false},{"id":"seg-003","text":"之子于歸","isActive":false},{"id":"seg-004","text":"宜其室家","isActive":false},{"id":"seg-005","text":"桃之夭夭","isActive":false},{"id":"seg-006","text":"有蕡其實","isActive":false},{"id":"seg-007","text":"之子于歸","isActive":false},{"id":"seg-008","text":"宜其家室","isActive":false},{"id":"seg-009","text":"桃之夭夭","isActive":false},{"id":"seg-010","text":"其葉蓁蓁","isActive":false},{"id":"seg-011","text":"之子于歸","isActive":false},{"id":"seg-012","text":"宜其家人","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":8,"glossCount":8},"annotations":[{"id":"0001","order":1,"total":8,"layer":"global","layerLabel":"全篇总说","targetText":"题注","targetNotes":"对应 item-0015 题注。","sourceLabel":null,"sourceNotes":"item-0015.txt 第 3 行。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注","text":"题注为“喜之子能宜室家也”，先点出这是一首祝贺新嫁女子善能宜家之诗。","notes":null}]},{"id":"0002","order":2,"total":8,"layer":"span","layerLabel":"诗句片段","targetText":"桃之夭夭，灼灼其華。之子于歸，宜其室家。","targetNotes":"第一章。","sourceLabel":null,"sourceNotes":"item-0015.txt 第 5 行。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":null,"text":"首章谓“興中有比”，以桃花灼灼比新嫁女子芳龄盛美；又注“之子于歸，實賦”“宜其室家，虚想”，点出由实写婚嫁转入对婚后宜家的祝愿。","notes":null}]},{"id":"0003","order":3,"total":8,"layer":"span","layerLabel":"诗句片段","targetText":"桃之夭夭，有蕡其實。之子于歸，宜其家室。","targetNotes":"第二章。","sourceLabel":null,"sourceNotes":"item-0015.txt 第 6 行。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":null,"text":"次章以“有蕡其實”承上，方玉润注“又變”，由花转实，既见诗意递进，也暗寓妇人婚后有子。","notes":null}]},{"id":"0004","order":4,"total":8,"layer":"span","layerLabel":"诗句片段","targetText":"桃之夭夭，其葉蓁蓁。之子于歸，宜其家人。","targetNotes":"第三章。","sourceLabel":null,"sourceNotes":"item-0015.txt 第 7 行。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":null,"text":"三章以“其葉蓁蓁”收束，仍写桃树盛美，转祝女子于归后能宜其家人。","notes":null}]},{"id":"0005","order":5,"total":8,"layer":"global","layerLabel":"全篇总说","targetText":"总评","targetNotes":"对应 item-0015 总评。","sourceLabel":null,"sourceNotes":"item-0015.txt 第 9 行。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"方玉润","sectionLabel":"总评","text":"方玉润辨《小序》《大序》与僞传诸说皆拘泥后妃之义，主张《桃夭》只是咏新昏之诗，与《關雎》同为房中乐，不过一从男求女说，一从女归男说。诗中以桃花比喻女子如花胜玉，又以宜室宜家称其德色双美，故虽不知所咏何人，亦当是足称乐而不淫的佳偶。","notes":null}]},{"id":"0006","order":6,"total":8,"layer":"global","layerLabel":"全篇总说","targetText":"眉评","targetNotes":"对应 item-0015 眉评。","sourceLabel":null,"sourceNotes":"item-0015.txt 第 11 行。","notes":null,"glosses":[{"key":"0006-1","attributionLabel":"方玉润","sectionLabel":"眉评","text":"眉评称首章“豔絶”，谓其为千古香奁词赋之祖；又谓二章意尽首章，而“葉”“實”都是于归后的事，兼见妇人贵有子。","notes":null}]},{"id":"0007","order":7,"total":8,"layer":"global","layerLabel":"全篇总说","targetText":"集释","targetNotes":"对应 item-0015 集释。","sourceLabel":null,"sourceNotes":"item-0015.txt 第 13 行。","notes":null,"glosses":[{"key":"0007-1","attributionLabel":"方玉润","sectionLabel":"集释","text":"集释解释桃、夭夭、灼灼、归、宜、蕡、蓁蓁诸词，并引孔颖达、朱善、朱道行等说，申言“宜”是和顺见于外，有德而后有宜；又以“有蕡其實”比婚后多子。","notes":null}]},{"id":"0008","order":8,"total":8,"layer":"global","layerLabel":"全篇总说","targetText":"标韵","targetNotes":"对应 item-0015 标韵。","sourceLabel":null,"sourceNotes":"item-0015.txt 第 15 行。","notes":null,"glosses":[{"key":"0008-1","attributionLabel":"方玉润","sectionLabel":"标韵","text":"标韵以“華、家”为麻部同韵，“實、室”为质部同韵，“蓁、人”为真部同韵。","notes":null}]}]}}}
