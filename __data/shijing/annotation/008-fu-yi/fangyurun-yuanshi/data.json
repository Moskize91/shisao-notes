{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/008-fu-yi/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/008-fu-yi/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 芣苢 · 注释总览","description":"風 · 周南 · 芣苢 · 汇集《诗经原始(上下)》关于《芣苢》的 7 条注释，含 7 条注脚。"},"payload":{"detail":{"route":{"poemId":"008-fu-yi","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/008-fu-yi/fangyurun-yuanshi","poem":{"id":"008-fu-yi","title":"芣苢","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","芣苢"],"segments":[{"id":"seg-001","text":"采采芣苢","isActive":false},{"id":"seg-002","text":"薄言采之","isActive":false},{"id":"seg-003","text":"采采芣苢","isActive":false},{"id":"seg-004","text":"薄言有之","isActive":false},{"id":"seg-005","text":"采采芣苢","isActive":false},{"id":"seg-006","text":"薄言掇之","isActive":false},{"id":"seg-007","text":"采采芣苢","isActive":false},{"id":"seg-008","text":"薄言捋之","isActive":false},{"id":"seg-009","text":"采采芣苢","isActive":false},{"id":"seg-010","text":"薄言袺之","isActive":false},{"id":"seg-011","text":"采采芣苢","isActive":false},{"id":"seg-012","text":"薄言襭之","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":7,"glossCount":7},"annotations":[{"id":"0001","order":1,"total":7,"layer":"global","layerLabel":"全篇总说","targetText":"芣苢三章曲式与采菜歌咏","targetNotes":"依 item-0017 中的总说与前言。","sourceLabel":null,"sourceNotes":"Item-0017.txt 前段与总说段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":null,"text":"首段写芣苢采芣的妇女歌，强调这是一声声嬉戏的劳动唱和，用“薄言”重复行动的词语让读者听见不断的采集、拾取与收拢，继而介绍芣苢的意义乃“拾菜歌歌”，并以《小序》《大序》引出妇女嬉唱之道与传播的社会风。一段通篇说明，提示读者无需逐句求实，以想象田野场景、顺其自然之美品味此诗。","notes":null}]},{"id":"0002","order":2,"total":7,"layer":"span","layerLabel":"诗句片段","targetText":"采采芣苢，薄言采之。采采芣苢，薄言有之。","targetNotes":"第一章。","sourceLabel":null,"sourceNotes":"Item-0017.txt 章首。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":null,"text":"首章以重复“采采芣苢”“薄言采之”“薄言有之”描写妇女在田野拾菜的节奏，强调采采是连声、薄言是轻声的体察，借此展现劳动歌的和鸣与无矣刻意的自然。","notes":null}]},{"id":"0003","order":3,"total":7,"layer":"span","layerLabel":"诗句片段","targetText":"采采芣苢，薄言掇之。采采芣苢，薄言捋之。","targetNotes":"第二章。","sourceLabel":null,"sourceNotes":"Item-0017.txt 第二章段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":null,"text":"第二章继续以“采采芣苢”引动“薄言掇之”“薄言捋之”，其中“掇”取， “捋”挤，皆是田间采集技巧，叙述过程缓缓为读者描出田野播撒与收拢的画面，强调芣苢之歌与妇女并肩劳作的生活轮廓。","notes":null}]},{"id":"0004","order":4,"total":7,"layer":"span","layerLabel":"诗句片段","targetText":"采采芣苢，薄言袺之。采采芣苢，薄言襭之。","targetNotes":"第三章。","sourceLabel":null,"sourceNotes":"Item-0017.txt 第三章段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":null,"text":"第三章以“袺”与“襭”收束，描述妇女把采来的芣苢收拢、包裹于衣兜与带间的动作，象征收获进入归家，并在结尾处交回“芣苢三章”这一循环的音乐性。","notes":null}]},{"id":"0005","order":5,"total":7,"layer":"global","layerLabel":"全篇总说","targetText":"眉评","targetNotes":"第 item-0017.txt 眉评段。","sourceLabel":null,"sourceNotes":"眉评行段。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"方玉润","sectionLabel":"眉评","text":"眉评称全文只用六字反复，故无实指，正其妙在于平原野趣的田家妇女采菜歌，强调诗意在音律与想象。","notes":null}]},{"id":"0006","order":6,"total":7,"layer":"global","layerLabel":"全篇总说","targetText":"集释","targetNotes":"第 item-0017.txt 集释段。","sourceLabel":null,"sourceNotes":"集释段。","notes":null,"glosses":[{"key":"0006-1","attributionLabel":"方玉润","sectionLabel":"集释","text":"集释引用《尔雅》《韩氏》《陆氏》等解释芣苢为车前草、掇取、捋取、袺藏、襭以衣的过程，指出芣苢多在车前生长，因此与“车前”同义，且“袺”“襭”都是整理衣物的动作，从而把诗中的重复词全部翻入具体操作。","notes":null}]},{"id":"0007","order":7,"total":7,"layer":"global","layerLabel":"全篇总说","targetText":"标韵","targetNotes":"对应 item-0017 标韵段。","sourceLabel":null,"sourceNotes":"item-0017.txt 末段《标韵》。","notes":null,"glosses":[{"key":"0007-1","attributionLabel":"方玉润","sectionLabel":"标韵","text":"标韵云：“采十賄。有二十五有。叶韻。掇七曷。捋同。本韻。袺九屑。襭同。本韻。”","notes":null}]}]}}}
