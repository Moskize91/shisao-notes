{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/008-fu-yi/chenhuan-chuanshu","dataHref":"/__data/shijing/annotation/008-fu-yi/chenhuan-chuanshu/data.json","title":"詩毛氏傳疏 · 芣苢 · 注释总览","description":"風 · 周南 · 芣苢 · 汇集《詩毛氏傳疏》关于《芣苢》的 5 条 annotation，含 5 条 gloss。"},"payload":{"detail":{"route":{"poemId":"008-fu-yi","materialId":"chenhuan-chuanshu"},"href":"/shijing/annotation/008-fu-yi/chenhuan-chuanshu","poem":{"id":"008-fu-yi","title":"芣苢","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","芣苢"],"segments":[{"id":"seg-001","text":"采采芣苢","isActive":false},{"id":"seg-002","text":"薄言采之","isActive":false},{"id":"seg-003","text":"薄言有之","isActive":false},{"id":"seg-004","text":"薄言掇之","isActive":false},{"id":"seg-005","text":"薄言捋之","isActive":false},{"id":"seg-006","text":"薄言袺之","isActive":false},{"id":"seg-007","text":"薄言襭之","isActive":false}]},"material":{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","authors":["陳奐"],"contributorLine":"清 · 陳奐","era":"清","publicationYear":1847,"carrier":"PDF"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"preface","layerLabel":"篇序","targetText":"序《芣苢》","targetNotes":"篇首《序》与陈奂总疏。","sourceLabel":"第 38 页","sourceNotes":"PDF 第 38 页页首。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"疏承《序》“后妃之美”“和平则妇人乐有子”之说，认为《芣苢》写妇人采车前之乐，正见关雎、桃夭以来内治和平之效；并辨此篇重在妇人顺时采择、以车前助怀妊生产，不当泛作无实之歌。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"采采芣苢薄言采之薄言有之","targetNotes":"首章传疏。","sourceLabel":"第 39 页","sourceNotes":"PDF 第 39 页前半。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"疏称“芣苢”即《尔雅》之马舄、车前，“采采”见采者众而非一辞；“薄言”是发语之辞，“有之”则从《传》训为藏之。陈奂并引陆玑、本草与韩诗旧说，辨明诗中所采为草类车前，并以宜怀妊、治难产申后妃和平之意。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"薄言掇之薄言捋之","targetNotes":"第二章传疏。","sourceLabel":"第 39-40 页","sourceNotes":"PDF 第 39 页后半至第 40 页前段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"疏沿毛传释“掇”为拾、“捋”为取其子，并把第二章理解为由采而入细取的动作层次。陈奂兼引《说文》与诸家训诂，说明“掇”“捋”虽同属采择，前者偏手拾其物，后者偏顺手取实，因此章法较首章更细密。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"薄言袺之薄言襭之","targetNotes":"第三章传疏。","sourceLabel":"第 40 页","sourceNotes":"PDF 第 40 页中后段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"疏称“袺”为执衽收物，“襭”为扱衽于带间，写妇人采得之后以衣襟、衣带承贮其物。陈奂又借礼制衣服之说申明二字分寸，认为末章已从采择转入收贮，正是全诗动作递进的收束。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"芣苢三章章四句","targetNotes":"陈奂对三章与末尾章句之总述。","sourceLabel":"第 40 页","sourceNotes":"/tmp/fuyi-pages/chenhuan-40.png 末尾章句。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"疏从“章四句”入手，总结三章各以采藏、掇捋、袺襭之态，归之于后妃以和礼行化，呼应前篇关于文王之德、后妃之化的总体论述。","notes":null}]}]}}}
