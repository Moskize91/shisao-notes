{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/008-fu-yi/maoheng-zhushu-kr1c0004","dataHref":"/__data/shijing/annotation/008-fu-yi/maoheng-zhushu-kr1c0004/data.json","title":"毛詩注疏 · 芣苢 · 注释总览","description":"風 · 周南 · 芣苢 · 汇集《毛詩注疏》关于《芣苢》的 5 条注释，含 6 条注脚。"},"payload":{"detail":{"route":{"poemId":"008-fu-yi","materialId":"maoheng-zhushu-kr1c0004"},"href":"/shijing/annotation/008-fu-yi/maoheng-zhushu-kr1c0004","poem":{"id":"008-fu-yi","title":"芣苢","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","芣苢"],"segments":[{"id":"seg-001","text":"采采芣苢","isActive":false},{"id":"seg-002","text":"薄言采之","isActive":false},{"id":"seg-003","text":"采采芣苢","isActive":false},{"id":"seg-004","text":"薄言有之","isActive":false},{"id":"seg-005","text":"采采芣苢","isActive":false},{"id":"seg-006","text":"薄言掇之","isActive":false},{"id":"seg-007","text":"采采芣苢","isActive":false},{"id":"seg-008","text":"薄言捋之","isActive":false},{"id":"seg-009","text":"采采芣苢","isActive":false},{"id":"seg-010","text":"薄言袺之","isActive":false},{"id":"seg-011","text":"采采芣苢","isActive":false},{"id":"seg-012","text":"薄言襭之","isActive":false}]},"material":{"id":"maoheng-zhushu-kr1c0004","title":"毛詩注疏","authors":["毛亨","鄭氏","孔穎達"],"contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","era":"漢唐","publicationYear":653,"carrier":"TXT"},"stats":{"annotationCount":5,"glossCount":6},"annotations":[{"id":"0001","order":1,"total":5,"layer":"preface","layerLabel":"篇序","targetText":"序芣苢乃后妃之美与文王化道","targetNotes":"篇首开引与背景说明。","sourceLabel":null,"sourceNotes":"对应 kanseki 1036-1055 行的序文段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序","text":"序称《芣苢》之后篇接《兔罝》《芣苢》皆赞后妃之美，并取王化之道以复国家，章章述妇人乐有子之义，指文王之和平化在江汉乃至六合。","notes":null},{"key":"0001-2","attributionLabel":"孔疏","sectionLabel":null,"text":"疏亦引《周书》《汉书》与《礼记》，以芣苢作为马舄草，冬暖夏柔之物，谓其能治难产又与文王之化相应，提到“太平”之名但示尚未成，呼应前后章章呼和平与德广。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"采采芣苢，薄言采之。采采芣苢，薄言有之。","targetNotes":"首章采采有之对照。","sourceLabel":null,"sourceNotes":"对应 kanseki 1059-1063 行。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"毛传","sectionLabel":null,"text":"传指出“采采”非一词，“芣苢”即马舄草，与车前草同名，既能治难产又是文王之化之象，‘有之’者指藏之。以安胎与文王德化的关系为主题。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"采采芣苢，薄言掇之。采采芣苢，薄言捋之。","targetNotes":"第二章取与捋。","sourceLabel":null,"sourceNotes":"对应 kanseki 1065-1069 行。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"毛传","sectionLabel":null,"text":"传述掇捋二术皆为妇人采草之法，用以象征采芣苢时的动作与礼仪；并补“掇”即取、“捋”即捋取之义。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"采采芣苢，薄言袺之。采采芣苢，薄言襭之。","targetNotes":"第三章袺与襭。","sourceLabel":null,"sourceNotes":"对应 kanseki 1070-1074 行。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"毛传","sectionLabel":null,"text":"传述袺襭皆为执衣衽之状，以手执衣而衣自归，象征采成之后包裹收束，表示妇人乐采多子并归藏之意。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"芣苢三章章四句","targetNotes":"章句总说。","sourceLabel":null,"sourceNotes":"对应 kanseki 1075-1078 行。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"毛传","sectionLabel":"章句","text":"章句概括三章：首章采之藏之、二章掇之捋之、三章袺之襭之，均以采芣苢之礼赞后妃之化与天下和平。","notes":null}]}]}}}
