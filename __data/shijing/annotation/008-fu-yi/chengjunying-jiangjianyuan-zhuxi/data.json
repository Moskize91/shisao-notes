{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/008-fu-yi/chengjunying-jiangjianyuan-zhuxi","dataHref":"/__data/shijing/annotation/008-fu-yi/chengjunying-jiangjianyuan-zhuxi/data.json","title":"詩經注析 · 芣苢 · 注释总览","description":"風 · 周南 · 芣苢 · 汇集《詩經注析》关于《芣苢》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"008-fu-yi","materialId":"chengjunying-jiangjianyuan-zhuxi"},"href":"/shijing/annotation/008-fu-yi/chengjunying-jiangjianyuan-zhuxi","poem":{"id":"008-fu-yi","title":"芣苢","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","芣苢"],"segments":[{"id":"seg-001","text":"采采芣苢","isActive":false},{"id":"seg-002","text":"薄言采之","isActive":false},{"id":"seg-003","text":"薄言有之","isActive":false},{"id":"seg-004","text":"薄言掇之","isActive":false},{"id":"seg-005","text":"薄言捋之","isActive":false},{"id":"seg-006","text":"薄言袺之","isActive":false},{"id":"seg-007","text":"薄言襭之","isActive":false}]},"material":{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","authors":["程俊英","蔣見元"],"contributorLine":"现代 · 程俊英、蔣見元","era":"现代","publicationYear":1991,"carrier":"PDF"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"题解","targetNotes":"依照书中题解与作者批注。","sourceLabel":"第 39 页","sourceNotes":"页图 /tmp/fuyi-pages/cheng-40.png 上半段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"题解赞颂采芣苢的妇女，用“采采”“芣苢”等反复句式描绘她们与天地相和的劳动；该处引方玉润说明芣苢能治妇女不孕，借其和谐凸显婚姻与社会之义。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"采采芣苢，薄言采之。","targetNotes":"首章节奏与采集之始。","sourceLabel":"第 40 页","sourceNotes":"/tmp/fuyi-pages/cheng-40.png 中间段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"注称“薄言”即细言，意在强调采芣苢的缓慢节奏与每一份草料要被细心挑选，借此入诗赞营造生活与生产的细致和谐。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"薄言有之。薄言掇之，薄言捋之。","targetNotes":"第二章描采芣苢的具体动作。","sourceLabel":"第 40 页","sourceNotes":"/tmp/fuyi-pages/cheng-40.png 下段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"注指出“掇”“捋”即拾取与拢实的动作，强调采集过程中既需身手又需规律，合乎女性劳动与婚姻祝愿的双重意象。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"薄言袺之，薄言襭之。","targetNotes":"第三章收束与篇末礼仪。","sourceLabel":"第 41 页","sourceNotes":"/tmp/fuyi-pages/cheng-41.png。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"注释解释“袺”“襭”均为束缚衣衽的动作，借采集草药的结尾描写妇人在采后整理，也象征妇女在家务收尾中保持安定之德。","notes":null}]}]}}}
