{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/008-fu-yi/zhuxi-shijichuan-kr1c0009","dataHref":"/__data/shijing/annotation/008-fu-yi/zhuxi-shijichuan-kr1c0009/data.json","title":"詩集傳 · 芣苢 · 注释总览","description":"風 · 周南 · 芣苢 · 汇集《詩集傳》关于《芣苢》的 4 条 annotation，含 4 条 gloss。"},"payload":{"detail":{"route":{"poemId":"008-fu-yi","materialId":"zhuxi-shijichuan-kr1c0009"},"href":"/shijing/annotation/008-fu-yi/zhuxi-shijichuan-kr1c0009","poem":{"id":"008-fu-yi","title":"芣苢","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","芣苢"],"segments":[{"id":"seg-001","text":"采采芣苢","isActive":false},{"id":"seg-002","text":"薄言采之","isActive":false},{"id":"seg-003","text":"薄言有之","isActive":false},{"id":"seg-004","text":"薄言掇之","isActive":false},{"id":"seg-005","text":"薄言捋之","isActive":false},{"id":"seg-006","text":"薄言袺之","isActive":false},{"id":"seg-007","text":"薄言襭之","isActive":false}]},"material":{"id":"zhuxi-shijichuan-kr1c0009","title":"詩集傳","authors":["朱熹"],"contributorLine":"宋 · 朱熹","era":"宋","publicationYear":1186,"carrier":"TXT"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"芣苢三章章四句","targetNotes":"章句总说。","sourceLabel":null,"sourceNotes":"对应 Kanseki 171-174 行的总述与章末“芣苢三章章四句”。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"朱熹","sectionLabel":"传","text":"诗以采采芣苢抒妇人在平静日子里取草寄情，用“薄言”反复写出采集、累积与衣带结束的动作，末章以“章四句”总括，显出风俗之善与江汉之旅女的风姿。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"采采芣苢，薄言采之。薄言有之。","targetNotes":"首句与“有之”并列。","sourceLabel":null,"sourceNotes":"注释段落前半。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"朱熹","sectionLabel":"传","text":"首章以采芣苢诗兴，说妇人采采芣苢既为游戏又为备用，“薄言有之”表明取来后藏之于车前，蕴含有备无患与家室和乐的旨意。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"薄言掇之。薄言捋之。","targetNotes":"中段处置之态。","sourceLabel":null,"sourceNotes":"Kansekis 上的“薄言掇之”“薄言捋之”段落。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"朱熹","sectionLabel":"传","text":"“掇”与“捋”描写妇人拾取芣苢的动作，朱熹以为此既是对劳动的歌颂，也是为衣食储备，二章连用表达从取材到束整的节奏感。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"薄言袺之。薄言襭之。","targetNotes":"结尾描述收束。","sourceLabel":null,"sourceNotes":"对应 Kanseki 下半的“薄言袺之”“薄言襭之”。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"朱熹","sectionLabel":"传","text":"“袺”取衣带、“襭”结衣襟，末章用织服之语引出江汉女子以礼取义，诗意在收束采集之事的同时升华为深远的风俗怀念。","notes":null}]}]}}}
