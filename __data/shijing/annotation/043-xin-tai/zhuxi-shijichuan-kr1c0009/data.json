{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/043-xin-tai/zhuxi-shijichuan-kr1c0009","dataHref":"/__data/shijing/annotation/043-xin-tai/zhuxi-shijichuan-kr1c0009/data.json","title":"詩集傳 · 新臺 · 注释总览","description":"風 · 邶風 · 新臺 · 汇集《詩集傳》关于《新臺》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"043-xin-tai","materialId":"zhuxi-shijichuan-kr1c0009"},"href":"/shijing/annotation/043-xin-tai/zhuxi-shijichuan-kr1c0009","poem":{"id":"043-xin-tai","title":"新臺","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","新臺"],"segments":[{"id":"seg-001","text":"新臺有泚","isActive":true},{"id":"seg-002","text":"河水瀰瀰","isActive":true},{"id":"seg-003","text":"燕婉之求","isActive":true},{"id":"seg-004","text":"蘧篨不鮮","isActive":true},{"id":"seg-005","text":"新臺有灑","isActive":false},{"id":"seg-006","text":"河水浼浼","isActive":false},{"id":"seg-007","text":"燕婉之求","isActive":false},{"id":"seg-008","text":"蘧篨不殄","isActive":false},{"id":"seg-009","text":"魚網之設","isActive":false},{"id":"seg-010","text":"鴻則離之","isActive":false},{"id":"seg-011","text":"燕婉之求","isActive":false},{"id":"seg-012","text":"得此戚施","isActive":false}]},"material":{"id":"zhuxi-shijichuan-kr1c0009","title":"詩集傳","authors":["朱熹"],"contributorLine":"宋 · 朱熹","era":"宋","publicationYear":1186,"carrier":"TXT"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"新臺有泚，河水瀰瀰。燕婉之求，蘧篨不鮮。","targetNotes":"首章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》新臺首章。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"朱熹","sectionLabel":null,"text":"賦也。朱熹释“泚”为鲜明貌，“瀰瀰”为盛貌；“燕”是安，“婉”是顺，“蘧篨”为不能俯之丑疾，“鮮”作少解。又引旧说谓卫宣公闻伋妻之美，作新臺于河上邀取，故诗刺其以齐女本求燕婉之配而反得丑恶之人。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"新臺有灑，河水浼浼。燕婉之求，蘧篨不殄。","targetNotes":"次章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》新臺次章。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"朱熹","sectionLabel":null,"text":"賦也。朱熹以“灑”为高峻，“浼浼”为平，“殄”为绝，并言“蘧篨”之病不已。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"魚網之設，鴻則離之。燕婉之求，得此戚施。","targetNotes":"末章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》新臺末章。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"朱熹","sectionLabel":null,"text":"興也。朱熹以“鴻”为大雁，“離”为附丽，“戚施”为不能仰之丑疾，并说設魚網而反得鴻，用以兴求燕婉而反得丑疾之人，所得非所求。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"新臺三章章四句凡宣姜事首尾見春秋傳然於詩則皆未有考也諸篇放此","targetNotes":"章句总说。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》新臺章句总说。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"朱熹","sectionLabel":null,"text":"朱熹记《新臺》三章，章四句，并谓宣姜之事首尾见《春秋传》，但于诗旨未有确考。","notes":null}]}]}}}
