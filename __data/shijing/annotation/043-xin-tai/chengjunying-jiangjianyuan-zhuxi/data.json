{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/043-xin-tai/chengjunying-jiangjianyuan-zhuxi","dataHref":"/__data/shijing/annotation/043-xin-tai/chengjunying-jiangjianyuan-zhuxi/data.json","title":"詩經注析 · 新臺 · 注释总览","description":"風 · 邶風 · 新臺 · 汇集《詩經注析》关于《新臺》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"043-xin-tai","materialId":"chengjunying-jiangjianyuan-zhuxi"},"href":"/shijing/annotation/043-xin-tai/chengjunying-jiangjianyuan-zhuxi","poem":{"id":"043-xin-tai","title":"新臺","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","新臺"],"segments":[{"id":"seg-001","text":"新台有泚","isActive":false},{"id":"seg-002","text":"河水瀰瀰","isActive":false},{"id":"seg-003","text":"燕婉之求","isActive":false},{"id":"seg-004","text":"籧篨不鲜","isActive":false},{"id":"seg-005","text":"新台有洒","isActive":false},{"id":"seg-006","text":"河水浼浼","isActive":false},{"id":"seg-007","text":"燕婉之求","isActive":false},{"id":"seg-008","text":"籧篨不殄","isActive":false},{"id":"seg-009","text":"鱼网之设","isActive":false},{"id":"seg-010","text":"鸿则离之","isActive":false},{"id":"seg-011","text":"燕婉之求","isActive":false},{"id":"seg-012","text":"得此戚施","isActive":false}]},"material":{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","authors":["程俊英","蔣見元"],"contributorLine":"现代 · 程俊英、蔣見元","era":"现代","publicationYear":1991,"carrier":"PDF"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"题解","targetNotes":"题解总说。","sourceLabel":"第 91 页","sourceNotes":"书内页 91《题解》段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"题解将《新台》定为人民讽刺卫宣公劫夺儿媳的诗，并据《左传》《史记》相关记载解释其历史背景。程、蒋强调诗中通过“燕婉之求”与“得此戚施”的强烈反差，揭露乱伦与强夺造成的理想破灭，具有鲜明的讽刺锋芒。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"新台有泚，河水瀰瀰。燕婉之求，籧篨不鲜！","targetNotes":"第一章。","sourceLabel":"第 91-92 页","sourceNotes":"书内页 91 下栏至 92 上栏首章注析。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","text":"首章先写景寓刺。程、蒋释“泚”为鲜明，“瀰瀰”为水盛；并释“燕婉”为安和美好配偶之意，“籧篨”为丑恶者，指出“燕婉之求，籧篨不鲜”正写齐女求佳偶而反遭宣公劫夺的强烈反差。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"新台有洒，河水浼浼。燕婉之求，籧篨不殄！","targetNotes":"第二章。","sourceLabel":"第 92 页","sourceNotes":"书内页 92 第二章注析。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","text":"次章承上强化讽刺。程、蒋释“洒”为高峻貌，“浼浼”为水势平缓貌，“不殄”为不断绝；意谓所求的和美婚配已不可得，而丑恶现实持续不去。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"鱼网之设，鸿则离之。燕婉之求，得此戚施。","targetNotes":"第三章。","sourceLabel":"第 92 页","sourceNotes":"书内页 92 第三章注析。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","text":"末章以“鱼网得鸿”为喻收束全篇。程、蒋释“离”为附着、获得，“戚施”为丑恶之人，指出此章以“所得非所求”直刺宣公强夺婚姻、败坏人伦。","notes":null}]}]}}}
