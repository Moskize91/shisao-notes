{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/043-xin-tai/quwanli-quanshi","dataHref":"/__data/shijing/annotation/043-xin-tai/quwanli-quanshi/data.json","title":"詩經詮釋 · 新臺 · 注释总览","description":"風 · 邶風 · 新臺 · 汇集《詩經詮釋》关于《新臺》的 2 条注释，含 2 条注脚。"},"payload":{"detail":{"route":{"poemId":"043-xin-tai","materialId":"quwanli-quanshi"},"href":"/shijing/annotation/043-xin-tai/quwanli-quanshi","poem":{"id":"043-xin-tai","title":"新臺","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","新臺"],"segments":[{"id":"seg-001","text":"新臺有泚","isActive":false},{"id":"seg-002","text":"河水瀰瀰","isActive":false},{"id":"seg-003","text":"燕婉之求","isActive":false},{"id":"seg-004","text":"籧篨不鮮","isActive":false},{"id":"seg-005","text":"新臺有洒","isActive":false},{"id":"seg-006","text":"河水浼浼","isActive":false},{"id":"seg-007","text":"燕婉之求","isActive":false},{"id":"seg-008","text":"籧篨不殄","isActive":false},{"id":"seg-009","text":"魚網之設","isActive":false},{"id":"seg-010","text":"鴻則離之","isActive":false},{"id":"seg-011","text":"燕婉之求","isActive":false},{"id":"seg-012","text":"得此戚施","isActive":false}]},"material":{"id":"quwanli-quanshi","title":"詩經詮釋","authors":["屈萬里"],"contributorLine":"现代 · 屈萬里","era":"现代","publicationYear":1983,"carrier":"PDF"},"stats":{"annotationCount":2,"glossCount":2},"annotations":[{"id":"0001","order":1,"total":2,"layer":"global","layerLabel":"全篇总说","targetText":"新臺","targetNotes":"诗旨总说。","sourceLabel":"第 52 页","sourceNotes":"书页 52《注释》①。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"屈万里","sectionLabel":"总说","text":"屈万里于《新臺》首条注释据《詩序》述其事，以卫宣公夺取伋妻为背景，定此篇为讽刺宣公乱伦强夺之作。","notes":null}]},{"id":"0002","order":2,"total":2,"layer":"term","layerLabel":"字词注","targetText":"新臺有泚，河水瀰瀰。燕婉之求，籧篨不鮮。新臺有洒，河水浼浼。燕婉之求，籧篨不殄。魚網之設，鴻則離之。燕婉之求，得此戚施。","targetNotes":"《注释》②至⑫撮要。","sourceLabel":"第 52 页","sourceNotes":"书页 52《注释》②至⑫。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"屈万里","sectionLabel":"注释","text":"屈万里释“泚”为鮮明貌（《說文》作玼），“瀰瀰”为水滿。又释“燕婉”为美色，“籧篨”为不能俯之醜疾，并以“不鮮”言其丑而不早死。次章释“洒”为高峻，“浼浼”见《韓詩》作浘浘，“不殄”犹不死。末章释“離”为罹，“戚施”为不能仰之醜疾，归结此诗为“求美偶而反得丑夫”的讽刺。","notes":null}]}]}}}
