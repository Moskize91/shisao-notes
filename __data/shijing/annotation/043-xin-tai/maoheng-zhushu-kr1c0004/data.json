{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/043-xin-tai/maoheng-zhushu-kr1c0004","dataHref":"/__data/shijing/annotation/043-xin-tai/maoheng-zhushu-kr1c0004/data.json","title":"毛詩注疏 · 新臺 · 注释总览","description":"風 · 邶風 · 新臺 · 汇集《毛詩注疏》关于《新臺》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"043-xin-tai","materialId":"maoheng-zhushu-kr1c0004"},"href":"/shijing/annotation/043-xin-tai/maoheng-zhushu-kr1c0004","poem":{"id":"043-xin-tai","title":"新臺","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","新臺"],"segments":[{"id":"seg-001","text":"新臺有泚","isActive":false},{"id":"seg-002","text":"河水彌彌","isActive":false},{"id":"seg-003","text":"燕婉之求","isActive":false},{"id":"seg-004","text":"籧篨不鮮","isActive":false},{"id":"seg-005","text":"新臺有灑","isActive":false},{"id":"seg-006","text":"河水浼浼","isActive":false},{"id":"seg-007","text":"燕婉之求","isActive":false},{"id":"seg-008","text":"籧篨不殄","isActive":false},{"id":"seg-009","text":"魚網之設","isActive":false},{"id":"seg-010","text":"鴻則離之","isActive":false},{"id":"seg-011","text":"燕婉之求","isActive":false},{"id":"seg-012","text":"得此戚施","isActive":false}]},"material":{"id":"maoheng-zhushu-kr1c0004","title":"毛詩注疏","authors":["毛亨","鄭氏","孔穎達"],"contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","era":"漢唐","publicationYear":653,"carrier":"TXT"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"preface","layerLabel":"篇序","targetText":"新臺刺衛宣公也納伋之妻作新臺於河上而要之國人惡之而作是詩也","targetNotes":"篇首小序。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》新臺序文。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序","text":"序：《新臺》，刺衛宣公也。納伋之妻，作新臺於河上而要之。國人惡之，而作是詩也。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"新臺有泚河水彌彌燕婉之求籧篨不鮮","targetNotes":"首章。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》新臺首章。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"毛传","sectionLabel":null,"text":"泚，鮮明貌。彌彌，盛貌。水所以絜汙穢，反於河上而為淫昏之行。燕，安。婉，順也。籧篨，不能俯者。箋云：鮮，善也。伋之妻，齊女，來嫁於衛。其心本求燕婉之人，謂伋也，反得籧篨不善，謂宣公也。籧篨口柔，常觀人顏色而為之辭，故不能俯也。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"新臺有灑河水浼浼燕婉之求籧篨不殄","targetNotes":"次章。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》新臺次章。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"毛传","sectionLabel":null,"text":"灑，高峻也。浼浼，平地也。殄，絕也。箋云：殄當作腆。腆，善也。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"魚網之設鴻則離之燕婉之求得此戚施","targetNotes":"三章。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》新臺三章。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"毛传","sectionLabel":null,"text":"言所得非所求也。箋云：設魚網者宜得魚，鴻乃鳥也，反離焉。猶齊女以禮來求世子，而得宣公。戚施，不能仰者。箋云：戚施面柔，下人以色，故不能仰也。","notes":null}]}]}}}
