{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/048-sang-zhong/maoheng-zhushu-kr1c0004","dataHref":"/__data/shijing/annotation/048-sang-zhong/maoheng-zhushu-kr1c0004/data.json","title":"毛詩注疏 · 桑中 · 注释总览","description":"風 · 鄘風 · 桑中 · 汇集《毛詩注疏》关于《桑中》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"048-sang-zhong","materialId":"maoheng-zhushu-kr1c0004"},"href":"/shijing/annotation/048-sang-zhong/maoheng-zhushu-kr1c0004","poem":{"id":"048-sang-zhong","title":"桑中","categoryId":"feng","subcategoryId":"yongfeng","path":["風","鄘風","桑中"],"segments":[{"id":"seg-001","text":"爰采唐矣","isActive":false},{"id":"seg-002","text":"沬之鄉矣","isActive":false},{"id":"seg-003","text":"云誰之思","isActive":false},{"id":"seg-004","text":"美孟姜矣","isActive":false},{"id":"seg-005","text":"期我乎桑中","isActive":false},{"id":"seg-006","text":"要我乎上宮","isActive":false},{"id":"seg-007","text":"送我乎淇之上矣","isActive":false},{"id":"seg-008","text":"爰采麥矣","isActive":false},{"id":"seg-009","text":"沬之北矣","isActive":false},{"id":"seg-010","text":"云誰之思","isActive":false},{"id":"seg-011","text":"美孟弋矣","isActive":false},{"id":"seg-012","text":"期我乎桑中","isActive":false},{"id":"seg-013","text":"要我乎上宮","isActive":false},{"id":"seg-014","text":"送我乎淇之上矣","isActive":false},{"id":"seg-015","text":"爰采葑矣","isActive":false},{"id":"seg-016","text":"沬之東矣","isActive":false},{"id":"seg-017","text":"云誰之思","isActive":false},{"id":"seg-018","text":"美孟庸矣","isActive":false},{"id":"seg-019","text":"期我乎桑中","isActive":false},{"id":"seg-020","text":"要我乎上宮","isActive":false},{"id":"seg-021","text":"送我乎淇之上矣","isActive":false}]},"material":{"id":"maoheng-zhushu-kr1c0004","title":"毛詩注疏","authors":["毛亨","鄭氏","孔穎達"],"contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","era":"漢唐","publicationYear":653,"carrier":"TXT"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"preface","layerLabel":"篇序","targetText":"桑中刺奔也衛之公室淫亂男女相奔至於世族在位相竊妻妾期於幽遠政散民流而不可止","targetNotes":"篇首小序。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷三》桑中序文。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序","text":"序：《桑中》，刺奔也。衛之公室淫亂，男女相奔，至於世族在位，相竊妻妾，期於幽遠，政散民流而不可止。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"爰采唐矣沬之鄉矣云誰之思美孟姜矣期我乎桑中要我乎上宮送我乎淇之上矣","targetNotes":"首章。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷三》桑中首章。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：爰，於也。唐蒙，菜名。沬，衛邑。箋云：於何采唐，必沬之鄉，猶言欲為淫亂者，必之衛之都。惡衛為淫亂之主。傳：姜，姓也。言世族在位有是惡行。箋云：淫亂之人誰思乎？乃思美孟姜。孟姜，列國之長女，而思與淫亂。疾世族在位，有是惡行也。傳：桑中、上宮，所期之地。淇，水名也。箋云：此思孟姜之愛厚已也，與我期於桑中，而要見我於上宮，其送我則於淇水之上。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"爰采麥矣沬之北矣云誰之思美孟弋矣期我乎桑中要我乎上宮送我乎淇之上矣","targetNotes":"次章。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷三》桑中次章。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：弋，姓也。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"爰采葑矣沬之東矣云誰之思美孟庸矣期我乎桑中要我乎上宮送我乎淇之上矣","targetNotes":"三章。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷三》桑中三章。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"毛传","sectionLabel":null,"text":"箋云：葑，蔓菁。傳：庸，姓也。","notes":null}]}]}}}
