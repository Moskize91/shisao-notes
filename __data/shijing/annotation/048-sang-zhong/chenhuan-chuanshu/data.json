{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/048-sang-zhong/chenhuan-chuanshu","dataHref":"/__data/shijing/annotation/048-sang-zhong/chenhuan-chuanshu/data.json","title":"詩毛氏傳疏 · 桑中 · 注释总览","description":"風 · 鄘風 · 桑中 · 汇集《詩毛氏傳疏》关于《桑中》的 2 条注释，含 2 条注脚。"},"payload":{"detail":{"route":{"poemId":"048-sang-zhong","materialId":"chenhuan-chuanshu"},"href":"/shijing/annotation/048-sang-zhong/chenhuan-chuanshu","poem":{"id":"048-sang-zhong","title":"桑中","categoryId":"feng","subcategoryId":"yongfeng","path":["風","鄘風","桑中"],"segments":[{"id":"seg-001","text":"爰采唐矣","isActive":false},{"id":"seg-002","text":"沬之鄉矣","isActive":false},{"id":"seg-003","text":"云誰之思","isActive":false},{"id":"seg-004","text":"美孟姜矣","isActive":false},{"id":"seg-005","text":"期我乎桑中","isActive":false},{"id":"seg-006","text":"要我乎上宮","isActive":false},{"id":"seg-007","text":"送我乎淇之上矣","isActive":false},{"id":"seg-008","text":"爰采麥矣","isActive":false},{"id":"seg-009","text":"沬之北矣","isActive":false},{"id":"seg-010","text":"云誰之思","isActive":false},{"id":"seg-011","text":"美孟弋矣","isActive":false},{"id":"seg-012","text":"期我乎桑中","isActive":false},{"id":"seg-013","text":"要我乎上宮","isActive":false},{"id":"seg-014","text":"送我乎淇之上矣","isActive":false},{"id":"seg-015","text":"爰采葑矣","isActive":false},{"id":"seg-016","text":"沬之東矣","isActive":false},{"id":"seg-017","text":"云誰之思","isActive":false},{"id":"seg-018","text":"美孟庸矣","isActive":false},{"id":"seg-019","text":"期我乎桑中","isActive":false},{"id":"seg-020","text":"要我乎上宮","isActive":false},{"id":"seg-021","text":"送我乎淇之上矣","isActive":false}]},"material":{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","authors":["陳奐"],"contributorLine":"清 · 陳奐","era":"清","publicationYear":1847,"carrier":"PDF"},"stats":{"annotationCount":2,"glossCount":2},"annotations":[{"id":"0001","order":1,"total":2,"layer":"preface","layerLabel":"篇序","targetText":"桑中刺奔也衛之公室淫亂男女相奔至於世族在位相竊妻妾期於幽遠政散民流而不可止","targetNotes":"篇首小序。","sourceLabel":"第 5 页","sourceNotes":"卷四页五《桑中》小序。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序","text":"序：《桑中》，刺奔也。衛之公室淫亂，男女相奔，至於世族在位，相竊妻妾，期於幽遠，政散民流而不可止。","notes":null}]},{"id":"0002","order":2,"total":2,"layer":"span","layerLabel":"诗句片段","targetText":"爰采唐矣，沬之鄉矣。云誰之思，美孟姜矣。期我乎桑中，要我乎上宮，送我乎淇之上矣。爰采麥矣，沬之北矣。云誰之思，美孟弋矣。期我乎桑中，要我乎上宮，送我乎淇之上矣。爰采葑矣，沬之東矣。云誰之思，美孟庸矣。期我乎桑中，要我乎上宮，送我乎淇之上矣。","targetNotes":"通篇经传疏解。","sourceLabel":"第 5-7 页","sourceNotes":"据卷四页五至页七《桑中》经传疏。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"陈奂疏《桑中》时，先据《序》“刺奔也……政散民流而不可止”指出卫国公室淫乱，遂使世族在位相窃妻妾。其释首章“爰采唐矣，沬之鄉矣，云誰之思，美孟姜矣，期我乎桑中，要我乎上宮，送我乎淇之上矣”，谓托采唐于沬鄉起兴，实写男子思慕孟姜而与之期会迎送。次章“爰采麥矣，沬之北矣，云誰之思，美孟弋矣，期我乎桑中，要我乎上宮，送我乎淇之上矣”，言更举沬北采麥，而所思由孟姜转为孟弋，见私奔之事非一端。末章“爰采葑矣，沬之東矣，云誰之思，美孟庸矣，期我乎桑中，要我乎上宮，送我乎淇之上矣”，又以沬東采葑与孟庸相期相送，层递成文，以见淫风流行而不可禁。","notes":null}]}]}}}
