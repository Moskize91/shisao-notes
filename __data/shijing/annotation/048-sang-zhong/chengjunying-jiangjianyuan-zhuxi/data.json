{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/048-sang-zhong/chengjunying-jiangjianyuan-zhuxi","dataHref":"/__data/shijing/annotation/048-sang-zhong/chengjunying-jiangjianyuan-zhuxi/data.json","title":"詩經注析 · 桑中 · 注释总览","description":"風 · 鄘風 · 桑中 · 汇集《詩經注析》关于《桑中》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"048-sang-zhong","materialId":"chengjunying-jiangjianyuan-zhuxi"},"href":"/shijing/annotation/048-sang-zhong/chengjunying-jiangjianyuan-zhuxi","poem":{"id":"048-sang-zhong","title":"桑中","categoryId":"feng","subcategoryId":"yongfeng","path":["風","鄘風","桑中"],"segments":[{"id":"seg-001","text":"爰采唐矣","isActive":false},{"id":"seg-002","text":"沬之乡矣","isActive":false},{"id":"seg-003","text":"云谁之思","isActive":false},{"id":"seg-004","text":"美孟姜矣","isActive":false},{"id":"seg-005","text":"期我乎桑中","isActive":false},{"id":"seg-006","text":"要我乎上宫","isActive":false},{"id":"seg-007","text":"送我乎淇之上矣","isActive":false},{"id":"seg-008","text":"爰采麦矣","isActive":false},{"id":"seg-009","text":"沬之北矣","isActive":false},{"id":"seg-010","text":"云谁之思","isActive":false},{"id":"seg-011","text":"美孟弋矣","isActive":false},{"id":"seg-012","text":"期我乎桑中","isActive":false},{"id":"seg-013","text":"要我乎上宫","isActive":false},{"id":"seg-014","text":"送我乎淇之上矣","isActive":false},{"id":"seg-015","text":"爰采葑矣","isActive":false},{"id":"seg-016","text":"沬之东矣","isActive":false},{"id":"seg-017","text":"云谁之思","isActive":false},{"id":"seg-018","text":"美孟庸矣","isActive":false},{"id":"seg-019","text":"期我乎桑中","isActive":false},{"id":"seg-020","text":"要我乎上宫","isActive":false},{"id":"seg-021","text":"送我乎淇之上矣","isActive":false}]},"material":{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","authors":["程俊英","蔣見元"],"contributorLine":"现代 · 程俊英、蔣見元","era":"现代","publicationYear":1991,"carrier":"PDF"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"题解","targetNotes":"题解总说。","sourceLabel":"第 101-102 页","sourceNotes":"书内页 101-102《题解》段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"题解认为《桑中》是一首写男女相悦、幽期密约的诗，并不认同将其定为讽刺贵族淫乱。程、蒋引崔述“有叹美而无规戒”与闻一多“桑虫，思会时也”等说，指出诗写采菜摘麦时对恋人的追念，以孟姜、孟弋、孟庸为泛指美人的代称。全诗以一问一答展开，又复唱“期我”“要我”“送我”之事，情意柔和而音节铿锵，后人称其为“无题诗”之祖。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"爰采唐矣？沬之乡矣。云谁之思？美孟姜矣。期我乎桑中，要我乎上宫，送我乎淇之上矣。","targetNotes":"第一章。","sourceLabel":"第 102-103 页","sourceNotes":"书内页 102-103 第一章注析。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","text":"首章“爰采唐矣？沬之乡矣。云谁之思？美孟姜矣。期我乎桑中，要我乎上宫，送我乎淇之上矣”以问答体开篇。程、蒋释“爰”为“于焉”合音，意为“何处”，“唐”即女萝。又释“沬”为卫都朝歌，“孟姜”为贵族女子的泛称。末三句写与恋人在桑中期会、上宫相要、临别送至淇水之上，情致宛转。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"爰采麦矣？沬之北矣。云谁之思？美孟弋矣。期我乎桑中，要我乎上宫，送我乎淇之上矣。","targetNotes":"第二章。","sourceLabel":"第 103 页","sourceNotes":"书内页 103 第二章注析。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","text":"次章“爰采麦矣？沬之北矣。云谁之思？美孟弋矣。期我乎桑中，要我乎上宫，送我乎淇之上矣”仍承问答复唱。程、蒋释“沬之北”为朝歌以北旧邶地，“弋”古亦作“姒”，借作贵族女子代称。“期我乎桑中”“要我乎上宫”“送我乎淇之上矣”三句复沓，强化相思不忘。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"爰采葑矣？沬之东矣。云谁之思？美孟庸矣。期我乎桑中，要我乎上宫，送我乎淇之上矣。","targetNotes":"第三章。","sourceLabel":"第 103-104 页","sourceNotes":"书内页 103-104 第三章注析。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","text":"三章“爰采葑矣？沬之东矣。云谁之思？美孟庸矣。期我乎桑中，要我乎上宫，送我乎淇之上矣”以采葑作兴。程、蒋释“葑”为芜菁，“沬之东”指古鄘地，“庸”古亦作“鄘”，仍为姓氏代称。末仍复唱“期我乎桑中”“要我乎上宫”“送我乎淇之上矣”，与前两章层递回环。","notes":null}]}]}}}
