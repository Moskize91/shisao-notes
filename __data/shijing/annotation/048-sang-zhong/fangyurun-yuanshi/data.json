{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/048-sang-zhong/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/048-sang-zhong/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 桑中 · 注释总览","description":"風 · 鄘風 · 桑中 · 汇集《诗经原始(上下)》关于《桑中》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"048-sang-zhong","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/048-sang-zhong/fangyurun-yuanshi","poem":{"id":"048-sang-zhong","title":"桑中","categoryId":"feng","subcategoryId":"yongfeng","path":["風","鄘風","桑中"],"segments":[{"id":"seg-001","text":"爰采唐矣","isActive":false},{"id":"seg-002","text":"沬之鄉矣","isActive":false},{"id":"seg-003","text":"云誰之思","isActive":false},{"id":"seg-004","text":"美孟姜矣","isActive":false},{"id":"seg-005","text":"期我乎桑中","isActive":false},{"id":"seg-006","text":"要我乎上宫","isActive":false},{"id":"seg-007","text":"送我乎淇之上矣","isActive":false},{"id":"seg-008","text":"爰采麥矣","isActive":false},{"id":"seg-009","text":"沬之北矣","isActive":false},{"id":"seg-010","text":"云誰之思","isActive":false},{"id":"seg-011","text":"美孟弋矣","isActive":false},{"id":"seg-012","text":"期我乎桑中","isActive":false},{"id":"seg-013","text":"要我乎上宫","isActive":false},{"id":"seg-014","text":"送我乎淇之上矣","isActive":false},{"id":"seg-015","text":"爰采葑矣","isActive":false},{"id":"seg-016","text":"沬之東矣","isActive":false},{"id":"seg-017","text":"云誰之思","isActive":false},{"id":"seg-018","text":"美孟庸矣","isActive":false},{"id":"seg-019","text":"期我乎桑中","isActive":false},{"id":"seg-020","text":"要我乎上宫","isActive":false},{"id":"seg-021","text":"送我乎淇之上矣","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"桑中㊟刺淫也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标题段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注","text":"方玉润题注以“刺淫”定篇，直指《桑中》所刺在世风淫靡。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"总评","targetNotes":"通篇总评。","sourceLabel":null,"sourceNotes":"对应 EPUB item 总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"总评","text":"方玉润总评先列《小序》《大序》及《集传》“刺奔”之说，继而反驳将“期我”“要我”“送我”直作自叙私奔，谓三章所咏三物三地三人不一，赋诗者当是代诗中人设辞。其又引“无题诗”喻，指出即使未必实有其人其事，亦足反映时俗与世运，故此类“刺淫”之作仍可为亡国之音，圣人录之所以垂戒。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"眉评","targetNotes":"篇中眉评撮要。","sourceLabel":null,"sourceNotes":"对应 EPUB item 眉评内容。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"眉评","text":"方玉润眉评云：三人、三地、三物，各章所咏不同，而所期所要所送之地则一，章法板中寓活。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"term","layerLabel":"字词注","targetText":"爰采唐矣沬之鄉矣要我乎上宫美孟弋矣爰采葑矣美孟庸矣","targetNotes":"集释撮要。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":"集释","text":"方玉润集释云：唐，蒙菜也，一名兔絲；沬，衛邑也，《書》所謂沬邦。上宫据《通典》为衛州衛縣上宫臺，“要”犹迎也。“弋”据《春秋》“定姒”、《公》《穀》作“定弋”，谓杞女夏后氏之后。葑，蔓菁也。庸，《補傳》谓鄘本庸姓之國，后有仕于衛者。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"标韵","targetNotes":"三章韵脚撮述。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标韵段。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"方玉润","sectionLabel":"标韵","text":"方玉润标韵云：首章“唐”七阳，“鄉、姜”并同为本韵，“中”一东、“宫”同，且下二章同；“上”二十三漾为叶韵，与上三韵叶，后二章应。次章“麥”十一陌、“北”十三职，“弋”同，为通韵。三章“葑”二冬，“東”与“庸”并属冬部，亦通韵。","notes":null}]}]}}}
