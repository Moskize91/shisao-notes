{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/024-he-bi-nong-yi/wangli-yundu","dataHref":"/__data/shijing/annotation/024-he-bi-nong-yi/wangli-yundu/data.json","title":"詩經韻讀 · 何彼穠矣 · 注释总览","description":"風 · 召南 · 何彼穠矣 · 汇集《詩經韻讀》关于《何彼穠矣》的 2 条注释，含 2 条注脚。"},"payload":{"detail":{"route":{"poemId":"024-he-bi-nong-yi","materialId":"wangli-yundu"},"href":"/shijing/annotation/024-he-bi-nong-yi/wangli-yundu","poem":{"id":"024-he-bi-nong-yi","title":"何彼穠矣","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","何彼穠矣"],"segments":[{"id":"seg-001","text":"何彼穠矣","isActive":false},{"id":"seg-002","text":"唐棣之华","isActive":false},{"id":"seg-003","text":"曷不肃雍","isActive":false},{"id":"seg-004","text":"王姬之车","isActive":false},{"id":"seg-005","text":"何彼穠矣","isActive":false},{"id":"seg-006","text":"华如桃李","isActive":false},{"id":"seg-007","text":"平王之孙","isActive":false},{"id":"seg-008","text":"齐侯之子","isActive":false},{"id":"seg-009","text":"其钓维何","isActive":false},{"id":"seg-010","text":"维丝伊缗","isActive":false},{"id":"seg-011","text":"齐侯之子","isActive":false},{"id":"seg-012","text":"平王之孙","isActive":false}]},"material":{"id":"wangli-yundu","title":"詩經韻讀","authors":["王力"],"contributorLine":"现代 · 王力","era":"现代","publicationYear":1980,"carrier":"PDF"},"stats":{"annotationCount":2,"glossCount":2},"annotations":[{"id":"0001","order":1,"total":2,"layer":"global","layerLabel":"全篇总说","targetText":"《何彼穠矣》韵读总说","targetNotes":"书页 149 的诗号 24 全段。","sourceLabel":"第 149 页局部","sourceNotes":"书页 149《何彼穠矣》韵读。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"王力","sectionLabel":"韵读","text":"王力将《何彼穠矣》读作三章三换韵：首章“华(hoa)”与“车(kia)”入鱼部而前句“矣”与后句“雍”相协；第二章“李(lia)”与“子(tzia)”属之部；第三章“缗(mion)”与“孙(suan)”又转入文部。全篇句式整齐，而韵脚随章递换。","notes":null}]},{"id":"0002","order":2,"total":2,"layer":"span","layerLabel":"诗句片段","targetText":"何彼穠矣！唐棣之华。曷不肃雍，王姬之车。何彼穠矣！华如桃李。平王之孙，齐侯之子。其钓维何？维丝伊缗。齐侯之子，平王之孙。","targetNotes":"现存页图可见全篇。","sourceLabel":"第 149 页局部","sourceNotes":"书页 149《何彼穠矣》全篇韵读。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"王力","sectionLabel":"韵读","text":"页图可读首章“唐棣之华(hoa)、王姬之车(kia)”为鱼部，次章“华如桃李(lia)、齐侯之子(tzia)”转之部，末章“维丝伊缗(mion)、平王之孙(suan)”转文部。王力据此把《何彼穠矣》视为章章换韵而节奏匀整的一篇。","notes":null}]}]}}}
