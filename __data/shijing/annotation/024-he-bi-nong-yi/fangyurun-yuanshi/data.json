{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/024-he-bi-nong-yi/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/024-he-bi-nong-yi/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 何彼穠矣 · 注释总览","description":"風 · 召南 · 何彼穠矣 · 汇集《诗经原始(上下)》关于《何彼穠矣》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"024-he-bi-nong-yi","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/024-he-bi-nong-yi/fangyurun-yuanshi","poem":{"id":"024-he-bi-nong-yi","title":"何彼穠矣","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","何彼穠矣"],"segments":[{"id":"seg-001","text":"何彼穠矣","isActive":false},{"id":"seg-002","text":"唐棣之華","isActive":false},{"id":"seg-003","text":"曷不肅雝","isActive":false},{"id":"seg-004","text":"王姬之車","isActive":false},{"id":"seg-005","text":"何彼穠矣","isActive":false},{"id":"seg-006","text":"華如桃李","isActive":false},{"id":"seg-007","text":"平王之孫","isActive":false},{"id":"seg-008","text":"齊侯之子","isActive":false},{"id":"seg-009","text":"其釣維何","isActive":false},{"id":"seg-010","text":"維絲伊緡","isActive":false},{"id":"seg-011","text":"齊侯之子","isActive":false},{"id":"seg-012","text":"平王之孫","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"何彼穠矣㊟諷王姬車服漸侈也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标题段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注","text":"方玉润在题注中直断《何彼穠矣》为讽刺王姬车服渐侈之作，不从《序》与《集传》“美王姬下嫁而能肃雝”的读法。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"何彼穠矣？唐棣之華。曷不肅雝？王姬之車。何彼穠矣？華如桃李。平王之孫，齊侯之子。其釣維何？維絲伊緡。齊侯之子，平王之孫。","targetNotes":"通篇总评。","sourceLabel":null,"sourceNotes":"对应 EPUB item 正文与总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":null,"text":"方玉润引姚际恒、章潢诸说，力辨“平王之孙，齐侯之子”更近春秋时平王嫁女于齐的历史背景，认为此诗绝非周初淳美王化之音，而是“美中含刺”。他尤其指出“何彼穠矣”固盛称其色，“曷不肅雝”却分明是疑其德不称色；全篇所见只是王姬婚嫁时容饰、车服与门第婚媾之盛，故其微意正在讽贵族世胄联姻而德意渐侈。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"term","layerLabel":"字词注","targetText":"何彼穠矣唐棣之華平王之孫齊侯之子維絲伊緡","targetNotes":"集释所及名物字义。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"集释","sectionLabel":null,"text":"集释释“穠”为盛貌，石经作“禯”；“唐棣”即薁李，一名雀梅；“平王”即宜臼，“齊侯”指襄公诸儿；“緡”则为合丝所成之绳。整组集释既补足字义，也与方玉润所主东周说互相发明。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"标韵","targetNotes":"各章韵脚与通韵说明。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标韵段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"标韵","sectionLabel":null,"text":"标韵以首章“穠”“雝”归冬部本韵，间叶“華”“車”之麻部；第二章“李”“子”为纸部本韵；第三章“緡”“孫”则列真、元通韵。方玉润据此显示此诗章次虽短，而换韵分明。","notes":null}]}]}}}
