{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/024-he-bi-nong-yi/maoheng-zhushu-kr1c0004","dataHref":"/__data/shijing/annotation/024-he-bi-nong-yi/maoheng-zhushu-kr1c0004/data.json","title":"毛詩注疏 · 何彼穠矣 · 注释总览","description":"風 · 召南 · 何彼穠矣 · 汇集《毛詩注疏》关于《何彼穠矣》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"024-he-bi-nong-yi","materialId":"maoheng-zhushu-kr1c0004"},"href":"/shijing/annotation/024-he-bi-nong-yi/maoheng-zhushu-kr1c0004","poem":{"id":"024-he-bi-nong-yi","title":"何彼穠矣","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","何彼穠矣"],"segments":[{"id":"seg-001","text":"何彼穠矣","isActive":false},{"id":"seg-002","text":"唐棣之華","isActive":false},{"id":"seg-003","text":"曷不肅雝","isActive":false},{"id":"seg-004","text":"王姬之車","isActive":false},{"id":"seg-005","text":"何彼穠矣","isActive":false},{"id":"seg-006","text":"華如桃李","isActive":false},{"id":"seg-007","text":"平王之孫","isActive":false},{"id":"seg-008","text":"齊侯之子","isActive":false},{"id":"seg-009","text":"其釣維何","isActive":false},{"id":"seg-010","text":"維絲伊緡","isActive":false},{"id":"seg-011","text":"齊侯之子","isActive":false},{"id":"seg-012","text":"平王之孫","isActive":false}]},"material":{"id":"maoheng-zhushu-kr1c0004","title":"毛詩注疏","authors":["毛亨","鄭氏","孔穎達"],"contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","era":"漢唐","publicationYear":653,"carrier":"TXT"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"preface","layerLabel":"篇序","targetText":"何彼穠矣美王姬也雖則王姬亦下嫁於諸侯車服不繫其夫下王后一等猶執婦道以成肅雝之德也","targetNotes":"篇首小序。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經/何彼穠矣》序文。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序","text":"序：《何彼穠矣》，美王姬也。雖則王姬，亦下嫁於諸侯。車服不繫其夫，下王后一等，猶執婦道，以成肅雝之德也。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"何彼穠矣唐棣之華曷不肅雝王姬之車","targetNotes":"首章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經/何彼穠矣》首章。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：穠，猶戎戎也。唐棣，栘也。肅，敬也。雝，和也。王姬，周王之女，姬姓，故曰王姬。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"何彼穠矣華如桃李平王之孫齊侯之子","targetNotes":"第二章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經/何彼穠矣》第二章。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：平，正也。武王之女，文王之孫，適齊侯之子。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"其釣維何維絲伊緡齊侯之子平王之孫","targetNotes":"第三章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經/何彼穠矣》第三章。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：伊，維也。緡，綸也。","notes":null}]}]}}}
