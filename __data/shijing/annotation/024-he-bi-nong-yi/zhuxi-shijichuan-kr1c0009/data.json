{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/024-he-bi-nong-yi/zhuxi-shijichuan-kr1c0009","dataHref":"/__data/shijing/annotation/024-he-bi-nong-yi/zhuxi-shijichuan-kr1c0009/data.json","title":"詩集傳 · 何彼穠矣 · 注释总览","description":"風 · 召南 · 何彼穠矣 · 汇集《詩集傳》关于《何彼穠矣》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"024-he-bi-nong-yi","materialId":"zhuxi-shijichuan-kr1c0009"},"href":"/shijing/annotation/024-he-bi-nong-yi/zhuxi-shijichuan-kr1c0009","poem":{"id":"024-he-bi-nong-yi","title":"何彼穠矣","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","何彼穠矣"],"segments":[{"id":"seg-001","text":"何彼禯矣","isActive":true},{"id":"seg-002","text":"唐棣之華","isActive":true},{"id":"seg-003","text":"曷不肅雝","isActive":true},{"id":"seg-004","text":"王姬之車","isActive":true},{"id":"seg-005","text":"何彼禯矣","isActive":false},{"id":"seg-006","text":"華如桃李","isActive":false},{"id":"seg-007","text":"平王之孫","isActive":false},{"id":"seg-008","text":"齊矦之子","isActive":false},{"id":"seg-009","text":"其釣維何","isActive":false},{"id":"seg-010","text":"維絲伊緡","isActive":false},{"id":"seg-011","text":"齊矦之子","isActive":false},{"id":"seg-012","text":"平王之孫","isActive":false}]},"material":{"id":"zhuxi-shijichuan-kr1c0009","title":"詩集傳","authors":["朱熹"],"contributorLine":"宋 · 朱熹","era":"宋","publicationYear":1186,"carrier":"TXT"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"何彼禯矣，唐棣之華。曷不肅雝，王姬之車。","targetNotes":"首章。","sourceLabel":null,"sourceNotes":"对应 txt 408-415 行。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"朱熹","sectionLabel":null,"text":"興也。禯，盛也；唐棣，栘也；肅，敬也；雝，和也。朱熹以为王姬下嫁于诸侯，车服虽盛而不敢挟贵以骄其夫家，故见其车者知其能敬且和，以执妇道，诗人于是美之。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"何彼禯矣，華如桃李。平王之孫，齊矦之子。","targetNotes":"第二章。","sourceLabel":null,"sourceNotes":"对应 txt 415-419 行。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"朱熹","sectionLabel":null,"text":"興也。朱熹释“華如桃李”为以二木盛花比男女二人，并记旧说或以平王为正、谓武王女文王孙适齐侯之子，或以平王即宜臼、齐侯即襄公诸儿，事见《春秋》，而于两说之间存疑。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"其釣維何，維絲伊緡。齊矦之子，平王之孫。","targetNotes":"第三章。","sourceLabel":null,"sourceNotes":"对应 txt 420-422 行。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"朱熹","sectionLabel":null,"text":"興也。伊，亦維也；緡，綸也，絲之合而為綸，猶男女之合而為昏。朱熹以末章重申婚姻相配之义，并承上章“齊矦之子，平王之孫”以结此篇。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"何彼禯矣三章章四句","targetNotes":"章句总说。","sourceLabel":null,"sourceNotes":"对应 txt 423 行。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"朱熹","sectionLabel":null,"text":"朱熹记《何彼禯矣》为三章，每章四句，并于篇后再指出此诗时代不可的知，但文王、太姒之教久而未衰，亦可于其中想见。","notes":null}]}]}}}
