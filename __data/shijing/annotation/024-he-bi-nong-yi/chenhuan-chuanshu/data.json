{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/024-he-bi-nong-yi/chenhuan-chuanshu","dataHref":"/__data/shijing/annotation/024-he-bi-nong-yi/chenhuan-chuanshu/data.json","title":"詩毛氏傳疏 · 何彼穠矣 · 注释总览","description":"風 · 召南 · 何彼穠矣 · 汇集《詩毛氏傳疏》关于《何彼穠矣》的 2 条注释，含 2 条注脚。"},"payload":{"detail":{"route":{"poemId":"024-he-bi-nong-yi","materialId":"chenhuan-chuanshu"},"href":"/shijing/annotation/024-he-bi-nong-yi/chenhuan-chuanshu","poem":{"id":"024-he-bi-nong-yi","title":"何彼穠矣","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","何彼穠矣"],"segments":[{"id":"seg-001","text":"何彼穠矣","isActive":false},{"id":"seg-002","text":"唐棣之華","isActive":false},{"id":"seg-003","text":"曷不肅雝","isActive":false},{"id":"seg-004","text":"王姬之車","isActive":false},{"id":"seg-005","text":"何彼穠矣","isActive":false},{"id":"seg-006","text":"華如桃李","isActive":false},{"id":"seg-007","text":"平王之孫","isActive":false},{"id":"seg-008","text":"齊侯之子","isActive":false},{"id":"seg-009","text":"其釣維何","isActive":false},{"id":"seg-010","text":"維絲伊緡","isActive":false},{"id":"seg-011","text":"齊侯之子","isActive":false},{"id":"seg-012","text":"平王之孫","isActive":false}]},"material":{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","authors":["陳奐"],"contributorLine":"清 · 陳奐","era":"清","publicationYear":1847,"carrier":"PDF"},"stats":{"annotationCount":2,"glossCount":2},"annotations":[{"id":"0001","order":1,"total":2,"layer":"preface","layerLabel":"篇序","targetText":"何彼穠矣美王姬也雖則王姬亦下嫁於諸侯車服不繫其夫下王后一等猶執婦道以成肅雝之德也","targetNotes":"诗序。","sourceLabel":"第 45 页","sourceNotes":"据实页第45页《何彼穠矣》题下诗序。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序"}]},{"id":"0002","order":2,"total":2,"layer":"span","layerLabel":"诗句片段","targetText":"何彼穠矣，唐棣之華。曷不肅雝，王姬之車。何彼穠矣，華如桃李。平王之孫，齊侯之子。其釣維何，維絲伊緡。齊侯之子，平王之孫。","targetNotes":"通篇经文。","sourceLabel":"第 45-46 页","sourceNotes":"据实页第45-46页《何彼穠矣》经传疏。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"陈奂","sectionLabel":"疏"}]}]}}}
