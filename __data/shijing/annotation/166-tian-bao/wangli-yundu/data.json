{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/166-tian-bao/wangli-yundu","dataHref":"/__data/shijing/annotation/166-tian-bao/wangli-yundu/data.json","title":"詩經韻讀 · 天保 · 注释总览","description":"雅 · 小雅 · 天保 · 汇集《詩經韻讀》关于《天保》的 1 条注释，含 1 条注脚。"},"payload":{"detail":{"route":{"poemId":"166-tian-bao","materialId":"wangli-yundu"},"href":"/shijing/annotation/166-tian-bao/wangli-yundu","poem":{"id":"166-tian-bao","title":"天保","categoryId":"ya","subcategoryId":"xiaoya","path":["雅","小雅","天保"],"segments":[{"id":"seg-001","text":"天保定尔","isActive":true},{"id":"seg-002","text":"亦孔之固","isActive":true},{"id":"seg-003","text":"俾尔单厚","isActive":true},{"id":"seg-004","text":"何福不除","isActive":true},{"id":"seg-005","text":"俾尔多益","isActive":true},{"id":"seg-006","text":"以莫不庶","isActive":true},{"id":"seg-007","text":"天保定尔","isActive":true},{"id":"seg-008","text":"俾尔戬穀","isActive":true},{"id":"seg-009","text":"罄无不宜","isActive":true},{"id":"seg-010","text":"受天百禄","isActive":true},{"id":"seg-011","text":"降尔遐福","isActive":true},{"id":"seg-012","text":"维日不足","isActive":true},{"id":"seg-013","text":"天保定尔","isActive":true},{"id":"seg-014","text":"以莫不兴","isActive":true},{"id":"seg-015","text":"如山如阜","isActive":true},{"id":"seg-016","text":"如冈如陵","isActive":true},{"id":"seg-017","text":"如川之方至","isActive":true},{"id":"seg-018","text":"以莫不增","isActive":true},{"id":"seg-019","text":"吉蠲为饎","isActive":true},{"id":"seg-020","text":"是用孝享","isActive":true},{"id":"seg-021","text":"禴祠烝尝","isActive":true},{"id":"seg-022","text":"于公先王","isActive":true},{"id":"seg-023","text":"君曰卜尔","isActive":true},{"id":"seg-024","text":"万寿无疆","isActive":true},{"id":"seg-025","text":"神之吊矣","isActive":true},{"id":"seg-026","text":"诒尔多福","isActive":true},{"id":"seg-027","text":"民之质矣","isActive":true},{"id":"seg-028","text":"日用饮食","isActive":true},{"id":"seg-029","text":"群黎百姓","isActive":true},{"id":"seg-030","text":"遍为尔德","isActive":true},{"id":"seg-031","text":"如月之恒","isActive":true},{"id":"seg-032","text":"如日之升","isActive":true},{"id":"seg-033","text":"如南山之寿","isActive":true},{"id":"seg-034","text":"不骞不崩","isActive":true},{"id":"seg-035","text":"如松柏之茂","isActive":true},{"id":"seg-036","text":"无不尔或承","isActive":true}]},"material":{"id":"wangli-yundu","title":"詩經韻讀","authors":["王力"],"contributorLine":"现代 · 王力","era":"现代","publicationYear":1980,"carrier":"PDF"},"stats":{"annotationCount":1,"glossCount":1},"annotations":[{"id":"0001","order":1,"total":1,"layer":"span","layerLabel":"诗句片段","targetText":"天保定尔，亦孔之固。俾尔单厚，何福不除。俾尔多益，以莫不庶。天保定尔，俾尔戬穀。罄无不宜，受天百禄。降尔遐福，维日不足。天保定尔，以莫不兴。如山如阜，如冈如陵，如川之方至，以莫不增。吉蠲为饎，是用孝享。禴祠烝尝，于公先王。君曰卜尔，万寿无疆。神之吊矣，诒尔多福。民之质矣，日用饮食。群黎百姓，遍为尔德。如月之恒，如日之升。如南山之寿，不骞不崩。如松柏之茂，无不尔或承。","targetNotes":"整篇韵读对应正文。","sourceLabel":"第 240-241 页","sourceNotes":"第 240-241 页《天保》韵读。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"王力","sectionLabel":"韵读"}]}]}}}
