{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/166-tian-bao/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/166-tian-bao/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 天保 · 注释总览","description":"雅 · 小雅 · 天保 · 汇集《诗经原始(上下)》关于《天保》的 10 条注释，含 10 条注脚。"},"payload":{"detail":{"route":{"poemId":"166-tian-bao","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/166-tian-bao/fangyurun-yuanshi","poem":{"id":"166-tian-bao","title":"天保","categoryId":"ya","subcategoryId":"xiaoya","path":["雅","小雅","天保"],"segments":[{"id":"seg-001","text":"天保定爾","isActive":false},{"id":"seg-002","text":"亦孔之固","isActive":false},{"id":"seg-003","text":"俾爾單厚","isActive":false},{"id":"seg-004","text":"何福不除","isActive":false},{"id":"seg-005","text":"俾爾多益","isActive":false},{"id":"seg-006","text":"以莫不庶","isActive":false},{"id":"seg-007","text":"天保定爾","isActive":false},{"id":"seg-008","text":"俾爾戩穀","isActive":false},{"id":"seg-009","text":"罄無不宜","isActive":false},{"id":"seg-010","text":"受天百禄","isActive":false},{"id":"seg-011","text":"降爾遐福","isActive":false},{"id":"seg-012","text":"維日不足","isActive":false},{"id":"seg-013","text":"天保定爾","isActive":false},{"id":"seg-014","text":"以莫不興","isActive":false},{"id":"seg-015","text":"如山如阜","isActive":false},{"id":"seg-016","text":"如岡如陵","isActive":false},{"id":"seg-017","text":"如川之方至","isActive":false},{"id":"seg-018","text":"以莫不增","isActive":false},{"id":"seg-019","text":"吉蠲爲饎","isActive":false},{"id":"seg-020","text":"是用孝享","isActive":false},{"id":"seg-021","text":"禴祠烝嘗","isActive":false},{"id":"seg-022","text":"于公先王","isActive":false},{"id":"seg-023","text":"君曰卜爾","isActive":false},{"id":"seg-024","text":"萬壽無疆","isActive":false},{"id":"seg-025","text":"神之弔矣","isActive":false},{"id":"seg-026","text":"詒爾多福","isActive":false},{"id":"seg-027","text":"民之質矣","isActive":false},{"id":"seg-028","text":"日用飲食","isActive":false},{"id":"seg-029","text":"群黎百姓","isActive":false},{"id":"seg-030","text":"徧爲爾德","isActive":false},{"id":"seg-031","text":"如月之恒","isActive":false},{"id":"seg-032","text":"如日之升","isActive":false},{"id":"seg-033","text":"如南山之壽","isActive":false},{"id":"seg-034","text":"不騫不崩","isActive":false},{"id":"seg-035","text":"如松柏之茂","isActive":false},{"id":"seg-036","text":"無不爾或承","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":10,"glossCount":10},"annotations":[{"id":"0001","order":1,"total":10,"layer":"global","layerLabel":"全篇总说","targetText":"天保㊟祝君福也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB chapter09_0001_0006.html 题注。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注"}]},{"id":"0002","order":2,"total":10,"layer":"span","layerLabel":"诗句片段","targetText":"天保定爾，亦孔之固。俾爾單厚，何福不除。俾爾多益，以莫不庶。","targetNotes":"首章正文。","sourceLabel":null,"sourceNotes":"对应 EPUB chapter09_0001_0006.html 首章。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"正文"}]},{"id":"0003","order":3,"total":10,"layer":"span","layerLabel":"诗句片段","targetText":"天保定爾，俾爾戩穀。罄無不宜，受天百禄。降爾遐福，維日不足。","targetNotes":"二章正文。","sourceLabel":null,"sourceNotes":"对应 EPUB chapter09_0001_0006.html 二章。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"正文"}]},{"id":"0004","order":4,"total":10,"layer":"span","layerLabel":"诗句片段","targetText":"天保定爾，以莫不興。如山如阜，如岡如陵。如川之方至，以莫不增。","targetNotes":"三章正文。","sourceLabel":null,"sourceNotes":"对应 EPUB chapter09_0001_0006.html 三章。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":"正文"}]},{"id":"0005","order":5,"total":10,"layer":"span","layerLabel":"诗句片段","targetText":"吉蠲爲饎，是用孝享。禴祠烝嘗，于公先王。君曰卜爾，萬壽無疆。","targetNotes":"四章正文。","sourceLabel":null,"sourceNotes":"对应 EPUB chapter09_0001_0006.html 四章。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"方玉润","sectionLabel":"正文"}]},{"id":"0006","order":6,"total":10,"layer":"span","layerLabel":"诗句片段","targetText":"神之弔矣，詒爾多福。民之質矣，日用飲食。群黎百姓，徧爲爾德。","targetNotes":"五章正文。","sourceLabel":null,"sourceNotes":"对应 EPUB chapter09_0001_0006.html 五章。","notes":null,"glosses":[{"key":"0006-1","attributionLabel":"方玉润","sectionLabel":"正文"}]},{"id":"0007","order":7,"total":10,"layer":"span","layerLabel":"诗句片段","targetText":"如月之恒，如日之升。如南山之壽，不騫不崩。如松柏之茂，無不爾或承。","targetNotes":"六章正文。","sourceLabel":null,"sourceNotes":"对应 EPUB chapter09_0001_0006.html 六章。","notes":null,"glosses":[{"key":"0007-1","attributionLabel":"方玉润","sectionLabel":"正文"}]},{"id":"0008","order":8,"total":10,"layer":"global","layerLabel":"全篇总说","targetText":"右《天保》六章，章六句。《序》謂「下報上也」。鄭氏、《集傳》遂謂前五章皆君下臣，此章乃臣報君。殊知五章中非盡君下臣也，且臣必待君賜而後報，則所報者亦僞，豈尚有愛君之誠哉？此不過編詩次第應如是耳，不可泥以説詩也。全詩大意，前三章皆天之福君，後三章皆神之福君。其祝頌且多複筆，亦略無規諷意，不已近於諛乎？豈知臣之祝君，非但君也，實爲民耳。蓋君之福即民之福，君一人受天地神祇之福，即天下臣民億萬衆同享天地神祇之福。其所係不綦重歟？故詩又曰「群黎百姓，徧爲爾德」，是必在上有多福之君，然後在下有受福之民。特民在福中，日用飲食皆君福所庇，而不自知其所以然耳。前後雖極言天神降福，無所不至，其實以「德徧群黎」一句爲主。夫使君德未徧，天雖有福而不降，神又豈肯受其享哉？是知君福君自致耳，非民所能祝也。臣以此頌君，臣不過盡其心所欲而已。故極其頌禱不爲諛，反覆譬喻而非夸。若後世頌中帶諷，未免有意於其間，詎得以是爲名高歟？","targetNotes":"总评。","sourceLabel":null,"sourceNotes":"对应 EPUB chapter09_0001_0006.html 总评。","notes":null,"glosses":[{"key":"0008-1","attributionLabel":"方玉润","sectionLabel":"总评"}]},{"id":"0009","order":9,"total":10,"layer":"global","layerLabel":"全篇总说","targetText":"全詩以「德」字爲主。","targetNotes":"眉评。","sourceLabel":null,"sourceNotes":"对应 EPUB chapter09_0001_0006.html 眉评。","notes":null,"glosses":[{"key":"0009-1","attributionLabel":"方玉润","sectionLabel":"眉評"}]},{"id":"0010","order":10,"total":10,"layer":"term","layerLabel":"字词注","targetText":"天保定爾亦孔之固俾爾單厚何福不除以莫不庶俾爾戩穀罄無不宜降爾遐福吉蠲爲饎于公先王君曰卜爾神之弔矣詒爾多福民之質矣如月之恒不騫不崩無不爾或承","targetNotes":"集释中可稳定整理的关键训诂。","sourceLabel":null,"sourceNotes":"对应 EPUB chapter09_0001_0006.html 集释。","notes":null,"glosses":[{"key":"0010-1","attributionLabel":"方玉润","sectionLabel":"集釋"}]}]}}}
