{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/039-quan-shui/chengjunying-jiangjianyuan-zhuxi","dataHref":"/__data/shijing/annotation/039-quan-shui/chengjunying-jiangjianyuan-zhuxi/data.json","title":"詩經注析 · 泉水 · 注释总览","description":"風 · 邶風 · 泉水 · 汇集《詩經注析》关于《泉水》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"039-quan-shui","materialId":"chengjunying-jiangjianyuan-zhuxi"},"href":"/shijing/annotation/039-quan-shui/chengjunying-jiangjianyuan-zhuxi","poem":{"id":"039-quan-shui","title":"泉水","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","泉水"],"segments":[{"id":"seg-001","text":"毖彼泉水","isActive":false},{"id":"seg-002","text":"亦流于淇","isActive":false},{"id":"seg-003","text":"有怀于卫","isActive":false},{"id":"seg-004","text":"靡日不思","isActive":false},{"id":"seg-005","text":"娈彼诸姬","isActive":false},{"id":"seg-006","text":"聊与之谋","isActive":false},{"id":"seg-007","text":"出宿于泲","isActive":false},{"id":"seg-008","text":"饮饯于祢","isActive":false},{"id":"seg-009","text":"女子有行","isActive":false},{"id":"seg-010","text":"远父母兄弟","isActive":false},{"id":"seg-011","text":"问我诸姑","isActive":false},{"id":"seg-012","text":"遂及伯姊","isActive":false},{"id":"seg-013","text":"出宿于干","isActive":false},{"id":"seg-014","text":"饮饯于言","isActive":false},{"id":"seg-015","text":"载脂载辖","isActive":false},{"id":"seg-016","text":"还车言迈","isActive":false},{"id":"seg-017","text":"遄臻于卫","isActive":false},{"id":"seg-018","text":"不瑕有害","isActive":false},{"id":"seg-019","text":"我思肥泉","isActive":false},{"id":"seg-020","text":"兹之永叹","isActive":false},{"id":"seg-021","text":"思须与漕","isActive":false},{"id":"seg-022","text":"我心悠悠","isActive":false},{"id":"seg-023","text":"驾言出游","isActive":false},{"id":"seg-024","text":"以写我忧","isActive":false}]},"material":{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","authors":["程俊英","蔣見元"],"contributorLine":"现代 · 程俊英、蔣見元","era":"现代","publicationYear":1991,"carrier":"PDF"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"题解","targetNotes":"题解总说。","sourceLabel":"第 82 页","sourceNotes":"书内页 82《题解》段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解"}]},{"id":"0002","order":2,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"毖彼泉水，亦流于淇。有怀于卫，靡日不思。娈彼诸姬，聊与之谋。","targetNotes":"第一章。","sourceLabel":"第 82 页","sourceNotes":"书内页 82 首章注析。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解"}]},{"id":"0003","order":3,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"出宿于泲，饮饯于祢。女子有行，远父母兄弟。问我诸姑，遂及伯姊。","targetNotes":"第二章。","sourceLabel":"第 83 页","sourceNotes":"书内页 83 第二章注析。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解"}]},{"id":"0004","order":4,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"出宿于干，饮饯于言。载脂载辖，还车言迈。遄臻于卫，不瑕有害？","targetNotes":"第三章。","sourceLabel":"第 83 页","sourceNotes":"书内页 83 第三章注析。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解"}]},{"id":"0005","order":5,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"我思肥泉，兹之永叹。思须与漕，我心悠悠。驾言出游，以写我忧。","targetNotes":"第四章。","sourceLabel":"第 84 页","sourceNotes":"书内页 84 第四章注析。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解"}]}]}}}
