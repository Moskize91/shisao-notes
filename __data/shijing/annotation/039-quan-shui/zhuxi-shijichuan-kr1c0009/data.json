{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/039-quan-shui/zhuxi-shijichuan-kr1c0009","dataHref":"/__data/shijing/annotation/039-quan-shui/zhuxi-shijichuan-kr1c0009/data.json","title":"詩集傳 · 泉水 · 注释总览","description":"風 · 邶風 · 泉水 · 汇集《詩集傳》关于《泉水》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"039-quan-shui","materialId":"zhuxi-shijichuan-kr1c0009"},"href":"/shijing/annotation/039-quan-shui/zhuxi-shijichuan-kr1c0009","poem":{"id":"039-quan-shui","title":"泉水","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","泉水"],"segments":[{"id":"seg-001","text":"毖彼泉水","isActive":true},{"id":"seg-002","text":"亦流于淇","isActive":true},{"id":"seg-003","text":"有懷于衛","isActive":true},{"id":"seg-004","text":"靡日不思","isActive":true},{"id":"seg-005","text":"孌彼諸姬","isActive":true},{"id":"seg-006","text":"聊與之謀","isActive":true},{"id":"seg-007","text":"出宿于泲","isActive":false},{"id":"seg-008","text":"飲餞于禰","isActive":false},{"id":"seg-009","text":"女子有行","isActive":false},{"id":"seg-010","text":"遠父母兄弟","isActive":false},{"id":"seg-011","text":"問我諸姑","isActive":false},{"id":"seg-012","text":"遂及伯姊","isActive":false},{"id":"seg-013","text":"出宿于干","isActive":false},{"id":"seg-014","text":"飲餞于言","isActive":false},{"id":"seg-015","text":"載脂載舝","isActive":false},{"id":"seg-016","text":"還車言邁","isActive":false},{"id":"seg-017","text":"遄臻于衛","isActive":false},{"id":"seg-018","text":"不瑕有害","isActive":false},{"id":"seg-019","text":"我思肥泉","isActive":false},{"id":"seg-020","text":"茲之永嘆","isActive":false},{"id":"seg-021","text":"思須與漕","isActive":false},{"id":"seg-022","text":"我心悠悠","isActive":false},{"id":"seg-023","text":"駕言出遊","isActive":false},{"id":"seg-024","text":"以寫我憂","isActive":false}]},"material":{"id":"zhuxi-shijichuan-kr1c0009","title":"詩集傳","authors":["朱熹"],"contributorLine":"宋 · 朱熹","era":"宋","publicationYear":1186,"carrier":"TXT"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"毖彼泉水，亦流于淇。有懷于衛，靡日不思。孌彼諸姬，聊與之謀。","targetNotes":"首章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》泉水首章。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"朱熹","sectionLabel":null,"text":"興也。朱熹先释“毖彼泉水，亦流于淇”为卫地泉水入淇之景，又以“有懷于衛，靡日不思”点明卫女思卫之情，并据“孌彼諸姬，聊與之謀”说明她因父母已终、不得归宁，所以只能与侄娣商量归卫之计。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"出宿于泲，飲餞于禰。女子有行，遠父母兄弟。問我諸姑，遂及伯姊。","targetNotes":"次章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》泉水次章。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"朱熹","sectionLabel":null,"text":"賦也。朱熹说“出宿于泲，飲餞于禰”是女子初嫁自卫而来时所经之地，又以“女子有行，遠父母兄弟”说明既嫁之后本已远离本家，至“問我諸姑，遂及伯姊”则是转向诸姑伯姊询问今日是否还能归卫，并引郑氏归宁之说以见礼制限制。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"出宿于干，飲餞于言。載脂載舝，還車言邁。遄臻于衛，不瑕有害。","targetNotes":"三章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》泉水三章。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"朱熹","sectionLabel":null,"text":"賦也。朱熹释“出宿于干，飲餞于言”为假设再往卫去时经过之地，又说“載脂載舝，還車言邁”是设想整备车轴、回转嫁车而行，至“遄臻于衛，不瑕有害”则写如果真能迅速抵达卫国，终究还是要顾忌是否有害于义理，所以只是疑而未敢遂行。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"我思肥泉，茲之永嘆。思須與漕，我心悠悠。駕言出遊，以寫我憂。","targetNotes":"末章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》泉水末章。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"朱熹","sectionLabel":null,"text":"賦也。朱熹释“我思肥泉”“思須與漕”为虽不敢归卫，却仍止不住思念卫地水邑；因此“我心悠悠”正写其思之绵长，而“駕言出遊，以寫我憂”则只是希望借一时出游稍稍排遣忧思。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"泉水四章章六句","targetNotes":"章句总说。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》泉水章句总说。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"朱熹","sectionLabel":null,"text":"朱熹记《泉水》为四章、章六句，并转录杨氏之说，强调卫女思归本出于人情，而终究“不归”则是止于礼义；圣人著录此诗，正是要使后世知道嫁往异国者在父母既终之后无归宁之义。","notes":null}]}]}}}
