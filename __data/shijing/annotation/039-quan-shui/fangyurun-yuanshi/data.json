{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/039-quan-shui/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/039-quan-shui/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 泉水 · 注释总览","description":"風 · 邶風 · 泉水 · 汇集《诗经原始(上下)》关于《泉水》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"039-quan-shui","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/039-quan-shui/fangyurun-yuanshi","poem":{"id":"039-quan-shui","title":"泉水","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","泉水"],"segments":[{"id":"seg-001","text":"毖彼泉水","isActive":false},{"id":"seg-002","text":"亦流于淇","isActive":false},{"id":"seg-003","text":"有懷于衛","isActive":false},{"id":"seg-004","text":"靡日不思","isActive":false},{"id":"seg-005","text":"孌彼諸姬","isActive":false},{"id":"seg-006","text":"聊與之謀","isActive":false},{"id":"seg-007","text":"出宿于泲","isActive":false},{"id":"seg-008","text":"飲餞于禰","isActive":false},{"id":"seg-009","text":"女子有行","isActive":false},{"id":"seg-010","text":"遠父母兄弟","isActive":false},{"id":"seg-011","text":"問我諸姑","isActive":false},{"id":"seg-012","text":"遂及伯姊","isActive":false},{"id":"seg-013","text":"出宿于干","isActive":false},{"id":"seg-014","text":"飲餞于言","isActive":false},{"id":"seg-015","text":"載脂載舝","isActive":false},{"id":"seg-016","text":"還車言邁","isActive":false},{"id":"seg-017","text":"遄臻于衛","isActive":false},{"id":"seg-018","text":"不瑕有害","isActive":false},{"id":"seg-019","text":"我思肥泉","isActive":false},{"id":"seg-020","text":"茲之永歎","isActive":false},{"id":"seg-021","text":"思須與漕","isActive":false},{"id":"seg-022","text":"我心悠悠","isActive":false},{"id":"seg-023","text":"駕言出遊","isActive":false},{"id":"seg-024","text":"以寫我憂","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"泉水㊟衛媵女和《載馳》作也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标题段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注","text":"方玉润题注直定《泉水》为卫国媵女和《載馳》之作，不从旧序“思归宁不得”的单线读法。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"总评","targetNotes":"通篇总评。","sourceLabel":null,"sourceNotes":"对应 EPUB item 总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"总评","text":"方玉润总评认为《泉水》虽与《竹竿》同为思归，却并非徒言归宁；其词意在直伤卫事、且为卫谋，并与《載馳》诸句互相唱和。由嫡、媵口吻各守其分可知，此篇当是媵妾和作，不是许穆夫人自作。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"眉评","targetNotes":"篇中眉评撮要。","sourceLabel":null,"sourceNotes":"对应 EPUB item 眉评内容。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"眉评","text":"方玉润眉评分章指出：首章动辄谋诸外戚，正是妇女声口，而其所以谋者仍在卫事；次章问及诸姑、伯姊，恰见妾媵身份；三四章所云饮饯，只是虚拟饯行之地，终归只能思漕写忧。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"term","layerLabel":"字词注","targetText":"毖彼泉水亦流于淇孌彼諸姬出宿于泲飲餞于禰問我諸姑遂及伯姊出宿于干飲餞于言載脂載舝遄臻于衛不瑕有害我思肥泉思須與漕以寫我憂","targetNotes":"集释撮要。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":"集释","text":"方玉润集释依次解释“毖”“泉水”“淇”“孌”“諸姬”“泲”“禰”“諸姑”“伯姊”“干”“言”“脂”“舝”“遄”“臻”“不瑕有害”“肥泉”“須”“漕”“寫”等词义。并借“諸姬”与“諸姑”“伯姊”之辨、以及“須”“漕”所指卫邑，申明此篇是为卫谋，不是徒言归宁。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"标韵","targetNotes":"四章韵脚撮述。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标韵段。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"方玉润","sectionLabel":"标韵","text":"方玉润标出《泉水》四章韵脚：首章以“淇、思、謀”转叶，次章以“禰、弟、姊”通韵，三章以“干、言、邁、害”换转，四章再以“泉、歎、悠、憂”相应。其标韵显示全篇在唱和《載馳》的同时，也随章法层层转韵。","notes":null}]}]}}}
