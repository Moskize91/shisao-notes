{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/039-quan-shui/quwanli-quanshi","dataHref":"/__data/shijing/annotation/039-quan-shui/quwanli-quanshi/data.json","title":"詩經詮釋 · 泉水 · 注释总览","description":"風 · 邶風 · 泉水 · 汇集《詩經詮釋》关于《泉水》的 2 条注释，含 2 条注脚。"},"payload":{"detail":{"route":{"poemId":"039-quan-shui","materialId":"quwanli-quanshi"},"href":"/shijing/annotation/039-quan-shui/quwanli-quanshi","poem":{"id":"039-quan-shui","title":"泉水","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","泉水"],"segments":[{"id":"seg-001","text":"毖彼泉水","isActive":false},{"id":"seg-002","text":"亦流于淇","isActive":false},{"id":"seg-003","text":"有懷于衛","isActive":false},{"id":"seg-004","text":"靡日不思","isActive":false},{"id":"seg-005","text":"孌彼諸姬","isActive":false},{"id":"seg-006","text":"聊與之謀","isActive":false},{"id":"seg-007","text":"出宿于泲","isActive":false},{"id":"seg-008","text":"飲餞于禰","isActive":false},{"id":"seg-009","text":"女子有行","isActive":false},{"id":"seg-010","text":"遠父母兄弟","isActive":false},{"id":"seg-011","text":"問我諸姑","isActive":false},{"id":"seg-012","text":"遂及伯姊","isActive":false},{"id":"seg-013","text":"出宿于干","isActive":false},{"id":"seg-014","text":"飲餞于言","isActive":false},{"id":"seg-015","text":"載脂載舝","isActive":false},{"id":"seg-016","text":"還車言邁","isActive":false},{"id":"seg-017","text":"遄臻于衛","isActive":false},{"id":"seg-018","text":"不瑕有害","isActive":false},{"id":"seg-019","text":"我思肥泉","isActive":false},{"id":"seg-020","text":"茲之永歎","isActive":false},{"id":"seg-021","text":"思須與漕","isActive":false},{"id":"seg-022","text":"我心悠悠","isActive":false},{"id":"seg-023","text":"駕言出遊","isActive":false},{"id":"seg-024","text":"以寫我憂","isActive":false}]},"material":{"id":"quwanli-quanshi","title":"詩經詮釋","authors":["屈萬里"],"contributorLine":"现代 · 屈萬里","era":"现代","publicationYear":1983,"carrier":"PDF"},"stats":{"annotationCount":2,"glossCount":2},"annotations":[{"id":"0001","order":1,"total":2,"layer":"global","layerLabel":"全篇总说","targetText":"泉水","targetNotes":"诗旨总说。","sourceLabel":"第 47 页","sourceNotes":"书页 47 题下总说。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"屈万里","sectionLabel":"总说","text":"屈万里以《泉水》为卫女嫁于他国而思归卫之诗，认为篇中反复出现的怀卫、问亲、欲归而终止等层次，都围绕远嫁女子的思乡苦情展开；他不重《毛序》“国人思之”说，而把诗旨收在女子自身久客异邦、思归不得的心理经验上。","notes":null}]},{"id":"0002","order":2,"total":2,"layer":"term","layerLabel":"字词注","targetText":"毖彼泉水亦流于淇孌彼諸姬飲餞于禰女子有行遂及伯姊出宿于干飲餞于言載脂載舝還車言邁遄臻于衛不瑕有害我思肥泉思須與漕我心悠悠以寫我憂","targetNotes":"《注释》②至㉕撮要。","sourceLabel":"第 47-48 页","sourceNotes":"第 47-48 页《注释》②至㉕。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"屈万里","sectionLabel":"注释","text":"屈万里释“毖”为泉水涌流貌，“淇”为水名；又说“諸姬”指姪娣，“禰”是卫地名，“行”为嫁，“伯姊”为大姊，“干”“言”皆地名。又以“載”为装，“舝”为车轴头键，“還”为旋返，“遄”为速至；“不瑕有害”从王引之说，谓当读作“不会有什么害处吗”的设问。末章诸词则释“肥泉”为卫地泉名，“須”“漕”为地名，“悠悠”为思念长远，“寫”为除去，用这些词义串起全诗思归不得的情绪。","notes":null}]}]}}}
