{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/005-zhong-si/chengjunying-jiangjianyuan-zhuxi","dataHref":"/__data/shijing/annotation/005-zhong-si/chengjunying-jiangjianyuan-zhuxi/data.json","title":"詩經注析 · 螽斯 · 注释总览","description":"風 · 周南 · 螽斯 · 汇集《詩經注析》关于《螽斯》的 4 条 annotation，含 4 条 gloss。"},"payload":{"detail":{"route":{"poemId":"005-zhong-si","materialId":"chengjunying-jiangjianyuan-zhuxi"},"href":"/shijing/annotation/005-zhong-si/chengjunying-jiangjianyuan-zhuxi","poem":{"id":"005-zhong-si","title":"螽斯","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","螽斯"],"segments":[{"id":"seg-001","text":"螽斯羽","isActive":false},{"id":"seg-002","text":"诜诜兮","isActive":false},{"id":"seg-003","text":"宜尔子孙","isActive":false},{"id":"seg-004","text":"振振兮","isActive":false},{"id":"seg-005","text":"螽斯羽","isActive":false},{"id":"seg-006","text":"薨薨兮","isActive":false},{"id":"seg-007","text":"宜尔子孙","isActive":false},{"id":"seg-008","text":"绳绳兮","isActive":false},{"id":"seg-009","text":"螽斯羽","isActive":false},{"id":"seg-010","text":"揖揖兮","isActive":false},{"id":"seg-011","text":"宜尔子孙","isActive":false},{"id":"seg-012","text":"蛰蛰兮","isActive":false}]},"material":{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","authors":["程俊英","蔣見元"],"contributorLine":"现代 · 程俊英、蔣見元","era":"现代","publicationYear":1991,"carrier":"PDF"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"这是一首祝人多子多孙的诗，体式与《樛木》相近","targetNotes":"题解与篇章结构说明。","sourceLabel":"第 36 页","sourceNotes":"第 36 页《题解》。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"题解把《螽斯》解释为祝人多子多孙之诗，指出诗人借多子的虫类比喻人的多子，并说明这种托物言志的比体也是《诗经》中常见的艺术手法。作者又将本诗与《樛木》并观，认为两篇都是叠咏体，只在章间更换少数字眼，从而显示语意层层推进而又反复歌咏的效果。","notes":"据第 36 页题解。"}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"螽斯羽，诜诜兮。宜尔子孙，振振兮。","targetNotes":"第一章。","sourceLabel":"第 36 页","sourceNotes":"第 36 页上半。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"螽斯是一类多子的虫，又名蚣蝑、斯螽。诜诜为众多貌。书中又引马瑞辰说“宜”有“多”义，因此“宜尔子孙”就是祝福对方子孙众多；“尔”指被祝贺的人，不宜解作螽斯。至于“振振”，作者从王先谦之说，以为有振奋有为之意，不取毛传“仁厚、信厚”的解释。本章韵读属文部。","notes":"据第 36 页第一章注释。"}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"螽斯羽，薨薨兮。宜尔子孙，绳绳兮。","targetNotes":"第二章。","sourceLabel":"第 36 页","sourceNotes":"第 36 页下半。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"薨薨指昆虫群飞的声音。作者说明这一词可与他书中的同音假借字互证，用来描摹飞动群集之状。绳绳则释为谨慎貌，并据毛传“绳绳，戒慎也”以及《大雅·下武》异文，说明“绳”与“慎”双声通用。本章韵读属蒸部。","notes":"据第 36 页第二章注释。"}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"螽斯羽，揖揖兮。宜尔子孙，蛰蛰兮。","targetNotes":"第三章。","sourceLabel":"第 37 页","sourceNotes":"第 37 页页首。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"揖揖释为群聚貌，书中兼举毛传“会聚也”以及鲁、韩诗作“集集”的异文来说明音义相通。蛰蛰则释为安静貌，并引《尔雅》“蛰，静也”为证。本章韵读属缉部。","notes":"据第 37 页第三章注释。"}]}]}}}
