{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/005-zhong-si/zhuxi-shijichuan-kr1c0009","dataHref":"/__data/shijing/annotation/005-zhong-si/zhuxi-shijichuan-kr1c0009/data.json","title":"詩集傳 · 螽斯 · 注释总览","description":"風 · 周南 · 螽斯 · 汇集《詩集傳》关于《螽斯》的 4 条 annotation，含 5 条 gloss。"},"payload":{"detail":{"route":{"poemId":"005-zhong-si","materialId":"zhuxi-shijichuan-kr1c0009"},"href":"/shijing/annotation/005-zhong-si/zhuxi-shijichuan-kr1c0009","poem":{"id":"005-zhong-si","title":"螽斯","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","螽斯"],"segments":[{"id":"seg-001","text":"螽斯羽","isActive":true},{"id":"seg-002","text":"詵詵兮","isActive":true},{"id":"seg-003","text":"宜爾子孫","isActive":true},{"id":"seg-004","text":"振振兮","isActive":true},{"id":"seg-005","text":"螽斯羽","isActive":false},{"id":"seg-006","text":"薨薨兮","isActive":false},{"id":"seg-007","text":"宜爾子孫","isActive":false},{"id":"seg-008","text":"繩繩兮","isActive":false},{"id":"seg-009","text":"螽斯羽","isActive":false},{"id":"seg-010","text":"揖揖兮","isActive":false},{"id":"seg-011","text":"宜爾子孫","isActive":false},{"id":"seg-012","text":"蟄蟄兮","isActive":false}]},"material":{"id":"zhuxi-shijichuan-kr1c0009","title":"詩集傳","authors":["朱熹"],"contributorLine":"宋 · 朱熹","era":"宋","publicationYear":1186,"carrier":"TXT"},"stats":{"annotationCount":4,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"螽斯羽，詵詵兮。宜爾子孫，振振兮。","targetNotes":"首章并章句说明。","sourceLabel":null,"sourceNotes":"对应 txt 139-143 行。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"朱熹","sectionLabel":"传","text":"比也。螽斯，蝗屬，長而青，角長股，能以股相切作聲，一生九十九子。詵詵，和集貌。爾，指螽斯也。振振，盛貌。","notes":null},{"key":"0001-2","attributionLabel":"朱熹","sectionLabel":"传","text":"比者，以彼物比此物也。后妃不妬忌而子孫衆多，故衆妾以螽斯之羣處和集而子孫衆多比之，言其有是德而宜有是福也。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"螽斯羽，薨薨兮。宜爾子孫，繩繩兮。","targetNotes":"第二章并章句说明。","sourceLabel":null,"sourceNotes":"对应 txt 143-145 行。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"朱熹","sectionLabel":"传","text":"比也。薨薨，羣飛聲。繩繩，不絶貌。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"螽斯羽，揖揖兮。宜爾子孫，蟄蟄兮。","targetNotes":"第三章并章句说明。","sourceLabel":null,"sourceNotes":"对应 txt 145-147 行。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"朱熹","sectionLabel":"传","text":"比也。揖揖，會聚也。蟄蟄，亦多意。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"螽斯三章章四句","targetNotes":"章句总说。","sourceLabel":null,"sourceNotes":"对应 txt 148 行。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"朱熹","sectionLabel":"总评","text":"螽斯三章章四句。","notes":null}]}]}}}
