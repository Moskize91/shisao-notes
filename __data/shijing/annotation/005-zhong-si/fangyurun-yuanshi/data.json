{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/005-zhong-si/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/005-zhong-si/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 螽斯 · 注释总览","description":"風 · 周南 · 螽斯 · 汇集《诗经原始(上下)》关于《螽斯》的 8 条注释，含 8 条注脚。"},"payload":{"detail":{"route":{"poemId":"005-zhong-si","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/005-zhong-si/fangyurun-yuanshi","poem":{"id":"005-zhong-si","title":"螽斯","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","螽斯"],"segments":[{"id":"seg-001","text":"螽斯羽","isActive":false},{"id":"seg-002","text":"詵詵兮","isActive":false},{"id":"seg-003","text":"宜爾子孫","isActive":false},{"id":"seg-004","text":"振振兮","isActive":false},{"id":"seg-005","text":"螽斯羽","isActive":false},{"id":"seg-006","text":"薨薨兮","isActive":false},{"id":"seg-007","text":"宜爾子孫","isActive":false},{"id":"seg-008","text":"繩繩兮","isActive":false},{"id":"seg-009","text":"螽斯羽","isActive":false},{"id":"seg-010","text":"揖揖兮","isActive":false},{"id":"seg-011","text":"宜爾子孫","isActive":false},{"id":"seg-012","text":"蟄蟄兮","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":8,"glossCount":8},"annotations":[{"id":"0001","order":1,"total":8,"layer":"global","layerLabel":"全篇总说","targetText":"题注","targetNotes":"对应 item-0014 题注。","sourceLabel":null,"sourceNotes":"item-0014.txt 第 3 行。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注","text":"题注为“美多男也”，先以祝颂子孙众多点出篇旨。","notes":null}]},{"id":"0002","order":2,"total":8,"layer":"span","layerLabel":"诗句片段","targetText":"螽斯羽，詵詵兮。宜爾子孫，振振兮。","targetNotes":"第一章。","sourceLabel":null,"sourceNotes":"item-0014.txt 第 5 行。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":null,"text":"首章以“比”字点明体例，并于“宜爾子孫”下注“入比意”，说明由螽斯繁衍转入对人间多男之祝颂。","notes":null}]},{"id":"0003","order":3,"total":8,"layer":"span","layerLabel":"诗句片段","targetText":"螽斯羽，薨薨兮。宜爾子孫，繩繩兮。","targetNotes":"第二章。","sourceLabel":null,"sourceNotes":"item-0014.txt 第 6 行。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":null,"text":"第二章承首章递进，以群飞有声、不绝相续之象继续申说子孙众盛。","notes":null}]},{"id":"0004","order":4,"total":8,"layer":"span","layerLabel":"诗句片段","targetText":"螽斯羽，揖揖兮。宜爾子孫，蟄蟄兮。","targetNotes":"第三章。","sourceLabel":null,"sourceNotes":"item-0014.txt 第 7 行。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":null,"text":"第三章转取会聚和集之态，以归结螽斯繁衍、群聚而多子的比兴。","notes":null}]},{"id":"0005","order":5,"total":8,"layer":"global","layerLabel":"全篇总说","targetText":"总评","targetNotes":"对应 item-0014 总评。","sourceLabel":null,"sourceNotes":"item-0014.txt 第 9 行。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"方玉润","sectionLabel":"总评","text":"方玉润辨《小序》《大序》与《集传》皆拘于后妃、众妾之说，主张此篇只是借螽斯为比，泛写文王子孙众多，不必泥定君妃与众妾。","notes":null}]},{"id":"0006","order":6,"total":8,"layer":"global","layerLabel":"全篇总说","targetText":"眉评","targetNotes":"对应 item-0014 眉评。","sourceLabel":null,"sourceNotes":"item-0014.txt 第 11 行。","notes":null,"glosses":[{"key":"0006-1","attributionLabel":"方玉润","sectionLabel":"眉评","text":"眉评谓此诗“只平説，唯六字鍊得甚新”，强调全篇用语平正，而“詵詵、振振、薨薨、繩繩、揖揖、蟄蟄”六字最见炼字之工。","notes":null}]},{"id":"0007","order":7,"total":8,"layer":"global","layerLabel":"全篇总说","targetText":"集释","targetNotes":"对应 item-0014 集释。","sourceLabel":null,"sourceNotes":"item-0014.txt 第 13 行。","notes":null,"glosses":[{"key":"0007-1","attributionLabel":"方玉润","sectionLabel":"集释","text":"集释汇引毛传、孔疏、《集传》与姚际恒诸说，解释螽斯名物、股鸣多子及“詵詵、振振、薨薨、繩繩、揖揖、蟄蟄”等词义，并辨“螽斯”之“斯”可作语辞。","notes":null}]},{"id":"0008","order":8,"total":8,"layer":"global","layerLabel":"全篇总说","targetText":"标韵","targetNotes":"对应 item-0014 标韵。","sourceLabel":null,"sourceNotes":"item-0014.txt 第 15 行。","notes":null,"glosses":[{"key":"0008-1","attributionLabel":"方玉润","sectionLabel":"标韵","text":"标韵分别归“詵、振”为真部，“薨、繩”为蒸部，“揖、蟄”为缉部，三章各自叶本韵。","notes":null}]}]}}}
