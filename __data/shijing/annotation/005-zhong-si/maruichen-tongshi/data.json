{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/005-zhong-si/maruichen-tongshi","dataHref":"/__data/shijing/annotation/005-zhong-si/maruichen-tongshi/data.json","title":"毛詩傳箋通釋 · 螽斯 · 注释总览","description":"風 · 周南 · 螽斯 · 汇集《毛詩傳箋通釋》关于《螽斯》的 4 条 annotation，含 4 条 gloss。"},"payload":{"detail":{"route":{"poemId":"005-zhong-si","materialId":"maruichen-tongshi"},"href":"/shijing/annotation/005-zhong-si/maruichen-tongshi","poem":{"id":"005-zhong-si","title":"螽斯","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","螽斯"],"segments":[{"id":"seg-001","text":"螽斯羽","isActive":false},{"id":"seg-002","text":"詵詵兮","isActive":false},{"id":"seg-003","text":"宜爾子孫","isActive":false},{"id":"seg-004","text":"振振兮","isActive":false},{"id":"seg-005","text":"螽斯羽","isActive":false},{"id":"seg-006","text":"薨薨兮","isActive":false},{"id":"seg-007","text":"宜爾子孫","isActive":false},{"id":"seg-008","text":"繩繩兮","isActive":false},{"id":"seg-009","text":"螽斯羽","isActive":false},{"id":"seg-010","text":"揖揖兮","isActive":false},{"id":"seg-011","text":"宜爾子孫","isActive":false},{"id":"seg-012","text":"蟄蟄兮","isActive":false}]},"material":{"id":"maruichen-tongshi","title":"毛詩傳箋通釋","authors":["馬瑞辰"],"contributorLine":"清 · 馬瑞辰","era":"清","publicationYear":1989,"carrier":"PDF"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"《螽斯》后妃子孙众多之义与名物考辨","targetNotes":"篇首总说。","sourceLabel":"第 83 页","sourceNotes":"位于第 83 页《螽斯》篇题后。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"马瑞辰","sectionLabel":"按","text":"瑞辰承《序》义，以《螽斯》为后妃不妒忌而子孙众多之诗。篇首先考辨螽斯名物，参引《尔雅》《说文》及诸家旧注，辨螽斯、蜤螽、斯螽、蚣蝑等名称相通，皆是蝗类群飞多子的虫。","notes":"依据第 83 页篇题与考释提要。"}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"螽斯羽詵詵兮宜爾子孫振振兮","targetNotes":"首章与训诂提要。","sourceLabel":"第 83-84 页","sourceNotes":"第 83 页末至 84 页上半。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"马瑞辰","sectionLabel":"按","text":"瑞辰谓詵詵与下章薨薨、揖揖皆是形容羽声之盛多，首章重在写其众集纷纭。至于“振振”，仍从毛、郑“仁厚”之训而申其德化所感，认为既祝子孙众多，亦兼祝其类皆仁厚蕃盛。","notes":"依据第 84 页首章考释提要。"}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"螽斯羽薨薨兮宜爾子孫繩繩兮","targetNotes":"第二章。","sourceLabel":"第 84 页","sourceNotes":"第 84 页中段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"马瑞辰","sectionLabel":"按","text":"此章仍从羽声立义。瑞辰顺毛传解释薨薨为声之盛多，并以“繩繩”兼见相续不绝、戒慎有序之意，强调所祝不惟多子，且绵延不替。","notes":"依据第 84 页第二章提要。"}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"螽斯羽揖揖兮宜爾子孫蟄蟄兮","targetNotes":"第三章。","sourceLabel":"第 85 页","sourceNotes":"第 85 页。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"马瑞辰","sectionLabel":"按","text":"瑞辰于末章申说揖揖与聚集相关，蟄蟄则取和集静密之义，三章但更数字，而皆归于群飞和比、蕃衍不绝之旨，由此见本篇反复咏叹以尽后妃子孙盛多之意。","notes":"依据第 85 页第三章提要。"}]}]}}}
