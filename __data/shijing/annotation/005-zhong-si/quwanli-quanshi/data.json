:"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"螽斯羽，薨薨兮。宜爾子孫，繩繩兮。","targetNotes":"第二章。","sourceLabel":"第 48 页局部","sourceNotes":"第 48 页《注释》⑤。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"屈万里","sectionLabel":"注释","text":"繩繩，連續不絕貌。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"螽斯羽，揖揖兮。宜爾子孫，蟄蟄兮。","targetNotes":"第三章。","sourceLabel":"第 48 页局部","sourceNotes":"第 48 页《注释》⑥。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"屈万里","sectionLabel":"注释","text":"蟄蟄，和集貌。","notes":null}]}]}}}
