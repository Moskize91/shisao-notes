{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/001-guan-ju/quwanli-quanshi","dataHref":"/__data/shijing/annotation/001-guan-ju/quwanli-quanshi/data.json","title":"詩經詮釋 · 關雎 · 注释总览","description":"風 · 周南 · 關雎 · 汇集《詩經詮釋》关于《關雎》的 6 条注释，含 6 条注脚。"},"payload":{"detail":{"route":{"poemId":"001-guan-ju","materialId":"quwanli-quanshi"},"href":"/shijing/annotation/001-guan-ju/quwanli-quanshi","poem":{"id":"001-guan-ju","title":"關雎","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","關雎"],"segments":[{"id":"seg-001","text":"關關雎鳩","isActive":false},{"id":"seg-002","text":"在河之洲","isActive":false},{"id":"seg-003","text":"窈窕淑女","isActive":false},{"id":"seg-004","text":"君子好逑","isActive":false},{"id":"seg-005","text":"參差荇菜","isActive":false},{"id":"seg-006","text":"左右流之","isActive":false},{"id":"seg-007","text":"窈窕淑女","isActive":false},{"id":"seg-008","text":"寤寐求之","isActive":false},{"id":"seg-009","text":"求之不得","isActive":false},{"id":"seg-010","text":"寤寐思服","isActive":false},{"id":"seg-011","text":"悠哉悠哉","isActive":false},{"id":"seg-012","text":"輾轉反側","isActive":false},{"id":"seg-013","text":"參差荇菜","isActive":false},{"id":"seg-014","text":"左右采之","isActive":false},{"id":"seg-015","text":"窈窕淑女","isActive":false},{"id":"seg-016","text":"琴瑟友之","isActive":false},{"id":"seg-017","text":"參差荇菜","isActive":false},{"id":"seg-018","text":"左右芼之","isActive":false},{"id":"seg-019","text":"窈窕淑女","isActive":false},{"id":"seg-020","text":"鐘鼓樂之","isActive":false}]},"material":{"id":"quwanli-quanshi","title":"詩經詮釋","authors":["屈萬里"],"contributorLine":"现代 · 屈萬里","era":"现代","publicationYear":1983,"carrier":"PDF"},"stats":{"annotationCount":6,"glossCount":6},"annotations":[{"id":"0001","order":1,"total":6,"layer":"global","layerLabel":"全篇总说","targetText":"《關雎》全篇旨意","targetNotes":"全篇总说。","sourceLabel":"第 43 页","sourceNotes":"第 43 页《注释》①。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"屈万里","sectionLabel":"注释","text":"此诗被解释为祝贺新婚之作。书中据“鐘鼓樂之”与王国维《释乐次》说，推为南国诸侯或其子之婚礼颂辞；又把全篇内容归为三层：首章泛言淑女为君子嘉偶，次章写思求之切，末章写得偶之乐。","notes":"原书以义类统摄全篇，不按今本五章逐章分述。"}]},{"id":"0002","order":2,"total":6,"layer":"term","layerLabel":"字词注","targetText":"關關雎鳩，在河之洲","targetNotes":"首章起兴物象与地理词。","sourceLabel":"第 43 页","sourceNotes":"第 43 页《注释》②至⑤。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"屈万里","sectionLabel":"注释","text":"“關關”为相和之声；“雎”音沮，雎鸠即鱼鹰；《诗经》凡言“河”多指黄河；“洲”为水中可居之地。","notes":null}]},{"id":"0003","order":3,"total":6,"layer":"term","layerLabel":"字词注","targetText":"窈窕淑女，君子好逑","targetNotes":"首章人物品评与婚配词。","sourceLabel":"第 43 页","sourceNotes":"第 43 页《注释》⑥至⑨。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"屈万里","sectionLabel":"注释","text":"“窈窕”音杳挑，指容貌美好；“淑”为善，此指品德；《诗经》中的“君子”多指有官爵者，妇人称夫亦可用之，不同后世专指品德高尚之人；“逑”音求，为匹偶，“好逑”即嘉偶。","notes":null}]},{"id":"0004","order":4,"total":6,"layer":"term","layerLabel":"字词注","targetText":"參差荇菜，左右流之","targetNotes":"第二章起首的景物与动作训释。","sourceLabel":"第 43 页","sourceNotes":"第 43 页《注释》⑩至⑫。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"屈万里","sectionLabel":"注释","text":"“参差”为长短不齐；“荇”音杏，是可食的水生植物，故称荇菜；“流”可训为求，若作流动义解亦通。","notes":null}]},{"id":"0005","order":5,"total":6,"layer":"term","layerLabel":"字词注","targetText":"寤寐求之／寤寐思服／悠哉悠哉","targetNotes":"求而未得时的心理状态词。","sourceLabel":"第 43 页","sourceNotes":"第 43 页《注释》⑬至⑮。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"屈万里","sectionLabel":"注释","text":"“寤寐”犹梦寐；《经传释词》以“思”为句中语助词，“服”为思念；“悠哉悠哉”形容思念绵长深切。","notes":null}]},{"id":"0006","order":6,"total":6,"layer":"term","layerLabel":"字词注","targetText":"輾轉反側／左右采之／琴瑟友之／左右芼之","targetNotes":"第 44 页页首续出的末四则术语注。","sourceLabel":"第 44 页局部","sourceNotes":"仅取第 44 页《葛覃》标题前《关雎》注释⑯至⑲。","notes":null,"glosses":[{"key":"0006-1","attributionLabel":"屈万里","sectionLabel":"注释","text":"“輾”是转之半，“反侧”犹反覆；“采”即採字；“友”为亲；“芼”音冒，训为择。","notes":null}]}]}}}
