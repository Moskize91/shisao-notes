{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/001-guan-ju/zhuxi-shijichuan-kr1c0009","dataHref":"/__data/shijing/annotation/001-guan-ju/zhuxi-shijichuan-kr1c0009/data.json","title":"詩集傳 · 關雎 · 注释总览","description":"風 · 周南 · 關雎 · 汇集《詩集傳》关于《關雎》的 5 条 annotation，含 9 条 gloss。"},"payload":{"detail":{"route":{"poemId":"001-guan-ju","materialId":"zhuxi-shijichuan-kr1c0009"},"href":"/shijing/annotation/001-guan-ju/zhuxi-shijichuan-kr1c0009","poem":{"id":"001-guan-ju","title":"關雎","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","關雎"],"segments":[{"id":"seg-001","text":"關關雎鳩","isActive":true},{"id":"seg-002","text":"在河之洲","isActive":true},{"id":"seg-003","text":"窈窕淑女","isActive":true},{"id":"seg-004","text":"君子好逑","isActive":true},{"id":"seg-005","text":"參差荇菜","isActive":false},{"id":"seg-006","text":"左右流之","isActive":false},{"id":"seg-007","text":"窈窕淑女","isActive":false},{"id":"seg-008","text":"寤寐求之","isActive":false},{"id":"seg-009","text":"求之不得","isActive":false},{"id":"seg-010","text":"寤寐思服","isActive":false},{"id":"seg-011","text":"悠哉悠哉","isActive":false},{"id":"seg-012","text":"輾轉反側","isActive":false},{"id":"seg-013","text":"參差荇菜","isActive":false},{"id":"seg-014","text":"左右采之","isActive":false},{"id":"seg-015","text":"窈窕淑女","isActive":false},{"id":"seg-016","text":"琴瑟友之","isActive":false},{"id":"seg-017","text":"參差荇菜","isActive":false},{"id":"seg-018","text":"左右芼之","isActive":false},{"id":"seg-019","text":"窈窕淑女","isActive":false},{"id":"seg-020","text":"鐘鼓樂之","isActive":false}]},"material":{"id":"zhuxi-shijichuan-kr1c0009","title":"詩集傳","authors":["朱熹"],"contributorLine":"宋 · 朱熹","era":"宋","publicationYear":1186,"carrier":"TXT"},"stats":{"annotationCount":5,"glossCount":9},"annotations":[{"id":"0001","order":1,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"關關雎鳩，在河之洲。窈窕淑女，君子好逑。","targetNotes":"首章并首段章句说明。","sourceLabel":null,"sourceNotes":"对应 txt 约 36-50 行。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"朱熹","sectionLabel":"传","text":"興也。關關，雌雄相應之和聲。雎鳩，水鳥，一名王雎，生有定偶而不相亂，偶常並遊而不相狎。洲，水中可居之地。窈窕，幽閒之意。淑，善也。逑，匹也。","notes":null},{"key":"0001-2","attributionLabel":"朱熹","sectionLabel":"传","text":"朱子以此章為起興：先言雎鳩之和鳴有别，以引窈窕淑女與君子之善匹；其義在和樂而恭敬。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"參差荇菜，左右流之。窈窕淑女，寤寐求之。求之不得，寤寐思服。悠哉悠哉，輾轉反側。","targetNotes":"二、三章合说。","sourceLabel":null,"sourceNotes":"对应 txt 约 51-60 行。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"朱熹","sectionLabel":"传","text":"興也。參差，長短不齊之貌。荇，接余也，根生水底，葉浮水面。流，順水之流而取之。寤寐，言無時。服，猶懷。悠，長也。輾轉反側，皆卧不安席之意。","notes":null},{"key":"0002-2","attributionLabel":"朱熹","sectionLabel":"传","text":"此章本其未得而言：此人此德世不常有，求之不得，則無以配君子而成内治，故憂思之深不能自已。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"參差荇菜，左右采之。窈窕淑女，琴瑟友之。參差荇菜，左右芼之。窈窕淑女，鐘鼓樂之。","targetNotes":"四、五章合说。","sourceLabel":null,"sourceNotes":"对应 txt 约 61-69 行。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"朱熹","sectionLabel":"传","text":"興也。采，采取而擇之。芼，熟而薦之。琴瑟為絲屬，樂之小者；鐘鼓為金革之屬，樂之大者。友者親愛之意，樂則和平之極。","notes":null},{"key":"0003-2","attributionLabel":"朱熹","sectionLabel":"传","text":"此章據既得而言：既得淑女，則可以配君子而成内治，故其喜樂尊奉之意不能自已。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"章句与分章","targetNotes":"全篇结构说明。","sourceLabel":null,"sourceNotes":"对应 txt 70-71 行。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"朱熹","sectionLabel":"章句","text":"關雎三章：一章四句，二章章八句。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"总评与诗教定位","targetNotes":"全篇总论。","sourceLabel":null,"sourceNotes":"对应 txt 71-82 行。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"孔子、朱熹","sectionLabel":"总评","text":"孔子曰：關雎樂而不淫，哀而不傷。朱子谓此詩得性情之正、聲氣之和：德如雎鳩之有别，則后妃之正可見其端；寤寐反側、琴瑟鐘鼓極其哀樂而不過其則，則詩人性情之正可見其全體。","notes":null},{"key":"0005-2","attributionLabel":"康衡","sectionLabel":"总评","text":"康衡曰：妃匹之際，生民之始，萬福之原。婚姻之禮正，然後品物遂而天命全。論詩以關雎爲始，正在其可以為人倫教化之端。","notes":null}]}]}}}
