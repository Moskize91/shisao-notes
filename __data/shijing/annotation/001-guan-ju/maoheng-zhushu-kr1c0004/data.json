{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/001-guan-ju/maoheng-zhushu-kr1c0004","dataHref":"/__data/shijing/annotation/001-guan-ju/maoheng-zhushu-kr1c0004/data.json","title":"毛詩注疏 · 關雎 · 注释总览","description":"風 · 周南 · 關雎 · 汇集《毛詩注疏》关于《關雎》的 12 条 annotation，含 33 条 gloss。"},"payload":{"detail":{"route":{"poemId":"001-guan-ju","materialId":"maoheng-zhushu-kr1c0004"},"href":"/shijing/annotation/001-guan-ju/maoheng-zhushu-kr1c0004","poem":{"id":"001-guan-ju","title":"關雎","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","關雎"],"segments":[{"id":"seg-001","text":"關關雎鳩","isActive":false},{"id":"seg-002","text":"在河之洲","isActive":false},{"id":"seg-003","text":"窈窕淑女","isActive":false},{"id":"seg-004","text":"君子好逑","isActive":false},{"id":"seg-005","text":"參差荇菜","isActive":false},{"id":"seg-006","text":"左右流之","isActive":false},{"id":"seg-007","text":"窈窕淑女","isActive":false},{"id":"seg-008","text":"寤寐求之","isActive":false},{"id":"seg-009","text":"求之不得","isActive":false},{"id":"seg-010","text":"寤寐思服","isActive":false},{"id":"seg-011","text":"悠哉悠哉","isActive":false},{"id":"seg-012","text":"輾轉反側","isActive":false},{"id":"seg-013","text":"參差荇菜","isActive":false},{"id":"seg-014","text":"左右采之","isActive":false},{"id":"seg-015","text":"窈窕淑女","isActive":false},{"id":"seg-016","text":"琴瑟友之","isActive":false},{"id":"seg-017","text":"參差荇菜","isActive":false},{"id":"seg-018","text":"左右芼之","isActive":false},{"id":"seg-019","text":"窈窕淑女","isActive":false},{"id":"seg-020","text":"鐘鼓樂之","isActive":false}]},"material":{"id":"maoheng-zhushu-kr1c0004","title":"毛詩注疏","authors":["毛亨","鄭氏","孔穎達"],"contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","era":"漢唐","publicationYear":653,"carrier":"TXT"},"stats":{"annotationCount":12,"glossCount":33},"annotations":[{"id":"0001","order":1,"total":12,"layer":"preface","layerLabel":"篇序","targetText":"序《關雎》","targetNotes":"篇首小序与其疏。","sourceLabel":null,"sourceNotes":"对应 txt 约 13-39 行（序文）与 18-33 行（序疏）。","notes":"作为全篇序文锚点。","glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序","text":"序：關雎后妃之徳也。風之始也，所以風天下而正夫婦也，故用之鄉人焉，用之邦國焉。","notes":"录序文主干。"},{"key":"0001-2","attributionLabel":"孔疏","sectionLabel":null,"text":"正義曰：此篇言后妃性行和諧、貞專、寤寐求賢、供奉職事，是后妃之德。夫婦正則父子親，父子親則君臣敬。","notes":"录序疏总旨。"}]},{"id":"0002","order":2,"total":12,"layer":"global","layerLabel":"全篇总说","targetText":"章句与篇制总说","targetNotes":"关雎章句与疏家总说。","sourceLabel":null,"sourceNotes":"对应 txt 约 542-560 行。","notes":"全篇章法说明。","glosses":[{"key":"0002-1","attributionLabel":"章句","sectionLabel":null,"text":"關雎五章章四句；毛公旧分作三章（一章四句，二章章八句）。","notes":null},{"key":"0002-2","attributionLabel":"孔疏","sectionLabel":null,"text":"正義就章句体例申说：句以联字为言，章以积句成义，篇以总章见意；并以《關雎》四言句为例说明。","notes":"摘录总意，不尽录术语细部。"}]},{"id":"0003","order":3,"total":12,"layer":"span","layerLabel":"诗句片段","targetText":"關關雎鳩／在河之洲","targetNotes":"首章前二句。","sourceLabel":null,"sourceNotes":"对应 txt 约 427-433 行及 442-457 行。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"毛传","sectionLabel":null,"text":"興也。關關，和聲也。雎鳩，王雎也。鳥摯而有別。水中可居者曰洲。后妃說樂君子之德，無不和諧，又不淫其色。","notes":null},{"key":"0003-2","attributionLabel":"郑笺","sectionLabel":null,"text":"摯之言至也，謂王雎之鳥雌雄情意至然而有別。","notes":null},{"key":"0003-3","attributionLabel":"孔疏","sectionLabel":null,"text":"正義申毛义：以雎鳩雌雄情至而有别，兴后妃說樂君子而不淫其色；并引釋鳥、釋水诸说辨王雎与洲渚义。","notes":null}]},{"id":"0004","order":4,"total":12,"layer":"span","layerLabel":"诗句片段","targetText":"窈窕淑女／君子好逑","targetNotes":"首章后二句。","sourceLabel":null,"sourceNotes":"对应 txt 约 433-437 行及 459-463 行。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"毛传","sectionLabel":null,"text":"窈窕，幽閒也。淑，善。逑，匹也。言后妃有關雎之德，是幽閒貞專之善女，宜為君子之好匹。","notes":null},{"key":"0004-2","attributionLabel":"郑笺","sectionLabel":null,"text":"怨耦曰仇。言后妃之德和諧，則幽閒處深宫、貞專之善女能為君子和好眾妾之怨者。","notes":null},{"key":"0004-3","attributionLabel":"孔疏","sectionLabel":null,"text":"正義云逑、仇異音義同，總言宜求為君子好匹；又辨鄭箋“三夫人九嬪以下”所指与范围。","notes":null}]},{"id":"0005","order":5,"total":12,"layer":"span","layerLabel":"诗句片段","targetText":"參差荇菜／左右流之","targetNotes":"第二章前二句。","sourceLabel":null,"sourceNotes":"对应 txt 约 472-474 行及 486-494 行。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"毛传","sectionLabel":null,"text":"荇，接余也。流，求也。后妃有關雎之德，乃能共荇菜備庶物，以事宗廟也。","notes":null},{"key":"0005-2","attributionLabel":"郑笺","sectionLabel":null,"text":"左右，助也。将共荇菜之葅，必有助而求之者。","notes":null},{"key":"0005-3","attributionLabel":"孔疏","sectionLabel":null,"text":"正義兼釋荇菜形质与祭用，并据“左右流之”申明淑女佐助后妃求菜；对毛、鄭两家在“祭时/未祭时”的说法分别辨析。","notes":null}]},{"id":"0006","order":6,"total":12,"layer":"span","layerLabel":"诗句片段","targetText":"窈窕淑女／寤寐求之","targetNotes":"第二章后二句。","sourceLabel":null,"sourceNotes":"对应 txt 约 476-477 行及 481-485 行。","notes":null,"glosses":[{"key":"0006-1","attributionLabel":"毛传","sectionLabel":null,"text":"寤，覺；寐，寢也。","notes":null},{"key":"0006-2","attributionLabel":"郑笺","sectionLabel":null,"text":"后妃覺寐則常求此賢女，欲與之共已職也。","notes":null},{"key":"0006-3","attributionLabel":"孔疏","sectionLabel":null,"text":"正義以“寤寐求之”为后妃常求淑女之状，連上“左右流之”说明其求贤以共事宗庙。","notes":null}]},{"id":"0007","order":7,"total":12,"layer":"span","layerLabel":"诗句片段","targetText":"求之不得／寤寐思服／悠哉悠哉／輾轉反側","targetNotes":"第三章。","sourceLabel":null,"sourceNotes":"对应 txt 约 500-504 行及 505-510 行。","notes":null,"glosses":[{"key":"0007-1","attributionLabel":"毛传","sectionLabel":null,"text":"服，思之也。悠，思也。臥而不周曰輾。","notes":null},{"key":"0007-2","attributionLabel":"郑笺","sectionLabel":null,"text":"服，事也。求賢女而不得，覺寐則思己職事當誰與共；“思之哉”言其誠思之。","notes":null},{"key":"0007-3","attributionLabel":"孔疏","sectionLabel":null,"text":"正義详辨“服”之训（思/事）与“輾轉反側”皆卧不安之貌，谓求贤未得而忧思深切。","notes":null}]},{"id":"0008","order":8,"total":12,"layer":"span","layerLabel":"诗句片段","targetText":"參差荇菜／左右采之／窈窕淑女／琴瑟友之","targetNotes":"第四章。","sourceLabel":null,"sourceNotes":"对应 txt 约 512-515 行及 516-528 行。","notes":null,"glosses":[{"key":"0008-1","attributionLabel":"毛传","sectionLabel":null,"text":"宜以琴瑟友樂之。","notes":null},{"key":"0008-2","attributionLabel":"郑笺","sectionLabel":null,"text":"后妃既得荇菜，必有助而采之者。同志為友，言賢女助后妃共荇菜，其情意乃與琴瑟之志同。","notes":null},{"key":"0008-3","attributionLabel":"孔疏","sectionLabel":null,"text":"正義并陈毛、鄭：毛主“設樂以待淑女”，鄭主“祭时上下同樂”；并释“友”取情志和同之义。","notes":null}]},{"id":"0009","order":9,"total":12,"layer":"span","layerLabel":"诗句片段","targetText":"參差荇菜／左右芼之／窈窕淑女／鐘鼓樂之","targetNotes":"第五章。","sourceLabel":null,"sourceNotes":"对应 txt 约 532-535 行及 536-541 行。","notes":null,"glosses":[{"key":"0009-1","attributionLabel":"毛传","sectionLabel":null,"text":"芼，擇也。德盛者宜有鐘鼓之樂。","notes":null},{"key":"0009-2","attributionLabel":"郑笺","sectionLabel":null,"text":"后妃既得荇菜，必有助而擇之者。琴瑟在堂，鐘鼓在庭，言共荇菜之時上下之樂皆作，盛其禮也。","notes":null},{"key":"0009-3","attributionLabel":"孔疏","sectionLabel":null,"text":"正義釋“芼”為拔而擇，並據《皋陶謨》及禮文申“琴瑟在堂、鐘鼓在庭”，以明祭時樂作之禮。","notes":null}]},{"id":"0010","order":10,"total":12,"layer":"term","layerLabel":"字词注","targetText":"君子好逑","targetNotes":"术语层：逑/仇异文。","sourceLabel":null,"sourceNotes":"对应 txt 约 434-435 行、441 行、460-461 行。","notes":null,"glosses":[{"key":"0010-1","attributionLabel":"毛传","sectionLabel":null,"text":"逑，匹也。","notes":null},{"key":"0010-2","attributionLabel":"音义","sectionLabel":"音义","text":"音義：逑音求，本亦作仇，音同。","notes":null},{"key":"0010-3","attributionLabel":"孔疏","sectionLabel":null,"text":"正義：詩本作逑，爾雅多作仇，異音義同；孫炎曰“相求之匹”。","notes":null}]},{"id":"0011","order":11,"total":12,"layer":"term","layerLabel":"字词注","targetText":"左右流之","targetNotes":"术语层：流字训释。","sourceLabel":null,"sourceNotes":"对应 txt 约 472 行与 487-489 行。","notes":null,"glosses":[{"key":"0011-1","attributionLabel":"毛传","sectionLabel":null,"text":"流，求也。","notes":null},{"key":"0011-2","attributionLabel":"孔疏","sectionLabel":null,"text":"正義：流求为《釋言》文；并以经下“寤寐求之”申其训，兼辨“左右流之”与祭事关联。","notes":null}]},{"id":"0012","order":12,"total":12,"layer":"term","layerLabel":"字词注","targetText":"輾轉反側","targetNotes":"术语层：輾、轉、反側。","sourceLabel":null,"sourceNotes":"对应 txt 约 503-510 行。","notes":null,"glosses":[{"key":"0012-1","attributionLabel":"毛传","sectionLabel":null,"text":"悠，思也。臥而不周曰輾。","notes":null},{"key":"0012-2","attributionLabel":"郑笺","sectionLabel":null,"text":"思之哉，思之哉，言已誠思之。","notes":null},{"key":"0012-3","attributionLabel":"孔疏","sectionLabel":null,"text":"正義谓“反側亦臥而不正；反側既為一，則輾轉亦為一”，皆忧思深切、卧不安之貌。","notes":null}]}]}}}
