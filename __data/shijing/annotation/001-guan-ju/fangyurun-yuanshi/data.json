{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/001-guan-ju/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/001-guan-ju/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 關雎 · 注释总览","description":"風 · 周南 · 關雎 · 汇集《诗经原始(上下)》关于《關雎》的 12 条 annotation，含 12 条 gloss。"},"payload":{"detail":{"route":{"poemId":"001-guan-ju","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/001-guan-ju/fangyurun-yuanshi","poem":{"id":"001-guan-ju","title":"關雎","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","關雎"],"segments":[{"id":"seg-001","text":"關關雎鳩","isActive":false},{"id":"seg-002","text":"在河之洲","isActive":false},{"id":"seg-003","text":"窈窕淑女","isActive":false},{"id":"seg-004","text":"君子好逑","isActive":false},{"id":"seg-005","text":"參差荇菜","isActive":false},{"id":"seg-006","text":"左右流之","isActive":false},{"id":"seg-007","text":"窈窕淑女","isActive":false},{"id":"seg-008","text":"寤寐求之","isActive":false},{"id":"seg-009","text":"求之不得","isActive":false},{"id":"seg-010","text":"寤寐思服","isActive":false},{"id":"seg-011","text":"悠哉悠哉","isActive":false},{"id":"seg-012","text":"輾轉反側","isActive":false},{"id":"seg-013","text":"參差荇菜","isActive":false},{"id":"seg-014","text":"左右采之","isActive":false},{"id":"seg-015","text":"窈窕淑女","isActive":false},{"id":"seg-016","text":"琴瑟友之","isActive":false},{"id":"seg-017","text":"參差荇菜","isActive":false},{"id":"seg-018","text":"左右芼之","isActive":false},{"id":"seg-019","text":"窈窕淑女","isActive":false},{"id":"seg-020","text":"鐘鼓樂之","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":12,"glossCount":12},"annotations":[{"id":"0001","order":1,"total":12,"layer":"global","layerLabel":"全篇总说","targetText":"题注与全篇章次","targetNotes":"对应 item-0010 开头题注与五章总起。","sourceLabel":null,"sourceNotes":"item-0010.txt 第 3-10 行。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注","text":"题注为“樂得淑女以配君子也”。正文先以五章次第总提：首章总冒，二章写“求之”过程，三章转入“求之不得”与反侧之情，四五章写既得之后由“友”至“樂”的层层推进。","notes":null}]},{"id":"0002","order":2,"total":12,"layer":"span","layerLabel":"诗句片段","targetText":"關關雎鳩 在河之洲 窈窕淑女 君子好逑","targetNotes":"第一章。","sourceLabel":null,"sourceNotes":"item-0010.txt 第 5 行第一分句。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":null,"text":"“興起，却兼比意”。作者指出本章既是起兴，同时兼具比体；并云“承明正意，仍是總冒”，强调其统摄全篇的开篇功能。","notes":null}]},{"id":"0003","order":3,"total":12,"layer":"span","layerLabel":"诗句片段","targetText":"參差荇菜 左右流之 窈窕淑女 寤寐求之","targetNotes":"第二章。","sourceLabel":null,"sourceNotes":"item-0010.txt 第 6 行。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":null,"text":"“參差荇菜”在本章被明确为“興而比，下同”。“左右流之”与“寤寐求之”并举，形成“物之流动”与“人之求索”的并行结构。","notes":null}]},{"id":"0004","order":4,"total":12,"layer":"span","layerLabel":"诗句片段","targetText":"求之不得 寤寐思服 悠哉悠哉 輾轉反側","targetNotes":"第三章。","sourceLabel":null,"sourceNotes":"item-0010.txt 第 7 行。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":null,"text":"作者特标“根上‘求’字，忽生出‘不得’一層，文心乃曲”，点出全篇情势在本章发生转折，由求而不得，故有“思服”“反側”之深情。","notes":null}]},{"id":"0005","order":5,"total":12,"layer":"span","layerLabel":"诗句片段","targetText":"參差荇菜 左右采之 窈窕淑女 琴瑟友之","targetNotes":"第四章。","sourceLabel":null,"sourceNotes":"item-0010.txt 第 8 行。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"方玉润","sectionLabel":null,"text":"此章进入“既得情景”。作者提示“以下皆言既得情景，而用字自有深淺不同處”，说明四五章虽同写得偶之乐，但语义力度递进。","notes":null}]},{"id":"0006","order":6,"total":12,"layer":"span","layerLabel":"诗句片段","targetText":"參差荇菜 左右芼之 窈窕淑女 鐘鼓樂之","targetNotes":"第五章。","sourceLabel":null,"sourceNotes":"item-0010.txt 第 9 行。","notes":null,"glosses":[{"key":"0006-1","attributionLabel":"方玉润","sectionLabel":null,"text":"第五章承第四章而更进一层，以“鐘鼓樂之”完成乐意高潮，与前章“琴瑟友之”形成由亲狎到礼乐的层级展开。","notes":null}]},{"id":"0007","order":7,"total":12,"layer":"global","layerLabel":"全篇总说","targetText":"方玉润本论","targetNotes":"“右《關雎》五章”总论段。","sourceLabel":null,"sourceNotes":"item-0010.txt 第 11 行。","notes":null,"glosses":[{"key":"0007-1","attributionLabel":"方玉润","sectionLabel":"总论","text":"作者不取“后妃自咏”与“宫人咏大姒文王”的定指说，主张此篇本为周地民间初昏歌诗，故可作房中乐而被于乡邦。又提出：即便不实指文王大姒，仍可视为文王大姒德化及民后所形成之正风。","notes":null}]},{"id":"0008","order":8,"total":12,"layer":"global","layerLabel":"全篇总说","targetText":"附録姚际恒驳序","targetNotes":"附录段落，集中驳《序》《传》系统。","sourceLabel":null,"sourceNotes":"item-0010.txt 第 13 行。","notes":null,"glosses":[{"key":"0008-1","attributionLabel":"姚际恒","sectionLabel":"附录","text":"附录主旨是反对“后妃自咏、淑女指妾媵”说，提出“四不可通”：雎鳩兴义、君子淑女对举、逑仇义位、琴瑟义例皆与妾媵说相违。并批评后世反复附会，最后仍回到“初昏嘉耦、可以正邦国风天下”的解释框架。","notes":null}]},{"id":"0009","order":9,"total":12,"layer":"global","layerLabel":"全篇总说","targetText":"眉评","targetNotes":"眉评段落。","sourceLabel":null,"sourceNotes":"item-0010.txt 第 15 行。","notes":null,"glosses":[{"key":"0009-1","attributionLabel":"眉评","sectionLabel":null,"text":"眉评强调首章“和平中正”之音为全篇核心；三章骤转为“繁弦促音”以收束精神；四五章“友”“樂”递进而不侈靡，契合“樂而不淫”。","notes":null}]},{"id":"0010","order":10,"total":12,"layer":"term","layerLabel":"字词注","targetText":"關關雎鳩","targetNotes":"集释中关于“雎鳩”的训解。","sourceLabel":null,"sourceNotes":"item-0010.txt 第 17 行中“集釋”起首至“窈窕”条目前。","notes":null,"glosses":[{"key":"0010-1","attributionLabel":"集释","sectionLabel":null,"text":"集释汇合《集传》与姚际恒等说：雎鳩可据“定偶不乱”理解其比德作用，但对“摯而有别”的过度附会亦多所辨析，强调不可脱离“關關”声意而空谈德目。","notes":null}]},{"id":"0011","order":11,"total":12,"layer":"term","layerLabel":"字词注","targetText":"窈窕淑女／君子好逑／左右流之／寤寐思服／輾轉反側／左右芼之","targetNotes":"集释中关键训诂组。","sourceLabel":null,"sourceNotes":"item-0010.txt 第 17 行中“窈窕”条后半至“芼熟而薦之也”。","notes":null,"glosses":[{"key":"0011-1","attributionLabel":"集释","sectionLabel":null,"text":"集释对“窈窕”侧重幽闲义而反对机械等同深宫；“逑”释匹；“流”不主强训为“求”，更重其随水无方以引“求之不得”；“輾轉反側”释卧不安；“芼”释熟择而荐。整体强调诗中语义递进与兴比结构。","notes":null}]},{"id":"0012","order":12,"total":12,"layer":"global","layerLabel":"全篇总说","targetText":"标韵","targetNotes":"韵读总表。","sourceLabel":null,"sourceNotes":"item-0010.txt 第 19 行。","notes":null,"glosses":[{"key":"0012-1","attributionLabel":"标韵","sectionLabel":null,"text":"标韵将“鳩、洲、逑、流、求、得、服、側、采、友、芼、樂”等字分别归入今韵并注通叶关系，说明“屋/職”等在古音可通，体现全篇韵脚的系统性说明。","notes":null}]}]}}}
