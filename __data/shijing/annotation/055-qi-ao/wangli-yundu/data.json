ions":[{"id":"0001","order":1,"total":3,"layer":"span","layerLabel":"诗句片段","targetText":"瞻彼淇奥，绿竹猗猗。有匪君子，如切如磋，如琢如磨。瑟兮僩兮，赫兮咺兮。有匪君子，终不可谖兮。","targetNotes":"第一章。","sourceLabel":"第 168-169 页","sourceNotes":"第 168-169 页《淇奥》第一章，起于页 168 页底，续于页 169。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"王力","sectionLabel":"韵读"}]},{"id":"0002","order":2,"total":3,"layer":"span","layerLabel":"诗句片段","targetText":"瞻彼淇奥，绿竹青青。有匪君子，充耳琇莹，会弁如星。瑟兮僩兮，赫兮咺兮。有匪君子，终不可谖兮。","targetNotes":"第二章。","sourceLabel":"第 169 页局部","sourceNotes":"第 169 页《淇奥》第二章。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"王力","sectionLabel":"韵读"}]},{"id":"0003","order":3,"total":3,"layer":"span","layerLabel":"诗句片段","targetText":"瞻彼淇奥，绿竹如箦。有匪君子，如金如锡，如圭如璧。宽兮绰兮，猗重较兮。善戏谑兮，不为虐兮。","targetNotes":"第三章。","sourceLabel":"第 169 页局部","sourceNotes":"第 169 页《淇奥》第三章；下接《考槃》。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"王力","sectionLabel":"韵读"}]}]}}}
