onCount":2,"glossCount":2},"annotations":[{"id":"0001","order":1,"total":2,"layer":"preface","layerLabel":"篇序","targetText":"淇奧美武公之德也有文章又能聽其規諫以禮自防故能入相于周美而作是詩也","targetNotes":"诗序","sourceLabel":"第 121 页","sourceNotes":"卷五页121，《淇奧》篇首小序。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序"}]},{"id":"0002","order":2,"total":2,"layer":"span","layerLabel":"诗句片段","targetText":"瞻彼淇奧，綠竹猗猗。有匪君子，如切如磋，如琢如磨。瑟兮僴兮，赫兮咺兮。有匪君子，終不可諼兮。瞻彼淇奧，綠竹青青。有匪君子，充耳瑩瑩，會弁如星。瑟兮僴兮，赫兮咺兮。有匪君子，終不可諼兮。瞻彼淇奧，綠竹如箦。有匪君子，如金如錫，如圭如璧。寬兮綽兮，倚重較兮。善戲謔兮，不爲虐兮。","targetNotes":"通篇经文","sourceLabel":"第 123-124 页","sourceNotes":"卷五页123-124，《淇奧》通篇经文；124页收至篇末。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"陈奂","sectionLabel":"传疏"}]}]}}}
