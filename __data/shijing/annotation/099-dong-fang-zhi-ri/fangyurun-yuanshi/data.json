{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/099-dong-fang-zhi-ri/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/099-dong-fang-zhi-ri/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 東方之日 · 注释总览","description":"風 · 齊風 · 東方之日 · 汇集《诗经原始(上下)》关于《東方之日》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"099-dong-fang-zhi-ri","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/099-dong-fang-zhi-ri/fangyurun-yuanshi","poem":{"id":"099-dong-fang-zhi-ri","title":"東方之日","categoryId":"feng","subcategoryId":"qifeng","path":["風","齊風","東方之日"],"segments":[{"id":"seg-001","text":"東方之日兮","isActive":false},{"id":"seg-002","text":"彼姝者子","isActive":false},{"id":"seg-003","text":"在我室兮","isActive":false},{"id":"seg-004","text":"在我室兮","isActive":false},{"id":"seg-005","text":"履我即兮","isActive":false},{"id":"seg-006","text":"東方之月兮","isActive":false},{"id":"seg-007","text":"彼姝者子","isActive":false},{"id":"seg-008","text":"在我闥兮","isActive":false},{"id":"seg-009","text":"在我闥兮","isActive":false},{"id":"seg-010","text":"履我發兮","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"刺荒淫也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 篇首题注。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注"}]},{"id":"0002","order":2,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"右《東方之日》二章，章五句。此詩刺淫，必有所指，非泛然也。故孔氏謂「刺哀公」，僞傳、説謂「刺莊公」，何玄子謂「刺襄公」。雖皆無據，而寢闥之内，一任彼姝朝來暮往，則終日昏昏、内作色荒也可知。士庶之家尚且不可，況宫闈乎？此詩之作，詎能無故？然言者雖不可考，而聞者正當以爲戒也。","targetNotes":"总评原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"总评"}]},{"id":"0003","order":3,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"履躡也。即〔《集傳》〕即，言此女躡我之跡而相就也。闥〔陸氏德明曰〕《韓詩》云：「門屏之間曰闥。」發行去也。〔孔氏穎達曰〕行必發足而去，故以發爲行也。〔《集傳》曰〕言躡我而行去也。","targetNotes":"集释原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"集釋"}]},{"id":"0004","order":4,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"日四質。室同。即十三職。通韻。月六月。闥七曷。發六月。通韻。","targetNotes":"标韵原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标韵段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":"標韻"}]}]}}}
