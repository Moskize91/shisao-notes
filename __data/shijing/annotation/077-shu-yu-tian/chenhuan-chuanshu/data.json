{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/077-shu-yu-tian/chenhuan-chuanshu","dataHref":"/__data/shijing/annotation/077-shu-yu-tian/chenhuan-chuanshu/data.json","title":"詩毛氏傳疏 · 叔于田 · 注释总览","description":"風 · 鄭風 · 叔于田 · 汇集《詩毛氏傳疏》关于《叔于田》的 1 条注释，含 1 条注脚。"},"payload":{"detail":{"route":{"poemId":"077-shu-yu-tian","materialId":"chenhuan-chuanshu"},"href":"/shijing/annotation/077-shu-yu-tian/chenhuan-chuanshu","poem":{"id":"077-shu-yu-tian","title":"叔于田","categoryId":"feng","subcategoryId":"zhengfeng","path":["風","鄭風","叔于田"],"segments":[{"id":"seg-001","text":"叔于田","isActive":true},{"id":"seg-002","text":"巷無居人","isActive":true},{"id":"seg-003","text":"豈無居人","isActive":true},{"id":"seg-004","text":"不如叔也","isActive":true},{"id":"seg-005","text":"洵美且仁","isActive":true},{"id":"seg-006","text":"叔于狩","isActive":true},{"id":"seg-007","text":"巷無飲酒","isActive":true},{"id":"seg-008","text":"豈無飲酒","isActive":true},{"id":"seg-009","text":"不如叔也","isActive":true},{"id":"seg-010","text":"洵美且好","isActive":true},{"id":"seg-011","text":"叔適野","isActive":true},{"id":"seg-012","text":"巷無服馬","isActive":true},{"id":"seg-013","text":"豈無服馬","isActive":true},{"id":"seg-014","text":"不如叔也","isActive":true},{"id":"seg-015","text":"洵美且武","isActive":true}]},"material":{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","authors":["陳奐"],"contributorLine":"清 · 陳奐","era":"清","publicationYear":1847,"carrier":"PDF"},"stats":{"annotationCount":1,"glossCount":1},"annotations":[{"id":"0001","order":1,"total":1,"layer":"span","layerLabel":"诗句片段","targetText":"叔于田，巷無居人。豈無居人？不如叔也，洵美且仁。叔于狩，巷無飲酒。豈無飲酒？不如叔也，洵美且好。叔適野，巷無服馬。豈無服馬？不如叔也，洵美且武。","targetNotes":"全篇疏义。","sourceLabel":"第 81-82 页","sourceNotes":"据 /private/tmp/077-chen-hi/p91.png、p92.png 定位。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"陈奂疏《叔于田》，仍从《序》刺庄公纵弟之说，谓篇中极称叔段田猎、饮酒、服马之盛，正是反衬庄公不能制弟而任其骄恣，并借众口争称之辞以寓警。","notes":"依据页图 /private/tmp/077-chen-hi/p91.png、p92.png 保守摘录。"}]}]}}}
