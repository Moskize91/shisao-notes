{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/045-bai-zhou/quwanli-quanshi","dataHref":"/__data/shijing/annotation/045-bai-zhou/quwanli-quanshi/data.json","title":"詩經詮釋 · 柏舟 · 注释总览","description":"風 · 鄘風 · 柏舟 · 汇集《詩經詮釋》关于《柏舟》的 2 条注释，含 2 条注脚。"},"payload":{"detail":{"route":{"poemId":"045-bai-zhou","materialId":"quwanli-quanshi"},"href":"/shijing/annotation/045-bai-zhou/quwanli-quanshi","poem":{"id":"045-bai-zhou","title":"柏舟","categoryId":"feng","subcategoryId":"yongfeng","path":["風","鄘風","柏舟"],"segments":[{"id":"seg-001","text":"汎彼柏舟","isActive":false},{"id":"seg-002","text":"在彼中河","isActive":false},{"id":"seg-003","text":"髧彼兩髦","isActive":false},{"id":"seg-004","text":"實維我儀","isActive":false},{"id":"seg-005","text":"之死矢靡它","isActive":false},{"id":"seg-006","text":"母也天只","isActive":false},{"id":"seg-007","text":"不諒人只","isActive":false},{"id":"seg-008","text":"汎彼柏舟","isActive":false},{"id":"seg-009","text":"在彼河側","isActive":false},{"id":"seg-010","text":"髧彼兩髦","isActive":false},{"id":"seg-011","text":"實維我特","isActive":false},{"id":"seg-012","text":"之死矢靡慝","isActive":false},{"id":"seg-013","text":"母也天只","isActive":false},{"id":"seg-014","text":"不諒人只","isActive":false}]},"material":{"id":"quwanli-quanshi","title":"詩經詮釋","authors":["屈萬里"],"contributorLine":"现代 · 屈萬里","era":"现代","publicationYear":1983,"carrier":"PDF"},"stats":{"annotationCount":2,"glossCount":2},"annotations":[{"id":"0001","order":1,"total":2,"layer":"global","layerLabel":"全篇总说","targetText":"柏舟","targetNotes":"诗旨总说。","sourceLabel":"第 54-55 页","sourceNotes":"书页 54-55《注释》①。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"屈万里","sectionLabel":"总说","text":"屈万里引《詩序》共姜自誓说，并据《史記》共伯事迹辨其与《詩序》互异；又承姚际恒疑《序》之说，认为若依《史記》则“共伯蚤死”与“父母迫嫁”皆难成立，故谓《史記》此说未可尽信。","notes":null}]},{"id":"0002","order":2,"total":2,"layer":"term","layerLabel":"字词注","targetText":"汎彼柏舟，在彼中河。髧彼兩髦，實維我儀。之死矢靡它。母也天只！不諒人只！汎彼柏舟，在彼河側。髧彼兩髦，實維我特。之死矢靡慝。母也天只！不諒人只！","targetNotes":"《注释》②至⑬撮要。","sourceLabel":"第 55 页","sourceNotes":"书页 55《注释》②至⑬。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"屈万里","sectionLabel":"注释","text":"屈万里释“汎”为浮，“中河”为河中；“髧”训髮垂，“兩髦”谓幼小之飾，“儀”为匹配。又释“之”为至，“矢”为誓，“靡它”为无他心意，“諒”作谅解。次章并释“特”为牡畜独称而借作匹，“慝”音忒训邪。","notes":null}]}]}}}
