{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/045-bai-zhou/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/045-bai-zhou/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 柏舟 · 注释总览","description":"風 · 鄘風 · 柏舟 · 汇集《诗经原始(上下)》关于《柏舟》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"045-bai-zhou","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/045-bai-zhou/fangyurun-yuanshi","poem":{"id":"045-bai-zhou","title":"柏舟","categoryId":"feng","subcategoryId":"yongfeng","path":["風","鄘風","柏舟"],"segments":[{"id":"seg-001","text":"汎彼柏舟","isActive":false},{"id":"seg-002","text":"在彼中河","isActive":false},{"id":"seg-003","text":"髧彼兩髦","isActive":false},{"id":"seg-004","text":"實維我儀","isActive":false},{"id":"seg-005","text":"之死矢靡他","isActive":false},{"id":"seg-006","text":"母也天只","isActive":false},{"id":"seg-007","text":"不諒人只","isActive":false},{"id":"seg-008","text":"汎彼柏舟","isActive":false},{"id":"seg-009","text":"在彼河側","isActive":false},{"id":"seg-010","text":"髧彼兩髦","isActive":false},{"id":"seg-011","text":"實維我特","isActive":false},{"id":"seg-012","text":"之死矢靡慝","isActive":false},{"id":"seg-013","text":"母也天只","isActive":false},{"id":"seg-014","text":"不諒人只","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"柏舟㊟貞婦自誓也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标题段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注","text":"方玉润题注以“貞婦自誓”定篇，主张此诗写妇人守贞拒嫁之誓辞。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"总评","targetNotes":"通篇总评。","sourceLabel":null,"sourceNotes":"对应 EPUB item 总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"总评","text":"方玉润总评先述《序》与《集传》旧说以共姜自誓实之，并辨吕祖谦、姚际恒围绕《序》与《史记》的疑难。方氏认为无论共伯事迹可否尽考，诗意仍近“有夫蚤死而誓不再嫁”之贞妇自誓；若必泥共姜事，则失于穿凿。其并以邶、鄘二《柏舟》对举：邶篇为贤臣忧乱，鄘篇为烈妇守贞，皆足为后世法。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"眉评","targetNotes":"篇中眉评撮要。","sourceLabel":null,"sourceNotes":"对应 EPUB item 眉评内容。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"眉评","text":"方玉润眉评以邶、鄘二篇《柏舟》互证，谓邶篇“汎汎其流”喻国势危，而此篇“在彼中河”喻人心定；并称其置于《静女》《新台》《墙茨》之间，足见守贞不挠如中流砥柱。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"term","layerLabel":"字词注","targetText":"髧彼兩髦實維我儀不諒人只實維我特之死矢靡慝","targetNotes":"集释撮要。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":"集释","text":"方玉润集释依次训“髧”“兩髦”“儀”“諒”“只”“特”“慝”：谓“髧”为髮垂貌，“兩髦”为翦髮夾囟并引《内則》《喪大記》释亲没乃去；“儀”为匹，“諒”为信，“只”为語助辭；又引陸德明《韓詩》作“直”及黄佐说解“特”字，并以“慝”为邪，谓“以是为慝，则绝之甚矣”。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"标韵","targetNotes":"两章韵脚撮述。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标韵段。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"方玉润","sectionLabel":"标韵","text":"方玉润标出《柏舟》韵脚：首章“河、他”为五歌，“儀”四支叶牛何反，故“河、儀、他”叶韵；“天”一先叶铁因反与“人”十一真作通韵。次章“側、特、慝”入十三职，为本韵。","notes":null}]}]}}}
