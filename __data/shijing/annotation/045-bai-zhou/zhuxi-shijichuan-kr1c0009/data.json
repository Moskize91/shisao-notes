otes":"次章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》柏舟次章。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"朱熹","sectionLabel":null,"text":"興也。特、亦匹也。慝、邪也。以是爲慝，則其絶之甚矣。","notes":null}]},{"id":"0003","order":3,"total":3,"layer":"global","layerLabel":"全篇总说","targetText":"柏舟二章章七句","targetNotes":"章句总说。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》柏舟章句总说。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"朱熹","sectionLabel":null,"text":"朱熹记《柏舟》二章，章七句。","notes":null}]}]}}}
