{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/110-zhi-hu/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/110-zhi-hu/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 陟岵 · 注释总览","description":"風 · 魏風 · 陟岵 · 汇集《诗经原始(上下)》关于《陟岵》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"110-zhi-hu","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/110-zhi-hu/fangyurun-yuanshi","poem":{"id":"110-zhi-hu","title":"陟岵","categoryId":"feng","subcategoryId":"weifeng-state","path":["風","魏風","陟岵"],"segments":[{"id":"seg-001","text":"陟彼岵兮","isActive":false},{"id":"seg-002","text":"瞻望父兮","isActive":false},{"id":"seg-003","text":"父曰","isActive":false},{"id":"seg-004","text":"嗟予子行役","isActive":false},{"id":"seg-005","text":"夙夜無已","isActive":false},{"id":"seg-006","text":"上慎旃哉猶來無止","isActive":false},{"id":"seg-007","text":"陟彼屺兮","isActive":false},{"id":"seg-008","text":"瞻望母兮","isActive":false},{"id":"seg-009","text":"母曰","isActive":false},{"id":"seg-010","text":"嗟予季行役","isActive":false},{"id":"seg-011","text":"夙夜無寐","isActive":false},{"id":"seg-012","text":"上慎旃哉猶來無棄","isActive":false},{"id":"seg-013","text":"陟彼岡兮","isActive":false},{"id":"seg-014","text":"瞻望兄兮","isActive":false},{"id":"seg-015","text":"兄曰","isActive":false},{"id":"seg-016","text":"嗟予弟行役","isActive":false},{"id":"seg-017","text":"夙夜必偕","isActive":false},{"id":"seg-018","text":"上慎旃哉猶來無死","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"孝子行役而思親也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 篇首题注。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注"}]},{"id":"0002","order":2,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"右《陟岵》三章，章六句。人子行役，登高念親，人情之常。若從正面直寫己之所以念親，縱千言萬語，豈能道得意盡？詩妙從對面設想，思親所以念己之心，與臨行勗己之言，則筆以曲而愈達，情以婉而愈深。千載下讀之，猶足令羇旅人望白雲而起思親之念，況當日遠離父母者乎？其用意尤重在「上慎旃哉」一語。親以是祝之子，子以是體夫親。其能以親心爲己心者，又不僅在思親之貌與親之情而已。而可不謂之爲賢乎？","targetNotes":"总评原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"总评"}]},{"id":"0003","order":3,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"岵〔《爾雅》〕《釋山》：「多草木，岵。」上猶尚也。無止謂無止于彼而不來也。屺〔《爾雅》〕《釋山》：「無草木，峐。屺同。」無棄謂無棄我而不歸也。必偕謂必與同役者偕，無獨行也。無死較無止、無棄而加切耳。","targetNotes":"集释原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"集釋"}]},{"id":"0004","order":4,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"岵七麌。父同。本韻。已四紙。止同。本韻。屺四紙。母二十五有，叶滿彼反。叶韻。寐。四寘。棄同。本韻。岡七陽。兄八庚。轉韻。偕九佳，叶舉里反。死四紙。叶韻。","targetNotes":"标韵原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标韵段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":"標韻"}]}]}}}
