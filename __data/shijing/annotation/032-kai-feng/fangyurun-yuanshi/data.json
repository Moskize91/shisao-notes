{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/032-kai-feng/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/032-kai-feng/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 凱風 · 注释总览","description":"風 · 邶風 · 凱風 · 汇集《诗经原始(上下)》关于《凱風》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"032-kai-feng","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/032-kai-feng/fangyurun-yuanshi","poem":{"id":"032-kai-feng","title":"凱風","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","凱風"],"segments":[{"id":"seg-001","text":"凱風自南","isActive":false},{"id":"seg-002","text":"吹彼棘心","isActive":false},{"id":"seg-003","text":"棘心夭夭","isActive":false},{"id":"seg-004","text":"母氏劬勞","isActive":false},{"id":"seg-005","text":"凱風自南","isActive":false},{"id":"seg-006","text":"吹彼棘薪","isActive":false},{"id":"seg-007","text":"母氏聖善","isActive":false},{"id":"seg-008","text":"我無令人","isActive":false},{"id":"seg-009","text":"爰有寒泉","isActive":false},{"id":"seg-010","text":"在浚之下","isActive":false},{"id":"seg-011","text":"有子七人","isActive":false},{"id":"seg-012","text":"母氏勞苦","isActive":false},{"id":"seg-013","text":"睍睆黃鳥","isActive":false},{"id":"seg-014","text":"載好其音","isActive":false},{"id":"seg-015","text":"有子七人","isActive":false},{"id":"seg-016","text":"莫慰母心","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"凱風㊟孝子自責以感母心也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标题段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注","text":"方玉润在题注中径定《凱風》为“孝子自責以感母心”之诗，不从《序》及郑笺把全篇坐实为恶母欲嫁之作。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"总评","targetNotes":"通篇总评。","sourceLabel":null,"sourceNotes":"对应 EPUB item 总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"总评","text":"方玉润总评中力驳《序》《传》以“卫之淫风流行”说此诗，援孟子“《凱風》，親之過小者也”与两汉碑文、乐府旧语，认为此篇所存不独美孝子，亦足表贤母。依他看，七子只是婉词几谏、反躬自责，母亦因闻子言而回念，不可诬以淫风流行。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"眉评","targetNotes":"篇中眉评撮要。","sourceLabel":null,"sourceNotes":"对应 EPUB item 眉评内容。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"眉评","text":"方玉润眉评仅曰“言婉而意愈深”，点出《凱風》不正面斥母、不直陈家事，而以四章比兴回环自责，反更见孝子深情。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"term","layerLabel":"字词注","targetText":"凱風自南吹彼棘心棘心夭夭吹彼棘薪母氏聖善我無令人爰有寒泉在浚之下睍睆黃鳥","targetNotes":"集释撮要。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":"集释","text":"方玉润集释云：“凱風”为南风长养万物之风，“棘”为难长养小木，“夭夭”见其和茂，“棘薪”为成就者，“聖善”谓明达贤淑，“令”为善，“浚”为卫邑，“睍睆”为黄鸟好貌。整组训诂都围绕“母有长养之德，而七子未足慰母”这一层推进。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"标韵","targetNotes":"四章韵脚撮述。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标韵段。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"方玉润","sectionLabel":"标韵","text":"方玉润标出《凱風》四章韵脚：首章“南、心”通韵，“夭、勞”通韵；第二章“薪、人”本韵；第三章“下、苦”叶韵；第四章“音、心”本韵。四章不繁而韵脚清楚，与其婉曲章法相应。","notes":null}]}]}}}
