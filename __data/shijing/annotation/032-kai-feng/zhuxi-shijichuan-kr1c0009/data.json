{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/032-kai-feng/zhuxi-shijichuan-kr1c0009","dataHref":"/__data/shijing/annotation/032-kai-feng/zhuxi-shijichuan-kr1c0009/data.json","title":"詩集傳 · 凱風 · 注释总览","description":"風 · 邶風 · 凱風 · 汇集《詩集傳》关于《凱風》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"032-kai-feng","materialId":"zhuxi-shijichuan-kr1c0009"},"href":"/shijing/annotation/032-kai-feng/zhuxi-shijichuan-kr1c0009","poem":{"id":"032-kai-feng","title":"凱風","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","凱風"],"segments":[{"id":"seg-001","text":"凱風自南","isActive":true},{"id":"seg-002","text":"吹彼棘心","isActive":true},{"id":"seg-003","text":"棘心夭夭","isActive":true},{"id":"seg-004","text":"母氏劬勞","isActive":true},{"id":"seg-005","text":"凱風自南","isActive":false},{"id":"seg-006","text":"吹彼棘薪","isActive":false},{"id":"seg-007","text":"母氏聖善","isActive":false},{"id":"seg-008","text":"我無令人","isActive":false},{"id":"seg-009","text":"爰有寒泉","isActive":false},{"id":"seg-010","text":"在浚之下","isActive":false},{"id":"seg-011","text":"有子七人","isActive":false},{"id":"seg-012","text":"母氏勞苦","isActive":false},{"id":"seg-013","text":"睍睆黃鳥","isActive":false},{"id":"seg-014","text":"載好其音","isActive":false},{"id":"seg-015","text":"有子七人","isActive":false},{"id":"seg-016","text":"莫慰母心","isActive":false}]},"material":{"id":"zhuxi-shijichuan-kr1c0009","title":"詩集傳","authors":["朱熹"],"contributorLine":"宋 · 朱熹","era":"宋","publicationYear":1186,"carrier":"TXT"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"凱風自南，吹彼棘心。棘心夭夭，母氏劬勞。","targetNotes":"首章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》凱風首章。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"朱熹","sectionLabel":null,"text":"比也。朱熹以凱風為長養萬物之南風，以棘心比子之幼弱未成者；首章先本母生衆子、幼而育之之勞，以起諸子自責之端。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"凱風自南，吹彼棘薪。母氏聖善，我無令人。","targetNotes":"第二章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》第二章。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"朱熹","sectionLabel":null,"text":"興也。朱熹说棘至可為薪則已長成，用以興子之壯大而無善；復以“母氏聖善”高舉其母，而以“我無令人”深自刻責。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"爰有寒泉，在浚之下。有子七人，母氏勞苦。","targetNotes":"第三章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》第三章。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"朱熹","sectionLabel":null,"text":"興也。朱熹以寒泉在浚之下而能滋益其邑，反衬七子雖多，反不能事母而使母勞苦，故此章把自責推得更痛切。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"睍睆黃鳥，載好其音。有子七人，莫慰母心。","targetNotes":"第四章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》第四章。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"朱熹","sectionLabel":null,"text":"興也。朱熹言黃鳥尚能以好音悅人，而七子獨不能慰悅母心；以鳥之有益反襯人子之不及，結語尤為沉至。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"凱風四章章四句","targetNotes":"章句总说。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》凱風章句总说。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"朱熹","sectionLabel":null,"text":"朱熹记《凱風》为四章、章四句，并通篇视为诸子感母劬劳而自责不能慰母之辞。","notes":null}]}]}}}
