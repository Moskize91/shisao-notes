{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/032-kai-feng/chenhuan-chuanshu","dataHref":"/__data/shijing/annotation/032-kai-feng/chenhuan-chuanshu/data.json","title":"詩毛氏傳疏 · 凱風 · 注释总览","description":"風 · 邶風 · 凱風 · 汇集《詩毛氏傳疏》关于《凱風》的 2 条注释，含 2 条注脚。"},"payload":{"detail":{"route":{"poemId":"032-kai-feng","materialId":"chenhuan-chuanshu"},"href":"/shijing/annotation/032-kai-feng/chenhuan-chuanshu","poem":{"id":"032-kai-feng","title":"凱風","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","凱風"],"segments":[{"id":"seg-001","text":"凱風自南","isActive":false},{"id":"seg-002","text":"吹彼棘心","isActive":false},{"id":"seg-003","text":"棘心夭夭","isActive":false},{"id":"seg-004","text":"母氏劬勞","isActive":false},{"id":"seg-005","text":"凱風自南","isActive":false},{"id":"seg-006","text":"吹彼棘薪","isActive":false},{"id":"seg-007","text":"母氏聖善","isActive":false},{"id":"seg-008","text":"我無令人","isActive":false},{"id":"seg-009","text":"爰有寒泉","isActive":false},{"id":"seg-010","text":"在浚之下","isActive":false},{"id":"seg-011","text":"有子七人","isActive":false},{"id":"seg-012","text":"母氏勞苦","isActive":false},{"id":"seg-013","text":"睍睆黃鳥","isActive":false},{"id":"seg-014","text":"載好其音","isActive":false},{"id":"seg-015","text":"有子七人","isActive":false},{"id":"seg-016","text":"莫慰母心","isActive":false}]},"material":{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","authors":["陳奐"],"contributorLine":"清 · 陳奐","era":"清","publicationYear":1847,"carrier":"PDF"},"stats":{"annotationCount":2,"glossCount":2},"annotations":[{"id":"0001","order":1,"total":2,"layer":"preface","layerLabel":"篇序","targetText":"凱風美孝子也衛之淫風流行雖有七子之母猶不能安其室故美七子能盡其孝道以慰其母心而成其志爾","targetNotes":"篇首小序。","sourceLabel":"第 62 页","sourceNotes":"书内页 62 篇首序文。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序","text":"序：《凱風》，美孝子也。衛之淫風流行，雖有七子之母，猶不能安其室，故美七子能盡其孝道，以慰其母心，而成其志爾。","notes":null}]},{"id":"0002","order":2,"total":2,"layer":"span","layerLabel":"诗句片段","targetText":"凱風自南，吹彼棘心。棘心夭夭，母氏劬勞。凱風自南，吹彼棘薪。母氏聖善，我無令人。爰有寒泉，在浚之下。有子七人，母氏勞苦。睍睆黃鳥，載好其音。有子七人，莫慰母心。","targetNotes":"通篇经传疏解。","sourceLabel":"第 62-64 页","sourceNotes":"据第 62-64 页《凱風》经传疏。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"陈奂疏《凱風》时遵《序》与郑笺旧义，以母“不能安其室”释为有欲嫁之志，而七子则以自责婉词感母。其疏先申明前二章说母养子劳苦，继以寒泉、黄鸟二兴反衬诸子不能事母、不能悦母，所以全篇虽不直斥母过，而孝子之情尤见。","notes":null}]}]}}}
