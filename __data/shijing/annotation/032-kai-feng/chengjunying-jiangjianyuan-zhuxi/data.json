{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/032-kai-feng/chengjunying-jiangjianyuan-zhuxi","dataHref":"/__data/shijing/annotation/032-kai-feng/chengjunying-jiangjianyuan-zhuxi/data.json","title":"詩經注析 · 凱風 · 注释总览","description":"風 · 邶風 · 凱風 · 汇集《詩經注析》关于《凱風》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"032-kai-feng","materialId":"chengjunying-jiangjianyuan-zhuxi"},"href":"/shijing/annotation/032-kai-feng/chengjunying-jiangjianyuan-zhuxi","poem":{"id":"032-kai-feng","title":"凱風","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","凱風"],"segments":[{"id":"seg-001","text":"凯风自南","isActive":false},{"id":"seg-002","text":"吹彼棘心","isActive":false},{"id":"seg-003","text":"棘心夭夭","isActive":false},{"id":"seg-004","text":"母氏劬劳","isActive":false},{"id":"seg-005","text":"凯风自南","isActive":false},{"id":"seg-006","text":"吹彼棘薪","isActive":false},{"id":"seg-007","text":"母氏圣善","isActive":false},{"id":"seg-008","text":"我无令人","isActive":false},{"id":"seg-009","text":"爰有寒泉","isActive":false},{"id":"seg-010","text":"在浚之下","isActive":false},{"id":"seg-011","text":"有子七人","isActive":false},{"id":"seg-012","text":"母氏劳苦","isActive":false},{"id":"seg-013","text":"睍睆黄鸟","isActive":false},{"id":"seg-014","text":"载好其音","isActive":false},{"id":"seg-015","text":"有子七人","isActive":false},{"id":"seg-016","text":"莫慰母心","isActive":false}]},"material":{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","authors":["程俊英","蔣見元"],"contributorLine":"现代 · 程俊英、蔣見元","era":"现代","publicationYear":1991,"carrier":"PDF"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"题解","targetNotes":"题解总说。","sourceLabel":"第 62-63 页","sourceNotes":"书内页 62-63《题解》段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"程、蒋将《凯风》定为儿子颂母并反躬自责之诗，不取《序》以来“卫之淫风流行、七子劝母不嫁”的旧说。题解引魏源、王先谦等三家诗说，强调全篇只是追怀母氏劬劳、愧己不能慰母心，胜在语言朴直而骨肉至情极深。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"凯风自南，吹彼棘心。棘心夭夭，母氏劬劳。","targetNotes":"首章。","sourceLabel":"第 63 页","sourceNotes":"书内页 63 首章注析。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"注析","text":"程、蒋释“凯风”为南风，“棘心”为酸枣初发之芽，并引王先谦说以凯风喻母、棘心喻子。首章以南风长养棘木起兴，写母亲抚养七子由幼及长之辛劳，是全诗自责之端。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"凯风自南，吹彼棘薪。母氏圣善，我无令人。","targetNotes":"第二章。","sourceLabel":"第 63 页","sourceNotes":"书内页 63 第二章注析。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"注析","text":"程、蒋释“棘薪”为棘长成可供薪者，承上由“棘心”推进到诸子已长成，却仍“无令人”，没有一个成材足以报母。此章把颂母与自责并写，语气更沉重。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"爰有寒泉，在浚之下。有子七人，母氏劳苦。","targetNotes":"第三章。","sourceLabel":"第 63-64 页","sourceNotes":"书内页 63-64 第三章注析。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"注析","text":"程、蒋释“寒泉”为浚地之泉，认为此章以寒泉之能润泽一邑，反衬七子虽多却不能解除母氏劳苦。比兴由自然物转入切身愧悔，自责之意更深。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"睍睆黄鸟，载好其音。有子七人，莫慰母心。","targetNotes":"第四章。","sourceLabel":"第 64 页","sourceNotes":"书内页 64 第四章注析。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"注析","text":"末章里程、蒋释“睍睆”为鸟鸣婉转，以黄鸟善好其音反衬七子不能慰悦母心。全篇至此把“泉益于人”“鸟悦于人”都转成对自身的不及，收束在最平直也最诚恳的孝思之中。","notes":null}]}]}}}
