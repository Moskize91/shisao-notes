{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/010-ru-fen/chengjunying-jiangjianyuan-zhuxi","dataHref":"/__data/shijing/annotation/010-ru-fen/chengjunying-jiangjianyuan-zhuxi/data.json","title":"詩經注析 · 汝墳 · 注释总览","description":"風 · 周南 · 汝墳 · 汇集《詩經注析》关于《汝墳》的 4 条 annotation，含 4 条 gloss。"},"payload":{"detail":{"route":{"poemId":"010-ru-fen","materialId":"chengjunying-jiangjianyuan-zhuxi"},"href":"/shijing/annotation/010-ru-fen/chengjunying-jiangjianyuan-zhuxi","poem":{"id":"010-ru-fen","title":"汝墳","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","汝墳"],"segments":[{"id":"seg-001","text":"遵彼汝坟","isActive":false},{"id":"seg-002","text":"伐其条枚","isActive":false},{"id":"seg-003","text":"未见君子","isActive":false},{"id":"seg-004","text":"惄如调饥","isActive":false},{"id":"seg-005","text":"遵彼汝坟","isActive":false},{"id":"seg-006","text":"伐其条肄","isActive":false},{"id":"seg-007","text":"既见君子","isActive":false},{"id":"seg-008","text":"不我遐弃","isActive":false},{"id":"seg-009","text":"鲂鱼赪尾","isActive":false},{"id":"seg-010","text":"王室如燬","isActive":false},{"id":"seg-011","text":"虽则如燬","isActive":false},{"id":"seg-012","text":"父母孔迩","isActive":false}]},"material":{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","authors":["程俊英","蔣見元"],"contributorLine":"现代 · 程俊英、蔣見元","era":"现代","publicationYear":1991,"carrier":"PDF"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"preface","layerLabel":"篇序","targetText":"题解","targetNotes":"依照书中题解段。","sourceLabel":"第 19 页","sourceNotes":"/tmp/rufen-pages/cheng-1.png 下半段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"题解将《汝墳》定为思妇诗，认为诗序与韩诗一系把它坐实为“美文王之化”并不贴切；更接近的解释是妇女在汝水边伐柴时思念行役之夫，由不得见到既见而慰，再到以“王室如燬”写乱离之苦。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"遵彼汝坟，伐其条枚。未见君子，惄如调饥。","targetNotes":"首章。","sourceLabel":"第 19-20 页","sourceNotes":"/tmp/rufen-pages/cheng-1.png 下段至 /tmp/rufen-pages/cheng-2.png 上段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"首章用汝坟伐柴起兴，作者解释“惄如调饥”为思夫之切如饥渴难耐，并指出这里的情绪转折由景入情，先写伐木劳动，再转入未见君子的焦灼。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"遵彼汝坟，伐其条肄。既见君子，不我遐弃。","targetNotes":"第二章。","sourceLabel":"第 20 页","sourceNotes":"/tmp/rufen-pages/cheng-2.png 中段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"次章由“未见”转为“既见”，作者强调“条肄”写的是斫木又生的持续过程，与情绪上的转喜相对；“不我遐弃”写女子见到丈夫归来后宽慰而仍带余忧。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"鲂鱼赪尾，王室如燬。虽则如燬，父母孔迩。","targetNotes":"第三章。","sourceLabel":"第 20 页","sourceNotes":"/tmp/rufen-pages/cheng-2.png 下段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"text":"第三章以鲂鱼赤尾比劳苦之深，又引“王室如燬”写时局如火；作者认为“父母孔迩”并非单纯家常宽慰，而是乱世中仍觉亲长近在，可以稍稍安放其心。","notes":null}]}]}}}
