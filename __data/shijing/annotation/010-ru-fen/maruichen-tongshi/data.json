y":"0002-1","attributionLabel":"马瑞辰","sectionLabel":null,"text":"首章以伐木行动开篇，作者认为“调饥”形容思夫之急，同时指出“伐其条枚”展现劳作与期待交错，先景后情形成强烈张力。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"遵彼汝墳，伐其条肄。既见君子，不我遐弃。","targetNotes":"第二章。","sourceLabel":null,"sourceNotes":"依据 /tmp/rufen-more/maruichen-2.png 与 /tmp/rufen-more/maruichen-3.png 的中段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"马瑞辰","sectionLabel":null,"text":"次章由“未见”转为“既见”，“条肄”写出木条重斫以迎夫归，作者并强调“不我遐弃”显露女子见到君子后仍带牵挂。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"鲂鱼赪尾，王室如燬。虽则如燬，父母孔迩。","targetNotes":"第三章。","sourceLabel":null,"sourceNotes":"依据 /tmp/rufen-more/maruichen-3.png 的末段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"马瑞辰","sectionLabel":null,"text":"第三章以鲂鱼赪尾比忧虑的深沉，继而将王室如火写成乱世图景，“父母孔迩”则被解为在亲人面前得以短暂安慰。","notes":null}]}]}}}
