{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/010-ru-fen/chenhuan-chuanshu","dataHref":"/__data/shijing/annotation/010-ru-fen/chenhuan-chuanshu/data.json","title":"詩毛氏傳疏 · 汝墳 · 注释总览","description":"風 · 周南 · 汝墳 · 汇集《詩毛氏傳疏》关于《汝墳》的 5 条 annotation，含 5 条 gloss。"},"payload":{"detail":{"route":{"poemId":"010-ru-fen","materialId":"chenhuan-chuanshu"},"href":"/shijing/annotation/010-ru-fen/chenhuan-chuanshu","poem":{"id":"010-ru-fen","title":"汝墳","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","汝墳"],"segments":[{"id":"seg-001","text":"遵彼汝墳","isActive":false},{"id":"seg-002","text":"伐其條枚","isActive":false},{"id":"seg-003","text":"未見君子","isActive":false},{"id":"seg-004","text":"惄如調飢","isActive":false},{"id":"seg-005","text":"遵彼汝墳","isActive":false},{"id":"seg-006","text":"伐其條肄","isActive":false},{"id":"seg-007","text":"既見君子","isActive":false},{"id":"seg-008","text":"不我遐棄","isActive":false},{"id":"seg-009","text":"魴魚赬尾","isActive":false},{"id":"seg-010","text":"王室如燬","isActive":false},{"id":"seg-011","text":"雖則如燬","isActive":false},{"id":"seg-012","text":"父母孔邇","isActive":false}]},"material":{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","authors":["陳奐"],"contributorLine":"清 · 陳奐","era":"清","publicationYear":1847,"carrier":"PDF"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"preface","layerLabel":"篇序","targetText":"序《汝墳》道化行也","targetNotes":"篇首题解与陈奂疏义。","sourceLabel":"第 1 页","sourceNotes":"/tmp/rufen-more/chenhuan-1.png 上半页题解。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"疏承《序》言“汝墳，道化行也”，借汝水与汝墳之名指文王之德广被南国，称妇人虽忧劳而犹能悯念君子、以正义劝勉，凸显其在逺役时仍守礼之忠诚。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"遵彼汝墳，伐其條枚。未見君子，惄如調飢。","targetNotes":"首章传疏。","sourceLabel":"第 1-2 页","sourceNotes":"/tmp/rufen-more/chenhuan-1.png 下段与 /tmp/rufen-more/chenhuan-2.png 上段首章。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"疏以汝墳伐薪起兴，解“惄如调饥”为未见君子之忧驰若饥，语气由景转情，强调妇人虽在劳作，却心系君子，仍循规蹈矩，不敢偏离文王之道。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"遵彼汝墳，伐其條肄。既見君子，不我遐棄。","targetNotes":"第二章。","sourceLabel":"第 2-3 页","sourceNotes":"/tmp/rufen-more/chenhuan-2.png 下段至 /tmp/rufen-more/chenhuan-3.png 上部。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"疏称续写“遵彼”在于示妇人之节——仍以汝墳为境，呼“既见君子”乃报得君子消息后仍不敢懈怠，用“不我遐弃”反衬君子终不忘此妇之忧，突显其情思与忠义。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"魴魚赬尾，王室如燬。雖則如燬，父母孔邇。","targetNotes":"第三章。","sourceLabel":"第 3 页","sourceNotes":"/tmp/rufen-more/chenhuan-3.png 中段至下段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"疏以魴鱼赬尾、王室如毁的景象写乱世之劳，认为“虽则如毁”乃说虽有劳役辛苦，然“父母孔邇”则说文王之德若父母般接近，敦促众人勿失礼，让妇人之恳切与国家之望相呼应。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"汝墳三章章四句","targetNotes":"章句总说。","sourceLabel":"第 3 页","sourceNotes":"/tmp/rufen-more/chenhuan-3.png 下段“汝墳三章章四句”。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"疏以“章四句”总述三章：前二章写妇人之劳，末章写王室之劳与父母之望，由表及里，表明文王之德亦能感人，使边陲之民见文王之亲近。","notes":null}]}]}}}
