{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/010-ru-fen/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/010-ru-fen/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 汝墳 · 注释总览","description":"風 · 周南 · 汝墳 · 汇集《诗经原始(上下)》关于《汝墳》的 5 条 annotation，含 5 条 gloss。"},"payload":{"detail":{"route":{"poemId":"010-ru-fen","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/010-ru-fen/fangyurun-yuanshi","poem":{"id":"010-ru-fen","title":"汝墳","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","汝墳"],"segments":[{"id":"seg-001","text":"遵彼汝墳","isActive":false},{"id":"seg-002","text":"伐其條枚","isActive":false},{"id":"seg-003","text":"全詩皆比","isActive":false},{"id":"seg-004","text":"未見君子","isActive":false},{"id":"seg-005","text":"惄如調飢","isActive":false},{"id":"seg-006","text":"遵彼汝墳","isActive":false},{"id":"seg-007","text":"伐其條肄","isActive":false},{"id":"seg-008","text":"既見君子","isActive":false},{"id":"seg-009","text":"不我遐棄","isActive":false},{"id":"seg-010","text":"魴魚赬尾","isActive":false},{"id":"seg-011","text":"奧句","isActive":false},{"id":"seg-012","text":"王室如燬","isActive":false},{"id":"seg-013","text":"雖則如燬","isActive":false},{"id":"seg-014","text":"父母孔邇","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"题注与眉评","targetNotes":"题注开篇且附带眉评。","sourceLabel":null,"sourceNotes":"item-0019.txt 第 3-45 行开头题注与大段阐述。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注","text":"题注指出《汝墳》置于近周边疆的汝水与汝墳地，先以文王文化使妇人欣喜，而后述妇人思夫之情，表达诗人不便直言的感受；眉评按章列“调饥”“不我遐弃”“孔迩”，分别抓住渴望、欣幸与安慰三种情绪。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"遵彼汝墳，伐其條枚。全詩皆比。未見君子，惄如調飢。","targetNotes":"第一章原文。","sourceLabel":null,"sourceNotes":"item-0019.txt 第 4-8 行。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":null,"text":"解释称首章借“汝墳”“汝水”之近周之势写文王文化之广，首两句写民间伐木之举为比，用“未见君子”“惄如调饥”两句表示妇人虽盼其夫返却无所见，借渴望渴求的意象作诗人心绪。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"遵彼汝墳，伐其條肄。既見君子，不我遐棄。","targetNotes":"第二章。","sourceLabel":null,"sourceNotes":"item-0019.txt 第 9-12 行。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":null,"text":"第二章以“肄”代“枚”强调持续的备薪，既见游女所思之君子，诗人以“不我遐弃”表达女子的安慰与希望，继续用“遵彼汝墳”呼应首章。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"魴魚赬尾，奧句。王室如燬。雖則如燬，父母孔邇。","targetNotes":"第三章。","sourceLabel":null,"sourceNotes":"item-0019.txt 第 12-15 行。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":null,"text":"这一章以魴鱼赬尾比游女之贞，借“王室如燬”之词述战乱将致王室灭亡，而“父母孔迩”则表明家人就在旁边，借此写尽游女担心君子逃散却仍存归心。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"章句总说","targetNotes":"靠 item-0019 结语“右《汝墳》三章章四句”。","sourceLabel":null,"sourceNotes":"item-0019.txt 第 16-23 行。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"方玉润","sectionLabel":"章句","text":"章句总说沿袭《小序》《大序》《集传》立论，称全篇以文王德化铭记妇人思夫，夹带对商政之乱的感叹，并借地名、集释词汇（条枚、肄、魴鱼、赬尾）补述诗中动作与语义。","notes":null}]}]}}}
