{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/010-ru-fen/maoheng-zhushu-kr1c0004","dataHref":"/__data/shijing/annotation/010-ru-fen/maoheng-zhushu-kr1c0004/data.json","title":"毛詩注疏 · 汝墳 · 注释总览","description":"風 · 周南 · 汝墳 · 汇集《毛詩注疏》关于《汝墳》的 5 条注释，含 9 条注脚。"},"payload":{"detail":{"route":{"poemId":"010-ru-fen","materialId":"maoheng-zhushu-kr1c0004"},"href":"/shijing/annotation/010-ru-fen/maoheng-zhushu-kr1c0004","poem":{"id":"010-ru-fen","title":"汝墳","categoryId":"feng","subcategoryId":"zhounan","path":["風","周南","汝墳"],"segments":[{"id":"seg-001","text":"遵彼汝墳","isActive":false},{"id":"seg-002","text":"伐其條枚","isActive":false},{"id":"seg-003","text":"未見君子","isActive":false},{"id":"seg-004","text":"惄如調飢","isActive":false},{"id":"seg-005","text":"遵彼汝墳","isActive":false},{"id":"seg-006","text":"伐其條肄","isActive":false},{"id":"seg-007","text":"既見君子","isActive":false},{"id":"seg-008","text":"不我遐棄","isActive":false},{"id":"seg-009","text":"魴魚赬尾","isActive":false},{"id":"seg-010","text":"王室如燬","isActive":false},{"id":"seg-011","text":"雖則如燬","isActive":false},{"id":"seg-012","text":"父母孔邇","isActive":false}]},"material":{"id":"maoheng-zhushu-kr1c0004","title":"毛詩注疏","authors":["毛亨","鄭氏","孔穎達"],"contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","era":"漢唐","publicationYear":653,"carrier":"TXT"},"stats":{"annotationCount":5,"glossCount":9},"annotations":[{"id":"0001","order":1,"total":5,"layer":"preface","layerLabel":"篇序","targetText":"序汝墳道化行也","targetNotes":"篇首小序与郑笺。","sourceLabel":null,"sourceNotes":"对应 txt 1152-1160 行。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序","text":"序：汝墳，道化行也。文王之化行乎汝墳之國，婦人能閔其君子，猶勉之以正也。","notes":null},{"key":"0001-2","attributionLabel":"郑笺","sectionLabel":null,"text":"箋云：此婦人被文王之化尤厚，能憂念其君子，又不失臣道，以正義勸勉之，不敢使其逃亡避役。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"遵彼汝墳伐其條枚未見君子惄如調飢","targetNotes":"首章。","sourceLabel":"第 13 页","sourceNotes":"/tmp/yushengwu-scan/211-13.png 上段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：遵，循也。汝，水名也。墳，大防也。條，枝也。枚，榦也。惄，飢意也。調，朝也。","notes":null},{"key":"0002-2","attributionLabel":"郑笺","sectionLabel":null,"text":"箋云：婦人自伐薪於汝水之側，以見其君子本為賢者而處勤勞之職，非其宜也；故未見君子時，憂思如朝飢思食。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"遵彼汝墳伐其條肄既見君子不我遐棄","targetNotes":"第二章。","sourceLabel":"第 13-14 页","sourceNotes":"/tmp/yushengwu-scan/211-13.png 下段与 /tmp/yushengwu-scan/211-14.png 上段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：肄，餘也。斬而復生曰肄。既，已也。遐，遠也。","notes":null},{"key":"0003-2","attributionLabel":"郑笺","sectionLabel":null,"text":"箋云：既已見君子之反，知其不遠棄我而死亡，故前時憂思至此反而愈深；但其辭仍從婦人自道，不敢失禮。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"魴魚赬尾王室如燬雖則如燬父母孔邇","targetNotes":"第三章。","sourceLabel":"第 14 页","sourceNotes":"/tmp/yushengwu-scan/211-14.png 下段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：赬，赤也。魚勞則尾赤。燬，火也。孔，甚也。邇，近也。","notes":null},{"key":"0004-2","attributionLabel":"郑笺","sectionLabel":null,"text":"箋云：君子仕於亂世，顏色瘦病如魚勞而尾赤；王室酷烈如火，雖然如此，父母甚近，當念之以免於害，此即所謂勉之以正。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"汝墳三章章四句","targetNotes":"章句总说。","sourceLabel":"第 14 页","sourceNotes":"/tmp/yushengwu-scan/211-14.png 页底“汝墳三章章四句”。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"章句","sectionLabel":null,"text":"汝墳三章章四句。","notes":null}]}]}}}
