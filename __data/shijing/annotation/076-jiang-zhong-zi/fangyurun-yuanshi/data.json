{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/076-jiang-zhong-zi/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/076-jiang-zhong-zi/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 將仲子 · 注释总览","description":"風 · 鄭風 · 將仲子 · 汇集《诗经原始(上下)》关于《將仲子》的 8 条注释，含 8 条注脚。"},"payload":{"detail":{"route":{"poemId":"076-jiang-zhong-zi","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/076-jiang-zhong-zi/fangyurun-yuanshi","poem":{"id":"076-jiang-zhong-zi","title":"將仲子","categoryId":"feng","subcategoryId":"zhengfeng","path":["風","鄭風","將仲子"],"segments":[{"id":"seg-001","text":"將仲子兮","isActive":false},{"id":"seg-002","text":"無踰我里","isActive":false},{"id":"seg-003","text":"無折我樹杞","isActive":false},{"id":"seg-004","text":"豈敢愛之","isActive":false},{"id":"seg-005","text":"畏我父母","isActive":false},{"id":"seg-006","text":"仲可懷也","isActive":false},{"id":"seg-007","text":"父母之言","isActive":false},{"id":"seg-008","text":"亦可畏也","isActive":false},{"id":"seg-009","text":"將仲子兮","isActive":false},{"id":"seg-010","text":"無踰我牆","isActive":false},{"id":"seg-011","text":"無折我樹桑","isActive":false},{"id":"seg-012","text":"豈敢愛之","isActive":false},{"id":"seg-013","text":"畏我諸兄","isActive":false},{"id":"seg-014","text":"仲可懷也","isActive":false},{"id":"seg-015","text":"諸兄之言","isActive":false},{"id":"seg-016","text":"亦可畏也","isActive":false},{"id":"seg-017","text":"將仲子兮","isActive":false},{"id":"seg-018","text":"無踰我園","isActive":false},{"id":"seg-019","text":"無折我樹檀","isActive":false},{"id":"seg-020","text":"豈敢愛之","isActive":false},{"id":"seg-021","text":"畏人之多言","isActive":false},{"id":"seg-022","text":"仲可懷也","isActive":false},{"id":"seg-023","text":"人之多言","isActive":false},{"id":"seg-024","text":"亦可畏也","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":8,"glossCount":8},"annotations":[{"id":"0001","order":1,"total":8,"layer":"global","layerLabel":"全篇总说","targetText":"諷世以禮自持也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标题段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注"}]},{"id":"0002","order":2,"total":8,"layer":"global","layerLabel":"全篇总说","targetText":"右《將仲子》三章，章八句。《序》謂「刺莊公不勝其母，以害其弟，祭仲諫而弗聽」，特以詩中有「父母」、「兄弟」、「仲子」等字耳。《集傳》從鄭漁仲説，以爲無與莊公、叔段事，是矣。而又以爲淫奔詩，亦非。蓋女心既有所畏而不從，則不得謂之爲奔，亦不得謂之爲淫。姚氏知其然，仍不能斷。乃曰：「按，此詩言鄭事多不合，以爲淫詩則合。」是其識亦尚游移未定耳。此詩難保非采自民間閭巷，鄙夫婦相愛慕之辭。然其義有合於聖賢守身大道，故太史録之以爲涉世法。夫使人心無所畏，則富貴功名孰非可懷而可愛？惟能以理制其心，斯能以禮慎其守。故或非義之當前，心雖不能無所動，而惕以人言可畏，即父母、兄弟有所不敢欺，則慾念頓消而天理自在。是善於守身法也，而謂之爲惡也得乎？故《左傳》子展如晉賦此詩，而衛侯得歸。使其爲本國淫詩，豈尚舉以自賦而復見許於他國歟？此非淫詞斷可知已。","targetNotes":"通篇总评原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"总评"}]},{"id":"0003","order":3,"total":8,"layer":"term","layerLabel":"字词注","targetText":"將請也。","targetNotes":"集释条目。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段分条。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"集释"}]},{"id":"0004","order":4,"total":8,"layer":"term","layerLabel":"字词注","targetText":"仲子男子之字也。","targetNotes":"集释条目。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段分条。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":"集释"}]},{"id":"0005","order":5,"total":8,"layer":"term","layerLabel":"字词注","targetText":"里〔孔氏穎達曰〕《地官·遂人》云：「五家爲鄰，五鄰爲里。」是二十五家爲里也。","targetNotes":"集释条目。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段分条。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"方玉润","sectionLabel":"集释"}]},{"id":"0006","order":6,"total":8,"layer":"term","layerLabel":"字词注","targetText":"杞柳屬也。〔王氏應麟曰〕杞有三：「無折我樹杞」，柳屬也。「南山有杞」、「在彼杞棘」，梓杞也。「集于苞杞」、「言采其杞」、「隰有杞桋」，枸杞也。","targetNotes":"集释条目。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段分条。","notes":null,"glosses":[{"key":"0006-1","attributionLabel":"方玉润","sectionLabel":"集释"}]},{"id":"0007","order":7,"total":8,"layer":"term","layerLabel":"字词注","targetText":"檀〔《集傳》〕檀，皮青滑澤，材彊韌，可爲車。","targetNotes":"集释条目。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段分条。","notes":null,"glosses":[{"key":"0007-1","attributionLabel":"方玉润","sectionLabel":"集释"}]},{"id":"0008","order":8,"total":8,"layer":"term","layerLabel":"字词注","targetText":"里四紙。杞同。本韻。愛十一隊。母二十五有，叶滿彼反。叶韻。懷九佳。畏五未，叶於非反。叶韻。","targetNotes":"标韵原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标韵段。","notes":null,"glosses":[{"key":"0008-1","attributionLabel":"方玉润","sectionLabel":"标韵"}]}]}}}
