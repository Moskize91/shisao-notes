{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/066-jun-zi-yu-yi/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/066-jun-zi-yu-yi/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 君子于役 · 注释总览","description":"風 · 王風 · 君子于役 · 汇集《诗经原始(上下)》关于《君子于役》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"066-jun-zi-yu-yi","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/066-jun-zi-yu-yi/fangyurun-yuanshi","poem":{"id":"066-jun-zi-yu-yi","title":"君子于役","categoryId":"feng","subcategoryId":"wangfeng","path":["風","王風","君子于役"],"segments":[{"id":"seg-001","text":"君子于役","isActive":false},{"id":"seg-002","text":"不知其期","isActive":false},{"id":"seg-003","text":"曷至哉","isActive":false},{"id":"seg-004","text":"雞棲于塒","isActive":false},{"id":"seg-005","text":"日之夕矣","isActive":false},{"id":"seg-006","text":"羊牛下來","isActive":false},{"id":"seg-007","text":"君子于役","isActive":false},{"id":"seg-008","text":"如之何勿思","isActive":false},{"id":"seg-009","text":"君子于役","isActive":false},{"id":"seg-010","text":"不日不月","isActive":false},{"id":"seg-011","text":"曷其有佸","isActive":false},{"id":"seg-012","text":"雞棲于桀","isActive":false},{"id":"seg-013","text":"日之夕矣","isActive":false},{"id":"seg-014","text":"羊牛下括","isActive":false},{"id":"seg-015","text":"君子于役","isActive":false},{"id":"seg-016","text":"苟無飢渴","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"君子于役㊟婦人思夫遠行無定也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标题段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注"}]},{"id":"0002","order":2,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"右《君子于役》二章，章八句。《小序》謂「刺平王」，僞説以爲「戍申者之妻作」，皆鑿也。詩到真極，羌無故實，亦自可傳。使三百詩人，篇篇皆懷諷刺，則於忠厚之旨何在？於陶情淑性之意又何存？此詩言情寫景，可謂真實樸至。宣聖雖欲删之，亦有所不忍也。又況夫婦遠離，懷思不已，用情而得其正。即詩之所爲教，又何必定求其人以實之，而後謂有關係作哉？","targetNotes":"通篇总评原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"总评"}]},{"id":"0003","order":3,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"眉評傍晚懷人，真情真境，描寫如畫。晉、唐田家諸詩，恐無此真實自然。","targetNotes":"篇中眉评原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 眉评段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"眉评"}]},{"id":"0004","order":4,"total":5,"layer":"term","layerLabel":"字词注","targetText":"集釋塒〔《集傳》〕鑿牆而棲曰塒。〔郭氏璞曰〕今寒鄉穿牆棲鷄。〔《禽經》云〕陸鳥曰棲，水鳥曰宿。佸會也。桀杙也。〔《爾雅》〕鷄棲於弋爲榤。〔李氏巡曰〕弋，橜也。","targetNotes":"集释原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":"集释"}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"標韻期四支。塒同。本韻。來十灰。思四支。通韻。月六月。桀九屑。括七曷。渴同。轉韻。","targetNotes":"标韵原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标韵段。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"方玉润","sectionLabel":"标韵"}]}]}}}
