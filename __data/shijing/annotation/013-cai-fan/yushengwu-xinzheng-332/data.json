{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/013-cai-fan/yushengwu-xinzheng-332","dataHref":"/__data/shijing/annotation/013-cai-fan/yushengwu-xinzheng-332/data.json","title":"澤螺居詩經新證 澤螺居楚辭新證 · 采蘩 · 注释总览","description":"風 · 召南 · 采蘩 · 汇集《澤螺居詩經新證 澤螺居楚辭新證》关于《采蘩》的 3 条注释，含 3 条注脚。"},"payload":{"detail":{"route":{"poemId":"013-cai-fan","materialId":"yushengwu-xinzheng-332"},"href":"/shijing/annotation/013-cai-fan/yushengwu-xinzheng-332","poem":{"id":"013-cai-fan","title":"采蘩","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","采蘩"],"segments":[{"id":"seg-001","text":"于以采蘩","isActive":true},{"id":"seg-002","text":"于沼于沚","isActive":false},{"id":"seg-003","text":"于以用之","isActive":false},{"id":"seg-004","text":"公侯之事","isActive":false},{"id":"seg-005","text":"于以采蘩","isActive":false},{"id":"seg-006","text":"于澗之中","isActive":false},{"id":"seg-007","text":"于以用之","isActive":false},{"id":"seg-008","text":"公侯之宫","isActive":false},{"id":"seg-009","text":"被之僮僮","isActive":false},{"id":"seg-010","text":"夙夜在公","isActive":false},{"id":"seg-011","text":"被之祁祁","isActive":false},{"id":"seg-012","text":"薄言還歸","isActive":false}]},"material":{"id":"yushengwu-xinzheng-332","title":"澤螺居詩經新證 澤螺居楚辭新證","authors":["于省吾"],"contributorLine":"现代 · 于省吾","era":"现代","publicationYear":2009,"carrier":"PDF"},"stats":{"annotationCount":3,"glossCount":3},"annotations":[{"id":"0001","order":1,"total":3,"layer":"term","layerLabel":"字词注","targetText":"于以采蘩","targetNotes":"对应词目“蘩”。","sourceLabel":"第 7 页","sourceNotes":"对应 PDF 绝对页 27。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"于省吾","sectionLabel":"按","text":"于省吾据青铜器辞“用蘩匃实寿绰永命”等例，指出《采蘩》之“蘩”即白蒿，可见此字在先秦礼用语境中本有实指，不应作空泛虚字看待。","notes":null}]},{"id":"0002","order":2,"total":3,"layer":"term","layerLabel":"字词注","targetText":"被之僮僮","targetNotes":"书内页 6 词目。","sourceLabel":"第 6 页","sourceNotes":"对应 PDF 绝对页 26。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"于省吾","sectionLabel":"按","text":"于省吾沿用本书一贯辨证，反对把“被”拘解为首饰，主张“被、彼古通”，故此句当作“彼之僮僮”。这样所称美的是夫人在公时的敬慎端肃，而不是专摹发饰服饰。","notes":null}]},{"id":"0003","order":3,"total":3,"layer":"term","layerLabel":"字词注","targetText":"被之祁祁","targetNotes":"书内页 6 词目。","sourceLabel":"第 6 页","sourceNotes":"对应 PDF 绝对页 26。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"于省吾","sectionLabel":"按","text":"于省吾将“被之祁祁”与上句并看，认为这里仍应通读作“彼之祁祁”。这样下句所赞便是夫人归来安徐舒迟、进退有度的仪态，和祭服首饰之说无涉。","notes":null}]}]}}}
