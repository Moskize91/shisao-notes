{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/013-cai-fan/zhuxi-shijichuan-kr1c0009","dataHref":"/__data/shijing/annotation/013-cai-fan/zhuxi-shijichuan-kr1c0009/data.json","title":"詩集傳 · 采蘩 · 注释总览","description":"風 · 召南 · 采蘩 · 汇集《詩集傳》关于《采蘩》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"013-cai-fan","materialId":"zhuxi-shijichuan-kr1c0009"},"href":"/shijing/annotation/013-cai-fan/zhuxi-shijichuan-kr1c0009","poem":{"id":"013-cai-fan","title":"采蘩","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","采蘩"],"segments":[{"id":"seg-001","text":"于以采蘩","isActive":true},{"id":"seg-002","text":"于沼于沚","isActive":true},{"id":"seg-003","text":"于以用之","isActive":true},{"id":"seg-004","text":"公矦之事","isActive":true},{"id":"seg-005","text":"于以采蘩","isActive":false},{"id":"seg-006","text":"于㵎之中","isActive":false},{"id":"seg-007","text":"于以用之","isActive":false},{"id":"seg-008","text":"公矦之宫","isActive":false},{"id":"seg-009","text":"被之僮僮","isActive":false},{"id":"seg-010","text":"夙夜在公","isActive":false},{"id":"seg-011","text":"被之祁祁","isActive":false},{"id":"seg-012","text":"薄言還歸","isActive":false}]},"material":{"id":"zhuxi-shijichuan-kr1c0009","title":"詩集傳","authors":["朱熹"],"contributorLine":"宋 · 朱熹","era":"宋","publicationYear":1186,"carrier":"TXT"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"于以采蘩于沼于沚于以用之公矦之事","targetNotes":"首章。","sourceLabel":null,"sourceNotes":"对应 txt 257-261 行。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"朱熹","sectionLabel":null,"text":"賦也。于，於也。蘩，白蒿也。沼，池也。沚，渚也。事，祭事也。南國被文王之化，諸矦夫人能盡誠敬以奉祭祀，而其家人叙其事以美之也。或曰：蘩所以生蠶，蓋古者后夫人有親蠶之禮，此詩亦猶周南之有葛覃也。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"于以采蘩于㵎之中于以用之公矦之宫","targetNotes":"第二章。","sourceLabel":null,"sourceNotes":"对应 txt 262-263 行。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"朱熹","sectionLabel":null,"text":"賦也。山夾水曰㵎。宫，廟也。或曰：即記所謂公桑蠶室也。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"被之僮僮夙夜在公被之祁祁薄言還歸","targetNotes":"第三章。","sourceLabel":null,"sourceNotes":"对应 txt 263-268 行。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"朱熹","sectionLabel":null,"text":"賦也。被，首飾也。編髮爲之。僮僮，竦敬也。夙，早也。公，公所也。祁祁，舒遲貌。去事有儀也。祭義曰：及祭之後，陶陶遂遂，如將復入，然不欲遽去，愛敬之無巳也。或曰：公亦即所謂公桑也。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"采蘩三章章四句","targetNotes":"章句总说。","sourceLabel":null,"sourceNotes":"对应 txt 269 行。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"朱熹","sectionLabel":"章次","text":"朱熹定此篇为三章章四句，并将其主旨归于南国诸侯夫人承文王之化而能尽诚敬奉祭；又录亲蚕、公桑之说，以见此篇可与《周南》之《葛覃》互相发明。","notes":null}]}]}}}
