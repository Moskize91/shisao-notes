{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/013-cai-fan/chenhuan-chuanshu","dataHref":"/__data/shijing/annotation/013-cai-fan/chenhuan-chuanshu/data.json","title":"詩毛氏傳疏 · 采蘩 · 注释总览","description":"風 · 召南 · 采蘩 · 汇集《詩毛氏傳疏》关于《采蘩》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"013-cai-fan","materialId":"chenhuan-chuanshu"},"href":"/shijing/annotation/013-cai-fan/chenhuan-chuanshu","poem":{"id":"013-cai-fan","title":"采蘩","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","采蘩"],"segments":[{"id":"seg-001","text":"于以采蘩","isActive":false},{"id":"seg-002","text":"于沼于沚","isActive":false},{"id":"seg-003","text":"于以用之","isActive":false},{"id":"seg-004","text":"公侯之事","isActive":false},{"id":"seg-005","text":"于以采蘩","isActive":false},{"id":"seg-006","text":"于澗之中","isActive":false},{"id":"seg-007","text":"于以用之","isActive":false},{"id":"seg-008","text":"公侯之宮","isActive":false},{"id":"seg-009","text":"被之僮僮","isActive":false},{"id":"seg-010","text":"夙夜在公","isActive":false},{"id":"seg-011","text":"被之祁祁","isActive":false},{"id":"seg-012","text":"薄言還歸","isActive":false}]},"material":{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","authors":["陳奐"],"contributorLine":"清 · 陳奐","era":"清","publicationYear":1847,"carrier":"PDF"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"preface","layerLabel":"篇序","targetText":"采蘩，夫人不失職也。夫人可以奉祭祀，則不失職矣。","targetNotes":"篇首序文。","sourceLabel":"第 40 页","sourceNotes":"据第 40 页右侧《采蘩》篇首序义。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"疏承《序》以《采蘩》为夫人奉祭而不失其职之诗，重在说明夫人能亲供祭事、恪守法度，则其德行足见，不徒是采蘩一事之勤。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"于以采蘩。于沼于沚。于以用之。公侯之事。","targetNotes":"第一章。","sourceLabel":"第 40 页","sourceNotes":"据第 40 页中右部《采蘩》首章。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"疏以首章先言采蘩之地在沼沚之间，继言其所用在公侯祭事，认为诗意先标采处，次点祭用，用以见夫人奉公敬事之本。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"于以采蘩。于澗之中。于以用之。公侯之宮。","targetNotes":"第二章。","sourceLabel":"第 40-41 页","sourceNotes":"据第 40 页下段续至第 41 页上段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"疏释二章时，将“澗之中”与“公侯之宮”对看，指出采地由沼沚转到山澗，而用地则落实于宗庙宫中，较首章更进一步写夫人所奉之祭礼有定位、有等差。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"span","layerLabel":"诗句片段","targetText":"被之僮僮。夙夜在公。被之祁祁。薄言還歸。","targetNotes":"第三章。","sourceLabel":"第 41 页","sourceNotes":"据第 41 页中段第三章疏释。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"疏以末章专写夫人之容与其事：首饰整齐而色容肃敬，夙夜在公而不懈，及祭毕将归，则威仪舒徐而有节，借此收束上文“奉祭不失职”之义。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"采蘩三章章四句","targetNotes":"章句总说。","sourceLabel":"第 41 页","sourceNotes":"据第 41 页右上章句总说。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"疏以“三章章四句”总束全篇，认为重章递进皆围绕夫人奉祭之义而展开：先写采荐之具，次写祭所之别，终写在公与还归之节，故全诗首尾皆归于礼度。","notes":null}]}]}}}
