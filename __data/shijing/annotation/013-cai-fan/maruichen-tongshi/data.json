{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/013-cai-fan/maruichen-tongshi","dataHref":"/__data/shijing/annotation/013-cai-fan/maruichen-tongshi/data.json","title":"毛詩傳箋通釋 · 采蘩 · 注释总览","description":"風 · 召南 · 采蘩 · 汇集《毛詩傳箋通釋》关于《采蘩》的 2 条注释，含 2 条注脚。"},"payload":{"detail":{"route":{"poemId":"013-cai-fan","materialId":"maruichen-tongshi"},"href":"/shijing/annotation/013-cai-fan/maruichen-tongshi","poem":{"id":"013-cai-fan","title":"采蘩","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","采蘩"],"segments":[{"id":"seg-001","text":"于以采蘩","isActive":true},{"id":"seg-002","text":"于沼于沚","isActive":true},{"id":"seg-003","text":"于以用之","isActive":true},{"id":"seg-004","text":"公侯之事","isActive":true},{"id":"seg-005","text":"于以采蘩","isActive":true},{"id":"seg-006","text":"于澗之中","isActive":true},{"id":"seg-007","text":"于以用之","isActive":true},{"id":"seg-008","text":"公侯之宫","isActive":true},{"id":"seg-009","text":"被之僮僮","isActive":false},{"id":"seg-010","text":"夙夜在公","isActive":false},{"id":"seg-011","text":"被之祁祁","isActive":false},{"id":"seg-012","text":"薄言還歸","isActive":false}]},"material":{"id":"maruichen-tongshi","title":"毛詩傳箋通釋","authors":["馬瑞辰"],"contributorLine":"清 · 馬瑞辰","era":"清","publicationYear":1989,"carrier":"PDF"},"stats":{"annotationCount":2,"glossCount":2},"annotations":[{"id":"0001","order":1,"total":2,"layer":"span","layerLabel":"诗句片段","targetText":"于以采蘩，于沼于沚。于以用之，公侯之事。于以采蘩，于澗之中。于以用之，公侯之宫。","targetNotes":"前二章。","sourceLabel":"第 106 页","sourceNotes":"依据 /tmp/caifan-maruichen-600/p106.png 中《采蘩》题下前二章与名物、地望、祭用诸说。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"马瑞辰","sectionLabel":"按","text":"瑞辰先據《說文》及諸書釋“蘩”為白蒿，並引《夏小正》與服食諸說辨其名物；又釋“沼”“沚”為池與小渚，“澗”為山夾水，見采蘩之地有沼沚亦有山澗。章義則從《箋》說，謂夫人采蘩以供公侯祭事，故曰“公侯之事”“公侯之宫”，前二章分見其采之所與用之所。","notes":null}]},{"id":"0002","order":2,"total":2,"layer":"span","layerLabel":"诗句片段","targetText":"被之僮僮，夙夜在公。被之祁祁，薄言還歸。","targetNotes":"第三章。","sourceLabel":"第 106-107 页","sourceNotes":"依据 /tmp/caifan-maruichen-600/p106.png 末行与 /tmp/caifan-maruichen-600/p107.png 全页中第三章及被饰、夙夜、还归诸说。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"马瑞辰","sectionLabel":"按","text":"瑞辰引《周官》追師注與《少牢饋食禮》諸說，辨“被”為副編次飾，指夫人首服盛飾而有容；“僮僮”“祁祁”皆言被飾整肅徐舒之貌。又釋“夙夜在公”為早入公宫持事，至祭畢乃還，故末句曰“薄言還歸”，見其奉公助祭之勤敬。","notes":null}]}]}}}
