{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/013-cai-fan/maoheng-zhushu-kr1c0004","dataHref":"/__data/shijing/annotation/013-cai-fan/maoheng-zhushu-kr1c0004/data.json","title":"毛詩注疏 · 采蘩 · 注释总览","description":"風 · 召南 · 采蘩 · 汇集《毛詩注疏》关于《采蘩》的 3 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"013-cai-fan","materialId":"maoheng-zhushu-kr1c0004"},"href":"/shijing/annotation/013-cai-fan/maoheng-zhushu-kr1c0004","poem":{"id":"013-cai-fan","title":"采蘩","categoryId":"feng","subcategoryId":"shaonan","path":["風","召南","采蘩"],"segments":[{"id":"seg-001","text":"于以采蘩","isActive":false},{"id":"seg-002","text":"于沼于沚","isActive":false},{"id":"seg-003","text":"于以用之","isActive":false},{"id":"seg-004","text":"公侯之事","isActive":false},{"id":"seg-005","text":"于以采蘩","isActive":false},{"id":"seg-006","text":"于澗之中","isActive":false},{"id":"seg-007","text":"于以用之","isActive":false},{"id":"seg-008","text":"公侯之宮","isActive":false},{"id":"seg-009","text":"被之僮僮","isActive":false},{"id":"seg-010","text":"夙夜在公","isActive":false},{"id":"seg-011","text":"被之祁祁","isActive":false},{"id":"seg-012","text":"薄言還歸","isActive":false}]},"material":{"id":"maoheng-zhushu-kr1c0004","title":"毛詩注疏","authors":["毛亨","鄭氏","孔穎達"],"contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","era":"漢唐","publicationYear":653,"carrier":"TXT"},"stats":{"annotationCount":3,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":3,"layer":"preface","layerLabel":"篇序","targetText":"序采蘩夫人不失職也","targetNotes":"篇首小序。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷一》turn12view1 第 444-448 行。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序","text":"序：《采蘩》，夫人不失職也。夫人可以奉祭祀，則不失職矣。","notes":null}]},{"id":"0002","order":2,"total":3,"layer":"span","layerLabel":"诗句片段","targetText":"于以采蘩于沼于沚于以用之公侯之事于以采蘩于澗之中于以用之公侯之宮","targetNotes":"前二章。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷一》turn12view1 第 450-456 行与 turn12view2 第 458-464 行。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：蘩，皤蒿也。于，於。沼，池。沚，渚也。之事，祭事也。山夾水曰澗。宮，廟也。","notes":null},{"key":"0002-2","attributionLabel":"郑笺","sectionLabel":null,"text":"箋云：于以，猶言往以也。執蘩菜者，以豆薦蘩菹。言夫人於君祭祀而薦此豆也。","notes":null}]},{"id":"0003","order":3,"total":3,"layer":"span","layerLabel":"诗句片段","targetText":"被之僮僮夙夜在公被之祁祁薄言還歸","targetNotes":"第三章。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷一》turn12view2 第 466-472 行。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：被，首飾也。僮僮，竦敬也。夙，早也。祁祁，舒鷃也，去事有儀也。","notes":null},{"key":"0003-2","attributionLabel":"郑笺","sectionLabel":null,"text":"箋云：公，事也。早夜在事，謂視濯溉饎爨之事。言，我也。祭事畢，夫人釋祭服而去髲髢，其威儀祁祁然而安舒，無罷倦之失。我還歸者，自廟反其燕寢。","notes":null}]}]}}}
