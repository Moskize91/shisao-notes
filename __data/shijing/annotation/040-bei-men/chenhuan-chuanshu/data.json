{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/040-bei-men/chenhuan-chuanshu","dataHref":"/__data/shijing/annotation/040-bei-men/chenhuan-chuanshu/data.json","title":"詩毛氏傳疏 · 北門 · 注释总览","description":"風 · 邶風 · 北門 · 汇集《詩毛氏傳疏》关于《北門》的 2 条注释，含 2 条注脚。"},"payload":{"detail":{"route":{"poemId":"040-bei-men","materialId":"chenhuan-chuanshu"},"href":"/shijing/annotation/040-bei-men/chenhuan-chuanshu","poem":{"id":"040-bei-men","title":"北門","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","北門"],"segments":[{"id":"seg-001","text":"出自北門","isActive":false},{"id":"seg-002","text":"憂心殷殷","isActive":false},{"id":"seg-003","text":"終窶且貧","isActive":false},{"id":"seg-004","text":"莫知我艱","isActive":false},{"id":"seg-005","text":"已焉哉","isActive":false},{"id":"seg-006","text":"天實爲之","isActive":false},{"id":"seg-007","text":"謂之何哉","isActive":false},{"id":"seg-008","text":"王事適我","isActive":false},{"id":"seg-009","text":"政事一埤益我","isActive":false},{"id":"seg-010","text":"我入自外","isActive":false},{"id":"seg-011","text":"室人交徧讁我","isActive":false},{"id":"seg-012","text":"已焉哉","isActive":false},{"id":"seg-013","text":"天實爲之","isActive":false},{"id":"seg-014","text":"謂之何哉","isActive":false},{"id":"seg-015","text":"王事敦我","isActive":false},{"id":"seg-016","text":"政事一埤遺我","isActive":false},{"id":"seg-017","text":"我入自外","isActive":false},{"id":"seg-018","text":"室人交徧摧我","isActive":false},{"id":"seg-019","text":"已焉哉","isActive":false},{"id":"seg-020","text":"天實爲之","isActive":false},{"id":"seg-021","text":"謂之何哉","isActive":false}]},"material":{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","authors":["陳奐"],"contributorLine":"清 · 陳奐","era":"清","publicationYear":1847,"carrier":"PDF"},"stats":{"annotationCount":2,"glossCount":2},"annotations":[{"id":"0001","order":1,"total":2,"layer":"preface","layerLabel":"篇序","targetText":"北門刺仕不得志也言衛之忠臣不得志於君而見困窮也","targetNotes":"篇首小序。","sourceLabel":"第 70 页","sourceNotes":"书内页 70 篇首序文。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序","text":"序：《北門》，刺仕不得志也。言衛之忠臣不得志於君，而見困窮也。","notes":null}]},{"id":"0002","order":2,"total":2,"layer":"span","layerLabel":"诗句片段","targetText":"出自北門，憂心殷殷。終窶且貧，莫知我艱。已焉哉，天實爲之。謂之何哉。王事適我，政事一埤益我。我入自外，室人交徧讁我。已焉哉，天實爲之。謂之何哉。王事敦我，政事一埤遺我。我入自外，室人交徧摧我。已焉哉，天實爲之。謂之何哉。","targetNotes":"通篇经传疏解。","sourceLabel":"第 70-71 页","sourceNotes":"据第 70-71 页《北門》经传疏。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"陈奂","sectionLabel":"疏","text":"陈奂疏《北門》时，从《序》定为卫之忠臣仕不得志之诗。其解首章“出自北門，憂心殷殷”“終窶且貧，莫知我艱”，以为写忠臣忧劳困穷而无人知其艰。又就“王事適我，政事一埤益我”“王事敦我，政事一埤遺我”申明王事政事层层加重于一身；“我入自外，室人交徧讁我”“室人交徧摧我”则写奔走于外而归家仍遭室人责摧。至三章反覆言“已焉哉，天實爲之，謂之何哉”，则见其不敢怨上，惟归之于天，以见忠厚隐忍。","notes":null}]}]}}}
