{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/040-bei-men/maoheng-zhushu-kr1c0004","dataHref":"/__data/shijing/annotation/040-bei-men/maoheng-zhushu-kr1c0004/data.json","title":"毛詩注疏 · 北門 · 注释总览","description":"風 · 邶風 · 北門 · 汇集《毛詩注疏》关于《北門》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"040-bei-men","materialId":"maoheng-zhushu-kr1c0004"},"href":"/shijing/annotation/040-bei-men/maoheng-zhushu-kr1c0004","poem":{"id":"040-bei-men","title":"北門","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","北門"],"segments":[{"id":"seg-001","text":"出自北門","isActive":false},{"id":"seg-002","text":"憂心殷殷","isActive":false},{"id":"seg-003","text":"終窶且貧","isActive":false},{"id":"seg-004","text":"莫知我艱","isActive":false},{"id":"seg-005","text":"已焉哉","isActive":false},{"id":"seg-006","text":"天實為之","isActive":false},{"id":"seg-007","text":"謂之何哉","isActive":false},{"id":"seg-008","text":"王事適我","isActive":false},{"id":"seg-009","text":"政事一埤益我","isActive":false},{"id":"seg-010","text":"我入自外","isActive":false},{"id":"seg-011","text":"室人交徧讁我","isActive":false},{"id":"seg-012","text":"已焉哉","isActive":false},{"id":"seg-013","text":"天實為之","isActive":false},{"id":"seg-014","text":"謂之何哉","isActive":false},{"id":"seg-015","text":"王事敦我","isActive":false},{"id":"seg-016","text":"政事一埤遺我","isActive":false},{"id":"seg-017","text":"我入自外","isActive":false},{"id":"seg-018","text":"室人交徧摧我","isActive":false},{"id":"seg-019","text":"已焉哉","isActive":false},{"id":"seg-020","text":"天實為之","isActive":false},{"id":"seg-021","text":"謂之何哉","isActive":false}]},"material":{"id":"maoheng-zhushu-kr1c0004","title":"毛詩注疏","authors":["毛亨","鄭氏","孔穎達"],"contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","era":"漢唐","publicationYear":653,"carrier":"TXT"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"preface","layerLabel":"篇序","targetText":"北門刺仕不得志也言衛之忠臣不得其志耳","targetNotes":"篇首小序。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》北門序文。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"诗序","sectionLabel":"序","text":"序：《北門》，刺仕不得志也。言衛之忠臣不得其志耳。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"出自北門憂心殷殷終窶且貧莫知我艱已焉哉天實為之謂之何哉","targetNotes":"首章。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》北門首章。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：興也。北門背明鄉陰。箋云：自，從也。興者，喻己仕於闇君，猶行而出北門，心為之憂殷殷然。傳：窶者無禮也，貧者困于財。箋云：艱，難也。君於己祿薄，終不足以為禮；又近困於財，無知己以此為難者。言君既然矣，諸臣亦如之。箋云：謂，勤也。詩人事君無二志，故自決歸之於天。我勤身以事君，何哉？忠之至。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"王事適我政事一埤益我我入自外室人交徧讁我已焉哉天實為之謂之何哉","targetNotes":"次章。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》北門次章。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：適，之。埤，厚也。箋云：國有王命役使之事，則不以之彼，必來之我；有賦稅之事，則減彼一而以益我。言君政偏，己兼其苦。傳：讁，責也。箋云：我從外而入，在室之人更迭徧來責我，使己去也。言室人亦不知己志。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"王事敦我政事一埤遺我我入自外室人交徧摧我已焉哉天實為之謂之何哉","targetNotes":"三章。","sourceLabel":null,"sourceNotes":"对应维基文库《毛詩正義/卷二》北門三章。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"毛传","sectionLabel":null,"text":"傳：敦，厚。遺，加也。箋云：敦猶投擲也。傳：摧，沮也。箋云：摧者，刺譏之言。","notes":null}]}]}}}
