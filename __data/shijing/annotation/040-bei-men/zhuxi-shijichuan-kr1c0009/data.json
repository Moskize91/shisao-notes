{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/040-bei-men/zhuxi-shijichuan-kr1c0009","dataHref":"/__data/shijing/annotation/040-bei-men/zhuxi-shijichuan-kr1c0009/data.json","title":"詩集傳 · 北門 · 注释总览","description":"風 · 邶風 · 北門 · 汇集《詩集傳》关于《北門》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"040-bei-men","materialId":"zhuxi-shijichuan-kr1c0009"},"href":"/shijing/annotation/040-bei-men/zhuxi-shijichuan-kr1c0009","poem":{"id":"040-bei-men","title":"北門","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","北門"],"segments":[{"id":"seg-001","text":"出自北門","isActive":true},{"id":"seg-002","text":"憂心殷殷","isActive":true},{"id":"seg-003","text":"終窶且貧","isActive":true},{"id":"seg-004","text":"莫知我艱","isActive":true},{"id":"seg-005","text":"已焉哉","isActive":true},{"id":"seg-006","text":"天實爲之","isActive":true},{"id":"seg-007","text":"謂之何哉","isActive":true},{"id":"seg-008","text":"王事適我","isActive":false},{"id":"seg-009","text":"政事一埤益我","isActive":false},{"id":"seg-010","text":"我入自外","isActive":false},{"id":"seg-011","text":"室人交徧讁我","isActive":false},{"id":"seg-012","text":"已焉哉","isActive":false},{"id":"seg-013","text":"天實爲之","isActive":false},{"id":"seg-014","text":"謂之何哉","isActive":false},{"id":"seg-015","text":"王事敦我","isActive":false},{"id":"seg-016","text":"政事一埤遺我","isActive":false},{"id":"seg-017","text":"我入自外","isActive":false},{"id":"seg-018","text":"室人交徧摧我","isActive":false},{"id":"seg-019","text":"已焉哉","isActive":false},{"id":"seg-020","text":"天實爲之","isActive":false},{"id":"seg-021","text":"謂之何哉","isActive":false}]},"material":{"id":"zhuxi-shijichuan-kr1c0009","title":"詩集傳","authors":["朱熹"],"contributorLine":"宋 · 朱熹","era":"宋","publicationYear":1186,"carrier":"TXT"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"出自北門，憂心殷殷。終窶且貧，莫知我艱。已焉哉，天實爲之。謂之何哉。","targetNotes":"首章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》北門首章。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"朱熹","sectionLabel":null,"text":"比也。朱熹先解“北門”为背阳向阴之地，又释“殷殷”为忧貌、“窶”为贫而无以行礼。由此判定本章所写，是卫国贤者处乱世、事暗君而不得志，因出北门触景自比，既叹贫困无人知其艰难，最终又把遭遇归之于天。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"王事適我，政事一埤益我。我入自外，室人交徧讁我。已焉哉，天實爲之。謂之何哉。","targetNotes":"次章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》北門次章。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"朱熹","sectionLabel":null,"text":"賦也。朱熹释“王事”是王命所使之事，“適”即加之于我，“政事”则是本国政务；“一”犹皆，“埤”有加厚增益之意，“讁”是责备。故本章所见，是王事既归于我，政事又一概加重于我；而我自外奔走归来，家人却还交相责我，写出其困于内外两端已极。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"王事敦我，政事一埤遺我。我入自外，室人交徧摧我。已焉哉，天實爲之。謂之何哉。","targetNotes":"末章。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》北門末章。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"朱熹","sectionLabel":null,"text":"賦也。朱熹说“敦”有投掷般驱逼之意，“遺”是加于我，“摧”则是沮抑困伤。与次章相比，这一章进一步把外在差事之逼迫和室人交相摧折之苦推到更重处；但诗人仍只反覆叹“天实为之”，是不敢怨上而归之于天的写法。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"北門三章章七句","targetNotes":"章句总说。","sourceLabel":null,"sourceNotes":"对应维基文库《詩經集傳/卷之二》北門章句总说。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"朱熹","sectionLabel":null,"text":"朱熹记《北門》为三章、章七句，并转录杨氏之说，指出忠信而受重禄，本应用来劝士；今卫之忠臣反至窶贫而莫知其艰，所以见其仕而不得志。尽管如此，诗中仍无怨怼之辞，只知事无可奈何而归之于天，因此尤见忠臣之意。","notes":null}]}]}}}
