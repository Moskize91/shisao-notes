{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/040-bei-men/chengjunying-jiangjianyuan-zhuxi","dataHref":"/__data/shijing/annotation/040-bei-men/chengjunying-jiangjianyuan-zhuxi/data.json","title":"詩經注析 · 北門 · 注释总览","description":"風 · 邶風 · 北門 · 汇集《詩經注析》关于《北門》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"040-bei-men","materialId":"chengjunying-jiangjianyuan-zhuxi"},"href":"/shijing/annotation/040-bei-men/chengjunying-jiangjianyuan-zhuxi","poem":{"id":"040-bei-men","title":"北門","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","北門"],"segments":[{"id":"seg-001","text":"出自北门","isActive":false},{"id":"seg-002","text":"忧心殷殷","isActive":false},{"id":"seg-003","text":"终窭且贫","isActive":false},{"id":"seg-004","text":"莫知我艰","isActive":false},{"id":"seg-005","text":"已焉哉","isActive":false},{"id":"seg-006","text":"天实为之","isActive":false},{"id":"seg-007","text":"谓之何哉","isActive":false},{"id":"seg-008","text":"王事适我","isActive":false},{"id":"seg-009","text":"政事一埤益我","isActive":false},{"id":"seg-010","text":"我入自外","isActive":false},{"id":"seg-011","text":"室人交遍谪我","isActive":false},{"id":"seg-012","text":"已焉哉","isActive":false},{"id":"seg-013","text":"天实为之","isActive":false},{"id":"seg-014","text":"谓之何哉","isActive":false},{"id":"seg-015","text":"王事敦我","isActive":false},{"id":"seg-016","text":"政事一埤遗我","isActive":false},{"id":"seg-017","text":"我入自外","isActive":false},{"id":"seg-018","text":"室人交遍摧我","isActive":false},{"id":"seg-019","text":"已焉哉","isActive":false},{"id":"seg-020","text":"天实为之","isActive":false},{"id":"seg-021","text":"谓之何哉","isActive":false}]},"material":{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","authors":["程俊英","蔣見元"],"contributorLine":"现代 · 程俊英、蔣見元","era":"现代","publicationYear":1991,"carrier":"PDF"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"题解","targetNotes":"题解总说。","sourceLabel":"第 85 页","sourceNotes":"书内页 85《题解》段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","text":"程俊英、蒋见元不取《毛序》“忠臣不得其志”之说，认为《北门》更像一位颇受信任却被繁重差事压得内外交困的卫国贵族自叹之作。二人又引郭沫若“破产贵族”说，指出诗中贫窭、家人责难与反复叹天，反映的是生活困顿、无可奈何而借叠章长叹排遣的复杂心理。","notes":null}]},{"id":"0002","order":2,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"出自北门，忧心殷殷。终窭且贫，莫知我艰。已焉哉！天实为之，谓之何哉！","targetNotes":"第一章。","sourceLabel":"第 85 页","sourceNotes":"书内页 85 首章注析。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","text":"首章先写“出自北门，忧心殷殷”的深忧情状。程、蒋反对毛、郑把“北门”硬解为背明向阴以喻暗君，认为这里只是随手写实的出门地点；而“终窭且贫，莫知我艰”则点出其既贫且窭、无人理解的现实困境，章末连用“已焉哉！天实为之，谓之何哉！”写他除了叹命之外别无办法。","notes":null}]},{"id":"0003","order":3,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"王事适我，政事一埤益我。我入自外，室人交遍谪我。已焉哉！天实为之，谓之何哉！","targetNotes":"第二章。","sourceLabel":"第 86 页","sourceNotes":"书内页 86 第二章注析。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","text":"第二章把困境落到事务分配与家庭压力上。“王事适我，政事一埤益我”被解释为王朝差事和国内政事都一股脑加到诗人身上；“我入自外，室人交遍谪我”则写他在外奔走归来，家人还轮番责备。程、蒋借此指出，这一章把内外交迫的处境写得更具体了。","notes":null}]},{"id":"0004","order":4,"total":4,"layer":"span","layerLabel":"诗句片段","targetText":"王事敦我，政事一埤遗我。我入自外，室人交遍摧我。已焉哉！天实为之，谓之何哉！","targetNotes":"第三章。","sourceLabel":"第 86 页","sourceNotes":"书内页 86 第三章注析。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","text":"末章与次章相承而更进一层。程、蒋释“敦”为逼迫，“遗”为加给，“摧”从韩诗义作讥刺责难，因此“王事敦我，政事一埤遗我”是说差役催逼更甚，“室人交遍摧我”则是家人不仅责备，且以讥刺相加。结尾再叹“已焉哉！天实为之，谓之何哉！”，把无可奈何的情绪推到最重。","notes":null}]}]}}}
