{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/040-bei-men/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/040-bei-men/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 北門 · 注释总览","description":"風 · 邶風 · 北門 · 汇集《诗经原始(上下)》关于《北門》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"040-bei-men","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/040-bei-men/fangyurun-yuanshi","poem":{"id":"040-bei-men","title":"北門","categoryId":"feng","subcategoryId":"beifeng","path":["風","邶風","北門"],"segments":[{"id":"seg-001","text":"出自北門","isActive":false},{"id":"seg-002","text":"憂心殷殷","isActive":false},{"id":"seg-003","text":"終窶且貧","isActive":false},{"id":"seg-004","text":"莫知我艱","isActive":false},{"id":"seg-005","text":"已焉哉","isActive":false},{"id":"seg-006","text":"天實爲之","isActive":false},{"id":"seg-007","text":"謂之何哉","isActive":false},{"id":"seg-008","text":"王事適我","isActive":false},{"id":"seg-009","text":"政事一埤益我","isActive":false},{"id":"seg-010","text":"我入自外","isActive":false},{"id":"seg-011","text":"室人交徧讁我","isActive":false},{"id":"seg-012","text":"已焉哉","isActive":false},{"id":"seg-013","text":"天實爲之","isActive":false},{"id":"seg-014","text":"謂之何哉","isActive":false},{"id":"seg-015","text":"王事敦我","isActive":false},{"id":"seg-016","text":"政事一埤遺我","isActive":false},{"id":"seg-017","text":"我入自外","isActive":false},{"id":"seg-018","text":"室人交徧摧我","isActive":false},{"id":"seg-019","text":"已焉哉","isActive":false},{"id":"seg-020","text":"天實爲之","isActive":false},{"id":"seg-021","text":"謂之何哉","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"北門㊟賢者安於貧仕也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标题段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注","text":"方玉润题注直定《北門》为贤者安于贫仕之作，重点不在怨刺激烈，而在贤者处困仍尽其职守。","notes":null}]},{"id":"0002","order":2,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"总评","targetNotes":"通篇总评。","sourceLabel":null,"sourceNotes":"对应 EPUB item 总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"总评","text":"方玉润总评认为《北門》是贤人仕卫而不见知于上、却仍随遇安之的作品。诗中既写“終窶且貧”的生活困顿，又写王事政务压身、室人交谪之苦；但作者终究尽心竭力，不怨人而归之于天，因此更见其贤。至于“出自北門”，方氏又推想或是邶士所为。","notes":null}]},{"id":"0003","order":3,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"眉评","targetNotes":"篇中眉评撮要。","sourceLabel":null,"sourceNotes":"对应 EPUB item 眉评内容。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"眉评","text":"方玉润眉评拈出三章主眼：首章以“莫知”二字为主，见困穷而无人知；次章把“室家势利之情”写得如在目前；末章则只是委之于天，见其无可奈何而不怨。","notes":null}]},{"id":"0004","order":4,"total":5,"layer":"term","layerLabel":"字词注","targetText":"終窶且貧王事適我政事一埤益我室人交徧讁我王事敦我政事一埤遺我室人交徧摧我","targetNotes":"集释撮要。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":"集释","text":"方玉润集释重点解释“窶”与“貧”有别，谓前者是无财可以为礼，后者是无财可以自给；又释“王事”为上所命之事，“政事”为职所治之事，“適”为之也，“一”犹皆，“埤”为厚，“讁”为责，“敦”为迫，“摧”为排挤。诸释合看，正写此贤者内外两困而仍受其任。","notes":null}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"标韵","targetNotes":"三章韵脚撮述。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标韵段。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"方玉润","sectionLabel":"标韵","text":"方玉润标出《北門》三章韵脚：首章“門、殷、貧、艱”通韵，而“之、哉”别转；次章以“適、益、讁”为本韵；末章则标“敦、遺、摧”叶转。其标韵显示全篇在重章复沓中又层层变韵。","notes":null}]}]}}}
