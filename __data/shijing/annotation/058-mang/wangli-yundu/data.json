{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/058-mang/wangli-yundu","dataHref":"/__data/shijing/annotation/058-mang/wangli-yundu/data.json","title":"詩經韻讀 · 氓 · 注释总览","description":"風 · 衛風 · 氓 · 汇集《詩經韻讀》关于《氓》的 6 条注释，含 6 条注脚。"},"payload":{"detail":{"route":{"poemId":"058-mang","materialId":"wangli-yundu"},"href":"/shijing/annotation/058-mang/wangli-yundu","poem":{"id":"058-mang","title":"氓","categoryId":"feng","subcategoryId":"weifeng","path":["風","衛風","氓"],"segments":[{"id":"seg-001","text":"氓之蚩蚩","isActive":true},{"id":"seg-002","text":"抱布贸丝","isActive":true},{"id":"seg-003","text":"匪来贸丝","isActive":true},{"id":"seg-004","text":"来即我谋","isActive":true},{"id":"seg-005","text":"送子涉淇","isActive":true},{"id":"seg-006","text":"至于顿丘","isActive":true},{"id":"seg-007","text":"匪我愆期","isActive":true},{"id":"seg-008","text":"子无良媒","isActive":true},{"id":"seg-009","text":"将子无怒","isActive":true},{"id":"seg-010","text":"秋以为期","isActive":true},{"id":"seg-011","text":"乘彼垝垣","isActive":false},{"id":"seg-012","text":"以望复关","isActive":false},{"id":"seg-013","text":"不见复关","isActive":false},{"id":"seg-014","text":"泣涕涟涟","isActive":false},{"id":"seg-015","text":"既见复关","isActive":false},{"id":"seg-016","text":"载笑载言","isActive":false},{"id":"seg-017","text":"尔卜尔筮","isActive":false},{"id":"seg-018","text":"体无咎言","isActive":false},{"id":"seg-019","text":"以尔车来","isActive":false},{"id":"seg-020","text":"以我贿迁","isActive":false},{"id":"seg-021","text":"桑之未落","isActive":false},{"id":"seg-022","text":"其叶沃若","isActive":false},{"id":"seg-023","text":"于嗟鸠兮","isActive":false},{"id":"seg-024","text":"无食桑葚","isActive":false},{"id":"seg-025","text":"于嗟女兮","isActive":false},{"id":"seg-026","text":"无与士耽","isActive":false},{"id":"seg-027","text":"士之耽兮","isActive":false},{"id":"seg-028","text":"犹可说也","isActive":false},{"id":"seg-029","text":"女之耽兮","isActive":false},{"id":"seg-030","text":"不可说也","isActive":false},{"id":"seg-031","text":"桑之落矣","isActive":false},{"id":"seg-032","text":"其黄而陨","isActive":false},{"id":"seg-033","text":"自我徂尔","isActive":false},{"id":"seg-034","text":"三岁食贫","isActive":false},{"id":"seg-035","text":"淇水汤汤","isActive":false},{"id":"seg-036","text":"渐车帷裳","isActive":false},{"id":"seg-037","text":"女也不爽","isActive":false},{"id":"seg-038","text":"士贰其行","isActive":false},{"id":"seg-039","text":"士也罔极","isActive":false},{"id":"seg-040","text":"二三其德","isActive":false},{"id":"seg-041","text":"三岁为妇","isActive":false},{"id":"seg-042","text":"靡室劳矣","isActive":false},{"id":"seg-043","text":"夙兴夜寐","isActive":false},{"id":"seg-044","text":"靡有朝矣","isActive":false},{"id":"seg-045","text":"言既遂矣","isActive":false},{"id":"seg-046","text":"至于暴矣","isActive":false},{"id":"seg-047","text":"兄弟不知","isActive":false},{"id":"seg-048","text":"咥其笑矣","isActive":false},{"id":"seg-049","text":"静言思之","isActive":false},{"id":"seg-050","text":"躬自悼矣","isActive":false},{"id":"seg-051","text":"及尔偕老","isActive":false},{"id":"seg-052","text":"老使我怨","isActive":false},{"id":"seg-053","text":"淇则有岸","isActive":false},{"id":"seg-054","text":"隰则有泮","isActive":false},{"id":"seg-055","text":"总角之宴","isActive":false},{"id":"seg-056","text":"言笑晏晏","isActive":false},{"id":"seg-057","text":"信誓旦旦","isActive":false},{"id":"seg-058","text":"不思其反","isActive":false},{"id":"seg-059","text":"反是不思","isActive":false},{"id":"seg-060","text":"亦已焉哉","isActive":false}]},"material":{"id":"wangli-yundu","title":"詩經韻讀","authors":["王力"],"contributorLine":"现代 · 王力","era":"现代","publicationYear":1980,"carrier":"PDF"},"stats":{"annotationCount":6,"glossCount":6},"annotations":[{"id":"0001","order":1,"total":6,"layer":"span","layerLabel":"诗句片段","targetText":"氓之蚩蚩，抱布贸丝。匪来贸丝，来即我谋。送子涉淇，至于顿丘。匪我愆期，子无良媒。将子无怒，秋以为期。","targetNotes":"第一章。","sourceLabel":"第 171 页局部","sourceNotes":"第 171 页《氓》第一章。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"王力","sectionLabel":"韵读"}]},{"id":"0002","order":2,"total":6,"layer":"span","layerLabel":"诗句片段","targetText":"乘彼垝垣，以望复关。不见复关，泣涕涟涟。既见复关，载笑载言。尔卜尔筮，体无咎言。以尔车来，以我贿迁。","targetNotes":"第二章。","sourceLabel":"第 171 页局部","sourceNotes":"第 171 页《氓》第二章。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"王力","sectionLabel":"韵读"}]},{"id":"0003","order":3,"total":6,"layer":"span","layerLabel":"诗句片段","targetText":"桑之未落，其叶沃若。于嗟鸠兮，无食桑葚。于嗟女兮，无与士耽。士之耽兮，犹可说也；女之耽兮，不可说也。","targetNotes":"第三章。","sourceLabel":"第 172 页局部","sourceNotes":"第 172 页《氓》第三章。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"王力","sectionLabel":"韵读"}]},{"id":"0004","order":4,"total":6,"layer":"span","layerLabel":"诗句片段","targetText":"桑之落矣，其黄而陨。自我徂尔，三岁食贫。淇水汤汤，渐车帷裳。女也不爽，士贰其行。士也罔极，二三其德。","targetNotes":"第四章。","sourceLabel":"第 172 页局部","sourceNotes":"第 172 页《氓》第四章。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"王力","sectionLabel":"韵读"}]},{"id":"0005","order":5,"total":6,"layer":"span","layerLabel":"诗句片段","targetText":"三岁为妇，靡室劳矣。夙兴夜寐，靡有朝矣。言既遂矣，至于暴矣。兄弟不知，咥其笑矣。静言思之，躬自悼矣。","targetNotes":"第五章。","sourceLabel":"第 172-173 页","sourceNotes":"第 172-173 页《氓》第五章，末句续到第 173 页。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"王力","sectionLabel":"韵读"}]},{"id":"0006","order":6,"total":6,"layer":"span","layerLabel":"诗句片段","targetText":"及尔偕老，老使我怨。淇则有岸，隰则有泮。总角之宴，言笑晏晏。信誓旦旦，不思其反。反是不思，亦已焉哉！","targetNotes":"第六章。","sourceLabel":"第 173 页局部","sourceNotes":"第 173 页《氓》第六章；下接《竹竿》。","notes":null,"glosses":[{"key":"0006-1","attributionLabel":"王力","sectionLabel":"韵读"}]}]}}}
