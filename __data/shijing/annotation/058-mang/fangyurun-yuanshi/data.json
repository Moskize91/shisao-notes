{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/058-mang/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/058-mang/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 氓 · 注释总览","description":"風 · 衛風 · 氓 · 汇集《诗经原始(上下)》关于《氓》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"058-mang","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/058-mang/fangyurun-yuanshi","poem":{"id":"058-mang","title":"氓","categoryId":"feng","subcategoryId":"weifeng","path":["風","衛風","氓"],"segments":[{"id":"seg-001","text":"氓之蚩蚩","isActive":false},{"id":"seg-002","text":"抱布貿絲","isActive":false},{"id":"seg-003","text":"匪來貿絲","isActive":false},{"id":"seg-004","text":"來即我謀","isActive":false},{"id":"seg-005","text":"送子涉淇","isActive":false},{"id":"seg-006","text":"至于頓丘","isActive":false},{"id":"seg-007","text":"匪我愆期","isActive":false},{"id":"seg-008","text":"子無良媒","isActive":false},{"id":"seg-009","text":"將子無怒","isActive":false},{"id":"seg-010","text":"秋以爲期","isActive":false},{"id":"seg-011","text":"乘彼垝垣","isActive":false},{"id":"seg-012","text":"以望復關","isActive":false},{"id":"seg-013","text":"不見復關","isActive":false},{"id":"seg-014","text":"泣涕漣漣","isActive":false},{"id":"seg-015","text":"既見復關","isActive":false},{"id":"seg-016","text":"載笑載言","isActive":false},{"id":"seg-017","text":"爾卜爾筮","isActive":false},{"id":"seg-018","text":"體無咎言","isActive":false},{"id":"seg-019","text":"以爾車來","isActive":false},{"id":"seg-020","text":"以我賄遷","isActive":false},{"id":"seg-021","text":"桑之未落","isActive":false},{"id":"seg-022","text":"其葉沃若","isActive":false},{"id":"seg-023","text":"于嗟鳩兮","isActive":false},{"id":"seg-024","text":"無食桑葚","isActive":false},{"id":"seg-025","text":"于嗟女兮","isActive":false},{"id":"seg-026","text":"無與士耽","isActive":false},{"id":"seg-027","text":"士之耽兮","isActive":false},{"id":"seg-028","text":"猶可説也","isActive":false},{"id":"seg-029","text":"女之耽兮","isActive":false},{"id":"seg-030","text":"不可説也","isActive":false},{"id":"seg-031","text":"桑之落矣","isActive":false},{"id":"seg-032","text":"其黄而隕","isActive":false},{"id":"seg-033","text":"自我徂爾","isActive":false},{"id":"seg-034","text":"三歲食貧","isActive":false},{"id":"seg-035","text":"淇水湯湯","isActive":false},{"id":"seg-036","text":"漸車帷裳","isActive":false},{"id":"seg-037","text":"女也不爽","isActive":false},{"id":"seg-038","text":"士貳其行","isActive":false},{"id":"seg-039","text":"士也罔極","isActive":false},{"id":"seg-040","text":"二三其德","isActive":false},{"id":"seg-041","text":"三歲爲婦","isActive":false},{"id":"seg-042","text":"靡室勞矣","isActive":false},{"id":"seg-043","text":"夙興夜寐","isActive":false},{"id":"seg-044","text":"靡有朝矣","isActive":false},{"id":"seg-045","text":"言既遂矣","isActive":false},{"id":"seg-046","text":"至于暴矣","isActive":false},{"id":"seg-047","text":"兄弟不知","isActive":false},{"id":"seg-048","text":"咥其笑矣","isActive":false},{"id":"seg-049","text":"静言思之","isActive":false},{"id":"seg-050","text":"躬自悼矣","isActive":false},{"id":"seg-051","text":"及爾偕老","isActive":false},{"id":"seg-052","text":"老使我怨","isActive":false},{"id":"seg-053","text":"淇則有岸","isActive":false},{"id":"seg-054","text":"隰則有泮","isActive":false},{"id":"seg-055","text":"總角之宴","isActive":false},{"id":"seg-056","text":"言笑晏晏","isActive":false},{"id":"seg-057","text":"信誓旦旦","isActive":false},{"id":"seg-058","text":"不思其反","isActive":false},{"id":"seg-059","text":"反是不思","isActive":false},{"id":"seg-060","text":"亦已焉哉","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"氓㊟爲棄婦作也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标题段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注"}]},{"id":"0002","order":2,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"右《氓》六章，章十句。此與《谷風》相似而實不同。《谷風》寓言，借棄婦以喻逐臣，此則實賦，必有所爲而作，如漢樂府《羽林郎》、《陌上桑》及《古詩爲焦仲卿妻作》之類，皆詩人所咏，非棄婦作也。觀其以氓直起，亦某甲某乙無知之人耳，特其事述之足以爲戒，故見諸歌咏將以爲世勸焉。曰「子無良媒」者，是其初亦未嘗不欲守禮以待媒，乃情不自禁私訂昏姻，後要媒妁則違禮已甚。然其不敢顯然背禮之心，則又昭然而若揭。曰「送子涉淇」者，將送而未送之謀也。曰「至于頓丘」者，欲至而不至之心也。欲至不至，將送未送，故至愆期而不之顧，敢負約哉？亦無媒耳。媒若果至，則秋以爲期焉，未爲不可也。夫事既有約，則心自難待。遲久不至，則必至乘垣以相望。不見則憂，既見則喜，亦情之所不容已者，女殆癡於情焉者耳。故其自歎，則以桑之榮落喻色之盛衰，以見氓之所重在色不在情，己又未免爲情所累，以致一誤再誤，至於不可説，轉欲援情以自戒，則其情愈可矜已。李白詩云「以色事他人，能得幾時好」，況所事者又蚩蚩氓乎！宜其有《白頭吟》也。「三歲爲婦」，甘苦備嘗而猶不免於見棄，此其咎誠不在己而在氓矣。然知我者其誰？兄弟雖親亦將啞然相笑，以爲是婦德之不終也，而豈知其爲男子之無良乎？回憶總角，「信誓旦旦」，盟猶在耳，詎料其反復如是之速耶？夫淇水悠悠亦尚有岸，原隰浩浩未始無涯，斯人也而乃恝然相棄也。予之至是，予之不思耳。使其思之，豈尚至是？「亦已焉哉」，尚何言哉？雖然口縱言已，心豈能忘？此女始終總爲情誤，固非私奔失節者比。特其一念之差，所託非人，以致不終，徒爲世笑。士之無識而失身以事人者，何以異是？故可以爲戒也。","targetNotes":"通篇总评原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"总评"}]},{"id":"0003","order":3,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"眉評〔一章〕直起，與「昔有霍家奴」同一起法。訂約。〔二章〕懷想一段。落到合諧。〔三章〕色盛見憐一段，已有悔意。〔四章〕色衰愛弛一段，歸咎男子。〔五章〕歷叙勞苦反遭見棄，自怨自艾，如泣如訴，情至之文。〔六章〕跌宕，語極有致。付之一歎。","targetNotes":"篇中眉评原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 眉评段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"眉评"}]},{"id":"0004","order":4,"total":5,"layer":"term","layerLabel":"字词注","targetText":"集釋氓民也。蚩蚩無知貌。貿買也。頓丘地名。〔王氏應麟曰〕《地理志》：東郡頓丘縣。《輿地廣志》：頓丘，本衛邑，在淇水南。愆過也。將願也。垝毁也。垣牆也。復關關名。〔王氏應麟曰〕《寰宇記》：澶州臨河縣復關城，在南黄河北阜也。復關堤，在南三百步。卜龜卜。筮蓍筮。體兆卦之體也。賄財也。沃若潤澤貌。葚桑實也。鳩食葚多則致醉。耽相樂也。説解也。隕落也。徂往也。漸漬也。帷裳車飾。〔孔氏穎達曰〕丈夫之車立乘，有蓋無帷裳。此言帷裳者，婦人之車故也。以幃障車之傍如裳，以爲容飾，故或謂之幃裳，或謂之童容。爽差也。極至也。靡不也。咥笑貌。泮涯也。總角〔孔氏穎達曰〕《甫田》云「總角丱兮」，是男子總角未冠，則婦人總角未笄也。以無笄，直結其髮，聚之爲兩角。晏晏和柔也。旦旦〔鄭氏康成曰〕以信相誓旦旦耳，言其懇惻款誠。","targetNotes":"集释原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":"集释"}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"標韻蚩四支。絲同。本韻。謀十一尤。丘同。本韻。期四支。媒十灰。通韻。垣十三元。關十五删。漣一先。言十三元。遷一先。通韻。落十藥。若同。本韻。葚二十六寢，叶知林反。耽十三覃，叶特林反。叶韻。説九屑。二字自叶韻。隕十一軫，叶子貧反。貧十一真。叶韻。湯七陽。裳、行並同。本韻。極十三職。德同。本韻。勞四豪。朝二蕭。通韻。暴二十號。笑十八嘯。悼二十號。通韻。怨十四願。岸十五翰。泮同。宴十七霰。晏十六諫。旦十五翰。反十三阮，叶孚絢反。叶韻。思四支。哉十灰。通韻。","targetNotes":"标韵原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标韵段。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"方玉润","sectionLabel":"标韵"}]}]}}}
