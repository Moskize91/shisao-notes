"sourceLabel":null,"sourceNotes":"对应 EPUB Text/chapter07_0001_0015.html 眉評段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"眉評"}]},{"id":"0004","order":4,"total":7,"layer":"global","layerLabel":"全篇总说","targetText":"集釋牂牂盛貌。明星啟明也。煌煌大明貌。肺肺〔《集傳》〕肺肺，猶牂牂也。晳晳猶煌煌也。","targetNotes":"集釋段。","sourceLabel":null,"sourceNotes":"对应 EPUB Text/chapter07_0001_0015.html 集釋段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":"集釋"}]},{"id":"0005","order":5,"total":7,"layer":"global","layerLabel":"全篇总说","targetText":"標韻牂七陽。煌同。本韻。肺十一隊，叶普計反。晳十二錫。叶韻。","targetNotes":"標韻段。","sourceLabel":null,"sourceNotes":"对应 EPUB Text/chapter07_0001_0015.html 標韻段。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"方玉润","sectionLabel":"標韻"}]},{"id":"0006","order":6,"total":7,"layer":"span","layerLabel":"诗句片段","targetText":"東門之楊，其葉牂牂。昏以為期，明星煌煌。","targetNotes":"正文第一章。","sourceLabel":null,"sourceNotes":"对应 EPUB Text/chapter07_0001_0015.html 正文第一章。","notes":null,"glosses":[{"key":"0006-1","attributionLabel":"方玉润","sectionLabel":"正文"}]},{"id":"0007","order":7,"total":7,"layer":"span","layerLabel":"诗句片段","targetText":"東門之楊，其葉肺肺。昏以為期，明星晳晳。","targetNotes":"正文第二章。","sourceLabel":null,"sourceNotes":"对应 EPUB Text/chapter07_0001_0015.html 正文第二章。","notes":null,"glosses":[{"key":"0007-1","attributionLabel":"方玉润","sectionLabel":"正文"}]}]}}}
