{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/059-zhu-gan/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/059-zhu-gan/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 竹竿 · 注释总览","description":"風 · 衛風 · 竹竿 · 汇集《诗经原始(上下)》关于《竹竿》的 1 条注释，含 1 条注脚。"},"payload":{"detail":{"route":{"poemId":"059-zhu-gan","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/059-zhu-gan/fangyurun-yuanshi","poem":{"id":"059-zhu-gan","title":"竹竿","categoryId":"feng","subcategoryId":"weifeng","path":["風","衛風","竹竿"],"segments":[{"id":"seg-001","text":"籊籊竹竿","isActive":true},{"id":"seg-002","text":"以釣于淇","isActive":true},{"id":"seg-003","text":"豈不爾思","isActive":true},{"id":"seg-004","text":"遠莫致之","isActive":true},{"id":"seg-005","text":"泉源在左","isActive":true},{"id":"seg-006","text":"淇水在右","isActive":true},{"id":"seg-007","text":"女子有行","isActive":true},{"id":"seg-008","text":"遠兄弟父母","isActive":true},{"id":"seg-009","text":"淇水在右","isActive":true},{"id":"seg-010","text":"泉源在左","isActive":true},{"id":"seg-011","text":"巧笑之瑳","isActive":true},{"id":"seg-012","text":"佩玉之儺","isActive":true},{"id":"seg-013","text":"淇水滺滺","isActive":true},{"id":"seg-014","text":"檜楫松舟","isActive":true},{"id":"seg-015","text":"駕言出遊","isActive":true},{"id":"seg-016","text":"以寫我憂","isActive":true}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":1,"glossCount":1},"annotations":[{"id":"0001","order":1,"total":1,"layer":"span","layerLabel":"诗句片段","targetText":"籊籊竹竿，以釣于淇，豈不爾思，遠莫致之。泉源在左，淇水在右，女子有行，遠兄弟父母。淇水在右，泉源在左，巧笑之瑳，佩玉之儺。淇水滺滺，檜楫松舟，駕言出遊，以寫我憂。","targetNotes":"全篇通释。","sourceLabel":null,"sourceNotes":"依据 EPUB《詩經原始》卷四《竹竿》条整理。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"总评","text":"方玉润仅以“衛女思歸也”概括题旨，不取《大序》“不見答”之说。其总评又指出本诗局度雍容、音节圆畅，无须强求作者其人，而“巧笑之瑳”“檜楫松舟”自足见其风致。","notes":null}]}]}}}
