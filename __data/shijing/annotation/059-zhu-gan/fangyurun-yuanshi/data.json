{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/059-zhu-gan/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/059-zhu-gan/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 竹竿 · 注释总览","description":"風 · 衛風 · 竹竿 · 汇集《诗经原始(上下)》关于《竹竿》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"059-zhu-gan","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/059-zhu-gan/fangyurun-yuanshi","poem":{"id":"059-zhu-gan","title":"竹竿","categoryId":"feng","subcategoryId":"weifeng","path":["風","衛風","竹竿"],"segments":[{"id":"seg-001","text":"籊籊竹竿","isActive":false},{"id":"seg-002","text":"以釣于淇","isActive":false},{"id":"seg-003","text":"豈不爾思","isActive":false},{"id":"seg-004","text":"遠莫致之","isActive":false},{"id":"seg-005","text":"泉源在左","isActive":false},{"id":"seg-006","text":"淇水在右","isActive":false},{"id":"seg-007","text":"女子有行","isActive":false},{"id":"seg-008","text":"遠兄弟父母","isActive":false},{"id":"seg-009","text":"淇水在右","isActive":false},{"id":"seg-010","text":"泉源在左","isActive":false},{"id":"seg-011","text":"巧笑之瑳","isActive":false},{"id":"seg-012","text":"佩玉之儺","isActive":false},{"id":"seg-013","text":"淇水滺滺","isActive":false},{"id":"seg-014","text":"檜楫松舟","isActive":false},{"id":"seg-015","text":"駕言出遊","isActive":false},{"id":"seg-016","text":"以寫我憂","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"竹竿㊟衛女思歸也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标题段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注"}]},{"id":"0002","order":2,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"右《竹竿》四章，章四句。《小序》謂「衛女思歸」，《大序》增以「不見答」。何氏楷則謂「《泉水》及此篇皆許穆夫人作」，姚氏際恒以其語多重複，非一人筆，疑爲「媵和夫人之詞」，均未嘗細咏詩辭也。《載馳》、《泉水》，與此篇雖皆思衛之作，而一則遭亂以思歸，一則無端而念舊，詞意迥乎不同。此不惟非許夫人作，亦無所謂「不見答」意。蓋其局度雍容、音節圓暢，而造語之工，風致嫣然，自足以擅美一時，不必定求其人以實之也。詩固有以無心求工而自工者，迨至工時自不能磨，此類是已。俗儒説詩，務求確解，則三百詩詞不過一本記事珠，欲求一陶情寄興之作，豈可得哉？","targetNotes":"通篇总评原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"总评"}]},{"id":"0003","order":3,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"眉評仙骨姗姗，風韻欲絶。","targetNotes":"篇中眉评原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 眉评段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"眉评"}]},{"id":"0004","order":4,"total":5,"layer":"term","layerLabel":"字词注","targetText":"集釋籊籊〔《集傳》曰〕籊籊，長而殺也。泉源即百泉也。瑳〔《集傳》曰〕瑳，鮮白色。笑而見齒，其色瑳然，猶所謂粲然，皆笑也。儺〔嚴氏粲曰〕儺，柔緩也。腰身褭儺也。〔何氏楷曰〕巧，工也。猶好也。瑳，《説文》云：「玉色鮮白也。」笑而見齒，其色似之。儺，《説文》云：「行有節也。」徐鍇云：「佩玉所以節步。」滺滺流貌。〔陸氏德明曰〕滺本亦作浟。檜木名，似柏。","targetNotes":"集释原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":"集释"}]},{"id":"0005","order":5,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"標韻淇四支。之同。本韻。右二十五有。母同。本韻。左二十哿。儺同。本韻。滺十一尤。舟、遊、憂並同。本韻。","targetNotes":"标韵原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标韵段。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"方玉润","sectionLabel":"标韵"}]}]}}}
