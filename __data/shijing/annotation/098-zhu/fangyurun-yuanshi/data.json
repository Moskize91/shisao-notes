{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/098-zhu/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/098-zhu/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 著 · 注释总览","description":"風 · 齊風 · 著 · 汇集《诗经原始(上下)》关于《著》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"098-zhu","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/098-zhu/fangyurun-yuanshi","poem":{"id":"098-zhu","title":"著","categoryId":"feng","subcategoryId":"qifeng","path":["風","齊風","著"],"segments":[{"id":"seg-001","text":"俟我于著乎而","isActive":false},{"id":"seg-002","text":"充耳以素乎而","isActive":false},{"id":"seg-003","text":"尚之以瓊華乎而","isActive":false},{"id":"seg-004","text":"俟我于庭乎而","isActive":false},{"id":"seg-005","text":"充耳以青乎而","isActive":false},{"id":"seg-006","text":"尚之以瓊瑩乎而","isActive":false},{"id":"seg-007","text":"俟我于堂乎而","isActive":false},{"id":"seg-008","text":"充耳以黄乎而","isActive":false},{"id":"seg-009","text":"尚之以瓊英乎而","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"刺不親迎也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 篇首题注。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注"}]},{"id":"0002","order":2,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"右《著》三章，章三句。《序》謂「刺時」。夫親迎即是昏禮，禮重親迎，所以正夫婦、别嫌疑。齊俗不親迎，故《序》以爲刺，然詩詞明明寫親迎之事，自與《序》不合。毛氏特以變風無美詞耳。其實此詩正是一位女子寫其夫婿來親迎時之喜悦之情。每章只易三字，而情景步步深入：自著而庭而堂，新郎容止服飾，漸次逼近，於是新婦滿心歡喜，情不自禁，哼成此篇。其詞一唱三歎，舒徐婉轉，曲盡新嫁娘既喜且羞之情態，真妙品也。","targetNotes":"总评原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"总评"}]},{"id":"0003","order":3,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"著門屏之間也。充耳冠飾也。尚加也。瓊華美石之有光華者。庭中庭也。青青色也。瓊瑩玉色也。堂堂上也。黄黄色也。瓊英玉之精華也。","targetNotes":"集释原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"集釋"}]},{"id":"0004","order":4,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"著九御。素十一暮。華五麻。通韻。庭十一青。青同。瑩八庚。通韻。堂十陽。黄同。英七陽。通韻。","targetNotes":"标韵原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标韵段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":"標韻"}]}]}}}
