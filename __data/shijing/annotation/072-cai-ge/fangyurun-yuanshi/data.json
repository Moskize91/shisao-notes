{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/072-cai-ge/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/072-cai-ge/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 采葛 · 注释总览","description":"風 · 王風 · 采葛 · 汇集《诗经原始(上下)》关于《采葛》的 5 条注释，含 5 条注脚。"},"payload":{"detail":{"route":{"poemId":"072-cai-ge","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/072-cai-ge/fangyurun-yuanshi","poem":{"id":"072-cai-ge","title":"采葛","categoryId":"feng","subcategoryId":"wangfeng","path":["風","王風","采葛"],"segments":[{"id":"seg-001","text":"彼采葛兮","isActive":false},{"id":"seg-002","text":"一日不見","isActive":false},{"id":"seg-003","text":"如三月兮","isActive":false},{"id":"seg-004","text":"彼采蕭兮","isActive":false},{"id":"seg-005","text":"一日不見","isActive":false},{"id":"seg-006","text":"如三秋兮","isActive":false},{"id":"seg-007","text":"彼采艾兮","isActive":false},{"id":"seg-008","text":"一日不見","isActive":false},{"id":"seg-009","text":"如三歲兮","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":5,"glossCount":5},"annotations":[{"id":"0001","order":1,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"采葛㊟懷友也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标题段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注"}]},{"id":"0002","order":2,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"右《采葛》三章，章三句。此詩明明千古懷友佳章，自《集傳》以爲「淫奔者」所託，遂使天下後世士夫君子，皆不敢有寄懷作也。不知此老何以好爲刻薄之言若是。至《小序》謂爲「懼讒」，尤不足與辯。夫良友情親，如同夫婦，一朝遠别，不勝相思。此正交情濃厚處，故有三月、三秋、三歲之感也。若泛泛相值，轉面頓忘，或市利相交，勢衰即去，豈尚能作此語？故是詩之在衰朝，亦世情之中流砥柱也。而可無存乎？","targetNotes":"通篇总评原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"总评"}]},{"id":"0003","order":3,"total":5,"layer":"global","layerLabel":"全篇总说","targetText":"眉評雅韻欲流，遂成千秋佳語。","targetNotes":"眉评原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 眉评段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"眉评"}]},{"id":"0004","order":4,"total":5,"layer":"term","layerLabel":"字词注","targetText":"集釋蕭荻也。〔孔氏穎達曰〕李巡曰：「荻，一名蕭。」陸璣云：「今人所謂荻蒿者是也。」《郊特牲》：「既奠，然後爇蕭合馨香。」是蕭所以供祭祀也。艾蒿屬。〔《爾雅》〕「艾，冰臺」注：艾蒿。〔姚氏際恒曰〕或云艾必三年方可治病，故言「三歲」，雖詩人之意未必如此，然亦巧合，大有思致。","targetNotes":"集释原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":"集释"}]},{"id":"0005","order":5,"total":5,"layer":"term","layerLabel":"字词注","targetText":"標韻葛七曷。月六月。轉韻。蕭二蕭。秋十一尤。叶韻。艾九泰。歲八霽。通韻。","targetNotes":"标韵原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标韵段。","notes":null,"glosses":[{"key":"0005-1","attributionLabel":"方玉润","sectionLabel":"标韵"}]}]}}}
