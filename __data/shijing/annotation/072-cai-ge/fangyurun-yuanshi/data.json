{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/072-cai-ge/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/072-cai-ge/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 采葛 · 注释总览","description":"風 · 王風 · 采葛 · 汇集《诗经原始(上下)》关于《采葛》的 2 条注释，含 2 条注脚。"},"payload":{"detail":{"route":{"poemId":"072-cai-ge","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/072-cai-ge/fangyurun-yuanshi","poem":{"id":"072-cai-ge","title":"采葛","categoryId":"feng","subcategoryId":"wangfeng","path":["風","王風","采葛"],"segments":[{"id":"seg-001","text":"彼采葛兮","isActive":false},{"id":"seg-002","text":"一日不見","isActive":false},{"id":"seg-003","text":"如三月兮","isActive":false},{"id":"seg-004","text":"彼采蕭兮","isActive":false},{"id":"seg-005","text":"一日不見","isActive":false},{"id":"seg-006","text":"如三秋兮","isActive":false},{"id":"seg-007","text":"彼采艾兮","isActive":false},{"id":"seg-008","text":"一日不見","isActive":false},{"id":"seg-009","text":"如三歲兮","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":2,"glossCount":2},"annotations":[{"id":"0001","order":1,"total":2,"layer":"global","layerLabel":"全篇总说","targetText":"采葛㊟懷友也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 89 标题段。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注","text":"方玉润题注直断《采葛》为怀友之诗，先把全篇的“三月”“三秋”“三歲”都收束到久别思友的情境之中。","notes":null}]},{"id":"0002","order":2,"total":2,"layer":"global","layerLabel":"全篇总说","targetText":"总评","targetNotes":"通篇总评。","sourceLabel":null,"sourceNotes":"对应 EPUB item 89 总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"总评","text":"方玉润谓《采葛》本是“千古懷友佳章”，力驳《集传》以为淫奔假托、《小序》以为惧谗之说。他认为真正的好友情深正如夫妇，一朝远别便不胜相思，故诗中由“三月”递到“三秋”“三歲”，正是交情浓厚、久别弥深的自然流露。","notes":null}]}]}}}
