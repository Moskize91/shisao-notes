{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/072-cai-ge/wangli-yundu","dataHref":"/__data/shijing/annotation/072-cai-ge/wangli-yundu/data.json","title":"詩經韻讀 · 采葛 · 注释总览","description":"風 · 王風 · 采葛 · 汇集《詩經韻讀》关于《采葛》的 1 条注释，含 1 条注脚。"},"payload":{"detail":{"route":{"poemId":"072-cai-ge","materialId":"wangli-yundu"},"href":"/shijing/annotation/072-cai-ge/wangli-yundu","poem":{"id":"072-cai-ge","title":"采葛","categoryId":"feng","subcategoryId":"wangfeng","path":["風","王風","采葛"],"segments":[{"id":"seg-001","text":"彼采葛兮","isActive":true},{"id":"seg-002","text":"一日不见","isActive":true},{"id":"seg-003","text":"如三月兮","isActive":true},{"id":"seg-004","text":"彼采萧兮","isActive":true},{"id":"seg-005","text":"一日不见","isActive":true},{"id":"seg-006","text":"如三秋兮","isActive":true},{"id":"seg-007","text":"彼采艾兮","isActive":true},{"id":"seg-008","text":"一日不见","isActive":true},{"id":"seg-009","text":"如三岁兮","isActive":true}]},"material":{"id":"wangli-yundu","title":"詩經韻讀","authors":["王力"],"contributorLine":"现代 · 王力","era":"现代","publicationYear":1980,"carrier":"PDF"},"stats":{"annotationCount":1,"glossCount":1},"annotations":[{"id":"0001","order":1,"total":1,"layer":"span","layerLabel":"诗句片段","targetText":"彼采葛兮，一日不见，如三月兮。彼采萧兮，一日不见，如三秋兮。彼采艾兮，一日不见，如三岁兮。","targetNotes":"全篇韵读。","sourceLabel":"第 180 页","sourceNotes":"据 /private/tmp/071-wangli/p002.png（页码 180）定位；同页上半仍见《葛藟》，下方已入《大车》标题。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"王力","sectionLabel":"韵读","text":"王力录《采葛》三章，首章以“葛、月”入月部，次章“萧、秋”入幽部，末章“艾、岁”入月部。三章只换所采之物，而“不见”之感由三月推进到三秋、三岁，形成递深的怀人节奏。","notes":null}]}]}}}
