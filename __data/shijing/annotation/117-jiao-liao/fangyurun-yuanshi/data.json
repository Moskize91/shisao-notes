{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/117-jiao-liao/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/117-jiao-liao/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 椒聊 · 注释总览","description":"風 · 唐風 · 椒聊 · 汇集《诗经原始(上下)》关于《椒聊》的 4 条注释，含 4 条注脚。"},"payload":{"detail":{"route":{"poemId":"117-jiao-liao","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/117-jiao-liao/fangyurun-yuanshi","poem":{"id":"117-jiao-liao","title":"椒聊","categoryId":"feng","subcategoryId":"tangfeng","path":["風","唐風","椒聊"],"segments":[{"id":"seg-001","text":"椒聊之實","isActive":false},{"id":"seg-002","text":"蕃衍盈升","isActive":false},{"id":"seg-003","text":"彼其之子","isActive":false},{"id":"seg-004","text":"碩大無朋","isActive":false},{"id":"seg-005","text":"椒聊且","isActive":false},{"id":"seg-006","text":"遠條且","isActive":false},{"id":"seg-007","text":"椒聊之實","isActive":false},{"id":"seg-008","text":"蕃衍盈匊","isActive":false},{"id":"seg-009","text":"彼其之子","isActive":false},{"id":"seg-010","text":"碩大且篤","isActive":false},{"id":"seg-011","text":"椒聊且","isActive":false},{"id":"seg-012","text":"遠條且","isActive":false}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":4,"glossCount":4},"annotations":[{"id":"0001","order":1,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"憂沃盛而晉微也。","targetNotes":"篇首题注。","sourceLabel":null,"sourceNotes":"对应 EPUB item 篇首题注。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注"}]},{"id":"0002","order":2,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"右《椒聊》二章，章六句。此詩爲沃盛晉弱而發無疑。惟輔氏廣謂「當時民情，棄舊君而樂桓叔，以見其俗之薄」，則大非詩意。詩不云乎，「彼其之子，碩大無朋」。以桓叔爲彼，則必以昭公爲君。憂晉之弱，不得不極言沃之盛以警之也，而何以謂其爲叛晉哉？案：《春秋》惠二十四年，昭公封成師於曲沃，至莊十六年，曲沃伯始爲晉侯。中間幾七十年。此詩之作，亦遠在三四十年之間。事未至而慮已周，非見微知著之君子，不足以爲此，其所以忠於昭公者何如乎？聖人存之，正以見其識之遠而慮之深耳。若謂民罔常懷，懷於有仁，盡將詩人忠厚視同叛黨，可乎哉？","targetNotes":"总评原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 总评段。","notes":null,"glosses":[{"key":"0002-1","attributionLabel":"方玉润","sectionLabel":"总评"}]},{"id":"0003","order":3,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"椒〔《集傳》〕椒，樹似茱萸，有針刺，其實味辛而香烈。聊〔何氏楷曰〕聊，舊以爲語助辭，似非文理。按《爾雅》云：「朹，檕梅。朻者，聊。」檕梅名朹，其朻者名聊也。朻，《説文》：「高木也。」聊即朹之高者。〔姚氏際恒曰〕案此説是。則是「椒聊且」，歎其枝之高也。「遠條且」，歎其條之遠也。","targetNotes":"集释原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 集释段。","notes":null,"glosses":[{"key":"0003-1","attributionLabel":"方玉润","sectionLabel":"集釋"}]},{"id":"0004","order":4,"total":4,"layer":"global","layerLabel":"全篇总说","targetText":"升十蒸。朋同。本韻。聊二蕭。條同。本韻。匊一屋。篤二沃。通韻。","targetNotes":"标韵原文。","sourceLabel":null,"sourceNotes":"对应 EPUB item 标韵段。","notes":null,"glosses":[{"key":"0004-1","attributionLabel":"方玉润","sectionLabel":"標韻"}]}]}}}
