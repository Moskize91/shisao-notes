{"version":1,"page":{"kind":"annotation-detail","href":"/shijing/annotation/060-wan-lan/fangyurun-yuanshi","dataHref":"/__data/shijing/annotation/060-wan-lan/fangyurun-yuanshi/data.json","title":"诗经原始(上下) · 芄蘭 · 注释总览","description":"風 · 衛風 · 芄蘭 · 汇集《诗经原始(上下)》关于《芄蘭》的 1 条注释，含 1 条注脚。"},"payload":{"detail":{"route":{"poemId":"060-wan-lan","materialId":"fangyurun-yuanshi"},"href":"/shijing/annotation/060-wan-lan/fangyurun-yuanshi","poem":{"id":"060-wan-lan","title":"芄蘭","categoryId":"feng","subcategoryId":"weifeng","path":["風","衛風","芄蘭"],"segments":[{"id":"seg-001","text":"芄蘭之支","isActive":true},{"id":"seg-002","text":"童子佩觿","isActive":true},{"id":"seg-003","text":"雖則佩觿","isActive":true},{"id":"seg-004","text":"能不我知","isActive":true},{"id":"seg-005","text":"容兮遂兮","isActive":true},{"id":"seg-006","text":"垂帶悸兮","isActive":true},{"id":"seg-007","text":"芄蘭之葉","isActive":true},{"id":"seg-008","text":"童子佩韘","isActive":true},{"id":"seg-009","text":"雖則佩韘","isActive":true},{"id":"seg-010","text":"能不我甲","isActive":true},{"id":"seg-011","text":"容兮遂兮","isActive":true},{"id":"seg-012","text":"垂帶悸兮","isActive":true}]},"material":{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","authors":["方玉润","李先耕"],"contributorLine":"清 · 方玉润、李先耕","era":"清","publicationYear":1986,"carrier":"EPUB"},"stats":{"annotationCount":1,"glossCount":1},"annotations":[{"id":"0001","order":1,"total":1,"layer":"span","layerLabel":"诗句片段","targetText":"芄蘭之支，童子佩觿，雖則佩觿，能不我知，容兮遂兮，垂帶悸兮。芄蘭之葉，童子佩韘，雖則佩韘，能不我甲，容兮遂兮，垂帶悸兮。","targetNotes":"全篇通释。","sourceLabel":null,"sourceNotes":"依据 EPUB《詩經原始》卷四《芄蘭》条整理。","notes":null,"glosses":[{"key":"0001-1","attributionLabel":"方玉润","sectionLabel":"题注","text":"方玉润题下注《芄蘭》曰“諷童子以守分也”。其后又由“能不我知”“能不我甲”说明诗意在讽其逾分自矜，而“甲”可通“狎”，亦即不能见亲见习于人。","notes":null}]}]}}}
