Ids":["seg-007:3-4:无吪","seg-014:3-4:无觉","seg-021:3-4:无聪"],"glossAnchorIds":["anchor-3-1","anchor-3-2","anchor-3-3"],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016","seg-017","seg-018","seg-019","seg-020","seg-021"]},{"id":"chenhuan-chuanshu:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/070-tu-yuan/chenhuan-chuanshu/0001-1","materialId":"chenhuan-chuanshu","materialTitle":"詩毛氏傳疏","contributorLine":"清 · 陳奐","publicationYear":1847,"layer":"span","layerLabel":"诗句片段","targetText":"有兔爰爰，雉離于羅，我生之初，尚無爲，我生之後，逢此百罹，尚寐無吪，有兔爰爰，雉離于罦，我生之初，尚無造，我生之後，逢此百憂，尚寐無覺，有兔爰爰，雉離于罿，我生之初，尚無庸，我生之後，逢此百凶，尚寐無聰。","sourceLabel":"第 88-89 页","attributionLabel":"陈奂","sectionLabel":"传疏","excerpt":"陈奂释《兔爰》，以兔脱雉陷发明“小人致乱而幸免，君子无辜而受祸”之比。","fullText":"陈奂释《兔爰》，以兔脱雉陷发明“小人致乱而幸免，君子无辜而受祸”之比。其又顺章申说“無吪”“無覺”“無聰”，谓皆是乱世之中不欲更言、不欲更见、不欲更闻之意，而三章以“百罹”“百憂”“百凶”层层加深其苦。","notes":null,"partOrder":1,"anchorIds":["seg-001:2-2:兔","seg-002:1-1:雉"],"glossAnchorIds":["anchor-1-1","anchor-1-2"],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016","seg-017","seg-018","seg-019","seg-020","seg-021"]},{"id":"chenhuan-chuanshu:0001-1:part-2","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/070-tu-yuan/chenhuan-chuanshu/0001-1","materialId":"chenhuan-chuanshu","materialTitle":"詩毛氏傳疏","contributorLine":"清 · 陳奐","publicationYear":1847,"layer":"span","layerLabel":"诗句片段","targetText":"有兔爰爰，雉離于羅，我生之初，尚無爲，我生之後，逢此百罹，尚寐無吪，有兔爰爰，雉離于罦，我生之初，尚無造，我生之後，逢此百憂，尚寐無覺，有兔爰爰，雉離于罿，我生之初，尚無庸，我生之後，逢此百凶，尚寐無聰。","sourceLabel":"第 88-89 页","attributionLabel":"陈奂","sectionLabel":"传疏","excerpt":"其又顺章申说“無吪”“無覺”“無聰”，谓皆是乱世之中不欲更言、不欲更见、不欲更闻之意，","fullText":"陈奂释《兔爰》，以兔脱雉陷发明“小人致乱而幸免，君子无辜而受祸”之比。其又顺章申说“無吪”“無覺”“無聰”，谓皆是乱世之中不欲更言、不欲更见、不欲更闻之意，而三章以“百罹”“百憂”“百凶”层层加深其苦。","notes":null,"partOrder":2