","maruichen-tongshi:0001-1:part-2","quwanli-quanshi:0001-1:part-2","wangli-yundu:0001-1:part-3"],"materialIds":["chengjunying-jiangjianyuan-zhuxi","chenhuan-chuanshu","maruichen-tongshi","quwanli-quanshi","wangli-yundu"]},{"id":"seg-020:4-4:凶","segmentId":"seg-020","segmentOrder":20,"surfaceText":"凶","charStart":4,"charEnd":4,"entryIds":["wangli-yundu:0001-1:part-2"],"materialIds":["wangli-yundu"]},{"id":"seg-021:3-4:无聪","segmentId":"seg-021","segmentOrder":21,"surfaceText":"无聪","charStart":3,"charEnd":4,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-3"],"materialIds":["chengjunying-jiangjianyuan-zhuxi"]},{"id":"seg-021:3-4:無聰","segmentId":"seg-021","segmentOrder":21,"surfaceText":"無聰","charStart":3,"charEnd":4,"entryIds":["chenhuan-chuanshu:0001-1:part-2","maruichen-tongshi:0001-1:part-3","quwanli-quanshi:0001-1:part-2"],"materialIds":["chenhuan-chuanshu","maruichen-tongshi","quwanli-quanshi"]},{"id":"seg-021:4-4:聪","segmentId":"seg-021","segmentOrder":21,"surfaceText":"聪","charStart":4,"charEnd":4,"entryIds":["wangli-yundu:0001-1:part-2"],"materialIds":["wangli-yundu"]}],"entries":[{"id":"chengjunying-jiangjianyuan-zhuxi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/070-tu-yuan/chengjunying-jiangjianyuan-zhuxi/0001-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"有兔爰爰，雉离于罗，我生之初，尚无为，我生之后，逢此百罹，尚寐无吪，有兔爰爰，雉离于罦，我生之初，尚无造，我生之后，逢此百忧，尚寐无觉，有兔爰爰，雉离于罿，我生之初，尚无庸，我生之后，逢此百凶，尚寐无聪。","sourceLabel":"第 159-161 页","attributionLabel":"程俊英","sectionLabel":"注析","excerpt":"程俊英释《兔爰》，谓此为没落贵族厌世之作：作者回忆宣王末年尚无兵祸，东迁之后却逢“百罹”“百忧”“百凶”。","fullText":"程俊英释《兔爰》，谓此为没落贵族厌世之作：作者回忆宣王末年尚无兵祸，东迁之后却逢“百罹”“百忧”“百凶”。篇首两句以“有兔爰爰”“雉离于罗”比小人独免、君子受祸，而“无吪”“无觉”“无聪”分别写不愿再说、不愿再见、不愿再闻乱世。","notes":null,"partOrder":1,"anchorIds":["seg-006:3-4:百罹","seg-013:3-4:百忧","seg-020:3-4:百凶"],"glossAnchorIds":["anchor-1-1","anchor-1-2","anchor-1-3"],"segmentIds":