-yundu:0002-1:part-1","zhuxi-shijichuan-kr1c0009:0004-1:part-1"],"characters":[{"index":1,"text":"莫","anchorIds":[]},{"index":2,"text":"慰","anchorIds":[]},{"index":3,"text":"母","anchorIds":[]},{"index":4,"text":"心","anchorIds":[]}]}]},"materials":[{"id":"maoheng-zhushu-kr1c0004","title":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"glossCount":5,"partCount":5},{"id":"zhuxi-shijichuan-kr1c0009","title":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"glossCount":5,"partCount":5},{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","contributorLine":"清 · 陳奐","publicationYear":1847,"glossCount":2,"partCount":2},{"id":"wangli-yundu","title":"詩經韻讀","contributorLine":"现代 · 王力","publicationYear":1980,"glossCount":2,"partCount":2},{"id":"quwanli-quanshi","title":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"glossCount":2,"partCount":2},{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"glossCount":5,"partCount":5},{"id":"maruichen-tongshi","title":"毛詩傳箋通釋","contributorLine":"清 · 馬瑞辰","publicationYear":1989,"glossCount":1,"partCount":1},{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"glossCount":5,"partCount":5}],"stats":{"materialCount":8,"glossCount":27,"anchoredPartCount":0,"overviewPartCount":10},"overview":{"prefaceEntryIds":["chenhuan-chuanshu:0001-1:part-1","maoheng-zhushu-kr1c0004:0001-1:part-1"],"globalEntryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-1","fangyurun-yuanshi:0001-1:part-1","fangyurun-yuanshi:0002-1:part-1","fangyurun-yuanshi:0003-1:part-1","fangyurun-yuanshi:0005-1:part-1","quwanli-quanshi:0001-1:part-1","wangli-yundu:0001-1:part-1","zhuxi-shijichuan-kr1c0009:0005-1:part-1"]},"focusAnchors":[],"entries":[{"id":"chengjunying-jiangjianyuan-zhuxi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/032-kai-feng/chengjunying-jiangjianyuan-zhuxi/0001-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"global","layerLabel":"全篇总说","targetText":"题解","sourceLabel":"第 62-63 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","excerpt":"程、蒋将《凯风》定为儿子颂母并反躬自责之诗，不取《序》以来“卫之淫风流行、七子劝母不嫁”的旧说。题解引魏源、王先谦等三家诗说，强调全篇只是追怀母氏劬劳、愧己不能慰母心，胜在语言朴直而骨肉至情极深。","fullText":"程、蒋将《凯风》定为儿子颂母并反躬自责之诗，不取《序》以来“卫之淫风流行、七子劝母不嫁”的旧说。题解引魏源、王先谦等三家诗说，强调全篇只是追怀母氏劬劳、愧己不能慰母心，胜在语言朴直而骨肉至情极深。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"chengjunying-jiangjianyuan-zhuxi:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/032-kai-feng/chengjunying-jiangjianyuan-zhuxi/0002-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"凯风自南，吹彼棘心。棘心夭夭，母氏劬劳。","sourceLabel":"第 63 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"注析","excerpt":"程、蒋释“凯风”为南风，“棘心”为酸枣初发之芽，并引王先谦说以凯风喻母、棘心喻子。首章以南风长养棘木起兴，写母亲抚养七子由幼及长之辛劳，是全诗自责之端。","fullText":"程、蒋释“凯风”为南风，“棘心”为酸枣初发之芽，并引王先谦说以凯风喻母、棘心喻子。首章以南风长养棘木起兴，写母亲抚养七子由幼及长之辛劳，是全诗自责之端。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004"]},{"id":"chengjunying-jiangjianyuan-zhuxi:0003-1:part-1","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/032-kai-feng/chengjunying-jiangjianyuan-zhuxi/0003-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"凯风自南，吹彼棘薪。母氏圣善，我无令人。","sourceLabel":"第 63 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"注析","excerpt":"程、蒋释“棘薪”为棘长成可供薪者，承上由“棘心”推进到诸子已长成，却仍“无令人”，没有一个成材足以报母。此章把颂母与自责并写，语气更沉重。","fullText":"程、蒋释“棘薪”为棘长成可供薪者，承上由“棘心”推进到诸子已长成，却仍“无令人”，没有一个成材足以报母。此章把颂母与自责并写，语气更沉重。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-005","seg-006","seg-007","seg-008"]},{"id":"chengjunying-jiangjianyuan-zhuxi:0004-1:part-1","annotationId":"0004","glossId":"0004-1","glossHref":"/shijing/gloss/032-kai-feng/chengjunying-jiangjianyuan-zhuxi/0004-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"爰有寒泉，在浚之下。有子七人，母氏劳苦。","sourceLabel":"第 63-64 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"注析","excerpt":"程、蒋释“寒泉”为浚地之泉，认为此章以寒泉之能润泽一邑，反衬七子虽多却不能解除母氏劳苦。比兴由自然物转入切身愧悔，自责之意更深。","fullText":"程、蒋释“寒泉”为浚地之泉，认为此章以寒泉之能润泽一邑，反衬七子虽多却不能解除母氏劳苦。比兴由自然物转入切身愧悔，自责之意更深。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-009","seg-010","seg-011","seg-012"]},{"id":"chengjunying-jiangjianyuan-zhuxi:0005-1:part-1","annotationId":"0005","glossId":"0005-1","glossHref":"/shijing/gloss/032-kai-feng/chengjunying-jiangjianyuan-zhuxi/0005-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"睍睆黄鸟，载好其音。有子七人，莫慰母心。","sourceLabel":"第 64 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"注析","excerpt":"末章里程、蒋释“睍睆”为鸟鸣婉转，以黄鸟善好其音反衬七子不能慰悦母心。全篇至此把“泉益于人”“鸟悦于人”都转成对自身的不及，收束在最平直也最诚恳的孝思之中。","fullText":"末章里程、蒋释“睍睆”为鸟鸣婉转，以黄鸟善好其音反衬七子不能慰悦母心。全篇至此把“泉益于人”“鸟悦于人”都转成对自身的不及，收束在最平直也最诚恳的孝思之中。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-013","seg-014","seg-015","seg-016"]},{"id":"chenhuan-chuanshu:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/032-kai-feng/chenhuan-chuanshu/0001-1","materialId":"chenhuan-chuanshu","materialTitle":"詩毛氏傳疏","contributorLine":"清 · 陳奐","publicationYear":1847,"layer":"preface","layerLabel":"篇序","targetText":"凱風美孝子也衛之淫風流行雖有七子之母猶不能安其室故美七子能盡其孝道以慰其母心而成其志爾","sourceLabel":"第 62 页","attributionLabel":"诗序","sectionLabel":"序","excerpt":"序：《凱風》，美孝子也。衛之淫風流行，雖有七子之母，猶不能安其室，故美七子能盡其孝道，以慰其母心，而成其志爾。","fullText":"序：《凱風》，美孝子也。衛之淫風流行，雖有七子之母，猶不能安其室，故美七子能盡其孝道，以慰其母心，而成其志爾。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"chenhuan-chuanshu:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/032-kai-feng/chenhuan-chuanshu/0002-1","materialId":"chenhuan-chuanshu","materialTitle":"詩毛氏傳疏","contributorLine":"清 · 陳奐","publicationYear":1847,"layer":"span","layerLabel":"诗句片段","targetText":"凱風自南，吹彼棘心。棘心夭夭，母氏劬勞。凱風自南，吹彼棘薪。母氏聖善，我無令人。爰有寒泉，在浚之下。有子七人，母氏勞苦。睍睆黃鳥，載好其音。有子七人，莫慰母心。","sourceLabel":"第 62-64 页","attributionLabel":"陈奂","sectionLabel":"疏","excerpt":"陈奂疏《凱風》时遵《序》与郑笺旧义，以母“不能安其室”释为有欲嫁之志，而七子则以自责婉词感母。其疏先申明前二章说母养子劳苦，继以寒泉、黄鸟二兴反衬诸子不能事母、不能悦母，所以全篇虽不直斥母过，而孝子之情尤见。","fullText":"陈奂疏《凱風》时遵《序》与郑笺旧义，以母“不能安其室”释为有欲嫁之志，而七子则以自责婉词感母。其疏先申明前二章说母养子劳苦，继以寒泉、黄鸟二兴反衬诸子不能事母、不能悦母，所以全篇虽不直斥母过，而孝子之情尤见。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016"]},{"id":"fangyurun-yuanshi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/032-kai-feng/fangyurun-yuanshi/0001-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"global","layerLabel":"全篇总说","targetText":"凱風㊟孝子自責以感母心也。","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"题注","excerpt":"方玉润在题注中径定《凱風》为“孝子自責以感母心”之诗，不从《序》及郑笺把全篇坐实为恶母欲嫁之作。","fullText":"方玉润在题注中径定《凱風》为“孝子自責以感母心”之诗，不从《序》及郑笺把全篇坐实为恶母欲嫁之作。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"fangyurun-yuanshi:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/032-kai-feng/fangyurun-yuanshi/0002-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"global","layerLabel":"全篇总说","targetText":"总评","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"总评","excerpt":"方玉润总评中力驳《序》《传》以“卫之淫风流行”说此诗，援孟子“《凱風》，親之過小者也”与两汉碑文、乐府旧语，认为此篇所存不独美孝子，亦足表贤母。依他看，七子只是婉词几谏、反躬自责，母亦因闻子言而回念，不可诬以淫风流行。","fullText":"方玉润总评中力驳《序》《传》以“卫之淫风流行”说此诗，援孟子“《凱風》，親之過小者也”与两汉碑文、乐府旧语，认为此篇所存不独美孝子，亦足表贤母。依他看，七子只是婉词几谏、反躬自责，母亦因闻子言而回念，不可诬以淫风流行。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"fangyurun-yuanshi:0003-1:part-1","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/032-kai-feng/fangyurun-yuanshi/0003-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"global","layerLabel":"全篇总说","targetText":"眉评","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"眉评","excerpt":"方玉润眉评仅曰“言婉而意愈深”，点出《凱風》不正面斥母、不直陈家事，而以四章比兴回环自责，反更见孝子深情。","fullText":"方玉润眉评仅曰“言婉而意愈深”，点出《凱風》不正面斥母、不直陈家事，而以四章比兴回环自责，反更见孝子深情。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"fangyurun-yuanshi:0004-1:part-1","annotationId":"0004","glossId":"0004-1","glossHref":"/shijing/gloss/032-kai-feng/fangyurun-yuanshi/0004-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"term","layerLabel":"字词注","targetText":"凱風自南吹彼棘心棘心夭夭吹彼棘薪母氏聖善我無令人爰有寒泉在浚之下睍睆黃鳥","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"集释","excerpt":"方玉润集释云：“凱風”为南风长养万物之风，“棘”为难长养小木，“夭夭”见其和茂，“棘薪”为成就者，“聖善”谓明达贤淑，“令”为善，“浚”为卫邑，“睍睆”为黄鸟好貌。整组训诂都围绕“母有长养之德，而七子未足慰母”这一层推进。","fullText":"方玉润集释云：“凱風”为南风长养万物之风，“棘”为难长养小木，“夭夭”见其和茂，“棘薪”为成就者，“聖善”谓明达贤淑，“令”为善，“浚”为卫邑，“睍睆”为黄鸟好貌。整组训诂都围绕“母有长养之德，而七子未足慰母”这一层推进。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-006","seg-007","seg-008","seg-009","seg-010","seg-013"]},{"id":"fangyurun-yuanshi:0005-1:part-1","annotationId":"0005","glossId":"0005-1","glossHref":"/shijing/gloss/032-kai-feng/fangyurun-yuanshi/0005-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"global","layerLabel":"全篇总说","targetText":"标韵","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"标韵","excerpt":"方玉润标出《凱風》四章韵脚：首章“南、心”通韵，“夭、勞”通韵；第二章“薪、人”本韵；第三章“下、苦”叶韵；第四章“音、心”本韵。四章不繁而韵脚清楚，与其婉曲章法相应。","fullText":"方玉润标出《凱風》四章韵脚：首章“南、心”通韵，“夭、勞”通韵；第二章“薪、人”本韵；第三章“下、苦”叶韵；第四章“音、心”本韵。四章不繁而韵脚清楚，与其婉曲章法相应。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"maoheng-zhushu-kr1c0004:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/032-kai-feng/maoheng-zhushu-kr1c0004/0001-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"preface","layerLabel":"篇序","targetText":"凱風美孝子也衛之淫風流行雖有七子之母猶不能安其室故美七子能盡其孝道以慰其母心而成其志爾","sourceLabel":null,"attributionLabel":"诗序","sectionLabel":"序","excerpt":"序：《凱風》，美孝子也。衛之淫風流行，雖有七子之母，猶不能安其室，故美七子能盡其孝道，以慰其母心，而成其志爾。","fullText":"序：《凱風》，美孝子也。衛之淫風流行，雖有七子之母，猶不能安其室，故美七子能盡其孝道，以慰其母心，而成其志爾。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"maoheng-zhushu-kr1c0004:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/032-kai-feng/maoheng-zhushu-kr1c0004/0002-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"span","layerLabel":"诗句片段","targetText":"凱風自南吹彼棘心棘心夭夭母氏劬勞","sourceLabel":null,"attributionLabel":"毛传","sectionLabel":null,"excerpt":"傳：南風謂之凱風。樂夏之長養。夭夭，盛貌。劬勞，病苦也。","fullText":"傳：南風謂之凱風。樂夏之長養。夭夭，盛貌。劬勞，病苦也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004"]},{"id":"maoheng-zhushu-kr1c0004:0003-1:part-1","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/032-kai-feng/maoheng-zhushu-kr1c0004/0003-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"span","layerLabel":"诗句片段","targetText":"凱風自南吹彼棘薪母氏聖善我無令人","sourceLabel":null,"attributionLabel":"毛传","sectionLabel":null,"excerpt":"傳：棘薪，其成就者。聖，叡也。令，善也。","fullText":"傳：棘薪，其成就者。聖，叡也。令，善也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-005","seg-006","seg-007","seg-008"]},{"id":"maoheng-zhushu-kr1c0004:0004-1:part-1","annotationId":"0004","glossId":"0004-1","glossHref":"/shijing/gloss/032-kai-feng/maoheng-zhushu-kr1c0004/0004-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"span","layerLabel":"诗句片段","targetText":"爰有寒泉在浚之下有子七人母氏勞苦","sourceLabel":null,"attributionLabel":"毛传","sectionLabel":null,"excerpt":"傳：浚，衛邑也。在浚之下，言有益於浚。","fullText":"傳：浚，衛邑也。在浚之下，言有益於浚。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-009","seg-010","seg-011","seg-012"]},{"id":"maoheng-zhushu-kr1c0004:0005-1:part-1","annotationId":"0005","glossId":"0005-1","glossHref":"/shijing/gloss/032-kai-feng/maoheng-zhushu-kr1c0004/0005-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"span","layerLabel":"诗句片段","targetText":"睍睆黃鳥載好其音有子七人莫慰母心","sourceLabel":null,"attributionLabel":"毛传","sectionLabel":null,"excerpt":"傳：見睆，好貌。慰，安也。","fullText":"傳：見睆，好貌。慰，安也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-013","seg-014","seg-015","seg-016"]},{"id":"maruichen-tongshi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/032-kai-feng/maruichen-tongshi/0001-1","materialId":"maruichen-tongshi","materialTitle":"毛詩傳箋通釋","contributorLine":"清 · 馬瑞辰","publicationYear":1989,"layer":"span","layerLabel":"诗句片段","targetText":"凱風自南，吹彼棘心。棘心夭夭，母氏劬勞。凱風自南，吹彼棘薪。母氏聖善，我無令人。爰有寒泉，在浚之下。有子七人，母氏勞苦。睍睆黃鳥，載好其音。有子七人，莫慰母心。","sourceLabel":"第 112-113 页","attributionLabel":"马瑞辰","sectionLabel":"按","excerpt":"马瑞辰论《凱風》时，重在申明“以凱風比母，以棘心、棘薪比子”之义，并细辨“聖善”“睍睆”“載好其音”等训诂。他的按语不专向“恶母欲嫁”处用力，而更多从母能慈养、子当顺承的比兴结构说明诗旨，所以全篇仍落实为七子思报母劳而终不能慰母之作。","fullText":"马瑞辰论《凱風》时，重在申明“以凱風比母，以棘心、棘薪比子”之义，并细辨“聖善”“睍睆”“載好其音”等训诂。他的按语不专向“恶母欲嫁”处用力，而更多从母能慈养、子当顺承的比兴结构说明诗旨，所以全篇仍落实为七子思报母劳而终不能慰母之作。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016"]},{"id":"quwanli-quanshi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/032-kai-feng/quwanli-quanshi/0001-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"global","layerLabel":"全篇总说","targetText":"全篇旨意","sourceLabel":"第 37-38 页","attributionLabel":"屈万里","sectionLabel":"注释","excerpt":"屈万里首注仍录《诗序》“《凯风》，美孝子也”，全篇也依此理解为七子感念母劳而自责之诗。他的处理较少作长篇申论，主要通过比兴和词义说明，落实到“母有圣善、子无令人”“有子七人、莫慰母心”的层层反省。","fullText":"屈万里首注仍录《诗序》“《凯风》，美孝子也”，全篇也依此理解为七子感念母劳而自责之诗。他的处理较少作长篇申论，主要通过比兴和词义说明，落实到“母有圣善、子无令人”“有子七人、莫慰母心”的层层反省。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"quwanli-quanshi:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/032-kai-feng/quwanli-quanshi/0002-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"term","layerLabel":"字词注","targetText":"凯风自南吹彼棘心棘心夭夭吹彼棘薪母氏圣善我无令人爰有寒泉在浚之下睍睆黄鸟载好其音","sourceLabel":"第 37-38 页","attributionLabel":"屈万里","sectionLabel":"注释","excerpt":"屈万里释“凯风”为南风，“棘心”为小棘初生之心，“夭夭”为少壮盛貌，“棘薪”为棘已长大可为薪者，“圣”为叡智，“令”为善，“寒泉”为浚邑之泉，“睍睆”为鸟声婉转好貌，“载”为则。整组词注都在显明四章比兴：母能养子，子却不能慰母。","fullText":"屈万里释“凯风”为南风，“棘心”为小棘初生之心，“夭夭”为少壮盛貌，“棘薪”为棘已长大可为薪者，“圣”为叡智，“令”为善，“寒泉”为浚邑之泉，“睍睆”为鸟声婉转好貌，“载”为则。整组词注都在显明四章比兴：母能养子，子却不能慰母。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-006","seg-007","seg-008","seg-009","seg-010","seg-013","seg-014"]},{"id":"wangli-yundu:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/032-kai-feng/wangli-yundu/0001-1","materialId":"wangli-yundu","materialTitle":"詩經韻讀","contributorLine":"现代 · 王力","publicationYear":1980,"layer":"global","layerLabel":"全篇总说","targetText":"《凯风》韵读总说","sourceLabel":"第 154 页","attributionLabel":"王力","sectionLabel":"韵读","excerpt":"王力将《凯风》四章分作四组韵脚：首章“南(nam)、心(sim)”入侵部，“夭(io)、劳(lo)”入宵部；第二章“风、南”仍归侵，而“薪(sien)、人(njien)”转真部；第三章“下(hea)、苦(kha)”入鱼部；第四章“音(jəm)、心(siəm)”复归侵部。章法短整而换韵分明。","fullText":"王力将《凯风》四章分作四组韵脚：首章“南(nam)、心(sim)”入侵部，“夭(io)、劳(lo)”入宵部；第二章“风、南”仍归侵，而“薪(sien)、人(njien)”转真部；第三章“下(hea)、苦(kha)”入鱼部；第四章“音(jəm)、心(siəm)”复归侵部。章法短整而换韵分明。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"wangli-yundu:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/032-kai-feng/wangli-yundu/0002-1","materialId":"wangli-yundu","materialTitle":"詩經韻讀","contributorLine":"现代 · 王力","publicationYear":1980,"layer":"span","layerLabel":"诗句片段","targetText":"凯风自南，吹彼棘心。棘心夭夭，母氏劬劳。凯风自南，吹彼棘薪。母氏圣善，我无令人。爰有寒泉，在浚之下。有子七人，母氏劳苦。睍睆黄鸟，载好其音。有子七人，莫慰母心。","sourceLabel":"第 154 页","attributionLabel":"王力","sectionLabel":"韵读","excerpt":"页图可读《凯风》四章在侵、宵、真、鱼诸部之间往复切换，其中首二章同起于“风自南”，后两章分别用“下/苦”“音/心”收束，声情上也与自责渐深的结构相配。","fullText":"页图可读《凯风》四章在侵、宵、真、鱼诸部之间往复切换，其中首二章同起于“风自南”，后两章分别用“下/苦”“音/心”收束，声情上也与自责渐深的结构相配。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016"]},{"id":"zhuxi-shijichuan-kr1c0009:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/032-kai-feng/zhuxi-shijichuan-kr1c0009/0001-1","materialId":"zhuxi-shijichuan-kr1c0009","materialTitle":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"layer":"span","layerLabel":"诗句片段","targetText":"凱風自南，吹彼棘心。棘心夭夭，母氏劬勞。","sourceLabel":null,"attributionLabel":"朱熹","sectionLabel":null,"excerpt":"比也。朱熹以凱風為長養萬物之南風，以棘心比子之幼弱未成者；首章先本母生衆子、幼而育之之勞，以起諸子自責之端。","fullText":"比也。朱熹以凱風為長養萬物之南風，以棘心比子之幼弱未成者；首章先本母生衆子、幼而育之之勞，以起諸子自責之端。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004"]},{"id":"zhuxi-shijichuan-kr1c0009:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/032-kai-feng/zhuxi-shijichuan-kr1c0009/0002-1","materialId":"zhuxi-shijichuan-kr1c0009","materialTitle":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"layer":"span","layerLabel":"诗句片段","targetText":"凱風自南，吹彼棘薪。母氏聖善，我無令人。","sourceLabel":null,"attributionLabel":"朱熹","sectionLabel":null,"excerpt":"興也。朱熹说棘至可為薪則已長成，用以興子之壯大而無善；復以“母氏聖善”高舉其母，而以“我無令人”深自刻責。","fullText":"興也。朱熹说棘至可為薪則已長成，用以興子之壯大而無善；復以“母氏聖善”高舉其母，而以“我無令人”深自刻責。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-005","seg-006","seg-007","seg-008"]},{"id":"zhuxi-shijichuan-kr1c0009:0003-1:part-1","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/032-kai-feng/zhuxi-shijichuan-kr1c0009/0003-1","materialId":"zhuxi-shijichuan-kr1c0009","materialTitle":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"layer":"span","layerLabel":"诗句片段","targetText":"爰有寒泉，在浚之下。有子七人，母氏勞苦。","sourceLabel":null,"attributionLabel":"朱熹","sectionLabel":null,"excerpt":"興也。朱熹以寒泉在浚之下而能滋益其邑，反衬七子雖多，反不能事母而使母勞苦，故此章把自責推得更痛切。","fullText":"興也。朱熹以寒泉在浚之下而能滋益其邑，反衬七子雖多，反不能事母而使母勞苦，故此章把自責推得更痛切。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-009","seg-010","seg-011","seg-012"]},{"id":"zhuxi-shijichuan-kr1c0009:0004-1:part-1","annotationId":"0004","glossId":"0004-1","glossHref":"/shijing/gloss/032-kai-feng/zhuxi-shijichuan-kr1c0009/0004-1","materialId":"zhuxi-shijichuan-kr1c0009","materialTitle":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"layer":"span","layerLabel":"诗句片段","targetText":"睍睆黃鳥，載好其音。有子七人，莫慰母心。","sourceLabel":null,"attributionLabel":"朱熹","sectionLabel":null,"excerpt":"興也。朱熹言黃鳥尚能以好音悅人，而七子獨不能慰悅母心；以鳥之有益反襯人子之不及，結語尤為沉至。","fullText":"興也。朱熹言黃鳥尚能以好音悅人，而七子獨不能慰悅母心；以鳥之有益反襯人子之不及，結語尤為沉至。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-013","seg-014","seg-015","seg-016"]},{"id":"zhuxi-shijichuan-kr1c0009:0005-1:part-1","annotationId":"0005","glossId":"0005-1","glossHref":"/shijing/gloss/032-kai-feng/zhuxi-shijichuan-kr1c0009/0005-1","materialId":"zhuxi-shijichuan-kr1c0009","materialTitle":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"layer":"global","layerLabel":"全篇总说","targetText":"凱風四章章四句","sourceLabel":null,"attributionLabel":"朱熹","sectionLabel":null,"excerpt":"朱熹记《凱風》为四章、章四句，并通篇视为诸子感母劬劳而自责不能慰母之辞。","fullText":"朱熹记《凱風》为四章、章四句，并通篇视为诸子感母劬劳而自责不能慰母之辞。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]}]}}}
