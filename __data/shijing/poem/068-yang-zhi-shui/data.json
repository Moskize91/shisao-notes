arEnd":4,"entryIds":["maoheng-zhushu-kr1c0004:0001-1:part-2","zhuxi-shijichuan-kr1c0009:0001-1:part-2"],"materialIds":["maoheng-zhushu-kr1c0004","zhuxi-shijichuan-kr1c0009"]},{"id":"seg-010:1-5:不與我戍甫","segmentId":"seg-010","segmentOrder":10,"surfaceText":"不與我戍甫","charStart":1,"charEnd":5,"entryIds":["maoheng-zhushu-kr1c0004:0001-1:part-2","zhuxi-shijichuan-kr1c0009:0001-1:part-2"],"materialIds":["maoheng-zhushu-kr1c0004","zhuxi-shijichuan-kr1c0009"]},{"id":"seg-015:1-4:彼其之子","segmentId":"seg-015","segmentOrder":15,"surfaceText":"彼其之子","charStart":1,"charEnd":4,"entryIds":["maoheng-zhushu-kr1c0004:0001-1:part-2","zhuxi-shijichuan-kr1c0009:0001-1:part-2"],"materialIds":["maoheng-zhushu-kr1c0004","zhuxi-shijichuan-kr1c0009"]},{"id":"seg-016:1-5:不與我戍許","segmentId":"seg-016","segmentOrder":16,"surfaceText":"不與我戍許","charStart":1,"charEnd":5,"entryIds":["maoheng-zhushu-kr1c0004:0001-1:part-2","zhuxi-shijichuan-kr1c0009:0001-1:part-2"],"materialIds":["maoheng-zhushu-kr1c0004","zhuxi-shijichuan-kr1c0009"]}],"entries":[{"id":"chengjunying-jiangjianyuan-zhuxi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/068-yang-zhi-shui/chengjunying-jiangjianyuan-zhuxi/0001-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"扬之水，不流束薪，彼其之子，不与我戍申，怀哉怀哉，曷月予还归哉，扬之水，不流束楚，彼其之子，不与我戍甫，怀哉怀哉，曷月予还归哉，扬之水，不流束蒲，彼其之子，不与我戍许，怀哉怀哉，曷月予还归哉。","sourceLabel":"第 155-157 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","excerpt":"这是一首戍卒思归的诗。史记《周本纪》及《国语·郑语》韦昭注都说：申，姜姓，周平王的舅家。平王父亲幽王娶褒姒，废申后。太子宜臼奔申，幽王伐申。申联合西戎伐周，杀幽王，立宜臼于申，是为平王。另外，吕、许二国对平王东迁洛阳也都出了力。那时南方楚国强大，有并吞小国的野心。申、吕、许三国距王畿甚近，唇齿相依，周王派兵戍守。可是王都地小人稀，派去的兵士到期不能回乡，大家怨恨思归，就作了这首诗。正如方玉润《诗经原始》所指出的：“其所以致民怨嗟，见诸歌咏而不已者，以征调不均，瓜代又难必耳。”\n此诗艺术特点在于含蓄。诗人负羽从军，身处异乡。室家不见，生死相望。对水惊心，析薪断肠。百感交集，岂不凄怆！胸中塞满了独戍异地的怨思，但唱出来的歌词却不怨恨久戍，反而责怪所思念的人不和自己一起戍守。归期无望，而思情又不可遏抑，于是只能作此无聊之想，其情其意显得格外悲凉。清文澜说：“本怨戍申，却以不戍申为辞，何其婉妙。”诗的起句也很有特色，诗人以缓慢的流水漂不动束薪起兴，以寄托诗人无力与新婚妻子团聚的感慨，既含蓄，又深沉。首句“扬之水”起兴的乐调，可能也很悠扬动人，所以被后来诗人采用为诗篇的开头，如郑风的《扬之水》和唐风的《扬之水》都是。\n扬之水，不流束薪。彼其之子，不与我戍申。怀哉怀哉，曷月予还归哉？\n扬，悠扬，水缓流无力貌。鲁诗作杨，是扬的假借字。朱熹《诗集传》：“扬，悠扬也，水缓流之貌。”\n束薪，一捆柴。古代用这个词代表新婚。见《汉广》注。闻一多说：“析薪、束薪，盖上世婚礼中实有之仪式，非泛泛举譬也。”\n其（jì），语助词，亦作记、己。郑笺：“其，或作记，或作己，读声相似。”孔颖达疏：“其，声如‘彼记之子’之记。”“彼”和“子”都是第三人称的代名词，古语往往有这种重复。之子，是子；指作者所怀念的人。朱熹《诗集传》：“彼其之子，戍人指其室家而言也。”\n戍，守卫。毛传：“戍，守边也。”\n申，古国名。在今河南南阳。王肃注：“申，姜姓之国，平王之舅。”\n怀，想念。\n曷，何，指何时。\n还，音义同“旋”。尔雅释言：“还，返也。”郝懿行《尔雅义疏》：“还者……又通作旋。”\n韵读：真部——薪、申。脂部——怀（音回）、怀、归。\n扬之水，不流束楚。彼其之子，不与我戍甫。怀哉怀哉，曷月予还归哉？\n楚，荆条。说文：“楚，丛木。一名荆也。”按楚枝较薪小，形容流水更无力。\n甫，古国名。亦作吕。在今河南南阳西。陈奂传疏：“甫，即吕。诗及《孝经》、《礼记》皆作甫，《尚书》、《左传》、《国语》皆作吕。甫、吕古同声。”\n韵读：鱼部——楚、甫。脂部——怀、怀、归。\n扬之水，不流束蒲。彼其之子，不与我戍许。怀哉怀哉，曷月予还归哉？\n蒲，蒲柳。较荆条枝更细更轻。陆玑《毛诗草木鸟兽虫鱼疏》认为蒲柳有两种：一种青皮称为小杨，一种红皮称为大杨。其叶皆比柳树叶长而宽，枝条都可制箭干。就是左传所说的“董泽之蒲”。\n许，古国名。在今河南省许昌市。按诗共三章，三易戍地。大约这位戍卒久役，曾换了三个防守的地方。\n韵读：鱼部——蒲、许。脂部——怀、怀、归。","fullText":"这是一首戍卒思归的诗。史记《周本纪》及《国语·郑语》韦昭注都说：申，姜姓，周平王的舅家。平王父亲幽王娶褒姒，废申后。太子宜臼奔申，幽王伐申。申联合西戎伐周，杀幽王，立宜臼于申，是为平王。另外，吕、许二国对平王东迁洛阳也都出了力。那时南方楚国强大，有并吞小国的野心。申、吕、许三国距王畿甚近，唇齿相依，周王派兵戍守。可是王都地小人稀，派去的兵士到期不能回乡，大家怨恨思归，就作了这首诗。正如方玉润《诗经原始》所指出的：“其所以致民怨嗟，见诸歌咏而不已者，以征调不均，瓜代又难必耳。”\n此诗艺术特点在于含蓄。诗人负羽从军，身处异乡。室家不见，生死相望。对水惊心，析薪断肠。百感交集，岂不凄怆！胸中塞满了独戍异地的怨思，但唱出来的歌词却不怨恨久戍，反而责怪所思念的人不和自己一起戍守。归期无望，而思情又不可遏抑，于是只能作此无聊之想，其情其意显得格外悲凉。清文澜说：“本怨戍申，却以不戍申为辞，何其婉妙。”诗的起句也很有特色，诗人以缓慢的流水漂不动束薪起兴，以寄托诗人无力与新婚妻子团聚的感慨，既含蓄，又深沉。首句“扬之水”起兴的乐调，可能也很悠扬动人，所以被后来诗人采用为诗篇的开头，如郑风的《扬之水》和唐风的《扬之水》都是。\n扬之水，不流束薪。彼其之子，不与我戍申。怀哉怀哉，曷月予还归哉？\n扬，悠扬，水缓流无力貌。鲁诗作杨，是扬的假借字。朱熹《诗集传》：“扬，悠扬也，水缓流之貌。”\n束薪，一捆柴。古代用这个词代表新婚。见《汉广》注。闻一多说：“析薪、束薪，盖上世婚礼中实有之仪式，非泛泛举譬也。”\n其（jì），语助词，亦作记、己。郑笺：“其，或作记，或作己，读声相似。”孔颖达疏：“其，声如‘彼记之子’之记。”“彼”和“子”都是第三人称的代名词，古语往往有这种重复。之子，是子；指作者所怀念的人。朱熹《诗集传》：“彼其之子，戍人指其室家而言也。”\n戍，守卫。毛传：“戍，守边也。”\n申，古国名。在今河南南阳。王肃注：“申，姜姓之国，平王之舅。”\n怀，想念。\n曷，何，指何时。\n还，音义同“旋”。尔雅释言：“还，返也。”郝懿行《尔雅义疏》：“还者……又通作旋。”\n韵读：真部——薪、申。脂部——怀（音回）、怀、归。\n扬之水，不流束楚。彼其之子，不与我戍甫。怀哉怀哉，曷月予还归哉？\n楚，荆条。说文：“楚，丛木。一名荆也。”按楚枝较薪小，形容流水更无力。\n甫，古国名。亦作吕。在今河南南阳西。陈奂传疏：“甫，即吕。诗及《孝经》、《礼记》皆作甫，《尚书》、《左传》、《国语》皆作吕。甫、吕古同声。”\n韵读：鱼部——楚、甫。脂部——怀、怀、归。\n扬之水，不流束蒲。彼其之子，不与我戍许。怀哉怀哉，曷月予还归哉？\n蒲，蒲柳。较荆条枝更细更轻。陆玑《毛诗草木鸟兽虫鱼疏》认为蒲柳有两种：一种青皮称为小杨，一种红皮称为大杨。其叶皆比柳树叶长而宽，枝条都可制箭干。就是左传所说的“董泽之蒲”。\n许，古国名。在今河南省许昌市。按诗共三章，三易戍地。大约这位戍卒久役，曾换了三个防守的地方。\n韵读：鱼部——蒲、许。脂部——怀、怀、归。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016","seg-017","seg-018"]},{"id":"chenhuan-chuanshu:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/068-yang-zhi-shui/chenhuan-chuanshu/0001-1","materialId":"chenhuan-chuanshu","materialTitle":"詩毛氏傳疏","contributorLine":"清 · 陳奐","publicationYear":1847,"layer":"span","layerLabel":"诗句片段","targetText":"揚之水，不流束薪，彼其之子，不與我戍申，懷哉懷哉，曷月予還歸哉，揚之水，不流束楚，彼其之子，不與我戍甫，懷哉懷哉，曷月予還歸哉，揚之水，不流束蒲，彼其之子，不與我戍許，懷哉懷哉，曷月予還歸哉。","sourceLabel":null,"attributionLabel":"陈奂","sectionLabel":"经文","excerpt":"揚之水，不流束薪，彼其之子，不與我戍申，懷哉懷哉，曷月予還歸哉，揚之水，不流束楚，彼其之子，不與我戍甫，懷哉懷哉，曷月予還歸哉，揚之水，不流束蒲，彼其之子，不與我戍許，懷哉懷哉，曷月予還歸哉。","fullText":"揚之水，不流束薪，彼其之子，不與我戍申，懷哉懷哉，曷月予還歸哉，揚之水，不流束楚，彼其之子，不與我戍甫，懷哉懷哉，曷月予還歸哉，揚之水，不流束蒲，彼其之子，不與我戍許，懷哉懷哉，曷月予還歸哉。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016","seg-017","seg-018"]},{"id":"fangyurun-yuanshi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/068-yang-zhi-shui/fangyurun-yuanshi/0001-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"global","layerLabel":"全篇总说","targetText":"揚之水㊟戍卒怨也。","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"题注","excerpt":"揚之水㊟戍卒怨也。","fullText":"揚之水㊟戍卒怨也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"fangyurun-yuanshi:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/068-yang-zhi-shui/fangyurun-yuanshi/0002-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"global","layerLabel":"全篇总说","targetText":"右《揚之水》三章，章六句。經文明明言戍申、戍甫、戍許，而《序》偏云「戍于母家」，致啟《集傳》忘讐逆理之論，是皆未嘗即當日形勢而一思之耳。夫周轍既東，楚實强盛。京洛形勢，左據成臯，右控崤函，背枕黄河，面俯嵩高。則申、甫、許實爲南服屏蔽。而三國又非楚敵，不得不戍重兵以相保守，然後東都可以立國。觀於三國吴、魏相持，兩家重鎮必屯襄、樊，則往事可知。平王此時，不申、甫、許之是戍而何戍耶？其所以致民怨嗟、見諸歌咏而不已者，以徵調不均，瓜代又難必耳。夫徵調不均，則勞逸異勢；瓜代難必，則生聚無期。不惟小民怨咨，亦足見秉國者之措置乖方，籌謀未善。若宗周形勝，則豈慮是哉？此東都之不再振而西轍之難歸者，有由然矣。若沾沾謂其篤於母家，致令久戍不歸，則何異小兒夢囈！不識時務之甚。吾恐平王君臣，竊相笑於地下也。","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"总评","excerpt":"右《揚之水》三章，章六句。經文明明言戍申、戍甫、戍許，而《序》偏云「戍于母家」，致啟《集傳》忘讐逆理之論，是皆未嘗即當日形勢而一思之耳。夫周轍既東，楚實强盛。京洛形勢，左據成臯，右控崤函，背枕黄河，面俯嵩高。則申、甫、許實爲南服屏蔽。而三國又非楚敵，不得不戍重兵以相保守，然後東都可以立國。觀於三國吴、魏相持，兩家重鎮必屯襄、樊，則往事可知。平王此時，不申、甫、許之是戍而何戍耶？其所以致民怨嗟、見諸歌咏而不已者，以徵調不均，瓜代又難必耳。夫徵調不均，則勞逸異勢；瓜代難必，則生聚無期。不惟小民怨咨，亦足見秉國者之措置乖方，籌謀未善。若宗周形勝，則豈慮是哉？此東都之不再振而西轍之難歸者，有由然矣。若沾沾謂其篤於母家，致令久戍不歸，則何異小兒夢囈！不識時務之甚。吾恐平王君臣，竊相笑於地下也。","fullText":"右《揚之水》三章，章六句。經文明明言戍申、戍甫、戍許，而《序》偏云「戍于母家」，致啟《集傳》忘讐逆理之論，是皆未嘗即當日形勢而一思之耳。夫周轍既東，楚實强盛。京洛形勢，左據成臯，右控崤函，背枕黄河，面俯嵩高。則申、甫、許實爲南服屏蔽。而三國又非楚敵，不得不戍重兵以相保守，然後東都可以立國。觀於三國吴、魏相持，兩家重鎮必屯襄、樊，則往事可知。平王此時，不申、甫、許之是戍而何戍耶？其所以致民怨嗟、見諸歌咏而不已者，以徵調不均，瓜代又難必耳。夫徵調不均，則勞逸異勢；瓜代難必，則生聚無期。不惟小民怨咨，亦足見秉國者之措置乖方，籌謀未善。若宗周形勝，則豈慮是哉？此東都之不再振而西轍之難歸者，有由然矣。若沾沾謂其篤於母家，致令久戍不歸，則何異小兒夢囈！不識時務之甚。吾恐平王君臣，竊相笑於地下也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"fangyurun-yuanshi:0003-1:part-1","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/068-yang-zhi-shui/fangyurun-yuanshi/0003-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"term","layerLabel":"字词注","targetText":"揚悠揚也，水緩流之貌。","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"集释","excerpt":"揚悠揚也，水緩流之貌。","fullText":"揚悠揚也，水緩流之貌。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"fangyurun-yuanshi:0004-1:part-1","annotationId":"0004","glossId":"0004-1","glossHref":"/shijing/gloss/068-yang-zhi-shui/fangyurun-yuanshi/0004-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"term","layerLabel":"字词注","targetText":"彼其之子〔案〕姚氏際恒曰：鄭氏謂「處鄉里者」，歐陽氏謂「國人怨諸侯不戍申」，皆可通。《集傳》謂「指室家」，則謬矣。","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"集释","excerpt":"彼其之子〔案〕姚氏際恒曰：鄭氏謂「處鄉里者」，歐陽氏謂「國人怨諸侯不戍申」，皆可通。《集傳》謂「指室家」，則謬矣。","fullText":"彼其之子〔案〕姚氏際恒曰：鄭氏謂「處鄉里者」，歐陽氏謂「國人怨諸侯不戍申」，皆可通。《集傳》謂「指室家」，則謬矣。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"fangyurun-yuanshi:0005-1:part-1","annotationId":"0005","glossId":"0005-1","glossHref":"/shijing/gloss/068-yang-zhi-shui/fangyurun-yuanshi/0005-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"term","layerLabel":"字词注","targetText":"戍屯兵以守也。","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"集释","excerpt":"戍屯兵以守也。","fullText":"戍屯兵以守也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"fangyurun-yuanshi:0006-1:part-1","annotationId":"0006","glossId":"0006-1","glossHref":"/shijing/gloss/068-yang-zhi-shui/fangyurun-yuanshi/0006-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"term","layerLabel":"字词注","targetText":"申〔梁氏益曰〕申，伯爵，初爲侯，平王母申姜國，楚靈王遷之。今信陽之方城内也。〔《皇輿表》〕鄧州屬南陽府，信陽軍屬汝甯府，並隸河南。","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"集释","excerpt":"申〔梁氏益曰〕申，伯爵，初爲侯，平王母申姜國，楚靈王遷之。今信陽之方城内也。〔《皇輿表》〕鄧州屬南陽府，信陽軍屬汝甯府，並隸河南。","fullText":"申〔梁氏益曰〕申，伯爵，初爲侯，平王母申姜國，楚靈王遷之。今信陽之方城内也。〔《皇輿表》〕鄧州屬南陽府，信陽軍屬汝甯府，並隸河南。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"fangyurun-yuanshi:0007-1:part-1","annotationId":"0007","glossId":"0007-1","glossHref":"/shijing/gloss/068-yang-zhi-shui/fangyurun-yuanshi/0007-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"term","layerLabel":"字词注","targetText":"楚木也。〔陸氏佃曰〕楚者，楚地所出，其一名荆，故楚入《春秋》稱荆，而荆州亦以此木得名。","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"集释","excerpt":"楚木也。〔陸氏佃曰〕楚者，楚地所出，其一名荆，故楚入《春秋》稱荆，而荆州亦以此木得名。","fullText":"楚木也。〔陸氏佃曰〕楚者，楚地所出，其一名荆，故楚入《春秋》稱荆，而荆州亦以此木得名。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"fangyurun-yuanshi:0008-1:part-1","annotationId":"0008","glossId":"0008-1","glossHref":"/shijing/gloss/068-yang-zhi-shui/fangyurun-yuanshi/0008-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"term","layerLabel":"字词注","targetText":"甫〔《集傳》〕甫，即吕也，亦姜姓。《書》「吕刑」，《禮記》作「甫刑」。而孔氏以爲吕侯後爲甫侯，是也。〔王氏應麟曰〕《史記》：「吕尚先祖爲四岳，佐禹治水有功，虞、夏之際受封於吕。」《括地志》：「故吕城在鄧州南陽縣西四十里。」《吕氏春秋》：「吕在宛縣西。」","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"集释","excerpt":"甫〔《集傳》〕甫，即吕也，亦姜姓。《書》「吕刑」，《禮記》作「甫刑」。而孔氏以爲吕侯後爲甫侯，是也。〔王氏應麟曰〕《史記》：「吕尚先祖爲四岳，佐禹治水有功，虞、夏之際受封於吕。」《括地志》：「故吕城在鄧州南陽縣西四十里。」《吕氏春秋》：「吕在宛縣西。」","fullText":"甫〔《集傳》〕甫，即吕也，亦姜姓。《書》「吕刑」，《禮記》作「甫刑」。而孔氏以爲吕侯後爲甫侯，是也。〔王氏應麟曰〕《史記》：「吕尚先祖爲四岳，佐禹治水有功，虞、夏之際受封於吕。」《括地志》：「故吕城在鄧州南陽縣西四十里。」《吕氏春秋》：「吕在宛縣西。」","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"fangyurun-yuanshi:0009-1:part-1","annotationId":"0009","glossId":"0009-1","glossHref":"/shijing/gloss/068-yang-zhi-shui/fangyurun-yuanshi/0009-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"term","layerLabel":"字词注","targetText":"蒲〔嚴氏粲曰〕毛以爲草，鄭以爲蒲柳，皆通。〔案〕「蒲草」見《陳·澤陂》，「蒲柳」見《陳·東門之楊》。","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"集释","excerpt":"蒲〔嚴氏粲曰〕毛以爲草，鄭以爲蒲柳，皆通。〔案〕「蒲草」見《陳·澤陂》，「蒲柳」見《陳·東門之楊》。","fullText":"蒲〔嚴氏粲曰〕毛以爲草，鄭以爲蒲柳，皆通。〔案〕「蒲草」見《陳·澤陂》，「蒲柳」見《陳·東門之楊》。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"fangyurun-yuanshi:0010-1:part-1","annotationId":"0010","glossId":"0010-1","glossHref":"/shijing/gloss/068-ya