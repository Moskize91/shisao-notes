charEnd":3,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-7"],"materialIds":["chengjunying-jiangjianyuan-zhuxi"]},{"id":"seg-012:1-3:隰有杨","segmentId":"seg-012","segmentOrder":12,"surfaceText":"隰有杨","charStart":1,"charEnd":3,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-6"],"materialIds":["chengjunying-jiangjianyuan-zhuxi"]},{"id":"seg-012:3-3:杨","segmentId":"seg-012","segmentOrder":12,"surfaceText":"杨","charStart":3,"charEnd":3,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-7"],"materialIds":["chengjunying-jiangjianyuan-zhuxi"]},{"id":"seg-013:1-4:既见君子","segmentId":"seg-013","segmentOrder":13,"surfaceText":"既见君子","charStart":1,"charEnd":4,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-6"],"materialIds":["chengjunying-jiangjianyuan-zhuxi"]},{"id":"seg-014:1-4:并坐鼓簧","segmentId":"seg-014","segmentOrder":14,"surfaceText":"并坐鼓簧","charStart":1,"charEnd":4,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-6"],"materialIds":["chengjunying-jiangjianyuan-zhuxi"]},{"id":"seg-014:4-4:簧","segmentId":"seg-014","segmentOrder":14,"surfaceText":"簧","charStart":4,"charEnd":4,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-7"],"materialIds":["chengjunying-jiangjianyuan-zhuxi"]},{"id":"seg-015:1-4:今者不乐","segmentId":"seg-015","segmentOrder":15,"surfaceText":"今者不乐","charStart":1,"charEnd":4,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-6"],"materialIds":["chengjunying-jiangjianyuan-zhuxi"]},{"id":"seg-016:1-4:逝者其亡","segmentId":"seg-016","segmentOrder":16,"surfaceText":"逝者其亡","charStart":1,"charEnd":4,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-6"],"materialIds":["chengjunying-jiangjianyuan-zhuxi"]},{"id":"seg-016:4-4:亡","segmentId":"seg-016","segmentOrder":16,"surfaceText":"亡","charStart":4,"charEnd":4,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-7"],"materialIds":["chengjunying-jiangjianyuan-zhuxi"]}],"entries":[{"id":"chengjunying-jiangjianyuan-zhuxi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/126-che-lin/chengjunying-jiangjianyuan-zhuxi/0001-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"有车邻邻，有马白颠。未见君子，寺人之令。阪有漆，隰有栗。既见君子，并坐鼓瑟。今者不乐，逝者其耋。阪有桑，隰有杨。既见君子，并坐鼓簧。今者不乐，逝者其亡。","sourceLabel":"第 283-285 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","excerpt":"这是一首反映秦君生活的诗。“寺人”是当时宫中的侍从。毛序：“车邻，美秦仲也。秦仲始大，有车马礼乐侍御之好焉。”郑笺：“君臣以闲暇燕饮相安乐也。”后儒多据此认为是“君臣相得”之诗。但细味“阪有漆，隰有栗”的兴句，诗人似乎是一位女性，可能是秦君宫中的姆妾。最初因没有寺人的传令，见不到秦君；后来既见君子，秦君又颇为随和，同她并坐鼓瑟鼓簧，并言“今者不乐，逝者其耋（亡）”。方玉润评曰：“未见时如此严肃，既见时如此简易。”","fullText":"这是一首反映秦君生活的诗。“寺人”是当时宫中的侍从。毛序：“车邻，美秦仲也。秦仲始大，有车马礼乐侍御之好焉。”郑笺：“君臣以闲暇燕饮相安乐也。”后儒多据此认为是“君臣相得”之诗。但细味“阪有漆，隰有栗”的兴句，诗人似乎是一位女性，可能是秦君宫中的姆妾。最初因没有寺人的传令，见不到秦君；后来既见君子，秦君又颇为随和，同她并坐鼓瑟鼓簧，并言“今者不乐，逝者其耋（亡）”。方玉润评曰：“未见时如此严肃，既见时如此简易。”有车邻邻，有马白颠。未见君子，寺人之令。邻邻，车行声。白颠，马额正中有白毛。寺人，宫内小臣，掌传令。韵读：真部——邻、颠、令。阪有漆，隰有栗。既见君子，并坐鼓瑟。今者不乐，逝者其耋。阪，山坡。隰，低洼潮湿之地。鼓瑟，谓并坐弹瑟。逝者，谓将来。耋，老，泛指高年。韵读：脂部——漆、栗、瑟、耋。阪有桑，隰有杨。既见君子，并坐鼓簧。今者不乐，逝者其亡。簧，乐器名。亡，死亡。此二句亦言来日无多，当及时行乐。韵读：阳部——桑、杨、簧、亡。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016"]},{"id":"chengjunying-jiangjianyuan-zhuxi:0001-1:part-2","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/126-che-lin/chengjunying-jiangjianyuan-zhuxi/0001-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"有车邻邻，有马白颠。未见君子，寺人之令。阪有漆，隰有栗。既见君子，并坐鼓瑟。今者不乐，逝者其耋。阪有桑，隰有杨。既见君子，并坐鼓簧。今者不乐，逝者其亡。","sourceLabel":"第 283-285 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","excerpt":"有车邻邻，有马白颠。未见君子，寺人之令。","fullText":"这是一首反映秦君生活的诗。“寺人”是当时宫中的侍从。毛序：“车邻，美秦仲也。秦仲始大，有车马礼乐侍御之好焉。”郑笺：“君臣以闲暇燕饮相安乐也。”后儒多据此认为是“君臣相得”之诗。但细味“阪有漆，隰有栗”的兴句，诗人似乎是一位女性，可能是秦君宫中的姆妾。最初因没有寺人的传令，见不到秦君；后来既见君子，秦君又颇为随和，同她并坐鼓瑟鼓簧，并言“今者不乐，逝者其耋（亡）”。方玉润评曰：“未见时如此严肃，既见时如此简易。”有车邻邻，有马白颠。未见君子，寺人之令。邻邻，车行声。白颠，马额正中有白毛。寺人，宫内小臣，掌传令。韵读：真部——邻、颠、令。阪有漆，隰有栗。既见君子，并坐鼓瑟。今者不乐，逝者其耋。阪，山坡。隰，低洼潮湿之地。鼓瑟，谓并坐弹瑟。逝者，谓将来。耋，老，泛指高年。韵读：脂部——漆、栗、瑟、耋。阪有桑，隰有杨。既见君子，并坐鼓簧。今者不乐，逝者其亡。簧，乐器名。亡，死亡。此二句亦言来日无多，当及时行乐。韵读：阳部——桑、杨、簧、亡。","notes":null,"partOrder":2,"anchorIds":["seg-001:1-4:有车邻邻","seg-002:1-4:有马白颠","seg-003:1-4:未见君子","seg-004:1-4:寺人之令"],"glossAnchorIds":["anchor-2-1","anchor-2-2","anchor-2-3","anchor-2-4"],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016"]},{"id":"chengjunying-jiangjianyuan-zhuxi:0001-1:part-3","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/126-che-lin/chengjunying-jiangjianyuan-zhuxi/0001-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"有车邻邻，有马白颠。未见君子，寺人之令。阪有漆，隰有栗。既见君子，并坐鼓瑟。今者不乐，逝者其耋。阪有桑，隰有杨。既见君子，并坐鼓簧。今者不乐，逝者其亡。","sourceLabel":"第 283-285 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","excerpt":"邻邻，车行声。白颠，马额正中有白毛。寺人，宫内小臣，掌传令。韵读：真部——邻、颠、令。","fullText":"这是一首反映秦君生活的诗。“寺人”是当时宫中的侍从。毛序：“车邻，美秦仲也。秦仲始大，有车马礼乐侍御之好焉。”郑笺：“君臣以闲暇燕饮相安乐也。”后儒多据此认为是“君臣相得”之诗。但细味“阪有漆，隰有栗”的兴句，诗人似乎是一位女性，可能是秦君宫中的姆妾。最初因没有寺人的传令，见不到秦君；后来既见君子，秦君又颇为随和，同她并坐鼓瑟鼓簧，并言“今者不乐，逝者其耋（亡）”。方玉润评曰：“未见时如此严肃，既见时如此简易。”有车邻邻，有马白颠。未见君子，寺人之令。邻邻，车行声。白颠，马额正中有白毛。寺人，宫内小臣，掌传令。韵读：真部——邻、颠、令。阪有漆，隰有栗。既见君子，并坐鼓瑟。今者不乐，逝者其耋。阪，山坡。隰，低洼潮湿之地。鼓瑟，谓并坐弹瑟。逝者，谓将来。耋，老，泛指高年。韵读：脂部——漆、栗、瑟、耋。阪有桑，隰有杨。既见君子，并坐鼓簧。今者不乐，逝者其亡。簧，乐器名。亡，死亡。此二句亦言来日无多，当及时行乐。韵读：阳部——桑、杨、簧、亡。","notes":null,"partOrder":3,"anchorIds":["seg-001:3-4:邻邻","seg-002:3-4:白颠","seg-004:1-2:寺人","seg-004:4-4:令"],"glossAnchorIds":["anchor-3-1","anchor-3-2","anchor-3-3","anchor-3-4"],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-