5"],"materialIds":["chengjunying-jiangjianyuan-zhuxi"]},{"id":"seg-004:8-8:簋","segmentId":"seg-004","segmentOrder":4,"surfaceText":"簋","charStart":8,"charEnd":8,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-6","chengjunying-jiangjianyuan-zhuxi:0001-1:part-7"],"materialIds":["chengjunying-jiangjianyuan-zhuxi"]},{"id":"seg-005:1-7:今也每食不飽。","segmentId":"seg-005","segmentOrder":5,"surfaceText":"今也每食不飽。","charStart":1,"charEnd":7,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-5"],"materialIds":["chengjunying-jiangjianyuan-zhuxi"]},{"id":"seg-005:6-6:飽","segmentId":"seg-005","segmentOrder":5,"surfaceText":"飽","charStart":6,"charEnd":6,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-7"],"materialIds":["chengjunying-jiangjianyuan-zhuxi"]},{"id":"seg-006:1-9:于嗟乎！不承權輿。","segmentId":"seg-006","segmentOrder":6,"surfaceText":"于嗟乎！不承權輿。","charStart":1,"charEnd":9,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-5"],"materialIds":["chengjunying-jiangjianyuan-zhuxi"]},{"id":"seg-006:3-3:乎","segmentId":"seg-006","segmentOrder":6,"surfaceText":"乎","charStart":3,"charEnd":3,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-7"],"materialIds":["chengjunying-jiangjianyuan-zhuxi"]},{"id":"seg-006:8-8:輿","segmentId":"seg-006","segmentOrder":6,"surfaceText":"輿","charStart":8,"charEnd":8,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-7"],"materialIds":["chengjunying-jiangjianyuan-zhuxi"]}],"entries":[{"id":"chengjunying-jiangjianyuan-zhuxi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/135-quan-yu/chengjunying-jiangjianyuan-zhuxi/0001-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"於我乎，夏屋渠渠。今也每食無餘。于嗟乎！不承權輿。於我乎，每食四簋。今也每食不飽。于嗟乎！不承權輿。","sourceLabel":"第 303-304 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","excerpt":"这是一首没落贵族回想当年生活而自伤的诗。春秋时代私田渐多，各国纷纷实行按亩税田，领主没落，生活下降，这首诗正是当时社会变革的一种反映。毛序说“权舆，刺康公也。忘先君之旧臣与贤者有始而无终也”，虽多附会，但“有始而无终”一语确能领略诗中的情绪。方玉润评曰：“起似居食双题，下乃单承侧重食一面，局法变换不测，于此可悟文法化板为活之妙。”","fullText":"这是一首没落贵族回想当年生活而自伤的诗。春秋时代私田渐多，各国纷纷实行按亩税田，领主没落，生活下降，这首诗正是当时社会变革的一种反映。毛序说“权舆，刺康公也。忘先君之旧臣与贤者有始而无终也”，虽多附会，但“有始而无终”一语确能领略诗中的情绪。方玉润评曰：“起似居食双题，下乃单承侧重食一面，局法变换不测，于此可悟文法化板为活之妙。”於我乎，夏屋渠渠。今也每食無餘。于嗟乎！不承權輿。於，同乌，叹词。夏屋，大屋。渠渠，高大貌。承，继承。權輿，始初。韵读：鱼部一一乎、渠、餘、乎、輿。於我乎，每食四簋。今也每食不飽。于嗟乎！不承權輿。簋，古代盛饭的食器。韵读：纸部一一簋；巧部一一飽；鱼部一一乎、輿。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006"]},{"id":"chengjunying-jiangjianyuan-zhuxi:0001-1:part-2","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/135-quan-yu/chengjunying-jiangjianyuan-zhuxi/0001-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"於我乎，夏屋渠渠。今也每食無餘。于嗟乎！不承權輿。於我乎，每食四簋。今也每食不飽。于嗟乎！不承權輿。","sourceLabel":"第 303-304 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","excerpt":"於我乎，夏屋渠渠。今也每食無餘。于嗟乎！不承權輿。","fullText":"这是一首没落贵族回想当年生活而自伤的诗。春秋时代私田渐多，各国纷纷实行按亩税田，领主没落，生活下降，这首诗正是当时社会变革的一种反映。毛序说“权舆，刺康公也。忘先君之旧臣与贤者有始而无终也”，虽多附会，但“有始而无终”一语确能领略诗中的情绪。方玉润评曰：“起似居食双题，下乃单承侧重食一面，局法变换不测，于此可悟文法化板为活之妙。”於我乎，夏屋渠渠。今也每食無餘。于嗟乎！不承權輿。於，同乌，叹词。夏屋，大屋。渠渠，高大貌。承，继承。權輿，始初。韵读：鱼部一一乎、渠、餘、乎、輿。於我乎，每食四簋。今也每食不飽。于嗟乎！不承權輿。簋，古代盛饭的食器。韵读：纸部一一簋；巧部一一飽；鱼部一一乎、輿。","notes":null,"partOrder":2,"anchorIds":["seg-001:1-9:於我乎，夏屋渠渠。","seg-002:1-7:今也每食無餘。","seg-003:1-9:于嗟乎！不承權輿。"],"glossAnchorIds":["anchor-2-1","anchor-2-2","anchor-2-3"],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006"]},{"id":"chengjunying-jiangjianyuan-zhuxi:0001-1:part-3","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/135-quan-yu/chengjunying-jiangjianyuan-zhuxi/0001-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"