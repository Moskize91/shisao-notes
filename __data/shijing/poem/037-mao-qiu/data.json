["chengjunying-jiangjianyuan-zhuxi:0005-1:part-1","chenhuan-chuanshu:0002-1:part-1","fangyurun-yuanshi:0004-1:part-1","maoheng-zhushu-kr1c0004:0005-1:part-1","maruichen-tongshi:0001-1:part-1","quwanli-quanshi:0002-1:part-1","wangli-yundu:0002-1:part-1","zhuxi-shijichuan-kr1c0009:0004-1:part-1"],"characters":[{"index":1,"text":"褎","anchorIds":[]},{"index":2,"text":"如","anchorIds":[]},{"index":3,"text":"充","anchorIds":[]},{"index":4,"text":"耳","anchorIds":[]}]}]},"materials":[{"id":"maoheng-zhushu-kr1c0004","title":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"glossCount":5,"partCount":5},{"id":"zhuxi-shijichuan-kr1c0009","title":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"glossCount":5,"partCount":5},{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","contributorLine":"清 · 陳奐","publicationYear":1847,"glossCount":2,"partCount":2},{"id":"wangli-yundu","title":"詩經韻讀","contributorLine":"现代 · 王力","publicationYear":1980,"glossCount":2,"partCount":2},{"id":"quwanli-quanshi","title":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"glossCount":2,"partCount":2},{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"glossCount":4,"partCount":4},{"id":"maruichen-tongshi","title":"毛詩傳箋通釋","contributorLine":"清 · 馬瑞辰","publicationYear":1989,"glossCount":1,"partCount":1},{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"glossCount":5,"partCount":5}],"stats":{"materialCount":8,"glossCount":26,"anchoredPartCount":0,"overviewPartCount":9},"overview":{"prefaceEntryIds":["chenhuan-chuanshu:0001-1:part-1","maoheng-zhushu-kr1c0004:0001-1:part-1"],"globalEntryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-1","fangyurun-yuanshi:0001-1:part-1","fangyurun-yuanshi:0002-1:part-1","fangyurun-yuanshi:0003-1:part-1","quwanli-quanshi:0001-1:part-1","wangli-yundu:0001-1:part-1","zhuxi-shijichuan-kr1c0009:0005-1:part-1"]},"focusAnchors":[],"entries":[{"id":"chengjunying-jiangjianyuan-zhuxi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/037-mao-qiu/chengjunying-jiangjianyuan-zhuxi/0001-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"global","layerLabel":"全篇总说","targetText":"题解","sourceLabel":"第 77 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","excerpt":"程俊英、蒋见元把《旄丘》解释为流亡到卫国的黎国人盼卫救济而久不得助之诗，基本承《诗序》“责卫伯不能修方伯连率之职”一路，但强调诗中最终情绪已从责卫转成绝望，实含劝归之意。","fullText":"程俊英、蒋见元把《旄丘》解释为流亡到卫国的黎国人盼卫救济而久不得助之诗，基本承《诗序》“责卫伯不能修方伯连率之职”一路，但强调诗中最终情绪已从责卫转成绝望，实含劝归之意。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"chengjunying-jiangjianyuan-zhuxi:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/037-mao-qiu/chengjunying-jiangjianyuan-zhuxi/0002-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"旄丘之葛兮，何诞之节兮。叔兮伯兮，何多日也。","sourceLabel":"第 77 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","excerpt":"首章以旄丘之葛起兴，问葛何以蔓延如此，又转问“叔兮伯兮，何多日也”。程、蒋认为此处所呼“叔伯”即卫国贵族，首章主要写流亡者久盼救援不至，怀着希望而发问。","fullText":"首章以旄丘之葛起兴，问葛何以蔓延如此，又转问“叔兮伯兮，何多日也”。程、蒋认为此处所呼“叔伯”即卫国贵族，首章主要写流亡者久盼救援不至，怀着希望而发问。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004"]},{"id":"chengjunying-jiangjianyuan-zhuxi:0003-1:part-1","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/037-mao-qiu/chengjunying-jiangjianyuan-zhuxi/0003-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"何其处也，必有与也。何其久也，必有以也。","sourceLabel":"第 77-78 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","excerpt":"第二章连用两组设问而自答：“必有与也”“必有以也”。程、蒋解释为流亡者给自己寻找理由，设想卫国或许别有所待、别有所挟，所以迟迟不来；言外正见其久盼久候而仍不忍断绝希望。","fullText":"第二章连用两组设问而自答：“必有与也”“必有以也”。程、蒋解释为流亡者给自己寻找理由，设想卫国或许别有所待、别有所挟，所以迟迟不来；言外正见其久盼久候而仍不忍断绝希望。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-005","seg-006","seg-007","seg-008"]},{"id":"chengjunying-jiangjianyuan-zhuxi:0004-1:part-1","annotationId":"0004","glossId":"0004-1","glossHref":"/shijing/gloss/037-mao-qiu/chengjunying-jiangjianyuan-zhuxi/0004-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"狐裘蒙戎，匪车不东。叔兮伯兮，靡所与同。","sourceLabel":"第 78 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","excerpt":"三章改用赋法，以“狐裘蒙戎，匪车不东”写卫国贵族衣冠整肃而车辆终不东来救黎。程、蒋认为这一章标志诗意转折：此前的希望至此开始破灭，诗人意识到卫国贵族与自己并不同心。","fullText":"三章改用赋法，以“狐裘蒙戎，匪车不东”写卫国贵族衣冠整肃而车辆终不东来救黎。程、蒋认为这一章标志诗意转折：此前的希望至此开始破灭，诗人意识到卫国贵族与自己并不同心。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-009","seg-010","seg-011","seg-012"]},{"id":"chengjunying-jiangjianyuan-zhuxi:0005-1:part-1","annotationId":"0005","glossId":"0005-1","glossHref":"/shijing/gloss/037-mao-qiu/chengjunying-jiangjianyuan-zhuxi/0005-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"琐兮尾兮，流离之子。叔兮伯兮，褎如充耳。","sourceLabel":"第 78-79 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","excerpt":"末章以“琐兮尾兮，流离之子”自写流亡困苦、细碎疲敝之状，而卫国诸臣却“褎如充耳”，盛服若聋，置若罔闻。程、蒋据此指出，这已不是单纯责卫，而是绝望之后转为劝君早归故国。","fullText":"末章以“琐兮尾兮，流离之子”自写流亡困苦、细碎疲敝之状，而卫国诸臣却“褎如充耳”，盛服若聋，置若罔闻。程、蒋据此指出，这已不是单纯责卫，而是绝望之后转为劝君早归故国。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-013","seg-014","seg-015","seg-016"]},{"id":"chenhuan-chuanshu:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/037-mao-qiu/chenhuan-chuanshu/0001-1","materialId":"chenhuan-chuanshu","materialTitle":"詩毛氏傳疏","contributorLine":"清 · 陳奐","publicationYear":1847,"layer":"preface","layerLabel":"篇序","targetText":"旄丘責衛伯也狄人迫逐黎侯黎侯寓於衛衛不能脩方伯連率之職黎之臣子以責於衛也","sourceLabel":"第 61 页","attributionLabel":"诗序","sectionLabel":"序","excerpt":"序：《旄丘》，責衛伯也。狄人迫逐黎侯，黎侯寓於衛，衛不能脩方伯連率之職，黎之臣子以責於衛也。","fullText":"序：《旄丘》，責衛伯也。狄人迫逐黎侯，黎侯寓於衛，衛不能脩方伯連率之職，黎之臣子以責於衛也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"chenhuan-chuanshu:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/037-mao-qiu/chenhuan-chuanshu/0002-1","materialId":"chenhuan-chuanshu","materialTitle":"詩毛氏傳疏","contributorLine":"清 · 陳奐","publicationYear":1847,"layer":"span","layerLabel":"诗句片段","targetText":"旄丘之葛兮，何誕之節兮。叔兮伯兮，何多日也。何其處也，必有與也。何其久也，必有以也。狐裘蒙戎，匪車不東。叔兮伯兮，靡所與同。瑣兮尾兮，流離之子。叔兮伯兮，褎如充耳。","sourceLabel":"第 61-62 页","attributionLabel":"陈奂","sectionLabel":"疏","excerpt":"陈奂疏《旄丘》时紧承《序》责卫伯说，认为全诗从久望其来、为其迟来设辞，到见其狐裘乘车而终不东来，再至末章责其盛服充耳、绝无同心，层层写出黎臣责卫不修方伯之职。其疏重心在于坐实诗旨为责卫，而非泛写流离之苦。","fullText":"陈奂疏《旄丘》时紧承《序》责卫伯说，认为全诗从久望其来、为其迟来设辞，到见其狐裘乘车而终不东来，再至末章责其盛服充耳、绝无同心，层层写出黎臣责卫不修方伯之职。其疏重心在于坐实诗旨为责卫，而非泛写流离之苦。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016"]},{"id":"fangyurun-yuanshi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/037-mao-qiu/fangyurun-yuanshi/0001-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"global","layerLabel":"全篇总说","targetText":"旄丘㊟黎臣勸君勿望救於衛也。","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"题注","excerpt":"方玉润题注把《旄丘》径定为黎臣劝君勿再望卫之救、当早归自振之诗。","fullText":"方玉润题注把《旄丘》径定为黎臣劝君勿再望卫之救、当早归自振之诗。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"fangyurun-yuanshi:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/037-mao-qiu/fangyurun-yuanshi/0002-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"global","layerLabel":"全篇总说","targetText":"总评","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"总评","excerpt":"方玉润总评力转《序》“责卫伯不能救黎”之说，认为黎国自身不振，卫不来救未足深责；全诗虽若责人，意实劝君。四章从犹有望救之心写到知其无意于我，最后归结为“不如谋归故国之为愈”，仍是一片忧国爱君之心。","fullText":"方玉润总评力转《序》“责卫伯不能救黎”之说，认为黎国自身不振，卫不来救未足深责；全诗虽若责人，意实劝君。四章从犹有望救之心写到知其无意于我，最后归结为“不如谋归故国之为愈”，仍是一片忧国爱君之心。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"fangyurun-yuanshi:0003-1:part-1","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/037-mao-qiu/fangyurun-yuanshi/0003-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"global","layerLabel":"全篇总说","targetText":"眉评","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"眉评","excerpt":"方玉润只拈出第二章，称“自问自答，望人情景如画”，以点明本篇妙处正在盼望者心态的层层自解与自破。","fullText":"方玉润只拈出第二章，称“自问自答，望人情景如画”，以点明本篇妙处正在盼望者心态的层层自解与自破。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"fangyurun-yuanshi:0004-1:part-1","annotationId":"0004","glossId":"0004-1","glossHref":"/shijing/gloss/037-mao-qiu/fangyurun-yuanshi/0004-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"term","layerLabel":"字词注","targetText":"旄丘之葛兮何誕之節兮必有與也必有以也狐裘蒙戎匪車不東流離之子褎如充耳","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"集释","excerpt":"方玉润集释辨“旄丘”为前高后下之丘，“誕”当从延长义，“與”为与我伐狄，“以”为所以左右之；又训“狐裘”“蒙戎”“不東”“流離”“褎”“充耳”等，以证明卫国诸臣盛服自安而无意东来，正是末路绝望之根由。","fullText":"方玉润集释辨“旄丘”为前高后下之丘，“誕”当从延长义，“與”为与我伐狄，“以”为所以左右之；又训“狐裘”“蒙戎”“不東”“流離”“褎”“充耳”等，以证明卫国诸臣盛服自安而无意东来，正是末路绝望之根由。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-006","seg-008","seg-009","seg-010","seg-014","seg-016"]},{"id":"maoheng-zhushu-kr1c0004:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/037-mao-qiu/maoheng-zhushu-kr1c0004/0001-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"preface","layerLabel":"篇序","targetText":"旄丘責衛伯也狄人迫逐黎侯黎侯寓於衛衛不能脩方伯連率之職黎之臣子以責於衛也","sourceLabel":null,"attributionLabel":"诗序","sectionLabel":"序","excerpt":"序：《旄丘》，責衛伯也。狄人迫逐黎侯，黎侯寓於衛，衛不能脩方伯連率之職，黎之臣子以責於衛也。","fullText":"序：《旄丘》，責衛伯也。狄人迫逐黎侯，黎侯寓於衛，衛不能脩方伯連率之職，黎之臣子以責於衛也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"maoheng-zhushu-kr1c0004:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/037-mao-qiu/maoheng-zhushu-kr1c0004/0002-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"span","layerLabel":"诗句片段","targetText":"旄丘之葛兮，何誕之節兮。叔兮伯兮，何多日也。","sourceLabel":null,"attributionLabel":"毛传","sectionLabel":"傳","excerpt":"毛传以旄丘之葛起兴，训“誕”为阔大，由葛之延蔓写时日之久；“叔”“伯”皆指卫之诸臣。首章即从久望不至发问，起责卫之端。","fullText":"毛传以旄丘之葛起兴，训“誕”为阔大，由葛之延蔓写时日之久；“叔”“伯”皆指卫之诸臣。首章即从久望不至发问，起责卫之端。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004"]},{"id":"maoheng-zhushu-kr1c0004:0003-1:part-1","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/037-mao-qiu/maoheng-zhushu-kr1c0004/0003-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"span","layerLabel":"诗句片段","targetText":"何其處也，必有與也。何其久也，必有以也。","sourceLabel":null,"attributionLabel":"毛传","sectionLabel":"傳","excerpt":"毛传释“與”为与国相待而俱来，“以”为他故。第二章连续设想卫迟来必另有缘由，是黎臣强作解慰之辞，反显久待之切。","fullText":"毛传释“與”为与国相待而俱来，“以”为他故。第二章连续设想卫迟来必另有缘由，是黎臣强作解慰之辞，反显久待之切。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-005","seg-006","seg-007","seg-008"]},{"id":"maoheng-zhushu-kr1c0004:0004-1:part-1","annotationId":"0004","glossId":"0004-1","glossHref":"/shijing/gloss/037-mao-qiu/maoheng-zhushu-kr1c0004/0004-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"span","layerLabel":"诗句片段","targetText":"狐裘蒙戎，匪車不東。叔兮伯兮，靡所與同。","sourceLabel":null,"attributionLabel":"毛传","sectionLabel":"傳","excerpt":"毛传训“蒙戎”为乱貌弊敝，“不東”谓卫车不向东来；“靡所與同”则明言卫之诸臣与我不同心。三章在希望之后转为失望。","fullText":"毛传训“蒙戎”为乱貌弊敝，“不東”谓卫车不向东来；“靡所與同”则明言卫之诸臣与我不同心。三章在希望之后转为失望。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-009","seg-010","seg-011","seg-012"]},{"id":"maoheng-zhushu-kr1c0004:0005-1:part-1","annotationId":"0005","glossId":"0005-1","glossHref":"/shijing/gloss/037-mao-qiu/maoheng-zhushu-kr1c0004/0005-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"span","layerLabel":"诗句片段","targetText":"瑣兮尾兮，流離之子。叔兮伯兮，褎如充耳。","sourceLabel":null,"attributionLabel":"毛传","sectionLabel":"傳","excerpt":"毛传释“瑣”为细，“尾”为末，“流離”为流散，“褎如充耳”为盛服而塞耳不闻。末章极写流亡者困苦与卫臣充耳不闻之冷漠，责意毕见。","fullText":"毛传释“瑣”为细，“尾”为末，“流離”为流散，“褎如充耳”为盛服而塞耳不闻。末章极写流亡者困苦与卫臣充耳不闻之冷漠，责意毕见。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-013","seg-014","seg-015","seg-016"]},{"id":"maruichen-tongshi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/037-mao-qiu/maruichen-tongshi/0001-1","materialId":"maruichen-tongshi","materialTitle":"毛詩傳箋通釋","contributorLine":"清 · 馬瑞辰","publicationYear":1989,"layer":"span","layerLabel":"诗句片段","targetText":"旄丘之葛兮，何誕之節兮。叔兮伯兮，何多日也。何其處也，必有與也。何其久也，必有以也。狐裘蒙戎，匪車不東。叔兮伯兮，靡所與同。瑣兮尾兮，流離之子。叔兮伯兮，褎如充耳。","sourceLabel":"第 88-89 页","attributionLabel":"马瑞辰","sectionLabel":"按","excerpt":"马瑞辰论《旄丘》时，围绕“誕”“與”“以”“蒙戎”“不東”“流離”“褎如充耳”等字反复征引群经与诸家训释，并综论《序》、毛、郑及后儒之说。其按语重心在于说明本篇由望救到绝望的结构，并以训诂支持“责卫而终归于劝君自归”的读法。","fullText":"马瑞辰论《旄丘》时，围绕“誕”“與”“以”“蒙戎”“不東”“流離”“褎如充耳”等字反复征引群经与诸家训释，并综论《序》、毛、郑及后儒之说。其按语重心在于说明本篇由望救到绝望的结构，并以训诂支持“责卫而终归于劝君自归”的读法。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016"]},{"id":"quwanli-quanshi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/037-mao-qiu/quwanli-quanshi/0001-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"global","layerLabel":"全篇总说","targetText":"旄丘","sourceLabel":"第 45 页","attributionLabel":"屈万里","sectionLabel":"总说","excerpt":"屈万里题下从《诗序》说，认《旄丘》为责卫不能修方伯连率之职以救黎之诗，并指出篇中一再称“叔兮伯兮”，即直指卫之贵族诸臣。","fullText":"屈万里题下从《诗序》说，认《旄丘》为责卫不能修方伯连率之职以救黎之诗，并指出篇中一再称“叔兮伯兮”，即直指卫之贵族诸臣。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"quwanli-quanshi:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/037-mao-qiu/quwanli-quanshi/0002-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"term","layerLabel":"字词注","targetText":"旄丘之葛兮，何誕之節兮。叔兮伯兮，何多日也。何其處也，必有與也。何其久也，必有以也。狐裘蒙戎，匪車不東。叔兮伯兮，靡所與同。瑣兮尾兮，流離之子。叔兮伯兮，褎如充耳。","sourceLabel":"第 45 页","attributionLabel":"屈万里","sectionLabel":"注释","excerpt":"屈万里逐条解释“旄丘”“誕”“與”“以”“蒙戎”“不東”“流離”“褎”“充耳”等词，并引朱传、毛传及陈氏传疏互证。其词注整体承责卫说，以训诂扶出望救不得、终至责绝的诗意。","fullText":"屈万里逐条解释“旄丘”“誕”“與”“以”“蒙戎”“不東”“流離”“褎”“充耳”等词，并引朱传、毛传及陈氏传疏互证。其词注整体承责卫说，以训诂扶出望救不得、终至责绝的诗意。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016"]},{"id":"wangli-yundu:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/037-mao-qiu/wangli-yundu/0001-1","materialId":"wangli-yundu","materialTitle":"詩經韻讀","contributorLine":"现代 · 王力","publicationYear":1980,"layer":"global","layerLabel":"全篇总说","targetText":"韵读总说","sourceLabel":"第 158 页","attributionLabel":"王力","sectionLabel":"韵读","excerpt":"王力《诗经韵读》把《旄丘》列为四章四句，各章自成韵转：首章“节、日”通韵，二章“处、与、久、以”间见叶转，三章“戎、东、同”为一部，四章“子、耳”再收。全篇在重章短句中形成连续催迫之势。","fullText":"王力《诗经韵读》把《旄丘》列为四章四句，各章自成韵转：首章“节、日”通韵，二章“处、与、久、以”间见叶转，三章“戎、东、同”为一部，四章“子、耳”再收。全篇在重章短句中形成连续催迫之势。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"wangli-yundu:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/037-mao-qiu/wangli-yundu/0002-1","materialId":"wangli-yundu","materialTitle":"詩經韻讀","contributorLine":"现代 · 王力","publicationYear":1980,"layer":"span","layerLabel":"诗句片段","targetText":"旄丘之葛兮，何诞之节兮。叔兮伯兮，何多日也。何其处也，必有与也。何其久也，必有以也。狐裘蒙戎，匪车不东。叔兮伯兮，靡所与同。琐兮尾兮，流离之子。叔兮伯兮，褎如充耳。","sourceLabel":"第 158 页","attributionLabel":"王力","sectionLabel":"韵读","excerpt":"王力在全篇韵读中标出《旄丘》各句拟音与韵部：首章“节、日”相通，二章“处、与、久、以”层层叶转，三章“戎、东、同”归东部，四章“子、耳”入纸部。四章转韵紧凑，正与全诗由盼望转为斥绝的情势相配。","fullText":"王力在全篇韵读中标出《旄丘》各句拟音与韵部：首章“节、日”相通，二章“处、与、久、以”层层叶转，三章“戎、东、同”归东部，四章“子、耳”入纸部。四章转韵紧凑，正与全诗由盼望转为斥绝的情势相配。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016"]},{"id":"zhuxi-shijichuan-kr1c0009:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/037-mao-qiu/zhuxi-shijichuan-kr1c0009/0001-1","materialId":"zhuxi-shijichuan-kr1c0009","materialTitle":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"layer":"span","layerLabel":"诗句片段","targetText":"旄丘之葛兮，何誕之節兮。叔兮伯兮，何多日也。","sourceLabel":null,"attributionLabel":"朱熹","sectionLabel":"集传","excerpt":"兴也。朱熹释旄丘为前高后下之丘，以葛之延蔓起兴，言黎臣久望卫之叔伯而不至，故发“何多日也”之问。","fullText":"兴也。朱熹释旄丘为前高后下之丘，以葛之延蔓起兴，言黎臣久望卫之叔伯而不至，故发“何多日也”之问。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004"]},{"id":"zhuxi-shijichuan-kr1c0009:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/037-mao-qiu/zhuxi-shijichuan-kr1c0009/0002-1","materialId":"zhuxi-shijichuan-kr1c0009","materialTitle":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"layer":"span","layerLabel":"诗句片段","targetText":"何其處也，必有與也。何其久也，必有以也。","sourceLabel":null,"attributionLabel":"朱熹","sectionLabel":"集传","excerpt":"赋也。朱熹以“必有与也”“必有以也”作设想之词，谓卫所以久不来者，或有所与国相待而俱来，或别有他故不得来，正写久待之人自为宽解。","fullText":"赋也。朱熹以“必有与也”“必有以也”作设想之词，谓卫所以久不来者，或有所与国相待而俱来，或别有他故不得来，正写久待之人自为宽解。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-005","seg-006","seg-007","seg-008"]},{"id":"zhuxi-shijichuan-kr1c0009:0003-1:part-1","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/037-mao-qiu/zhuxi-shijichuan-kr1c0009/0003-1","materialId":"zhuxi-shijichuan-kr1c0009","materialTitle":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"layer":"span","layerLabel":"诗句片段","targetText":"狐裘蒙戎，匪車不東。叔兮伯兮，靡所與同。","sourceLabel":null,"attributionLabel":"朱熹","sectionLabel":"集传","excerpt":"赋也。朱熹释“狐裘蒙戎，匪车不东”为见卫诸臣盛服乘车而终不东来，“靡所与同”则点出卫与黎不同心，诗意至此由望救而渐绝。","fullText":"赋也。朱熹释“狐裘蒙戎，匪车不东”为见卫诸臣盛服乘车而终不东来，“靡所与同”则点出卫与黎不同心，诗意至此由望救而渐绝。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-009","seg-010","seg-011","seg-012"]},{"id":"zhuxi-shijichuan-kr1c0009:0004-1:part-1","annotationId":"0004","glossId":"0004-1","glossHref":"/shijing/gloss/037-mao-qiu/zhuxi-shijichuan-kr1c0009/0004-1","materialId":"zhuxi-shijichuan-kr1c0009","materialTitle":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"layer":"span","layerLabel":"诗句片段","targetText":"瑣兮尾兮，流離之子。叔兮伯兮，褎如充耳。","sourceLabel":null,"attributionLabel":"朱熹","sectionLabel":"集传","excerpt":"赋也。朱熹释“瑣兮尾兮，流離之子”自状流亡困苦，而“褎如充耳”则言卫诸臣盛服充耳若聋，不闻其呼号。末章责卫之意遂极。","fullText":"赋也。朱熹释“瑣兮尾兮，流離之子”自状流亡困苦，而“褎如充耳”则言卫诸臣盛服充耳若聋，不闻其呼号。末章责卫之意遂极。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-013","seg-014","seg-015","seg-016"]},{"id":"zhuxi-shijichuan-kr1c0009:0005-1:part-1","annotationId":"0005","glossId":"0005-1","glossHref":"/shijing/gloss/037-mao-qiu/zhuxi-shijichuan-kr1c0009/0005-1","materialId":"zhuxi-shijichuan-kr1c0009","materialTitle":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"layer":"global","layerLabel":"全篇总说","targetText":"旄丘四章章四句","sourceLabel":null,"attributionLabel":"朱熹","sectionLabel":"章句","excerpt":"朱熹总云《旄丘》四章章四句，并承旧说以为黎侯寓卫、黎臣责卫不来相救之诗。","fullText":"朱熹总云《旄丘》四章章四句，并承旧说以为黎侯寓卫、黎臣责卫不来相救之诗。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]}]}}}
