Year":1847,"glossCount":2,"partCount":2},{"id":"wangli-yundu","title":"詩經韻讀","contributorLine":"现代 · 王力","publicationYear":1980,"glossCount":2,"partCount":2},{"id":"quwanli-quanshi","title":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"glossCount":2,"partCount":2},{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"glossCount":5,"partCount":5},{"id":"maruichen-tongshi","title":"毛詩傳箋通釋","contributorLine":"清 · 馬瑞辰","publicationYear":1989,"glossCount":1,"partCount":1},{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"glossCount":3,"partCount":3}],"stats":{"materialCount":8,"glossCount":21,"anchoredPartCount":0,"overviewPartCount":10},"overview":{"prefaceEntryIds":["chenhuan-chuanshu:0001-1:part-1","maoheng-zhushu-kr1c0004:0001-1:part-1"],"globalEntryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-1","fangyurun-yuanshi:0001-1:part-1","fangyurun-yuanshi:0002-1:part-1","fangyurun-yuanshi:0003-1:part-1","fangyurun-yuanshi:0005-1:part-1","quwanli-quanshi:0001-1:part-1","wangli-yundu:0001-1:part-1","zhuxi-shijichuan-kr1c0009:0003-1:part-1"]},"focusAnchors":[],"entries":[{"id":"chengjunying-jiangjianyuan-zhuxi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/025-zou-yu/chengjunying-jiangjianyuan-zhuxi/0001-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"global","layerLabel":"全篇总说","targetText":"题解","sourceLabel":"第 44-45 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","excerpt":"题解把《驺虞》定为赞美猎人的诗。编者认为“于嗟乎驺虞”中的叹词短促有力，配合两章复沓，写出射猎时强烈而波动的情绪；而一发五豝、一发五豵，并不必拘泥为实数，重点仍在夸示勇健善射，所以全篇主旨在赞叹猎获之盛与猎人的敏捷。","fullText":"题解把《驺虞》定为赞美猎人的诗。编者认为“于嗟乎驺虞”中的叹词短促有力，配合两章复沓，写出射猎时强烈而波动的情绪；而一发五豝、一发五豵，并不必拘泥为实数，重点仍在夸示勇健善射，所以全篇主旨在赞叹猎获之盛与猎人的敏捷。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"chengjunying-jiangjianyuan-zhuxi:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/025-zou-yu/chengjunying-jiangjianyuan-zhuxi/0002-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"彼茁者葭，壹发五豝。于嗟乎驺虞！","sourceLabel":"第 45 页","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"excerpt":"首章释“茁”为草木初生而壮盛，“葭”为初生芦苇，“豝”为母猪或猎场所见大兽。程、蒋指出“一发五豝”当是极写射者的勇武与技艺，不必胶着实数；末句“于嗟乎驺虞”则用赞叹口吻收束，形成猎场呼喝般的声势。","fullText":"首章释“茁”为草木初生而壮盛，“葭”为初生芦苇，“豝”为母猪或猎场所见大兽。程、蒋指出“一发五豝”当是极写射者的勇武与技艺，不必胶着实数；末句“于嗟乎驺虞”则用赞叹口吻收束，形成猎场呼喝般的声势。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003"]},{"id":"chengjunying-jiangjianyuan-zhuxi:0003-1:part-1","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/025-zou-yu/chengjunying-jiangjianyuan-zhuxi/0003-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"彼茁者蓬，壹发五豵。于嗟乎驺虞！","sourceLabel":"第 45 页","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"excerpt":"第二章换以蓬草、豵豕复沓前意。“豵”为小猪，和首章“大兽”对举，使猎获更见丰富。编者认为两章同用“于嗟乎驺虞”反复收束，正显示诗歌从猎场打猎的劳动与武勇里取材，而不是借义兽之名空作祥瑞颂辞。","fullText":"第二章换以蓬草、豵豕复沓前意。“豵”为小猪，和首章“大兽”对举，使猎获更见丰富。编者认为两章同用“于嗟乎驺虞”反复收束，正显示诗歌从猎场打猎的劳动与武勇里取材，而不是借义兽之名空作祥瑞颂辞。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-004","seg-005","seg-006"]},{"id":"chenhuan-chuanshu:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/025-zou-yu/chenhuan-chuanshu/0001-1","materialId":"chenhuan-chuanshu","materialTitle":"詩毛氏傳疏","contributorLine":"清 · 陳奐","publicationYear":1847,"layer":"preface","layerLabel":"篇序","targetText":"騶虞鵲巢之應也鵲巢之化行人倫既正朝廷既治天下純被文王之化則庶類蕃殖蒐田以時仁如騶虞則王道成也","sourceLabel":"第 47 页","attributionLabel":"诗序","sectionLabel":"序","excerpt":"序：《騶虞》，鵲巢之應也。鵲巢之化行，人倫既正，朝廷既治，天下純被文王之化，則庶類蕃殖，蒐田以時，仁如騶虞，則王道成也。","fullText":"序：《騶虞》，鵲巢之應也。鵲巢之化行，人倫既正，朝廷既治，天下純被文王之化，則庶類蕃殖，蒐田以時，仁如騶虞，則王道成也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"chenhuan-chuanshu:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/025-zou-yu/chenhuan-chuanshu/0002-1","materialId":"chenhuan-chuanshu","materialTitle":"詩毛氏傳疏","contributorLine":"清 · 陳奐","publicationYear":1847,"layer":"span","layerLabel":"诗句片段","targetText":"彼茁者葭，壹發五豝，于嗟乎騶虞。彼茁者蓬，壹發五豵，于嗟乎騶虞。","sourceLabel":"第 47-48 页","attributionLabel":"陈奂","sectionLabel":"疏","excerpt":"陈奂遵《序》与毛郑旧义，把《騶虞》看作文王化行、蒐田以时而庶类蕃殖的颂辞。“壹發五豝”“壹發五豵”皆被解释为虞人翼兽以待君发，意在见其不尽杀之仁；末句“于嗟乎騶虞”则是借义兽以叹仁人，归结到王道已成。","fullText":"陈奂遵《序》与毛郑旧义，把《騶虞》看作文王化行、蒐田以时而庶类蕃殖的颂辞。“壹發五豝”“壹發五豵”皆被解释为虞人翼兽以待君发，意在见其不尽杀之仁；末句“于嗟乎騶虞”则是借义兽以叹仁人，归结到王道已成。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006"]},{"id":"fangyurun-yuanshi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/025-zou-yu/fangyurun-yuanshi/0001-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"global","layerLabel":"全篇总说","targetText":"騶虞㊟獵不盡殺也。","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"题注","excerpt":"方玉润在题注中把《騶虞》定为“猎不尽杀”之诗，直接从田猎礼意入手，不以騶虞当作义兽实指。","fullText":"方玉润在题注中把《騶虞》定为“猎不尽杀”之诗，直接从田猎礼意入手，不以騶虞当作义兽实指。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"fangyurun-yuanshi:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/025-zou-yu/fangyurun-yuanshi/0002-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"global","layerLabel":"全篇总说","targetText":"彼茁者葭，壹發五豝。于嗟乎，騶虞！彼茁者蓬，壹發五豵。于嗟乎，騶虞！","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":null,"excerpt":"方玉润力辨《毛传》《集传》把騶虞当作义兽、并据此附会文王化行的读法，认为“騶虞”更当作騶囿、虞官一类职官名。全诗所咏，不过是田猎时不合围、不尽杀物的礼意，借“一发五豝”“一发五豵”夸写猎获之盛，而末句转美虞人，实即不敢斥君而归功于国君之仁。","fullText":"方玉润力辨《毛传》《集传》把騶虞当作义兽、并据此附会文王化行的读法，认为“騶虞”更当作騶囿、虞官一类职官名。全诗所咏，不过是田猎时不合围、不尽杀物的礼意，借“一发五豝”“一发五豵”夸写猎获之盛，而末句转美虞人，实即不敢斥君而归功于国君之仁。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006"]},{"id":"fangyurun-yuanshi:0003-1:part-1","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/025-zou-yu/fangyurun-yuanshi/0003-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"global","layerLabel":"全篇总说","targetText":"眉评","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"眉评","excerpt":"眉评谓末句虽与“于嗟麟兮”相似，实则不同；正因通章未先以騶虞为比，反足证“騶虞”并非兽名。","fullText":"眉评谓末句虽与“于嗟麟兮”相似，实则不同；正因通章未先以騶虞为比，反足证“騶虞”并非兽名。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"fangyurun-yuanshi:0004-1:part-1","annotationId":"0004","glossId":"0004-1","glossHref":"/shijing/gloss/025-zou-yu/fangyurun-yuanshi/0004-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"term","layerLabel":"字词注","targetText":"彼茁者葭彼茁者蓬","sourceLabel":null,"attributionLabel":"集释","sectionLabel":null,"excerpt":"集释释“茁”为生出壮盛之貌，“葭”为初生芦苇，“蓬”为蒿类野草。所举草木都取其春猎时生意蓬勃之状，以衬猎场时令。","fullText":"集释释“茁”为生出壮盛之貌，“葭”为初生芦苇，“蓬”为蒿类野草。所举草木都取其春猎时生意蓬勃之状，以衬猎场时令。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-004"]},{"id":"fangyurun-yuanshi:0005-1:part-1","annotationId":"0005","glossId":"0005-1","glossHref":"/shijing/gloss/025-zou-yu/fangyurun-yuanshi/0005-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"global","layerLabel":"全篇总说","targetText":"标韵","sourceLabel":null,"attributionLabel":"标韵","sectionLabel":null,"excerpt":"标韵以首章“葭”“豝”为麻部本韵，“乎”“虞”为虞部本韵；次章“蓬”“豵”则转东部，而“虞”与上章遥应。方玉润并借此驳正诸家把末句强作叶音的做法。","fullText":"标韵以首章“葭”“豝”为麻部本韵，“乎”“虞”为虞部本韵；次章“蓬”“豵”则转东部，而“虞”与上章遥应。方玉润并借此驳正诸家把末句强作叶音的做法。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"maoheng-zhushu-kr1c0004:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/025-zou-yu/maoheng-zhushu-kr1c0004/0001-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"preface","layerLabel":"篇序","targetText":"騶虞鵲巢之應也鵲巢之化行人倫既正朝廷既治天下純被文王之化則庶類蕃殖蒐田以時仁如騶虞則王道成也","sourceLabel":null,"attributionLabel":"诗序","sectionLabel":"序","excerpt":"序：《騶虞》，鵲巢之應也。鵲巢之化行，人倫既正，朝廷既治，天下純被文王之化，則庶類蕃殖，蒐田以時，仁如騶虞，則王道成也。","fullText":"序：《騶虞》，鵲巢之應也。鵲巢之化行，人倫既正，朝廷既治，天下純被文王之化，則庶類蕃殖，蒐田以時，仁如騶虞，則王道成也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"maoheng-zhushu-kr1c0004:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/025-zou-yu/maoheng-zhushu-kr1c0004/0002-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"span","layerLabel":"诗句片段","targetText":"彼茁者葭壹發五豝于嗟乎騶虞","sourceLabel":null,"attributionLabel":"毛传","sectionLabel":null,"excerpt":"傳：茁，出也。葭，蘆也。發，矢發也。豝，牝豕也。于嗟，歎辭。騶虞，義獸也，白虎黑文，不食生物。有至信之德則應之。","fullText":"傳：茁，出也。葭，蘆也。發，矢發也。豝，牝豕也。于嗟，歎辭。騶虞，義獸也，白虎黑文，不食生物。有至信之德則應之。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003"]},{"id":"maoheng-zhushu-kr1c0004:0003-1:part-1","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/025-zou-yu/maoheng-zhushu-kr1c0004/0003-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"span","layerLabel":"诗句片段","targetText":"彼茁者蓬壹發五豵于嗟乎騶虞","sourceLabel":null,"attributionLabel":"毛传","sectionLabel":null,"excerpt":"傳：蓬，草也。豵，一歲豕也。","fullText":"傳：蓬，草也。豵，一歲豕也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-004","seg-005","seg-006"]},{"id":"maruichen-tongshi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/025-zou-yu/maruichen-tongshi/0001-1","materialId":"maruichen-tongshi","materialTitle":"毛詩傳箋通釋","contributorLine":"清 · 馬瑞辰","publicationYear":1989,"layer":"span","layerLabel":"诗句片段","targetText":"彼茁者葭，壹發五豝，于嗟乎騶虞。彼茁者蓬，壹發五豵，于嗟乎騶虞。","sourceLabel":"第 99-100 页","attributionLabel":"马瑞辰","sectionLabel":"按","excerpt":"瑞辰辨《騶虞》诸说，既考“豝”“豵”“虞”与獵礼、鸟兽官名，也讨论《序》与《集传》把騶虞说成义兽的来历。其按语大旨更重“于嗟乎騶虞”乃叹美猎不尽杀、王政有仁，而不必拘泥为真有白虎黑文之兽出现；故全篇仍应从王道仁厚及田猎有节理解。","fullText":"瑞辰辨《騶虞》诸说，既考“豝”“豵”“虞”与獵礼、鸟兽官名，也讨论《序》与《集传》把騶虞说成义兽的来历。其按语大旨更重“于嗟乎騶虞”乃叹美猎不尽杀、王政有仁，而不必拘泥为真有白虎黑文之兽出现；故全篇仍应从王道仁厚及田猎有节理解。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006"]},{"id":"quwanli-quanshi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/025-zou-yu/quwanli-quanshi/0001-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"global","layerLabel":"全篇总说","targetText":"《驺虞》全篇旨意","sourceLabel":"第 27 页","attributionLabel":"屈万里","sectionLabel":"注释","excerpt":"此美田猎之诗。","fullText":"此美田猎之诗。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"quwanli-quanshi:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/025-zou-yu/quwanli-quanshi/0002-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"term","layerLabel":"字词注","targetText":"彼茁者葭壹发五豝于嗟乎驺虞彼茁者蓬壹发五豵于嗟乎驺虞","sourceLabel":"第 26-27 页","attributionLabel":"屈万里","sectionLabel":"注释","excerpt":"屈万里释“茁”为草初生貌，“葭”为初生芦苇，“蓬”为蒿，“豝”为母猪，“驺虞”是掌鸟兽之官，“豵”为一岁豕。整组注释偏重名物与字义，因此仍把此篇读成赞美田猎者或猎礼有节的诗。","fullText":"屈万里释“茁”为草初生貌，“葭”为初生芦苇，“蓬”为蒿，“豝”为母猪，“驺虞”是掌鸟兽之官，“豵”为一岁豕。整组注释偏重名物与字义，因此仍把此篇读成赞美田猎者或猎礼有节的诗。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006"]},{"id":"wangli-yundu:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/025-zou-yu/wangli-yundu/0001-1","materialId":"wangli-yundu","materialTitle":"詩經韻讀","contributorLine":"现代 · 王力","publicationYear":1980,"layer":"global","layerLabel":"全篇总说","targetText":"《驺虞》韵读总说","sourceLabel":"第 149 页局部","attributionLabel":"王力","sectionLabel":"韵读","excerpt":"王力将《驺虞》读作两章分换韵：首章“葭(kea)、豝(pea)”同在鱼部，而“驺虞(ngiua)”入鱼部相协；次章“蓬(bong)、豵(tzong)”转东部，煞句“驺虞”则与上章遥应。两章句短而节奏劲利。","fullText":"王力将《驺虞》读作两章分换韵：首章“葭(kea)、豝(pea)”同在鱼部，而“驺虞(ngiua)”入鱼部相协；次章“蓬(bong)、豵(tzong)”转东部，煞句“驺虞”则与上章遥应。两章句短而节奏劲利。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"wangli-yundu:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/025-zou-yu/wangli-yundu/0002-1","materialId":"wangli-yundu","materialTitle":"詩經韻讀","contributorLine":"现代 · 王力","publicationYear":1980,"layer":"span","layerLabel":"诗句片段","targetText":"彼茁者葭，壹发五豝。于嗟乎驺虞！彼茁者蓬，壹发五豵。于嗟乎驺虞！","sourceLabel":"第 149 页局部","attributionLabel":"王力","sectionLabel":"韵读","excerpt":"页图可读首章“彼茁者葭(kea)、壹发五豝(pea)、于嗟乎驺虞(ngiua)”同属鱼部；次章“彼茁者蓬(bong)、壹发五豵(tzong)”转东部，而末句“驺虞”与上章通押。王力据此把此诗视为短章急调的田猎之作。","fullText":"页图可读首章“彼茁者葭(kea)、壹发五豝(pea)、于嗟乎驺虞(ngiua)”同属鱼部；次章“彼茁者蓬(bong)、壹发五豵(tzong)”转东部，而末句“驺虞”与上章通押。王力据此把此诗视为短章急调的田猎之作。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006"]},{"id":"zhuxi-shijichuan-kr1c0009:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/025-zou-yu/zhuxi-shijichuan-kr1c0009/0001-1","materialId":"zhuxi-shijichuan-kr1c0009","materialTitle":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"layer":"span","layerLabel":"诗句片段","targetText":"彼茁者葭，壹發五豝。于嗟乎騶虞。","sourceLabel":null,"attributionLabel":"朱熹","sectionLabel":null,"excerpt":"賦也。茁，生出壯盛之貌；葭，蘆也，亦名葦；發，發矢也；豝，牡豕也。一發五豝，猶言中必疊雙。騶虞，獸名，白虎黑文，不食生物者。朱熹以此章美南國諸侯承文王之化，春田之際草木茂、禽獸多，而其仁及庶類。","fullText":"賦也。茁，生出壯盛之貌；葭，蘆也，亦名葦；發，發矢也；豝，牡豕也。一發五豝，猶言中必疊雙。騶虞，獸名，白虎黑文，不食生物者。朱熹以此章美南國諸侯承文王之化，春田之際草木茂、禽獸多，而其仁及庶類。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003"]},{"id":"zhuxi-shijichuan-kr1c0009:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/025-zou-yu/zhuxi-shijichuan-kr1c0009/0002-1","materialId":"zhuxi-shijichuan-kr1c0009","materialTitle":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"layer":"span","layerLabel":"诗句片段","targetText":"彼茁者蓬，壹發五豵。于嗟乎騶虞。","sourceLabel":null,"attributionLabel":"朱熹","sectionLabel":null,"excerpt":"賦也。蓬，草名；豵，一歲豕，亦小豕也。朱熹以第二章仍承首章之意，用草木与禽兽之多反覆形容文王之化流被庶类。","fullText":"賦也。蓬，草名；豵，一歲豕，亦小豕也。朱熹以第二章仍承首章之意，用草木与禽兽之多反覆形容文王之化流被庶类。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-004","seg-005","seg-006"]},{"id":"zhuxi-shijichuan-kr1c0009:0003-1:part-1","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/025-zou-yu/zhuxi-shijichuan-kr1c0009/0003-1","materialId":"zhuxi-shijichuan-kr1c0009","materialTitle":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"layer":"global","layerLabel":"全篇总说","targetText":"騶虞二章章三句","sourceLabel":null,"attributionLabel":"朱熹","sectionLabel":null,"excerpt":"朱熹记《騶虞》为二章、章三句，并以为文王之化始于《關雎》、深于《麟趾》，形于《鵲巢》而及于《騶虞》，足见其泽之及物者广。","fullText":"朱熹记《騶虞》为二章、章三句，并以为文王之化始于《關雎》、深于《麟趾》，形于《鵲巢》而及于《騶虞》，足见其泽之及物者广。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]}]}}}
