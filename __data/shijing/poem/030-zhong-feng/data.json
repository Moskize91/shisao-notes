t-1","quwanli-quanshi:0002-1:part-1","wangli-yundu:0002-1:part-1","zhuxi-shijichuan-kr1c0009:0004-1:part-1"],"characters":[{"index":1,"text":"願","anchorIds":[]},{"index":2,"text":"言","anchorIds":[]},{"index":3,"text":"則","anchorIds":[]},{"index":4,"text":"懷","anchorIds":[]}]}]},"materials":[{"id":"maoheng-zhushu-kr1c0004","title":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"glossCount":5,"partCount":5},{"id":"zhuxi-shijichuan-kr1c0009","title":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"glossCount":5,"partCount":5},{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","contributorLine":"清 · 陳奐","publicationYear":1847,"glossCount":2,"partCount":2},{"id":"wangli-yundu","title":"詩經韻讀","contributorLine":"现代 · 王力","publicationYear":1980,"glossCount":2,"partCount":2},{"id":"quwanli-quanshi","title":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"glossCount":2,"partCount":2},{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"glossCount":4,"partCount":4},{"id":"maruichen-tongshi","title":"毛詩傳箋通釋","contributorLine":"清 · 馬瑞辰","publicationYear":1989,"glossCount":1,"partCount":1},{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"glossCount":5,"partCount":5}],"stats":{"materialCount":8,"glossCount":26,"anchoredPartCount":0,"overviewPartCount":9},"overview":{"prefaceEntryIds":["chenhuan-chuanshu:0001-1:part-1","maoheng-zhushu-kr1c0004:0001-1:part-1"],"globalEntryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-1","fangyurun-yuanshi:0001-1:part-1","fangyurun-yuanshi:0002-1:part-1","fangyurun-yuanshi:0004-1:part-1","quwanli-quanshi:0001-1:part-1","wangli-yundu:0001-1:part-1","zhuxi-shijichuan-kr1c0009:0005-1:part-1"]},"focusAnchors":[],"entries":[{"id":"chengjunying-jiangjianyuan-zhuxi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/030-zhong-feng/chengjunying-jiangjianyuan-zhuxi/0001-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"global","layerLabel":"全篇总说","targetText":"题解","sourceLabel":"第 57-58 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","excerpt":"程、蒋认为《终风》写的是一位妇女被丈夫轻薄、玩弄、冷落后的怨恋之情。题解指出《毛序》以庄姜遭州吁之暴为说，既与诗中“顾我则笑”“惠然肯来”等辞不合，也无足够确据；就诗意看，四章层层写出既恨其轻狂、又不能断绝思念的矛盾心理。","fullText":"程、蒋认为《终风》写的是一位妇女被丈夫轻薄、玩弄、冷落后的怨恋之情。题解指出《毛序》以庄姜遭州吁之暴为说，既与诗中“顾我则笑”“惠然肯来”等辞不合，也无足够确据；就诗意看，四章层层写出既恨其轻狂、又不能断绝思念的矛盾心理。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"chengjunying-jiangjianyuan-zhuxi:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/030-zhong-feng/chengjunying-jiangjianyuan-zhuxi/0002-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"终风且暴，顾我则笑。谑浪笑敖，中心是悼。","sourceLabel":"第 58 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"注析","excerpt":"程、蒋释“暴”为迅疾，以疾风兴丈夫的狂暴轻薄；“谑浪笑敖”则写其调戏放纵、把玩取笑。“中心是悼”不是单纯恐惧，而是因被轻侮而又无法摆脱其人，于是心中伤悼交集。","fullText":"程、蒋释“暴”为迅疾，以疾风兴丈夫的狂暴轻薄；“谑浪笑敖”则写其调戏放纵、把玩取笑。“中心是悼”不是单纯恐惧，而是因被轻侮而又无法摆脱其人，于是心中伤悼交集。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004"]},{"id":"chengjunying-jiangjianyuan-zhuxi:0003-1:part-1","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/030-zhong-feng/chengjunying-jiangjianyuan-zhuxi/0003-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"终风且霾，惠然肯来。莫往莫来，悠悠我思。","sourceLabel":"第 59 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"注析","excerpt":"此章语气一转。程、蒋以“霾”写风尘昏暗，比丈夫心意阴晦无常；“惠然肯来”只是她对其回心转意的希冀，而“莫往莫来”却又写现实中终不见其往来，于是思念绵长，怨中仍带恋意。","fullText":"此章语气一转。程、蒋以“霾”写风尘昏暗，比丈夫心意阴晦无常；“惠然肯来”只是她对其回心转意的希冀，而“莫往莫来”却又写现实中终不见其往来，于是思念绵长，怨中仍带恋意。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-005","seg-006","seg-007","seg-008"]},{"id":"chengjunying-jiangjianyuan-zhuxi:0004-1:part-1","annotationId":"0004","glossId":"0004-1","glossHref":"/shijing/gloss/030-zhong-feng/chengjunying-jiangjianyuan-zhuxi/0004-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"终风且曀，不日有曀。寤言不寐，愿言则嚏。","sourceLabel":"第 59 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"注析","excerpt":"程、蒋释“曀”为阴而有风，“不日有曀”是说刚见暂时开朗，不久又复阴晦，比其丈夫偶有转机而终究复蔽。女子因此彻夜不眠，希望对方也能因思己而打喷嚏，写出无望中仍不肯自断的痴想。","fullText":"程、蒋释“曀”为阴而有风，“不日有曀”是说刚见暂时开朗，不久又复阴晦，比其丈夫偶有转机而终究复蔽。女子因此彻夜不眠，希望对方也能因思己而打喷嚏，写出无望中仍不肯自断的痴想。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-009","seg-010","seg-011","seg-012"]},{"id":"chengjunying-jiangjianyuan-zhuxi:0005-1:part-1","annotationId":"0005","glossId":"0005-1","glossHref":"/shijing/gloss/030-zhong-feng/chengjunying-jiangjianyuan-zhuxi/0005-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"曀曀其阴，虺虺其雷。寤言不寐，愿言则怀。","sourceLabel":"第 59 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"注析","excerpt":"末章把风雷阴翳写得更重。程、蒋据旧注以“虺虺”为雷将发之声，“怀”为思念，并指出这里已不只盼对方知我思念，更隐含希望其反过来思我、悔悟前非。全诗至此，把弃妇既怨又恋的矛盾心理推到极致。","fullText":"末章把风雷阴翳写得更重。程、蒋据旧注以“虺虺”为雷将发之声，“怀”为思念，并指出这里已不只盼对方知我思念，更隐含希望其反过来思我、悔悟前非。全诗至此，把弃妇既怨又恋的矛盾心理推到极致。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-013","seg-014","seg-015","seg-016"]},{"id":"chenhuan-chuanshu:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/030-zhong-feng/chenhuan-chuanshu/0001-1","materialId":"chenhuan-chuanshu","materialTitle":"詩毛氏傳疏","contributorLine":"清 · 陳奐","publicationYear":1847,"layer":"preface","layerLabel":"篇序","targetText":"終風衛莊姜傷己也遭州吁之暴見侮慢而不能正也","sourceLabel":"第 58 页","attributionLabel":"诗序","sectionLabel":"序","excerpt":"序：《終風》，衛莊姜傷己也。遭州吁之暴，見侮慢而不能正也。","fullText":"序：《終風》，衛莊姜傷己也。遭州吁之暴，見侮慢而不能正也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"chenhuan-chuanshu:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/030-zhong-feng/chenhuan-chuanshu/0002-1","materialId":"chenhuan-chuanshu","materialTitle":"詩毛氏傳疏","contributorLine":"清 · 陳奐","publicationYear":1847,"layer":"span","layerLabel":"诗句片段","targetText":"終風且暴，顧我則笑。謔浪笑敖，中心是悼。終風且霾，惠然肯來。莫往莫來，悠悠我思。終風且曀，不日有曀。寤言不寐，願言則嚏。曀曀其陰，虺虺其靁。寤言不寐，願言則懷。","sourceLabel":"第 58-59 页","attributionLabel":"陈奂","sectionLabel":"疏","excerpt":"陈奂为《序》说辩护，仍以《終風》归庄姜遭州吁之暴、见侮慢而不能正。其疏重在说明篇中虽有“顧我則笑”“惠然肯來”等语，所写仍是庄姜所遭轻侮与无常之遇；四章以风霾阴雷层层推进，见其忧悼、思望与不寐之情。","fullText":"陈奂为《序》说辩护，仍以《終風》归庄姜遭州吁之暴、见侮慢而不能正。其疏重在说明篇中虽有“顧我則笑”“惠然肯來”等语，所写仍是庄姜所遭轻侮与无常之遇；四章以风霾阴雷层层推进，见其忧悼、思望与不寐之情。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016"]},{"id":"fangyurun-yuanshi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/030-zhong-feng/fangyurun-yuanshi/0001-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"global","layerLabel":"全篇总说","targetText":"終風㊟衛莊姜傷所遇不淑也。","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"题注","excerpt":"方玉润在题注中将《終風》径定为卫庄姜伤所遇不淑之诗，直指其所遭者是庄公而非州吁。","fullText":"方玉润在题注中将《終風》径定为卫庄姜伤所遇不淑之诗，直指其所遭者是庄公而非州吁。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"fangyurun-yuanshi:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/030-zhong-feng/fangyurun-yuanshi/0002-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"global","layerLabel":"全篇总说","targetText":"总评","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"总评","excerpt":"方玉润明言《序》以州吁之暴说《終風》不通，因为“顧我則笑”“惠然肯來”绝非子对母所宜出之语；仍从朱熹，以为庄姜伤庄公而作。他解释前二章写庄公狂荡暴疾、来往无定，后二章则写庄姜度日如终风阴曀、忧郁成疾，并强调“終風”诸句当作兴不作比，诗意方能曲折深长。","fullText":"方玉润明言《序》以州吁之暴说《終風》不通，因为“顧我則笑”“惠然肯來”绝非子对母所宜出之语；仍从朱熹，以为庄姜伤庄公而作。他解释前二章写庄公狂荡暴疾、来往无定，后二章则写庄姜度日如终风阴曀、忧郁成疾，并强调“終風”诸句当作兴不作比，诗意方能曲折深长。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"fangyurun-yuanshi:0003-1:part-1","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/030-zhong-feng/fangyurun-yuanshi/0003-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"term","layerLabel":"字词注","targetText":"終風且暴謔浪笑敖中心是悼終風且霾惠然肯來終風且曀願言則嚏曀曀其陰虺虺其靁願言則懷","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"集释","excerpt":"方玉润集释云：“終風”为终日之风，“暴”为疾，“謔”为戏言，“浪”为放荡，“悼”为伤，“霾”为雨土蒙雾，“惠”为顺，“曀”为阴而风，“嚏”为鼽嚏，“曀曀”为阴貌，“虺虺”为雷将发而未震之声，“懷”为怀抱不释。整组训诂皆为说明所遇之人狂荡反覆。","fullText":"方玉润集释云：“終風”为终日之风，“暴”为疾，“謔”为戏言，“浪”为放荡，“悼”为伤，“霾”为雨土蒙雾，“惠”为顺，“曀”为阴而风，“嚏”为鼽嚏，“曀曀”为阴貌，“虺虺”为雷将发而未震之声，“懷”为怀抱不释。整组训诂皆为说明所遇之人狂荡反覆。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-003","seg-004","seg-005","seg-006","seg-009","seg-012","seg-013","seg-014","seg-016"]},{"id":"fangyurun-yuanshi:0004-1:part-1","annotationId":"0004","glossId":"0004-1","glossHref":"/shijing/gloss/030-zhong-feng/fangyurun-yuanshi/0004-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"global","layerLabel":"全篇总说","targetText":"标韵","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"标韵","excerpt":"方玉润分章标出韵脚：首章“暴、笑、敖、悼”通韵，次章“霾、來、來、思”通韵，三章“曀、曀、嚏”为本韵，四章“靁、懷”通韵。其标韵与总评相呼应，见四章层次分明而情绪一气贯穿。","fullText":"方玉润分章标出韵脚：首章“暴、笑、敖、悼”通韵，次章“霾、來、來、思”通韵，三章“曀、曀、嚏”为本韵，四章“靁、懷”通韵。其标韵与总评相呼应，见四章层次分明而情绪一气贯穿。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"maoheng-zhushu-kr1c0004:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/030-zhong-feng/maoheng-zhushu-kr1c0004/0001-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"preface","layerLabel":"篇序","targetText":"終風衛莊姜傷己也遭州吁之暴見侮慢而不能正也","sourceLabel":null,"attributionLabel":"诗序","sectionLabel":"序","excerpt":"序：《終風》，衛莊姜傷己也。遭州吁之暴，見侮慢而不能正也。","fullText":"序：《終風》，衛莊姜傷己也。遭州吁之暴，見侮慢而不能正也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"maoheng-zhushu-kr1c0004:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/030-zhong-feng/maoheng-zhushu-kr1c0004/0002-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"span","layerLabel":"诗句片段","targetText":"終風且暴顧我則笑謔浪笑敖中心是悼","sourceLabel":null,"attributionLabel":"毛传","sectionLabel":null,"excerpt":"傳：暴，疾也。謔，戲也。浪，笑貌。敖，戲謔也。中心是悼，動于中而傷于心也。","fullText":"傳：暴，疾也。謔，戲也。浪，笑貌。敖，戲謔也。中心是悼，動于中而傷于心也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004"]},{"id":"maoheng-zhushu-kr1c0004:0003-1:part-1","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/030-zhong-feng/maoheng-zhushu-kr1c0004/0003-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"span","layerLabel":"诗句片段","targetText":"終風且霾惠然肯來莫往莫來悠悠我思","sourceLabel":null,"attributionLabel":"毛传","sectionLabel":null,"excerpt":"傳：霾，雨土也。惠，順也。莫，無也。悠悠，思也。","fullText":"傳：霾，雨土也。惠，順也。莫，無也。悠悠，思也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-005","seg-006","seg-007","seg-008"]},{"id":"maoheng-zhushu-kr1c0004:0004-1:part-1","annotationId":"0004","glossId":"0004-1","glossHref":"/shijing/gloss/030-zhong-feng/maoheng-zhushu-kr1c0004/0004-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"span","layerLabel":"诗句片段","targetText":"終風且曀不日有曀寤言不寐願言則嚏","sourceLabel":null,"attributionLabel":"毛传","sectionLabel":null,"excerpt":"傳：曀，陰而風也。有，又也。嚏，跲也。寤言不寐，覺而有言且不能寐也。","fullText":"傳：曀，陰而風也。有，又也。嚏，跲也。寤言不寐，覺而有言且不能寐也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-009","seg-010","seg-011","seg-012"]},{"id":"maoheng-zhushu-kr1c0004:0005-1:part-1","annotationId":"0005","glossId":"0005-1","glossHref":"/shijing/gloss/030-zhong-feng/maoheng-zhushu-kr1c0004/0005-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"span","layerLabel":"诗句片段","targetText":"曀曀其陰虺虺其靁寤言不寐願言則懷","sourceLabel":null,"attributionLabel":"毛传","sectionLabel":null,"excerpt":"傳：曀曀，陰貌。虺虺，雷聲也。懷，思也。","fullText":"傳：曀曀，陰貌。虺虺，雷聲也。懷，思也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-013","seg-014","seg-015","seg-016"]},{"id":"maruichen-tongshi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/030-zhong-feng/maruichen-tongshi/0001-1","materialId":"maruichen-tongshi","materialTitle":"毛詩傳箋通釋","contributorLine":"清 · 馬瑞辰","publicationYear":1989,"layer":"span","layerLabel":"诗句片段","targetText":"終風且暴，顧我則笑。謔浪笑敖，中心是悼。終風且霾，惠然肯來。莫往莫來，悠悠我思。終風且曀，不日有曀。寤言不寐，願言則嚏。曀曀其陰，虺虺其靁。寤言不寐，願言則懷。","sourceLabel":null,"attributionLabel":"马瑞辰","sectionLabel":"按","excerpt":"马瑞辰论《終風》大体仍从庄姜伤己说，但按语重点在辨析“顧我則笑”“惠然肯來”一类辞意，说明诗中既有见侮之怨，也有不能自已之思。其解兼重《毛传》名物训诂与篇旨流转，认为四章由伤悼、悠悠、失眠到愿其怀我，层层推进而情致不断。","fullText":"马瑞辰论《終風》大体仍从庄姜伤己说，但按语重点在辨析“顧我則笑”“惠然肯來”一类辞意，说明诗中既有见侮之怨，也有不能自已之思。其解兼重《毛传》名物训诂与篇旨流转，认为四章由伤悼、悠悠、失眠到愿其怀我，层层推进而情致不断。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016"]},{"id":"quwanli-quanshi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/030-zhong-feng/quwanli-quanshi/0001-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"global","layerLabel":"全篇总说","targetText":"全篇旨意","sourceLabel":"第 35 页","attributionLabel":"屈万里","sectionLabel":"注释","excerpt":"屈万里直说《终风》是妇人不得于其夫之诗。全篇以终日狂风、尘霾、阴曀、雷声起兴，写女子见侮慢而伤悼，又在怨恨中不断回想对方，故诗意不是单纯责怒，而是怨恋交并。","fullText":"屈万里直说《终风》是妇人不得于其夫之诗。全篇以终日狂风、尘霾、阴曀、雷声起兴，写女子见侮慢而伤悼，又在怨恨中不断回想对方，故诗意不是单纯责怒，而是怨恋交并。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"quwanli-quanshi:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/030-zhong-feng/quwanli-quanshi/0002-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"term","layerLabel":"字词注","targetText":"终风且暴谑浪笑敖中心是悼终风且霾终风且曀不日有曀愿言则嚏曀曀其阴虺虺其雷愿言则怀","sourceLabel":"第 35 页","attributionLabel":"屈万里","sectionLabel":"注释","excerpt":"屈万里释“终”为既，“谑浪”为戏笑放纵，“悼”为伤，“霾”为风扬尘土，“惠”为顺悦，“曀”为阴而风，“有”为又，“嚏”为喷嚏，“曀曀”为阴暗貌，“虺虺”为雷声初发，“怀”为思。其词注简明，而足以显示四章情绪递深。","fullText":"屈万里释“终”为既，“谑浪”为戏笑放纵，“悼”为伤，“霾”为风扬尘土，“惠”为顺悦，“曀”为阴而风，“有”为又，“嚏”为喷嚏，“曀曀”为阴暗貌，“虺虺”为雷声初发，“怀”为思。其词注简明，而足以显示四章情绪递深。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-003","seg-004","seg-005","seg-009","seg-010","seg-012","seg-013","seg-014","seg-016"]},{"id":"wangli-yundu:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/030-zhong-feng/wangli-yundu/0001-1","materialId":"wangli-yundu","materialTitle":"詩經韻讀","contributorLine":"现代 · 王力","publicationYear":1980,"layer":"global","layerLabel":"全篇总说","targetText":"《终风》韵读总说","sourceLabel":"第 152-153 页","attributionLabel":"王力","sectionLabel":"韵读","excerpt":"王力将《终风》读作四章换韵：首章“暴(bok)、笑(sio)、敖(ngo)、悼(dok)”为药宵通韵，次章“霾(mea)、来(la)、来(la)、思(sia)”入之部，三章“曀(yet)、曀(yet)、嚏(tyet)”入质部，四章“雷(luoi)、怀(hoi)”入微部。各章用韵紧凑，正与情绪层层推进相应。","fullText":"王力将《终风》读作四章换韵：首章“暴(bok)、笑(sio)、敖(ngo)、悼(dok)”为药宵通韵，次章“霾(mea)、来(la)、来(la)、思(sia)”入之部，三章“曀(yet)、曀(yet)、嚏(tyet)”入质部，四章“雷(luoi)、怀(hoi)”入微部。各章用韵紧凑，正与情绪层层推进相应。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"wangli-yundu:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/030-zhong-feng/wangli-yundu/0002-1","materialId":"wangli-yundu","materialTitle":"詩經韻讀","contributorLine":"现代 · 王力","publicationYear":1980,"layer":"span","layerLabel":"诗句片段","targetText":"终风且暴，顾我则笑。谑浪笑敖，中心是悼。终风且霾，惠然肯来。莫往莫来，悠悠我思。终风且曀，不日有曀。寤言不寐，愿言则嚏。曀曀其阴，虺虺其雷。寤言不寐，愿言则怀。","sourceLabel":"第 152-153 页","attributionLabel":"王力","sectionLabel":"韵读","excerpt":"页图可读《终风》首章通押药宵，二章转之，三章转质，四章转微。王力所记注音显示，本篇篇幅虽短，但章章换韵明确，因此在回环复沓中仍有明显的声律递变。","fullText":"页图可读《终风》首章通押药宵，二章转之，三章转质，四章转微。王力所记注音显示，本篇篇幅虽短，但章章换韵明确，因此在回环复沓中仍有明显的声律递变。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016"]},{"id":"zhuxi-shijichuan-kr1c0009:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/030-zhong-feng/zhuxi-shijichuan-kr1c0009/0001-1","materialId":"zhuxi-shijichuan-kr1c0009","materialTitle":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"layer":"span","layerLabel":"诗句片段","targetText":"終風且暴，顧我則笑。謔浪笑敖，中心是悼。","sourceLabel":null,"attributionLabel":"朱熹","sectionLabel":null,"excerpt":"比也。朱熹从庄姜伤庄公说，以终风暴疾比其人狂荡轻薄；“顧我則笑”“謔浪笑敖”写其见侮慢而失礼，故妇人中心伤悼。","fullText":"比也。朱熹从庄姜伤庄公说，以终风暴疾比其人狂荡轻薄；“顧我則笑”“謔浪笑敖”写其见侮慢而失礼，故妇人中心伤悼。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004"]},{"id":"zhuxi-shijichuan-kr1c0009:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/030-zhong-feng/zhuxi-shijichuan-kr1c0009/0002-1","materialId":"zhuxi-shijichuan-kr1c0009","materialTitle":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"layer":"span","layerLabel":"诗句片段","targetText":"終風且霾，惠然肯來。莫往莫來，悠悠我思。","sourceLabel":null,"attributionLabel":"朱熹","sectionLabel":null,"excerpt":"比也。朱熹认为第二章语意已转，从首章之伤转入思望；“惠然肯來”只是冀望之辞，而“莫往莫來”终归于其不至，于是悠悠之思愈长。","fullText":"比也。朱熹认为第二章语意已转，从首章之伤转入思望；“惠然肯來”只是冀望之辞，而“莫往莫來”终归于其不至，于是悠悠之思愈长。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-005","seg-006","seg-007","seg-008"]},{"id":"zhuxi-shijichuan-kr1c0009:0003-1:part-1","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/030-zhong-feng/zhuxi-shijichuan-kr1c0009/0003-1","materialId":"zhuxi-shijichuan-kr1c0009","materialTitle":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"layer":"span","layerLabel":"诗句片段","targetText":"終風且曀，不日有曀。寤言不寐，願言則嚏。","sourceLabel":null,"attributionLabel":"朱熹","sectionLabel":null,"excerpt":"比也。朱熹以“不日有曀”为暂开而复蔽，仍比其人情意反复；“願言則嚏”则承思望而来，写其想念之深，至于觉而有言、终夜不寐。","fullText":"比也。朱熹以“不日有曀”为暂开而复蔽，仍比其人情意反复；“願言則嚏”则承思望而来，写其想念之深，至于觉而有言、终夜不寐。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-009","seg-010","seg-011","seg-012"]},{"id":"zhuxi-shijichuan-kr1c0009:0004-1:part-1","annotationId":"0004","glossId":"0004-1","glossHref":"/shijing/gloss/030-zhong-feng/zhuxi-shijichuan-kr1c0009/0004-1","materialId":"zhuxi-shijichuan-kr1c0009","materialTitle":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"layer":"span","layerLabel":"诗句片段","targetText":"曀曀其陰，虺虺其靁。寤言不寐，願言則懷。","sourceLabel":null,"attributionLabel":"朱熹","sectionLabel":null,"excerpt":"比也。朱熹认为末章风雷愈甚，比其狂惑愈深；而“願言則懷”则比前三章更进一步，不仅我思其人，更希望其人念我。","fullText":"比也。朱熹认为末章风雷愈甚，比其狂惑愈深；而“願言則懷”则比前三章更进一步，不仅我思其人，更希望其人念我。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-013","seg-014","seg-015","seg-016"]},{"id":"zhuxi-shijichuan-kr1c0009:0005-1:part-1","annotationId":"0005","glossId":"0005-1","glossHref":"/shijing/gloss/030-zhong-feng/zhuxi-shijichuan-kr1c0009/0005-1","materialId":"zhuxi-shijichuan-kr1c0009","materialTitle":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"layer":"global","layerLabel":"全篇总说","targetText":"終風四章章四句","sourceLabel":null,"attributionLabel":"朱熹","sectionLabel":null,"excerpt":"朱熹记《終風》为四章、章四句，并以庄姜伤庄公之说统摄全篇，故章解都兼见见侮之怨与不能已之思。","fullText":"朱熹记《終風》为四章、章四句，并以庄姜伤庄公之说统摄全篇，故章解都兼见见侮之怨与不能已之思。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]}]}}}
