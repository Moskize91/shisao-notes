art-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/083-you-nv-tong-che/chengjunying-jiangjianyuan-zhuxi/0001-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"有女同车，颜如舜华。将翱将翔，佩玉琼琚。彼美孟姜，洵美且都。有女同行，颜如舜英。将翱将翔，佩玉将将。彼美孟姜，德音不忘。","sourceLabel":"第 184-186 页","attributionLabel":"程俊英","sectionLabel":"题解","excerpt":"程俊英、蒋见元以《有女同车》为写贵族男女恋歌，谓诗中兼写女子容貌与德音，孟姜只是美人泛称，不必实指文姜。","fullText":"程俊英、蒋见元以《有女同车》为写贵族男女恋歌，谓诗中兼写女子容貌与德音，孟姜只是美人泛称，不必实指文姜。","notes":null,"partOrder":1,"anchorIds":["seg-012:1-2:德音","seg-005:3-4:孟姜"],"glossAnchorIds":["anchor-1-1","anchor-1-2"],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012"]},{"id":"chenhuan-chuanshu:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/083-you-nv-tong-che/chenhuan-chuanshu/0001-1","materialId":"chenhuan-chuanshu","materialTitle":"詩毛氏傳疏","contributorLine":"清 · 陳奐","publicationYear":1847,"layer":"span","layerLabel":"诗句片段","targetText":"有女同車，顏如舜華。將翺將翔，佩玉瓊琚。彼美孟姜，洵美且都。有女同行，顏如舜英。將翺將翔，佩玉將將。彼美孟姜，德音不忘。","sourceLabel":"第 95 页","attributionLabel":"陳奂","sectionLabel":"疏","excerpt":"陳奂疏《有女同車》，申《序》刺忽之義，謂孟姜既美且都，車服佩玉皆見齊女之盛飾賢德。","fullText":"陳奂疏《有女同車》，申《序》刺忽之義，謂孟姜既美且都，車服佩玉皆見齊女之盛飾賢德。","notes":null,"partOrder":1,"anchorIds":["seg-005:3-4:孟姜","seg-006:2-4:美且都","seg-004:1-2:佩玉"],"glossAnchorIds":["anchor-1-1","anchor-1-2","anchor-1-3"],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012"]},{"id":"fangyurun-yuanshi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/083-you-nv-tong-che/fangyurun-yuanshi/0001-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"span","layerLabel":"诗句片段","targetText":"有女同車，顔如舜華。將翺將翔，佩玉瓊琚。彼美孟姜，洵美且都。有女同行，顔如舜英。將翺將翔，佩玉將將。彼美孟姜，德音不忘。","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"总评","excerpt":"方玉潤論《有女同車》是諷鄭太子忽宜昏於齊之詩，非刺其不昏；同車佩玉、德音不忘，皆足見孟姜威儀盛飾與賢德。","fullText":"方玉潤論《有女同車》是諷鄭太子忽宜昏於齊之詩，非刺其不昏；同車佩玉、德音不忘，皆足見孟姜威儀盛飾與賢德。","notes":null,"partOrder":1,"anchorIds":["seg-001:3-4:同車","seg-004:1-2:佩玉","seg-012:1-4:德音不忘","seg-005:3-4:孟姜"],"glossAnchorIds":["anchor-1-1","anchor-1-2","anchor-1-3","anchor-1-4"],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012"]},{"id":"maruichen-tongshi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/083-you-nv-tong-che/maruichen-tongshi/0001-1","materialId":"maruichen-tongshi","materialTitle":"毛詩傳箋通釋","contributorLine":"清 · 馬瑞辰","publicationYear":1989,"layer":"span","layerLabel":"诗句片段","targetText":"有女同車，顏如舜華。將翺將翔，佩玉瓊琚。彼美孟姜，洵美且都。有女同行，顏如舜英。將翺將翔，佩玉將將。彼美孟姜，德音不忘。","sourceLabel":"第 383-384 页","attributionLabel":"馬瑞辰","sectionLabel":"通釋","excerpt":"馬瑞辰以《有女同車》為專美孟姜之詩，謂其同車佩玉、洵美且都，皆見齊女容德兼美。","fullText":"馬瑞辰以《有女同車》為專美孟姜之詩，謂其同車佩玉、洵美且都，皆見齊女容德兼美。","notes":null,"partOrder":1,"anchorIds":["seg-005:3-4:孟姜","seg-001:3-4:同車","seg-004:1-2:佩玉","seg-006:1-4:洵美且都"],"glossAnchorIds":["anchor-1-1","anchor-1-2","anchor-1-3","anchor-1-4"],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012"]},{"id":"quwanli-quanshi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/083-you-nv-tong-che/quwanli-quanshi/0001-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"span","layerLabel":"诗句片段","targetText":"有女同车，颜如舜华。将翱将翔，佩玉琼琚。彼美孟姜，洵美且都。有女同行，颜如舜英。将翱将翔，佩玉将将。彼美孟姜，德音不忘。","sourceLabel":"第 100-101 页","attributionLabel":"屈万里","sectionLabel":"注释","excerpt":"屈万里以《有女同車》为婚者美其新妇之诗，谓淫奔者不得公然同车，舜华舜英皆木槿花，将将为佩玉相击声，德音为美言。","fullText":"屈万里以《有女同車》为婚者美其新妇之诗，谓淫奔者不得公然同车，舜华舜英皆木槿花，将将为佩玉相击声，德音为美言。","notes":null,"partOrder":1,"anchorIds":["seg-001:3-4:同车","seg-002:3-4:舜华","seg-008:3-4:舜英","seg-010:3-4:将将","seg-010:1-2:佩玉","seg-012:1-2:德音"],"glossAnchorIds":["anchor-1-1","anchor-1-2","anchor-1-3","anchor-1-4","anchor-1-5","anchor-1-6"],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012"]},{"id":"wangli-yundu:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/083-you-nv-tong-che/wangli-yundu/0001-1","materialId":"wangli-yundu","materialTitle":"詩經韻讀","contributorLine":"现代 · 王力","publicationYear":1980,"layer":"span","layerLabel":"诗句片段","targetText":"有女同车，颜如舜华。将翱将翔，佩玉琼琚。彼美孟姜，洵美且都。有女同行，颜如舜英。将翱将翔，佩玉将将。彼美孟姜，德音不忘。","sourceLabel":"第 187 页","attributionLabel":"王力","sectionLabel":"韵读","excerpt":"王力录《有女同车》二章韵读，首章标出“车、华、琚、姜、都”的读音关系，次章“行、英、翔、将、姜、忘”同归阳部。","fullText":"王力录《有女同车》二章韵读，首章标出“车、华、琚、姜、都”的读音关系，次章“行、英、翔、将、姜、忘”同归阳部。","notes":null,"partOrder":1,"anchorIds":["seg-001:4-4:车","seg-002:4-4:华","seg-004:4-4:琚","seg-005:4-4:姜","seg-006:4-4:都","seg-007:4-4:行","seg-008:4-4:英","seg-009:4-4:翔","seg-010:3-3:将","seg-011:4-4:姜","seg-012:4-4:忘"],"glossAnchorIds":["anchor-1-1","anchor-1-2","anchor-1-3","anchor-1-4","anchor-1-5","anchor-1-6","anchor-1-7","anchor-1-8","anchor-1-9","anchor-1-10","anchor-1-11"],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012"]}]}}}
