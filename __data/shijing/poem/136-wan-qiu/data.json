surfaceText":"缶","charStart":4,"charEnd":4,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-10","chengjunying-jiangjianyuan-zhuxi:0001-1:part-9"],"materialIds":["chengjunying-jiangjianyuan-zhuxi"]},{"id":"seg-010:1-4:宛丘之道","segmentId":"seg-010","segmentOrder":10,"surfaceText":"宛丘之道","charStart":1,"charEnd":4,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-8"],"materialIds":["chengjunying-jiangjianyuan-zhuxi"]},{"id":"seg-010:4-4:道","segmentId":"seg-010","segmentOrder":10,"surfaceText":"道","charStart":4,"charEnd":4,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-10"],"materialIds":["chengjunying-jiangjianyuan-zhuxi"]},{"id":"seg-011:1-4:無冬無夏","segmentId":"seg-011","segmentOrder":11,"surfaceText":"無冬無夏","charStart":1,"charEnd":4,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-8"],"materialIds":["chengjunying-jiangjianyuan-zhuxi"]},{"id":"seg-012:1-4:值其鷺翿","segmentId":"seg-012","segmentOrder":12,"surfaceText":"值其鷺翿","charStart":1,"charEnd":4,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-8"],"materialIds":["chengjunying-jiangjianyuan-zhuxi"]},{"id":"seg-012:4-4:翿","segmentId":"seg-012","segmentOrder":12,"surfaceText":"翿","charStart":4,"charEnd":4,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-10","chengjunying-jiangjianyuan-zhuxi:0001-1:part-9"],"materialIds":["chengjunying-jiangjianyuan-zhuxi"]}],"entries":[{"id":"chengjunying-jiangjianyuan-zhuxi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/136-wan-qiu/chengjunying-jiangjianyuan-zhuxi/0001-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"子之湯兮，宛丘之上兮。洵有情兮，而無望兮。坎其擊鼓，宛丘之下。無冬無夏，值其鷺羽。坎其擊缶，宛丘之道。無冬無夏，值其鷺翿。","sourceLabel":"第 305-307 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","excerpt":"这首诗写一个以巫为职业的舞女。诗中的“子”就是这样一个巫女。陈国民间风俗爱好跳舞，巫风盛行，所以她不论天冷天热都在街上为人们祝祷跳舞。巫舞的形式是羽舞，也称翳舞、翿舞。毛序说“宛丘，刺幽公也”，朱熹则较为谨慎，认为只是叙其事以刺之。此诗首章直截表达情感，后二章则转用白描，抑扬顿挫地写出巫女歌舞的场面。","fullText":"这首诗写一个以巫为职业的舞女。诗中的“子”就是这样一个巫女。陈国民间风俗爱好跳舞，巫风盛行，所以她不论天冷天热都在街上为人们祝祷跳舞。巫舞的形式是羽舞，也称翳舞、翿舞。毛序说“宛丘，刺幽公也”，朱熹则较为谨慎，认为只是叙其事以刺之。此诗首章直截表达情感，后二章则转用白描，抑扬顿挫地写出巫女歌舞的场面。子之湯兮，宛丘之上兮。洵有情兮，而無望兮。子，指跳舞的巫女。湯，同荡，形容舞姿摇动的样子。宛丘，陈国丘名，为国人游观之所。洵，信、确实。無望，没有威仪可瞻望，也可解为诗人有情而不敢抱希望。韵读：阳部一一湯、上、望。坎其擊鼓，宛丘之下。無冬無夏，值其鷺羽。坎其，即坎坎，击鼓之声。值，持。鷺羽，用鹭鸟羽毛制成的舞具。韵读：鱼部一一鼓、下、夏、羽。坎其擊缶，宛丘之道。無冬無夏，值其鷺翿。缶，瓦盆，可用作打拍子的乐器。翿，即鷺羽一类舞具。韵读：幽部一一缶、道、翿。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012"]},{"id":"chengjunying-jiangjianyuan-zhuxi:0001-1:part-2","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/136-wan-qiu/chengjunying-jiangjianyuan-zhuxi/0001-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"子之湯兮，宛丘之上兮。洵有情兮，而無望兮。坎其擊鼓，宛丘之下。無冬無夏，值其鷺羽。坎其擊缶，宛丘之道。無冬無夏，值其鷺翿。","sourceLabel":"第 305-307 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","excerpt":"子之湯兮，宛丘之上兮。洵有情兮，而無望兮。","fullText":"这首诗写一个以巫为职业的舞女。诗中的“子”就是这样一个巫女。陈国民间风俗爱好跳舞，巫风盛行，所以她不论天冷天热都在街上为人们祝祷跳舞。巫舞的形式是羽舞，也称翳舞、翿舞。毛序说“宛丘，刺幽公也”，朱熹则较为谨慎，认为只是叙其事以刺之。此诗首章直截表达情感，后二章则转用白描，抑扬顿挫地写出巫女歌舞的场面。子之湯兮，宛丘之上兮。洵有情兮，而無望兮。子，指跳舞的巫女。湯，同荡，形容舞姿摇动的样子。宛丘，陈国丘名，为国人游观之所。洵，信、确实。無望，没有威仪可瞻望，也可解为诗人有情而不敢抱希望。韵读：阳部一一湯、上、望。坎其擊鼓，宛丘之下。無冬無夏，值其鷺羽。坎其，即坎坎，击鼓之声。值，持。鷺羽，用鹭鸟羽毛制成的舞具。韵读：鱼部一一鼓、下、夏、羽。坎其擊缶，宛丘之道。無冬無夏，值其鷺翿。缶，瓦盆，可用作打拍子的乐器。翿，即鷺羽一类舞具。韵读：幽部一一缶、道、翿。","notes":null,"partOrder":2,"anchorIds":["seg-001:1-4:子之湯兮","seg-002:1-5:宛丘之上兮","seg-003:1-4:洵有情兮","seg-004:1-4:而無望兮"],"glossAnchorIds":["anchor-2-1","anchor-2-2","anchor-2-3","anchor-2-4"],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012"]},{"id":"chengjunying-jiangjianyuan-zhuxi:0001-1:part-3","annotationId":"0001","glossId":"0001-1","glossHref":"/shiji