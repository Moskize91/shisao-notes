nchorIds":[]},{"index":3,"text":"具","anchorIds":[]},{"index":4,"text":"阜","anchorIds":[]}]},{"id":"seg-027","order":27,"text":"叔马慢忌","entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-1","chenhuan-chuanshu:0001-1:part-1","quwanli-quanshi:0020-1:part-1","quwanli-quanshi:0028-1:part-1","wangli-yundu:0003-1:part-1"],"characters":[{"index":1,"text":"叔","anchorIds":[]},{"index":2,"text":"马","anchorIds":[]},{"index":3,"text":"慢","anchorIds":[]},{"index":4,"text":"忌","anchorIds":[]}]},{"id":"seg-028","order":28,"text":"叔发罕忌","entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-1","chenhuan-chuanshu:0001-1:part-1","quwanli-quanshi:0020-1:part-1","quwanli-quanshi:0028-1:part-1","wangli-yundu:0003-1:part-1"],"characters":[{"index":1,"text":"叔","anchorIds":[]},{"index":2,"text":"发","anchorIds":[]},{"index":3,"text":"罕","anchorIds":[]},{"index":4,"text":"忌","anchorIds":[]}]},{"id":"seg-029","order":29,"text":"抑释掤忌","entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-1","chenhuan-chuanshu:0001-1:part-1","quwanli-quanshi:0020-1:part-1","quwanli-quanshi:0021-1:part-1","quwanli-quanshi:0029-1:part-1","wangli-yundu:0003-1:part-1"],"characters":[{"index":1,"text":"抑","anchorIds":[]},{"index":2,"text":"释","anchorIds":[]},{"index":3,"text":"掤","anchorIds":[]},{"index":4,"text":"忌","anchorIds":[]}]},{"id":"seg-030","order":30,"text":"抑鬯弓忌","entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-1","chenhuan-chuanshu:0001-1:part-1","quwanli-quanshi:0020-1:part-1","quwanli-quanshi:0021-1:part-1","quwanli-quanshi:0030-1:part-1","wangli-yundu:0003-1:part-1"],"characters":[{"index":1,"text":"抑","anchorIds":[]},{"index":2,"text":"鬯","anchorIds":[]},{"index":3,"text":"弓","anchorIds":[]},{"index":4,"text":"忌","anchorIds":[]}]}]},"materials":[{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","contributorLine":"清 · 陳奐","publicationYear":1847,"glossCount":1,"partCount":1},{"id":"wangli-yundu","title":"詩經韻讀","contributorLine":"现代 · 王力","publicationYear":1980,"glossCount":3,"partCount":3},{"id":"quwanli-quanshi","title":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"glossCount":30,"partCount":30},{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"glossCount":4,"partCount":4},{"id":"maruichen-tongshi","title":"毛詩傳箋通釋","contributorLine":"清 · 馬瑞辰","publicationYear":1989,"glossCount":1,"partCount":1},{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"glossCount":1,"partCount":1}],"stats":{"materialCount":6,"glossCount":40,"anchoredPartCount":1,"overviewPartCount":4},"overview":{"prefaceEntryIds":[],"globalEntryIds":["fangyurun-yuanshi:0001-1:part-1","fangyurun-yuanshi:0002-1:part-1","quwanli-quanshi:0001-1:part-1","quwanli-quanshi:0002-1:part-1"]},"focusAnchors":[{"id":"seg-010:3-4:傷女","segmentId":"seg-010","segmentOrder":10,"surfaceText":"傷女","charStart":3,"charEnd":4,"entryIds":["maruichen-tongshi:0001-1:part-1"],"materialIds":["maruichen-tongshi"]}],"entries":[{"id":"chengjunying-jiangjianyuan-zhuxi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/078-da-shu-yu-tian/chengjunying-jiangjianyuan-zhuxi/0001-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"叔于田，乘乘马。执辔如组，两骖如舞。叔在薮，火烈具举。袒裼暴虎，献于公所。将叔无狃，戒其伤女。叔于田，乘乘黄。两服上襄，两骖雁行。叔在薮，火烈具扬。叔善射忌，又良御忌。抑磬控忌，抑纵送忌。叔于田，乘乘鸨。两服齐首，两骖如手。叔在薮，火烈具阜。叔马慢忌，叔发罕忌。抑释掤忌，抑鬯弓忌。","sourceLabel":"第 175-177 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","excerpt":"这是赞美一位青年猎手的诗。毛序：“大叔于田，刺庄公也。叔多才而好勇，不义而得众也。”其误与上篇叔于田同。这位猎手有高车四马，有弓箭，有烧火的随从人员，打来老虎又献于公所，都说明他的身份是贵族。\n篇名原作叔于田，释文：“叔于田，本或作大叔于田者，误。”后人因此篇诗文较上篇长，故加上大小的大。严粲诗缉：“短篇者止曰叔于田，长篇者加大为别。”陈子展先生认为此诗“似是改写之叔于田，或是二者同出于一母题之歌谣”颇有理。所谓改写的区别，看来就在于方玉润所说的“前篇虚写，此篇实赋”。这位诗人可能是狩猎的参加者，否则不会描写得如此逼真具体，有声有色。诗对于驾车、射箭、打虎、烧火等都作了细节的形容，通过这些动作的描写把青年猎人勇武好胜的性格衬托得很鲜明。这种铺叙的手法对后世辞赋的影响很大，所以此诗被评为“描摹工艳，铺张亦复淋漓尽致。便为长杨、羽猎之祖”。\n叔于田，乘乘马。执辔如组，两骖如舞。叔在薮，火烈具举。袒裼暴虎，献于公所。将叔无狃，戒其伤女。\n叔于田，本篇的诗题据诗经命题的惯例，应作叔于田，后人加一“大”字，是“长”的意思，以区别于前面短篇的叔于田。\n乘（chéng），驾车，作动词。\n乘（shèng）马，古时一车四马叫做一乘。\n执辔如组，手执六条马缰，整齐如带。见简兮注。\n两骖，驾车的四匹马中在两旁的两匹。\n如舞，像跳舞行列一样动作整齐。毛传：“骖之与服和谐中节。”服，指中间的两匹服马。\n薮，低湿而多草木之处，为禽兽聚处。韩说曰：“禽兽居之曰薮。”孔疏：“边有甫草，此言在薮，盖薮甫也。”\n烈，鲁诗作列，烈是列的假借字，列是划的古字。说文：“划，遮也。”打猎时放火烧草，遮断群兽逃走的路，叫“火划”。\n具，通“俱”。具举，齐起，指火光四面升起。\n袒裼（tǎn xī），脱衣露体，赤膊。齐、韩诗袒作襢，袒是襢的假借字。说文：“襢，袒也。”诗曰：“襢裼暴虎。”\n暴，通搏。暴虎，不持兵器，空手打虎。毛传：“暴虎，徒搏也。”\n将（qiāng），请。狃（niǔ），熟练。毛传：“狃，习也。”无狃，不要因熟练而麻痹大意。\n戒，警惕。\n女，通“汝”，指叔。\n韵读：鱼部——马（音姥mǔ）、组、舞、举、虎、所、女。\n叔于田，乘乘黄。两服上襄，两骖雁行。叔在薮，火烈具扬。叔善射忌，又良御忌。抑磬控忌，抑纵送忌。\n乘黄，四匹黄马。\n两服，驾车的四匹马中，居中驾辕的两匹。孔疏：“中央夹辕者名服马。”\n襄，向“骧”，说文：“骧，马之低仰也。”上襄，指马头昂起。\n雁行，骖马比服马稍后，其排列像飞雁行列一样。\n扬，孔疏：“言举火而扬其光耳。”\n忌，语尾助词。郑笺：“忌，读如‘彼己之子’之己。”\n良御，善于驾车。\n抑，发语词，含有“忽而”的意思。礼记史虞注：“抑，辞也。”\n磬，原为乐器名，后以其形状形容人弯腰前曲貌。\n控，控制马不使前进。磬控，形容御者止马的姿态。\n纵送，纵马快跑。马瑞辰通释：“磬控双声字，纵送叠韵字，皆言御者驰逐之貌。”\n韵读：阳部——黄、襄、行（音杭）、扬。鱼部——射（音豫）、御。东部——控、送。\n叔于田，乘乘鸨。两服齐首，两骖如手。叔在薮，火烈具阜。叔马慢忌，叔发罕忌。抑释掤忌，抑鬯弓忌。\n鸨（bǎo），黑白杂色的马。尔雅释畜郭注：“鸨，今之乌骊也。”\n齐首，两匹服马并头齐驱。即上章的“两服上襄”。\n如手，两骖马在旁而稍后，像人的双手那样整齐。与上章“两骖雁行”亦同意。\n阜，旺盛。\n发，发箭。\n罕，少。这两句意为，打猎近尾声，叔的马走得慢下来，他射出的箭也少了。\n释，打开。楚辞王注：“释，解也。”\n掤（bīng），箭筒盖。释掤，打开箭筒的盖，准备将箭收起。\n鬯（chàng），通“韔”，弓袋。这里用作动词，“鬯弓”指将弓放进弓袋里。","fullText":"这是赞美一位青年猎手的诗。毛序：“大叔于田，刺庄公也。叔多才而好勇，不义而得众也。”其误与上篇叔于田同。这位猎手有高车四马，有弓箭，有烧火的随从人员，打来老虎又献于公所，都说明他的身份是贵族。\n篇名原作叔于田，释文：“叔于田，本或作大叔于田者，误。”后人因此篇诗文较上篇长，故加上大小的大。严粲诗缉：“短篇者止曰叔于田，长篇者加大为别。”陈子展先生认为此诗“似是改写之叔于田，或是二者同出于一母题之歌谣”颇有理。所谓改写的区别，看来就在于方玉润所说的“前篇虚写，此篇实赋”。这位诗人可能是狩猎的参加者，否则不会描写得如此逼真具体，有声有色。诗对于驾车、射箭、打虎、烧火等都作了细节的形容，通过这些动作的描写把青年猎人勇武好胜的性格衬托得很鲜明。这种铺叙的手法对后世辞赋的影响很大，所以此诗被评为“描摹工艳，铺张亦复淋漓尽致。便为长杨、羽猎之祖”。\n叔于田，乘乘马。执辔如组，两骖如舞。叔在薮，火烈具举。袒裼暴虎，献于公所。将叔无狃，戒其伤女。\n叔于田，本篇的诗题据诗经命题的惯例，应作叔于田，后人加一“大”字，是“长”的意思，以区别于前面短篇的叔于田。\n乘（chéng），驾车，作动词。\n乘（shèng）马，古时一车四马叫做一乘。\n执辔如组，手执六条马缰，整齐如带。见简兮注。\n两骖，驾车的四匹马中在两旁的两匹。\n如舞，像跳舞行列一样动作整齐。毛传：“骖之与服和谐中节。”服，指中间的两匹服马。\n薮，低湿而多草木之处，为禽兽聚处。韩说曰：“禽兽居之曰薮。”孔疏：“边有甫草，此言在薮，盖薮甫也。”\n烈，鲁诗作列，烈是列的假借字，列是划的古字。说文：“划，遮也。”打猎时放火烧草，遮断群兽逃走的路，叫“火划”。\n具，通“俱”。具举，齐起，指火光四面升起。\n袒裼（tǎn xī），脱衣露体，赤膊。齐、韩诗袒作襢，袒是襢的假借字。说文：“襢，袒也。”诗曰：“襢裼暴虎。”\n暴，通搏。暴虎，不持兵器，空手打虎。毛传：“暴虎，徒搏也。”\n将（qiāng），请。狃（niǔ），熟练。毛传：“狃，习也。”无狃，不要因熟练而麻痹大意。\n戒，警惕。\n女，通“汝”，指叔。\n韵读：鱼部——马（音姥mǔ）、组、舞、举、虎、所、女。\n叔于田，乘乘黄。两服上襄，两骖雁行。叔在薮，火烈具扬。叔善射忌，又良御忌。抑磬控忌，抑纵送忌。\n乘黄，四匹黄马。\n两服，驾车的四匹马中，居中驾辕的两匹。孔疏：“中央夹辕者名服马。”\n襄，向“骧”，说文：“骧，马之低仰也。”上襄，指马头昂起。\n雁行，骖马比服马稍后，其排列像飞雁行列一样。\n扬，孔疏：“言举火而扬其光耳。”\n忌，语尾助词。郑笺：“忌，读如‘彼己之子’之己。”\n良御，善于驾车。\n抑，发语词，含有“忽而”的意思。礼记史虞注：“抑，辞也。”\n磬，原为乐器名，后以其形状形容人弯腰前曲貌。\n控，控制马不使前进。磬控，形容御者止马的姿态。\n纵送，纵马快跑。马瑞辰通释：“磬控双声字，纵送叠韵字，皆言御者驰逐之貌。”\n韵读：阳部——黄、襄、行（音杭）、扬。鱼部——射（音豫）、御。东部——控、送。\n叔于田，乘乘鸨。两服齐首，两骖如手。叔在薮，火烈具阜。叔马慢忌，叔发罕忌。抑释掤忌，抑鬯弓忌。\n鸨（bǎo），黑白杂色的马。尔雅释畜郭注：“鸨，今之乌骊也。”\n齐首，两匹服马并头齐驱。即上章的“两服上襄”。\n如手，两骖马在旁而稍后，像人的双手那样整齐。与上章“两骖雁行”亦同意。\n阜，旺盛。\n发，发箭。\n罕，少。这两句意为，打猎近尾声，叔的马走得慢下来，他射出的箭也少了。\n释，打开。楚辞王注：“释，解也。”\n掤（bīng），箭筒盖。释掤，打开箭筒的盖，准备将箭收起。\n鬯（chàng），通“韔”，弓袋。这里用作动词，“鬯弓”指将弓放进弓袋里。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016","seg-017","seg-018","seg-019","seg-020","seg-021","seg-022","seg-023","seg-024","seg-025","seg-026","seg-027","seg-028","seg-029","seg-030"]},{"id":"chenhuan-chuanshu:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/078-da-shu-yu-tian/chenhuan-chuanshu/0001-1","materialId":"chenhuan-chuanshu","materialTitle":"詩毛氏傳疏","contributorLine":"清 · 陳奐","publicationYear":1847,"layer":"span","layerLabel":"诗句片段","targetText":"叔于田，乘乘馬。執轡如組，兩驂如舞。叔在藪，火烈具舉。襢裼暴虎，獻于公所。將叔無狃，戒其傷女。叔于田，乘乘黃。兩服上襄，兩驂鴈行。叔在藪，火烈具揚。叔善射忌，又良御忌。抑磬控忌，抑縱送忌。叔于田，乘乘鴇。兩服齊首，兩驂如手。叔在藪，火烈具阜。叔馬慢忌，叔發罕忌。抑釋掤忌，抑鬯弓忌。","sourceLabel":"第 83-85 页","attributionLabel":"陈奂","sectionLabel":"经文","excerpt":"叔于田，乘乘馬。執轡如組，兩驂如舞。叔在藪，火烈具舉。襢裼暴虎，獻于公所。將叔無狃，戒其傷女。叔于田，乘乘黃。兩服上襄，兩驂鴈行。叔在藪，火烈具揚。叔善射忌，又良御忌。抑磬控忌，抑縱送忌。叔于田，乘乘鴇。兩服齊首，兩驂如手。叔在藪，火烈具阜。叔馬慢忌，叔發罕忌。抑釋掤忌，抑鬯弓忌。","fullText":"叔于田，乘乘馬。執轡如組，兩驂如舞。叔在藪，火烈具舉。襢裼暴虎，獻于公所。將叔無狃，戒其傷女。叔于田，乘乘黃。兩服上襄，兩驂鴈行。叔在藪，火烈具揚。叔善射忌，又良御忌。抑磬控忌，抑縱送忌。叔于田，乘乘鴇。兩服齊首，兩驂如手。叔在藪，火烈具阜。叔馬慢忌，叔發罕忌。抑釋掤忌，抑鬯弓忌。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016","seg-017","seg-018","seg-019","seg-020","seg-021","seg-022","seg-023","seg-024","seg-025","seg-026","seg-027","seg-028","seg-029","seg-030"]},{"id":"fangyurun-yuanshi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/078-da-shu-yu-tian/fangyurun-yuanshi/0001-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"global","layerLabel":"全篇总说","targetText":"刺莊公縱弟恃勇而勝衆也。","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"题注","excerpt":"刺莊公縱弟恃勇而勝衆也。","fullText":"刺莊公縱弟恃勇而勝衆也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"fangyurun-yuanshi:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/078-da-shu-yu-tian/fangyurun-yuanshi/0002-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"global","layerLabel":"全篇总说","targetText":"右《大叔于田》三章，章十句。案此詩與前篇同爲刺莊公縱弟游獵之作。但前篇虚寫，此篇實賦；前篇私游，此篇從獵而愈矜其勇也。詩曰：「襢裼暴虎，獻于公所。」暴虎，危事，太叔至親，而叔以此驕其兄，則恃勇無君之心已可概見。莊公時不惟不怒其無禮，而且勞而慰之曰：「將叔無狃，戒其傷女。」豈真愛之耶？實縱之以蹈於危耳。詩人窺破此隱，故特咏之以爲誅心之論，如《春秋》書法，微意所在也。若謂國人愛之而恐其或傷，則好勇不義之人，人又何愛之有耶？至其詞氣之工，則姚氏所謂「描摹工豔，鋪張亦復淋漓盡致，便爲《長楊》、《羽獵》之祖」，庶幾能識作者苦心云。","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"总评","excerpt":"右《大叔于田》三章，章十句。案此詩與前篇同爲刺莊公縱弟游獵之作。但前篇虚寫，此篇實賦；前篇私游，此篇從獵而愈矜其勇也。詩曰：「襢裼暴虎，獻于公所。」暴虎，危事，太叔至親，而叔以此驕其兄，則恃勇無君之心已可概見。莊公時不惟不怒其無禮，而且勞而慰之曰：「將叔無狃，戒其傷女。」豈真愛之耶？實縱之以蹈於危耳。詩人窺破此隱，故特咏之以爲誅心之論，如《春秋》書法，微意所在也。若謂國人愛之而恐其或傷，則好勇不義之人，人又何愛之有耶？至其詞氣之工，則姚氏所謂「描摹工豔，鋪張亦復淋漓盡致，便爲《長楊》、《羽獵》之祖」，庶幾能識作者苦心云。","fullText":"右《大叔于田》三章，章十句。案此詩與前篇同爲刺莊公縱弟游獵之作。但前篇虚寫，此篇實賦；前篇私游，此篇從獵而愈矜其勇也。詩曰：「襢裼暴虎，獻于公所。」暴虎，危事，太叔至親，而叔以此驕其兄，則恃勇無君之心已可概見。莊公時不惟不怒其無禮，而且勞而慰之曰：「將叔無狃，戒其傷女。」豈真愛之耶？實縱之以蹈於危耳。詩人窺破此隱，故特咏之以爲誅心之論，如《春秋》書法，微意所在也。若謂國人愛之而恐其或傷，則好勇不義之人，人又何愛之有耶？至其詞氣之工，則姚氏所謂「描摹工豔，鋪張亦復淋漓盡致，便爲《長楊》、《羽獵》之祖」，庶幾能識作者苦心云。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"fangyurun-yuanshi:0003-1:part-1","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/078-da-shu-yu-tian/fangyurun-yuanshi/0003-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"term","layerLabel":"字词注","targetText":"兩驂車衡外兩馬曰驂。如舞〔董氏逌曰〕五御之法，有舞交衢者，蓋詩所謂「如舞」也。驂與服諧和，然服制於衡不得如舞。其言舞者，驂也。藪澤也。〔孔氏穎達曰〕鄭有圃田，此言「在藪」，蓋圃田也。襢裼〔孔氏穎達曰〕李巡曰：「襢裼，脱衣見體曰肉襢。」孫炎曰：「襢去裼衣。」狃習也。乘黄〔陸氏佃曰〕黄，馬之上色。《明堂位》曰：「周人黄馬蕃鬣。」言吉事乘此。兩服〔孔氏穎達曰〕車有一轅而四馬駕之，中央夾轅者名服馬，兩邊名騑馬，亦曰驂馬。襄駕也。鴈行〔《集傳》〕鴈行者，驂少次服後，如鴈行也。忌、抑語助辭。磬控〔范氏處義曰〕磬，謂使之曲折如磬。控，謂控制不逸。縱送〔《集傳》〕舍拔曰縱，覆彇曰送。〔梁氏益曰〕拔，矢末也，所謂栝也。亦作筈，箭本受弦處。彇與簫同，弓之梢末，所謂弭也。《曲禮》「左手執簫」䟽云：「弓頭稱剡，差斜似簫，故名曰簫，又謂之弰。」鴇〔《集傳》〕驪白雜毛曰鴇，今所謂烏驄也。阜盛也。慢遲也。發發矢也。罕希也。釋解也。掤〔《集傳》〕掤，矢筩蓋。《春秋傳》作「冰」。鬯〔《集傳》〕鬯，弓囊也，與韔同。","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"集释","excerpt":"兩驂車衡外兩馬曰驂。如舞〔董氏逌曰〕五御之法，有舞交衢者，蓋詩所謂「如舞」也。驂與服諧和，然服制於衡不得如舞。其言舞者，驂也。藪澤也。〔孔氏穎達曰〕鄭有圃田，此言「在藪」，蓋圃田也。襢裼〔孔氏穎達曰〕李巡曰：「襢裼，脱衣見體曰肉襢。」孫炎曰：「襢去裼衣。」狃習也。乘黄〔陸氏佃曰〕黄，馬之上色。《明堂位》曰：「周人黄馬蕃鬣。」言吉事乘此。兩服〔孔氏穎達曰〕車有一轅而四馬駕之，中央夾轅者名服馬，兩邊名騑馬，亦曰驂馬。襄駕也。鴈行〔《集傳》〕鴈行者，驂少次服後，如鴈行也。忌、抑語助辭。磬控〔范氏處義曰〕磬，謂使之曲折如磬。控，謂控制不逸。縱送〔《集傳》〕舍拔曰縱，覆彇曰送。〔梁氏益曰〕拔，矢末也，所謂栝也。亦作筈，箭本受弦處。彇與簫同，弓之梢末，所謂弭也。《曲禮》「左手執簫」䟽云：「弓頭稱剡，差斜似簫，故名曰簫，又謂之弰。」鴇〔《集傳》〕驪白雜毛曰鴇，今所謂烏驄也。阜盛也。慢遲也。發發矢也。罕希也。釋解也。掤〔《集傳》〕掤，矢筩蓋。《春秋傳》作「冰」。鬯〔《集傳》〕鬯，弓囊也，與韔同。","fullText":"兩驂車衡外兩馬曰驂。如舞〔董氏逌曰〕五御之法，有舞交衢者，蓋詩所謂「如舞」也。驂與服諧和，然服制於衡不得如舞。其言舞者，驂也。藪澤也。〔孔氏穎達曰〕鄭有圃田，此言「在藪」，蓋圃田也。襢裼〔孔氏穎達曰〕李巡曰：「襢裼，脱衣見體曰肉襢。」孫炎曰：「襢去裼衣。」狃習也。乘黄〔陸氏佃曰〕黄，馬之上色。《明堂位》曰：「周人黄馬蕃鬣。」言吉事乘此。兩服〔孔氏穎達曰〕車有一轅而四馬駕之，中央夾轅者名服馬，兩邊名騑馬，亦曰驂馬。襄駕也。鴈行〔《集傳》〕鴈行者，驂少次服後，如鴈行也。忌、抑語助辭。磬控〔范氏處義曰〕磬，謂使之曲折如磬。控，謂控制不逸。縱送〔《集傳》〕舍拔曰縱，覆彇曰送。〔梁氏益曰〕拔，矢末也，所謂栝也。亦作筈，箭本受弦處。彇與簫同，弓之梢末，所謂弭也。《曲禮》「左手執簫」䟽云：「弓頭稱剡，差斜似簫，故名曰簫，又謂之弰。」鴇〔《集傳》〕驪白雜毛曰鴇，今所謂烏驄也。阜盛也。慢遲也。發發矢也。罕希也。釋解也。掤〔《集傳》〕掤，矢筩蓋。《春秋傳》作「冰」。鬯〔《集傳》〕鬯，弓囊也，與韔同。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"fangyurun-yuanshi:0004-1:part-1","annotationId":"0004","glossId":"0004-1","glossHref":"/shijing/gloss/078-da-shu-yu-tian/fangyurun-yuanshi/0004-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"term","layerLabel":"字词注","targetText":"馬二十一馬，叶滿補反。組七麌。舞同。藪二十五有，叶素苦反。舉六語。虎七麌。所六語。狃二十五有，叶女古反。女六語。叶韻。黄七陽。襄、行、揚並同。本韻。射二十一禡。御六御，叶魚駕反。叶韻。控一送。送同。本韻。鴇十九皓，叶補苟反。首二十五有。手、藪、阜並同。本韻。慢十六諫。罕十四旱，叶虚旰反。叶韻。掤十蒸。弓一東，叶姑宏反。叶韻。","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"标韵","excerpt":"馬二十一馬，叶滿補反。組七麌。舞同。藪二十五有，叶素苦反。舉六語。虎七麌。所六語。狃二十五有，叶女古反。女六語。叶韻。黄七陽。襄、行、揚並同。本韻。射二十一禡。御六御，叶魚駕反。叶韻。控一送。送同。本韻。鴇十九皓，叶補苟反。首二十五有。手、藪、阜並同。本韻。慢十六諫。罕十四旱，叶虚旰反。叶韻。掤十蒸。弓一東，叶姑宏反。叶韻。","fullText":"馬二十一馬，叶滿補反。組七麌。舞同。藪二十五有，叶素苦反。舉六語。虎七麌。所六語。狃二十五有，叶女古反。女六語。叶韻。黄七陽。襄、行、揚並同。本韻。射二十一禡。御六御，叶魚駕反。叶韻。控一送。送同。本韻。鴇十九皓，叶補苟反。首二十五有。手、藪、阜並同。本韻。慢十六諫。罕十四旱，叶虚旰反。叶韻。掤十蒸。弓一東，叶姑宏反。叶韻。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"maruichen-tongshi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/078-da-shu-yu-tian/maruichen-tongshi/0001-1","materialId":"maruichen-tongshi","materialTitle":"毛詩傳箋通釋","contributorLine":"清 · 馬瑞辰","publicationYear":1989,"layer":"span","layerLabel":"诗句片段","targetText":"戒其傷女","sourceLabel":"第 368 页","attributionLabel":"马瑞辰","sectionLabel":"按","excerpt":"傷女","fullText":"傷女","notes":null,"partOrder":1,"anchorIds":["seg-010:3-4:傷女"],"glossAnchorIds":["anchor-1-1"],"segmentIds":["seg-010"]},{"id":"quwanli-quanshi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/078-da-shu-yu-tian/quwanli-quanshi/0001-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"global","layerLabel":"全篇总说","targetText":"此亦美共叔段之詩。","sourceLabel":"第 94 页","attributionLabel":"屈万里","sectionLabel":"注釋","excerpt":"此亦美共叔段之詩。","fullText":"此亦美共叔段之詩。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"quwanli-quanshi:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/078-da-shu-yu-tian/quwanli-quanshi/0002-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"global","layerLabel":"全篇总说","targetText":"《釋文》云：“《叔于田》，本或作《大叔于田》者，誤。”按：兩《叔于田》相次，篇名無别，不便稱說。嚴粲以爲長篇者加“大”字以别之，其說是也。","sourceLabel":"第 94 页","attributionLabel":"屈万里","sectionLabel":"注釋","excerpt":"《釋文》云：“《叔于田》，本或作《大叔于田》者，誤。”按：兩《叔于田》相次，篇名無别，不便稱說。嚴粲以爲長篇者加“大”字以别之，其說是也。","fullText":"《釋文》云：“《叔于田》，本或作《大叔于田》者，誤。”按：兩《叔于田》相次，篇名無别，不便稱說。嚴粲以爲長篇者加“大”字以别之，其說是也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"quwanli-quanshi:0003-1:part-1","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/078-da-shu-yu-tian/quwanli-quanshi/0003-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"span","layerLabel":"诗句片段","targetText":"乘乘马乘乘黄乘乘鸨","sourceLabel":"第 94 页","attributionLabel":"屈万里","sectionLabel":"注釋","excerpt":"下乘字音剩，四馬也。","fullText":"下乘字音剩，四馬也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-002","seg-012","seg-022"]},{"id":"quwanli-quanshi:0004-1:part-1","annotationId":"0004","glossId":"0004-1","glossHref":"/shijing/gloss/078-da-shu-yu-tian/quwanli-quanshi/0004-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"span","layerLabel":"诗句片段","targetText":"执辔如组","sourceLabel":"第 94 页","attributionLabel":"屈万里","sectionLabel":"注釋","excerpt":"見《邶風•簡兮》。","fullText":"見《邶風•簡兮》。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-003"]},{"id":"quwanli-quanshi:0005-1:part-1","annotationId":"0005","glossId":"0005-1","glossHref":"/shijing/gloss/078-da-shu-yu-tian/quwanli-quanshi/0005-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"span","layerLabel":"诗句片段","targetText":"两服上襄两骖雁行两服齐首两骖如手","sourceLabel":"第 94 页","attributionLabel":"屈万里","sectionLabel":"注釋","excerpt":"古者一車四馬，中間夾轅之兩馬，謂之兩服；兩服外之兩馬，謂之兩驂。","fullText":"古者一車四馬，中間夾轅之兩馬，謂之兩服；兩服外之兩馬，謂之兩驂。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-013","seg-014","seg-023","seg-024"]},{"id":"quwanli-quanshi:0006-1:part-1","annotationId":"0006","glossId":"0006-1","glossHref":"/shijing/gloss/078-da-shu-yu-tian/quwanli-quanshi/0006-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"span","layerLabel":"诗句片段","targetText":"两骖如舞","sourceLabel":"第 94 页","attributionLabel":"屈万里","sectionLabel":"注釋","excerpt":"如舞，言行列整齊。","fullText":"如舞，言行列整齊。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-004"]},{"id":"quwanli-quanshi:0007-1:part-1","annotationId":"0007","glossId":"0007-1","glossHref":"/shijing/gloss/078-da-shu-yu-tian/quwanli-quanshi/0007-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"span","layerLabel":"诗句片段","targetText":"叔在薮叔在薮叔在薮","sourceLabel":"第 94 页","attributionLabel":"屈万里","sectionLabel":"注釋","excerpt":"藪，澤也，草叢生處。","fullText":"藪，澤也，草叢生處。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-005","seg-015","seg-025"]},{"id":"quwanli-quanshi:0008-1:part-1","annotationId":"0008","glossId":"0008-1","glossHref":"/shijing/gloss/078-da-shu-yu-tian/quwanli-quanshi/0008-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"span","layerLabel":"诗句片段","targetText":"火烈具举火烈具扬火烈具阜","sourceLabel":"第 94 页","attributionLabel":"屈万里","sectionLabel":"注釋","excerpt":"烈，猛火也。","fullText":"烈，猛火也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-006","seg-016","seg-026"]},{"id":"quwanli-quanshi:0009-1:part-1","annotationId":"0009","glossId":"0009-1","glossHref":"/shijing/gloss/078-da-shu-yu-tian/quwanli-quanshi/0009-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"span","layerLabel":"诗句片段","targetText":"火烈具举","sourceLabel":"第 94 页","attributionLabel":"屈万里","sectionLabel":"注釋","excerpt":"具，俱也。舉，起也。","fullText":"具，俱也。舉，起也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-006"]},{"id":"quwanli-quanshi:0010-1:part-1","annotationId":"0010","glossId":"0010-1","glossHref":"/shijing/gloss/078-da-shu-yu-tian/quwanli-quanshi/0010-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"span","layerLabel":"诗句片段","targetText":"袒裼暴虎","sourceLabel":"第 94 页","attributionLabel":"屈万里","sectionLabel":"注釋","excerpt":"襢，音但。裼，音錫。襢裼，裸露上身也。","fullText":"襢，音但。裼，音錫。襢裼，裸露上身也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-007"]},{"id":"quwanli-quanshi:0011-1:part-1","annotationId":"0011","glossId":"0011-1","glossHref":"/shijing/gloss/078-da-shu-yu-tian/quwanli-quanshi/0011-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"span","layerLabel":"诗句片段","targetText":"袒裼暴虎","sourceLabel":"第 94 页","attributionLabel":"屈万里","sectionLabel":"注釋","excerpt":"暴虎，徒手搏虎也。","fullText":"暴虎，徒手搏虎也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-007"]},{"id":"quwanli-quanshi:0012-1:part-1","annotationId":"0012","glossId":"0012-1","glossHref":"/shijing/gloss/078-da-shu-yu-tian/quwanli-quanshi/0012-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"span","layerLabel":"诗句片段","targetText":"献于公所","sourceLabel":"第 94 页","attributionLabel":"屈万里","sectionLabel":"注釋","excerpt":"公所，鄭莊公之所。","fullText":"公所，鄭莊公之所。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-008"]},{"id":"quwanli-quanshi:0013-1:part-1","annotationId":"0013","glossId":"0013-1","glossHref":"/shijing/gloss/078-da-shu-yu-tian/quwanli-quanshi/0013-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"span","layerLabel":"诗句片段","targetText":"将叔无狃","sourceLabel":"第 94 页","attributionLabel":"屈万里","sectionLabel":"注釋","excerpt":"狃，音扭，習慣也，謂屢爲之也。","fullText":"狃，音扭，習慣也，謂屢爲之也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-009"]},{"id":"quwanli-quanshi:0014-1:part-1","annotationId":"0014","glossId":"0014-1","glossHref":"/shijing/gloss/078-da-shu-yu-tian/quwanli-quanshi/0014-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"span","layerLabel":"诗句片段","targetText":"戒其伤女","sourceLabel":"第 94 页","attributionLabel":"屈万里","sectionLabel":"注釋","excerpt":"戒，防備也。","fullText":"戒，防備也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-010"]},{"id":"quwanli-quanshi:0015-1:part-1","annotationId":"0015","glossId":"0015-1","glossHref":"/shijing/gloss/078-da-shu-yu-tian/quwanli-quanshi/0015-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"span","layerLabel":"诗句片段","targetText":"乘乘黄","sourceLabel":"第 94 页","attributionLabel":"屈万里","sectionLabel":"注釋","excerpt":"乘黄，四馬皆黄色也。","fullText":"乘黄，四馬皆黄色也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-012"]},{"id":"quwanli-quanshi:0016-1:part-1","annotationId":"0016","glossId":"0016-1","glossHref":"/shijing/gloss/078-da-shu-yu-tian/quwanli-quanshi/0016-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"span","layerLabel":"诗句片段","targetText":"两服上襄两服齐首","sourceLabel":"第 95 页","attributionLabel":"屈万里","sectionLabel":"注釋","excerpt":"兩服，見注⑤。","fullText":"兩服，見注⑤。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-013","seg-023"]},{"id":"quwanli-quanshi:0017-1:part-1","annotationId":"0017","glossId":"0017-1","glossHref":"/shijing/gloss/078-da-shu-yu-tian/quwanli-quanshi/0017-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"span","layerLabel":"诗句片段","targetText":"两服上襄","sourceLabel":"第 95 页","attributionLabel":"屈万里","sectionLabel":"注釋","excerpt":"上，前也；襄，駕也。上襄，猶言前駕。謂服馬較驂馬稍前也。《經義述聞》說。","fullText":"上，前也；襄，駕也。上襄，猶言前駕。謂服馬較驂馬稍前也。《經義述聞》說。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-013"]},{"id":"quwanli-quanshi:0018-1:part-1","annotationId":"0018","glossId":"0018-1","glossHref":"/shijing/gloss/078-da-shu-yu-tian/quwanli-quanshi/0018-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"span","layerLabel":"诗句片段","targetText":"两骖雁行","sourceLabel":"第 95 页","attributionLabel":"屈万里","sectionLabel":"注釋","excerpt":"鴈行，謂兩驂在旁而稍後，如鴈之行列也。","fullText":"鴈行，謂兩驂在旁而稍後，如鴈之行列也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-014"]},{"id":"quwanli-quanshi:0019-1:part-1","annotationId":"0019","glossId":"0019-1","glossHref":"/shijing/gloss/078-da-shu-yu-tian/quwanli-quanshi/0019-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"span","layerLabel":"诗句片段","targetText":"火烈具扬","sourceLabel":"第 95 页","attributionLabel":"屈万里","sectionLabel":"注釋","excerpt":"揚，舉也。","fullText":"揚，舉也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-016"]},{"id":"quwanli-quanshi:0020-1:part-1","annotationId":"0020","glossId":"0020-1","glossHref":"/shijing/gloss/078-da-shu-yu-tian/quwanli-quanshi/0020-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"span","layerLabel":"诗句片段","targetText":"叔善射忌又良御忌抑磬控忌抑纵送忌叔马慢忌叔发罕忌抑释掤忌抑鬯弓忌","sourceLabel":"第 95 页","attributionLabel":"屈万里","sectionLabel":"注釋","excerpt":"忌，語助詞。","fullText":"忌，語助詞。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-017","seg-018","seg-019","seg-020","seg-027","seg-028","seg-029","seg-030"]},{"id":"quwanli-quanshi:0021-1:part-1","annotationId":"0021","glossId":"0021-1","glossHref":"/shijing/gloss/078-da-shu-yu-tian/quwanli-quanshi/0021-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"span","layerLabel":"诗句片段","targetText":"抑磬控忌抑纵送忌抑释掤忌抑鬯弓忌","sourceLabel":"第 95 页","attributionLabel":"屈万里","sectionLabel":"注釋","excerpt":"抑、噫古通，歎詞也。下同。","fullText":"抑、噫古通，歎詞也。下同。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-019","seg-020","seg-029","seg-030"]},{"id":"quwanli-quanshi:0022-1:part-1","annotationId":"0022","glossId":"0022-1","glossHref":"/shijing/gloss/078-da-shu-yu-tian/quwanli-quanshi/0022-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"span","layerLabel":"诗句片段","targetText":"抑磬控忌","sourceLabel":"第 95 页","attributionLabel":"屈万里","sectionLabel":"注釋","excerpt":"磬控，雙聲聯緜字，磬即控，言止馬也。","fullText":"磬控，雙聲聯緜字，磬即控，言止馬也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-019"]},{"id":"quwanli-quanshi:0023-1:part-1","annotationId":"0023","glossId":"0023-1","glossHref":"/shijing/gloss/078-da-shu-yu-tian/quwanli-quanshi/0023-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"span","layerLabel":"诗句片段","targetText":"抑纵送忌","sourceLabel":"第 95 页","attributionLabel":"屈万里","sectionLabel":"注釋","excerpt":"縱送，疊韵聯緜字，送即縱，言騁馬也。以上兩義，馬瑞辰、俞樾並有說。","fullText":"縱送，疊韵聯緜字，送即縱，言騁馬也。以上兩義，馬瑞辰、俞樾並有說。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-020"]},{"id":"quwanli-quanshi:0024-1:part-1","annotationId":"0024","glossId":"0024-1","glossHref":"/shijing/gloss/078-da-shu-yu-tian/quwanli-quanshi/0024-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"span","layerLabel":"诗句片段","targetText":"乘乘鸨","sourceLabel":"第 95 页","attributionLabel":"屈万里","sectionLabel":"注釋","excerpt":"鴇，音保，驪白雜毛之馬也。本字應作駂。","fullText":"鴇，音保，驪白雜毛之馬也。本字應作駂。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-022"]},{"id":"quwanli-quanshi:0025-1:part-1","annotationId":"0025","glossId":"0025-1","glossHref":"/shijing/gloss/078-da-shu-yu-tian/quwanli-quanshi/0025-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"span","layerLabel":"诗句片段","targetText":"两服齐首","sourceLabel":"第 95 页","attributionLabel":"屈万里","sectionLabel":"注釋","excerpt":"齊首，馬首齊也。","fullText":"齊首，馬首齊也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-023"]},{"id":"quwanli-quanshi:0026-1:part-1","annotationId":"0026","glossId":"0026-1","glossHref":"/shijing/gloss/078-da-shu-yu-tian/quwanli-quanshi/0026-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"span","layerLabel":"诗句片段","targetText":"两骖如手","sourceLabel":"第 95 页","attributionLabel":"屈万里","sectionLabel":"注釋","excerpt":"兩驂夾兩服，如兩手之夾身也。","fullText":"兩驂夾兩服，如兩手之夾身也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-024"]},{"id":"quwanli-quanshi:0027-1:part-1","annotationId":"0027","glossId":"0027-1","glossHref":"/shijing/gloss/078-da-shu-yu-tian/quwanli-quanshi/0027-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"span","layerLabel":"诗句片段","targetText":"火烈具阜","sourceLabel":"第 95 页","attributionLabel":"屈万里","sectionLabel":"注釋","excerpt":"阜，盛也。","fullText":"阜，盛也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-026"]},{"id":"quwanli-quanshi:0028-1:part-1","annotationId":"0028","glossId":"0028-1","glossHref":"/shijing/gloss/078-da-shu-yu-tian/quwanli-quanshi/0028-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"span","layerLabel":"诗句片段","targetText":"叔马慢忌叔发罕忌","sourceLabel":"第 95 页","attributionLabel":"屈万里","sectionLabel":"注釋","excerpt":"馬慢，射稀，言田獵將畢也。發，射也。","fullText":"馬慢，射稀，言田獵將畢也。發，射也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-027","seg-028"]},{"id":"quwanli-quanshi:0029-1:part-1","annotationId":"0029","glossId":"0029-1","glossHref":"/shijing/gloss/078-da-shu-yu-tian/quwanli-quanshi/0029-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"span","layerLabel":"诗句片段","targetText":"抑释掤忌","sourceLabel":"第 95 页","attributionLabel":"屈万里","sectionLabel":"注釋","excerpt":"掤，音冰，箭筩之蓋。釋，解也。射者腰佩箭筩，射畢則解之。","fullText":"掤，音冰，箭筩之蓋。釋，解也。射者腰佩箭筩，射畢則解之。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-029"]},{"id":"quwanli-quanshi:0030-1:part-1","annotationId":"0030","glossId":"0030-1","glossHref":"/shijing/gloss/078-da-shu-yu-tian/quwanli-quanshi/0030-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"span","layerLabel":"诗句片段","targetText":"抑鬯弓忌","sourceLabel":"第 95 页","attributionLabel":"屈万里","sectionLabel":"注釋","excerpt":"鬯，音暢，韔之假借字，弓囊也。此作動詞用，謂盛弓於韔也。","fullText":"鬯，音暢，韔之假借字，弓囊也。此作動詞用，謂盛弓於韔也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-030"]},{"id":"wangli-yundu:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/078-da-shu-yu-tian/wangli-yundu/0001-1","materialId":"wangli-yundu","materialTitle":"詩經韻讀","contributorLine":"现代 · 王力","publicationYear":1980,"layer":"span","layerLabel":"诗句片段","targetText":"叔于田，乘乘马。执辔如组，两骖如舞。叔在薮，火烈具举。袒裼暴虎，献于公所。将叔无狃，戒其伤女。","sourceLabel":"第 184 页","attributionLabel":"王力","sectionLabel":"韵读","excerpt":"叔于田，乘乘马(mea)。执辔如组(tza)，两骖如舞(miua)。叔在薮，火烈具举(kia)。袒裼暴虎(xa)，献于公所(shia)。将叔无狃，戒其伤女(njia)。（鱼部）","fullText":"叔于田，乘乘马(mea)。执辔如组(tza)，两骖如舞(miua)。叔在薮，火烈具举(kia)。袒裼暴虎(xa)，献于公所(shia)。将叔无狃，戒其伤女(njia)。（鱼部）","notes":"据页图转写，保留拟音与韵部。","partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010"]},{"id":"wangli-yundu:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/078-da-shu-yu-tian/wangli-yundu/0002-1","materialId":"wangli-yundu","materialTitle":"詩經韻讀","contributorLine":"现代 · 王力","publicationYear":1980,"layer":"span","layerLabel":"诗句片段","targetText":"叔于田，乘乘黄。两服上襄，两骖雁行。叔在薮，火烈具扬。叔善射忌，又良御忌。抑磬控忌，抑纵送忌。","sourceLabel":"第 184 页","attributionLabel":"王力","sectionLabel":"韵读","excerpt":"叔于田，乘乘黄(huang)。两服上襄(siang)，两骖雁行(hang)。叔在薮，火烈具扬(jiang)。（阳部）叔善射(dyak)忌，又良御(ngiak)忌。（铎部）抑磬控(khong)忌，抑纵送(song)忌。（东部）","fullText":"叔于田，乘乘黄(huang)。两服上襄(siang)，两骖雁行(hang)。叔在薮，火烈具扬(jiang)。（阳部）叔善射(dyak)忌，又良御(ngiak)忌。（铎部）抑磬控(khong)忌，抑纵送(song)忌。（东部）","notes":"据页图转写，保留拟音与韵部。","partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-011","seg-012","seg-013","seg-014","seg-015","seg-016","seg-017","seg-018","seg-019","seg-020"]},{"id":"wangli-yundu:0003-1:part-1","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/078-da-shu-yu-tian/wangli-yundu/0003-1","materialId":"wangli-yundu","materialTitle":"詩經韻讀","contributorLine":"现代 · 王力","publicationYear":1980,"layer":"span","layerLabel":"诗句片段","targetText":"叔于田，乘乘鸨。两服齐首，两骖如手。叔在薮，火烈具阜。叔马慢忌，叔发罕忌。抑释掤忌，抑鬯弓忌。","sourceLabel":"第 184 页","attributionLabel":"王力","sectionLabel":"韵读","excerpt":"叔于田，乘乘鸨(pu)。两服齐首(sjiu)，两骖如手(sjiu)。叔在薮，火烈具阜(biu)。（幽部）叔马慢(mean)忌，叔发罕(xan)忌。（元部）抑释掤(piong)忌，抑鬯弓(kiuong)忌。（蒸部）","fullText":"叔于田，乘乘鸨(pu)。两服齐首(sjiu)，两骖如手(sjiu)。叔在薮，火烈具阜(biu)。（幽部）叔马慢(mean)忌，叔发罕(xan)忌。（元部）抑释掤(piong)忌，抑鬯弓(kiuong)忌。（蒸部）","notes":"据页图转写，保留拟音与韵部。","partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-021","seg-022","seg-023","seg-024","seg-025","seg-026","seg-027","seg-028","seg-029","seg-030"]}]}}}
