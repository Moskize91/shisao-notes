,"charStart":1,"charEnd":3,"entryIds":["quwanli-quanshi:0001-1:part-1","wangli-yundu:0001-1:part-1"],"materialIds":["quwanli-quanshi","wangli-yundu"]},{"id":"seg-001:3-3:路","segmentId":"seg-001","segmentOrder":1,"surfaceText":"路","charStart":3,"charEnd":3,"entryIds":["wangli-yundu:0001-1:part-2"],"materialIds":["wangli-yundu"]},{"id":"seg-002:1-1:摻","segmentId":"seg-002","segmentOrder":2,"surfaceText":"摻","charStart":1,"charEnd":1,"entryIds":["quwanli-quanshi:0001-1:part-2"],"materialIds":["quwanli-quanshi"]},{"id":"seg-002:5-5:祛","segmentId":"seg-002","segmentOrder":2,"surfaceText":"祛","charStart":5,"charEnd":5,"entryIds":["wangli-yundu:0001-1:part-2"],"materialIds":["wangli-yundu"]},{"id":"seg-002:5-5:袪","segmentId":"seg-002","segmentOrder":2,"surfaceText":"袪","charStart":5,"charEnd":5,"entryIds":["quwanli-quanshi:0001-1:part-2"],"materialIds":["quwanli-quanshi"]},{"id":"seg-003:3-3:恶","segmentId":"seg-003","segmentOrder":3,"surfaceText":"恶","charStart":3,"charEnd":3,"entryIds":["wangli-yundu:0001-1:part-2"],"materialIds":["wangli-yundu"]},{"id":"seg-003:3-3:惡","segmentId":"seg-003","segmentOrder":3,"surfaceText":"惡","charStart":3,"charEnd":3,"entryIds":["quwanli-quanshi:0001-1:part-2"],"materialIds":["quwanli-quanshi"]},{"id":"seg-004:3-3:故","segmentId":"seg-004","segmentOrder":4,"surfaceText":"故","charStart":3,"charEnd":3,"entryIds":["wangli-yundu:0001-1:part-2"],"materialIds":["wangli-yundu"]},{"id":"seg-006:5-5:手","segmentId":"seg-006","segmentOrder":6,"surfaceText":"手","charStart":5,"charEnd":5,"entryIds":["wangli-yundu:0001-1:part-3"],"materialIds":["wangli-yundu"]},{"id":"seg-007:3-3:魗","segmentId":"seg-007","segmentOrder":7,"surfaceText":"魗","charStart":3,"charEnd":3,"entryIds":["quwanli-quanshi:0001-1:part-3","wangli-yundu:0001-1:part-3"],"materialIds":["quwanli-quanshi","wangli-yundu"]},{"id":"seg-008:1-4:不寁好也","segmentId":"seg-008","segmentOrder":8,"surfaceText":"不寁好也","charStart":1,"charEnd":4,"entryIds":["maruichen-tongshi:0001-1:part-1"],"materialIds":["maruichen-tongshi"]},{"id":"seg-008:3-3:好","segmentId":"seg-008","segmentOrder":8,"surfaceText":"好","charStart":3,"charEnd":3,"entryIds":["quwanli-quanshi:0001-1:part-3","wangli-yundu:0001-1:part-3"],"materialIds":["quwanli-quanshi","wangli-yundu"]}],"entries":[{"id":"chengjunying-jiangjianyuan-zhuxi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/081-zun-da-lu/chengjunying-jiangjianyuan-zhuxi/0001-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"遵大路兮，掺执子之祛兮。无我恶兮，不寁故也。遵大路兮，掺执子之手兮。无我魗兮，不寁好也。","sourceLabel":"第 181-182 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","excerpt":"这是一首弃妇的诗。文选宋玉登徒子好色赋：“遵大路兮揽子袪。”朱熹据此说：“亦男女相悦之辞。”这比毛序的“思君子”之说要实在得多。这一对男女可能不是正式的夫妻，但同居的时间比较长，所以诗中说“不寁故也（不要离开故人）”。他们平日可能争吵过，所以又说“无我恶兮”、“无我魗兮”。从这些诗句看来，诗确实反映了男子喜新厌旧、女子终被遗弃的悲剧。\n国风中写弃妇的诗甚多，而风格各不相同。如邶风柏舟的卑顺柔弱而忧思深结，邶风谷风的怨思虽深而犹存希冀，卫风氓的追悔不及而毅然决绝，塑造了几个同一遭遇而身份、性格不同的女性。这首诗与上述三诗又有区别，诗很简短，没有那些追忆往事、谴责负心的铺叙，只有可怜的求告，“执袪”、“执手”二句刻画一个哀告情急的女子，形象极为生动，章末二句祈求语更能引起读者的同情。因为诗短，倒留给我们不少想象的余地。读者不妨将此诗与野有蔓草对看，野有蔓草反映了“邂逅相遇”式的爱情的甜蜜，而此诗的作者似可说尝够了这种“邂逅”的苦涩。\n遵大路兮，掺执子之袪兮。无我恶兮，不寁故也。\n遵，循、沿着。\n掺，疑为“操”字之讹。说文：“操，把持也。”\n袪（qū），袖口。\n恶，厌恶。无我恶，即“无恶我”的倒文。\n寁（zǎn），很快地离去。马瑞辰通释：“寁字训速，速当读同孟子‘可以速则速’之速。赵注孟子：‘速，速去也。’速对久言，久为迟留，故知速为速去。”\n故，故人、老伴。\n韵读：鱼部——路、袪、恶、故。\n遵大路兮，掺执子之手兮。无我魗兮，不寁好也。\n魗，今作丑。孔疏：“魗与丑，古今字。”说文：“丑，可恶也。”\n好，相好。\n韵读：幽部——手、魗、好（呼受反）。","fullText":"这是一首弃妇的诗。文选宋玉登徒子好色赋：“遵大路兮揽子袪。”朱熹据此说：“亦男女相悦之辞。”这比毛序的“思君子”之说要实在得多。这一对男女可能不是正式的夫妻，但同居的时间比较长，所以诗中说“不寁故也（不要离开故人）”。他们平日可能争吵过，所以又说“无我恶兮”、“无我魗兮”。从这些诗句看来，诗确实反映了男子喜新厌旧、女子终被遗弃的悲剧。\n国风中写弃妇的诗甚多，而风格各不相同。如邶风柏舟的卑顺柔弱而忧思深结，邶风谷风的怨思虽深而犹存希冀，卫风氓的追悔不及而毅然决绝，塑造了几个同一遭遇而身份、性格不同的女性。这首诗与上述三诗又有区别，诗很简短，没有那些追忆往事、谴责负心的铺叙，只有可怜的求告，“执袪”、“执手”二句刻画一个哀告情急的女子，形象极为生动，章末二句祈求语更能引起读者的同情。因为诗短，倒留给我们不少想象的余地。读者不妨将此诗与野有蔓草对看，野有蔓草反映了“邂逅相遇”式的爱情的甜蜜，而此诗的作者似可说尝够了这种“邂逅”的苦涩。\n遵大路兮，掺执子之袪兮。无我恶兮，不寁故也。\n遵，循、沿着。\n掺，疑为“操”字之讹。说文：“操，把持也。”\n袪（qū），袖口。\n恶，厌恶。无我恶，即“无恶我”的倒文。\n寁（zǎn），很快地离去。马瑞辰通释：“寁字训速，速当读同孟子‘可以速则速’之速。赵注孟子：‘速，速去也。’速对久言，久为迟留，故知速为速去。”\n故，故人、老伴。\n韵读：鱼部——路、袪、恶、故。\n遵大路兮，掺执子之手兮。无我魗兮，不寁好也。\n魗，今作丑。孔疏：“魗与丑，古今字。”说文：“丑，可恶也。”\n好，相好。\n韵读：幽部——手、魗、好（呼受反）。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008"]},{"id":"chenhuan-chuanshu:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/081-zun-da-lu/chenhuan-chuanshu/0001-1","materialId":"chenhuan-chuanshu","materialTitle":"詩毛氏傳疏","contributorLine":"清 · 陳奐","publicationYear":1847,"layer":"span","layerLabel":"诗句片段","targetText":"遵大路兮，摻執子之袪兮。無我惡兮，不寁故也。遵大路兮，摻執子之手兮。無我魗兮，不寁好也。","sourceLabel":"第 91-92 页","attributionLabel":"陳奂","sectionLabel":"经文","excerpt":"遵大路兮，摻執子之袪兮。無我惡兮，不寁故也。遵大路兮，摻執子之手兮。無我魗兮，不寁好也。","fullText":"遵大路兮，摻執子之袪兮。無我惡兮，不寁故也。遵大路兮，摻執子之手兮。無我魗兮，不寁好也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008"]},{"id":"fangyurun-yuanshi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/081-zun-da-lu/fangyurun-yuanshi/0001-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"span","layerLabel":"诗句片段","targetText":"挽君子勿速行也。","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"题注","excerpt":"挽君子勿速行也。","fullText":"挽君子勿速行也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"fangyurun-yuanshi:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/081-zun-da-lu/fangyurun-yuanshi/0002-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"span","layerLabel":"诗句片段","targetText":"右《遵大路》二章，章四句。此詩當從《序》言爲正，《集傳》謂「淫婦爲人所棄」者固非，即姚氏以爲「故舊道左言情」者亦未是。蓋道左而挽留賢士，且殷殷動以故舊朋好之心，則豈無故而云然哉？吕氏祖謙曰：「武公之朝，蓋多君子矣。至於莊公，尚權謀，專武力，氣象一變。左右前後，無非祭仲、高渠彌、祝聃之徒也，君子安得不去乎？『不寁故也』，『不寁好也』，詩人豈徒勉君子遲遲其行也，感於事而懷其舊者亦深矣。」此雖無所據，而揆時度勢，據理言情，深得古風人意旨所在。不然，區區道故常情，何煩大聖人之删而存哉？又曹氏粹中曰：「申公、白生强起穆生曰『獨不念先王之德歟』，即此詩欲留君子之意。而詩不言念先王，但曰『無我惡』者，詞婉而意愈深耳。」嗚乎！可以觀世道矣。","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"总评","excerpt":"右《遵大路》二章，章四句。此詩當從《序》言爲正，《集傳》謂「淫婦爲人所棄」者固非，即姚氏以爲「故舊道左言情」者亦未是。蓋道左而挽留賢士，且殷殷動以故舊朋好之心，則豈無故而云然哉？吕氏祖謙曰：「武公之朝，蓋多君子矣。至於莊公，尚權謀，專武力，氣象一變。左右前後，無非祭仲、高渠彌、祝聃之徒也，君子安得不去乎？『不寁故也』，『不寁好也』，詩人豈徒勉君子遲遲其行也，感於事而懷其舊者亦深矣。」此雖無所據，而揆時度勢，據理言情，深得古風人意旨所在。不然，區區道故常情，何煩大聖人之删而存哉？又曹氏粹中曰：「申公、白生强起穆生曰『獨不念先王之德歟』，即此詩欲留君子之意。而詩不言念先王，但曰『無我惡』者，詞婉而意愈深耳。」嗚乎！可以觀世道矣。","fullText":"右《遵大路》二章，章四句。此詩當從《序》言爲正，《集傳》謂「淫婦爲人所棄」者固非，即姚氏以爲「故舊道左言情」者亦未是。蓋道左而挽留賢士，且殷殷動以故舊朋好之心，則豈無故而云然哉？吕氏祖謙曰：「武公之朝，蓋多君子矣。至於莊公，尚權謀，專武力，氣象一變。左右前後，無非祭仲、高渠彌、祝聃之徒也，君子安得不去乎？『不寁故也』，『不寁好也』，詩人豈徒勉君子遲遲其行也，感於事而懷其舊者亦深矣。」此雖無所據，而揆時度勢，據理言情，深得古風人意旨所在。不然，區區道故常情，何煩大聖人之删而存哉？又曹氏粹中曰：「申公、白生强起穆生曰『獨不念先王之德歟』，即此詩欲留君子之意。而詩不言念先王，但曰『無我惡』者，詞婉而意愈深耳。」嗚乎！可以觀世道矣。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"fangyurun-yuanshi:0003-1:part-1","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/081-zun-da-lu/fangyurun-yuanshi/0003-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"term","layerLabel":"字词注","targetText":"摻擥也。袪袂也。〔孔氏穎達曰〕袂是袪之本，袪是袂之末，俱是衣袖。寁速也。〔嚴氏粲曰〕猶言倉卒也。魗與醜同。","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"集释","excerpt":"摻擥也。袪袂也。〔孔氏穎達曰〕袂是袪之本，袪是袂之末，俱是衣袖。寁速也。〔嚴氏粲曰〕猶言倉卒也。魗與醜同。","fullText":"摻擥也。袪袂也。〔孔氏穎達曰〕袂是袪之本，袪是袂之末，俱是衣袖。寁速也。〔嚴氏粲曰〕猶言倉卒也。魗與醜同。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"fangyurun-yuanshi:0004-1:part-1","annotationId":"0004","glossId":"0004-1","glossHref":"/shijing/gloss/081-zun-da-lu/fangyurun-yuanshi/0004-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"term","layerLabel":"字词注","targetText":"袪六魚，叶起據反。惡七遇。故同。叶韻。手二十五有。魗同。好十九皓，叶許口反。叶韻。","sourceLabel":null,"attributionLabel":"方玉润","sect