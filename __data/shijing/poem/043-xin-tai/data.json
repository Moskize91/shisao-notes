tionId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/043-xin-tai/maoheng-zhushu-kr1c0004/0002-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"span","layerLabel":"诗句片段","targetText":"新臺有泚河水彌彌燕婉之求籧篨不鮮","sourceLabel":null,"attributionLabel":"毛传","sectionLabel":null,"excerpt":"箋云：鮮，善也。伋之妻，齊女，來嫁於衛。其心本求燕婉之人，謂伋也，反得籧篨不善，謂宣公也。籧篨口柔，常觀人顏色而為之辭，故不能俯也。","fullText":"泚，鮮明貌。彌彌，盛貌。水所以絜汙穢，反於河上而為淫昏之行。燕，安。婉，順也。籧篨，不能俯者。箋云：鮮，善也。伋之妻，齊女，來嫁於衛。其心本求燕婉之人，謂伋也，反得籧篨不善，謂宣公也。籧篨口柔，常觀人顏色而為之辭，故不能俯也。","notes":null,"partOrder":3,"anchorIds":["seg-004:4-4:鮮","seg-003:1-2:燕婉","seg-004:1-2:籧篨"],"glossAnchorIds":["anchor-3-1","anchor-3-2","anchor-3-3"],"segmentIds":["seg-001","seg-002","seg-003","seg-004"]},{"id":"maoheng-zhushu-kr1c0004:0003-1:part-1","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/043-xin-tai/maoheng-zhushu-kr1c0004/0003-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"span","layerLabel":"诗句片段","targetText":"新臺有灑河水浼浼燕婉之求籧篨不殄","sourceLabel":null,"attributionLabel":"毛传","sectionLabel":null,"excerpt":"灑，高峻也。浼浼，平地也。","fullText":"灑，高峻也。浼浼，平地也。殄，絕也。箋云：殄當作腆。腆，善也。","notes":null,"partOrder":1,"anchorIds":["seg-005:4-4:灑","seg-006:3-4:浼浼"],"glossAnchorIds":["anchor-1-1","anchor-1-2"],"segmentIds":["seg-005","seg-006","seg-007","seg-008"]},{"id":"maoheng-zhushu-kr1c0004:0003-1:part-2","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/043-xin-tai/maoheng-zhushu-kr1c0004/0003-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"span","layerLabel":"诗句片段","targetText":"新臺有灑河水浼浼燕婉之求籧篨不殄","sourceLabel":null,"attributionLabel":"毛传","sectionLabel":null,"excerpt":"殄，絕也。箋云：殄當作腆。腆，善也。","fullText":"灑，高峻也。浼浼，平地也。殄，絕也。箋云：殄當作腆。腆，善也。","notes":null,"partOrder":2,"anchorIds":["seg-008:4-4:殄"],"glossAnchorIds":["anchor-2-1"],"segmentIds":["seg-005","seg-006","seg-007","seg-008"]},{"id":"maoheng-zhushu-kr1c0004:0004-1:part-1","annotationId":"0004","glossId":"0004-1","glossHref":"/shijing/gloss/043-xin-tai/maoheng-zhushu-kr1c0004/0004-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"span","layerLabel":"诗句片段","targetText":"魚網之設鴻則離之燕婉之求得此戚施","sourceLabel":null,"attributionLabel":"毛传","sectionLabel":null,"excerpt":"言所得非所求也。箋云：設魚網者宜得魚，鴻乃鳥也，反離焉。猶齊女以禮來求世子，而得宣公。","fullText":"言所得非所求也。箋云：設魚網者宜得魚，鴻乃鳥也，反離焉。猶齊女以禮來求世子，而得宣公。戚施，不能仰者。箋云：戚施面柔，下人以色，故不能仰也。","notes":null,"partOrder":1,"anchorIds":["seg-009:1-2:魚網","seg-010:1-1:鴻","seg-010:3-3:離","seg-011:4-4:求","seg-012:1-1:得"],"glossAnchorIds":["anchor-1-1","anchor-1-2","anchor-1-3","anchor-1-4","anchor-1-5"],"segmentIds":["seg-009","seg-010","seg-011","seg-012"]},{"id":"maoheng-zhushu-kr1c0004:0004-1:part-2","annotationId":"0004","glossId":"0004-1","glossHref":"/shijing/gloss/043-xin-tai/maoheng-zhushu-kr1c0004/0004-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"span","layerLabel":"诗句片段","targetText":"魚網之設鴻則離之燕婉之求得此戚施","sourceLabel":null,"attributionLabel":"毛传","sectionLabel":null,"excerpt":"戚施，不能仰者。箋云：戚施面柔，下人以色，故不能仰也。","fullText":"言所得非所求也。箋云：設魚網者宜得魚，鴻乃鳥也，反離焉。猶齊女以禮來求世子，而得宣公。戚施，不能仰者。箋云：戚施面柔，下人以色，故不能仰也。","notes":null,"partOrder":2,"anchorIds":["seg-012:3-4:戚施"],"glossAnchorIds":["anchor-2-1"],"segmentIds":["seg-009","seg-010","seg-011","seg-012"]},{"id":"quwanli-quanshi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/043-xin-tai/quwanli-quanshi/0001-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"global","layerLabel":"全篇总说","targetText":"《詩序》：“《新臺》，刺衛宣公也。納伋之妻，作新臺于河上而要之。國人惡之，而作是詩也。”按：宣公名晉，桓公弟。伋，宣公子。所納伋之妻，即宣姜也。","sourceLabel":"第 52 页","attributionLabel":"屈万里","sectionLabel":"注释","excerpt":"《詩序》：“《新臺》，刺衛宣公也。納伋之妻，作新臺于河上而要之。國人惡之，而作是詩也。”按：宣公名晉，桓公弟。伋，宣公子。所納伋之妻，即宣姜也。","fullText":"《詩序》：“《新臺》，刺衛宣公也。納伋之妻，作新臺于河上而要之。國人惡之，而作是詩也。”按：宣公名晉，桓公弟。伋，宣公子。所納伋之妻，即宣姜也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"quwanli-quanshi:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/043-xin-tai/quwanli-quanshi/0002-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"term","layerLabel":"字词注","targetText":"新臺有泚，河水瀰瀰。燕婉之求，籧篨不鮮。新臺有洒，河水浼浼。燕婉之求，籧篨不殄。魚網之設，鴻則離之。燕婉之求，得此戚施。","sourceLabel":"第 52 页","attributionLabel":"屈万里","sectionLabel":"注释","excerpt":"屈万里释“泚”为鮮明貌（《說文》作玼），“瀰瀰”为水滿。","fullText":"屈万里释“泚”为鮮明貌（《說文》作玼），“瀰瀰”为水滿。又释“燕婉”为美色，“籧篨”为不能俯之醜疾，并以“不鮮”言其丑而不早死。次章释“洒”为高峻，“浼浼”见《韓詩》作浘浘，“不殄”犹不死。末章释“離”为罹，“戚施”为不能仰之醜疾，归结此诗为“求美偶而反得丑夫”的讽刺。","notes":null,"partOrder":1,"anchorIds":["seg-001:4-4:泚","seg-002:3-4:瀰瀰"],"glossAnchorIds":["anchor-1-1","anchor-1-2"],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012"]},{"id":"quwanli-quanshi:0002-1:part-2","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/043-xin-tai/quwanli-quanshi/0002-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"term","layerLabel":"字词注","targetText":"新臺有泚，河水瀰瀰。燕婉之求，籧篨不鮮。新臺有洒，河水浼浼。燕婉之求，籧篨不殄。魚網之設，鴻則離之。燕婉之求，得此戚施。","sourceLabel":"第 52 页","attributionLabel":"屈万里","sectionLabel":"注释","excerpt":"又释“燕婉”为美色，“籧篨”为不能俯之醜疾，并以“不鮮”言其丑而不早死。","fullText":"屈万里释“泚”为鮮明貌（《說文》作玼），“瀰瀰”为水滿。又释“燕婉”为美色，“籧篨”为不能俯之醜疾，并以“不鮮”言其丑而不早死。次章释“洒”为高峻，“浼浼”见《韓詩》作浘浘，“不殄”犹不死。末章释“離”为罹，“戚施”为不能仰之醜疾，归结此诗为“求美偶而反得丑夫”的讽刺。","notes":null,"partOrder":2,"anchorIds":["seg-003:1-2:燕婉","seg-004:1-2:籧篨","seg-004:3-4:不鮮"],"glossAnchorIds":["anchor-2-1","anchor-2-2","anchor-2-3"],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011",