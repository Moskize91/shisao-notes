huan-kr1c0009"]},{"id":"seg-010:3-3:离","segmentId":"seg-010","segmentOrder":10,"surfaceText":"离","charStart":3,"charEnd":3,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0004-1:part-1"],"materialIds":["chengjunying-jiangjianyuan-zhuxi"]},{"id":"seg-010:3-3:離","segmentId":"seg-010","segmentOrder":10,"surfaceText":"離","charStart":3,"charEnd":3,"entryIds":["maoheng-zhushu-kr1c0004:0004-1:part-1","quwanli-quanshi:0002-1:part-4","zhuxi-shijichuan-kr1c0009:0003-1:part-1"],"materialIds":["maoheng-zhushu-kr1c0004","quwanli-quanshi","zhuxi-shijichuan-kr1c0009"]},{"id":"seg-011:1-2:燕婉","segmentId":"seg-011","segmentOrder":11,"surfaceText":"燕婉","charStart":1,"charEnd":2,"entryIds":["zhuxi-shijichuan-kr1c0009:0003-1:part-2"],"materialIds":["zhuxi-shijichuan-kr1c0009"]},{"id":"seg-011:4-4:求","segmentId":"seg-011","segmentOrder":11,"surfaceText":"求","charStart":4,"charEnd":4,"entryIds":["maoheng-zhushu-kr1c0004:0004-1:part-1"],"materialIds":["maoheng-zhushu-kr1c0004"]},{"id":"seg-012:1-1:得","segmentId":"seg-012","segmentOrder":12,"surfaceText":"得","charStart":1,"charEnd":1,"entryIds":["maoheng-zhushu-kr1c0004:0004-1:part-1"],"materialIds":["maoheng-zhushu-kr1c0004"]},{"id":"seg-012:3-4:戚施","segmentId":"seg-012","segmentOrder":12,"surfaceText":"戚施","charStart":3,"charEnd":4,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0004-1:part-2","maoheng-zhushu-kr1c0004:0004-1:part-2","quwanli-quanshi:0002-1:part-4","zhuxi-shijichuan-kr1c0009:0003-1:part-1"],"materialIds":["chengjunying-jiangjianyuan-zhuxi","maoheng-zhushu-kr1c0004","quwanli-quanshi","zhuxi-shijichuan-kr1c0009"]}],"entries":[{"id":"chengjunying-jiangjianyuan-zhuxi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/043-xin-tai/chengjunying-jiangjianyuan-zhuxi/0001-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"preface","layerLabel":"篇序","targetText":"题解","sourceLabel":"第 91 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","excerpt":"这是人民讽刺卫宣公劫夺儿媳的诗。《毛序》:“刺卫宣公也。纳伋之妻，作新台于河上而要之，国人恶之而作是诗也。”《左传》桓公十六年:“卫宣公烝于夷姜，生急子，为之取（娶）于齐而美，公取之。”司马迁《史记·卫世家》亦有同样的记载。历来学者根据这些史料，都认为这是讽刺卫宣公乱伦，同情齐女所得非所求的诗，细析诗的内容，大概是不错的。黑格尔说:“一种高尚的精神和道德的情操无法在一个罪恶和愚蠢的世界里实现它的自觉的理想，于是带着一腔火热的愤怒或是微妙的巧智和冷酷辛辣的语调去反对当前的事物，对和他的关于道德与真理的抽象概念起直接冲突的那个世界不是痛恨，就是鄙视。”“以描绘这种有限的主体与腐化堕落的外在世界之间矛盾为任务的艺术形式就是讽刺。”（《美学》第二卷）在这首诗中，作者即通过对“燕婉之求”与“得此戚施”这一对矛盾的揭示，用辛辣的语言、不平的口吻，鞭挞了人世“籧篨”的卑劣行径，反映了一个美好愿望的可悲的破灭，表现了理想和现实的冲突，自身和丑恶现象不能兼容的愤怒心情，对邪恶的事物起了揭露、讥刺的作用。前人说一部诗经，诸体皆备。如这首诗，已开我国古代讽刺诗的先声。","fullText":"这是人民讽刺卫宣公劫夺儿媳的诗。《毛序》:“刺卫宣公也。纳伋之妻，作新台于河上而要之，国人恶之而作是诗也。”《左传》桓公十六年:“卫宣公烝于夷姜，生急子，为之取（娶）于齐而美，公取之。”司马迁《史记·卫世家》亦有同样的记载。历来学者根据这些史料，都认为这是讽刺卫宣公乱伦，同情齐女所得非所求的诗，细析诗的内容，大概是不错的。黑格尔说:“一种高尚的精神和道德的情操无法在一个罪恶和愚蠢的世界里实现它的自觉的理想，于是带着一腔火热的愤怒或是微妙的巧智和冷酷辛辣的语调去反对当前的事物，对和他的关于道德与真理的抽象概念起直接冲突的那个世界不是痛恨，就是鄙视。”“以描绘这种有限的主体与腐化堕落的外在世界之间矛盾为任务的艺术形式就是讽刺。”（《美学》第二卷）在这首诗中，作者即通过对“燕婉之求”与“得此戚施”这一对矛盾的揭示，用辛辣的语言、不平的口吻，鞭挞了人世“籧篨”的卑劣行径，反映了一个美好愿望的可悲的破灭，表现了理想和现实的冲突，自身和丑恶现象不能兼容的愤怒心情，对邪恶的事物起了揭露、讥刺的作用。前人说一部诗经，诸体皆备。如这首诗，已开我国古代讽刺诗的先声。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"chengjunying-jiangjianyuan-zhuxi:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/043-xin-tai/chengjunying-jiangjianyuan-zhuxi/0002-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"新台有泚，河水瀰瀰。燕婉之求，籧篨不鲜！","sourceLabel":"第 91-92 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","excerpt":"新台，台名。筑在水上的房子称为台。新台旧址在今河南临漳西黄河旁。泚（cǐ），玼的假借字。《说文》:“玼，玉色鲜也。诗曰:新台有玼。”段注:“《说文》‘玉’上当有‘新’字。玼本新玉色，引申为凡新色。如诗‘玼兮玼兮’，言衣之鲜盛；‘新台有玼’，言台之鲜明。”有泚，等于泚泚，形容新台新而鲜明貌。瀰，重瀰。瀰瀰，水盛貌。按瀰的本字作濔，远注:“濔，水满也。”张参《五经文字》云:“濔见《诗·邶风》。”即指此句。满盖后人增益字。","fullText":"新台，台名。筑在水上的房子称为台。新台旧址在今河南临漳西黄河旁。泚（cǐ），玼的假借字。《说文》:“玼，玉色鲜也。诗曰:新台有玼。”段注:“《说文》‘玉’上当有‘新’字。玼本新玉色，引申为凡新色。如诗‘玼兮玼兮’，言衣之鲜盛；‘新台有玼’，言台之鲜明。”有泚，等于泚泚，形容新台新而鲜明貌。瀰，重瀰。瀰瀰，水盛貌。按瀰的本字作濔，远注:“濔，水满也。”张参《五经文字》云:“濔见《诗·邶风》。”即指此句。满盖后人增益字。燕婉，亦作宴婉或嬿婉，安和美好貌。这句意为，本来想求得个好配偶。籧篨（qú chú），蟾蜍、癞虾蟆一类的东西（见闻一多全集《天问释天》）。马瑞辰认为籧篨和下文的“戚施”都是“丑恶之通称”，亦通。鲜，《尔雅·释诂》:“鲜，善也。”郑笺:“伋之妻齐女来嫁于卫，其心本求燕婉之人，谓伋也。反得籧篨不善，谓宣公也。”韵读:脂、元部借韵一一泚、瀰、鲜。","notes":null,"partOrder":1,"anchorIds":["seg-001:4-4:泚","seg-002:3-4:瀰瀰"],"glossAnchorIds":["anchor-1-1","anchor-1-2"],"segmentIds":["seg-001","seg-002","seg-003","seg-004"]},{"id":"chengjunying-jiangjianyuan-zhuxi:0002-1:part-2","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/043-xin-tai/chengjunying-jiangjianyuan-zhuxi/0002-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"新台有泚，河水瀰瀰。燕婉之求，籧篨不鲜！","sourceLabel":"第 91-92 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","excerpt":"燕婉，亦作宴婉或嬿婉，安和美好貌。这句意为，本来想求得个好配偶。籧篨（qú chú），蟾蜍、癞虾蟆一类的东西（见闻一多全集《天问释天》）。马瑞辰认为籧篨和下文的“戚施”都是“丑恶之通称”，亦通。鲜，《尔雅·释诂》:“鲜，善也。”郑笺:“伋之妻齐女来嫁于卫，其心本求燕婉之人，谓伋也。反得籧篨不善，谓宣公也。”韵读:脂、元部借韵一一泚、瀰、鲜。","fullText":"新台，台名。筑在水上的房子称为台。新台旧址在今河南临漳西黄河旁。泚（cǐ），玼的假借字。《说文》:“玼，玉色鲜也。诗曰:新台有玼。”段注:“《说文》‘玉’上当有‘新’字。玼本新玉色，引申为凡新色。如诗‘玼兮玼兮’，言衣之鲜盛；‘新台有玼’，言台之鲜明。”有泚，等于泚泚，形容新台新而鲜明貌。瀰，重瀰。瀰瀰，水盛貌。按瀰的本字作濔，远注:“濔，水满也。”张参《五经文字》云:“濔见《诗·邶风》。”即指此句。满盖后人增益字。燕婉，亦作宴婉或嬿婉，安和美好貌。这句意为，本来想求得个好配偶。籧篨（qú chú），蟾蜍、癞虾蟆一类的东西（见闻一多全集《天问释天》）。马瑞辰认为籧篨和下文的“戚施”都是“丑恶之通称”，亦通。鲜，《尔雅·释诂》:“鲜，善也。”郑笺:“伋之妻齐女来嫁于卫，其心本求燕婉之人，谓伋也。反得籧篨不善，谓宣公也。”韵读:脂、元部借韵一一泚、瀰、鲜。","notes":null,"partOrder":2,"anchorIds":["seg-003:1-2:燕婉","seg-004:1-2:籧篨","seg-004:4-4:鲜"],"glossAnchorIds":["anchor-2-1","anchor-2-2","anchor-2-3"],"segmentIds":["seg-001","seg-002","seg-003","seg-004"]},{"id":"chengjunying-jiangjianyuan-zhuxi:0003-1:part-1","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/043-xin-tai/chengjunying-jiangjianyuan-zhuxi/0003-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"新台有洒，河水浼浼。燕婉之求，籧篨不殄！","sourceLabel":"第 92 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","excerpt":"洒（cuǐ），高峻貌。有洒，即洒洒。韩诗洒作泚，云:“鲜貌。”亦可通。浼浼（měi měi），水平缓貌。韩诗作沬沬，音尾，云:“盛貌。”亦可通。殄（tiǎn），同腆，善。郑笺:“殄当作腆。腆，善也。”韵读:文、元部通韵一一洒（音眦）、浼（音免）、殄。","fullText":"洒（cuǐ），高峻貌。有洒，即洒洒。韩诗洒作泚，云:“鲜貌。”亦可通。浼浼（měi měi），水平缓貌。韩诗作沬沬，音尾，云:“盛貌。”亦可通。殄（tiǎn），同腆，善。郑笺:“殄当作腆。腆，善也。”韵读:文、元部通韵一一洒（音眦）、浼（音免）、殄。","notes":null,"partOrder":1,"anchorIds":["seg-005:4-4:洒","seg-006:3-4:浼浼","seg-008:4-4:殄"],"glossAnchorIds":["anchor-1-1","anchor-1-2","anchor-1-3"],"segmentIds":["seg-005","seg-006","seg-007","seg-008"]},{"id":"chengjunying-jiangjianyuan-zhuxi:0004-1:part-1","annotationId":"0004","glossId":"0004-1","glossHref":"/shijing/gloss/043-xin-tai/chengjunying-jiangjianyuan-zhuxi/0004-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"鱼网之设，鸿则离之。燕婉之求，得此戚施。","sourceLabel":"第 92 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","excerpt":"鸿，旧解为鸟名，雁之大者。闻一多在《诗新台鸿字说》一文中，考证鸿就是虾蟆。离（lí），附着、获得。王先谦《集疏》:“《易序卦传》:‘离者，丽也。’附着之义。”鱼网所以求鱼，今反得鸿，此所谓所得非所求也。求即经“燕婉之求”，以喻齐女求伋而得宣公也。","fullText":"鸿，旧解为鸟名，雁之大者。闻一多在《诗新台鸿字说》一文中，考证鸿就是虾蟆。离（lí），附着、获得。王先谦《集疏》:“《易序卦传》:‘离者，丽也。’附着之义。”鱼网所以求鱼，今反得鸿，此所谓所得非所求也。求即经“燕婉之求”，以喻齐女求伋而得宣公也。戚施，虾蟆。太平御览虫豸部引薛君章句云:“戚施蟾蜍，喻丑恶。”按蟾蜍即癞虾蟆，可能就是俗语所谓“癞虾蟆想吃天鹅肉”的癞虾蟆。韵读:歌部一一离（音罗）、施（音姿）。","notes":null,"partOrder":1,"anchorIds":["seg-010:1-1:鸿","seg-010:3-3:离"],"glossAnchorIds":["anchor-1-1","anchor-1-2"],"segmentIds":["seg-009","seg-010","seg-011","seg-012"]},{"id":"chengjunying-jiangjianyuan-zhuxi:0004-1:part-2","annotationId":"0004","glossId":"0004-1","glossHref":"/shijing/gloss/043-xin-tai/chengjunying-jiangjianyuan-zhuxi/0004-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"鱼网之设，鸿则离之。燕婉之求，得此戚施。","sourceLabel":"第 92 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"章解","excerpt":"戚施，虾蟆。太平御览虫豸部引薛君章句云:“戚施蟾蜍，喻丑恶。”按蟾蜍即癞虾蟆，可能就是俗语所谓“癞虾蟆想吃天鹅肉”的癞虾蟆。韵读:歌部一一离（音罗）、施（音姿）。","fullText":"鸿，旧解为鸟名，雁之大者。闻一多在《诗新台鸿字说》一文中，考证鸿就是虾蟆。离（lí），附着、获得。王先谦《集疏》:“《易序卦传》:‘离者，丽也。’附着之义。”鱼网所以求鱼，今反得鸿，此所谓所得非所求也。求即经“燕婉之求”，以喻齐女求伋而得宣公也。戚施，虾蟆。太平御览虫豸部引薛君章句云:“戚施蟾蜍，喻丑恶。”按蟾蜍即癞虾蟆，可能就是俗语所谓“癞虾蟆想吃天鹅肉”的癞虾蟆。韵读:歌部一一离（音罗）、施（音姿）。","notes":null,"partOrder":2,"anchorIds":["seg-012:3-4:戚施"],"glossAnchorIds":["anchor-2-1"],"segmentIds":["seg-009","seg-010","seg-011","seg-012"]},{"id":"fangyurun-yuanshi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/043-xin-tai/fangyurun-yuanshi/0001-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"global","layerLabel":"全篇总说","targetText":"新臺㊟刺齊女之從衛宣公也。","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"题注","excerpt":"新臺㊟刺齊女之從衛宣公也。","fullText":"新臺㊟刺齊女之從衛宣公也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"fangyurun-yuanshi:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/043-xin-tai/fangyurun-yuanshi/0002-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"global","layerLabel":"全篇总说","targetText":"右《新臺》三章，章四句。《小序》云：「刺衛宣公也。」《大序》謂：「納伋之妻，作新臺於河上而要之。國人惡之，而作是詩。」事見《春秋傳》，固無可疑。而《集傳》既引其説，又以爲於詩未有考，不知何意。愚謂此刺宣姜之作，非但宣公也。《静女》篇以刺宣公爲主，而帶及夫人。此篇以刺夫人爲主，而愈醜宣公。何也？婦人從一而終，不可改行易節，宣姜豈未之聞歟？當其初聘，本爲伋也妻，迨至新臺，乃爲伋也母。此稍有廉恥者所不忍聞，尚腼然立於人世乎？使其執意不從，宣公雖暴，亦無如何。而乃柔情懦志，將順其惡，以至逆理亂倫，爲千古笑。雖曰非其本意，亦豈能辭咎哉？故國人明指其臺與地，直刺厥非。曰：此非新臺乎？何其明且峻也。其下河水瀰瀰，互相罨映，又得佳麗鎖貯其中，則山川尤爲生色。即此臺中人亦覺燕婉可遂，而豈知其得此醜疾人乎？夫此醜疾之人，其俯仰固不足以對人，而爾夫人國色無雙，亦甘心遺臭，能無有媿於中？所謂「魚網之設，鴻則離之」，所得非所求，醜亦甚矣。吾恐河水雖盛，難洗君羞。千載下有從新臺過者，猶將掩鼻而去之也。詩人之意如此。蓋惡之之甚，故亦不暇爲之隱約其辭矣。","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"总评","excerpt":"右《新臺》三章，章四句。《小序》云：「刺衛宣公也。」《大序》謂：「納伋之妻，作新臺於河上而要之。國人惡之，而作是詩。」事見《春秋傳》，固無可疑。而《集傳》既引其説，又以爲於詩未有考，不知何意。愚謂此刺宣姜之作，非但宣公也。《静女》篇以刺宣公爲主，而帶及夫人。此篇以刺夫人爲主，而愈醜宣公。何也？婦人從一而終，不可改行易節，宣姜豈未之聞歟？當其初聘，本爲伋也妻，迨至新臺，乃爲伋也母。此稍有廉恥者所不忍聞，尚腼然立於人世乎？使其執意不從，宣公雖暴，亦無如何。而乃柔情懦志，將順其惡，以至逆理亂倫，爲千古笑。雖曰非其本意，亦豈能辭咎哉？故國人明指其臺與地，直刺厥非。曰：此非新臺乎？何其明且峻也。其下河水瀰瀰，互相罨映，又得佳麗鎖貯其中，則山川尤爲生色。即此臺中人亦覺燕婉可遂，而豈知其得此醜疾人乎？夫此醜疾之人，其俯仰固不足以對人，而爾夫人國色無雙，亦甘心遺臭，能無有媿於中？所謂「魚網之設，鴻則離之」，所得非所求，醜亦甚矣。吾恐河水雖盛，難洗君羞。千載下有從新臺過者，猶將掩鼻而去之也。詩人之意如此。蓋惡之之甚，故亦不暇爲之隱約其辭矣。","fullText":"右《新臺》三章，章四句。《小序》云：「刺衛宣公也。」《大序》謂：「納伋之妻，作新臺於河上而要之。國人惡之，而作是詩。」事見《春秋傳》，固無可疑。而《集傳》既引其説，又以爲於詩未有考，不知何意。愚謂此刺宣姜之作，非但宣公也。《静女》篇以刺宣公爲主，而帶及夫人。此篇以刺夫人爲主，而愈醜宣公。何也？婦人從一而終，不可改行易節，宣姜豈未之聞歟？當其初聘，本爲伋也妻，迨至新臺，乃爲伋也母。此稍有廉恥者所不忍聞，尚腼然立於人世乎？使其執意不從，宣公雖暴，亦無如何。而乃柔情懦志，將順其惡，以至逆理亂倫，爲千古笑。雖曰非其本意，亦豈能辭咎哉？故國人明指其臺與地，直刺厥非。曰：此非新臺乎？何其明且峻也。其下河水瀰瀰，互相罨映，又得佳麗鎖貯其中，則山川尤爲生色。即此臺中人亦覺燕婉可遂，而豈知其得此醜疾人乎？夫此醜疾之人，其俯仰固不足以對人，而爾夫人國色無雙，亦甘心遺臭，能無有媿於中？所謂「魚網之設，鴻則離之」，所得非所求，醜亦甚矣。吾恐河水雖盛，難洗君羞。千載下有從新臺過者，猶將掩鼻而去之也。詩人之意如此。蓋惡之之甚，故亦不暇爲之隱約其辭矣。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"fangyurun-yuanshi:0003-1:part-1","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/043-xin-tai/fangyurun-yuanshi/0003-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"global","layerLabel":"全篇总说","targetText":"眉評談笑而道之。","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"眉评","excerpt":"眉評談笑而道之。","fullText":"眉評談笑而道之。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"fangyurun-yuanshi:0004-1:part-1","annotationId":"0004","glossId":"0004-1","glossHref":"/shijing/gloss/043-xin-tai/fangyurun-yuanshi/0004-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"term","layerLabel":"字词注","targetText":"集釋新臺説見前。〔《爾雅》〕四方而高曰臺。泚〔劉氏彝曰〕泚，水中臺影鮮明之貌。瀰瀰盛也。燕安也。婉順也。籧篨疾之醜者也。本竹席名，編以爲囷狀，如人之擁腫而不能俯，故又以名疾也。鮮〔鄭氏康成曰〕鮮，善也。洒高峻也。〔陸氏德明曰〕洒，《韓詩》作漼，鮮貌。浼浼平也。〔陸氏曰〕浼，《韓詩》作浘。浘，盛貌。殄〔鄭氏康成曰〕殄，當作腆。腆，善也。〔孔氏穎達曰〕腆與殄古今字之異，故《儀禮》注云：「腆，古文字作殄。」是也。鴻雁之大者。離麗也。戚施亦醜疾名。《晉語》云：「籧篨不可使俯，戚施不可使仰。」〔歐陽氏脩曰〕籧篨，偃人，不可使俛。戚施，僂人，不可使仰。明其俯仰有媿云耳。","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"集释","excerpt":"集釋新臺説見前。〔《爾雅》〕四方而高曰臺。泚〔劉氏彝曰〕泚，水中臺影鮮明之