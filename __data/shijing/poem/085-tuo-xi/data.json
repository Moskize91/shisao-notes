:"/shijing/gloss/085-tuo-xi/wangli-yundu/0001-1","materialId":"wangli-yundu","materialTitle":"詩經韻讀","contributorLine":"现代 · 王力","publicationYear":1980,"layer":"span","layerLabel":"诗句片段","targetText":"箨兮箨兮，风其吹女。叔兮伯兮，倡予和女。","sourceLabel":"第 188 页","attributionLabel":"王力","sectionLabel":"韵读","excerpt":"箨(thak)兮，箨(thak)兮！（与“伯”协）风其吹(thjiuai)女。叔兮伯(peak)兮。（铎部）倡予和(huai)女。（歌部）","fullText":"箨(thak)兮，箨(thak)兮！（与“伯”协）风其吹(thjiuai)女。叔兮伯(peak)兮。（铎部）倡予和(huai)女。（歌部）","notes":"据页图转写，保留拟音与韵部。","partOrder":1,"anchorIds":["seg-001:1-1:箨","seg-001:3-3:箨","seg-002:3-3:吹","seg-003:3-3:伯","seg-004:3-3:和"],"glossAnchorIds":["anchor-1-1","anchor-1-2","anchor-1-3","anchor-1-4","anchor-1-5"],"segmentIds":["seg-001","seg-002","seg-003","seg-004"]},{"id":"wangli-yundu:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/085-tuo-xi/wangli-yundu/0002-1","materialId":"wangli-yundu","materialTitle":"詩經韻讀","contributorLine":"现代 · 王力","publicationYear":1980,"layer":"span","layerLabel":"诗句片段","targetText":"箨兮箨兮，风其漂女。叔兮伯兮，倡予要女。","sourceLabel":"第 188 页","attributionLabel":"王力","sectionLabel":"韵读","excerpt":"箨(thak)兮，箨(thak)兮！（与“伯”协）风其漂(phio)女。叔兮伯(peak)兮。（铎部）倡予要(io)女。（宵部）","fullText":"箨(thak)兮，箨(thak)兮！（与“伯”协）风其漂(phio)女。叔兮伯(peak)兮。（铎部）倡予要(io)女。（宵部）","notes":"据页图转写，保留拟音与韵部。","partOrder":1,"anchorIds":["seg-005:1-1:箨","seg-005:3-3:箨","seg-006:3-3:漂","seg-007:3-3:伯","seg-008:3-3:要"],"glossAnchorIds":["anchor-1-1","anchor-1-2","anchor-1-3","anchor-1-4","anchor-1-5"],"segmentIds":["seg-005","seg-006","seg-007","seg-008"]}]}}}
