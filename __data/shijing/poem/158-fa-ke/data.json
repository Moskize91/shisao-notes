-yuanshi:0003-1:part-1","quwanli-quanshi:0001-1:part-2","wangli-yundu:0001-1:part-2"],"materialIds":["chenhuan-chuanshu","fangyurun-yuanshi","quwanli-quanshi","wangli-yundu"]},{"id":"seg-006:2-2:則","segmentId":"seg-006","segmentOrder":6,"surfaceText":"則","charStart":2,"charEnd":2,"entryIds":["maruichen-tongshi:0002-1:part-1"],"materialIds":["maruichen-tongshi"]},{"id":"seg-007:1-4:我觏之子","segmentId":"seg-007","segmentOrder":7,"surfaceText":"我觏之子","charStart":1,"charEnd":4,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-2"],"materialIds":["chengjunying-jiangjianyuan-zhuxi"]},{"id":"seg-007:1-4:我覯之子","segmentId":"seg-007","segmentOrder":7,"surfaceText":"我覯之子","charStart":1,"charEnd":4,"entryIds":["chenhuan-chuanshu:0001-1:part-2","fangyurun-yuanshi:0003-1:part-2","quwanli-quanshi:0001-1:part-2","wangli-yundu:0001-1:part-2"],"materialIds":["chenhuan-chuanshu","fangyurun-yuanshi","quwanli-quanshi","wangli-yundu"]},{"id":"seg-008:1-4:笾豆有践","segmentId":"seg-008","segmentOrder":8,"surfaceText":"笾豆有践","charStart":1,"charEnd":4,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-2"],"materialIds":["chengjunying-jiangjianyuan-zhuxi"]},{"id":"seg-008:1-4:籩豆有踐","segmentId":"seg-008","segmentOrder":8,"surfaceText":"籩豆有踐","charStart":1,"charEnd":4,"entryIds":["chenhuan-chuanshu:0001-1:part-2","fangyurun-yuanshi:0003-1:part-2","quwanli-quanshi:0001-1:part-2","wangli-yundu:0001-1:part-2"],"materialIds":["chenhuan-chuanshu","fangyurun-yuanshi","quwanli-quanshi","wangli-yundu"]},{"id":"seg-008:4-4:踐","segmentId":"seg-008","segmentOrder":8,"surfaceText":"踐","charStart":4,"charEnd":4,"entryIds":["maruichen-tongshi:0003-1:part-1"],"materialIds":["maruichen-tongshi"]}],"entries":[{"id":"chengjunying-jiangjianyuan-zhuxi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/158-fa-ke/chengjunying-jiangjianyuan-zhuxi/0001-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"伐柯如何？匪斧不克。取妻如何？匪媒不得。伐柯伐柯，其则不远。我觏之子，笾豆有践。","sourceLabel":"第 357 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"注释","excerpt":"伐柯如何？匪斧不克。取妻如何？匪媒不得。\n柯，斧柄。\n匪，通“非”。克，能够。郑笺：“伐柯之道，唯斧乃能之。此以类求其类也。”\n取，通“娶”。\n媒，媒人。古代设有“媒氏”的官职，由妇女担任。\n韵读：之部一一克（枯力反，入声）、得（丁力反，入声）。","fullText":"伐柯如何？匪斧不克。取妻如何？匪媒不得。\n柯，斧柄。\n匪，通“非”。克，能够。郑笺：“伐柯之道，唯斧乃能之。此以类求其类也。”\n取，通“娶”。\n媒，媒人。古代设有“媒氏”的官职，由妇女担任。\n韵读：之部一一克（枯力反，入声）、得（丁力反，入声）。\n伐柯伐柯，其则不远。我觏之子，笾豆有践。\n则，法则。這二句意为，要砍一根制斧柄的木头，它的样子就是手中的斧柄，不必远求。\n觏，遇见。之子，朱熹诗集传：“指其妻而言。”\n笾(bin)，竹制的高足盘，古人用来盛果品。豆，篆文作豆，木制的高足盘，古人用来盛肉类。笾和豆都是古人宴会和祭祀用的器皿。有践，即践践，排列整齐貌。毛传：“践，行列貌。”这二句意为，我遇见称心的姑娘，就摆设宴会娶她过来。\n韵读：元部一一远、践。","notes":"据页图转写，按二章与随章注释整理。","partOrder":1,"anchorIds":["seg-001:1-4:伐柯如何","seg-002:1-4:匪斧不克","seg-003:1-4:取妻如何","seg-004:1-4:匪媒不得"],"glossAnchorIds":["anchor-1-1","anchor-1-2","anchor-1-3","anchor-1-4"],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008"]},{"id":"chengjunying-jiangjianyuan-zhuxi:0001-1:part-2","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/158-fa-ke/chengjunying-jiangjianyuan-zhuxi/0001-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"伐柯如何？匪斧不克。取妻如何？匪媒不得。伐柯伐柯，其则不远。我觏之子，笾豆有践。","sourceLabel":"第 357 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"注释","excerpt":"伐柯伐柯，其则不远。我觏之子，笾豆有践。\n则，法则。這二句意为，要砍一根制斧柄的木头，它的样子就是手中的斧柄，不必远求。\n觏，遇见。之子，朱熹诗集传：“指其妻而言。”\n笾(bin)，竹制的高足盘，古人用来盛果品。豆，篆文作豆，木制的高足盘，古人用来盛肉类。笾和豆都是古人宴会和祭祀用的器皿。有践，即践践，排列整齐貌。毛传：“践，行列貌。”这二句意为，我遇见称心的姑娘，就摆设宴会娶她过来。\n韵读：元部一一远、践。","fullText":"伐柯如何？匪斧不克。取妻如何？匪媒不得。\n柯，斧柄。\n匪，通“非”。克，能够。郑笺：“伐柯之道，唯斧乃能之。此以类求其类也。”\n取，通“娶”。\n媒，媒人。古代设有“媒氏”的官职，由妇女担任。\n韵读：之部一一克（枯力反，入声）、得（丁力反，入声）。\n伐柯伐柯，其则不远。我觏之子，笾豆有践。\n则，法则。這二句意为，要砍一根制斧柄的木头，它的样子就是手中的斧柄，不必远求。\n觏，遇见。之子，朱熹诗集传：“指其妻而言。”\n笾(bin)，竹制的高足盘，古人用来盛果品。豆，篆文作豆，木制的高足盘，古人用来盛肉类。笾和豆都是古人宴会和祭祀用的器皿。有践，即践践，排列整齐貌。毛传：“践，行列貌。”这二句意为，我遇见称心的姑娘，就摆设宴会娶她过来。\n韵读：元部一一远、践。","notes":"据页图转写，按二章与随章注释整理。","partOrder":2,"anchorIds":["seg-005:1-4:伐柯伐柯","seg-006:1-4:其则不远","seg-007:1-4:我觏之子","seg-008:1-4:笾豆有践"],"glossAnchorIds":["anchor-2-1","anchor-2-2","anchor-2-3","anchor-2-4"],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008"]},{"id":"chenhuan-chuanshu:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/158-fa-ke/chenhuan-chuanshu/0001-1","materialId":"chenhuan-chuanshu","materialTitle":"詩毛氏傳疏","contributorLine":"清 · 陳奐","publicationYear":1847,"layer":"span","layerLabel":"诗句片段","targetText":"伐柯如何，匪斧不克。取妻如何，匪媒不得。伐柯伐柯，其則不遠。我覯之子，籩豆有踐。","sourceLabel":"第 296 页","attributionLabel":"陈奂","sectionLabel":"正文","excerpt":"伐柯如何，匪斧不克。取妻如何，匪媒不得。","fullText":"伐柯如何，匪斧不克。取妻如何，匪媒不得。伐柯伐柯，其則不遠。我覯之子，籩豆有踐。","notes":null,"partOrder":1,"anchorIds":["seg-001:1-4:伐柯如何","seg-002:1-4:匪斧不克","seg-003:1-4:取妻如何","seg-004:1-4:匪媒不得"],"glossAnchorIds":["anchor-1-1","anchor-1-2","anchor-1-3","anchor-1-4"],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008"]},{"id":"chenhuan-chuanshu:0001-1:part-2","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/158-fa-ke/chenhuan-chuanshu/0001-1","materialId":"chenhuan-chuanshu","materialTitle":"詩毛氏傳疏","contributorLine":"清 · 陳奐","publicationYear":1847,"layer":"span","layerLabel":"诗句片段","targetText":"伐柯如何，匪斧不克。取妻如何，匪媒不得。伐柯伐柯，其則不遠。我覯之子，籩豆有踐。","sourceLabel":"第 296 页","attributionLabel":"陈奂","sectionLabel":"正文","excerpt":"伐柯伐柯，其則不遠。我覯之子，籩豆有踐。","fullText":"伐柯如何，匪斧不克。取妻如何，匪媒不得。伐柯伐柯，其則不遠。我覯之子，籩豆有踐。","notes":null,"partOrder":2,"anchorIds":["seg-005:1-4:伐柯伐柯","seg-006:1-4:其則不遠","seg-007:1-4:我覯之子","seg-008:1-4:籩豆有踐"],"glossAnchorIds":["anchor-2-1","anchor-2-2","anchor-2-3","anchor-2-4"],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008"]},{"id":"fangyurun-yuanshi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/158-fa-ke/fangyurun-yua