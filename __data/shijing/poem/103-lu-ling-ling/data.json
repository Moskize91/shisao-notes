rder":6,"surfaceText":"其人美且偲","charStart":1,"charEnd":5,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-6"],"materialIds":["chengjunying-jiangjianyuan-zhuxi"]},{"id":"seg-006:5-5:偲","segmentId":"seg-006","segmentOrder":6,"surfaceText":"偲","charStart":5,"charEnd":5,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-7"],"materialIds":["chengjunying-jiangjianyuan-zhuxi"]}],"entries":[{"id":"chengjunying-jiangjianyuan-zhuxi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/103-lu-ling-ling/chengjunying-jiangjianyuan-zhuxi/0001-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"卢令令，其人美且仁。卢重环，其人美且髦。卢重镅，其人美且偲。","sourceLabel":"第 216-217 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","excerpt":"这是一首赞美猎人的诗。春秋时代人们爱好田猎，诗中称誉之意甚明，纵使写齐襄公出猎，亦是赞美而非讥刺。此诗每章只有两句，章与章之间只变换二三字，可能是顺口溜一类的民歌。","fullText":"这是一首赞美猎人的诗。春秋时代人们爱好田猎，诗中称誉之意甚明，纵使写齐襄公出猎，亦是赞美而非讥刺。此诗每章只有两句，章与章之间只变换二三字，可能是顺口溜一类的民歌。卢令令，其人美且仁。卢，黑色猎狗。令令，狗颈下套环的响声。其人，指猎人。仁，和蔼友好。卢重环，其人美且髦。重环，大环中套一个小环，也称子母环。髦，勇壮。卢重镅，其人美且偲。重镅，大环中套两个小环。偲，多才。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006"]},{"id":"chengjunying-jiangjianyuan-zhuxi:0001-1:part-2","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/103-lu-ling-ling/chengjunying-jiangjianyuan-zhuxi/0001-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"卢令令，其人美且仁。卢重环，其人美且髦。卢重镅，其人美且偲。","sourceLabel":"第 216-217 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","excerpt":"卢令令，其人美且仁。","fullText":"这是一首赞美猎人的诗。春秋时代人们爱好田猎，诗中称誉之意甚明，纵使写齐襄公出猎，亦是赞美而非讥刺。此诗每章只有两句，章与章之间只变换二三字，可能是顺口溜一类的民歌。卢令令，其人美且仁。卢，黑色猎狗。令令，狗颈下套环的响声。其人，指猎人。仁，和蔼友好。卢重环，其人美且髦。重环，大环中套一个小环，也称子母环。髦，勇壮。卢重镅，其人美且偲。重镅，大环中套两个小环。偲，多才。","notes":nul