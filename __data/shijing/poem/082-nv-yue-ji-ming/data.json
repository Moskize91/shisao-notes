,"segmentOrder":17,"surfaceText":"好","charStart":4,"charEnd":4,"entryIds":["wangli-yundu:0001-1:part-4"],"materialIds":["wangli-yundu"]},{"id":"seg-018:1-2:雜佩","segmentId":"seg-018","segmentOrder":18,"surfaceText":"雜佩","charStart":1,"charEnd":2,"entryIds":["chenhuan-chuanshu:0001-1:part-3","maruichen-tongshi:0001-1:part-3"],"materialIds":["chenhuan-chuanshu","maruichen-tongshi"]},{"id":"seg-018:4-4:报","segmentId":"seg-018","segmentOrder":18,"surfaceText":"报","charStart":4,"charEnd":4,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-3","wangli-yundu:0001-1:part-4"],"materialIds":["chengjunying-jiangjianyuan-zhuxi","wangli-yundu"]}],"entries":[{"id":"chengjunying-jiangjianyuan-zhuxi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/082-nv-yue-ji-ming/chengjunying-jiangjianyuan-zhuxi/0001-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"女曰鸡鸣，士曰昧旦。子兴视夜，明星有烂。将翱将翔，弋凫与雁。弋言加之，与子宜之。宜言饮酒，与子偕老。琴瑟在御，莫不静好。知子之来之，杂佩以赠之。知子之顺之，杂佩以问之。知子之好之，杂佩以报之。","sourceLabel":"第 182-183 页","attributionLabel":"程俊英","sectionLabel":"题解","excerpt":"程俊英、蒋见元以《女曰鸡鸣》为写贵族夫妇相警相乐的联句诗，","fullText":"程俊英、蒋见元以《女曰鸡鸣》为写贵族夫妇相警相乐的联句诗，释首章为妻劝夫早起射凫雁，次章为琴瑟宜酒、与子偕老，三章则见杂佩相赠问报，以成其德。","notes":null,"partOrder":1,"anchorIds":["seg-001:1-4:女曰鸡鸣"],"glossAnchorIds":["anchor-1-1"],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016","seg-017","seg-018"]},{"id":"chengjunying-jiangjianyuan-zhuxi:0001-1:part-2","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/082-nv-yue-ji-ming/chengjunying-jiangjianyuan-zhuxi/0001-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"女曰鸡鸣，士曰昧旦。子兴视夜，明星有烂。将翱将翔，弋凫与雁。弋言加之，与子宜之。宜言饮酒，与子偕老。琴瑟在御，莫不静好。知子之来之，杂佩以赠之。知子之顺之，杂佩以问之。知子之好之，杂佩以报之。","sourceLabel":"第 182-183 页","attributionLabel":"程俊英","sectionLabel":"题解","excerpt":"释首章为妻劝夫早起射凫雁，次章为琴瑟宜酒、与子偕老，","fullText":"程俊英、蒋见元以《女曰鸡鸣》为写贵族夫妇相警相乐的联句诗，释首章为妻劝夫早起射凫雁，次章为琴瑟宜酒、与子偕老，三章则见杂佩相赠问报，以成其德。","notes":null,"partOrder":2,"anchorIds":["seg-006:2-2:凫","seg-011:1-2:琴瑟","seg-010:3-4:偕老"],"glossAnchorIds":["anchor-2-1","anchor-2-2","anchor-2-3"],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016","seg-017","seg-018"]},{"id":"chengjunying-jiangjianyuan-zhuxi:0001-1:part-3","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/082-nv-yue-ji-ming/chengjunying-jiangjianyuan-zhuxi/0001-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"女曰鸡鸣，士曰昧旦。子兴视夜，明星有烂。将翱将翔，弋凫与雁。弋言加之，与子宜之。宜言饮酒，与子偕老。琴瑟在御，莫不静好。知子之来之，杂佩以赠之。知子之顺之，杂佩以问之。知子之好之，杂佩以报之。","sourceLabel":"第 182-183 页","attributionLabel":"程俊英","sectionLabel":"题解","excerpt":"三章则见杂佩相赠问报，以成其德。","fullText":"程俊英、蒋见元以《女曰鸡鸣》为写贵族夫妇相警相乐的联句诗，释首章为妻劝夫早起射凫雁，次章为琴瑟宜酒、与子偕老，三章则见杂佩相赠问报，以成其德。","notes":null,"partOrder":3,"anchorIds":["seg-014:1-2:杂佩","seg-016:1-2:杂佩","seg-018:4-4:报"],"glossAnchorIds":["anchor-3-1","anchor-3-2","anchor-3-3"],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016","seg-017","seg-018"]},{"id":"chenhuan-chuanshu:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/082-nv-yue-ji-ming/chenhuan-chuanshu/0001-1","materialId":"chenhuan-chuanshu","materialTitle":"詩毛氏傳疏","contributorLine":"清 · 陳奐","publicationYear":1847,"layer":"span","layerLabel":"诗句片段","targetText":"女曰鷄鳴，士曰昧旦。子興視夜，明星有爛。將翺將翔，弋鳧與鴈。弋言加之，與子宜之。宜言飲酒，與子偕老。琴瑟在御，莫不靜好。知子之來之，雜佩以贈之。知子之順之，雜佩以問之。知子之好之，雜佩以報之。","sourceLabel":"第 93-94 页","attributionLabel":"陳奂","sectionLabel":"疏","excerpt":"陳奂疏《女曰鷄鳴》，申《序》所謂不說其德而見其德，","fullText":"陳奂疏《女曰鷄鳴》，申《序》所謂不說其德而見其德，謂首章雞鳴視夜是婦人勉夫勤起，次章酒食琴瑟見宜家靜好，三章雜佩贈問報則見夫婦德音相感。","notes":null,"partOrder":1,"anchorIds":["seg-001:1-4:女曰鷄鳴"],"glossAnchorIds":["anchor-1-1"],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016","seg-017","seg-018"]},{"id":"chenhuan-chuanshu:0001-1:part-2","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/082-nv-yue-ji-ming/chenhuan-chuanshu/0001-1","materialId":"chenhuan-chuanshu","materialTitle":"詩毛氏傳疏","contributorLine":"清 · 陳奐","publicationYear":1847,"layer":"span","layerLabel":"诗句片段","targetText":"女曰鷄鳴，士曰昧旦。子興視夜，明星有爛。將翺將翔，弋鳧與鴈。弋言加之，與子宜之。宜言飲酒，與子偕老。琴瑟在御，莫不靜好。知子之來之，雜佩以贈之。知子之順之，雜佩以問之。知子之好之，雜佩以報之。","sourceLabel":"第 93-94 页","attributionLabel":"陳奂","sectionLabel":"疏","excerpt":"謂首章雞鳴視夜是婦人勉夫勤起，次章酒食琴瑟見宜家靜好，","fullText":"陳奂疏《女曰鷄鳴》，申《序》所謂不說其德而見其德，謂首章雞鳴視夜是婦人勉夫勤起，次章酒食琴瑟見宜家靜好，三章雜佩贈問報則見夫婦德音相感。","notes":null,"partOrder":2,"anchorIds":["seg-003:3-4:視夜","seg-011:1-2:琴瑟","seg-012:3-4:靜好"],"glossAnchorIds":["anchor-2-1","anchor-2-2","anchor-2-3"],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016","seg-017","seg-018"]},{"id":"chenhuan-chuanshu:0001-1:part-3","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/082-nv-yue-ji-ming/chenhuan-chuanshu/0001-1","materialId":"chenhuan-chuanshu","materialTitle":"詩毛氏傳疏","contributorLine":"清 · 陳奐","publicationYear":1847,"layer":"span","layerLabel":"诗句片段","targetText":"女曰鷄鳴，士曰昧旦。子興視夜，明星有爛。將翺將翔，弋鳧與鴈。弋言加之，與子宜之。宜言飲酒，與子偕老。琴瑟在御，莫不靜好。知子之來之，雜佩以贈之。知子之順之，雜佩以問之。知子之好之，雜佩以報之。","sourceLabel":"第 93-94 页","attributionLabel":"陳奂","sectionLabel":"疏","excerpt":"三章雜佩贈問報則見夫婦德音相感。","fullText":"陳奂疏《女曰鷄鳴》，申《序》所謂不說其德而見其德，謂首章雞鳴視夜是婦人勉夫勤起，次章酒食琴瑟見宜家靜好，三章雜佩贈問報則見夫婦德音相感。","notes":null,"partOrder":3,"anchorIds":["seg-014:1-2:雜佩","seg-016:1-2:雜佩","seg-018:1-2:雜佩"],"glossAnchorIds":["anchor-3-1","anchor-3-2","anchor-3-3"],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016","seg-017","seg-018"]},{"id":"fangyurun-yuanshi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/082-nv-yue-ji-ming/fangyurun-yuanshi/0001-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"span","layerLabel":"诗句片段","targetText":"女曰鷄鳴，士曰昧旦。子興視夜，明星有爛。將翺將翔，弋鳧與鴈。弋言加之，與子宜之。宜言飲酒，與子偕老。琴瑟在御，莫不静好。知子之來之，雜佩以贈之。知子之順之，雜佩以問之。知子之好之，雜佩以報之。","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"总评","excerpt":"方玉潤論《女曰鷄鳴》為賢夫婦相警戒之辭，非《序》所謂陳古刺今；","fullText":"方玉潤論《女曰鷄鳴》為賢夫婦相警戒之辭，非《序》所謂陳古刺今；首章勉夫勤勞，次章宜家和樂，三章則佐夫以親賢樂善而成其德，可與《關雎》《葛覃》並觀。","notes":null,"partOrder":1,"anchorIds":["seg-001:1-4:女曰鷄鳴"],"glossAnchorIds":["anchor-1-1"],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016","seg-017","seg-018"]},{"id":"fangyurun-yuanshi:0001-1:part-2","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/082-nv-yue-ji-ming/fangyurun-yuanshi/0001-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"span","layerLabel":"诗句片段","targetText":"女曰鷄鳴，士曰昧旦。子興視夜，明星有爛。將翺將翔，弋鳧與鴈。弋言加之，與子宜之。宜言飲酒，與子偕老。琴瑟在御，莫不静好。知子之來之，雜佩以贈之。知子之順之，雜佩以問之。知子之好之，雜佩以報之。","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"总评","excerpt":"首章勉夫勤勞，次章宜家和樂，三章則佐夫以親賢樂善而成其德，","fullText":"方玉潤論《女曰鷄鳴》為賢夫婦相警戒之辭，非《序》所謂陳古刺今；首章勉夫勤勞，次章宜家和樂，三章則佐夫以親賢樂善而成其德，可與《關雎》《葛覃》並觀。","notes":null,"partOrder":2,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016","seg-017","seg-018"]},{"id":"fangyurun-yuanshi:0001-1:part-3","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/082-nv-yue-ji-ming/fangyurun-yuanshi/0001-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"span","layerLabel":"诗句片段","targetText":"女曰鷄鳴，士曰昧旦。子興視夜，明星有爛。將翺將翔，弋鳧與鴈。弋言加之，與子宜之。宜言飲酒，與子偕老。琴瑟在御，莫不静好。知子之來之，雜佩以贈之。知子之順之，雜佩以問之。知子之好之，雜佩以報之。","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"总评","excerpt":"可與《關雎》《葛覃》並觀。","fullText":"方玉潤論《女曰鷄鳴》為賢夫婦相警戒之辭，非《序》所謂陳古刺今；首章勉夫勤勞，次章宜家和樂，三章則佐夫以親賢樂善而成其德，可與《關雎》《葛覃》並觀。","notes":null,"partOrder":3,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016","seg-017","seg-018"]},{"id":"maruichen-tongshi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/082-nv-yue-ji-ming/maruichen-tongshi/0001-1","materialId":"maruichen-tongshi","materialTitle":"毛詩傳箋通釋","contributorLine":"清 · 馬瑞辰","publicationYear":1989,"layer":"span","layerLabel":"诗句片段","targetText":"女曰鷄鳴，士曰昧旦。子興視夜，明星有爛。將翺將翔，弋鳧與鴈。弋言加之，與子宜之。宜言飲酒，與子偕老。琴瑟在御，莫不靜好。知子之來之，雜佩以贈之。知子之順之，雜佩以問之。知子之好之，雜佩以報之。","sourceLabel":"第 380-382 页","attributionLabel":"馬瑞辰","sectionLabel":"通釋","excerpt":"馬瑞辰通釋《女曰鷄鳴》，以爲婦人先警其夫早起視夜，","fullText":"馬瑞辰通釋《女曰鷄鳴》，以爲婦人先警其夫早起視夜，繼言弋鳧鴈、宜酒食、琴瑟靜好，末章又以雜佩相贈答，皆見夫婦和樂相勉之意。","notes":null,"partOrder":1,"anchorIds":["seg-001:1-4:女曰鷄鳴","seg-003:3-4:視夜"],"glossAnchorIds":["anchor-1-1","anchor-1-2"],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016","seg-017","seg-018"]},{"id":"maruichen-tongshi:0001-1:part-2","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/0