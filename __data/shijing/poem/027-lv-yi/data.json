[{"id":"maoheng-zhushu-kr1c0004","title":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"glossCount":5,"partCount":5},{"id":"zhuxi-shijichuan-kr1c0009","title":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"glossCount":5,"partCount":5},{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","contributorLine":"清 · 陳奐","publicationYear":1847,"glossCount":2,"partCount":2},{"id":"wangli-yundu","title":"詩經韻讀","contributorLine":"现代 · 王力","publicationYear":1980,"glossCount":2,"partCount":2},{"id":"quwanli-quanshi","title":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"glossCount":2,"partCount":2},{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"glossCount":5,"partCount":5},{"id":"maruichen-tongshi","title":"毛詩傳箋通釋","contributorLine":"清 · 馬瑞辰","publicationYear":1989,"glossCount":1,"partCount":1},{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"glossCount":5,"partCount":5}],"stats":{"materialCount":8,"glossCount":27,"anchoredPartCount":0,"overviewPartCount":10},"overview":{"prefaceEntryIds":["chenhuan-chuanshu:0001-1:part-1","maoheng-zhushu-kr1c0004:0001-1:part-1"],"globalEntryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-1","fangyurun-yuanshi:0001-1:part-1","fangyurun-yuanshi:0002-1:part-1","fangyurun-yuanshi:0003-1:part-1","fangyurun-yuanshi:0005-1:part-1","quwanli-quanshi:0001-1:part-1","wangli-yundu:0001-1:part-1","zhuxi-shijichuan-kr1c0009:0005-1:part-1"]},"focusAnchors":[],"entries":[{"id":"chengjunying-jiangjianyuan-zhuxi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/027-lv-yi/chengjunying-jiangjianyuan-zhuxi/0001-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"global","layerLabel":"全篇总说","targetText":"题解","sourceLabel":"第 50-51 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","excerpt":"程、蒋将《绿衣》读为睹物怀人、追念亡妻之诗，认为旧说庄姜伤己、嫡妾失位虽可备存，但细味全篇更近悼亡。题解强调诗人反复咏叹的只是亡妻旧衣，由“绿衣”“絺綌”牵出触目伤心之情，故此诗可视作后世悼亡诗的滥觞。","fullText":"程、蒋将《绿衣》读为睹物怀人、追念亡妻之诗，认为旧说庄姜伤己、嫡妾失位虽可备存，但细味全篇更近悼亡。题解强调诗人反复咏叹的只是亡妻旧衣，由“绿衣”“絺綌”牵出触目伤心之情，故此诗可视作后世悼亡诗的滥觞。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"chengjunying-jiangjianyuan-zhuxi:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/027-lv-yi/chengjunying-jiangjianyuan-zhuxi/0002-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"绿兮衣兮，绿衣黄里。心之忧矣，曷维其已！","sourceLabel":"第 51-52 页","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"excerpt":"首章从眼前所见的绿衣黄里写起。程、蒋认为“绿衣”并非比兴深喻，而是亡妻旧衣触发的真实联想；“曷维其已”则直接写出哀思无已，正与悼亡语气相合。","fullText":"首章从眼前所见的绿衣黄里写起。程、蒋认为“绿衣”并非比兴深喻，而是亡妻旧衣触发的真实联想；“曷维其已”则直接写出哀思无已，正与悼亡语气相合。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004"]},{"id":"chengjunying-jiangjianyuan-zhuxi:0003-1:part-1","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/027-lv-yi/chengjunying-jiangjianyuan-zhuxi/0003-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"绿兮衣兮，绿衣黄裳。心之忧矣，曷维其亡！","sourceLabel":"第 52 页","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"excerpt":"次章仍承首章复沓，“黄裳”由衣里转到下裳，只是把所见旧衣从里及表写得更具体。程、蒋把“亡”释作忘，认为这一章仍是写哀念不能忘怀。","fullText":"次章仍承首章复沓，“黄裳”由衣里转到下裳，只是把所见旧衣从里及表写得更具体。程、蒋把“亡”释作忘，认为这一章仍是写哀念不能忘怀。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-005","seg-006","seg-007","seg-008"]},{"id":"chengjunying-jiangjianyuan-zhuxi:0004-1:part-1","annotationId":"0004","glossId":"0004-1","glossHref":"/shijing/gloss/027-lv-yi/chengjunying-jiangjianyuan-zhuxi/0004-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"绿兮丝兮，女所治兮。我思古人，俾无訧兮。","sourceLabel":"第 52 页","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"excerpt":"三章由衣追想到衣料与缝治之人。“女所治兮”点出此衣出自故妻之手，“俾无訧兮”则称其生前足以辅佐、使己少过。程、蒋认为这一转进最见亡妻贤德，所以怀思更深。","fullText":"三章由衣追想到衣料与缝治之人。“女所治兮”点出此衣出自故妻之手，“俾无訧兮”则称其生前足以辅佐、使己少过。程、蒋认为这一转进最见亡妻贤德，所以怀思更深。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-009","seg-010","seg-011","seg-012"]},{"id":"chengjunying-jiangjianyuan-zhuxi:0005-1:part-1","annotationId":"0005","glossId":"0005-1","glossHref":"/shijing/gloss/027-lv-yi/chengjunying-jiangjianyuan-zhuxi/0005-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"絺兮綌兮，凄其以风。我思古人，实获我心。","sourceLabel":"第 52 页","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"excerpt":"末章由夏葛逢风而生凉意，引出“我思古人，实获我心”。程、蒋指出这里既写时令凄清，也写作者念及亡妻最能体贴己心，由是把全篇悼亡之意收束得更沉挚。","fullText":"末章由夏葛逢风而生凉意，引出“我思古人，实获我心”。程、蒋指出这里既写时令凄清，也写作者念及亡妻最能体贴己心，由是把全篇悼亡之意收束得更沉挚。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-013","seg-014","seg-015","seg-016"]},{"id":"chenhuan-chuanshu:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/027-lv-yi/chenhuan-chuanshu/0001-1","materialId":"chenhuan-chuanshu","materialTitle":"詩毛氏傳疏","contributorLine":"清 · 陳奐","publicationYear":1847,"layer":"preface","layerLabel":"篇序","targetText":"綠衣衛莊姜傷己也妾上僭夫人失位而作是詩也","sourceLabel":"第 54 页","attributionLabel":"诗序","sectionLabel":"序","excerpt":"序：《綠衣》，衛莊姜傷己也。妾上僭，夫人失位而作是詩也。","fullText":"序：《綠衣》，衛莊姜傷己也。妾上僭，夫人失位而作是詩也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"chenhuan-chuanshu:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/027-lv-yi/chenhuan-chuanshu/0002-1","materialId":"chenhuan-chuanshu","materialTitle":"詩毛氏傳疏","contributorLine":"清 · 陳奐","publicationYear":1847,"layer":"span","layerLabel":"诗句片段","targetText":"綠兮衣兮，綠衣黃裏。心之憂矣，曷維其已。綠兮衣兮，綠衣黃裳。心之憂矣，曷維其亡。綠兮絲兮，女所治兮。我思古人，俾無訧兮。絺兮綌兮，淒其以風。我思古人，實獲我心。","sourceLabel":"第 54-55 页","attributionLabel":"陈奂","sectionLabel":"疏","excerpt":"陈奂遵《序》旧说，以《綠衣》为庄姜伤己、嫡妾失位之辞。其疏重申“绿”为间色、“黄”为正色，以衣里、衣裳、丝帛与絺綌层层设喻，写妾僭而夫人见疏；末二章又从旧物缝治与寒风失时，转见庄姜自伤而怨不怒。","fullText":"陈奂遵《序》旧说，以《綠衣》为庄姜伤己、嫡妾失位之辞。其疏重申“绿”为间色、“黄”为正色，以衣里、衣裳、丝帛与絺綌层层设喻，写妾僭而夫人见疏；末二章又从旧物缝治与寒风失时，转见庄姜自伤而怨不怒。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016"]},{"id":"fangyurun-yuanshi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/027-lv-yi/fangyurun-yuanshi/0001-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"global","layerLabel":"全篇总说","targetText":"緑衣㊟衛莊姜傷嫡妾失位也。","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"题注","excerpt":"方玉润在题注中直定《緑衣》为卫庄姜伤嫡妾失位之诗，承庄姜失位说而发。","fullText":"方玉润在题注中直定《緑衣》为卫庄姜伤嫡妾失位之诗，承庄姜失位说而发。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"fangyurun-yuanshi:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/027-lv-yi/fangyurun-yuanshi/0002-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"global","layerLabel":"全篇总说","targetText":"总评","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"总评","excerpt":"总评中方玉润从庄姜说出发，认为首二章用绿黄、表里、上下比嫡妾贵贱倒置，三章则由“绿兮丝兮”回溯未染之前，怨意最深而不露，四章又以絺綌不宜寒风喻失时见弃。其评强调全诗温柔敦厚、怨而不怒，最能见庄姜之贤。","fullText":"总评中方玉润从庄姜说出发，认为首二章用绿黄、表里、上下比嫡妾贵贱倒置，三章则由“绿兮丝兮”回溯未染之前，怨意最深而不露，四章又以絺綌不宜寒风喻失时见弃。其评强调全诗温柔敦厚、怨而不怒，最能见庄姜之贤。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"fangyurun-yuanshi:0003-1:part-1","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/027-lv-yi/fangyurun-yuanshi/0003-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"global","layerLabel":"全篇总说","targetText":"眉评","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"眉评","excerpt":"眉评引姚际恒谓此诗先从“绿衣”言“黄里”，又从“绿衣”转言“丝”，再由“丝”及“絺綌”，若断若连，最足玩味。方玉润借此强调本篇结构绵密，不是单纯铺叙怨词。","fullText":"眉评引姚际恒谓此诗先从“绿衣”言“黄里”，又从“绿衣”转言“丝”，再由“丝”及“絺綌”，若断若连，最足玩味。方玉润借此强调本篇结构绵密，不是单纯铺叙怨词。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"fangyurun-yuanshi:0004-1:part-1","annotationId":"0004","glossId":"0004-1","glossHref":"/shijing/gloss/027-lv-yi/fangyurun-yuanshi/0004-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"term","layerLabel":"字词注","targetText":"緑兮衣兮緑衣黄裏緑衣黄裳女所治兮俾無訧兮","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"集释","excerpt":"集释明言“绿”为间色、“黄”为正色，“衣上曰衣，裳下曰裳”；又释“治”为治理丝帛，“訧”为过。方玉润借这些训释，把首二章的颜色礼制、后三章的妇功与得失都扣回庄姜失位之旨。","fullText":"集释明言“绿”为间色、“黄”为正色，“衣上曰衣，裳下曰裳”；又释“治”为治理丝帛，“訧”为过。方玉润借这些训释，把首二章的颜色礼制、后三章的妇功与得失都扣回庄姜失位之旨。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-006","seg-010","seg-012"]},{"id":"fangyurun-yuanshi:0005-1:part-1","annotationId":"0005","glossId":"0005-1","glossHref":"/shijing/gloss/027-lv-yi/fangyurun-yuanshi/0005-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"global","layerLabel":"全篇总说","targetText":"标韵","sourceLabel":null,"attributionLabel":"标韵","sectionLabel":null,"excerpt":"标韵以首章“裏”“已”入纸部，次章“裳”“亡”入阳部，三章“絲”“治”“訧”本支而末句叶尤，四章“風”“心”则东侵通叶。章章换韵而情绪递转。","fullText":"标韵以首章“裏”“已”入纸部，次章“裳”“亡”入阳部，三章“絲”“治”“訧”本支而末句叶尤，四章“風”“心”则东侵通叶。章章换韵而情绪递转。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"maoheng-zhushu-kr1c0004:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/027-lv-yi/maoheng-zhushu-kr1c0004/0001-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"preface","layerLabel":"篇序","targetText":"綠衣衛莊姜傷己也妾上僭夫人失位而作是詩也","sourceLabel":null,"attributionLabel":"诗序","sectionLabel":"序","excerpt":"序：《綠衣》，衛莊姜傷己也。妾上僭，夫人失位而作是詩也。","fullText":"序：《綠衣》，衛莊姜傷己也。妾上僭，夫人失位而作是詩也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"maoheng-zhushu-kr1c0004:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/027-lv-yi/maoheng-zhushu-kr1c0004/0002-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"span","layerLabel":"诗句片段","targetText":"綠兮衣兮綠衣黃裏心之憂矣曷維其已","sourceLabel":null,"attributionLabel":"毛传","sectionLabel":null,"excerpt":"傳：綠，間色。黃，正色。間色之綠衣，黃裏之。黃裏，黃之閒也。已，止也。","fullText":"傳：綠，間色。黃，正色。間色之綠衣，黃裏之。黃裏，黃之閒也。已，止也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004"]},{"id":"maoheng-zhushu-kr1c0004:0003-1:part-1","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/027-lv-yi/maoheng-zhushu-kr1c0004/0003-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"span","layerLabel":"诗句片段","targetText":"綠兮衣兮綠衣黃裳心之憂矣曷維其亡","sourceLabel":null,"attributionLabel":"毛传","sectionLabel":null,"excerpt":"傳：上曰衣，下曰裳。亡，忘也。","fullText":"傳：上曰衣，下曰裳。亡，忘也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-005","seg-006","seg-007","seg-008"]},{"id":"maoheng-zhushu-kr1c0004:0004-1:part-1","annotationId":"0004","glossId":"0004-1","glossHref":"/shijing/gloss/027-lv-yi/maoheng-zhushu-kr1c0004/0004-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"span","layerLabel":"诗句片段","targetText":"綠兮絲兮女所治兮我思古人俾無訧兮","sourceLabel":null,"attributionLabel":"毛传","sectionLabel":null,"excerpt":"傳：女，女功也。古人，古之人，謂夫人也。訧，過也。","fullText":"傳：女，女功也。古人，古之人，謂夫人也。訧，過也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-009","seg-010","seg-011","seg-012"]},{"id":"maoheng-zhushu-kr1c0004:0005-1:part-1","annotationId":"0005","glossId":"0005-1","glossHref":"/shijing/gloss/027-lv-yi/maoheng-zhushu-kr1c0004/0005-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"span","layerLabel":"诗句片段","targetText":"絺兮綌兮淒其以風我思古人實獲我心","sourceLabel":null,"attributionLabel":"毛传","sectionLabel":null,"excerpt":"傳：絺，細葛也。綌，麤葛也。淒，寒風也。實，是也。獲，得也。","fullText":"傳：絺，細葛也。綌，麤葛也。淒，寒風也。實，是也。獲，得也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-013","seg-014","seg-015","seg-016"]},{"id":"maruichen-tongshi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/027-lv-yi/maruichen-tongshi/0001-1","materialId":"maruichen-tongshi","materialTitle":"毛詩傳箋通釋","contributorLine":"清 · 馬瑞辰","publicationYear":1989,"layer":"span","layerLabel":"诗句片段","targetText":"綠兮衣兮，綠衣黃裏。心之憂矣，曷維其已。綠兮衣兮，綠衣黃裳。心之憂矣，曷維其亡。綠兮絲兮，女所治兮。我思古人，俾無訧兮。絺兮綌兮，淒其以風。我思古人，實獲我心。","sourceLabel":"第 102-103 页","attributionLabel":"马瑞辰","sectionLabel":"按","excerpt":"马瑞辰于《綠衣》一篇仍以庄姜失位说为主，但其按语尤其详论绿、黄、里、裳的礼制义与比兴关系，说明间色居上、正色居下如何象征嫡妾倒置；又由“絲”“絺綌”追溯妇功与失时之感，强调本诗辞婉而意深，不只是单纯怨色。","fullText":"马瑞辰于《綠衣》一篇仍以庄姜失位说为主，但其按语尤其详论绿、黄、里、裳的礼制义与比兴关系，说明间色居上、正色居下如何象征嫡妾倒置；又由“絲”“絺綌”追溯妇功与失时之感，强调本诗辞婉而意深，不只是单纯怨色。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016"]},{"id":"quwanli-quanshi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/027-lv-yi/quwanli-quanshi/0001-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"global","layerLabel":"全篇总说","targetText":"全篇旨意","sourceLabel":"第 32 页","attributionLabel":"屈万里","sectionLabel":"注释","excerpt":"屈万里在首条注释中录《诗序》“卫庄姜伤己也，妾上僭，夫人失位而作是诗”之说，同时指出此说未必能够遽定。其处理较为审慎，偏重保留旧说背景而不强作决断。","fullText":"屈万里在首条注释中录《诗序》“卫庄姜伤己也，妾上僭，夫人失位而作是诗”之说，同时指出此说未必能够遽定。其处理较为审慎，偏重保留旧说背景而不强作决断。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"quwanli-quanshi:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/027-lv-yi/quwanli-quanshi/0002-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"term","layerLabel":"字词注","targetText":"绿兮衣兮绿衣黄裏绿衣黄裳曷维其亡俾无訧兮凄其以风实获我心","sourceLabel":"第 32 页","attributionLabel":"屈万里","sectionLabel":"注释","excerpt":"屈万里释“绿”为间色，“黄”为正色，“衣”为上衣，“裳”为下衣；“亡”训忘，“訧”为过；并引郑笺、朱传说明“实获我心”为真能先得我心之所求。整组注释偏重字义礼制，对本篇是否必为庄姜伤己保持较谨慎态度。","fullText":"屈万里释“绿”为间色，“黄”为正色，“衣”为上衣，“裳”为下衣；“亡”训忘，“訧”为过；并引郑笺、朱传说明“实获我心”为真能先得我心之所求。整组注释偏重字义礼制，对本篇是否必为庄姜伤己保持较谨慎态度。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-006","seg-008","seg-012","seg-014","seg-016"]},{"id":"wangli-yundu:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/027-lv-yi/wangli-yundu/0001-1","materialId":"wangli-yundu","materialTitle":"詩經韻讀","contributorLine":"现代 · 王力","publicationYear":1980,"layer":"global","layerLabel":"全篇总说","targetText":"《绿衣》韵读总说","sourceLabel":"第 150-151 页","attributionLabel":"王力","sectionLabel":"韵读","excerpt":"王力将《绿衣》析为四章换韵：首章“里(lia)、已(jia)”入之部，次章“裳(ziang)、亡(miuang)”入阳部，三章“丝(sia)、治(dia)、訧(hiou)”以之部而末句叶尤，四章“风(piuam)、心(siem)”作东侵通叶。四章短促而句尾鲜明，最见复沓之美。","fullText":"王力将《绿衣》析为四章换韵：首章“里(lia)、已(jia)”入之部，次章“裳(ziang)、亡(miuang)”入阳部，三章“丝(sia)、治(dia)、訧(hiou)”以之部而末句叶尤，四章“风(piuam)、心(siem)”作东侵通叶。四章短促而句尾鲜明，最见复沓之美。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"wangli-yundu:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/027-lv-yi/wangli-yundu/0002-1","materialId":"wangli-yundu","materialTitle":"詩經韻讀","contributorLine":"现代 · 王力","publicationYear":1980,"layer":"span","layerLabel":"诗句片段","targetText":"绿兮衣兮，绿衣黄里。心之忧矣，曷维其已。绿兮衣兮，绿衣黄裳。心之忧矣，曷维其亡。绿兮丝兮，女所治兮。我思古人，俾无訧兮。絺兮綌兮，凄其以风。我思古人，实获我心。","sourceLabel":"第 150-151 页","attributionLabel":"王力","sectionLabel":"韵读","excerpt":"页图可读《绿衣》前二章分押之部、阳部，后三章再转之部与侵部。王力所记注音还显示第三章末句“訧”单独出韵，第四章则以“风”“心”收束，形成较柔婉的尾声。","fullText":"页图可读《绿衣》前二章分押之部、阳部，后三章再转之部与侵部。王力所记注音还显示第三章末句“訧”单独出韵，第四章则以“风”“心”收束，形成较柔婉的尾声。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016"]},{"id":"zhuxi-shijichuan-kr1c0009:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/027-lv-yi/zhuxi-shijichuan-kr1c0009/0001-1","materialId":"zhuxi-shijichuan-kr1c0009","materialTitle":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"layer":"span","layerLabel":"诗句片段","targetText":"綠兮衣兮，綠衣黃裏。心之憂矣，曷維其已。","sourceLabel":null,"attributionLabel":"朱熹","sectionLabel":null,"excerpt":"比也。朱熹从《序》说，以《綠衣》为庄姜伤己之辞；“绿”为间色，“黄”为正色，绿衣反以黄为里，正如妾僭而夫人失位，故忧伤无已。","fullText":"比也。朱熹从《序》说，以《綠衣》为庄姜伤己之辞；“绿”为间色，“黄”为正色，绿衣反以黄为里，正如妾僭而夫人失位，故忧伤无已。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004"]},{"id":"zhuxi-shijichuan-kr1c0009:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/027-lv-yi/zhuxi-shijichuan-kr1c0009/0002-1","materialId":"zhuxi-shijichuan-kr1c0009","materialTitle":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"layer":"span","layerLabel":"诗句片段","targetText":"綠兮衣兮，綠衣黃裳。心之憂矣，曷維其亡。","sourceLabel":null,"attributionLabel":"朱熹","sectionLabel":null,"excerpt":"比也。第二章以黄裳在下，比夫人反处卑位；“亡”犹忘。朱熹认为此章仍承嫡妾倒置之比，而写忧念不能忘。","fullText":"比也。第二章以黄裳在下，比夫人反处卑位；“亡”犹忘。朱熹认为此章仍承嫡妾倒置之比，而写忧念不能忘。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-005","seg-006","seg-007","seg-008"]},{"id":"zhuxi-shijichuan-kr1c0009:0003-1:part-1","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/027-lv-yi/zhuxi-shijichuan-kr1c0009/0003-1","materialId":"zhuxi-shijichuan-kr1c0009","materialTitle":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"layer":"span","layerLabel":"诗句片段","targetText":"綠兮絲兮，女所治兮。我思古人，俾無訧兮。","sourceLabel":null,"attributionLabel":"朱熹","sectionLabel":null,"excerpt":"比而赋也。朱熹释“女所治兮”为追念庄姜之妇功，“古人”即其所思之人，“訧”为过。此章由色衣转及丝治，见其贤德足以免己于过。","fullText":"比而赋也。朱熹释“女所治兮”为追念庄姜之妇功，“古人”即其所思之人，“訧”为过。此章由色衣转及丝治，见其贤德足以免己于过。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-009","seg-010","seg-011","seg-012"]},{"id":"zhuxi-shijichuan-kr1c0009:0004-1:part-1","annotationId":"0004","glossId":"0004-1","glossHref":"/shijing/gloss/027-lv-yi/zhuxi-shijichuan-kr1c0009/0004-1","materialId":"zhuxi-shijichuan-kr1c0009","materialTitle":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"layer":"span","layerLabel":"诗句片段","targetText":"絺兮綌兮，淒其以風。我思古人，實獲我心。","sourceLabel":null,"attributionLabel":"朱熹","sectionLabel":null,"excerpt":"比也。絺綌本为暑服，而今逢凄风，比贤者失时见弃；“实获我心”则是说庄姜真实得我心。朱熹以此章收束全篇，归结到对贤妇的追思。","fullText":"比也。絺綌本为暑服，而今逢凄风，比贤者失时见弃；“实获我心”则是说庄姜真实得我心。朱熹以此章收束全篇，归结到对贤妇的追思。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-013","seg-014","seg-015","seg-016"]},{"id":"zhuxi-shijichuan-kr1c0009:0005-1:part-1","annotationId":"0005","glossId":"0005-1","glossHref":"/shijing/gloss/027-lv-yi/zhuxi-shijichuan-kr1c0009/0005-1","materialId":"zhuxi-shijichuan-kr1c0009","materialTitle":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"layer":"global","layerLabel":"全篇总说","targetText":"綠衣四章章四句","sourceLabel":null,"attributionLabel":"朱熹","sectionLabel":null,"excerpt":"朱熹记《綠衣》为四章、章四句，并据《序》以为庄姜伤己之作，故其章解始终围绕嫡妾失位与追思贤妇展开。","fullText":"朱熹记《綠衣》为四章、章四句，并据《序》以为庄姜伤己之作，故其章解始终围绕嫡妾失位与追思贤妇展开。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]}]}}}
