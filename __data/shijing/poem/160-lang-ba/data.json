uxi","chenhuan-chuanshu","fangyurun-yuanshi","quwanli-quanshi","wangli-yundu"]},{"id":"seg-006:1-4:载跋其胡","segmentId":"seg-006","segmentOrder":6,"surfaceText":"载跋其胡","charStart":1,"charEnd":4,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-2","wangli-yundu:0001-1:part-2"],"materialIds":["chengjunying-jiangjianyuan-zhuxi","wangli-yundu"]},{"id":"seg-006:1-4:載跋其胡","segmentId":"seg-006","segmentOrder":6,"surfaceText":"載跋其胡","charStart":1,"charEnd":4,"entryIds":["chenhuan-chuanshu:0001-1:part-2","fangyurun-yuanshi:0003-1:part-1","quwanli-quanshi:0001-1:part-2"],"materialIds":["chenhuan-chuanshu","fangyurun-yuanshi","quwanli-quanshi"]},{"id":"seg-007:1-4:公孙硕肤","segmentId":"seg-007","segmentOrder":7,"surfaceText":"公孙硕肤","charStart":1,"charEnd":4,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-2","wangli-yundu:0001-1:part-2"],"materialIds":["chengjunying-jiangjianyuan-zhuxi","wangli-yundu"]},{"id":"seg-007:1-4:公孫碩膚","segmentId":"seg-007","segmentOrder":7,"surfaceText":"公孫碩膚","charStart":1,"charEnd":4,"entryIds":["chenhuan-chuanshu:0001-1:part-2","fangyurun-yuanshi:0003-1:part-2","quwanli-quanshi:0001-1:part-2"],"materialIds":["chenhuan-chuanshu","fangyurun-yuanshi","quwanli-quanshi"]},{"id":"seg-008:1-4:德音不瑕","segmentId":"seg-008","segmentOrder":8,"surfaceText":"德音不瑕","charStart":1,"charEnd":4,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-2","chenhuan-chuanshu:0001-1:part-2","fangyurun-yuanshi:0003-1:part-2","quwanli-quanshi:0001-1:part-2","wangli-yundu:0001-1:part-2"],"materialIds":["chengjunying-jiangjianyuan-zhuxi","chenhuan-chuanshu","fangyurun-yuanshi","quwanli-quanshi","wangli-yundu"]}],"entries":[{"id":"chengjunying-jiangjianyuan-zhuxi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/160-lang-ba/chengjunying-jiangjianyuan-zhuxi/0001-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"狼跋其胡，载疐其尾。公孙硕肤，赤舄几几。狼疐其尾，载跋其胡。公孙硕肤，德音不瑕。","sourceLabel":"第 359-360 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"注释","excerpt":"狼跋其胡，载疐其尾。公孙硕肤，赤舄几几。\n跋，践踏，踩着。胡，老狼颔下垂着的肉袋。朱熹诗集传：“胡，颔下悬肉也。”\n载，同“再”，又。疐(zhi)，韩诗作趾，二字相通。脚踩。说文：“疐，碍不行也。”毛传：“老狼有胡，进则跋其胡，退则疐其尾。进退有难，然而不失其猛。”诗人以老狼走路的姿态兴公孙进退维谷的狼狈处境。\n公孙，当时对贵族的称呼，与七月诗中的“公子”性质略同，当也是国公的后代。硕，大。有肤，肥胖。\n赤舄(xi)，以金为饰的红鞋，亦称金舄，是贵族配衮衣礼服穿的鞋，与平日穿的履不同。几几，鞋尖旁出貌。","fullText":"狼跋其胡，载疐其尾。公孙硕肤，赤舄几几。\n跋，践踏，踩着。胡，老狼颔下垂着的肉袋。朱熹诗集传：“胡，颔下悬肉也。”\n载，同“再”，又。疐(zhi)，韩诗作趾，二字相通。脚踩。说文：“疐，碍不行也。”毛传：“老狼有胡，进则跋其胡，退则疐其尾。进退有难，然而不失其猛。”诗人以老狼走路的姿态兴公孙进退维谷的狼狈处境。\n公孙，当时对贵族的称呼，与七月诗中的“公子”性质略同，当也是国公的后代。硕，大。有肤，肥胖。\n赤舄(xi)，以金为饰的红鞋，亦称金舄，是贵族配衮衣礼服穿的鞋，与平日穿的履不同。几几，鞋尖旁出貌。\n狼疐其尾，载跋其胡。公孙硕肤，德音不瑕。\n德音，声誉。不瑕，不已。\n韵读：鱼部一一胡、瑕。微脂合韵一一尾、几。","notes":"据页图与 OCR 整理，保留二章经文与随章注释。","partOrder":1,"anchorIds":["seg-001:1-4:狼跋其胡","seg-002:1-4:载疐其尾","seg-003:1-4:公孙硕肤","seg-004:1-4:赤舄几几"],"glossAnchorIds":["anchor-1-1","anchor-1-2","anchor-1-3","anchor-1-4"],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008"]},{"id":"chengjunying-jiangjianyuan-zhuxi:0001-1:part-2","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/160-lang-ba/chengjunying-jiangjianyuan-zhuxi/0001-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"狼跋其胡，载疐其尾。公孙硕肤，赤舄几几。狼疐其尾，载跋其胡。公孙硕肤，德音不瑕。","sourceLabel":"第 359-360 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"注释","excerpt":"狼疐其尾，载跋其胡。公孙硕肤，德音不瑕。\n德音，声誉。不瑕，不已。\n韵读：鱼部一一胡、瑕。微脂合韵一一尾、几。","fullText":"狼跋其胡，载疐其尾。公孙硕肤，赤舄几几。\n跋，践踏，踩着。胡，老狼颔下垂着的肉袋。朱熹诗集传：“胡，颔下悬肉也。”\n载，同“再”，又。疐(zhi)，韩诗作趾，二字相通。脚踩。说文：“疐，碍不行也。”毛传：“老狼有胡，进则跋其胡，退则疐其尾。进退有难，然而不失其猛。”诗人以老狼走路的姿态兴公孙进退维谷的狼狈处境。\n公孙，当时对贵族的称呼，与七月诗中的“公子”性质略同，当也是国公的后代。硕，大。有肤，肥胖。\n赤舄(xi)，以金为饰的红鞋，亦称金舄，是贵族配衮衣礼服穿的鞋，与平日穿的履不同。几几，鞋尖旁出貌。\n狼疐其尾，载跋其胡。公孙硕肤，德音不瑕。\n德音，声誉。不瑕，不已。\n韵读：鱼部一一胡、瑕。微脂合韵一一尾、几。","notes":"据页图与 OCR 整理，保留二章经文与随章注释。","partOrder":2,"anchorIds":["seg-005:1-4:狼疐其尾","seg-006:1-