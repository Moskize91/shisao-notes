"layer":"span","layerLabel":"诗句片段","targetText":"誰謂河廣，一葦杭之，誰謂宋遠，跂予望之。誰謂河廣，曾不容刀，誰謂宋遠，曾不崇朝。","sourceLabel":null,"attributionLabel":"马瑞辰","sectionLabel":"通释","excerpt":"马瑞辰通释《河廣》，同样抓住“一葦杭之”“曾不容刀”“曾不崇朝”这些层递语句，","fullText":"马瑞辰通释《河廣》，同样抓住“一葦杭之”“曾不容刀”“曾不崇朝”这些层递语句，说明全诗只是极言河狭宋近；正因为近而不能往，才更见夫人以义自制。","notes":null,"partOrder":1,"anchorIds":["seg-002:1-4:一葦杭之","seg-006:1-4:曾不容刀","seg-008:1-4:曾不崇朝"],"glossAnchorIds":["anchor-1-1","anchor-1-2","anchor-1-3"],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008"]},{"id":"maruichen-tongshi:0001-1:part-2","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/061-he-guang/maruichen-tongshi/0001-1","materialId":"maruichen-tongshi","materialTitle":"毛詩傳箋通釋","contributorLine":"清 · 馬瑞辰","publicationYear":1989,"layer":"span","layerLabel":"诗句片段","targetText":"誰謂河廣，一葦杭之，誰謂宋遠，跂予望之。誰謂河廣，曾不容刀，誰謂宋遠，曾不崇朝。","sourceLabel":null,"attributionLabel":"马瑞辰","sectionLabel":"通释","excerpt":"说明全诗只是极言河狭宋近；","fullText":"马瑞辰通释《河廣》，同样抓住“一葦杭之”“曾不容刀”“曾不崇朝”这些层递语句，说明全诗只是极言河狭宋近；正因为近而不能往，才更见夫人以义自制。","notes":null,"partOrder":2,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008"]},{"id":"maruichen-tongshi:0001-1:part-3","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/061-he-guang/maruichen-tongshi/0001-1","materialId":"maruichen-tongshi","materialTitle":"毛詩傳箋通釋","contributorLine":"清 · 馬瑞辰","publicationYear":1989,"layer":"span","layerLabel":"诗句片段","targetText":"誰謂河廣，一葦杭之，誰謂宋遠，跂予望之。誰謂河廣，曾不容刀，誰謂宋遠，曾不崇朝。","sourceLabel":null,"attributionLabel":"马瑞辰","sectionLabel":"通释","excerpt":"正因为近而不能往，才更见夫人以义自制。","fullText":"马瑞辰通释《河廣》，同样抓住“一葦杭之”“曾不容刀”“曾不崇朝”这些层递语句，说明全诗只是极言河狭宋近；正因为近而不能往，才更见夫人以义自制。","notes":null,"partOrder":3,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008"]},{"id":"quwanli-quanshi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHre