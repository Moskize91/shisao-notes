,"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008"]},{"id":"wangli-yundu:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/061-he-guang/wangli-yundu/0001-1","materialId":"wangli-yundu","materialTitle":"詩經韻讀","contributorLine":"现代 · 王力","publicationYear":1980,"layer":"span","layerLabel":"诗句片段","targetText":"谁谓河广，一苇杭之，谁谓宋远，跂予望之。谁谓河广，曾不容刀，谁谓宋远，曾不崇朝。","sourceLabel":"第 174 页","attributionLabel":"王力","sectionLabel":"韵读","excerpt":"王力《诗经韵读》收《河广》二章四句，正文用简体“谁谓河广”“谁谓宋远”；","fullText":"王力《诗经韵读》收《河广》二章四句，正文用简体“谁谓河广”“谁谓宋远”；从重章叠句看，全诗正是反复申说河狭宋近，以加强思宋而不能往的语势。","notes":null,"partOrder":1,"anchorIds":["seg-001:1-4:谁谓河广","seg-003:1-4:谁谓宋远"],"glossAnchorIds":["anchor-1-1","anchor-1-2"],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008"]},{"id":"wangli-yundu:0001-1:part-2","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/061-he-guang/wangli-yundu/0001-1","materialId":"wangli-yundu","materialTitle":"詩經韻讀","contributorLine":"现代 · 王力","publicationYear":1980,"layer":"span","layerLabel":"诗句片段","targetText":"谁谓河广，一苇杭之，谁谓宋远，跂予望之。谁谓河广，曾不容刀，谁谓宋远，曾不崇朝。","sourceLabel":"第 174 页","attributionLabel":"王力","sectionLabel":"韵读","excerpt":"从重章叠句看，全诗正是反复申说河狭宋近，","fullText":"王力《诗经韵读》收《河广》二章四句，正文用简体“谁谓河广”“谁谓宋远”；从重章叠句看，全诗正是反复申说河狭宋近，以加强思宋而不能往的语势。","notes":null,"partOrder":2,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008"]},{"id":"wangli-yundu:0001-1:part-3","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/061-he-guang/wangli-yundu/0001-1","materialId":"wangli-yundu","materialTitle":"詩經韻讀","contributorLine":"现代 · 王力","publicationYear":1980,"layer":"span","layerLabel":"诗句片段","targetText":"谁谓河广，一苇杭之，谁谓宋远，跂予望之。谁谓河广，曾不容刀，谁谓宋远，曾不崇朝。","sourceLabel":"第 174 页","attributionLabel":"王力","sectionLabel":"韵读","excerpt":"以加强思宋而不能往的语势。","fullText":"王力《诗经韵读》收《河广》二章四句，正文用简