:"清 · 陳奐","publicationYear":1847,"glossCount":2,"partCount":2},{"id":"wangli-yundu","title":"詩經韻讀","contributorLine":"现代 · 王力","publicationYear":1980,"glossCount":2,"partCount":2},{"id":"quwanli-quanshi","title":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"glossCount":2,"partCount":2},{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"glossCount":5,"partCount":5},{"id":"maruichen-tongshi","title":"毛詩傳箋通釋","contributorLine":"清 · 馬瑞辰","publicationYear":1989,"glossCount":1,"partCount":1},{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"glossCount":5,"partCount":5}],"stats":{"materialCount":8,"glossCount":27,"anchoredPartCount":0,"overviewPartCount":10},"overview":{"prefaceEntryIds":["chenhuan-chuanshu:0001-1:part-1","maoheng-zhushu-kr1c0004:0001-1:part-1"],"globalEntryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-1","fangyurun-yuanshi:0001-1:part-1","fangyurun-yuanshi:0002-1:part-1","fangyurun-yuanshi:0003-1:part-1","fangyurun-yuanshi:0005-1:part-1","quwanli-quanshi:0001-1:part-1","wangli-yundu:0001-1:part-1","zhuxi-shijichuan-kr1c0009:0005-1:part-1"]},"focusAnchors":[],"entries":[{"id":"chengjunying-jiangjianyuan-zhuxi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/028-yan-yan/chengjunying-jiangjianyuan-zhuxi/0001-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"global","layerLabel":"全篇总说","targetText":"题解","sourceLabel":"第 53 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","excerpt":"程、蒋把《燕燕》定为送人远嫁之诗，认为全篇核心在兄长送妹出嫁的惜别情境，不必拘泥于庄姜送归妾说。题解强调前三章极写送别时“瞻望弗及”的远望与泣立，四章再追述仲氏之贤，于惜别之外更添不忍遽舍之意，因此被后人称为送别诗之祖。","fullText":"程、蒋把《燕燕》定为送人远嫁之诗，认为全篇核心在兄长送妹出嫁的惜别情境，不必拘泥于庄姜送归妾说。题解强调前三章极写送别时“瞻望弗及”的远望与泣立，四章再追述仲氏之贤，于惜别之外更添不忍遽舍之意，因此被后人称为送别诗之祖。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"chengjunying-jiangjianyuan-zhuxi:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/028-yan-yan/chengjunying-jiangjianyuan-zhuxi/0002-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"燕燕于飞，差池其羽。之子于归，远送于野。瞻望弗及，泣涕如雨！","sourceLabel":"第 54 页","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"excerpt":"首章用燕子翩飞、羽毛参差起兴，渲染送别情景。程、蒋认为“之子于归”明确是女子出嫁，“远送于野”与“泣涕如雨”则把送别者目送不及、涕泣交流的情态一下写出，奠定全篇凄恻基调。","fullText":"首章用燕子翩飞、羽毛参差起兴，渲染送别情景。程、蒋认为“之子于归”明确是女子出嫁，“远送于野”与“泣涕如雨”则把送别者目送不及、涕泣交流的情态一下写出，奠定全篇凄恻基调。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006"]},{"id":"chengjunying-jiangjianyuan-zhuxi:0003-1:part-1","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/028-yan-yan/chengjunying-jiangjianyuan-zhuxi/0003-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"燕燕于飞，颉之颃之。之子于归，远于将之。瞻望弗及，伫立以泣。","sourceLabel":"第 54 页","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"excerpt":"次章改写燕飞顿仰高低，与送者目送愈远相呼应；“远于将之”是送到更远处去，“伫立以泣”则由首章的“泣涕如雨”转成久久伫立，更见依恋难舍。程、蒋据此指出本篇善于以重复递进加深别情。","fullText":"次章改写燕飞顿仰高低，与送者目送愈远相呼应；“远于将之”是送到更远处去，“伫立以泣”则由首章的“泣涕如雨”转成久久伫立，更见依恋难舍。程、蒋据此指出本篇善于以重复递进加深别情。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-007","seg-008","seg-009","seg-010","seg-011","seg-012"]},{"id":"chengjunying-jiangjianyuan-zhuxi:0004-1:part-1","annotationId":"0004","glossId":"0004-1","glossHref":"/shijing/gloss/028-yan-yan/chengjunying-jiangjianyuan-zhuxi/0004-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"燕燕于飞，下上其音。之子于归，远送于南。瞻望弗及，实劳我心。","sourceLabel":"第 54-55 页","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"excerpt":"三章将燕声随飞上下的听觉描写加进来，使送别场面更为立体；“远送于南”表明送行渐行渐远，“实劳我心”则从外在景象收回到内心劳思。程、蒋认为前三章层层复沓，正是本诗传神处。","fullText":"三章将燕声随飞上下的听觉描写加进来，使送别场面更为立体；“远送于南”表明送行渐行渐远，“实劳我心”则从外在景象收回到内心劳思。程、蒋认为前三章层层复沓，正是本诗传神处。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-013","seg-014","seg-015","seg-016","seg-017","seg-018"]},{"id":"chengjunying-jiangjianyuan-zhuxi:0005-1:part-1","annotationId":"0005","glossId":"0005-1","glossHref":"/shijing/gloss/028-yan-yan/chengjunying-jiangjianyuan-zhuxi/0005-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"仲氏任只，其心塞渊。终温且惠，淑慎其身。先君之思，以勖寡人。","sourceLabel":"第 55 页","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"excerpt":"末章转而追叙仲氏德行，称其诚信深厚、温惠淑慎，并能承先君遗意以勉励寡人。程、蒋认为这使全诗从一般送别上升到对被送者人格的追怀，也因此别情更显沉痛。","fullText":"末章转而追叙仲氏德行，称其诚信深厚、温惠淑慎，并能承先君遗意以勉励寡人。程、蒋认为这使全诗从一般送别上升到对被送者人格的追怀，也因此别情更显沉痛。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-019","seg-020","seg-021","seg-022","seg-023","seg-024"]},{"id":"chenhuan-chuanshu:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/028-yan-yan/chenhuan-chuanshu/0001-1","materialId":"chenhuan-chuanshu","materialTitle":"詩毛氏傳疏","contributorLine":"清 · 陳奐","publicationYear":1847,"layer":"preface","layerLabel":"篇序","targetText":"燕燕衛莊姜送歸妾也","sourceLabel":"第 55 页","attributionLabel":"诗序","sectionLabel":"序","excerpt":"序：《燕燕》，衛莊姜送歸妾也。","fullText":"序：《燕燕》，衛莊姜送歸妾也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"chenhuan-chuanshu:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/028-yan-yan/chenhuan-chuanshu/0002-1","materialId":"chenhuan-chuanshu","materialTitle":"詩毛氏傳疏","contributorLine":"清 · 陳奐","publicationYear":1847,"layer":"span","layerLabel":"诗句片段","targetText":"燕燕于飛，差池其羽。之子于歸，遠送于野。瞻望弗及，泣涕如雨。燕燕于飛，頡之頏之。之子于歸，遠于將之。瞻望弗及，佇立以泣。燕燕于飛，上下其音。之子于歸，遠送于南。瞻望弗及，實勞我心。仲氏任只，其心塞淵。終温且惠，淑慎其身。先君之思，以勗寡人。","sourceLabel":"第 55-56 页","attributionLabel":"陈奂","sectionLabel":"疏","excerpt":"陈奂遵《序》旧说，以《燕燕》为庄姜送归戴嬀之作。其疏重在据《左传》及卫国世系说明被送者可为州吁之母戴嬀，前三章皆写送别不忍，末章历叙其温惠淑慎与相勗之德，由此见庄姜之贤与二人情义之深。","fullText":"陈奂遵《序》旧说，以《燕燕》为庄姜送归戴嬀之作。其疏重在据《左传》及卫国世系说明被送者可为州吁之母戴嬀，前三章皆写送别不忍，末章历叙其温惠淑慎与相勗之德，由此见庄姜之贤与二人情义之深。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016","seg-017","seg-018","seg-019","seg-020","seg-021","seg-022","seg-023","seg-024"]},{"id":"fangyurun-yuanshi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/028-yan-yan/fangyurun-yuanshi/0001-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"global","layerLabel":"全篇总说","targetText":"燕燕㊟衛莊姜送歸妾也。","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"题注","excerpt":"方玉润在题注中径定《燕燕》为卫庄姜送归妾之诗，与《序》说一致。","fullText":"方玉润在题注中径定《燕燕》为卫庄姜送归妾之诗，与《序》说一致。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"fangyurun-yuanshi:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/028-yan-yan/fangyurun-yuanshi/0002-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"global","layerLabel":"全篇总说","targetText":"总评","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"总评","excerpt":"总评中方玉润明言《序》说与《左传》可互相证成，被送者即戴嬀；他尤其称道庄姜对戴嬀情义之深，认为前三章送别已极凄楚，末章再历叙其贤，更见非寻常妇人离别之情所可比。","fullText":"总评中方玉润明言《序》说与《左传》可互相证成，被送者即戴嬀；他尤其称道庄姜对戴嬀情义之深，认为前三章送别已极凄楚，末章再历叙其贤，更见非寻常妇人离别之情所可比。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"fangyurun-yuanshi:0003-1:part-1","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/028-yan-yan/fangyurun-yuanshi/0003-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"global","layerLabel":"全篇总说","targetText":"眉评","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"眉评","excerpt":"眉评指出前三章不过写送别情景，末章追念其贤，因而更觉难舍；又说“先君相勖，而竟不能长相保”，语意沉痛，不忍卒读。","fullText":"眉评指出前三章不过写送别情景，末章追念其贤，因而更觉难舍；又说“先君相勖，而竟不能长相保”，语意沉痛，不忍卒读。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"fangyurun-yuanshi:0004-1:part-1","annotationId":"0004","glossId":"0004-1","glossHref":"/shijing/gloss/028-yan-yan/fangyurun-yuanshi/0004-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"term","layerLabel":"字词注","targetText":"燕燕于飛差池其羽之子于歸頡之頏之佇立以泣其心塞淵以勗寡人","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"集释","excerpt":"集释详考“燕燕”为鳦，“差池”为不齐貌，“歸”为大归之辞；又释“頡頏”为飞势高下，“佇立”为久立，“塞淵”言心诚实而深，“勗”为勉励。诸条都用来支撑庄姜送戴嬀且称美其德的解读。","fullText":"集释详考“燕燕”为鳦，“差池”为不齐貌，“歸”为大归之辞；又释“頡頏”为飞势高下，“佇立”为久立，“塞淵”言心诚实而深，“勗”为勉励。诸条都用来支撑庄姜送戴嬀且称美其德的解读。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-008","seg-012","seg-020","seg-024"]},{"id":"fangyurun-yuanshi:0005-1:part-1","annotationId":"0005","glossId":"0005-1","glossHref":"/shijing/gloss/028-yan-yan/fangyurun-yuanshi/0005-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"global","layerLabel":"全篇总说","targetText":"标韵","sourceLabel":null,"attributionLabel":"标韵","sectionLabel":null,"excerpt":"标韵以首章“羽”“雨”并“野”叶麌马通韵，次章“頏”“將”与“及”“泣”分阳、缉两收，三章“音”“南”“心”侵覃通韵，四章“淵”“身”“人”则真先通叶。章章换韵而情绪层递。","fullText":"标韵以首章“羽”“雨”并“野”叶麌马通韵，次章“頏”“將”与“及”“泣”分阳、缉两收，三章“音”“南”“心”侵覃通韵，四章“淵”“身”“人”则真先通叶。章章换韵而情绪层递。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"maoheng-zhushu-kr1c0004:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/028-yan-yan/maoheng-zhushu-kr1c0004/0001-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"preface","layerLabel":"篇序","targetText":"燕燕衛莊姜送歸妾也","sourceLabel":null,"attributionLabel":"诗序","sectionLabel":"序","excerpt":"序：《燕燕》，衛莊姜送歸妾也。","fullText":"序：《燕燕》，衛莊姜送歸妾也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"maoheng-zhushu-kr1c0004:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/028-yan-yan/maoheng-zhushu-kr1c0004/0002-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"span","layerLabel":"诗句片段","targetText":"燕燕于飛差池其羽之子于歸遠送于野瞻望弗及泣涕如雨","sourceLabel":null,"attributionLabel":"毛传","sectionLabel":null,"excerpt":"傳：燕燕，鳦也。差池，其羽舒也。之子，戴媯也。歸，大歸也。","fullText":"傳：燕燕，鳦也。差池，其羽舒也。之子，戴媯也。歸，大歸也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006"]},{"id":"maoheng-zhushu-kr1c0004:0003-1:part-1","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/028-yan-yan/maoheng-zhushu-kr1c0004/0003-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"span","layerLabel":"诗句片段","targetText":"燕燕于飛頡之頏之之子于歸遠于將之瞻望弗及佇立以泣","sourceLabel":null,"attributionLabel":"毛传","sectionLabel":null,"excerpt":"傳：飛而上曰頡，飛而下曰頏。將，送也。","fullText":"傳：飛而上曰頡，飛而下曰頏。將，送也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-007","seg-008","seg-009","seg-010","seg-011","seg-012"]},{"id":"maoheng-zhushu-kr1c0004:0004-1:part-1","annotationId":"0004","glossId":"0004-1","glossHref":"/shijing/gloss/028-yan-yan/maoheng-zhushu-kr1c0004/0004-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"span","layerLabel":"诗句片段","targetText":"燕燕于飛上下其音之子于歸遠送于南瞻望弗及實勞我心","sourceLabel":null,"attributionLabel":"毛传","sectionLabel":null,"excerpt":"傳：音，聲也。南，陳在衛之南。","fullText":"傳：音，聲也。南，陳在衛之南。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-013","seg-014","seg-015","seg-016","seg-017","seg-018"]},{"id":"maoheng-zhushu-kr1c0004:0005-1:part-1","annotationId":"0005","glossId":"0005-1","glossHref":"/shijing/gloss/028-yan-yan/maoheng-zhushu-kr1c0004/0005-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"span","layerLabel":"诗句片段","targetText":"仲氏任只其心塞淵終温且惠淑慎其身先君之思以勗寡人","sourceLabel":null,"attributionLabel":"毛传","sectionLabel":null,"excerpt":"傳：仲氏，戴媯字也。任，大也。塞，瘱也。淵，深也。終温且惠，淑慎其身，先君之思，以勗寡人，思先君之德，以勸寡人。","fullText":"傳：仲氏，戴媯字也。任，大也。塞，瘱也。淵，深也。終温且惠，淑慎其身，先君之思，以勗寡人，思先君之德，以勸寡人。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-019","seg-020","seg-021","seg-022","seg-023","seg-024"]},{"id":"maruichen-tongshi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/028-yan-yan/maruichen-tongshi/0001-1","materialId":"maruichen-tongshi","materialTitle":"毛詩傳箋通釋","contributorLine":"清 · 馬瑞辰","publicationYear":1989,"layer":"span","layerLabel":"诗句片段","targetText":"燕燕于飛，差池其羽。之子于歸，遠送于野。瞻望弗及，泣涕如雨。燕燕于飛，頡之頏之。之子于歸，遠于將之。瞻望弗及，佇立以泣。燕燕于飛，上下其音。之子于歸，遠送于南。瞻望弗及，實勞我心。仲氏任只，其心塞淵。終温且惠，淑慎其身。先君之思，以勗寡人。","sourceLabel":"第 103-104 页","attributionLabel":"马瑞辰","sectionLabel":"按","excerpt":"马瑞辰于《燕燕》一篇大体仍从庄姜送戴嬀说，但按语尤其重考“頡頏”“塞淵”“勗”等字义，并申明末章称美仲氏贤德，足见二人相知相善。其解偏重以史事与训诂互证，认为本篇情深而有礼，不是泛泛送别。","fullText":"马瑞辰于《燕燕》一篇大体仍从庄姜送戴嬀说，但按语尤其重考“頡頏”“塞淵”“勗”等字义，并申明末章称美仲氏贤德，足见二人相知相善。其解偏重以史事与训诂互证，认为本篇情深而有礼，不是泛泛送别。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016","seg-017","seg-018","seg-019","seg-020","seg-021","seg-022","seg-023","seg-024"]},{"id":"quwanli-quanshi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/028-yan-yan/quwanli-quanshi/0001-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"global","layerLabel":"全篇总说","targetText":"全篇旨意","sourceLabel":"第 33 页","attributionLabel":"屈万里","sectionLabel":"注释","excerpt":"屈万里在《燕燕》首条注释中说王质以为国君送女弟适他国之诗，其说近是，但旧说卫庄姜送归妾仍可备考。整体上他对送妹出嫁说更为倾向，同时保留庄姜戴嬀的传统解法。","fullText":"屈万里在《燕燕》首条注释中说王质以为国君送女弟适他国之诗，其说近是，但旧说卫庄姜送归妾仍可备考。整体上他对送妹出嫁说更为倾向，同时保留庄姜戴嬀的传统解法。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"quwanli-quanshi:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/028-yan-yan/quwanli-quanshi/0002-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"term","layerLabel":"字词注","targetText":"差池其羽之子于归颉之颃之远于将之仲氏任只其心塞渊以勖寡人","sourceLabel":"第 33 页","attributionLabel":"屈万里","sectionLabel":"注释","excerpt":"屈万里释“差池”为不齐，“之子”为嫁女，“頡頏”为飞势高下，“將”为送，“任”为诚笃，“塞”为实，“淵”为深，“勖”为勉。整组注释偏重词义名物，而对诗旨则更近送别妹嫁之说。","fullText":"屈万里释“差池”为不齐，“之子”为嫁女，“頡頏”为飞势高下，“將”为送，“任”为诚笃，“塞”为实，“淵”为深，“勖”为勉。整组注释偏重词义名物，而对诗旨则更近送别妹嫁之说。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-002","seg-003","seg-008","seg-010","seg-019","seg-020","seg-024"]},{"id":"wangli-yundu:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/028-yan-yan/wangli-yundu/0001-1","materialId":"wangli-yundu","materialTitle":"詩經韻讀","contributorLine":"现代 · 王力","publicationYear":1980,"layer":"global","layerLabel":"全篇总说","targetText":"《燕燕》韵读总说","sourceLabel":"第 151-152 页","attributionLabel":"王力","sectionLabel":"韵读","excerpt":"王力将《燕燕》读作四章换韵：首章“飛(piuei)”协“歸(kiuai)”而“羽(hua)”“野(ya)”与“雨(hua)”入鱼麌通韵；次章“頏(hang)”与“將(tziang)”归阳部，末句“及(gjip)”“泣(khiap)”转缉部；三章“音(iam)”“南(nom)”与“心(siom)”入侵覃通韵；四章“淵(yuen)”“身(sjien)”“人(njien)”又转真部。章章分换而节奏明晰。","fullText":"王力将《燕燕》读作四章换韵：首章“飛(piuei)”协“歸(kiuai)”而“羽(hua)”“野(ya)”与“雨(hua)”入鱼麌通韵；次章“頏(hang)”与“將(tziang)”归阳部，末句“及(gjip)”“泣(khiap)”转缉部；三章“音(iam)”“南(nom)”与“心(siom)”入侵覃通韵；四章“淵(yuen)”“身(sjien)”“人(njien)”又转真部。章章分换而节奏明晰。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"wangli-yundu:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/028-yan-yan/wangli-yundu/0002-1","materialId":"wangli-yundu","materialTitle":"詩經韻讀","contributorLine":"现代 · 王力","publicationYear":1980,"layer":"span","layerLabel":"诗句片段","targetText":"燕燕于飞，差池其羽。之子于归，远送于野。瞻望弗及，泣涕如雨。燕燕于飞，颉之颃之。之子于归，远于将之。瞻望弗及，伫立以泣。燕燕于飞，下上其音。之子于归，远送于南。瞻望弗及，实劳我心。仲氏任只，其心塞渊。终温且惠，淑慎其身。先君之思，以勖寡人。","sourceLabel":"第 151-152 页","attributionLabel":"王力","sectionLabel":"韵读","excerpt":"页图可读《燕燕》前两章分别以鱼麌、阳缉分层收束，第三章转侵覃，第四章转真部。王力所记注音表明，本篇虽多复沓句，但每章韵脚安排不同，因而在反复中仍有鲜明层次。","fullText":"页图可读《燕燕》前两章分别以鱼麌、阳缉分层收束，第三章转侵覃，第四章转真部。王力所记注音表明，本篇虽多复沓句，但每章韵脚安排不同，因而在反复中仍有鲜明层次。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016","seg-017","seg-018","seg-019","seg-020","seg-021","seg-022","seg-023","seg-024"]},{"id":"zhuxi-shijichuan-kr1c0009:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/028-yan-yan/zhuxi-shijichuan-kr1c0009/0001-1","materialId":"zhuxi-shijichuan-kr1c0009","materialTitle":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"layer":"span","layerLabel":"诗句片段","targetText":"燕燕于飛，差池其羽。之子于歸，遠送于野。瞻望弗及，泣涕如雨。","sourceLabel":null,"attributionLabel":"朱熹","sectionLabel":null,"excerpt":"興也。朱熹从《序》说，以《燕燕》为庄姜送归妾之诗；首章借燕飞起兴，写送别者远望不及、涕泣如雨的情状。","fullText":"興也。朱熹从《序》说，以《燕燕》为庄姜送归妾之诗；首章借燕飞起兴，写送别者远望不及、涕泣如雨的情状。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006"]},{"id":"zhuxi-shijichuan-kr1c0009:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/028-yan-yan/zhuxi-shijichuan-kr1c0009/0002-1","materialId":"zhuxi-shijichuan-kr1c0009","materialTitle":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"layer":"span","layerLabel":"诗句片段","targetText":"燕燕于飛，頡之頏之。之子于歸，遠于將之。瞻望弗及，佇立以泣。","sourceLabel":null,"attributionLabel":"朱熹","sectionLabel":null,"excerpt":"興也。頡頏写燕飞高下，將是送。朱熹认为此章仍承首章送别之意，但由泣涕转为佇立，见得情深而不自胜。","fullText":"興也。頡頏写燕飞高下，將是送。朱熹认为此章仍承首章送别之意，但由泣涕转为佇立，见得情深而不自胜。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-007","seg-008","seg-009","seg-010","seg-011","seg-012"]},{"id":"zhuxi-shijichuan-kr1c0009:0003-1:part-1","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/028-yan-yan/zhuxi-shijichuan-kr1c0009/0003-1","materialId":"zhuxi-shijichuan-kr1c0009","materialTitle":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"layer":"span","layerLabel":"诗句片段","targetText":"燕燕于飛，上下其音。之子于歸，遠送于南。瞻望弗及，實勞我心。","sourceLabel":null,"attributionLabel":"朱熹","sectionLabel":null,"excerpt":"興也。上下其音，言燕飞上下而其鸣相随；實是也。朱熹以为此章由所见所闻转入内心劳思，别情至此更深。","fullText":"興也。上下其音，言燕飞上下而其鸣相随；實是也。朱熹以为此章由所见所闻转入内心劳思，别情至此更深。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-013","seg-014","seg-015","seg-016","seg-017","seg-018"]},{"id":"zhuxi-shijichuan-kr1c0009:0004-1:part-1","annotationId":"0004","glossId":"0004-1","glossHref":"/shijing/gloss/028-yan-yan/zhuxi-shijichuan-kr1c0009/0004-1","materialId":"zhuxi-shijichuan-kr1c0009","materialTitle":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"layer":"span","layerLabel":"诗句片段","targetText":"仲氏任只，其心塞淵。終温且惠，淑慎其身。先君之思，以勗寡人。","sourceLabel":null,"attributionLabel":"朱熹","sectionLabel":null,"excerpt":"賦也。朱熹释仲氏为戴嬀字，任为大，塞淵谓诚实深厚；末章追叙其德，并言其能思先君之意以勉寡人，所以见庄姜不独伤别，且怀其贤。","fullText":"賦也。朱熹释仲氏为戴嬀字，任为大，塞淵谓诚实深厚；末章追叙其德，并言其能思先君之意以勉寡人，所以见庄姜不独伤别，且怀其贤。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-019","seg-020","seg-021","seg-022","seg-023","seg-024"]},{"id":"zhuxi-shijichuan-kr1c0009:0005-1:part-1","annotationId":"0005","glossId":"0005-1","glossHref":"/shijing/gloss/028-yan-yan/zhuxi-shijichuan-kr1c0009/0005-1","materialId":"zhuxi-shijichuan-kr1c0009","materialTitle":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"layer":"global","layerLabel":"全篇总说","targetText":"燕燕四章章六句","sourceLabel":null,"attributionLabel":"朱熹","sectionLabel":null,"excerpt":"朱熹记《燕燕》为四章、章六句，并仍以庄姜送归妾说统摄全篇，所以章解皆兼见惜别与称德两层。","fullText":"朱熹记《燕燕》为四章、章六句，并仍以庄姜送归妾说统摄全篇，所以章解皆兼见惜别与称德两层。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]}]}}}
