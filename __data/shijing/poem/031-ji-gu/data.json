nchorIds":[]}]}]},"materials":[{"id":"maoheng-zhushu-kr1c0004","title":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"glossCount":6,"partCount":6},{"id":"zhuxi-shijichuan-kr1c0009","title":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"glossCount":6,"partCount":6},{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","contributorLine":"清 · 陳奐","publicationYear":1847,"glossCount":2,"partCount":2},{"id":"wangli-yundu","title":"詩經韻讀","contributorLine":"现代 · 王力","publicationYear":1980,"glossCount":2,"partCount":2},{"id":"quwanli-quanshi","title":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"glossCount":2,"partCount":2},{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"glossCount":5,"partCount":5},{"id":"maruichen-tongshi","title":"毛詩傳箋通釋","contributorLine":"清 · 馬瑞辰","publicationYear":1989,"glossCount":1,"partCount":1},{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"glossCount":6,"partCount":6}],"stats":{"materialCount":8,"glossCount":30,"anchoredPartCount":0,"overviewPartCount":10},"overview":{"prefaceEntryIds":["chenhuan-chuanshu:0001-1:part-1","maoheng-zhushu-kr1c0004:0001-1:part-1"],"globalEntryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-1","fangyurun-yuanshi:0001-1:part-1","fangyurun-yuanshi:0002-1:part-1","fangyurun-yuanshi:0003-1:part-1","fangyurun-yuanshi:0005-1:part-1","quwanli-quanshi:0001-1:part-1","wangli-yundu:0001-1:part-1","zhuxi-shijichuan-kr1c0009:0006-1:part-1"]},"focusAnchors":[],"entries":[{"id":"chengjunying-jiangjianyuan-zhuxi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/031-ji-gu/chengjunying-jiangjianyuan-zhuxi/0001-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"global","layerLabel":"全篇总说","targetText":"题解","sourceLabel":"第 60 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","excerpt":"程、蒋将《击鼓》定为卫国戍卒久戍思归不得之诗。题解回顾《序》以来多附会州吁伐郑、平陈与宋等史事，但强调全篇真正动人的核心不在某一战役，而在征人由从军劳苦、行伍离散，进而追忆夫妻别誓、终至怨叹久役无归的心路层递。","fullText":"程、蒋将《击鼓》定为卫国戍卒久戍思归不得之诗。题解回顾《序》以来多附会州吁伐郑、平陈与宋等史事，但强调全篇真正动人的核心不在某一战役，而在征人由从军劳苦、行伍离散，进而追忆夫妻别誓、终至怨叹久役无归的心路层递。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"chengjunying-jiangjianyuan-zhuxi:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/031-ji-gu/chengjunying-jiangjianyuan-zhuxi/0002-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"击鼓其镗，踊跃用兵。土国城漕，我独南行。","sourceLabel":"第 60-61 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"注析","excerpt":"程、蒋释“镗”为击鼓声，“兵”为兵器，“土国城漕”谓在国内服役土工、于漕邑筑城，而“我独南行”则写自己偏被派赴南征。首章通过与境内劳役相陪衬，突出远戍者处境尤苦。","fullText":"程、蒋释“镗”为击鼓声，“兵”为兵器，“土国城漕”谓在国内服役土工、于漕邑筑城，而“我独南行”则写自己偏被派赴南征。首章通过与境内劳役相陪衬，突出远戍者处境尤苦。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004"]},{"id":"chengjunying-jiangjianyuan-zhuxi:0003-1:part-1","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/031-ji-gu/chengjunying-jiangjianyuan-zhuxi/0003-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"从孙子仲，平陈与宋。不我以归，忧心有忡。","sourceLabel":"第 61 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"注析","excerpt":"程、蒋释孙子仲为卫将，认为“平陈与宋”可指当时相关军行，而“不我以归”即不让我回来，“有忡”为忧惧不安。此章点明久役不得归队返家的现实，是全篇怨情的正面落点。","fullText":"程、蒋释孙子仲为卫将，认为“平陈与宋”可指当时相关军行，而“不我以归”即不让我回来，“有忡”为忧惧不安。此章点明久役不得归队返家的现实，是全篇怨情的正面落点。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-005","seg-006","seg-007","seg-008"]},{"id":"chengjunying-jiangjianyuan-zhuxi:0004-1:part-1","annotationId":"0004","glossId":"0004-1","glossHref":"/shijing/gloss/031-ji-gu/chengjunying-jiangjianyuan-zhuxi/0004-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"爰居爰处，爰丧其马。于以求之，于林之下。","sourceLabel":"第 61 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"注析","excerpt":"程、蒋认为此章最见军伍离散之状：士卒散处无纪，乃至丧马、入林求觅。“爰居爰处”与“爰丧其马”并列，使征戍之乱象在短短四句中显得格外具体。","fullText":"程、蒋认为此章最见军伍离散之状：士卒散处无纪，乃至丧马、入林求觅。“爰居爰处”与“爰丧其马”并列，使征戍之乱象在短短四句中显得格外具体。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-009","seg-010","seg-011","seg-012"]},{"id":"chengjunying-jiangjianyuan-zhuxi:0005-1:part-1","annotationId":"0005","glossId":"0005-1","glossHref":"/shijing/gloss/031-ji-gu/chengjunying-jiangjianyuan-zhuxi/0005-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"死生契阔，与子成说。执子之手，与子偕老。","sourceLabel":"第 61-62 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"注析","excerpt":"程、蒋释“契阔”为结合与离别对举的誓词回忆，认为这一章忽然转入夫妻临别盟誓，使前面战乱劳苦都被映照得更可悲。全篇最著名的名句，在这里是征人思室家不得的情感高潮，而非单独的情爱小唱。","fullText":"程、蒋释“契阔”为结合与离别对举的誓词回忆，认为这一章忽然转入夫妻临别盟誓，使前面战乱劳苦都被映照得更可悲。全篇最著名的名句，在这里是征人思室家不得的情感高潮，而非单独的情爱小唱。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-013","seg-014","seg-015","seg-016"]},{"id":"chengjunying-jiangjianyuan-zhuxi:0006-1:part-1","annotationId":"0006","glossId":"0006-1","glossHref":"/shijing/gloss/031-ji-gu/chengjunying-jiangjianyuan-zhuxi/0006-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"于嗟阔兮，不我活兮。于嗟洵兮，不我信兮。","sourceLabel":"第 62 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"注析","excerpt":"末章中程、蒋释“活”为聚会、“信”为守约，认为这是对久役不返最直接的怨叹：昔日所誓今皆落空，夫妻长隔，不得团聚，前盟亦不能再申。全诗以此收束，既有兵役无已之怨，也有室家离散之悲。","fullText":"末章中程、蒋释“活”为聚会、“信”为守约，认为这是对久役不返最直接的怨叹：昔日所誓今皆落空，夫妻长隔，不得团聚，前盟亦不能再申。全诗以此收束，既有兵役无已之怨，也有室家离散之悲。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-017","seg-018","seg-019","seg-020"]},{"id":"chenhuan-chuanshu:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/031-ji-gu/chenhuan-chuanshu/0001-1","materialId":"chenhuan-chuanshu","materialTitle":"詩毛氏傳疏","contributorLine":"清 · 陳奐","publicationYear":1847,"layer":"preface","layerLabel":"篇序","targetText":"擊鼓怨州吁也衛州吁用兵暴亂使公孫文仲將而平陳與宋國人怨其勇而無禮也","sourceLabel":"第 59 页","attributionLabel":"诗序","sectionLabel":"序","excerpt":"序：《擊鼓》，怨州吁也。衛州吁用兵暴亂，使公孫文仲將而平陳與宋，國人怨其勇而無禮也。","fullText":"序：《擊鼓》，怨州吁也。衛州吁用兵暴亂，使公孫文仲將而平陳與宋，國人怨其勇而無禮也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"chenhuan-chuanshu:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/031-ji-gu/chenhuan-chuanshu/0002-1","materialId":"chenhuan-chuanshu","materialTitle":"詩毛氏傳疏","contributorLine":"清 · 陳奐","publicationYear":1847,"layer":"span","layerLabel":"诗句片段","targetText":"擊鼓其鏜，踊躍用兵。土國城漕，我獨南行。從孫子仲，平陳與宋。不我以歸，憂心有忡。爰居爰處，爰喪其馬。于以求之？于林之下。死生契闊，與子成説。執子之手，與子偕老。于嗟闊兮，不我活兮。于嗟洵兮，不我信兮。","sourceLabel":"第 59-60 页","attributionLabel":"陈奂","sectionLabel":"疏","excerpt":"陈奂遵《序》说，以《擊鼓》系州吁用兵暴乱所致，重在申明“平陳與宋”与当时史事可相证。其疏既释征行劳苦，也特别指出后两章由军旅之苦转入思室家、伤前盟，所以国人所怨，不仅在州吁无礼，亦在久役不返、夫妻离隔。","fullText":"陈奂遵《序》说，以《擊鼓》系州吁用兵暴乱所致，重在申明“平陳與宋”与当时史事可相证。其疏既释征行劳苦，也特别指出后两章由军旅之苦转入思室家、伤前盟，所以国人所怨，不仅在州吁无礼，亦在久役不返、夫妻离隔。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016","seg-017","seg-018","seg-019","seg-020"]},{"id":"fangyurun-yuanshi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/031-ji-gu/fangyurun-yuanshi/0001-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"global","layerLabel":"全篇总说","targetText":"擊鼓㊟衛戍卒思歸不得也。","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"题注","excerpt":"方玉润在题注中径定《擊鼓》为卫戍卒思归不得之诗，不从《小序》怨州吁的旧说。","fullText":"方玉润在题注中径定《擊鼓》为卫戍卒思归不得之诗，不从《小序》怨州吁的旧说。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"fangyurun-yuanshi:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/031-ji-gu/fangyurun-yuanshi/0002-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"global","layerLabel":"全篇总说","targetText":"总评","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"总评","excerpt":"方玉润详驳《小序》与郑笺以州吁伐郑实之的说法，认为只凭“平陳與宋”“不我以歸”二语即可见其多有不合。依他看，此诗当作于救陈之后边防久戍之时，先叙南行之故，次写军伍懈散，再追忆室家叙别之盟，末以久戍不归、前言尽负作结，最足见戍卒思归不得之苦。","fullText":"方玉润详驳《小序》与郑笺以州吁伐郑实之的说法，认为只凭“平陳與宋”“不我以歸”二语即可见其多有不合。依他看，此诗当作于救陈之后边防久戍之时，先叙南行之故，次写军伍懈散，再追忆室家叙别之盟，末以久戍不归、前言尽负作结，最足见戍卒思归不得之苦。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"fangyurun-yuanshi:0003-1:part-1","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/031-ji-gu/fangyurun-yuanshi/0003-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"global","layerLabel":"全篇总说","targetText":"眉评","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"眉评","excerpt":"方玉润眉评特别称道第四章追叙前盟，使文势转曲，与下章连用“于嗟”反转上意相配，最见章法之妙。","fullText":"方玉润眉评特别称道第四章追叙前盟，使文势转曲，与下章连用“于嗟”反转上意相配，最见章法之妙。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"fangyurun-yuanshi:0004-1:part-1","annotationId":"0004","glossId":"0004-1","glossHref":"/shijing/gloss/031-ji-gu/fangyurun-yuanshi/0004-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"term","layerLabel":"字词注","targetText":"擊鼓其鏜踊躍用兵土國城漕從孫子仲爰居爰處死生契濶于嗟濶兮于嗟洵兮","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"集释","excerpt":"方玉润集释云：“鏜”为鼓声，“土”为土功，“漕”为卫邑，“孫子仲”为所从之帅，“爰”为於也，“契濶”为隔远，“成説”为约誓有成言，“活”为生还，“洵”为信，“信”与申同。整组训诂都服务于戍卒久役离家、盟言难践的诗旨。","fullText":"方玉润集释云：“鏜”为鼓声，“土”为土功，“漕”为卫邑，“孫子仲”为所从之帅，“爰”为於也，“契濶”为隔远，“成説”为约誓有成言，“活”为生还，“洵”为信，“信”与申同。整组训诂都服务于戍卒久役离家、盟言难践的诗旨。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-005","seg-009","seg-013","seg-017","seg-019"]},{"id":"fangyurun-yuanshi:0005-1:part-1","annotationId":"0005","glossId":"0005-1","glossHref":"/shijing/gloss/031-ji-gu/fangyurun-yuanshi/0005-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"global","layerLabel":"全篇总说","targetText":"标韵","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"标韵","excerpt":"方玉润分章标出韵脚：首章“鏜、兵、行”转韵，二章“仲、宋、忡”叶韵，三章“馬、下”本韵，四章“濶、説”转韵而“手、老”叶韵，五章“濶、活”本韵，“洵、信”本韵。多层换韵配合章法递进。","fullText":"方玉润分章标出韵脚：首章“鏜、兵、行”转韵，二章“仲、宋、忡”叶韵，三章“馬、下”本韵，四章“濶、説”转韵而“手、老”叶韵，五章“濶、活”本韵，“洵、信”本韵。多层换韵配合章法递进。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"maoheng-zhushu-kr1c0004:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/031-ji-gu/maoheng-zhushu-kr1c0004/0001-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"preface","layerLabel":"篇序","targetText":"擊鼓怨州吁也衛州吁用兵暴亂使公孫文仲將而平陳與宋國人怨其勇而無禮也","sourceLabel":null,"attributionLabel":"诗序","sectionLabel":"序","excerpt":"序：《擊鼓》，怨州吁也。衛州吁用兵暴亂，使公孫文仲將而平陳與宋，國人怨其勇而無禮也。","fullText":"序：《擊鼓》，怨州吁也。衛州吁用兵暴亂，使公孫文仲將而平陳與宋，國人怨其勇而無禮也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"maoheng-zhushu-kr1c0004:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/031-ji-gu/maoheng-zhushu-kr1c0004/0002-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"span","layerLabel":"诗句片段","targetText":"擊鼓其鏜踊躍用兵土國城漕我獨南行","sourceLabel":null,"attributionLabel":"毛传","sectionLabel":null,"excerpt":"傳：鏜，擊鼓聲也。踊躍，武貌。土，國內之事。漕，衛邑也。","fullText":"傳：鏜，擊鼓聲也。踊躍，武貌。土，國內之事。漕，衛邑也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004"]},{"id":"maoheng-zhushu-kr1c0004:0003-1:part-1","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/031-ji-gu/maoheng-zhushu-kr1c0004/0003-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"span","layerLabel":"诗句片段","targetText":"從孫子仲平陳與宋不我以歸憂心有忡","sourceLabel":null,"attributionLabel":"毛传","sectionLabel":null,"excerpt":"傳：孫子仲，惠公孫文仲也。平，和也。忡，憂也。","fullText":"傳：孫子仲，惠公孫文仲也。平，和也。忡，憂也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-005","seg-006","seg-007","seg-008"]},{"id":"maoheng-zhushu-kr1c0004:0004-1:part-1","annotationId":"0004","glossId":"0004-1","glossHref":"/shijing/gloss/031-ji-gu/maoheng-zhushu-kr1c0004/0004-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"span","layerLabel":"诗句片段","targetText":"爰居爰處爰喪其馬于以求之于林之下","sourceLabel":null,"attributionLabel":"毛传","sectionLabel":null,"excerpt":"傳：爰，於也。不還者及其馬亡，則求之林下。","fullText":"傳：爰，於也。不還者及其馬亡，則求之林下。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-009","seg-010","seg-011","seg-012"]},{"id":"maoheng-zhushu-kr1c0004:0005-1:part-1","annotationId":"0005","glossId":"0005-1","glossHref":"/shijing/gloss/031-ji-gu/maoheng-zhushu-kr1c0004/0005-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"span","layerLabel":"诗句片段","targetText":"死生契闊與子成說執子之手與子偕老","sourceLabel":null,"attributionLabel":"毛传","sectionLabel":null,"excerpt":"傳：契闊，勤苦也。成說，成其相與之約。","fullText":"傳：契闊，勤苦也。成說，成其相與之約。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-013","seg-014","seg-015","seg-016"]},{"id":"maoheng-zhushu-kr1c0004:0006-1:part-1","annotationId":"0006","glossId":"0006-1","glossHref":"/shijing/gloss/031-ji-gu/maoheng-zhushu-kr1c0004/0006-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"span","layerLabel":"诗句片段","targetText":"于嗟闊兮不我活兮于嗟洵兮不我信兮","sourceLabel":null,"attributionLabel":"毛传","sectionLabel":null,"excerpt":"傳：闊，遠也。活，會也。洵，遠也。信，極也。","fullText":"傳：闊，遠也。活，會也。洵，遠也。信，極也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-017","seg-018","seg-019","seg-020"]},{"id":"maruichen-tongshi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/031-ji-gu/maruichen-tongshi/0001-1","materialId":"maruichen-tongshi","materialTitle":"毛詩傳箋通釋","contributorLine":"清 · 馬瑞辰","publicationYear":1989,"layer":"span","layerLabel":"诗句片段","targetText":"擊鼓其鏜，踊躍用兵。土國城漕，我獨南行。從孫子仲，平陳與宋。不我以歸，憂心有忡。爰居爰處，爰喪其馬。于以求之，于林之下。死生契闊，與子成説。執子之手，與子偕老。于嗟闊兮，不我活兮。于嗟洵兮，不我信兮。","sourceLabel":"第 111-112 页","attributionLabel":"马瑞辰","sectionLabel":"按","excerpt":"马瑞辰论《擊鼓》时，一面梳理州吁、公孙文仲、平陈与宋等旧说，一面详辨“契阔”“活”“信”等字义，强调后两章是追忆室家前盟而非泛言朋友。其解尤其重视征戍、离乱与夫妻之情三层交织，所以能把本篇写得沉痛而不板滞。","fullText":"马瑞辰论《擊鼓》时，一面梳理州吁、公孙文仲、平陈与宋等旧说，一面详辨“契阔”“活”“信”等字义，强调后两章是追忆室家前盟而非泛言朋友。其解尤其重视征戍、离乱与夫妻之情三层交织，所以能把本篇写得沉痛而不板滞。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016","seg-017","seg-018","seg-019","seg-020"]},{"id":"quwanli-quanshi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/031-ji-gu/quwanli-quanshi/0001-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"global","layerLabel":"全篇总说","targetText":"全篇旨意","sourceLabel":"第 35-36 页","attributionLabel":"屈万里","sectionLabel":"注释","excerpt":"屈万里在《击鼓》首条注释中仍录《诗序》怨州吁说及姚际恒异说，但整体判断偏向征戍者久役思归之作。诗中既有从军南行、军伍散乱之苦，也有追忆室家盟言、叹久别失信之悲。","fullText":"屈万里在《击鼓》首条注释中仍录《诗序》怨州吁说及姚际恒异说，但整体判断偏向征戍者久役思归之作。诗中既有从军南行、军伍散乱之苦，也有追忆室家盟言、叹久别失信之悲。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"quwanli-quanshi:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/031-ji-gu/quwanli-quanshi/0002-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"term","layerLabel":"字词注","targetText":"击鼓其镗踊跃用兵土国城漕从孙子仲不我以归忧心有忡死生契阔与子成说不我活兮于嗟洵兮不我信兮","sourceLabel":"第 35-36 页","attributionLabel":"屈万里","sectionLabel":"注释","excerpt":"屈万里释“镗”为鼓声，“踊跃”为擢跃貌，“兵”为兵器，“土国”“城漕”皆役事，“孙子仲”为公孙文仲，“不我以归”为倒文，“忡”为忧，“契阔”为离合，“成说”为成言，“活”为会，“洵”为远，“信”为守约。整组词注显示本篇核心仍在久役失期与夫妻离散。","fullText":"屈万里释“镗”为鼓声，“踊跃”为擢跃貌，“兵”为兵器，“土国”“城漕”皆役事，“孙子仲”为公孙文仲，“不我以归”为倒文，“忡”为忧，“契阔”为离合，“成说”为成言，“活”为会，“洵”为远，“信”为守约。整组词注显示本篇核心仍在久役失期与夫妻离散。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-005","seg-007","seg-008","seg-013","seg-014","seg-018","seg-019","seg-020"]},{"id":"wangli-yundu:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/031-ji-gu/wangli-yundu/0001-1","materialId":"wangli-yundu","materialTitle":"詩經韻讀","contributorLine":"现代 · 王力","publicationYear":1980,"layer":"global","layerLabel":"全篇总说","targetText":"《击鼓》韵读总说","sourceLabel":"第 153-154 页","attributionLabel":"王力","sectionLabel":"韵读","excerpt":"王力将《击鼓》分作五章换韵：首章“鏜(thang)、行(heang)”与“兵(pyang)”为阳部，次章“仲(dium)、宋(suom)、忡(thiuam)”入侵东通摄，三章“處(thjia)、馬(mea)、下(hea)”入鱼部，四章“闊(khuat)、説(sjuat)”与“老(lu)”分月幽两层，第五章“闊(khuat)、活(huat)”入月部，而“洵(siuen)、信(sien)”转真部。全诗声律随章法递转。","fullText":"王力将《击鼓》分作五章换韵：首章“鏜(thang)、行(heang)”与“兵(pyang)”为阳部，次章“仲(dium)、宋(suom)、忡(thiuam)”入侵东通摄，三章“處(thjia)、馬(mea)、下(hea)”入鱼部，四章“闊(khuat)、説(sjuat)”与“老(lu)”分月幽两层，第五章“闊(khuat)、活(huat)”入月部，而“洵(siuen)、信(sien)”转真部。全诗声律随章法递转。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"wangli-yundu:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/031-ji-gu/wangli-yundu/0002-1","materialId":"wangli-yundu","materialTitle":"詩經韻讀","contributorLine":"现代 · 王力","publicationYear":1980,"layer":"span","layerLabel":"诗句片段","targetText":"击鼓其镗，踊跃用兵。土国城漕，我独南行。从孙子仲，平陈与宋。不我以归，忧心有忡。爰居爰处，爰丧其马。于以求之，于林之下。死生契阔，与子成说；执子之手，与子偕老。于嗟阔兮，不我活兮。于嗟洵兮，不我信兮。","sourceLabel":"第 153-154 页","attributionLabel":"王力","sectionLabel":"韵读","excerpt":"页图可读《击鼓》五章韵部层次分明，由阳、侵、鱼而转入月幽、月真。王力所记注音表明，后两章虽为传诵名句，但在韵读上仍严格依章换韵，不是一味平铺。","fullText":"页图可读《击鼓》五章韵部层次分明，由阳、侵、鱼而转入月幽、月真。王力所记注音表明，后两章虽为传诵名句，但在韵读上仍严格依章换韵，不是一味平铺。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016","seg-017","seg-018","seg-019","seg-020"]},{"id":"zhuxi-shijichuan-kr1c0009:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/031-ji-gu/zhuxi-shijichuan-kr1c0009/0001-1","materialId":"zhuxi-shijichuan-kr1c0009","materialTitle":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"layer":"span","layerLabel":"诗句片段","targetText":"擊鼓其鏜，踊躍用兵。土國城漕，我獨南行。","sourceLabel":null,"attributionLabel":"朱熹","sectionLabel":null,"excerpt":"賦也。朱熹以为从军者自言其事，首章先总叙用兵与劳役之苦，而自我独南行一语已见其危苦尤甚。","fullText":"賦也。朱熹以为从军者自言其事，首章先总叙用兵与劳役之苦，而自我独南行一语已见其危苦尤甚。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004"]},{"id":"zhuxi-shijichuan-kr1c0009:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/031-ji-gu/zhuxi-shijichuan-kr1c0009/0002-1","materialId":"zhuxi-shijichuan-kr1c0009","materialTitle":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"layer":"span","layerLabel":"诗句片段","targetText":"從孫子仲，平陳與宋。不我以歸，憂心有忡。","sourceLabel":null,"attributionLabel":"朱熹","sectionLabel":null,"excerpt":"賦也。朱熹认为此章承上交代所从军将与所事之役，而不我以归一句正写征人不得归休，所以忧心忡忡。","fullText":"賦也。朱熹认为此章承上交代所从军将与所事之役，而不我以归一句正写征人不得归休，所以忧心忡忡。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-005","seg-006","seg-007","seg-008"]},{"id":"zhuxi-shijichuan-kr1c0009:0003-1:part-1","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/031-ji-gu/zhuxi-shijichuan-kr1c0009/0003-1","materialId":"zhuxi-shijichuan-kr1c0009","materialTitle":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"layer":"span","layerLabel":"诗句片段","targetText":"爰居爰處，爰喪其馬。于以求之，于林之下。","sourceLabel":null,"attributionLabel":"朱熹","sectionLabel":null,"excerpt":"賦也。朱熹以此章写军士失伍离次、无复斗志，正见久戍疲敝之状。","fullText":"賦也。朱熹以此章写军士失伍离次、无复斗志，正见久戍疲敝之状。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-009","seg-010","seg-011","seg-012"]},{"id":"zhuxi-shijichuan-kr1c0009:0004-1:part-1","annotationId":"0004","glossId":"0004-1","glossHref":"/shijing/gloss/031-ji-gu/zhuxi-shijichuan-kr1c0009/0004-1","materialId":"zhuxi-shijichuan-kr1c0009","materialTitle":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"layer":"span","layerLabel":"诗句片段","targetText":"死生契闊，與子成説。執子之手，與子偕老。","sourceLabel":null,"attributionLabel":"朱熹","sectionLabel":null,"excerpt":"賦也。朱熹以此章为追述室家别时誓约之言，所以与前三章军旅艰苦相对，倍增离别之痛。","fullText":"賦也。朱熹以此章为追述室家别时誓约之言，所以与前三章军旅艰苦相对，倍增离别之痛。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-013","seg-014","seg-015","seg-016"]},{"id":"zhuxi-shijichuan-kr1c0009:0005-1:part-1","annotationId":"0005","glossId":"0005-1","glossHref":"/shijing/gloss/031-ji-gu/zhuxi-shijichuan-kr1c0009/0005-1","materialId":"zhuxi-shijichuan-kr1c0009","materialTitle":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"layer":"span","layerLabel":"诗句片段","targetText":"于嗟闊兮，不我活兮。于嗟洵兮，不我信兮。","sourceLabel":null,"attributionLabel":"朱熹","sectionLabel":null,"excerpt":"賦也。朱熹释活为会、信为极，认为此章是对前盟不践、久别无归的终极怨叹。","fullText":"賦也。朱熹释活为会、信为极，认为此章是对前盟不践、久别无归的终极怨叹。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-017","seg-018","seg-019","seg-020"]},{"id":"zhuxi-shijichuan-kr1c0009:0006-1:part-1","annotationId":"0006","glossId":"0006-1","glossHref":"/shijing/gloss/031-ji-gu/zhuxi-shijichuan-kr1c0009/0006-1","materialId":"zhuxi-shijichuan-kr1c0009","materialTitle":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"layer":"global","layerLabel":"全篇总说","targetText":"擊鼓五章章四句","sourceLabel":null,"attributionLabel":"朱熹","sectionLabel":null,"excerpt":"朱熹记《擊鼓》为五章、章四句，并通篇视为从军者自述之辞。","fullText":"朱熹记《擊鼓》为五章、章四句，并通篇视为从军者自述之辞。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]}]}}}
