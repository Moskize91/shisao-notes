ine":"清 · 馬瑞辰","publicationYear":1989,"layer":"span","layerLabel":"诗句片段","targetText":"其樂只且","sourceLabel":null,"attributionLabel":"马瑞辰","sectionLabel":"按","excerpt":"只且","fullText":"只且","notes":null,"partOrder":1,"anchorIds":["seg-004:3-4:只且"],"glossAnchorIds":["anchor-1-1"],"segmentIds":["seg-004"]},{"id":"quwanli-quanshi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/067-jun-zi-yang-yang/quwanli-quanshi/0001-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"global","layerLabel":"全篇总说","targetText":"此蓋夫婦和樂之詩。","sourceLabel":"第 84 页","attributionLabel":"屈万里","sectionLabel":"注釋","excerpt":"此蓋夫婦和樂之詩。","fullText":"此蓋夫婦和樂之詩。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"quwanli-quanshi:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/067-jun-zi-yang-yang/quwanli-quanshi/0002-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"term","layerLabel":"字词注","targetText":"君子陽陽","sourceLabel":"第 84 页","attributionLabel":"屈万里","sectionLabel":"注釋","excerpt":"陽陽，通作揚揚，得意之貌，亦即快樂之狀也。馬瑞辰說。","fullText":"陽陽，通作揚揚，得意之貌，亦即快樂之狀也。馬瑞辰說。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001"]},{"id":"quwanli-quanshi:0003-1:part-1","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/067-jun-zi-yang-yang/quwanli-quanshi/0003-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"term","layerLabel":"字词注","targetText":"左執簧","sourceLabel":"第 84 页","attributionLabel":"屈万里","sectionLabel":"注釋","excerpt":"左，左手也。簧，笙也。","fullText":"左，左手也。簧，笙也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-002"]},{"id":"quwanli-quanshi:0004-1:part-1","annotationId":"0004","glossId":"0004-1","glossHref":"/shijing/gloss/067-jun-zi-yang