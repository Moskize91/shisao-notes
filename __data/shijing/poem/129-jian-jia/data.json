urfaceText":"道阻且右","charStart":1,"charEnd":4,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-6"],"materialIds":["chengjunying-jiangjianyuan-zhuxi"]},{"id":"seg-022:4-4:右","segmentId":"seg-022","segmentOrder":22,"surfaceText":"右","charStart":4,"charEnd":4,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-7","chengjunying-jiangjianyuan-zhuxi:0001-1:part-8"],"materialIds":["chengjunying-jiangjianyuan-zhuxi"]},{"id":"seg-023:1-4:溯游从之","segmentId":"seg-023","segmentOrder":23,"surfaceText":"溯游从之","charStart":1,"charEnd":4,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-6"],"materialIds":["chengjunying-jiangjianyuan-zhuxi"]},{"id":"seg-024:1-5:宛在水中沚","segmentId":"seg-024","segmentOrder":24,"surfaceText":"宛在水中沚","charStart":1,"charEnd":5,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-6"],"materialIds":["chengjunying-jiangjianyuan-zhuxi"]},{"id":"seg-024:5-5:沚","segmentId":"seg-024","segmentOrder":24,"surfaceText":"沚","charStart":5,"charEnd":5,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-7","chengjunying-jiangjianyuan-zhuxi:0001-1:part-8"],"materialIds":["chengjunying-jiangjianyuan-zhuxi"]}],"entries":[{"id":"chengjunying-jiangjianyuan-zhuxi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/129-jian-jia/chengjunying-jiangjianyuan-zhuxi/0001-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"蒹葭苍苍，白露为霜。所谓伊人，在水一方。溯洄从之，道阻且长。溯游从之，宛在水中央。蒹葭凄凄，白露未晞。所谓伊人，在水之湄。溯洄从之，道阻且跻。溯游从之，宛在水中坻。蒹葭采采，白露未已。所谓伊人，在水之涘。溯洄从之，道阻且右。溯游从之，宛在水中沚。","sourceLabel":"第 292-294 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","excerpt":"这是一首情意飘逸而求之不得的诗。题解梳理毛序、朱熹、方玉润等说，认为最可从诗中难与人言的思慕情致来理解。三章写深秋清晨河边不同时间的景象，借蒹葭白露起兴，写寻求“伊人”而终不可即。","fullText":"这是一首情意飘逸而求之不得的诗。题解梳理毛序、朱熹、方玉润等说，认为最可从诗中难与人言的思慕情致来理解。三章写深秋清晨河边不同时间的景象，借蒹葭白露起兴，写寻求“伊人”而终不可即。蒹葭苍苍，白露为霜。所谓伊人，在水一方。溯洄从之，道阻且长。溯游从之，宛在水中央。蒹葭，初生芦苇。苍苍，淡青色。白露为霜，言深秋露重。伊人，是人。方，旁，一方即一旁。溯洄，逆流向上，也可指沿岸逆流而行。道阻且长，言道路险阻而远。溯游，顺流向下。宛，好像。蒹葭凄凄，白露未晞。所谓伊人，在水之湄。溯洄从之，道阻且跻。溯游从之，宛在水中坻。凄凄，湿润貌。晞，干。湄，水与草交接之处。跻，登高。坻，水中小沙洲。蒹葭采采，白露未已。所谓伊人，在水之涘。溯洄从之，道阻且右。溯游从之，宛在水中沚。采采，众多貌。已，止，指露未全干。涘，水边。右，曲折迂回。沚，水中小沙滩。韵读：阳部苍、霜、方、长、央；脂部凄、晞、湄、跻、坻；之部采、已、涘、右、沚。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016","seg-017","seg-018","seg-019","seg-020","seg-021","seg-022","seg-023","seg-024"]},{"id":"chengjunying-jiangjianyuan-zhuxi:0001-1:part-2","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/129-jian-jia/chengjunying-jiangjianyuan-zhuxi/0001-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"蒹葭苍苍，白露为霜。所谓伊人，在水一方。溯洄从之，道阻且长。溯游从之，宛在水中央。蒹葭凄凄，白露未晞。所谓伊人，在水之湄。溯洄从之，道阻且跻。溯游从之，宛在水中坻。蒹葭采采，白露未已。所谓伊人，在水之涘。溯洄从之，道阻且右。溯游从之，宛在水中沚。","sourceLabel":"第 292-294 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","excerpt":"蒹葭苍苍，白露为霜。所谓伊人，在水一方。溯洄从之，道阻且长。溯游从之，宛在水中央。","fullText":"这是一首情意飘逸而求之不得的诗。题解梳理毛序、朱熹、方玉润等说，认为最可从诗中难与人言的思慕情致来理解。三章写深秋清晨河边不同时间的景象，借蒹葭白露起兴，写寻求“伊人”而终不可即。蒹葭苍苍，白露为霜。所谓伊人，在水一方。溯洄从之，道阻且长。溯游从之，宛在水中央。蒹葭，初生芦苇。苍苍，淡青色。白露为霜，言深秋露重。伊人，是人。方，旁，一方即一旁。溯洄，逆流向上，也可指沿岸逆流而行。道阻且长，言道路险阻而远。溯游，顺流向下。宛，好像。蒹葭凄凄，白露未晞。所谓伊人，在水之湄。溯洄从之，道阻且跻。溯游从之，宛在水中坻。凄凄，湿润貌。晞，干。湄，水与草交接之处。跻，登高。坻，水中小沙洲。蒹葭采采，白露未已。所谓伊人，在水之涘。溯洄从之，道阻且右。溯游从之，宛在水中沚。采采，众多貌。已，止，指露未全干。涘，水边。右，曲折迂回。沚，水中小沙滩。韵读：阳部苍、霜、方、长、央；脂部凄、晞、湄、跻、坻；之部采、已、涘、右、沚。","notes":null,"partOrder":2,"anchorIds":["seg-001:1-4:蒹葭苍苍","seg-002:1-4:白露为霜","seg-003:1-4:所谓伊人","seg-004:1-4:在水一方","seg-005:1-4:溯洄从之","seg-006:1-4:道阻且长","seg-007:1-4:溯游从之","seg-008:1-5:宛在水中央"],"glossAnchorIds":["anchor-2-1","anchor-2-2","anchor-2-3","anchor-2-4","anchor-2-5","anchor-2-6","anchor-2-7","anchor-2-8"],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","se