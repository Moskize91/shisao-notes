ers":[{"index":1,"text":"白","anchorIds":[]},{"index":2,"text":"茅","anchorIds":[]},{"index":3,"text":"純","anchorIds":[]},{"index":4,"text":"束","anchorIds":[]}]},{"id":"seg-008","order":8,"text":"有女如玉","entryIds":["chengjunying-jiangjianyuan-zhuxi:0003-1:part-1","chenhuan-chuanshu:0002-1:part-1","fangyurun-yuanshi:0002-1:part-1","maoheng-zhushu-kr1c0004:0003-1:part-1","maruichen-tongshi:0001-1:part-1","wangli-yundu:0002-1:part-1","zhuxi-shijichuan-kr1c0009:0002-1:part-1"],"characters":[{"index":1,"text":"有","anchorIds":[]},{"index":2,"text":"女","anchorIds":[]},{"index":3,"text":"如","anchorIds":[]},{"index":4,"text":"玉","anchorIds":[]}]},{"id":"seg-009","order":9,"text":"舒而脫脫兮","entryIds":["chengjunying-jiangjianyuan-zhuxi:0004-1:part-1","chenhuan-chuanshu:0002-1:part-1","fangyurun-yuanshi:0002-1:part-1","fangyurun-yuanshi:0004-1:part-1","fangyurun-yuanshi:0004-1:part-2","maoheng-zhushu-kr1c0004:0004-1:part-1","maruichen-tongshi:0001-1:part-1","quwanli-quanshi:0002-1:part-1","wangli-yundu:0002-1:part-1","zhuxi-shijichuan-kr1c0009:0003-1:part-1"],"characters":[{"index":1,"text":"舒","anchorIds":[]},{"index":2,"text":"而","anchorIds":[]},{"index":3,"text":"脫","anchorIds":[]},{"index":4,"text":"脫","anchorIds":[]},{"index":5,"text":"兮","anchorIds":[]}]},{"id":"seg-010","order":10,"text":"無感我帨兮","entryIds":["chengjunying-jiangjianyuan-zhuxi:0004-1:part-1","chenhuan-chuanshu:0002-1:part-1","fangyurun-yuanshi:0002-1:part-1","fangyurun-yuanshi:0004-1:part-1","fangyurun-yuanshi:0004-1:part-2","maoheng-zhushu-kr1c0004:0004-1:part-1","maruichen-tongshi:0001-1:part-1","quwanli-quanshi:0002-1:part-1","wangli-yundu:0002-1:part-1","zhuxi-shijichuan-kr1c0009:0003-1:part-1"],"characters":[{"index":1,"text":"無","anchorIds":[]},{"index":2,"text":"感","anchorIds":[]},{"index":3,"text":"我","anchorIds":[]},{"index":4,"text":"帨","anchorIds":[]},{"index":5,"text":"兮","anchorIds":[]}]},{"id":"seg-011","order":11,"text":"無使尨也吠","entryIds":["chengjunying-jiangjianyuan-zhuxi:0004-1:part-1","chenhuan-chuanshu:0002-1:part-1","fangyurun-yuanshi:0002-1:part-1","fangyurun-yuanshi:0004-1:part-1","fangyurun-yuanshi:0004-1:part-2","maoheng-zhushu-kr1c0004:0004-1:part-1","maruichen-tongshi:0001-1:part-1","quwanli-quanshi:0002-1:part-1","wangli-yundu:0002-1:part-1","zhuxi-shijichuan-kr1c0009:0003-1:part-1"],"characters":[{"index":1,"text":"無","anchorIds":[]},{"index":2,"text":"使","anchorIds":[]},{"index":3,"text":"尨","anchorIds":[]},{"index":4,"text":"也","anchorIds":[]},{"index":5,"text":"吠","anchorIds":[]}]}]},"materials":[{"id":"maoheng-zhushu-kr1c0004","title":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"glossCount":4,"partCount":4},{"id":"zhuxi-shijichuan-kr1c0009","title":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"glossCount":4,"partCount":4},{"id":"chenhuan-chuanshu","title":"詩毛氏傳疏","contributorLine":"清 · 陳奐","publicationYear":1847,"glossCount":2,"partCount":2},{"id":"wangli-yundu","title":"詩經韻讀","contributorLine":"现代 · 王力","publicationYear":1980,"glossCount":2,"partCount":2},{"id":"quwanli-quanshi","title":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"glossCount":2,"partCount":2},{"id":"fangyurun-yuanshi","title":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"glossCount":5,"partCount":7},{"id":"maruichen-tongshi","title":"毛詩傳箋通釋","contributorLine":"清 · 馬瑞辰","publicationYear":1989,"glossCount":1,"partCount":1},{"id":"chengjunying-jiangjianyuan-zhuxi","title":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"glossCount":4,"partCount":4}],"stats":{"materialCount":8,"glossCount":24,"anchoredPartCount":0,"overviewPartCount":11},"overview":{"prefaceEntryIds":["chenhuan-chuanshu:0001-1:part-1","maoheng-zhushu-kr1c0004:0001-1:part-1"],"globalEntryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-1","fangyurun-yuanshi:0001-1:part-1","fangyurun-yuanshi:0002-1:part-1","fangyurun-yuanshi:0003-1:part-1","fangyurun-yuanshi:0005-1:part-1","fangyurun-yuanshi:0005-1:part-2","quwanli-quanshi:0001-1:part-1","wangli-yundu:0001-1:part-1","zhuxi-shijichuan-kr1c0009:0004-1:part-1"]},"focusAnchors":[],"entries":[{"id":"chengjunying-jiangjianyuan-zhuxi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/023-ye-you-si-jun/chengjunying-jiangjianyuan-zhuxi/0001-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"global","layerLabel":"全篇总说","targetText":"题解","sourceLabel":"第 41 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","excerpt":"题解把《野有死麕》定为青年男女恋爱的情诗，认为它写猎人以死獐、白茅为礼物向少女求爱。编者强调此诗并不涉“淫奔”或“恶无礼”，而是以质朴而富野趣的语言，写女子既有羞怯防闲，又并非全然拒绝的微妙心理，第三章“无感我帨兮，无使尨也吠”尤见其半推半就、活泼传神。","fullText":"题解把《野有死麕》定为青年男女恋爱的情诗，认为它写猎人以死獐、白茅为礼物向少女求爱。编者强调此诗并不涉“淫奔”或“恶无礼”，而是以质朴而富野趣的语言，写女子既有羞怯防闲，又并非全然拒绝的微妙心理，第三章“无感我帨兮，无使尨也吠”尤见其半推半就、活泼传神。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"chengjunying-jiangjianyuan-zhuxi:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/023-ye-you-si-jun/chengjunying-jiangjianyuan-zhuxi/0002-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"野有死麕，白茅包之。有女怀春，吉士诱之。","sourceLabel":"第 41 页","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"excerpt":"首章释“麕”为獐，“包”为裹，“怀春”即女子怀有春情，“吉士”指美好的青年。编者据此认为死麕与白茅是猎人奉赠的礼物，正用来引逗怀春少女，所以通章是一幅山野求偶的生动开场。","fullText":"首章释“麕”为獐，“包”为裹，“怀春”即女子怀有春情，“吉士”指美好的青年。编者据此认为死麕与白茅是猎人奉赠的礼物，正用来引逗怀春少女，所以通章是一幅山野求偶的生动开场。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004"]},{"id":"chengjunying-jiangjianyuan-zhuxi:0003-1:part-1","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/023-ye-you-si-jun/chengjunying-jiangjianyuan-zhuxi/0003-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"林有朴樕，野有死鹿，白茅纯束，有女如玉。","sourceLabel":"第 42 页","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"excerpt":"第二章改以死鹿、白茅纯束重申求爱之礼，并以“有女如玉”转出对女方姿质的赞美。编者指出“朴樕”是丛生小木，衬出山林景象；“如玉”既美其色，也暗写其洁白可亲，使情调由首章的挑逗转向柔美。","fullText":"第二章改以死鹿、白茅纯束重申求爱之礼，并以“有女如玉”转出对女方姿质的赞美。编者指出“朴樕”是丛生小木，衬出山林景象；“如玉”既美其色，也暗写其洁白可亲，使情调由首章的挑逗转向柔美。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-005","seg-006","seg-007","seg-008"]},{"id":"chengjunying-jiangjianyuan-zhuxi:0004-1:part-1","annotationId":"0004","glossId":"0004-1","glossHref":"/shijing/gloss/023-ye-you-si-jun/chengjunying-jiangjianyuan-zhuxi/0004-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"舒而脱脱兮，无感我帨兮，无使尨也吠。","sourceLabel":"第 42 页","attributionLabel":"程俊英、蒋见元","sectionLabel":null,"excerpt":"第三章写女子答语。“舒而脱脱”是从容舒缓之貌，“帨”为佩巾，“尨”为多毛犬。编者认为这不是凛然拒绝，而是提醒男子放慢脚步、勿惊动衣饰和犬吠，以免幽会暴露。因而此章最能显出少女嗔中含喜、欲拒还迎的神态。","fullText":"第三章写女子答语。“舒而脱脱”是从容舒缓之貌，“帨”为佩巾，“尨”为多毛犬。编者认为这不是凛然拒绝，而是提醒男子放慢脚步、勿惊动衣饰和犬吠，以免幽会暴露。因而此章最能显出少女嗔中含喜、欲拒还迎的神态。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-009","seg-010","seg-011"]},{"id":"chenhuan-chuanshu:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/023-ye-you-si-jun/chenhuan-chuanshu/0001-1","materialId":"chenhuan-chuanshu","materialTitle":"詩毛氏傳疏","contributorLine":"清 · 陳奐","publicationYear":1847,"layer":"preface","layerLabel":"篇序","targetText":"野有死麕惡無禮也天下大亂強暴相陵遂成淫風被文王之化雖當亂世猶惡無禮也","sourceLabel":"第 45 页","attributionLabel":"诗序","sectionLabel":"序","excerpt":"序：《野有死麕》，惡無禮也。天下大亂，強暴相陵，遂成淫風。被文王之化，雖當亂世，猶惡無禮也。","fullText":"序：《野有死麕》，惡無禮也。天下大亂，強暴相陵，遂成淫風。被文王之化，雖當亂世，猶惡無禮也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"chenhuan-chuanshu:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/023-ye-you-si-jun/chenhuan-chuanshu/0002-1","materialId":"chenhuan-chuanshu","materialTitle":"詩毛氏傳疏","contributorLine":"清 · 陳奐","publicationYear":1847,"layer":"span","layerLabel":"诗句片段","targetText":"野有死麕，白茅包之。有女懷春，吉士誘之。林有樸樕，野有死鹿。白茅純束，有女如玉。舒而脫脫兮，無感我帨兮，無使尨也吠。","sourceLabel":"第 45-46 页","attributionLabel":"陈奂","sectionLabel":"疏","excerpt":"陈奂循《序》以为此篇旨在恶无礼，认为首二章写强暴男子以死麕死鹿为诱具而求近女子，第三章则是女子警拒之辞。其疏尤重“脱脱”“无感我帨”“无使尨也吠”数语，谓女子虽辞意婉曲，实含严正防闲，不许对方以非礼相干，故仍足见文王之化未坠。","fullText":"陈奂循《序》以为此篇旨在恶无礼，认为首二章写强暴男子以死麕死鹿为诱具而求近女子，第三章则是女子警拒之辞。其疏尤重“脱脱”“无感我帨”“无使尨也吠”数语，谓女子虽辞意婉曲，实含严正防闲，不许对方以非礼相干，故仍足见文王之化未坠。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011"]},{"id":"fangyurun-yuanshi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/023-ye-you-si-jun/fangyurun-yuanshi/0001-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"global","layerLabel":"全篇总说","targetText":"野有死麕㊟拒招隱也。","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"题注","excerpt":"方玉润在题注中径改旧说，认为《野有死麕》并非淫诗或拒暴之辞，而是托怀春之女拒绝招隐，以比高人逸士不肯出山用世。","fullText":"方玉润在题注中径改旧说，认为《野有死麕》并非淫诗或拒暴之辞，而是托怀春之女拒绝招隐，以比高人逸士不肯出山用世。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"fangyurun-yuanshi:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/023-ye-you-si-jun/fangyurun-yuanshi/0002-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"global","layerLabel":"全篇总说","targetText":"野有死麕，白茅包之。有女懷春，吉士誘之。林有樸樕，野有死鹿。白茅純束，有女如玉。舒而脱脱兮，無感我帨兮，無使尨也吠。","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":null,"excerpt":"方玉润历数恶无礼、凶荒婚礼、淫诗、刺淫、贞女拒暴等旧解，皆以为未安，最后从章潢、范处义而更推进之，断定此诗通篇是比体：所谓怀春之女、吉士相诱，实喻招贤求隐；所谓“有女如玉”，比其洁白无瑕；第三章则是逸士婉谢招徕，愿对方徐徐而来，勿惊其衣冠犬吠，深意在于不肯出仕。","fullText":"方玉润历数恶无礼、凶荒婚礼、淫诗、刺淫、贞女拒暴等旧解，皆以为未安，最后从章潢、范处义而更推进之，断定此诗通篇是比体：所谓怀春之女、吉士相诱，实喻招贤求隐；所谓“有女如玉”，比其洁白无瑕；第三章则是逸士婉谢招徕，愿对方徐徐而来，勿惊其衣冠犬吠，深意在于不肯出仕。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011"]},{"id":"fangyurun-yuanshi:0003-1:part-1","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/023-ye-you-si-jun/fangyurun-yuanshi/0003-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"global","layerLabel":"全篇总说","targetText":"眉评","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"眉评","excerpt":"眉评谓首章四句翻起，通篇全用比体；后二章拍合正位，末章拒辞意微而婉。","fullText":"眉评谓首章四句翻起，通篇全用比体；后二章拍合正位，末章拒辞意微而婉。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"fangyurun-yuanshi:0004-1:part-1","annotationId":"0004","glossId":"0004-1","glossHref":"/shijing/gloss/023-ye-you-si-jun/fangyurun-yuanshi/0004-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"term","layerLabel":"字词注","targetText":"野有死麕林有樸樕野有死鹿舒而脱脱兮無感我帨兮無使尨也吠","sourceLabel":null,"attributionLabel":"集释","sectionLabel":null,"excerpt":"集释释“麕”为獐，“樸樕”为小木，“鹿”为有角兽，又释“脱脱”为舒缓貌，“感”为动，“帨”为巾，“尨”为犬。","fullText":"集释释“麕”为獐，“樸樕”为小木，“鹿”为有角兽，又释“脱脱”为舒缓貌，“感”为动，“帨”为巾，“尨”为犬。方玉润并借这些名物训释加强其比兴说，认为白茅、死麕、死鹿都不必拘作实景。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-005","seg-006","seg-009","seg-010","seg-011"]},{"id":"fangyurun-yuanshi:0004-1:part-2","annotationId":"0004","glossId":"0004-1","glossHref":"/shijing/gloss/023-ye-you-si-jun/fangyurun-yuanshi/0004-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"term","layerLabel":"字词注","targetText":"野有死麕林有樸樕野有死鹿舒而脱脱兮無感我帨兮無使尨也吠","sourceLabel":null,"attributionLabel":"集释","sectionLabel":null,"excerpt":"方玉润并借这些名物训释加强其比兴说，认为白茅、死麕、死鹿都不必拘作实景。","fullText":"集释释“麕”为獐，“樸樕”为小木，“鹿”为有角兽，又释“脱脱”为舒缓貌，“感”为动，“帨”为巾，“尨”为犬。方玉润并借这些名物训释加强其比兴说，认为白茅、死麕、死鹿都不必拘作实景。","notes":null,"partOrder":2,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-005","seg-006","seg-009","seg-010","seg-011"]},{"id":"fangyurun-yuanshi:0005-1:part-1","annotationId":"0005","glossId":"0005-1","glossHref":"/shijing/gloss/023-ye-you-si-jun/fangyurun-yuanshi/0005-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"global","layerLabel":"全篇总说","targetText":"标韵","sourceLabel":null,"attributionLabel":"标韵","sectionLabel":null,"excerpt":"标韵以首章“麕”“春”归真部本韵，而“包”“誘”另作叶韵；次章“樕”“鹿”“束”“玉”屋沃通韵；三章“脱”“帨”“吠”三字转韵。","fullText":"标韵以首章“麕”“春”归真部本韵，而“包”“誘”另作叶韵；次章“樕”“鹿”“束”“玉”屋沃通韵；三章“脱”“帨”“吠”三字转韵。三章句式不齐而韵脚安排颇活。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"fangyurun-yuanshi:0005-1:part-2","annotationId":"0005","glossId":"0005-1","glossHref":"/shijing/gloss/023-ye-you-si-jun/fangyurun-yuanshi/0005-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"global","layerLabel":"全篇总说","targetText":"标韵","sourceLabel":null,"attributionLabel":"标韵","sectionLabel":null,"excerpt":"三章句式不齐而韵脚安排颇活。","fullText":"标韵以首章“麕”“春”归真部本韵，而“包”“誘”另作叶韵；次章“樕”“鹿”“束”“玉”屋沃通韵；三章“脱”“帨”“吠”三字转韵。三章句式不齐而韵脚安排颇活。","notes":null,"partOrder":2,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"maoheng-zhushu-kr1c0004:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/023-ye-you-si-jun/maoheng-zhushu-kr1c0004/0001-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"preface","layerLabel":"篇序","targetText":"野有死麕惡無禮也天下大亂強暴相陵遂成淫風被文王之化雖當亂世猶惡無禮也","sourceLabel":null,"attributionLabel":"诗序","sectionLabel":"序","excerpt":"序：《野有死麕》，惡無禮也。天下大亂，強暴相陵，遂成淫風。被文王之化，雖當亂世，猶惡無禮也。","fullText":"序：《野有死麕》，惡無禮也。天下大亂，強暴相陵，遂成淫風。被文王之化，雖當亂世，猶惡無禮也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"maoheng-zhushu-kr1c0004:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/023-ye-you-si-jun/maoheng-zhushu-kr1c0004/0002-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"span","layerLabel":"诗句片段","targetText":"野有死麕白茅包之有女懷春吉士誘之","sourceLabel":null,"attributionLabel":"毛传","sectionLabel":null,"excerpt":"傳：麕，獐也。包，裹也。懷春，不暇待秋也。吉士，成禮之士也。","fullText":"傳：麕，獐也。包，裹也。懷春，不暇待秋也。吉士，成禮之士也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004"]},{"id":"maoheng-zhushu-kr1c0004:0003-1:part-1","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/023-ye-you-si-jun/maoheng-zhushu-kr1c0004/0003-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"span","layerLabel":"诗句片段","targetText":"林有樸樕野有死鹿白茅純束有女如玉","sourceLabel":null,"attributionLabel":"毛传","sectionLabel":null,"excerpt":"傳：樸樕，小木也。純束，猶包之也。如玉者，美其色也。","fullText":"傳：樸樕，小木也。純束，猶包之也。如玉者，美其色也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-005","seg-006","seg-007","seg-008"]},{"id":"maoheng-zhushu-kr1c0004:0004-1:part-1","annotationId":"0004","glossId":"0004-1","glossHref":"/shijing/gloss/023-ye-you-si-jun/maoheng-zhushu-kr1c0004/0004-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"span","layerLabel":"诗句片段","targetText":"舒而脫脫兮無感我帨兮無使尨也吠","sourceLabel":null,"attributionLabel":"毛传","sectionLabel":null,"excerpt":"傳：舒，徐也。脫脫，舒遲也。感，動也。帨，佩巾也。尨，狗也。吠，驚也。","fullText":"傳：舒，徐也。脫脫，舒遲也。感，動也。帨，佩巾也。尨，狗也。吠，驚也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-009","seg-010","seg-011"]},{"id":"maruichen-tongshi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/023-ye-you-si-jun/maruichen-tongshi/0001-1","materialId":"maruichen-tongshi","materialTitle":"毛詩傳箋通釋","contributorLine":"清 · 馬瑞辰","publicationYear":1989,"layer":"span","layerLabel":"诗句片段","targetText":"野有死麕，白茅包之。有女懷春，吉士誘之。林有樸樕，野有死鹿。白茅純束，有女如玉。舒而脫脫兮，無感我帨兮，無使尨也吠。","sourceLabel":"第 96-97 页","attributionLabel":"马瑞辰","sectionLabel":"按","excerpt":"瑞辰辨析《野有死麕》历来或作昏礼、或作拒暴、或作诱女等诸说，认为诗意仍以男女相悦为近，而非纯然乱礼。其按语尤重“舒而脱脱”“帨”“尨”“吠”等词，指出末章是女子假作嗔语、实含相许，不必硬作严拒；故全篇贵在情辞婉曲、风致天然。","fullText":"瑞辰辨析《野有死麕》历来或作昏礼、或作拒暴、或作诱女等诸说，认为诗意仍以男女相悦为近，而非纯然乱礼。其按语尤重“舒而脱脱”“帨”“尨”“吠”等词，指出末章是女子假作嗔语、实含相许，不必硬作严拒；故全篇贵在情辞婉曲、风致天然。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011"]},{"id":"quwanli-quanshi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/023-ye-you-si-jun/quwanli-quanshi/0001-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"global","layerLabel":"全篇总说","targetText":"《野有死麕》全篇旨意","sourceLabel":"第 25 页","attributionLabel":"屈万里","sectionLabel":"注释","excerpt":"此男女相悦之诗。","fullText":"此男女相悦之诗。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"quwanli-quanshi:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/023-ye-you-si-jun/quwanli-quanshi/0002-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"term","layerLabel":"字词注","targetText":"野有死麕白茅包之林有朴樕白茅纯束舒而脱脱兮无感我帨兮无使尨也吠","sourceLabel":"第 25 页","attributionLabel":"屈万里","sectionLabel":"注释","excerpt":"屈万里释“麕”为獐，“白茅”是春时先开的草，“怀”即思，“朴樕”为小木，“纯”犹束，“脱脱”为舒缓貌，“感”为动，“帨”为佩巾，“尨”为长毛犬，并据此认定全诗是男女相悦而女方微作矜持的情态写照。","fullText":"屈万里释“麕”为獐，“白茅”是春时先开的草，“怀”即思，“朴樕”为小木，“纯”犹束，“脱脱”为舒缓貌，“感”为动，“帨”为佩巾，“尨”为长毛犬，并据此认定全诗是男女相悦而女方微作矜持的情态写照。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-005","seg-007","seg-009","seg-010","seg-011"]},{"id":"wangli-yundu:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/023-ye-you-si-jun/wangli-yundu/0001-1","materialId":"wangli-yundu","materialTitle":"詩經韻讀","contributorLine":"现代 · 王力","publicationYear":1980,"layer":"global","layerLabel":"全篇总说","targetText":"《野有死麕》韵读总说","sourceLabel":"第 148 页局部","attributionLabel":"王力","sectionLabel":"韵读","excerpt":"王力将《野有死麕》读作三章三势：首章“麕(kyuan)”与“春(thjuən)”为真部本韵，并以“包(pəu)”“诱(tjiu)”作隔句协；次章“樕(sok)”“鹿(lok)”同属屋部，而“束(sjiok)”“玉(ngiok)”另归沃、屋通押；第三章则见“脱(thuat)”“帨(sjuiat)”“吠(biuat)”三字转韵。全篇在王力系统中用韵最灵动。","fullText":"王力将《野有死麕》读作三章三势：首章“麕(kyuan)”与“春(thjuən)”为真部本韵，并以“包(pəu)”“诱(tjiu)”作隔句协；次章“樕(sok)”“鹿(lok)”同属屋部，而“束(sjiok)”“玉(ngiok)”另归沃、屋通押；第三章则见“脱(thuat)”“帨(sjuiat)”“吠(biuat)”三字转韵。全篇在王力系统中用韵最灵动。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"wangli-yundu:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/023-ye-you-si-jun/wangli-yundu/0002-1","materialId":"wangli-yundu","materialTitle":"詩經韻讀","contributorLine":"现代 · 王力","publicationYear":1980,"layer":"span","layerLabel":"诗句片段","targetText":"野有死麕，白茅包之。有女怀春，吉士诱之。林有朴樕，野有死鹿。白茅纯束，有女如玉。舒而脱脱兮，无感我帨兮，无使尨也吠。","sourceLabel":"第 148 页局部","attributionLabel":"王力","sectionLabel":"韵读","excerpt":"页图可读首章以“麕(kyuan)、春(thjuən)”为真部主韵，并旁协“包(pəu)、诱(tjiu)”；次章“樕(sok)、鹿(lok)、束(sjiok)、玉(ngiok)”由屋沃通押；第三章“脱(thuat)、帨(sjuiat)、吠(biuat)”另成一转。王力据此显出此诗句式和用韵都偏活泼跳宕。","fullText":"页图可读首章以“麕(kyuan)、春(thjuən)”为真部主韵，并旁协“包(pəu)、诱(tjiu)”；次章“樕(sok)、鹿(lok)、束(sjiok)、玉(ngiok)”由屋沃通押；第三章“脱(thuat)、帨(sjuiat)、吠(biuat)”另成一转。王力据此显出此诗句式和用韵都偏活泼跳宕。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011"]},{"id":"zhuxi-shijichuan-kr1c0009:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/023-ye-you-si-jun/zhuxi-shijichuan-kr1c0009/0001-1","materialId":"zhuxi-shijichuan-kr1c0009","materialTitle":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"layer":"span","layerLabel":"诗句片段","targetText":"野有死麕，白茅包之。有女懷春，吉士誘之。","sourceLabel":null,"attributionLabel":"朱熹","sectionLabel":null,"excerpt":"興也。麕，獐也，鹿屬無角。懷春，當春而有懷也。吉士猶美士也。朱熹承其说，以为南國被文王之化，女子有貞潔自守，不为强暴所污，故诗人因所见以兴其事而美之；或曰即赋，言吉士以白茅包死麕而诱怀春之女。","fullText":"興也。麕，獐也，鹿屬無角。懷春，當春而有懷也。吉士猶美士也。朱熹承其说，以为南國被文王之化，女子有貞潔自守，不为强暴所污，故诗人因所见以兴其事而美之；或曰即赋，言吉士以白茅包死麕而诱怀春之女。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004"]},{"id":"zhuxi-shijichuan-kr1c0009:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/023-ye-you-si-jun/zhuxi-shijichuan-kr1c0009/0002-1","materialId":"zhuxi-shijichuan-kr1c0009","materialTitle":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"layer":"span","layerLabel":"诗句片段","targetText":"林有樸樕，野有死鹿。白茅純束，有女如玉。","sourceLabel":null,"attributionLabel":"朱熹","sectionLabel":null,"excerpt":"興也。樸樕，小木也。鹿，獸名有角。純束猶包之也。如玉者，美其色也。朱熹说此章以上三句兴下一句，亦或直赋，谓吉士以樸樕藉死鹿、白茅束之，以诱如玉之女。","fullText":"興也。樸樕，小木也。鹿，獸名有角。純束猶包之也。如玉者，美其色也。朱熹说此章以上三句兴下一句，亦或直赋，谓吉士以樸樕藉死鹿、白茅束之，以诱如玉之女。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-005","seg-006","seg-007","seg-008"]},{"id":"zhuxi-shijichuan-kr1c0009:0003-1:part-1","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/023-ye-you-si-jun/zhuxi-shijichuan-kr1c0009/0003-1","materialId":"zhuxi-shijichuan-kr1c0009","materialTitle":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"layer":"span","layerLabel":"诗句片段","targetText":"舒而脫脫兮，無感我帨兮，無使尨也吠。","sourceLabel":null,"attributionLabel":"朱熹","sectionLabel":null,"excerpt":"賦也。舒，遲緩也。脫脫，舒緩貌。感，動。帨，巾。尨，犬。朱熹以此章为女子拒绝之辞，谓其使男子徐徐而来，勿动我帨，勿惊我犬，以甚言其不可相及，凛然不可犯之意可见。","fullText":"賦也。舒，遲緩也。脫脫，舒緩貌。感，動。帨，巾。尨，犬。朱熹以此章为女子拒绝之辞，谓其使男子徐徐而来，勿动我帨，勿惊我犬，以甚言其不可相及，凛然不可犯之意可见。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-009","seg-010","seg-011"]},{"id":"zhuxi-shijichuan-kr1c0009:0004-1:part-1","annotationId":"0004","glossId":"0004-1","glossHref":"/shijing/gloss/023-ye-you-si-jun/zhuxi-shijichuan-kr1c0009/0004-1","materialId":"zhuxi-shijichuan-kr1c0009","materialTitle":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"layer":"global","layerLabel":"全篇总说","targetText":"野有死麕三章二章章四句一章三句","sourceLabel":null,"attributionLabel":"朱熹","sectionLabel":null,"excerpt":"朱熹记《野有死麕》为三章，前二章各四句，末章三句。","fullText":"朱熹记《野有死麕》为三章，前二章各四句，末章三句。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]}]}}}
