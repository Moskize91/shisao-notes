":["chengjunying-jiangjianyuan-zhuxi"]},{"id":"seg-012:4-4:椒","segmentId":"seg-012","segmentOrder":12,"surfaceText":"椒","charStart":4,"charEnd":4,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-10"],"materialIds":["chengjunying-jiangjianyuan-zhuxi"]}],"entries":[{"id":"chengjunying-jiangjianyuan-zhuxi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/137-dong-men-zhi-fen/chengjunying-jiangjianyuan-zhuxi/0001-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"東門之枌，宛丘之栩。子仲之子，婆娑其下。穀旦于差，南方之原。不績其麻，市也婆娑。穀旦于逝，越以鬷邁。視爾如荍，貽我握椒。","sourceLabel":"第 307-309 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","excerpt":"这是一首描写男女相爱、聚会歌舞的情歌。诗人爱慕子仲家的姑娘，这是一位纺麻的女子，因为爱好歌舞甚至放弃了纺麻的日常工作，同情人一起到热闹的城市去跳舞。诗不但表现了青年的爱情生活，也反映了陈国男女聚会、歌舞相乐、巫风盛行的特殊风俗。","fullText":"这是一首描写男女相爱、聚会歌舞的情歌。诗人爱慕子仲家的姑娘，这是一位纺麻的女子，因为爱好歌舞甚至放弃了纺麻的日常工作，同情人一起到热闹的城市去跳舞。诗不但表现了青年的爱情生活，也反映了陈国男女聚会、歌舞相乐、巫风盛行的特殊风俗。東門之枌，宛丘之栩。子仲之子，婆娑其下。東門，陈国城门。枌，白榆树。栩，柞树。子仲之子，子仲家的姑娘。婆娑，跳舞盘旋摇摆的样子。韵读：鱼部一一栩、下。穀旦于差，南方之原。不績其麻，市也婆娑。穀旦，吉日。差，选择。原，高而平坦之地。不績其麻，指不去纺麻。市，也可作街市解。韵读：歌、元部借韵一一差、原、麻、娑。穀旦于逝，越以鬷邁。視爾如荍，貽我握椒。逝，往。越以，发语词。鬷，屡次。邁，往、去。荍，锦葵。貽，赠送。握椒，一把花椒。韵读：祭部一一逝、邁；幽部一一荍、椒。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012"]},{"id":"chengjunying-jiangjianyuan-zhuxi:0001-1:part-2","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/137-dong-men-zhi-fen/chengjunying-jiangjianyuan-zhuxi/0001-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"東門之枌，宛丘之栩。子仲之子，婆娑其下。穀旦于差，南方之原。不績其麻，市也婆娑。穀旦于逝，越以鬷邁。視爾如荍，貽我握椒。","sourceLabel":"第 307-309 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","excerpt":"東門之枌，宛丘之栩。子仲之子，婆娑其下。","fullT