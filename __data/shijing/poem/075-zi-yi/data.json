{"version":1,"page":{"kind":"poem-detail","href":"/shijing/poem/075-zi-yi","dataHref":"/__data/shijing/poem/075-zi-yi/data.json","title":"緇衣 · 逐字注脚阅读","description":"風 · 鄭風 · 汇聚 6 种资料、9 条注脚的《緇衣》阅读页。"},"payload":{"detail":{"route":{"poemId":"075-zi-yi"},"href":"/shijing/poem/075-zi-yi","poem":{"id":"075-zi-yi","title":"緇衣","categoryId":"feng","subcategoryId":"zhengfeng","path":["風","鄭風"],"segments":[{"id":"seg-001","order":1,"text":"缁衣之宜兮","entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-1","chenhuan-chuanshu:0001-1:part-1","quwanli-quanshi:0001-1:part-1","quwanli-quanshi:0001-1:part-2","quwanli-quanshi:0001-1:part-3","wangli-yundu:0001-1:part-1","wangli-yundu:0001-1:part-2","wangli-yundu:0001-1:part-3","wangli-yundu:0001-1:part-4"],"characters":[{"index":1,"text":"缁","anchorIds":["seg-001:1-1:缁"]},{"index":2,"text":"衣","anchorIds":[]},{"index":3,"text":"之","anchorIds":[]},{"index":4,"text":"宜","anchorIds":["seg-001:4-4:宜"]},{"index":5,"text":"兮","anchorIds":[]}]},{"id":"seg-002","order":2,"text":"敝予又改为兮","entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-1","chenhuan-chuanshu:0001-1:part-1","quwanli-quanshi:0001-1:part-1","quwanli-quanshi:0001-1:part-2","quwanli-quanshi:0001-1:part-3","wangli-yundu:0001-1:part-1","wangli-yundu:0001-1:part-2","wangli-yundu:0001-1:part-3","wangli-yundu:0001-1:part-4"],"characters":[{"index":1,"text":"敝","anchorIds":["seg-002:1-1:敝"]},{"index":2,"text":"予","anchorIds":[]},{"index":3,"text":"又","anchorIds":[]},{"index":4,"text":"改","anchorIds":[]},{"index":5,"text":"为","anchorIds":["seg-002:5-5:为"]},{"index":6,"text":"兮","anchorIds":[]}]},{"id":"seg-003","order":3,"text":"适子之馆兮","entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-1","chenhuan-chuanshu:0001-1:part-1","quwanli-quanshi:0001-1:part-1","quwanli-quanshi:0001-1:part-2","quwanli-quanshi:0001-1:part-3","wangli-yundu:0001-1:part-1","wangli-yundu:0001-1:part-2","wangli-yundu:0001-1:part-3","wangli-yundu:0001-1:part-4"],"characters":[{"index":1,"text":"适","anc