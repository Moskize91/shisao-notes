:1,"charEnd":4,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-4","chengjunying-jiangjianyuan-zhuxi:0001-1:part-5"],"materialIds":["chengjunying-jiangjianyuan-zhuxi"]},{"id":"seg-012:4-4:忘","segmentId":"seg-012","segmentOrder":12,"surfaceText":"忘","charStart":4,"charEnd":4,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-6"],"materialIds":["chengjunying-jiangjianyuan-zhuxi"]}],"entries":[{"id":"chengjunying-jiangjianyuan-zhuxi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/130-zhong-nan/chengjunying-jiangjianyuan-zhuxi/0001-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"终南何有？有条有梅。君子至止，锦衣狐袭。颜如渥丹，其君也哉！终南何有？有纪有堂。君子至止，黼衣绣裳。佩玉将将，寿考不忘。","sourceLabel":"第 294-296 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","excerpt":"这是一首周遗民含蓄劝戒秦君的诗。题解引严粲、方玉润之说，认为首章“其君也哉”与末章“寿考不忘”都含劝戒之意。两章都以终南山起兴，借山有嘉木喻君应以德副民望。","fullText":"这是一首周遗民含蓄劝戒秦君的诗。题解引严粲、方玉润之说，认为首章“其君也哉”与末章“寿考不忘”都含劝戒之意。两章都以终南山起兴，借山有嘉木喻君应以德副民望。终南何有？有条有梅。君子至止，锦衣狐袭。颜如渥丹，其君也哉！终南，山名，亦名南山。条，山楸。梅，旧注多作楠木，此处可视为佳木之称。锦衣狐袭，诸侯礼服。渥丹，涂以朱砂般红润。其君也哉，是设问而含期待。终南何有？有纪有堂。君子至止，黼衣绣裳。佩玉将将，寿考不忘。纪，杞柳。堂，棠梨。黼衣绣裳，贵族礼服。将将，佩玉相击之声。寿考不忘，是劝其终老不忘周天子之赐与民望。韵读：之部有、梅、止、袭、哉；阳部堂、裳、将、忘。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012"]},{"id":"chengjunying-jiangjianyuan-zhuxi:0001-1:part-2","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/130-zhong-nan/chengjunying-jiangjianyuan-zhuxi/0001-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"终南何有？有条有梅。君子至止，锦衣狐袭。颜如渥丹，其君也哉！终南何有？有纪有堂。君子至止，黼衣绣裳。佩玉将将，寿考不忘。","sourceLabel":"第 294-296 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","excerpt":"终南何有？