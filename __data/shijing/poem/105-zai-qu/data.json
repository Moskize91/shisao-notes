d":"seg-013:1-4:汶水滔滔","segmentId":"seg-013","segmentOrder":13,"surfaceText":"汶水滔滔","charStart":1,"charEnd":4,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-7"],"materialIds":["chengjunying-jiangjianyuan-zhuxi"]},{"id":"seg-013:3-4:滔滔","segmentId":"seg-013","segmentOrder":13,"surfaceText":"滔滔","charStart":3,"charEnd":4,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-8"],"materialIds":["chengjunying-jiangjianyuan-zhuxi"]},{"id":"seg-014:1-4:行人儦儦","segmentId":"seg-014","segmentOrder":14,"surfaceText":"行人儦儦","charStart":1,"charEnd":4,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-7"],"materialIds":["chengjunying-jiangjianyuan-zhuxi"]},{"id":"seg-014:3-4:儦儦","segmentId":"seg-014","segmentOrder":14,"surfaceText":"儦儦","charStart":3,"charEnd":4,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-8"],"materialIds":["chengjunying-jiangjianyuan-zhuxi"]},{"id":"seg-015:1-4:鲁道有荡","segmentId":"seg-015","segmentOrder":15,"surfaceText":"鲁道有荡","charStart":1,"charEnd":4,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-7"],"materialIds":["chengjunying-jiangjianyuan-zhuxi"]},{"id":"seg-016:1-4:齐子游敖","segmentId":"seg-016","segmentOrder":16,"surfaceText":"齐子游敖","charStart":1,"charEnd":4,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-7"],"materialIds":["chengjunying-jiangjianyuan-zhuxi"]},{"id":"seg-016:3-4:游敖","segmentId":"seg-016","segmentOrder":16,"surfaceText":"游敖","charStart":3,"charEnd":4,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-8"],"materialIds":["chengjunying-jiangjianyuan-zhuxi"]}],"entries":[{"id":"chengjunying-jiangjianyuan-zhuxi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/105-zai-qu/chengjunying-jiangjianyuan-zhuxi/0001-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"载驱薄薄，簟茀朱鞹。鲁道有荡，齐子发夕。四骊济济，垂辔濔濔。鲁道有荡，齐子岂弟。汶水汤汤，行人彭彭。鲁道有荡，齐子翱翔。汶水滔滔，行人儦儦。鲁道有荡，齐子游敖。","sourceLabel":"第 218-220 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","excerpt":"这是一首写齐女嫁鲁的诗。诗中叠字很多，可能与配合乐曲有关，也把哀姜故意拖拖拉拉的神态活画出来了。","fullText":"这是一首写齐女嫁鲁的诗。诗中叠字很多，可能与配合乐曲有关，也把哀姜故意拖拖拉拉的神态活画出来了。载驱薄薄，簟茀朱鞹。鲁道有荡，齐子发夕。薄薄，车轮转动声。簟，竹席。茀，车帘。朱鞹，染红兽皮制的车盖。鲁道有荡，指鲁道平坦。齐子发夕，写哀姜迟迟不入鲁境。四骊济济，垂辔濔濔。鲁道有荡，齐子岂弟。四骊，四匹黑马。济济，整齐貌。濔濔，柔软貌。岂弟，安舒徐缓。汶水汤汤，行人彭彭。鲁道有荡，齐子翱翔。汶水滔滔，行人儦儦。鲁道有荡，齐子游敖。汤汤，水势盛大貌。彭彭，行人众多貌。翱翔，游逛不进鲁国。滔滔，水流盛貌。儦儦，来回行走貌。游敖，即邀游。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016"]},{"id":"chengjunying-jiangjianyuan-zhuxi:0001-1:part-2","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/105-zai-qu/chengjunying-jiangjianyuan-zhuxi/0001-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"载驱薄薄，簟茀朱鞹。鲁道有荡，齐子发夕。四骊济济，垂辔濔濔。鲁道有荡，齐子岂弟。汶水汤汤，行人彭彭。鲁道有荡，齐子翱翔。汶水滔滔，行人儦儦。鲁道有荡，齐子游敖。","sourceLabel":"第 218-220 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","excerpt":"载驱薄薄，簟茀朱鞹。鲁道有荡，齐子发夕。","fullText":"这是一首写齐女嫁鲁的诗。诗中叠字很多，可能与配合乐曲有关，也把哀姜故意拖拖拉拉的神态活画出来了。载驱薄薄，簟茀朱鞹。鲁道有荡，齐子发夕。薄薄，车轮转动声。簟，竹席。茀，车帘。朱鞹，染红兽皮制的车盖。鲁道有荡，指鲁道平坦。齐子发夕，写哀姜迟迟不入鲁境。四骊济济，垂辔濔濔。鲁道有荡，齐子岂弟。四骊，四匹黑马。济济，整齐貌。濔濔，柔软貌。岂弟，安舒徐缓。汶水汤汤，行人彭彭。鲁道有荡，齐子翱翔。汶水滔滔，行人儦儦。鲁道有荡，齐子游敖。汤汤，水势盛大貌。彭彭，行人众多貌。翱翔，游逛不进鲁国。滔滔，水流盛貌。儦儦，来回行走貌。游敖，即邀游。","notes":null,"partOrder":2,"anchorIds":["seg-001:1-4:载驱薄薄","seg-002:1-4:簟茀朱鞹","seg-003:1-4:鲁道有荡","seg-004:1-4:齐子发夕"],"glossAnchorIds":["anchor-2-1","anchor-2-2","anchor-2-3","anchor-2-4"],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016"]},{"id":"chengjunying-jiangjianyuan-zhuxi:0001-1:part-3","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/105-zai-qu/chengj