mentId":"seg-009","segmentOrder":9,"surfaceText":"裯","charStart":4,"charEnd":4,"entryIds":["maoheng-zhushu-kr1c0004:0003-1:part-2","quwanli-quanshi:0002-1:part-2","zhuxi-shijichuan-kr1c0009:0002-1:part-1","zhuxi-shijichuan-kr1c0009:0002-1:part-2"],"materialIds":["maoheng-zhushu-kr1c0004","quwanli-quanshi","zhuxi-shijichuan-kr1c0009"]},{"id":"seg-010:3-4:不猶","segmentId":"seg-010","segmentOrder":10,"surfaceText":"不猶","charStart":3,"charEnd":4,"entryIds":["zhuxi-shijichuan-kr1c0009:0002-1:part-1"],"materialIds":["zhuxi-shijichuan-kr1c0009"]},{"id":"seg-010:4-4:猶","segmentId":"seg-010","segmentOrder":10,"surfaceText":"猶","charStart":4,"charEnd":4,"entryIds":["maoheng-zhushu-kr1c0004:0003-1:part-2","quwanli-quanshi:0002-1:part-2"],"materialIds":["maoheng-zhushu-kr1c0004","quwanli-quanshi"]}],"entries":[{"id":"chengjunying-jiangjianyuan-zhuxi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/021-xiao-xing/chengjunying-jiangjianyuan-zhuxi/0001-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"preface","layerLabel":"篇序","targetText":"这是一个小官吏出差赶路，怨恨自己不幸的诗。按当时把人分为十等，左传昭公七年：“人有十等，王臣公，公臣大夫，大夫臣士，士臣皂，皂臣舆，舆臣隶，隶臣僚，僚臣仆，仆臣台，马有圉，牛有牧。”士是可上可下的等级，作者可能是一位知识分子。洪迈容斋随笔：“小星‘肃肃宵征，抱衾与裯’，是咏使者远适，夙夜征行，不敢慢君命之意。”程大昌考古编：“此为使臣行役之诗。”姚际恒、方玉润亦断为“小臣行役之作”。毛序从“抱衾与裯”一句出发，认为这是贱妾进御于君的诗，序云：“夫人无妒忌之行，惠及贱妾，进御于君，知其命有贵贱，能尽其心矣。”朱熹诗集传亦沿其说。因此，后世竟将“小星”一词作为小老婆的代称。","sourceLabel":"第 38 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","excerpt":"这是一个小官吏出差赶路，怨恨自己不幸的诗。按当时把人分为十等，左传昭公七年：“人有十等，王臣公，公臣大夫，大夫臣士，士臣皂，皂臣舆，舆臣隶，隶臣僚，僚臣仆，仆臣台，马有圉，牛有牧。”士是可上可下的等级，作者可能是一位知识分子。洪迈容斋随笔：“小星‘肃肃宵征，抱衾与裯’，是咏使者远适，夙夜征行，不敢慢君命之意。”程大昌考古编：“此为使臣行役之诗。”姚际恒、方玉润亦断为“小臣行役之作”。毛序从“抱衾与裯”一句出发，认为这是贱妾进御于君的诗，序云：“夫人无妒忌之行，惠及贱妾，进御于君，知其命有贵贱，能尽其心矣。”朱熹诗集传亦沿其说。因此，后世竟将“小星”一词作为小老婆的代称。","fullText":"这是一个小官吏出差赶路，怨恨自己不幸的诗。按当时把人分为十等，左传昭公七年：“人有十等，王臣公，公臣大夫，大夫臣士，士臣皂，皂臣舆，舆臣隶，隶臣僚，僚臣仆，仆臣台，马有圉，牛有牧。”士是可上可下的等级，作者可能是一位知识分子。洪迈容斋随笔：“小星‘肃肃宵征，抱衾与裯’，是咏使者远适，夙夜征行，不敢慢君命之意。”程大昌考古编：“此为使臣行役之诗。”姚际恒、方玉润亦断为“小臣行役之作”。毛序从“抱衾与裯”一句出发，认为这是贱妾进御于君的诗，序云：“夫人无妒忌之行，惠及贱妾，进御于君，知其命有贵贱，能尽其心矣。”朱熹诗集传亦沿其说。因此，后世竟将“小星”一词作为小老婆的代称。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"chengjunying-jiangjianyuan-zhuxi:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/021-xiao-xing/chengjunying-jiangjianyuan-zhuxi/0002-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"preface","layerLabel":"篇序","targetText":"韵律是诗歌特色之一。诗经时代诗歌，多为口头创作，用韵非常自由，只求协音动听，没有什么韵书可查。其用韵之法，非常复杂，约言之，有如下三种：一、用于句首者，如关雎“求之不得”的“求”，与“悠哉悠哉”的“悠”押韵。二、用于句中者，如匏有苦叶“有瀰济盈，有鷕雉鸣”，“瀰”和“鷕”为句中押韵。三、用于句末者，如关雎首章鸠、洲、逑押韵。此诗仅二章，每章只五句。第一章星、征押韵，东、公、同押韵。第二章亦星、征押韵，昴、裯、犹押韵。（江永古韵标准云：“句中韵，参、衾亦韵。”）每句都押韵，读起来便觉音调铿锵，和谐悦耳。按句首和句中韵，诗经中较少，后世诗坛亦不用。故本书以标句末韵为主。","sourceLabel":"第 38 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","excerpt":"韵律是诗歌特色之一。诗经时代诗歌，多为口头创作，用韵非常自由，只求协音动听，没有什么韵书可查。其用韵之法，非常复杂，约言之，有如下三种：一、用于句首者，如关雎“求之不得”的“求”，与“悠哉悠哉”的“悠”押韵。二、用于句中者，如匏有苦叶“有瀰济盈，有鷕雉鸣”，“瀰”和“鷕”为句中押韵。三、用于句末者，如关雎首章鸠、洲、逑押韵。此诗仅二章，每章只五句。第一章星、征押韵，东、公、同押韵。第二章亦星、征押韵，昴、裯、犹押韵。（江永古韵标准云：“句中韵，参、衾亦韵。”）每句都押韵，读起来便觉音调铿锵，和谐悦耳。按句首和句中韵，诗经中较少，后世诗坛亦不用。故本书以标句末韵为主。","fullText":"韵律是诗歌特色之一。诗经时代诗歌，多为口头创作，用韵非常自由，只求协音动听，没有什么韵书可查。其用韵之法，非常复杂，约言之，有如下三种：一、用于句首者，如关雎“求之不得”的“求”，与“悠哉悠哉”的“悠”押韵。二、用于句中者，如匏有苦叶“有瀰济盈，有鷕雉鸣”，“瀰”和“鷕”为句中押韵。三、用于句末者，如关雎首章鸠、洲、逑押韵。此诗仅二章，每章只五句。第一章星、征押韵，东、公、同押韵。第二章亦星、征押韵，昴、裯、犹押韵。（江永古韵标准云：“句中韵，参、衾亦韵。”）每句都押韵，读起来便觉音调铿锵，和谐悦耳。按句首和句中韵，诗经中较少，后世诗坛亦不用。故本书以标句末韵为主。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"chengjunying-jiangjianyuan-zhuxi:0003-1:part-1","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/021-xiao-xing/chengjunying-jiangjianyuan-zhuxi/0003-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"嘒彼小星，三五在东。肃肃宵征，夙夜在公，实命不同。","sourceLabel":"第 39 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"首章","excerpt":"嘒彼小星，三五在东。肃肃宵征，夙夜在公，实命不同。","fullText":"嘒彼小星，三五在东。肃肃宵征，夙夜在公，实命不同。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005"]},{"id":"chengjunying-jiangjianyuan-zhuxi:0004-1:part-1","annotationId":"0004","glossId":"0004-1","glossHref":"/shijing/gloss/021-xiao-xing/chengjunying-jiangjianyuan-zhuxi/0004-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"嘒（huì），小星微光闪闪貌。韩诗作嘒。玉篇：“嘒，众星貌。”嘒彼，等于叠字嘒嘒（从王筠说）。","sourceLabel":"第 39 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"首章注","excerpt":"嘒（huì），小星微光闪闪貌。韩诗作嘒。玉篇：“嘒，众星貌。”嘒彼，等于叠字嘒嘒（从王筠说）。","fullText":"嘒（huì），小星微光闪闪貌。韩诗作嘒。玉篇：“嘒，众星貌。”嘒彼，等于叠字嘒嘒（从王筠说）。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"chengjunying-jiangjianyuan-zhuxi:0005-1:part-1","annotationId":"0005","glossId":"0005-1","glossHref":"/shijing/gloss/021-xiao-xing/chengjunying-jiangjianyuan-zhuxi/0005-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"肃肃，快步疾貌。毛传：“肃肃，疾貌。”宵，夜。征，行，赶路。夙夜，早夜，指大清早。见行露注。","sourceLabel":"第 39 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"首章注","excerpt":"肃肃，快步疾貌。毛传：“肃肃，疾貌。”宵，夜。征，行，赶路。夙夜，早夜，指大清早。见行露注。","fullText":"肃肃，快步疾貌。毛传：“肃肃，疾貌。”宵，夜。征，行，赶路。夙夜，早夜，指大清早。见行露注。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"chengjunying-jiangjianyuan-zhuxi:0006-1:part-1","annotationId":"0006","glossId":"0006-1","glossHref":"/shijing/gloss/021-xiao-xing/chengjunying-jiangjianyuan-zhuxi/0006-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"实，是，指示代词，作“此”或“这”用。说文：“寔，正也。正，是也。”以“是”训“寔”。韩诗作寔（实），为“是”的假借字。说文段注：“正与是互训，寔与是音义皆同。……寔、是音义皆殊，由赵魏之间寔、是同声，故相假借耳。”命，命运。不同，指不同于权贵。","sourceLabel":"第 39 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"首章注","excerpt":"实，是，指示代词，作“此”或“这”用。说文：“寔，正也。正，是也。”以“是”训“寔”。韩诗作寔（实），为“是”的假借字。说文段注：“正与是互训，寔与是音义皆同。……寔、是音义皆殊，由赵魏之间寔、是同声，故相假借耳。”命，命运。不同，指不同于权贵。","fullText":"实，是，指示代词，作“此”或“这”用。说文：“寔，正也。正，是也。”以“是”训“寔”。韩诗作寔（实），为“是”的假借字。说文段注：“正与是互训，寔与是音义皆同。……寔、是音义皆殊，由赵魏之间寔、是同声，故相假借耳。”命，命运。不同，指不同于权贵。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"chengjunying-jiangjianyuan-zhuxi:0007-1:part-1","annotationId":"0007","glossId":"0007-1","glossHref":"/shijing/gloss/021-xiao-xing/chengjunying-jiangjianyuan-zhuxi/0007-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"韵读：耕部——星、征。东部——东、公、同。","sourceLabel":"第 39 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"首章韵读","excerpt":"韵读：耕部——星、征。东部——东、公、同。","fullText":"韵读：耕部——星、征。东部——东、公、同。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"chengjunying-jiangjianyuan-zhuxi:0008-1:part-1","annotationId":"0008","glossId":"0008-1","glossHref":"/shijing/gloss/021-xiao-xing/chengjunying-jiangjianyuan-zhuxi/0008-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"嘒彼小星，维参与昴。肃肃宵征，抱衾与裯，实命不犹。","sourceLabel":"第 39 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"次章","excerpt":"嘒彼小星，维参与昴。肃肃宵征，抱衾与裯，实命不犹。","fullText":"嘒彼小星，维参与昴。肃肃宵征，抱衾与裯，实命不犹。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-006","seg-007","seg-008","seg-009","seg-010"]},{"id":"chengjunying-jiangjianyuan-zhuxi:0009-1:part-1","annotationId":"0009","glossId":"0009-1","glossHref":"/shijing/gloss/021-xiao-xing/chengjunying-jiangjianyuan-zhuxi/0009-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"参（shēn）、昴（mǎo），都是星名，即指上章“三五在东”的星。王引之经义述闻：“三五，举其数也。参昴，著其名也。”","sourceLabel":"第 39 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"次章注","excerpt":"参（shēn）、昴（mǎo），都是星名，即指上章“三五在东”的星。王引之经义述闻：“三五，举其数也。参昴，著其名也。”","fullText":"参（shēn）、昴（mǎo），都是星名，即指上章“三五在东”的星。王引之经义述闻：“三五，举其数也。参昴，著其名也。”","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"chengjunying-jiangjianyuan-zhuxi:0010-1:part-1","annotationId":"0010","glossId":"0010-1","glossHref":"/shijing/gloss/021-xiao-xing/chengjunying-jiangjianyuan-zhuxi/0010-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"衾，被。说文：“衾，大被也。”裯，床帐。三家诗作帱。裯是帱的假借字。说文：“帱，禅帐也。”","sourceLabel":"第 39 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"次章注","excerpt":"衾，被。说文：“衾，大被也。”裯，床帐。三家诗作帱。裯是帱的假借字。说文：“帱，禅帐也。”","fullText":"衾，被。说文：“衾，大被也。”裯，床帐。三家诗作帱。裯是帱的假借字。说文：“帱，禅帐也。”","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"chengjunying-jiangjianyuan-zhuxi:0011-1:part-1","annotationId":"0011","glossId":"0011-1","glossHref":"/shijing/gloss/021-xiao-xing/chengjunying-jiangjianyuan-zhuxi/0011-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"犹，如。毛传：“犹，若也。”不犹，不如（别人命好）。","sourceLabel":"第 39 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"次章注","excerpt":"犹，如。毛传：“犹，若也。”不犹，不如（别人命好）。","fullText":"犹，如。毛传：“犹，若也。”不犹，不如（别人命好）。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"chengjunying-jiangjianyuan-zhuxi:0012-1:part-1","annotationId":"0012","glossId":"0012-1","glossHref":"/shijing/gloss/021-xiao-xing/chengjunying-jiangjianyuan-zhuxi/0012-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"韵读：耕部——星、征。幽部——昴、裯、犹。","sourceLabel":"第 39 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"次章韵读","excerpt":"韵读：耕部——星、征。幽部——昴、裯、犹。","fullText":"韵读：耕部——星、征。幽部——昴、裯、犹。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"chenhuan-chuanshu:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/021-xiao-xing/chenhuan-chuanshu/0001-1","materialId":"chenhuan-chuanshu","materialTitle":"詩毛氏傳疏","contributorLine":"清 · 陳奐","publicationYear":1847,"layer":"preface","layerLabel":"篇序","targetText":"小星。惠及下也。夫人無妬忌之行。惠及賤妾。進御於君。知其命有貴賤。能盡其心矣。","sourceLabel":"第 51 页","attributionLabel":"诗序","sectionLabel":"序","excerpt":"小星。惠及下也。夫人無妬忌之行。惠及賤妾。進御於君。知其命有貴賤。能盡其心矣。","fullText":"小星。惠及下也。夫人無妬忌之行。惠及賤妾。進御於君。知其命有貴賤。能盡其心矣。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"chenhuan-chuanshu:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/021-xiao-xing/chenhuan-chuanshu/0002-1","materialId":"chenhuan-chuanshu","materialTitle":"詩毛氏傳疏","contributorLine":"清 · 陳奐","publicationYear":1847,"layer":"span","layerLabel":"诗句片段","targetText":"嘒彼小星，三五在東。肅肅宵征，夙夜在公，寔命不同。嘒彼小星，維參與昴。肅肅宵征，抱衾與裯，寔命不猶。","sourceLabel":"第 51-52 页","attributionLabel":"陈奂","sectionLabel":"疏","excerpt":"嘒彼小星，三五在東。肅肅宵征，夙夜在公，寔命不同。嘒彼小星，維參與昴。肅肅宵征，抱衾與裯，寔命不猶。","fullText":"嘒彼小星，三五在東。肅肅宵征，夙夜在公，寔命不同。嘒彼小星，維參與昴。肅肅宵征，抱衾與裯，寔命不猶。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010"]},{"id":"fangyurun-yuanshi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/021-xiao-xing/fangyurun-yuanshi/0001-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"global","layerLabel":"全篇总说","targetText":"小星㊟小臣行役自甘也。","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"题注","excerpt":"小星㊟小臣行役自甘也。","fullText":"小星㊟小臣行役自甘也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"fangyurun-yuanshi:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/021-xiao-xing/fangyurun-yuanshi/0002-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"global","layerLabel":"全篇总说","targetText":"嘒彼小星，三五在東。肅肅宵征，夙夜在公。寔命不同。嘒彼小星，維參與昴。肅肅宵征，抱衾與裯。寔命不猶。","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":null,"excerpt":"右《小星》二章，章五句。《小序》以爲「惠及下也」。《大序》謂「夫人無妒忌，惠及賤妾，進御於君，其命有貴賤，能盡其心矣」，《集傳》亦謹守其説而不敢背。然詩中詞意，唯「衾裯」句近閨詞，餘皆不類，不知何所見而云然也。且即使此句爲閨閣咏，亦青樓移枕就人之意，豈深宫進御於君之象哉？姚氏際恒解此詩，引章俊卿之言，以爲「小臣行役作」，因推廣其意云：「山川原隰之間，仰頭見星，東西歷歷可指，所謂戴星而行也。『抱衾裯』云者，猶後人言襆被之謂。『實命不同』，則較『我從事獨賢』稍爲渾厚。若謂衆妾，則是乃其常分，安見爲后妃之惠及妾媵乎？」然而詩旨原自分明，無如諸公之錯會其解者何哉？夫「肅肅宵征」者，遠行不逮，繼之以夜也。「夙夜在公」者，勤勞王事也。「命之不同」，則大小臣工之不一，而朝野勞逸之懸殊也。既知命不同，而仍克盡其心，各安其分，不敢有怨天心，不敢有忽王事，此何如器識乎？藉非文王平日用人無方，使之各盡所長，烏能令趨承奉公之士勤勞而無怨？蜀漢諸葛武侯亦稱得人，嘗罷李平，廢廖立爲民。及亮卒，立垂泣曰：「吾終爲左袵矣。」平聞之，亦發憤死，度後人之不能復用己也。嗟嗟！用人苟得其平，則雖廢棄終身猶不敢怨，況于役乎？此詩雖以命自委，而循分自安，毫無怨懟詞，不失敦厚遺旨，故可風也。","fullText":"右《小星》二章，章五句。《小序》以爲「惠及下也」。《大序》謂「夫人無妒忌，惠及賤妾，進御於君，其命有貴賤，能盡其心矣」，《集傳》亦謹守其説而不敢背。然詩中詞意，唯「衾裯」句近閨詞，餘皆不類，不知何所見而云然也。且即使此句爲閨閣咏，亦青樓移枕就人之意，豈深宫進御於君之象哉？姚氏際恒解此詩，引章俊卿之言，以爲「小臣行役作」，因推廣其意云：「山川原隰之間，仰頭見星，東西歷歷可指，所謂戴星而行也。『抱衾裯』云者，猶後人言襆被之謂。『實命不同』，則較『我從事獨賢』稍爲渾厚。若謂衆妾，則是乃其常分，安見爲后妃之惠及妾媵乎？」然而詩旨原自分明，無如諸公之錯會其解者何哉？夫「肅肅宵征」者，遠行不逮，繼之以夜也。「夙夜在公」者，勤勞王事也。「命之不同」，則大小臣工之不一，而朝野勞逸之懸殊也。既知命不同，而仍克盡其心，各安其分，不敢有怨天心，不敢有忽王事，此何如器識乎？藉非文王平日用人無方，使之各盡所長，烏能令趨承奉公之士勤勞而無怨？蜀漢諸葛武侯亦稱得人，嘗罷李平，廢廖立爲民。及亮卒，立垂泣曰：「吾終爲左袵矣。」平聞之，亦發憤死，度後人之不能復用己也。嗟嗟！用人苟得其平，則雖廢棄終身猶不敢怨，況于役乎？此詩雖以命自委，而循分自安，毫無怨懟詞，不失敦厚遺旨，故可風也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010"]},{"id":"fangyurun-yuanshi:0003-1:part-1","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/021-xiao-xing/fangyurun-yuanshi/0003-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"term","layerLabel":"字词注","targetText":"嘒彼小星三五在東維參與昴抱衾與裯寔命不猶","sourceLabel":null,"attributionLabel":"集释","sectionLabel":null,"excerpt":"集釋嘒微貌。三五〔《集傳》〕三五言其稀，蓋初昏或將旦時也。征行也。參昴西方二宿之名。〔毛氏萇曰〕參，伐也。昴，留也。〔孔氏穎達曰〕《天文志》云：「參，白虎宿，三星直，下有三星，鋭，曰伐。」《演孔圖》云「參以斬伐」，故言「參，伐也」。「昴六星，昴之爲言留，言物成就繫留」是也。衾被也。裯襌被也。","fullText":"集釋嘒微貌。三五〔《集傳》〕三五言其稀，蓋初昏或將旦時也。征行也。參昴西方二宿之名。〔毛氏萇曰〕參，伐也。昴，留也。〔孔氏穎達曰〕《天文志》云：「參，白虎宿，三星直，下有三星，鋭，曰伐。」《演孔圖》云「參以斬伐」，故言「參，伐也」。「昴六星，昴之爲言留，言物成就繫留」是也。衾被也。裯襌被也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-007","seg-009","seg-010"]},{"id":"fangyurun-yuanshi:0004-1:part-1","annotationId":"0004","glossId":"0004-1","glossHref":"/shijing/gloss/021-xiao-xing/fangyurun-yuanshi/0004-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"global","layerLabel":"全篇总说","targetText":"标韵","sourceLabel":null,"attributionLabel":"标韵","sectionLabel":null,"excerpt":"標韻東一東。公、同並同。本韻。昴十一尤。〔姚氏際恒曰〕《毛傳》云：「昴，留也。」疏引《元命苞》云：「昴之爲言留也。」《史·律書》云：「北至于留。」《索隱》云：「留，即昴。」則此當音留。〔案〕程氏《音韻攷》亦同，從之。裯、猶並同。本韻。","fullText":"標韻東一東。公、同並同。本韻。昴十一尤。〔姚氏際恒曰〕《毛傳》云：「昴，留也。」疏引《元命苞》云：「昴之爲言留也。」《史·律書》云：「北至于留。」《索隱》云：「留，即昴。」則此當音留。〔案〕程氏《音韻攷》亦同，從之。裯、猶並同。本韻。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"maoheng-zhushu-kr1c0004:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/021-xiao-xing/maoheng-zhushu-kr1c0004/0001-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"preface","layerLabel":"篇序","targetText":"小星惠及下也夫人無妬忌之行惠及賤妾進御於君知其命有貴賤能盡其心矣","sourceLabel":null,"attributionLabel":"诗序","sectionLabel":"序","excerpt":"序：《小星》，惠及下也。","fullText":"序：《小星》，惠及下也。夫人無妬忌之行，惠及賤妾，進御於君，知其命有貴賤，能盡其心矣。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"maoheng-zhushu-kr1c0004:0001-1:part-2","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/021-xiao-xing/maoheng-zhushu-kr1c0004/0001-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"preface","layerLabel":"篇序","targetText":"小星惠及下也夫人無妬忌之行惠及賤妾進御於君知其命有貴賤能盡其心矣","sourceLabel":null,"attributionLabel":"诗序","sectionLabel":"序","excerpt":"夫人無妬忌之行，惠及賤妾，進御於君，知其命有貴賤，能盡其心矣。","fullText":"序：《小星》，惠及下也。夫人無妬忌之行，惠及賤妾，進御於君，知其命有貴賤，能盡其心矣。","notes":null,"partOrder":2,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"maoheng-zhushu-kr1c0004:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/021-xiao-xing/maoheng-zhushu-kr1c0004/0002-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"span","layerLabel":"诗句片段","targetText":"嘒彼小星三五在東肅肅宵征夙夜在公寔命不同","sourceLabel":null,"attributionLabel":"毛传","sectionLabel":null,"excerpt":"傳：嘒，微貌。三五，心噣也。肅肅，疾貌。","fullText":"傳：嘒，微貌。三五，心噣也。肅肅，疾貌。夙夜，早夜也。寔，是也。","notes":null,"partOrder":1,"anchorIds":["seg-001:1-1:嘒","seg-002:1-2:三五","seg-003:1-2:肅肅"],"glossAnchorIds":["anchor-1-1","anchor-1-2","anchor-1-3"],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005"]},{"id":"maoheng-zhushu-kr1c0004:0002-1:part-2","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/021-xiao-xing/maoheng-zhushu-kr1c0004/0002-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"span","layerLabel":"诗句片段","targetText":"嘒彼小星三五在東肅肅宵征夙夜在公寔命不同","sourceLabel":null,"attributionLabel":"毛传","sectionLabel":null,"excerpt":"夙夜，早夜也。寔，是也。","fullText":"傳：嘒，微貌。三五，心噣也。肅肅，疾貌。夙夜，早夜也。寔，是也。","notes":null,"partOrder":2,"anchorIds":["seg-004:1-2:夙夜","seg-005:1-1:寔"],"glossAnchorIds":["anchor-2-1","anchor-2-2"],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005"]},{"id":"maoheng-zhushu-kr1c0004:0003-1:part-1","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/021-xiao-xing/maoheng-zhushu-kr1c0004/0003-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"span","layerLabel":"诗句片段","targetText":"嘒彼小星維參與昴肅肅宵征抱衾與裯寔命不猶","sourceLabel":null,"attributionLabel":"毛传","sectionLabel":null,"excerpt":"傳：參，伐也。昴，留也。","fullText":"傳：參，伐也。昴，留也。衾，被也。裯，禪被也。猶，若也。","notes":null,"partOrder":1,"anchorIds":["seg-007:2-2:參","seg-007:4-4:昴"],"glossAnchorIds":["anchor-1-1","anchor-1-2"],"segmentIds":["seg-006","seg-007","seg-008","seg-009","seg-010"]},{"id":"maoheng-zhushu-kr1c0004:0003-1:part-2","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/021-xiao-xing/maoheng-zhushu-kr1c0004/0003-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"span","layerLabel":"诗句片段","targetText":"嘒彼小星維參與昴肅肅宵征抱衾與裯寔命不猶","sourceLabel":null,"attributionLabel":"毛传","sectionLabel":null,"excerpt":"衾，被也。裯，禪被也。猶，若也。","fullText":"傳：參，伐也。昴，留也。衾，被也。裯，禪被也。猶，若也。","notes":null,"partOrder":2,"anchorIds":["seg-009:2-2:衾","seg-009:4-4:裯","seg-010:4-4:猶"],"glossAnchorIds":["anchor-2-1","anchor-2-2","anchor-2-3"],"segmentIds":["seg-006","seg-007","seg-008","seg-009","seg-010"]},{"id":"maruichen-tongshi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/021-xiao-xing/maruichen-tongshi/0001-1","materialId":"maruichen-tongshi","materialTitle":"毛詩傳箋通釋","contributorLine":"清 · 馬瑞辰","publicationYear":1989,"layer":"span","layerLabel":"诗句片段","targetText":"嘒彼小星","sourceLabel":"第 93-94 页","attributionLabel":"马瑞辰","sectionLabel":"按","excerpt":"嘒之言慧也。《方言》：「慧、[?]，意精明也。」嘒蓋狀星之明貌。〈雲漢〉詩「有嘒其星」，義同。《傳》於此曰「微貌」，於彼曰「眾星貌」，不免望文生義。","fullText":"嘒之言慧也。《方言》：「慧、[?]，意精明也。」嘒蓋狀星之明貌。〈雲漢〉詩「有嘒其星」，義同。《傳》於此曰「微貌」，於彼曰「眾星貌」，不免望文生義。","notes":null,"partOrder":1,"anchorIds":["seg-001:1-1:嘒"],"glossAnchorIds":["anchor-1-1"],"segmentIds":["seg-001"]},{"id":"quwanli-quanshi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/021-xiao-xing/quwanli-quanshi/0001-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"global","layerLabel":"全篇总说","targetText":"《韓詩外傳》卷一引此詩，以爲勞於仕宦者之作，近是。","sourceLabel":"第 23 页","attributionLabel":"屈万里","sectionLabel":"注释","excerpt":"《韓詩外傳》卷一引此詩，以爲勞於仕宦者之作，近是。","fullText":"《韓詩外傳》卷一引此詩，以爲勞於仕宦者之作，近是。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"quwanli-quanshi:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/021-xiao-xing/quwanli-quanshi/0002-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"term","layerLabel":"字词注","targetText":"嘒彼小星肅肅宵征夙夜在公寔命不同維參與昴抱衾與裯寔命不猶","sourceLabel":"第 23-24 页","attributionLabel":"屈万里","sectionLabel":"注释","excerpt":"屈万里释“嘒”为音辞兼有明锐之感，“肅肅”为疾貌，“征”为行，“公”为公署，“寔”同“實”；","fullText":"屈万里释“嘒”为音辞兼有明锐之感，“肅肅”为疾貌，“征”为行，“公”为公署，“寔”同“實”；又释“參”“昴”为宿名，“衾”“裯”为被具，“猶”训若。整组注释虽然偏重字义，但仍以女子迟婚、夙夜感时的读法贯串全篇。","notes":null,"partOrder":1,"anchorIds":["seg-001:1-1:嘒","seg-003:1-2:肅肅","seg-004:4-4:公","seg-005:1-1:寔"],"glossAnchorIds":["anchor-1-1","anchor-1-2","anchor-1-3","anchor-1-4"],"segmentIds":["seg-001","seg-003","seg-004","seg-005","seg-007","seg-009","seg-010"]},{"id":"quwanli-quanshi:0002-1:part-2","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/021-xiao-xing/quwanli-quanshi/0002-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"term","layerLabel":"字词注","targetText":"嘒彼小星肅肅宵征夙夜在公寔命不同維參與昴抱衾與裯寔命不猶","sourceLabel":"第 23-24 页","attributionLabel":"屈万里","sectionLabel":"注释","excerpt":"又释“參”“昴”为宿名，“衾”“裯”为被具，“猶”训若。整组注释虽然偏重字义，但仍以女子迟婚、夙夜感时的读法贯串全篇。","fullText":"屈万里释“嘒”为音辞兼有明锐之感，“肅肅”为疾貌，“征”为行，“公”为公署，“寔”同“實”；又释“參”“昴”为宿名，“衾”“裯”为被具，“猶”训若。整组注释虽然偏重字义，但仍以女子迟婚、夙夜感时的读法贯串全篇。","notes":null,"partOrder":2,"anchorIds":["seg-007:2-2:參","seg-009:4-4:裯","seg-010:4-4:猶"],"glossAnchorIds":["anchor-2-1","anchor-2-2","anchor-2-3"],"segmentIds":["seg-001","seg-003","seg-004","seg-005","seg-007","seg-009","seg-010"]},{"id":"wangli-yundu:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/021-xiao-xing/wangli-yundu/0001-1","materialId":"wangli-yundu","materialTitle":"詩經韻讀","contributorLine":"现代 · 王力","publicationYear":1980,"layer":"span","layerLabel":"诗句片段","targetText":"嘒彼小星，三五在東。肅肅宵征，夙夜在公。寔命不同。","sourceLabel":"第 147 页局部","attributionLabel":"王力","sectionLabel":"韵读","excerpt":"嘒彼小星（syeng），（与“征”协）三五在东（tong）；肃肃宵征（tjieng），（耕部）夙夜在公（kong）。寔命不同（dong）。（东部）","fullText":"嘒彼小星（syeng），（与“征”协）三五在东（tong）；肃肃宵征（tjieng），（耕部）夙夜在公（kong）。寔命不同（dong）。（东部）","notes":"据页图转写，保留句末拟音、协韵提示与韵部。","partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005"]},{"id":"wangli-yundu:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/021-xiao-xing/wangli-yundu/0002-1","materialId":"wangli-yundu","materialTitle":"詩經韻讀","contributorLine":"现代 · 王力","publicationYear":1980,"layer":"span","layerLabel":"诗句片段","targetText":"嘒彼小星，維參與昴。肅肅宵征，抱衾與裯。寔命不猶。","sourceLabel":"第 147-148 页","attributionLabel":"王力","sectionLabel":"韵读","excerpt":"嘒彼小星（syeng），（与“征”协）维参与昴（meu）；肃肃宵征（tjieng），（耕部）抱衾与裯（diu）。寔命不犹（jiu）。（幽部）","fullText":"嘒彼小星（syeng），（与“征”协）维参与昴（meu）；肃肃宵征（tjieng），（耕部）抱衾与裯（diu）。寔命不犹（jiu）。（幽部）","notes":"据页图转写，保留句末拟音、协韵提示与韵部。","partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-006","seg-007","seg-008","seg-009","seg-010"]},{"id":"yushengwu-xinzheng-211:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/021-xiao-xing/yushengwu-xinzheng-211/0001-1","materialId":"yushengwu-xinzheng-211","materialTitle":"澤螺居詩經新證 澤螺居楚辭新證","contributorLine":"现代 · 于省吾","publicationYear":2003,"layer":"term","layerLabel":"字词注","targetText":"維參與昴","sourceLabel":"第 6 页","attributionLabel":"于省吾","sectionLabel":"按","excerpt":"殷故地名有昂參，作“昂望”。","fullText":"殷故地名有昂參，作“昂望”。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-007"]},{"id":"yushengwu-xinzheng-211:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/021-xiao-xing/yushengwu-xinzheng-211/0002-1","materialId":"yushengwu-xinzheng-211","materialTitle":"澤螺居詩經新證 澤螺居楚辭新證","contributorLine":"现代 · 于省吾","publicationYear":2003,"layer":"term","layerLabel":"字词注","targetText":"肅肅宵征","sourceLabel":"第 6-7 页","attributionLabel":"于省吾","sectionLabel":"按","excerpt":"毛传：“肃肃，疾貌。宵，夜。征，行。”郑笺：“谓诸妾肃然夜行。”按宵、小古通。《礼记·学记》“宵雅肄三”注：“宵之言小也。”《文选·江文通杂体诗、鲍参军诗》注引《春秋元命图》来注：“宵犹小也。”正、征、政古同用。吴鼎“征月”即正月。《周礼·司勋》“惟加田无国正”，释文：“正，本亦作征。”《礼记·深衣》以直其政注：“政或为正。”郑则宵征应读为小正。","fullText":"毛传：“肃肃，疾貌。宵，夜。征，行。”郑笺：“谓诸妾肃然夜行。”按宵、小古通。《礼记·学记》“宵雅肄三”注：“宵之言小也。”《文选·江文通杂体诗、鲍参军诗》注引《春秋元命图》来注：“宵犹小也。”正、征、政古同用。吴鼎“征月”即正月。《周礼·司勋》“惟加田无国正”，释文：“正，本亦作征。”《礼记·深衣》以直其政注：“政或为正。”郑则宵征应读为小正。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-008"]},{"id":"yushengwu-xinzheng-332:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/021-xiao-xing/yushengwu-xinzheng-332/0001-1","materialId":"yushengwu-xinzheng-332","materialTitle":"澤螺居詩經新證 澤螺居楚辭新證","contributorLine":"现代 · 于省吾","publicationYear":2009,"layer":"term","layerLabel":"字词注","targetText":"維參與昴","sourceLabel":"第 11 页","attributionLabel":"于省吾","sectionLabel":"按","excerpt":"殷故地名有昂參，作“昂望”。","fullText":"殷故地名有昂參，作“昂望”。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-007"]},{"id":"yushengwu-xinzheng-332:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/021-xiao-xing/yushengwu-xinzheng-332/0002-1","materialId":"yushengwu-xinzheng-332","materialTitle":"澤螺居詩經新證 澤螺居楚辭新證","contributorLine":"现代 · 于省吾","publicationYear":2009,"layer":"term","layerLabel":"字词注","targetText":"肅肅宵征","sourceLabel":"第 11-12 页","attributionLabel":"于省吾","sectionLabel":"按","excerpt":"毛傳：“肅肅，疾貌。宵，夜。征，行。”鄭箋：“謂諸妾肅然夜行。”按宵、小古通。《禮記·學記》“宵雅肄三”注：“宵之言小也。”《文選·江文通雜體詩、鮑參軍詩》注引《春秋元命圖》宋注：“宵猶小也。”正、征、政古同用。吳鼎“征月”即正月。《周禮·司勳》“惟加田無國正”，釋文：“正，本亦作征。”《禮記·深衣》以直其政注：“政或爲正。”鄭則宵征應讀爲小正。","fullText":"毛傳：“肅肅，疾貌。宵，夜。征，行。”鄭箋：“謂諸妾肅然夜行。”按宵、小古通。《禮記·學記》“宵雅肄三”注：“宵之言小也。”《文選·江文通雜體詩、鮑參軍詩》注引《春秋元命圖》宋注：“宵猶小也。”正、征、政古同用。吳鼎“征月”即正月。《周禮·司勳》“惟加田無國正”，釋文：“正，本亦作征。”《禮記·深衣》以直其政注：“政或爲正。”鄭則宵征應讀爲小正。","notes":null,"partOrder":1,"anchorIds":["seg-008:1-2:肅肅"],"glossAnchorIds":["anchor-1-1"],"segmentIds":["seg-008"]},{"id":"zhuxi-shijichuan-kr1c0009:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/021-xiao-xing/zhuxi-shijichuan-kr1c0009/0001-1","materialId":"zhuxi-shijichuan-kr1c0009","materialTitle":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"layer":"span","layerLabel":"诗句片段","targetText":"嘒彼小星，三五在東。肅肅宵征，夙夜在公，寔命不同。","sourceLabel":null,"attributionLabel":"朱熹","sectionLabel":null,"excerpt":"興也。嘒，微貌。三五言其稀，蓋初昏或將旦時也。肅肅，齊遫貌；宵征，夜行也。命不同，謂天所賦之分不同。","fullText":"興也。嘒，微貌。三五言其稀，蓋初昏或將旦時也。肅肅，齊遫貌；宵征，夜行也。命不同，謂天所賦之分不同。朱熹承序說，以為南國夫人能惠及眾妾，故其進御於君夕往晨還，因見小星在東與夙夜在公而起興，自知命分不及貴者，故雖勤勞往來而不敢致怨。","notes":null,"partOrder":1,"anchorIds":["seg-001:1-1:嘒","seg-002:1-2:三五","seg-003:3-4:宵征","seg-005:2-4:命不同"],"glossAnchorIds":["anchor-1-1","anchor-1-2","anchor-1-3","anchor-1-4"],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005"]},{"id":"zhuxi-shijichuan-kr1c0009:0001-1:part-2","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/021-xiao-xing/zhuxi-shijichuan-kr1c0009/0001-1","materialId":"zhuxi-shijichuan-kr1c0009","materialTitle":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"layer":"span","layerLabel":"诗句片段","targetText":"嘒彼小星，三五在東。肅肅宵征，夙夜在公，寔命不同。","sourceLabel":null,"attributionLabel":"朱熹","sectionLabel":null,"excerpt":"朱熹承序說，以為南國夫人能惠及眾妾，故其進御於君夕往晨還，因見小星在東與夙夜在公而起興，自知命分不及貴者，故雖勤勞往來而不敢致怨。","fullText":"興也。嘒，微貌。三五言其稀，蓋初昏或將旦時也。肅肅，齊遫貌；宵征，夜行也。命不同，謂天所賦之分不同。朱熹承序說，以為南國夫人能惠及眾妾，故其進御於君夕往晨還，因見小星在東與夙夜在公而起興，自知命分不及貴者，故雖勤勞往來而不敢致怨。","notes":null,"partOrder":2,"anchorIds":["seg-004:1-4:夙夜在公"],"glossAnchorIds":["anchor-2-1"],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005"]},{"id":"zhuxi-shijichuan-kr1c0009:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/021-xiao-xing/zhuxi-shijichuan-kr1c0009/0002-1","materialId":"zhuxi-shijichuan-kr1c0009","materialTitle":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"layer":"span","layerLabel":"诗句片段","targetText":"嘒彼小星，維參與昴。肅肅宵征，抱衾與裯，寔命不猶。","sourceLabel":null,"attributionLabel":"朱熹","sectionLabel":null,"excerpt":"興也。參、昴為西方二宿之名，衾為被，裯為襌被；“與昴”“與裯”相應，亦以見興。“不猶”亦是不同之意。","fullText":"興也。參、昴為西方二宿之名，衾為被，裯為襌被；“與昴”“與裯”相應，亦以見興。“不猶”亦是不同之意。朱熹以為次章仍寫眾妾奉召夜行，自攜衾裯而往，愈見其勞，而所以能安其命者，正在感夫人之惠，不敢怨其來往之勤。","notes":null,"partOrder":1,"anchorIds":["seg-007:2-2:參","seg-009:4-4:裯","seg-010:3-4:不猶"],"glossAnchorIds":["anchor-1-1","anchor-1-2","anchor-1-3"],"segmentIds":["seg-006","seg-007","seg-008","seg-009","seg-010"]},{"id":"zhuxi-shijichuan-kr1c0009:0002-1:part-2","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/021-xiao-xing/zhuxi-shijichuan-kr1c0009/0002-1","materialId":"zhuxi-shijichuan-kr1c0009","materialTitle":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"layer":"span","layerLabel":"诗句片段","targetText":"嘒彼小星，維參與昴。肅肅宵征，抱衾與裯，寔命不猶。","sourceLabel":null,"attributionLabel":"朱熹","sectionLabel":null,"excerpt":"朱熹以為次章仍寫眾妾奉召夜行，自攜衾裯而往，愈見其勞，而所以能安其命者，正在感夫人之惠，不敢怨其來往之勤。","fullText":"興也。參、昴為西方二宿之名，衾為被，裯為襌被；“與昴”“與裯”相應，亦以見興。“不猶”亦是不同之意。朱熹以為次章仍寫眾妾奉召夜行，自攜衾裯而往，愈見其勞，而所以能安其命者，正在感夫人之惠，不敢怨其來往之勤。","notes":null,"partOrder":2,"anchorIds":["seg-009:4-4:裯"],"glossAnchorIds":["anchor-2-1"],"segmentIds":["seg-006","seg-007","seg-008","seg-009","seg-010"]},{"id":"zhuxi-shijichuan-kr1c0009:0003-1:part-1","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/021-xiao-xing/zhuxi-shijichuan-kr1c0009/0003-1","materialId":"zhuxi-shijichuan-kr1c0009","materialTitle":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"layer":"global","layerLabel":"全篇总说","targetText":"小星二章章五句","sourceLabel":null,"attributionLabel":"朱熹","sectionLabel":null,"excerpt":"朱熹记《小星》为二章，每章五句，","fullText":"朱熹记《小星》为二章，每章五句，并引吕氏语以申说夫人无妒忌而贱妾安其命。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"zhuxi-shijichuan-kr1c0009:0003-1:part-2","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/021-xiao-xing/zhuxi-shijichuan-kr1c0009/0003-1","materialId":"zhuxi-shijichuan-kr1c0009","materialTitle":"詩集傳","contributorLine":"宋 · 朱熹","publicationYear":1186,"layer":"global","layerLabel":"全篇总说","targetText":"小星二章章五句","sourceLabel":null,"attributionLabel":"朱熹","sectionLabel":null,"excerpt":"并引吕氏语以申说夫人无妒忌而贱妾安其命。","fullText":"朱熹记《小星》为二章，每章五句，并引吕氏语以申说夫人无妒忌而贱妾安其命。","notes":null,"partOrder":2,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]}]}}}
