angjianyuan-zhuxi"]},{"id":"seg-012:1-2:突而","segmentId":"seg-012","segmentOrder":12,"surfaceText":"突而","charStart":1,"charEnd":2,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-7"],"materialIds":["chengjunying-jiangjianyuan-zhuxi"]},{"id":"seg-012:1-4:突而弁兮","segmentId":"seg-012","segmentOrder":12,"surfaceText":"突而弁兮","charStart":1,"charEnd":4,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-6"],"materialIds":["chengjunying-jiangjianyuan-zhuxi"]},{"id":"seg-012:3-3:弁","segmentId":"seg-012","segmentOrder":12,"surfaceText":"弁","charStart":3,"charEnd":3,"entryIds":["chengjunying-jiangjianyuan-zhuxi:0001-1:part-7"],"materialIds":["chengjunying-jiangjianyuan-zhuxi"]}],"entries":[{"id":"chengjunying-jiangjianyuan-zhuxi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/102-fu-tian/chengjunying-jiangjianyuan-zhuxi/0001-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"无田甫田，维莠骄骄。无思远人，劳心忉忉。无田甫田，维莠桀桀。无思远人，劳心怛怛。婉兮娈兮，总角丱兮。未几见兮，突而弁兮。","sourceLabel":"第 214-215 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","excerpt":"这是一首思念远人的诗。作者可能是一位流亡的农民，曾经种过领主的大田。他想起当初种田除草的辛苦，现在虽然可以离开了，但又添了思念远人的苦恼，所以用大田起兴。第三章说出了这个远人是谁，就是那个幼小美好的孩子。别时他还是扎着羊角辫的娃娃，如果不久能见到的话，该是青年人了吧。他的久别之感与前两章的劳心相应。","fullText":"这是一首思念远人的诗。作者可能是一位流亡的农民，曾经种过领主的大田。他想起当初种田除草的辛苦，现在虽然可以离开了，但又添了思念远人的苦恼，所以用大田起兴。第三章说出了这个远人是谁，就是那个幼小美好的孩子。别时他还是扎着羊角辫的娃娃，如果不久能见到的话，该是青年人了吧。他的久别之感与前两章的劳心相应。无田甫田，维莠骄骄。无思远人，劳心忉忉。无田，不要耕种。甫，大。莠，狗尾草一类害苗之草。骄骄，高貌。忉忉，忧伤貌。无田甫田，维莠桀桀。无思远人，劳心怛怛。桀桀，草高举貌。怛怛，忧伤痛心貌。婉兮娈兮，总角丱兮。未几见兮，突而弁兮。婉娈，年少而美好。总角，儿童发饰。丱，形容总角的形状。未几，不久。突而，突然。弁，成年加冠。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012"]},{"id":"chengjunying-jiangjianyuan-zhuxi:0001-1:part-2","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/glos