0001-1:part-3"],"materialIds":["maoheng-zhushu-kr1c0004","quwanli-quanshi"]},{"id":"seg-014:4-4:背","segmentId":"seg-014","segmentOrder":14,"surfaceText":"背","charStart":4,"charEnd":4,"entryIds":["quwanli-quanshi:0001-1:part-3"],"materialIds":["quwanli-quanshi"]},{"id":"seg-016:1-4:使我心痗","segmentId":"seg-016","segmentOrder":16,"surfaceText":"使我心痗","charStart":1,"charEnd":4,"entryIds":["zhuxi-shijichuan-kr1c0009:0001-1:part-2"],"materialIds":["zhuxi-shijichuan-kr1c0009"]}],"entries":[{"id":"chengjunying-jiangjianyuan-zhuxi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/062-bo-xi/chengjunying-jiangjianyuan-zhuxi/0001-1","materialId":"chengjunying-jiangjianyuan-zhuxi","materialTitle":"詩經注析","contributorLine":"现代 · 程俊英、蔣見元","publicationYear":1991,"layer":"span","layerLabel":"诗句片段","targetText":"伯兮朅兮，邦之桀兮，伯也执殳，为王前驱。自伯之东，首如飞蓬，岂无膏沐，谁适为容。其雨其雨，杲杲出日，愿言思伯，甘心首疾。焉得谖草，言树之背，愿言思伯，使我心痗。","sourceLabel":"第 143-145 页","attributionLabel":"程俊英、蒋见元","sectionLabel":"题解","excerpt":"这是一位女子思念远征丈夫的诗。毛序：“伯兮，刺时也。言君子行役，为王前驱，过时而不返焉。”郑笺：“卫宣公之时，蔡人、卫人、陈人从王伐郑伯也（事见左传鲁桓公五年）。为王前驱久，故家人思之。”春秋时代，各国互相侵略吞并，强陵弱，众暴寡，战争频繁，这是普遍现象。郑康成确指诗的背景是蔡、卫、陈人从王伐郑之役，恐未必然。朱熹反驳道：“郑在卫西，不得为此伯行也。”一语点破郑笺之失。诗中说伯执殳前驱，是担任当时“旅贲”的官职，属于“中士”级别，地位相当高，不是一般士卒，他的妻子当然也是上层人物。\n全诗四章，后三章集中写一个“思”字。方玉润诗经原始：“始则首如飞蓬，发已乱矣，然犹未至于病也。继则甘心首疾，头已痛矣，而心尚无恙也。至于使我心痗，则心更病矣。其忧思之苦何如哉！”他说出了诗的层递手法。这首诗写室家怨思之苦，情意至深，对后世闺怨思远之作有很大影响。如李清照凤凰台上忆吹箫的“起来慵自梳头”、永遇乐的“如今憔悴，风鬟雾鬓”，都从“自伯之东，首如飞蓬”化出。徐幹杂诗“自君之出矣，明镜暗不治”、杜甫新婚别“罗襦不复施，对君洗红妆”，很明显地继承“岂无膏沐，谁适为容”之意。欧阳炯贺明朝“终是为伊，只恁偷瘦”、柳永凤栖梧“衣带渐宽终不悔，为伊消得人憔悴”，则是“愿言思伯，甘心首疾”的发展。\n伯兮朅兮，邦之桀兮。伯也执殳，为王前驱。\n伯，周代女子称她的丈夫为伯，类似现在乡间称夫为阿哥。仪礼士冠礼郑注：“伯、仲、叔、季，长幼之称。”正月毛传：“伯，长也。”\n朅（qiè），鲁诗作倡，朅是倡的假借字。壮健英武貌。按硕人“庶士有朅”，韩诗作桀，也训为“健”。朅的本义是“去”，在这两首诗中都是假借。\n邦，国家。桀，韩诗作杰，是本字。才智出众者。郑笺：“桀，英桀，言贤也。”\n殳（shū），古代兵器，竹制，形如竿，以当时的尺度衡量，长一丈二尺。广雅：“殳，杖也。”\n前驱，在战车两旁保卫统帅。马瑞辰通释：“执殳先驱，为旅贲之职。”王先谦集疏：“其执殳前驱者，当为中士。”按旅贲是天子的侍卫，其首领是中士级别。作战时，旅贲披甲执殳，守卫在统帅的战车两旁。\n韵读：祭部——朅、桀。侯部——殳（市朱反）、驱（音区qū）。\n自伯之东，首如飞蓬。岂无膏沐？谁适为容！\n之，往。\n飞蓬，蓬草遇风，四散飘飞，以喻不常梳洗的乱发。\n膏，润面的油。沐，洗头。王先谦集疏：“泽面曰膏，潘发曰沐。”按此处膏沐连用为偏义复词，主要指面油。\n适，悦。马瑞辰通释：“按一切经音义卷六引三苍：‘适，悦也。’此适字正当训为悦。女为悦己者容，夫不在，故曰‘谁适为容’，即言‘谁悦为容’也。”容，修饰容貌。这句意为，修饰容貌是为了取悦谁呢？\n韵读：东部——东、蓬、容。\n其雨其雨，杲杲出日。愿言思伯，甘心首疾！\n其，语助词。王引之经传释词：“其，犹庶几也。”这里表示一种希望的语气。“其雨其雨”的重叠，诗人用它比喻迫切盼望丈夫归来的心情。\n杲杲（gǎo），光明貌。马瑞辰通释：“杲对杳言。说文：‘杳，冥也。从日在木下。杲，明也。从日在木上。’说文又曰：‘榑桑，神木，日所出也。’日出神木之上，故日出谓之杲杲。”诗人用它比喻失望的心情，盼望下雨，偏偏出了太阳，事与愿违。\n愿言，念念不忘貌。闻一多风诗类钞训“愿”为“懁然”，即眷眷的意思。与二子乘舟的“愿言”训异。\n甘心，痛心。首疾，头痛。马瑞辰通释：“甘与苦古以相反为义，故甘草，经亦名为大苦。尔注：‘苦，快也。’疏注：‘苦而为快者，犹以臭为香，治为乱，存为亡。’以此推之，则甘心亦得训为苦心，犹言忧心、劳心、痛心也。成十三年左传：‘诸侯备闻此言，斯是用痛心疾首。’杜注：‘疾犹痛也。’甘心首疾与痛心疾首文正相类，皆为对举之词。诗不言疾首而言首疾者，倒文以为韵也。”这两句意为，念念不忘地想念丈夫，想得心口与头都痛起来了。\n韵读：脂部——日、疾。\n焉得谖草，言树之背？愿言思伯，使我心痗！\n焉，何。这里指何处。谖草，又名萱草，韩诗作谖。古人以为此草可以使人忘忧。即今之黄花菜、金针菜。\n言，而，乃。树，种植。背，古与“北”通，这里指北堂，即北房的阶下。姚际恒诗经通论：“背，堂背也。堂面向南，堂背向北，故背为北堂。”\n痗（mèi），病。心痗即心痛。\n韵读：脂部——背、痗。","fullText":"这是一位女子思念远征丈夫的诗。毛序：“伯兮，刺时也。言君子行役，为王前驱，过时而不返焉。”郑笺：“卫宣公之时，蔡人、卫人、陈人从王伐郑伯也（事见左传鲁桓公五年）。为王前驱久，故家人思之。”春秋时代，各国互相侵略吞并，强陵弱，众暴寡，战争频繁，这是普遍现象。郑康成确指诗的背景是蔡、卫、陈人从王伐郑之役，恐未必然。朱熹反驳道：“郑在卫西，不得为此伯行也。”一语点破郑笺之失。诗中说伯执殳前驱，是担任当时“旅贲”的官职，属于“中士”级别，地位相当高，不是一般士卒，他的妻子当然也是上层人物。\n全诗四章，后三章集中写一个“思”字。方玉润诗经原始：“始则首如飞蓬，发已乱矣，然犹未至于病也。继则甘心首疾，头已痛矣，而心尚无恙也。至于使我心痗，则心更病矣。其忧思之苦何如哉！”他说出了诗的层递手法。这首诗写室家怨思之苦，情意至深，对后世闺怨思远之作有很大影响。如李清照凤凰台上忆吹箫的“起来慵自梳头”、永遇乐的“如今憔悴，风鬟雾鬓”，都从“自伯之东，首如飞蓬”化出。徐幹杂诗“自君之出矣，明镜暗不治”、杜甫新婚别“罗襦不复施，对君洗红妆”，很明显地继承“岂无膏沐，谁适为容”之意。欧阳炯贺明朝“终是为伊，只恁偷瘦”、柳永凤栖梧“衣带渐宽终不悔，为伊消得人憔悴”，则是“愿言思伯，甘心首疾”的发展。\n伯兮朅兮，邦之桀兮。伯也执殳，为王前驱。\n伯，周代女子称她的丈夫为伯，类似现在乡间称夫为阿哥。仪礼士冠礼郑注：“伯、仲、叔、季，长幼之称。”正月毛传：“伯，长也。”\n朅（qiè），鲁诗作倡，朅是倡的假借字。壮健英武貌。按硕人“庶士有朅”，韩诗作桀，也训为“健”。朅的本义是“去”，在这两首诗中都是假借。\n邦，国家。桀，韩诗作杰，是本字。才智出众者。郑笺：“桀，英桀，言贤也。”\n殳（shū），古代兵器，竹制，形如竿，以当时的尺度衡量，长一丈二尺。广雅：“殳，杖也。”\n前驱，在战车两旁保卫统帅。马瑞辰通释：“执殳先驱，为旅贲之职。”王先谦集疏：“其执殳前驱者，当为中士。”按旅贲是天子的侍卫，其首领是中士级别。作战时，旅贲披甲执殳，守卫在统帅的战车两旁。\n韵读：祭部——朅、桀。侯部——殳（市朱反）、驱（音区qū）。\n自伯之东，首如飞蓬。岂无膏沐？谁适为容！\n之，往。\n飞蓬，蓬草遇风，四散飘飞，以喻不常梳洗的乱发。\n膏，润面的油。沐，洗头。王先谦集疏：“泽面曰膏，潘发曰沐。”按此处膏沐连用为偏义复词，主要指面油。\n适，悦。马瑞辰通释：“按一切经音义卷六引三苍：‘适，悦也。’此适字正当训为悦。女为悦己者容，夫不在，故曰‘谁适为容’，即言‘谁悦为容’也。”容，修饰容貌。这句意为，修饰容貌是为了取悦谁呢？\n韵读：东部——东、蓬、容。\n其雨其雨，杲杲出日。愿言思伯，甘心首疾！\n其，语助词。王引之经传释词：“其，犹庶几也。”这里表示一种希望的语气。“其雨其雨”的重叠，诗人用它比喻迫切盼望丈夫归来的心情。\n杲杲（gǎo），光明貌。马瑞辰通释：“杲对杳言。说文：‘杳，冥也。从日在木下。杲，明也。从日在木上。’说文又曰：‘榑桑，神木，日所出也。’日出神木之上，故日出谓之杲杲。”诗人用它比喻失望的心情，盼望下雨，偏偏出了太阳，事与愿违。\n愿言，念念不忘貌。闻一多风诗类钞训“愿”为“懁然”，即眷眷的意思。与二子乘舟的“愿言”训异。\n甘心，痛心。首疾，头痛。马瑞辰通释：“甘与苦古以相反为义，故甘草，经亦名为大苦。尔注：‘苦，快也。’疏注：‘苦而为快者，犹以臭为香，治为乱，存为亡。’以此推之，则甘心亦得训为苦心，犹言忧心、劳心、痛心也。成十三年左传：‘诸侯备闻此言，斯是用痛心疾首。’杜注：‘疾犹痛也。’甘心首疾与痛心疾首文正相类，皆为对举之词。诗不言疾首而言首疾者，倒文以为韵也。”这两句意为，念念不忘地想念丈夫，想得心口与头都痛起来了。\n韵读：脂部——日、疾。\n焉得谖草，言树之背？愿言思伯，使我心痗！\n焉，何。这里指何处。谖草，又名萱草，韩诗作谖。古人以为此草可以使人忘忧。即今之黄花菜、金针菜。\n言，而，乃。树，种植。背，古与“北”通，这里指北堂，即北房的阶下。姚际恒诗经通论：“背，堂背也。堂面向南，堂背向北，故背为北堂。”\n痗（mèi），病。心痗即心痛。\n韵读：脂部——背、痗。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016"]},{"id":"chenhuan-chuanshu:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/062-bo-xi/chenhuan-chuanshu/0001-1","materialId":"chenhuan-chuanshu","materialTitle":"詩毛氏傳疏","contributorLine":"清 · 陳奐","publicationYear":1847,"layer":"span","layerLabel":"诗句片段","targetText":"伯兮朅兮，邦之桀兮，伯也執殳，爲王前驅。自伯之東，首如飛蓬，豈無膏沐，誰適爲容。其雨其雨，杲杲出日，願言思伯，甘心首疾。焉得諼草，言樹之背，願言思伯，使我心痗。","sourceLabel":"第 144 页","attributionLabel":"陈奂","sectionLabel":"经文","excerpt":"伯兮朅兮，邦之桀兮，伯也執殳，爲王前驅。自伯之東，首如飛蓬，豈無膏沐，誰適爲容。其雨其雨，杲杲出日，願言思伯，甘心首疾。焉得諼草，言樹之背，願言思伯，使我心痗。","fullText":"伯兮朅兮，邦之桀兮，伯也執殳，爲王前驅。自伯之東，首如飛蓬，豈無膏沐，誰適爲容。其雨其雨，杲杲出日，願言思伯，甘心首疾。焉得諼草，言樹之背，願言思伯，使我心痗。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016"]},{"id":"fangyurun-yuanshi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/062-bo-xi/fangyurun-yuanshi/0001-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"global","layerLabel":"全篇总说","targetText":"伯兮㊟思婦寄征夫以詞也。","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"题注","excerpt":"伯兮㊟思婦寄征夫以詞也。","fullText":"伯兮㊟思婦寄征夫以詞也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"fangyurun-yuanshi:0002-1:part-1","annotationId":"0002","glossId":"0002-1","glossHref":"/shijing/gloss/062-bo-xi/fangyurun-yuanshi/0002-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"global","layerLabel":"全篇总说","targetText":"右《伯兮》四章，章四句。此詩不特爲婦人思夫之詞，且寄遠作也，觀次章辭意可見。鄭氏曰：「衛宣公之時，蔡人、衛人、陳人從王伐鄭。」故曰「爲王前驅」。曰「自伯之東」，鄭在王國之東，非衛東也。詩不過一婦人思夫作耳，何録乎？范氏曰：「居而相離則思，期而不至則憂。此人之情也。文王之遣戍役，周公之勞歸士，皆叙其室家之情、男女之思以閔之，故其民悦而忘死。聖人能通天下之志，是以能成天下之務。兵者，毒民於死者也。孤人之子，寡人之妻，傷天地之和，召水旱之災，故聖人重之。如不得已而行，則告以歸期，念其勤勞，哀傷慘怛，不啻在己。是以治世之詩，則言其君上閔恤之情；亂世之詩，則録其室家怨思之苦。以爲人情不出乎此也。」此詩室家之怨切矣。始則「首如飛蓬」，髮已亂矣，然猶未至於病也。繼則「甘心首疾」，頭已痛矣，而心尚無恙也。至於「使我心痗」，則心更病矣。其憂思之苦何如哉？使非爲王從征，胡以至是？後之帝王讀是詩者，其亦以窮兵黷武爲戒歟！","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"总评","excerpt":"右《伯兮》四章，章四句。此詩不特爲婦人思夫之詞，且寄遠作也，觀次章辭意可見。鄭氏曰：「衛宣公之時，蔡人、衛人、陳人從王伐鄭。」故曰「爲王前驅」。曰「自伯之東」，鄭在王國之東，非衛東也。詩不過一婦人思夫作耳，何録乎？范氏曰：「居而相離則思，期而不至則憂。此人之情也。文王之遣戍役，周公之勞歸士，皆叙其室家之情、男女之思以閔之，故其民悦而忘死。聖人能通天下之志，是以能成天下之務。兵者，毒民於死者也。孤人之子，寡人之妻，傷天地之和，召水旱之災，故聖人重之。如不得已而行，則告以歸期，念其勤勞，哀傷慘怛，不啻在己。是以治世之詩，則言其君上閔恤之情；亂世之詩，則録其室家怨思之苦。以爲人情不出乎此也。」此詩室家之怨切矣。始則「首如飛蓬」，髮已亂矣，然猶未至於病也。繼則「甘心首疾」，頭已痛矣，而心尚無恙也。至於「使我心痗」，則心更病矣。其憂思之苦何如哉？使非爲王從征，胡以至是？後之帝王讀是詩者，其亦以窮兵黷武爲戒歟！","fullText":"右《伯兮》四章，章四句。此詩不特爲婦人思夫之詞，且寄遠作也，觀次章辭意可見。鄭氏曰：「衛宣公之時，蔡人、衛人、陳人從王伐鄭。」故曰「爲王前驅」。曰「自伯之東」，鄭在王國之東，非衛東也。詩不過一婦人思夫作耳，何録乎？范氏曰：「居而相離則思，期而不至則憂。此人之情也。文王之遣戍役，周公之勞歸士，皆叙其室家之情、男女之思以閔之，故其民悦而忘死。聖人能通天下之志，是以能成天下之務。兵者，毒民於死者也。孤人之子，寡人之妻，傷天地之和，召水旱之災，故聖人重之。如不得已而行，則告以歸期，念其勤勞，哀傷慘怛，不啻在己。是以治世之詩，則言其君上閔恤之情；亂世之詩，則録其室家怨思之苦。以爲人情不出乎此也。」此詩室家之怨切矣。始則「首如飛蓬」，髮已亂矣，然猶未至於病也。繼則「甘心首疾」，頭已痛矣，而心尚無恙也。至於「使我心痗」，則心更病矣。其憂思之苦何如哉？使非爲王從征，胡以至是？後之帝王讀是詩者，其亦以窮兵黷武爲戒歟！","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"fangyurun-yuanshi:0003-1:part-1","annotationId":"0003","glossId":"0003-1","glossHref":"/shijing/gloss/062-bo-xi/fangyurun-yuanshi/0003-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"global","layerLabel":"全篇总说","targetText":"眉評〔二章〕宛然閨閣中語，漢、魏詩多襲此調。〔四章〕奇想。","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"眉评","excerpt":"眉評〔二章〕宛然閨閣中語，漢、魏詩多襲此調。〔四章〕奇想。","fullText":"眉評〔二章〕宛然閨閣中語，漢、魏詩多襲此調。〔四章〕奇想。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"fangyurun-yuanshi:0004-1:part-1","annotationId":"0004","glossId":"0004-1","glossHref":"/shijing/gloss/062-bo-xi/fangyurun-yuanshi/0004-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"term","layerLabel":"字词注","targetText":"集釋伯伯叔尊稱，或其夫字。朅武貌。桀英桀也。殳〔范氏處義曰〕殳長尋有四尺，在車之左，故曰前驅。蓬草名，叢生，風飛散亂。杲杲日色明也。首疾頭痛也。諼〔孔氏穎達曰〕諼，訓爲忘，非草名。〔案〕此諼下接草者，猶言善忘之草耳。草斷不可以忘事，故曰焉得也。《毛傳》謂「諼草令人忘憂」者，非。《説文》以諼爲藼者，尤非。詩家多用斷腸、忘憂、埋憂、填恨等字，皆寓言，非真物也。背〔姚氏際恒曰〕背，堂背也。堂面向南，堂背向北，故背爲北堂。痗病也。","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"集释","excerpt":"集釋伯伯叔尊稱，或其夫字。朅武貌。桀英桀也。殳〔范氏處義曰〕殳長尋有四尺，在車之左，故曰前驅。蓬草名，叢生，風飛散亂。杲杲日色明也。首疾頭痛也。諼〔孔氏穎達曰〕諼，訓爲忘，非草名。〔案〕此諼下接草者，猶言善忘之草耳。草斷不可以忘事，故曰焉得也。《毛傳》謂「諼草令人忘憂」者，非。《説文》以諼爲藼者，尤非。詩家多用斷腸、忘憂、埋憂、填恨等字，皆寓言，非真物也。背〔姚氏際恒曰〕背，堂背也。堂面向南，堂背向北，故背爲北堂。痗病也。","fullText":"集釋伯伯叔尊稱，或其夫字。朅武貌。桀英桀也。殳〔范氏處義曰〕殳長尋有四尺，在車之左，故曰前驅。蓬草名，叢生，風飛散亂。杲杲日色明也。首疾頭痛也。諼〔孔氏穎達曰〕諼，訓爲忘，非草名。〔案〕此諼下接草者，猶言善忘之草耳。草斷不可以忘事，故曰焉得也。《毛傳》謂「諼草令人忘憂」者，非。《説文》以諼爲藼者，尤非。詩家多用斷腸、忘憂、埋憂、填恨等字，皆寓言，非真物也。背〔姚氏際恒曰〕背，堂背也。堂面向南，堂背向北，故背爲北堂。痗病也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"fangyurun-yuanshi:0005-1:part-1","annotationId":"0005","glossId":"0005-1","glossHref":"/shijing/gloss/062-bo-xi/fangyurun-yuanshi/0005-1","materialId":"fangyurun-yuanshi","materialTitle":"诗经原始(上下)","contributorLine":"清 · 方玉润、李先耕","publicationYear":1986,"layer":"global","layerLabel":"全篇总说","targetText":"標韻朅九屑。桀同。本韻。殳七虞。驅同。本韻。東一東。蓬同。容二冬。通韻。日四質。疾同。本韻。背十一隊。痗同。本韻。","sourceLabel":null,"attributionLabel":"方玉润","sectionLabel":"标韵","excerpt":"標韻朅九屑。桀同。本韻。殳七虞。驅同。本韻。東一東。蓬同。容二冬。通韻。日四質。疾同。本韻。背十一隊。痗同。本韻。","fullText":"標韻朅九屑。桀同。本韻。殳七虞。驅同。本韻。東一東。蓬同。容二冬。通韻。日四質。疾同。本韻。背十一隊。痗同。本韻。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":[]},{"id":"maoheng-zhushu-kr1c0004:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/062-bo-xi/maoheng-zhushu-kr1c0004/0001-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"span","layerLabel":"诗句片段","targetText":"伯兮朅兮，邦之桀兮，伯也執殳，爲王前驅。自伯之東，首如飛蓬，豈無膏沐，誰適爲容。其雨其雨，杲杲出日，願言思伯，甘心首疾。焉得諼草，言樹之背，願言思伯，使我心痗。","sourceLabel":null,"attributionLabel":"毛传郑笺","sectionLabel":"传笺","excerpt":"《毛传》《郑笺》解《伯兮》时，以“朅”为武貌、“桀”为英杰，","fullText":"《毛传》《郑笺》解《伯兮》时，以“朅”为武貌、“桀”为英杰，又以“諼草”解为令人忘憂之草；全诗由“爲王前驅”的征役起兴，转入闺中思念之苦。","notes":null,"partOrder":1,"anchorIds":["seg-001:3-3:朅","seg-002:3-3:桀"],"glossAnchorIds":["anchor-1-1","anchor-1-2"],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016"]},{"id":"maoheng-zhushu-kr1c0004:0001-1:part-2","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/062-bo-xi/maoheng-zhushu-kr1c0004/0001-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"span","layerLabel":"诗句片段","targetText":"伯兮朅兮，邦之桀兮，伯也執殳，爲王前驅。自伯之東，首如飛蓬，豈無膏沐，誰適爲容。其雨其雨，杲杲出日，願言思伯，甘心首疾。焉得諼草，言樹之背，願言思伯，使我心痗。","sourceLabel":null,"attributionLabel":"毛传郑笺","sectionLabel":"传笺","excerpt":"又以“諼草”解为令人忘憂之草；","fullText":"《毛传》《郑笺》解《伯兮》时，以“朅”为武貌、“桀”为英杰，又以“諼草”解为令人忘憂之草；全诗由“爲王前驅”的征役起兴，转入闺中思念之苦。","notes":null,"partOrder":2,"anchorIds":["seg-013:3-4:諼草"],"glossAnchorIds":["anchor-2-1"],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016"]},{"id":"maoheng-zhushu-kr1c0004:0001-1:part-3","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/062-bo-xi/maoheng-zhushu-kr1c0004/0001-1","materialId":"maoheng-zhushu-kr1c0004","materialTitle":"毛詩注疏","contributorLine":"漢唐 · 毛亨、鄭氏、孔穎達","publicationYear":653,"layer":"span","layerLabel":"诗句片段","targetText":"伯兮朅兮，邦之桀兮，伯也執殳，爲王前驅。自伯之東，首如飛蓬，豈無膏沐，誰適爲容。其雨其雨，杲杲出日，願言思伯，甘心首疾。焉得諼草，言樹之背，願言思伯，使我心痗。","sourceLabel":null,"attributionLabel":"毛传郑笺","sectionLabel":"传笺","excerpt":"全诗由“爲王前驅”的征役起兴，转入闺中思念之苦。","fullText":"《毛传》《郑笺》解《伯兮》时，以“朅”为武貌、“桀”为英杰，又以“諼草”解为令人忘憂之草；全诗由“爲王前驅”的征役起兴，转入闺中思念之苦。","notes":null,"partOrder":3,"anchorIds":["seg-004:1-4:爲王前驅"],"glossAnchorIds":["anchor-3-1"],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016"]},{"id":"maruichen-tongshi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/062-bo-xi/maruichen-tongshi/0001-1","materialId":"maruichen-tongshi","materialTitle":"毛詩傳箋通釋","contributorLine":"清 · 馬瑞辰","publicationYear":1989,"layer":"span","layerLabel":"诗句片段","targetText":"使我心痗","sourceLabel":"第 225 页","attributionLabel":"马瑞辰","sectionLabel":"按","excerpt":"詩者，志之也。志之所之也。","fullText":"詩者，志之也。志之所之也。","notes":null,"partOrder":1,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-016"]},{"id":"quwanli-quanshi:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/062-bo-xi/quwanli-quanshi/0001-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"span","layerLabel":"诗句片段","targetText":"伯兮朅兮，邦之桀兮，伯也執殳，爲王前驅。自伯之東，首如飛蓬，豈無膏沐，誰適爲容。其雨其雨，杲杲出日，願言思伯，甘心首疾。焉得諼草，言樹之背，願言思伯，使我心痗。","sourceLabel":"第 78 页","attributionLabel":"屈万里","sectionLabel":"注释","excerpt":"屈万里释《伯兮》，以“朅”为勇武貌，“桀”为英傑，","fullText":"屈万里释《伯兮》，以“朅”为勇武貌，“桀”为英傑，又把“首如飛蓬”解释为不暇膏沐而发乱，末章“諼草”“背”则引到北堂忘忧的传统意象。","notes":null,"partOrder":1,"anchorIds":["seg-001:3-3:朅","seg-002:3-3:桀"],"glossAnchorIds":["anchor-1-1","anchor-1-2"],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016"]},{"id":"quwanli-quanshi:0001-1:part-2","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/062-bo-xi/quwanli-quanshi/0001-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"span","layerLabel":"诗句片段","targetText":"伯兮朅兮，邦之桀兮，伯也執殳，爲王前驅。自伯之東，首如飛蓬，豈無膏沐，誰適爲容。其雨其雨，杲杲出日，願言思伯，甘心首疾。焉得諼草，言樹之背，願言思伯，使我心痗。","sourceLabel":"第 78 页","attributionLabel":"屈万里","sectionLabel":"注释","excerpt":"又把“首如飛蓬”解释为不暇膏沐而发乱，","fullText":"屈万里释《伯兮》，以“朅”为勇武貌，“桀”为英傑，又把“首如飛蓬”解释为不暇膏沐而发乱，末章“諼草”“背”则引到北堂忘忧的传统意象。","notes":null,"partOrder":2,"anchorIds":["seg-006:1-4:首如飛蓬"],"glossAnchorIds":["anchor-2-1"],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016"]},{"id":"quwanli-quanshi:0001-1:part-3","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/062-bo-xi/quwanli-quanshi/0001-1","materialId":"quwanli-quanshi","materialTitle":"詩經詮釋","contributorLine":"现代 · 屈萬里","publicationYear":1983,"layer":"span","layerLabel":"诗句片段","targetText":"伯兮朅兮，邦之桀兮，伯也執殳，爲王前驅。自伯之東，首如飛蓬，豈無膏沐，誰適爲容。其雨其雨，杲杲出日，願言思伯，甘心首疾。焉得諼草，言樹之背，願言思伯，使我心痗。","sourceLabel":"第 78 页","attributionLabel":"屈万里","sectionLabel":"注释","excerpt":"末章“諼草”“背”则引到北堂忘忧的传统意象。","fullText":"屈万里释《伯兮》，以“朅”为勇武貌，“桀”为英傑，又把“首如飛蓬”解释为不暇膏沐而发乱，末章“諼草”“背”则引到北堂忘忧的传统意象。","notes":null,"partOrder":3,"anchorIds":["seg-013:3-4:諼草","seg-014:4-4:背"],"glossAnchorIds":["anchor-3-1","anchor-3-2"],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016"]},{"id":"wangli-yundu:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/062-bo-xi/wangli-yundu/0001-1","materialId":"wangli-yundu","materialTitle":"詩經韻讀","contributorLine":"现代 · 王力","publicationYear":1980,"layer":"span","layerLabel":"诗句片段","targetText":"伯兮朅兮，邦之桀兮，伯也执殳，为王前驱。自伯之东，首如飞蓬，岂无膏沐，谁适为容。其雨其雨，杲杲出日，愿言思伯，甘心首疾。焉得谖草，言树之背，愿言思伯，使我心痗。","sourceLabel":"第 174-175 页","attributionLabel":"王力","sectionLabel":"韵读","excerpt":"王力《诗经韵读》收《伯兮》四章，正文用简体“为王前驱”“谁适为容”“焉得谖草”；","fullText":"王力《诗经韵读》收《伯兮》四章，正文用简体“为王前驱”“谁适为容”“焉得谖草”；从重章换韵看，诗意由征夫英武逐步转入思妇的内心痛苦。","notes":null,"partOrder":1,"anchorIds":["seg-004:1-4:为王前驱","seg-008:1-4:谁适为容","seg-013:1-4:焉得谖草"],"glossAnchorIds":["anchor-1-1","anchor-1-2","anchor-1-3"],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016"]},{"id":"wangli-yundu:0001-1:part-2","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/062-bo-xi/wangli-yundu/0001-1","materialId":"wangli-yundu","materialTitle":"詩經韻讀","contributorLine":"现代 · 王力","publicationYear":1980,"layer":"span","layerLabel":"诗句片段","targetText":"伯兮朅兮，邦之桀兮，伯也执殳，为王前驱。自伯之东，首如飞蓬，岂无膏沐，谁适为容。其雨其雨，杲杲出日，愿言思伯，甘心首疾。焉得谖草，言树之背，愿言思伯，使我心痗。","sourceLabel":"第 174-175 页","attributionLabel":"王力","sectionLabel":"韵读","excerpt":"从重章换韵看，诗意由征夫英武逐步转入思妇的内心痛苦。","fullText":"王力《诗经韵读》收《伯兮》四章，正文用简体“为王前驱”“谁适为容”“焉得谖草”；从重章换韵看，诗意由征夫英武逐步转入思妇的内心痛苦。","notes":null,"partOrder":2,"anchorIds":[],"glossAnchorIds":[],"segmentIds":["seg-001","seg-002","seg-003","seg-004","seg-005","seg-006","seg-007","seg-008","seg-009","seg-010","seg-011","seg-012","seg-013","seg-014","seg-015","seg-016"]},{"id":"yushengwu-xinzheng-211:0001-1:part-1","annotationId":"0001","glossId":"0001-1","glossHref":"/shijing/gloss/062-bo-xi/yushengwu-xinzheng-211/0001-1","materialId":"yushengwu-xinzheng-211","materialTitle":"澤螺居詩經新證 澤螺居楚辭新證","contributorLine":"现代 · 于省吾","publicationYear":2003,"layer":"span","layerLabel":"诗句片段","targetText":"誰適爲容","sourceLabel":"第 14 页","attributionLabel":"于省吾","sectionLabel":"按","excerpt":"于省吾